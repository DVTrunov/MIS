#Область ЭМК

Функция СформироватьТемпературныйЛистДляЭМК(Клиент, МедицинскаяКарта, ДатаНачала, ДатаОкончания) Экспорт
	
	ДатаНачалаОтчета = ДатаНачала;
	
	ОписаниеПребывания = Стационар.ПолучитьОписаниеПребыванияПациентаВСтационареПоМедкарте(МедицинскаяКарта);
	Если ЗначениеЗаполнено(ОписаниеПребывания.ДатаПоступления) Тогда
		ДатаНачалаОтчета = Макс(НачалоДня(ОписаниеПребывания.ДатаПоступления), ДатаНачала);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачалаОтчета) Тогда
		Сообщение	= НСтр("ru='Не удалось сформировать температурный лист:'") + Символы.Таб
					+ НСтр("ru='Дата отчета не задана и не может быть определена автоматически'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеПребывания.ДатаВыписки) Тогда
		ДатаОкончанияОтчета = НачалоДня(ОписаниеПребывания.ДатаВыписки);
	Иначе
		ДатаОкончанияОтчета = Дата(3999, 12, 31);
	КонецЕсли;
	
	ТабДок = Отчеты.ТемпературныйЛист.Создать().СформироватьОтчет(, Клиент, МедицинскаяКарта, ДатаНачалаОтчета, ДатаОкончанияОтчета);
	
	Возврат ТабДок;
	
КонецФункции

Функция СформироватьЛистНазначенийДляЭМК(Клиент, МедицинскаяКарта, ДатаНачала, ДатаОкончания) Экспорт
	
	ЛистНазначенияОтчет = Отчеты.ЛистНазначений.Создать();
	ЛистНазначенияОтчет.Клиент = Клиент;
	ЛистНазначенияОтчет.МедицинскаяКарта = МедицинскаяКарта;
	
	Возврат ЛистНазначенияОтчет.СформироватьЛистВыполненияНазначений();
	
КонецФункции

Функция ПолучитьТекстHTMLТабличногоДокумента(ТабДок, СтандартныйHTMLПустогоДокумента = Ложь)
	
	ИтоговыйТекстHTML = "";
	
	Если ТипЗнч(ТабДок) = Тип("ТабличныйДокумент")
		И ТабДок.ВысотаТаблицы <> 0
	Тогда
		ИмяВременногоКаталога = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(
			ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВременныхФайлов()) + "medcard_tmp");
		ФайлКаталог = Новый Файл(ИмяВременногоКаталога);
		Если ФайлКаталог.Существует() Тогда 
			УдалитьФайлы(ИмяВременногоКаталога);
		КонецЕсли;
		СоздатьКаталог(ИмяВременногоКаталога);
		
		ИмяВременногоФайла = ИмяВременногоКаталога + "medcard.html"; 
		ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML5);
		
		ТекстовыйФайл = Новый ТекстовыйДокумент;
		ТекстовыйФайл.Прочитать(ИмяВременногоФайла);
		ТекстHТМЛ = ТекстовыйФайл.ПолучитьТекст();
		
		// Обработка изображений не осуществляется.
		
		ДокументHTML = РаботаСDOMКлиентСервер.СоздатьДокументDOM(ТекстHТМЛ);
		ТекстHТМЛ = РаботаСDOMКлиентСервер.ПолучитьТекстHTMLДокументаDOM(ДокументHTML);
		
		// Удаление временных файлов
		УдалитьФайлы(ИмяВременногоКаталога);
	Иначе 
		ТекстHТМЛ = "";
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстHТМЛ) И СтандартныйHTMLПустогоДокумента Тогда 
		ТекстHТМЛ = РаботаСHTMLКлиентСервер.ПолучитьТекстHTMLПустогоДокумента();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстHТМЛ) Тогда
		ДокументHTML = РаботаСDOMКлиентСервер.СоздатьДокументDOM(ТекстHТМЛ);
		ИтоговыйТекстHTML = РаботаСDOMКлиентСервер.ПолучитьТекстHTMLДокументаDOM(ДокументHTML);
		ИтоговыйТекстHTML = РаботаСHTMLКлиентСервер.ПеренестиСтилиИзHeadВТелоДокументаСЗаменойИменКлассов(ИтоговыйТекстHTML);
		ИтоговыйТекстHTML = РаботаСHTMLКлиентСервер.УдалитьСтильЭлемента(ИтоговыйТекстHTML);
	КонецЕсли;
	
	Возврат ИтоговыйТекстHTML;
	
КонецФункции


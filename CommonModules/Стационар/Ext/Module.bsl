
Функция ПолучитьМедКартуСтационара(Клиент, ТолькоОткрытые = Истина) Экспорт
	
	МедКартыСтационара = ПолучитьМедКартыСтационара(Клиент, ТолькоОткрытые);
	
	Если МедКартыСтационара.Количество() > 0 Тогда 
		Возврат МедКартыСтационара[0];
	Иначе 
		Возврат Справочники.МедицинскиеКарты.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Возвращает массив медкарт стационара клиента.
//
// Параметры:
//  Клиент	 - СправочникСсылка.Клиенты - Клиент.
// 
// Возвращаемое значение:
//   - Массив.
//
Функция ПолучитьМедКартыСтационара(Клиент, ТолькоОткрытые) Экспорт
	// Изменения Макеев 11-02-2026 (
	
	ОсновнаяМедицинскаяКарта = Клиент.ОсновнаяМедицинскаяКарта;

	ПрочиеНастройки = омг_МедицинскаяДеятельность.ПолучитьПрочиеНастройкиСистемы();
	ТипКарты = Перечисления.ТипыМедицинскихКарт.Стационар;
	Если ПрочиеНастройки.Свойство("ТипКартыСтационара") Тогда
		ТипКарты = ПрочиеНастройки.ТипКартыСтационара;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	МедицинскиеКарты.Ссылка КАК МедКарта
	                      |ИЗ
	                      |	РегистрСведений.омг_ТекущиеМедицинскиеКарты.СрезПоследних КАК омг_ТекущиеМедицинскиеКартыСрезПоследних
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МедицинскиеКарты КАК МедицинскиеКарты
	                      |		ПО омг_ТекущиеМедицинскиеКартыСрезПоследних.МедицискаяКарта = МедицинскиеКарты.Ссылка
	                      |ГДЕ
	                      |	МедицинскиеКарты.Клиент = &Клиент
	                      |	И МедицинскиеКарты.ВидКарты.ТипКарты = &ТипКарты
	                      |	И (&ТолькоОткрытые = ЛОЖЬ
	                      |			ИЛИ МедицинскиеКарты.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	                      |	И омг_ТекущиеМедицинскиеКартыСрезПоследних.Активна
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	МедицинскиеКарты.Ссылка <> &МедКарта,
	                      |	МедицинскиеКарты.ДатаЗакрытия <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0),
	                      |	МедицинскиеКарты.ДатаРегистрации УБЫВ");
	Запрос.УстановитьПараметр("Клиент",Клиент);
	Запрос.УстановитьПараметр("МедКарта",ОсновнаяМедицинскаяКарта);
	Запрос.УстановитьПараметр("ТолькоОткрытые",ТолькоОткрытые);
	Запрос.УстановитьПараметр("ТипКарты",ТипКарты);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Медкарта");
	
КонецФункции

Функция ЭтоМедКартаСтационара(МедицинскаяКарта) Экспорт
	
	Возврат ЗначениеЗаполнено(МедицинскаяКарта)
			// Изменено Макеевв (
			И (МедицинскаяКарта.ВидКарты.ТипКарты = Перечисления.ТипыМедицинскихКарт.Стационар
			Или МедицинскаяКарта.ВидКарты.ТипКарты = Перечисления.ТипыМедицинскихКарт.омг_СтационарРК);
			// )
		
КонецФункции

Процедура ПередРассчетомДвиженийВыполненияПланаЛечения(ВыполнениеПлана, Регистратор, МедицинскаяКарта) Экспорт
	
	Если Не ЭтоМедКартаСтационара(МедицинскаяКарта) Тогда
		Возврат;
	КонецЕсли;
	
	// Допустимые исполнители такой номенклатуры выполнения плана
	ДопустимыеИсполнители = Новый Массив;
	
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ДействияЗаСутки") Тогда
		ДопустимыеИсполнители.Добавить(Перечисления.ИсполнителиВСтационаре.ВыполняетсяМедсестрой);
		// Добавлено Макеев (
		ДопустимыеИсполнители.Добавить(Перечисления.ИсполнителиВСтационаре.ВыполняетсяВрачомОтображается);
		// )
	Иначе
		ДопустимыеИсполнители.Добавить(Перечисления.ИсполнителиВСтационаре.ВыполняетсяВрачом);
		ДопустимыеИсполнители.Добавить(Перечисления.ИсполнителиВСтационаре.ВыполняетсяВрачомОтображается);
		ДопустимыеИсполнители.Добавить(Перечисления.ИсполнителиВСтационаре.ПустаяСсылка());
	КонецЕсли;
	
	// Какая номенклатура документа отмечается им как выполнение плана лечения?
	НоменклатураВыполнения = ВыполнениеПлана.ВыгрузитьКолонку("Номенклатура");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НоменклатураВыполнения", НоменклатураВыполнения);
	Запрос.УстановитьПараметр("ДопустимыеИсполнители", ДопустимыеИсполнители);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&НоменклатураВыполнения)
	|	И Номенклатура.ИсполнительВСтационаре В(&ДопустимыеИсполнители)"
	;
	НоменклатураДопустимая = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	// Удаление лишних строк из таблицы выполнения плана
	мОбрИнд = ВыполнениеПлана.Количество()-1;
	Для Сч = 0 По мОбрИнд Цикл
		
		СтрокаТЗ = ВыполнениеПлана[мОбрИнд-Сч];
		Если НоменклатураДопустимая.Найти(СтрокаТЗ.Номенклатура) = Неопределено Тогда
			ВыполнениеПлана.Удалить(мОбрИнд-Сч);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает значение Шаблона осмотра для переданной роли и специализации
//
// Параметры:
//  РольШаблона - ПеречислениеСсылка.РольШаблоновСтационара - Роль шаблона
//	Специализация - СправочникСсылка.КатегорииВыработки - Специализация, для которой необходимо получить шаблон 
//
// Возвращаемое значение:
//  СправочникСсылка.ШаблоныHTML
//
Функция ПолучитьШаблонОсмотраМедицинскогоДокумента(РольШаблона = Неопределено, Специализация = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если РольШаблона = Неопределено Тогда 
		РольШаблона = Перечисления.РольШаблоновСтационара.ДневниковаяЗапись;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныМедицинскихДокументов.ШаблонОсмотра КАК ШаблонОсмотра,
		|	ВЫБОР
		|		КОГДА ШаблоныМедицинскихДокументов.Специализация = &Специализация
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	РегистрСведений.ШаблоныМедицинскихДокументовСтационара КАК ШаблоныМедицинскихДокументов
		|ГДЕ
		|	ШаблоныМедицинскихДокументов.РольШаблона = &РольШаблона
		|	И (ШаблоныМедицинскихДокументов.Специализация = &Специализация
		|			ИЛИ ШаблоныМедицинскихДокументов.Специализация = ЗНАЧЕНИЕ(Справочник.КатегорииВыработки.ПустаяСсылка))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
	
	Запрос.УстановитьПараметр("РольШаблона", РольШаблона);
	Запрос.УстановитьПараметр("Специализация", Специализация);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ШаблонОсмотра;
	Иначе
		Возврат Справочники.ШаблоныHTML.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Койки, в настоящее время привязанные к указанной Палате.
//
// Параметры:
//  Палата	 - СправочникСсылка.Палаты	 - палата.
// 
// Возвращаемое значение:
//  Массив - из СправочникСсылка.КойкоМеста.
//
Функция КойкиПалаты(Палата) Экспорт
	
	Койки = Новый Массив;
	
	Выб  = Справочники.КойкоМеста.Выбрать(, Палата);
	Пока Выб.Следующий() Цикл
		Если Не Выб.ПометкаУдаления Тогда
			Койки.Добавить(Выб.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Койки;
	
КонецФункции

Процедура ПроверитьВозможностьИзмененияСостоянияКойкоМеста(ДокументОбъект, ТаблицаУслуг = Неопределено, Отказ) Экспорт
	
	Перем ТаблицаСостоянияКойкоМест;
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("ДокументСсылка.БронированиеКойкоМеста"));
	МассивТипов.Добавить(Тип("ДокументСсылка.УстановкаУсловийПребывания"));	
	
	СтруктураДанных = Новый Структура("Клиент,КойкоМесто,ДатаНачала,ДатаОкончания,Ссылка,Дата");

	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.БронированиеКойкоМеста") Тогда 
		
		ЗаполнитьЗначенияСвойств(СтруктураДанных,ДокументОбъект);
		
		ПолучитьЗанятостьКойкоМест(СтруктураДанных,ТаблицаСостоянияКойкоМест);
		ОбработатьДанныеПоСостояниюКойкоМест(ТаблицаСостоянияКойкоМест,ДокументОбъект,Отказ);
		
		Если Не Отказ Тогда 
			ТекстСообщения = ПроверитьПациентов(СтруктураДанных,ТаблицаСостоянияКойкоМест,Отказ);
			Если ТекстСообщения <> "" Тогда
				Сообщить(ТекстСообщения);
			КонецЕсли;
			// Проводим движение
			ВыполнитьДвиженияПоРегиструСостояниеКойкоМеста(ДокументОбъект,Справочники.ВидыСостоянийКойкоМест.Бронь,Отказ);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УстановкаУсловийПребывания") Тогда	
		Если ДокументОбъект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.Поступление Тогда 
			// Проверим свободно ли койко-место, если да, то проведем движения по регистрам КлиентыСтационара и СостоянияКойкоМест.

			ЗаполнитьЗначенияСвойств(СтруктураДанных,ДокументОбъект);
			ПолучитьЗанятостьКойкоМест(СтруктураДанных,ТаблицаСостоянияКойкоМест);
			ОбработатьДанныеПоСостояниюКойкоМест(ТаблицаСостоянияКойкоМест,ДокументОбъект,Отказ);
			
			ТекущийДокументПоступления = ПолучитьДокументПоступленияПациентаСтационара(ДокументОбъект.Клиент, ДокументОбъект.Дата);
			Если ЗначениеЗаполнено(ТекущийДокументПоступления) Тогда
				
				ТекстСообщения	= "Пациент уже числится в стационаре по состоянию на " + Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy") + ".
				|Документ поступления пациента: " + ТекущийДокументПоступления + "
				|Проведение документа с видом операции " + Строка(ДокументОбъект.ВидОперации) + " невозможно!";
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка);
				
				Отказ = Истина;
			КонецЕсли;

			Если Не Отказ Тогда 
				
				ВыполнитьДвиженияПоРегиструКлиентыСтационара(ДокументОбъект, ДокументОбъект.Ссылка, Отказ);
				ВыполнитьДвиженияПоРегиструСостояниеКойкоМеста(ДокументОбъект,Справочники.ВидыСостоянийКойкоМест.ЗанятоПациентом,Отказ);
				ДвиженияПоРегиструУсловияПребывания(ДокументОбъект,ТаблицаУслуг,Отказ);				
			КонецЕсли;
				
		ИначеЕсли ДокументОбъект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.ИзменениеУсловий Тогда 

			ЗаполнитьЗначенияСвойств(СтруктураДанных,ДокументОбъект);
			ПолучитьЗанятостьКойкоМест(СтруктураДанных,ТаблицаСостоянияКойкоМест);
			ОбработатьДанныеПоСостояниюКойкоМест(ТаблицаСостоянияКойкоМест,ДокументОбъект,Отказ);
			
			Если Не Отказ Тогда 
				ТекущийДокументПоступления = ПолучитьДокументПоступленияПациентаСтационара(ДокументОбъект.Клиент, ДокументОбъект.Дата);
				Если Не ЗначениеЗаполнено(ТекущийДокументПоступления) Тогда
					
					ТекстСообщения	= "Пациент не числится в стационаре по состоянию на " + Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy") + ".
									  |Проведение документа с видом операции " + Строка(ДокументОбъект.ВидОперации) + " невозможно!";
								
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка);
					Отказ = Истина;
				КонецЕсли;
				
				Если Не Отказ Тогда 
					ВыполнитьДвиженияПоРегиструКлиентыСтационара(ДокументОбъект, ТекущийДокументПоступления, Отказ);
					ВыполнитьДвиженияПоРегиструСостояниеКойкоМеста(ДокументОбъект,Справочники.ВидыСостоянийКойкоМест.ЗанятоПациентом,Отказ);
				КонецЕсли;
				
				ДвиженияПоРегиструУсловияПребывания(ДокументОбъект,ТаблицаУслуг,Отказ);
			КонецЕсли;
			
		ИначеЕсли ДокументОбъект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.Выписка Тогда
			
			ТекущийДокументПоступления = ПолучитьДокументПоступленияПациентаСтационара(ДокументОбъект.Клиент, ДокументОбъект.ДатаНачала);
			Если Не ЗначениеЗаполнено(ТекущийДокументПоступления) Тогда
				
				ТекстСообщения	= "Пациент не числится в стационаре по состоянию на " + Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy") + ".
								  |Проведение документа с видом операции " + Строка(ДокументОбъект.ВидОперации) + " невозможно!";
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка);
				Отказ = Истина;
			КонецЕсли;
			
			Если Не Отказ Тогда
				// Проводим движение
				ВыполнитьДвиженияПоРегиструКлиентыСтационара(ДокументОбъект, ТекущийДокументПоступления, Отказ, Истина);
				ВыполнитьДвиженияПоРегиструСостояниеКойкоМеста(ДокументОбъект,Справочники.ВидыСостоянийКойкоМест.Свободно,Отказ);
			КонецЕсли;
			
		ИначеЕсли ДокументОбъект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.ПереводМеждуПодразделениями Тогда
			
			ЗаполнитьЗначенияСвойств(СтруктураДанных,ДокументОбъект);
			ПолучитьЗанятостьКойкоМест(СтруктураДанных,ТаблицаСостоянияКойкоМест);
			ОбработатьДанныеПоСостояниюКойкоМест(ТаблицаСостоянияКойкоМест,ДокументОбъект,Отказ);
			
			Если Не Отказ Тогда
				ТекущийДокументПоступления = ПолучитьДокументПоступленияПациентаСтационара(ДокументОбъект.Клиент, ДокументОбъект.Дата);
				Если Не ЗначениеЗаполнено(ТекущийДокументПоступления) Тогда
					
					ТекстСообщения	= "Пациент не числится в стационаре по состоянию на " + Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy") + ".
									  |Проведение документа с видом операции " + Строка(ДокументОбъект.ВидОперации) + " невозможно!";
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка);
					Отказ = Истина;
				КонецЕсли;
				
				Если Не Отказ И ПолучитьПредыдущееПодразделениеКлиента(ДокументОбъект.ДатаНачала, ДокументОбъект.Клиент) = ДокументОбъект.Подразделение Тогда
					
					ТекстСообщения	= "Пациент уже числится в данном отделении!
									  |Проведение документа с видом операции " + Строка(ДокументОбъект.ВидОперации) + " невозможно!";
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка);
					Отказ = Истина;
					
				КонецЕсли;
				
				Если Не Отказ Тогда
					ВыполнитьДвиженияПоРегиструКлиентыСтационара(ДокументОбъект, ТекущийДокументПоступления, Отказ);
					ВыполнитьДвиженияПоРегиструСостояниеКойкоМеста(ДокументОбъект,Справочники.ВидыСостоянийКойкоМест.ЗанятоПациентом,Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает последнее подразделение, в котором находился клиент
//
// Параметры:
//  Период	 - Дата						 - дата, на который нужно найти подразделение.
//  Клиент	 - СправочникСсылка.Клиенты	 - Клиент.
// 
// Возвращаемое значение:
//  СправочникСсыкла.КойкоМесто - Последняя занятая клиентом койка.
//
Функция ПолучитьПредыдущееПодразделениеКлиента(Дата, Клиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлиентыСтационараСрезПоследних.Подразделение КАК Подразделение
	               |ИЗ
	               |	РегистрСведений.КлиентыСтационара.СрезПоследних(&Период, Клиент = &Клиент) КАК КлиентыСтационараСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Подразделение;	
	Иначе
		Возврат Справочники.Подразделения.ПустаяСсылка();	
	КонецЕсли;
	
КонецФункции

Процедура ОбработатьДанныеПоСостояниюКойкоМест(ТаблицаСостоянияКойкоМест, ДокументОбъект, Отказ)
	
	Отказ = Ложь;
	Клиент = Строка(ДокументОбъект.Клиент);	
	Если ТаблицаСостоянияКойкоМест <> Неопределено И ТаблицаСостоянияКойкоМест.Количество() > 0  Тогда 
		Для Каждого стрТБ Из ТаблицаСостоянияКойкоМест Цикл
			
			ТекстОшибки = "";
			
			Если стрТБ.ПричинаСостоянияКойкоМеста = "Недоступность" Тогда
				ТекстОшибки = "Койка не существует, или недоступна в какой-то момент времени периода.";	
			Иначе
				Если Строка(стрТБ.Документ) = "" Тогда 
					БлокирующийДокумент =  "";
				Иначе 
					БлокирующийДокумент = " документом " + Строка(стрТБ.Документ);
				КонецЕсли;
				
				ТекстДатаКон = ?(ЗначениеЗаполнено(стрТБ.ДатаОкончания), " по " + Формат(стрТБ.ДатаОкончания,"ДФ='dd.MM.yyyy HH:mm'"), " бессрочно");
				ТекстКонцовка = " с " + Формат(стрТБ.ДатаНачала,"ДФ='dd.MM.yyyy HH:mm'") + ТекстДатаКон + БлокирующийДокумент + ?(ЗначениеЗаполнено(стрТБ.Клиент)," пациентом " + стрТБ.Клиент,"");
				
				Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.БронированиеКойкоМеста") Тогда
					
					ТекстОшибки = "Для койко-места " + стрТБ.КойкоМестоТекст + " бронирование невозможно, так как оно уже занято" + ТекстКонцовка;
					
				ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УстановкаУсловийПребывания") Тогда
					
					ТекстОшибки = "Пациента " + Клиент + " невозможно разместить на койко-месте " + стрТБ.КойкоМестоТекст + ", так как оно уже занято" + ТекстКонцовка;
				КонецЕсли;
			КонецЕсли;
			ОбщегоНазначения.СообщитьОбОшибке(ТекстОшибки,Отказ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьДвиженияПоРегиструСостояниеКойкоМеста(ДокументОбъект,СостояниеКойкоМеста,Отказ)
	
	НаборДвижений = ДокументОбъект.Движения.СостояниеКойкоМеста;
	ТаблицаДвижений = НаборДвижений.Выгрузить();
	
	Койка = ПолучитьОсвобождаемоеКойкоМесто(ДокументОбъект.Ссылка, ДокументОбъект.Клиент, ДокументОбъект.ДатаНачала);
	
	// Заполним таблицу движений.
	НоваяЗапись = ТаблицаДвижений.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, ДокументОбъект);
	НоваяЗапись.Состояние 			= СостояниеКойкоМеста;
	НоваяЗапись.КойкоМесто 			= ?(СостояниеКойкоМеста = Справочники.ВидыСостоянийКойкоМест.Свободно, Койка, НоваяЗапись.КойкоМесто);
	НоваяЗапись.ДатаОкончания 		= ?(НоваяЗапись.ДатаОкончания = Дата(1,1,1), Дата(3999, 12, 31, 23, 59, 59), НоваяЗапись.ДатаОкончания);
	
	// Для изменения условий создаем выписку из предыдущей палаты
	Если СостояниеКойкоМеста <> Справочники.ВидыСостоянийКойкоМест.Бронь
		И (ДокументОбъект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.ИзменениеУсловий
			Или ДокументОбъект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.ПереводМеждуПодразделениями)
		И Койка <> НоваяЗапись.КойкоМесто 
	Тогда
		ЗаписьВыписка = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьВыписка, ДокументОбъект);
		ЗаписьВыписка.КойкоМесто 		= Койка;
		ЗаписьВыписка.Состояние	 		= Справочники.ВидыСостоянийКойкоМест.Свободно;
		ЗаписьВыписка.ДатаОкончания 	= ?(ЗаписьВыписка.ДатаОкончания = Дата(1,1,1), Дата(3999, 12, 31, 23, 59, 59), ЗаписьВыписка.ДатаОкончания);
	КонецЕсли;
	
	НаборДвижений.мПериод           = ДокументОбъект.ДатаНачала;
	НаборДвижений.мТаблицаДвижений  = ТаблицаДвижений;
	
	Если Не Отказ Тогда
		НаборДвижений.ВыполнитьДвижения();
	КонецЕсли;
	
КонецПроцедуры

// Возвращает предыдущую занятую клиентом койку
//
// Параметры:
//	ДокументСсылка.УстановкаУсловийПребывания	- Документ, по которому клиент освобождает койку
//  Клиент	 									- СправочникСсылка.Клиенты	 - Клиент
//  Период	 									- Дата	 - Период, на который нужно найти койку
// 
// Возвращаемое значение:
// СправочникСсыкла.КойкоМесто  - Последняя занятая клиентом койка
//
Функция ПолучитьОсвобождаемоеКойкоМесто(Документ, Клиент, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостояниеКойкоМестаСрезПоследних.КойкоМесто КАК КойкоМесто
	               |ИЗ
	               |	РегистрСведений.СостояниеКойкоМеста.СрезПоследних(
	               |			&Период,
	               |			Клиент = &Клиент
	               |				И Регистратор <> &Документ
	               |				И Состояние <> ЗНАЧЕНИЕ(Справочник.ВидыСостоянийКойкоМест.Свободно)
	               |				И Состояние <> ЗНАЧЕНИЕ(Справочник.ВидыСостоянийКойкоМест.Бронь)) КАК СостояниеКойкоМестаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СостояниеКойкоМестаСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Период", Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КойкоМесто;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

Процедура ВыполнитьДвиженияПоРегиструКлиентыСтационара(ДокументОбъект, ДокументПоступления, Отказ, Выписан = Ложь)
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УстановкаУсловийПребывания") Тогда 
		
		НаборДвижений = ДокументОбъект.Движения.КлиентыСтационара;
		ТаблицаДвижений = НаборДвижений.Выгрузить();
		// Заполним таблицу движений.
		СтрокаДвижения = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДвижения,ДокументОбъект);
		СтрокаДвижения.ДокументПоступления = ДокументПоступления;
		СтрокаДвижения.Выписан = Выписан;
		
		НаборДвижений.мПериод           = ДокументОбъект.Дата;
		НаборДвижений.мТаблицаДвижений  = ТаблицаДвижений;
		Если Не Отказ Тогда
			НаборДвижений.ВыполнитьДвижения();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


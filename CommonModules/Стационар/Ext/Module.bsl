КонецПроцедуры

Процедура ПолучитьЗанятостьКойкоМест(СтруктураДанных,ТаблицаСостоянияКойкоМест)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СостояниеКойкоМеста.Клиент КАК Клиент,
	                      |	СостояниеКойкоМеста.КойкоМесто КАК КойкоМесто,
	                      |	СостояниеКойкоМеста.ДатаНачала КАК ДатаНачала,
	                      |	СостояниеКойкоМеста.ДатаОкончания КАК ДатаОкончания,
	                      |	СостояниеКойкоМеста.Регистратор КАК Документ,
	                      |	ВЫБОР
	                      |		КОГДА СостояниеКойкоМеста.Регистратор ССЫЛКА Документ.БронированиеКойкоМеста
	                      |			ТОГДА ""Бронирование""
	                      |		ИНАЧЕ ""ИзменениеУсловий""
	                      |	КОНЕЦ КАК ПричинаСостоянияКойкоМеста,
	                      |	СостояниеКойкоМеста.КойкоМесто.Представление КАК КойкоМестоТекст
	                      |ПОМЕСТИТЬ ЗанятостьКойки
	                      |ИЗ
	                      |	РегистрСведений.СостояниеКойкоМеста.СрезПоследних(&Дата) КАК СостояниеКойкоМеста
	                      |ГДЕ
	                      |	СостояниеКойкоМеста.Регистратор <> &ДокументСсылка
	                      |	И СостояниеКойкоМеста.Клиент <> &Клиент
	                      |	И СостояниеКойкоМеста.КойкоМесто = &КойкоМесто
	                      |	И (&ДатаНачала МЕЖДУ СостояниеКойкоМеста.ДатаНачала И ВЫБОР
	                      |				КОГДА СостояниеКойкоМеста.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	                      |					ТОГДА ДАТАВРЕМЯ(3999, 12, 31, 23, 59, 59)
	                      |				ИНАЧЕ СостояниеКойкоМеста.ДатаОкончания
	                      |			КОНЕЦ
	                      |			ИЛИ &ДатаОкончания МЕЖДУ СостояниеКойкоМеста.ДатаНачала И ВЫБОР
	                      |				КОГДА СостояниеКойкоМеста.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	                      |					ТОГДА ДАТАВРЕМЯ(3999, 12, 31, 23, 59, 59)
	                      |				ИНАЧЕ СостояниеКойкоМеста.ДатаОкончания
	                      |			КОНЕЦ
	                      |			ИЛИ &ДатаНачала <= СостояниеКойкоМеста.ДатаНачала
	                      |				И &ДатаОкончания >= ВЫБОР
	                      |					КОГДА СостояниеКойкоМеста.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	                      |						ТОГДА ДАТАВРЕМЯ(3999, 12, 31, 23, 59, 59)
	                      |					ИНАЧЕ СостояниеКойкоМеста.ДатаОкончания
	                      |				КОНЕЦ)
	                      |	И СостояниеКойкоМеста.Состояние <> ЗНАЧЕНИЕ(Справочник.ВидыСостоянийКойкоМест.Свободно)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ЗанятостьКойки.Документ КАК Документ,
	                      |	МИНИМУМ(СостояниеКойкоМеста.ДатаОкончания) КАК АктуальнаяДатаОкончания
	                      |ПОМЕСТИТЬ АктуальныеДатыОкончания
	                      |ИЗ
	                      |	ЗанятостьКойки КАК ЗанятостьКойки
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеКойкоМеста КАК СостояниеКойкоМеста
	                      |		ПО ЗанятостьКойки.Клиент = СостояниеКойкоМеста.Клиент
	                      |			И ЗанятостьКойки.КойкоМесто = СостояниеКойкоМеста.КойкоМесто
	                      |			И ЗанятостьКойки.ДатаНачала <= СостояниеКойкоМеста.ДатаНачала
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ЗанятостьКойки.Документ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ЗанятостьКойки.Клиент КАК Клиент,
	                      |	ЗанятостьКойки.КойкоМесто КАК КойкоМесто,
	                      |	ЗанятостьКойки.ДатаНачала КАК ДатаНачала,
	                      |	АктуальныеДатыОкончания.АктуальнаяДатаОкончания КАК ДатаОкончания,
	                      |	ЗанятостьКойки.Документ КАК Документ,
	                      |	ЗанятостьКойки.ПричинаСостоянияКойкоМеста КАК ПричинаСостоянияКойкоМеста,
	                      |	ЗанятостьКойки.КойкоМестоТекст КАК КойкоМестоТекст
	                      |ИЗ
	                      |	ЗанятостьКойки КАК ЗанятостьКойки
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ АктуальныеДатыОкончания КАК АктуальныеДатыОкончания
	                      |		ПО ЗанятостьКойки.Документ = АктуальныеДатыОкончания.Документ
	                      |ГДЕ
	                      |	ЕСТЬNULL(АктуальныеДатыОкончания.АктуальнаяДатаОкончания, ВЫБОР
	                      |				КОГДА ЗанятостьКойки.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	                      |					ТОГДА ДАТАВРЕМЯ(3999, 12, 31, 23, 59, 59)
	                      |				ИНАЧЕ ЗанятостьКойки.ДатаОкончания
	                      |			КОНЕЦ) >= &ДатаНачала");
						  
	Запрос.УстановитьПараметр("ДокументСсылка",СтруктураДанных.Ссылка);
	Запрос.УстановитьПараметр("Клиент"		  ,СтруктураДанных.Клиент);
	Запрос.УстановитьПараметр("КойкоМесто"	  ,СтруктураДанных.КойкоМесто);
	Запрос.УстановитьПараметр("ДатаНачала"	  ,СтруктураДанных.ДатаНачала);
	// Добавлено Макеев (
	Запрос.УстановитьПараметр("Дата"	  ,СтруктураДанных.Дата);
	// )
	Запрос.УстановитьПараметр("ДатаОкончания" ,?(СтруктураДанных.ДатаОкончания = Дата(1,1,1), Дата(3999, 12, 31, 23, 59, 59), СтруктураДанных.ДатаОкончания));
	
	ТаблицаСостоянияКойкоМест = Запрос.Выполнить().Выгрузить();
	
	ПроверитьДоступностьКойкоМеста(ТаблицаСостоянияКойкоМест, СтруктураДанных);
   
	УпорядочитьТаблицуПоПриоритетуСостояний(ТаблицаСостоянияКойкоМест);
	
КонецПроцедуры

Процедура ПроверитьДоступностьКойкоМеста(ТаблицаСостоянияКойкоМест, СтруктураДанных)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДвижениеКоечногоФондаСрезПоследних.Койка КАК Койка,
	               |	ДвижениеКоечногоФондаСрезПоследних.Статус КАК Статус,
	               |	""СостояниеНаНачало"" КАК ПричинаЗаписи,
	               |	ДвижениеКоечногоФондаСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ДвижениеКоечногоФонда.СрезПоследних(&ДатаНачала, Койка = &Койка) КАК ДвижениеКоечногоФондаСрезПоследних
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ДвижениеКоечногоФонда.Койка,
	               |	ДвижениеКоечногоФонда.Статус,
	               |	""Недоступность"" КАК ПричинаЗаписи,
	               |	ДвижениеКоечногоФонда.Период
	               |ИЗ
	               |	РегистрСведений.ДвижениеКоечногоФонда КАК ДвижениеКоечногоФонда
	               |ГДЕ
	               |	ДвижениеКоечногоФонда.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ДвижениеКоечногоФонда.Статус <> ЗНАЧЕНИЕ(Перечисление.СостоянияКоек.ПустаяСсылка)
				   |	И ДвижениеКоечногоФонда.Койка = &Койка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	
	Запрос.УстановитьПараметр("Койка",СтруктураДанных.КойкоМесто);
	Запрос.УстановитьПараметр("ДатаНачала",СтруктураДанных.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",?(СтруктураДанных.ДатаОкончания = Дата(1,1,1), Дата(3999, 12, 31, 23, 59, 59), СтруктураДанных.ДатаОкончания));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() 
		И Выборка.Количество() = 1 
		И Выборка.Статус = Перечисления.СостоянияКоек.ПустаяСсылка() 
	Тогда
		// Одна запись на начало периода о том, что койка свободна
		Возврат;	
	Иначе
		// Койки не существует на начало периода, или она становится недоступной на протяжении периода, 
		//или койку переместили в другую палату в будущем
		Строка = ТаблицаСостоянияКойкоМест.Добавить();
		Строка.КойкоМесто = СтруктураДанных.КойкоМесто;
		Строка.ПричинаСостоянияКойкоМеста = "Недоступность";
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьПациентов(СтруктураДанных,ТаблицаСостоянияКойкоМест,Отказ)
	
	Если Не Отказ Тогда 
	
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	КлиентыСтационараСрезПоследних.Клиент,
		                      |	КлиентыСтационараСрезПоследних.КойкоМесто,
		                      |	КлиентыСтационараСрезПоследних.ДатаНачала,
		                      |	КлиентыСтационараСрезПоследних.ДатаОкончания
		                      |ПОМЕСТИТЬ КлиентыСтационараСрезПоследнихНеВыписанные
		                      |ИЗ
		                      |	РегистрСведений.КлиентыСтационара.СрезПоследних(&ДатаПроведения, ) КАК КлиентыСтационараСрезПоследних
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	КлиентыСтационараСрезПоследнихНеВыписанные.Клиент.Представление КАК Клиент
		                      |ИЗ
		                      |	КлиентыСтационараСрезПоследнихНеВыписанные КАК КлиентыСтационараСрезПоследнихНеВыписанные
		                      |ГДЕ
		                      |	КлиентыСтационараСрезПоследнихНеВыписанные.КойкоМесто <> ЗНАЧЕНИЕ(Справочник.КойкоМеста.ПустаяСсылка)
		                      |	И КлиентыСтационараСрезПоследнихНеВыписанные.Клиент <> &Клиент
		                      |	И КлиентыСтационараСрезПоследнихНеВыписанные.КойкоМесто = &КойкоМесто");
							  
		Запрос.УстановитьПараметр("ДокументСсылка",СтруктураДанных.Ссылка);
		Запрос.УстановитьПараметр("ДатаПроведения",СтруктураДанных.Дата);
		Запрос.УстановитьПараметр("Клиент"		  ,СтруктураДанных.Клиент);
		Запрос.УстановитьПараметр("КойкоМесто"	  ,СтруктураДанных.КойкоМесто);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Текст = "Пациенты ";
		Пока Выборка.Следующий() Цикл 
			Текст = Текст + Выборка.Клиент + ", ";
		КонецЦикла;
		
		
		Если Текст <> "Пациенты " Тогда 
			Текст = СтрЗаменить(Текст + "**",", **","") + " не являются выписанными!";
			Возврат Текст;
		Иначе 
			Возврат "";
		КонецЕсли; 
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДокументПоступленияПациентаСтационара(Клиент, Дата) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КлиентыСтационараСрезПоследних.Клиент КАК Клиент,
	                      |	КлиентыСтационараСрезПоследних.ДокументПоступления КАК ДокументПоступления,
	                      |	КлиентыСтационараСрезПоследних.КойкоМесто КАК КойкоМесто,
	                      |	КлиентыСтационараСрезПоследних.ДатаНачала КАК ДатаНачала,
	                      |	КлиентыСтационараСрезПоследних.ДатаОкончания КАК ДатаОкончания,
	                      |	КлиентыСтационараСрезПоследних.Выписан КАК Выписан
	                      |ИЗ
	                      |	РегистрСведений.КлиентыСтационара.СрезПоследних(&Дата, Клиент = &Клиент) КАК КлиентыСтационараСрезПоследних
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДатаНачала УБЫВ");
						  
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Или Выборка.Выписан	Тогда
		Возврат Документы.УстановкаУсловийПребывания.ПустаяСсылка();
	Иначе
		Возврат Выборка.ДокументПоступления;
	КонецЕсли;
	
КонецФункции

Процедура ДвиженияПоРегиструУсловияПребывания(ДокументОбъект,ТаблицаПоУслугам, Отказ)
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УстановкаУсловийПребывания") И  ТаблицаПоУслугам.Количество() > 0 Тогда 
		
		НаборДвижений = ДокументОбъект.Движения.УсловияПребывания;
		ТаблицаДвижений = НаборДвижений.Выгрузить();
		// Заполним таблицу движений.
		Для Каждого стрТЗ Из ТаблицаПоУслугам Цикл 
			ЗаполнитьЗначенияСвойств(ТаблицаДвижений.Добавить(),стрТЗ);
		КонецЦикла;	
		НаборДвижений.мПериод           = ДокументОбъект.Дата;
		НаборДвижений.мТаблицаДвижений  = ТаблицаДвижений;
		Если Не Отказ Тогда
			НаборДвижений.ВыполнитьДвижения();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ДвиженияПоРегистрам
	
Функция ПолучитьТекстЗапросаТекущиеКлиентыСтационара(НуженОтборПоФилиалу = Ложь, ДополнительныеПоляЗапроса = Неопределено, ДополнительныеУсловия = Неопределено) Экспорт
	
	// Изменения Макеев 02-12-2025 (
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КлиентыСтационара.Клиент КАК Клиент,
	|	КлиентыСтационара.ДокументПоступления КАК ДокументПоступления,
	|	МАКСИМУМ(КлиентыСтационара.ДатаНачала) КАК ДатаНачала
	|ПОМЕСТИТЬ ПоследниеСостоянияКлиентовСтационара
	|ИЗ
	|	РегистрСведений.КлиентыСтационара КАК КлиентыСтационара
	|ГДЕ
	|	КлиентыСтационара.ДатаНачала <= КОНЕЦПЕРИОДА(&Дата, День)
	|
	|СГРУППИРОВАТЬ ПО
	|	КлиентыСтационара.Клиент,
	|	КлиентыСтационара.ДокументПоступления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Клиент,
	|	ДокументПоступления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КлиентыСтационара.Клиент,
	|	КлиентыСтационара.ДокументПоступления,
	|	КлиентыСтационара.КойкоМесто,
	|	КлиентыСтационара.ДатаНачала,
	|	КлиентыСтационара.ДатаОкончания,
	|	КлиентыСтационара.Выписан,
	|	ВЫБОР
	|		КОГДА КлиентыСтационара.ДокументПоступления.ДокументОбращения = ЗНАЧЕНИЕ(Документ.ОбращениеВСтационар.ПустаяСсылка)
	|				ИЛИ КлиентыСтационара.ДокументПоступления.ДокументОбращения.ДатаВремяПоступления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА КлиентыСтационара.ДокументПоступления.Дата
	|		ИНАЧЕ КлиентыСтационара.ДокументПоступления.ДокументОбращения.ДатаВремяПоступления
	|	КОНЕЦ КАК ДатаПоступления,
	|	КлиентыСтационара.Период КАК ДатаПоследнегоИзменения,
	|	КлиентыСтационара.КойкоМесто.Владелец.Подразделение КАК омг_Отделение,
	|	КлиентыСтационара.КойкоМесто.Владелец КАК Палата,
	|	КлиентыСтационара.ДокументПоступления.ДокументОбращения КАК ДокументОбращения,
	|	КлиентыСтационара.Регистратор
	|	//%ДополнительныеПоля%
	|ИЗ
	|	РегистрСведений.КлиентыСтационара КАК КлиентыСтационара
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследниеСостоянияКлиентовСтационара КАК ПоследниеСостоянияКлиентовСтационара
	|		ПО КлиентыСтационара.Клиент = ПоследниеСостоянияКлиентовСтационара.Клиент
	|			И КлиентыСтационара.ДокументПоступления = ПоследниеСостоянияКлиентовСтационара.ДокументПоступления
	|			И КлиентыСтационара.ДатаНачала = ПоследниеСостоянияКлиентовСтационара.ДатаНачала
	|ГДЕ
	|	НЕ КлиентыСтационара.Выписан
	|	//%ДополнительныеУсловия%
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПоступления
	|";
	
	Если НуженОтборПоФилиалу И ДополнительныеУсловия = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//%ДополнительныеУсловия%", "И Регистратор.Филиал = &Филиал");
	КонецЕсли;
	
	Если Не ДополнительныеУсловия = Неопределено Тогда
		СтрокаУсловий = "";
		Для Каждого Условие Из ДополнительныеУсловия Цикл
			СтрокаУсловий = СтрокаУсловий + " И " + Условие.Текст + " ";
		КонецЦикла;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//%ДополнительныеУсловия%", СтрокаУсловий);
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПоляЗапроса) = Тип("СписокЗначений") Тогда
		ТекстДопПолей = "";
		Для Каждого ЭлементСписка Из ДополнительныеПоляЗапроса Цикл
			
			ТекстДопПоля = "," + Символы.ПС + "КлиентыСтационара." + ЭлементСписка.Представление + " КАК " + ЭлементСписка.Значение;
			ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ТекстДопПолей, ТекстДопПоля, Символы.ПС);
			
		КонецЦикла;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//%ДополнительныеПоля%", ТекстДопПолей);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Только для возврата на сторону сервера

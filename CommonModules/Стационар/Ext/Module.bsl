				Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
	
Функция ПолучитьМедкартуИлиСсылкуПервичногоПриемаСтационара(Клиент, Дата, ВернутьПрием = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлиентыСтационараСрезПоследних.Клиент КАК Клиент,
		|	КлиентыСтационараСрезПоследних.ДокументПоступления.ДокументОбращения.МедицинскаяКарта КАК МедицинскаяКартаСтационара,
		|	КлиентыСтационараСрезПоследних.ДокументПоступления.ДокументОбращения.ДокументОснование КАК ПервичныйПрием
		|ПОМЕСТИТЬ СрезСтационара
		|ИЗ
		|	РегистрСведений.КлиентыСтационара.СрезПоследних(&Дата, Клиент = &Клиент) КАК КлиентыСтационараСрезПоследних
		|ГДЕ
		|	КлиентыСтационараСрезПоследних.ДокументПоступления.ДокументОбращения <> ЗНАЧЕНИЕ(Документ.ОбращениеВСтационар.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Прием.Ссылка КАК Ссылка,
		|	Прием.Дата КАК Дата,
		|	Прием.МедицинскаяКарта КАК МедицинскаяКарта
		|ПОМЕСТИТЬ ПриемыКлиента
		|ИЗ
		|	Документ.Прием КАК Прием
		|ГДЕ
		|	Прием.ЭтоПервичный
		|	И Прием.Клиент = &Клиент
		|	И Прием.МедицинскаяКарта.ВидКарты.ТипКарты = ЗНАЧЕНИЕ(Перечисление.ТипыМедицинскихКарт.Стационар)
		|	И Прием.Дата >= ДОБАВИТЬКДАТЕ(&Дата, День, -7)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПриемыКлиента.Ссылка КАК Ссылка,
		|	МИНИМУМ(ПриемыКлиента.Дата) КАК Дата,
		|	ПриемыКлиента.МедицинскаяКарта КАК МедицинскаяКарта
		|ПОМЕСТИТЬ МедкартаПервогоПриема
		|ИЗ
		|	ПриемыКлиента КАК ПриемыКлиента
		|
		|СГРУППИРОВАТЬ ПО
		|	ПриемыКлиента.Ссылка,
		|	ПриемыКлиента.МедицинскаяКарта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Выбор Когда СрезСтационара.ПервичныйПрием = Значение(Документ.Прием.ПустаяСсылка) Тогда 3 Иначе 1 Конец КАК Приоритет,
		|	СрезСтационара.МедицинскаяКартаСтационара КАК МедицинскаяКартаСтационара,
		|	СрезСтационара.ПервичныйПрием КАК Прием
		|ИЗ
		|	СрезСтационара КАК СрезСтационара
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Выбор Когда Прием.Ссылка = Значение(Документ.Прием.ПустаяСсылка) Тогда 4 Иначе 2 Конец,
		|	Прием.МедицинскаяКарта,
		|	Прием.Ссылка
		|ИЗ
		|	МедкартаПервогоПриема КАК Прием
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	5,
		|	МедицинскиеКарты.Ссылка,
		|	NULL
		|ИЗ
		|	Справочник.МедицинскиеКарты КАК МедицинскиеКарты
		|ГДЕ
		|	МедицинскиеКарты.Клиент = &Клиент
		|	И МедицинскиеКарты.ВидКарты.ТипКарты = ЗНАЧЕНИЕ(Перечисление.ТипыМедицинскихКарт.Стационар)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВернутьПрием = Неопределено Тогда
			Возврат Новый Структура("ПервичныйПрием, МедицинскаяКарта", ВыборкаДетальныеЗаписи.Прием, ВыборкаДетальныеЗаписи.МедицинскаяКартаСтационара);  
		Иначе	
			Возврат ?(ВернутьПрием, ВыборкаДетальныеЗаписи.Прием, ВыборкаДетальныеЗаписи.МедицинскаяКартаСтационара);
		КонецЕсли;
	Иначе
		Если ВернутьПрием = Неопределено Тогда
			Возврат Новый Структура("ПервичныйПрием, МедицинскаяКарта");  
		Иначе	
			Возврат ?(ВернутьПрием, Документы.Прием.ПустаяСсылка(), Справочники.МедицинскиеКарты.ПустаяСсылка());
		КонецЕсли;
	КонецЕсли;
			
КонецФункции

Функция ПолучитьОписаниеПребыванияПациентаВСтационареПоМедкарте(МедицинскаяКарта) Экспорт
	
	Результат = Новый Структура("МедицинскаяКарта, Обращение, ПервичныйПрием, ДокументПоступления, 
								|ДатаПоступления, ДатаВыписки, ПалатаПоступления, КойкоМестоПоступления",
								МедицинскаяКарта);
	
	// Получаем документ обращения в стационар по медкарте
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МедицинскаяКарта", МедицинскаяКарта);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбращениеВСтационар.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОбращениеВСтационар КАК ОбращениеВСтационар
	|ГДЕ
	|	ОбращениеВСтационар.МедицинскаяКарта = &МедицинскаяКарта
	|	И НЕ ОбращениеВСтационар.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбращениеВСтационар.Дата УБЫВ"
	;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Результат.Обращение = Выборка.Ссылка;
		
		// Получаем дату поступления и дату выписки
		ДанныеПребывания = ДанныеПребыванияПоОбращению(Результат.Обращение);
		
		ЗаполнитьЗначенияСвойств(Результат, ДанныеПребывания);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбращениеПоМедкарте(МедицинскаяКарта, ДокументыИсключения = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(МедицинскаяКарта) Тогда
		Возврат Документы.ОбращениеВСтационар.ПустаяСсылка(); 	
	КонецЕсли;
	
	// Получаем документ обращения в стационар по медкарте
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МедицинскаяКарта", МедицинскаяКарта);
	Запрос.УстановитьПараметр("ДокументыИсключения", ДокументыИсключения);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбращениеВСтационар.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОбращениеВСтационар КАК ОбращениеВСтационар
	|ГДЕ
	|	ОбращениеВСтационар.МедицинскаяКарта = &МедицинскаяКарта
	|	И (&ДокументыИсключения = НЕОПРЕДЕЛЕНО ИЛИ ОбращениеВСтационар.Ссылка НЕ В (&ДокументыИсключения))
	|	И НЕ ОбращениеВСтационар.ПометкаУдаления
	|	И НЕ ОбращениеВСтационар.ОтказВГоспитализации
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбращениеВСтационар.Дата УБЫВ"
	;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Документы.ОбращениеВСтационар.ПустаяСсылка()
	КонецЕсли;
	
КонецФункции

Функция ДанныеПребыванияПоОбращению(ОбращениеВСтационар)
	
	ДанныеПребывания = Новый Структура("ДатаПоступления, ДатаВыписки, ДокументПоступления, ПалатаПоступления, КойкоМестоПоступления");
	
	// Запрос получения даты поступления.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбращениеВСтационар", ОбращениеВСтационар);
	Запрос.УстановитьПараметр("ВидДвижения", Перечисления.ВидыДвиженияВСтационаре.Поступление);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлиентыСтационара.ДокументПоступления КАК ДокументПоступления,
	|	КлиентыСтационара.ДатаНачала КАК ДатаПоступления,
	|	КлиентыСтационара.ДокументПоступления.Палата КАК ПалатаПоступления,
	|	КлиентыСтационара.ДокументПоступления.КойкоМесто КАК КойкоМестоПоступления
	|ИЗ
	|	РегистрСведений.КлиентыСтационара КАК КлиентыСтационара
	|ГДЕ
	|	КлиентыСтационара.ДокументПоступления.ДокументОбращения = &ОбращениеВСтационар
	|	И КлиентыСтационара.ДокументПоступления.ВидОперации = &ВидДвижения"
	;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеПребывания, Выборка);
		
		// Получение даты выписки по этому документу поступления
		Запрос.УстановитьПараметр("ДокументПоступления", Выборка.ДокументПоступления);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлиентыСтационара.ДатаНачала КАК ДатаВыписки
		|ИЗ
		|	РегистрСведений.КлиентыСтационара КАК КлиентыСтационара
		|ГДЕ
		|	КлиентыСтационара.ДокументПоступления = &ДокументПоступления
		|	И КлиентыСтационара.Выписан"
		;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДанныеПребывания.ДатаВыписки = Выборка.ДатаВыписки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеПребывания;
	
КонецФункции


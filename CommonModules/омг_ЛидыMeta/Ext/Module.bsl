// Загрузка лидов из Meta Lead Ads (лид-формы Facebook и Instagram) через Graph API.
//
// Настройка источника трафика с типом «Meta Lead Ads»:
//  - ИдентификаторСтраницы — ID страницы Facebook, к которой привязаны лид-формы;
//  - ИдентификаторыФорм — ID лид-форм через запятую или по строке (пусто — все активные формы страницы);
//  - токен доступа (команда «Указать токен доступа») — токен системного пользователя Business Manager
//    с разрешениями leads_retrieval, pages_show_list, pages_read_engagement, pages_manage_ads
//    и доступом к странице. Хранится в безопасном хранилище.
//
// Лиды забираются регламентным заданием омг_ЗагрузкаЛидовMeta. Дополнительно можно подписать
// приложение Meta на событие leadgen страницы с адресом вебхука источника — тогда лид приходит сразу,
// а задание служит страховкой. Повторно загруженный лид не дублируется (ВнешнийИдентификатор = ID лида).

#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания омг_ЗагрузкаЛидовMeta.
//
Процедура ЗагрузитьЛидыПоРасписанию() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Источники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.омг_ИсточникиТрафика КАК Источники
	|ГДЕ
	|	Источники.ТипИсточника = ЗНАЧЕНИЕ(Перечисление.омг_ТипыИсточниковЛидов.Meta)
	|	И Источники.Используется
	|	И НЕ Источники.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ЗагрузитьЛиды(Выборка.Ссылка);
		Исключение
			// Ошибка уже записана в журнал и в состояние загрузки источника.
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Загружает новые лиды всех форм источника.
//
// Параметры:
//  Источник - СправочникСсылка.омг_ИсточникиТрафика
//
// Возвращаемое значение:
//  Структура - Получено, Создано (Число), Ошибка (Строка).
//
Функция ЗагрузитьЛиды(Источник) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура("Получено, Создано, Ошибка", 0, 0, "");
	ТекущееСостояние = СостояниеЗагрузки(Источник);
	ЗагруженоПо = ТекущееСостояние.ЗагруженоПо;
	Если Не ЗначениеЗаполнено(ЗагруженоПо) Тогда
		ЗагруженоПо = ТекущаяУниверсальнаяДата() - ГлубинаПервойЗагрузки();
	КонецЕсли;
	НовоеЗагруженоПо = ЗагруженоПо;
	
	Попытка
		Подключение = ПодключениеИсточника(Источник);
		// Небольшой нахлёст: лиды, пришедшие на границе, не теряются, повторы отсекаются по ID.
		Фильтр = СтрШаблон("[{""field"":""time_created"",""operator"":""GREATER_THAN"",""value"":%1}]",
			Формат(ЗагруженоПо - Дата(1970, 1, 1) - 3600, "ЧГ=0"));
		
		Для Каждого ИдентификаторФормы Из ФормыИсточника(Подключение) Цикл
			Адрес = СтрШаблон("/%1/%2/leads?fields=%3&limit=100&filtering=%4&access_token=%5",
				ВерсияAPI(), ИдентификаторФормы, ПоляЛида(),
				КодироватьСтроку(Фильтр, СпособКодированияСтроки.КодировкаURL), Подключение.Токен);
			Пока ЗначениеЗаполнено(Адрес) Цикл
				Ответ = ВыполнитьЗапрос(Адрес);
				Данные = Ответ.Получить("data");
				Если ТипЗнч(Данные) = Тип("Массив") Тогда
					Для Каждого ДанныеЛида Из Данные Цикл
						Результат.Получено = Результат.Получено + 1;
						Если ЗарегистрироватьЛид(Источник, ДанныеЛида) Тогда
							Результат.Создано = Результат.Создано + 1;
						КонецЕсли;
						ДатаЛида = ДатаGraphAPI(ДанныеЛида.Получить("created_time"));
						Если ДатаЛида > НовоеЗагруженоПо Тогда
							НовоеЗагруженоПо = ДатаЛида;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Адрес = СледующаяСтраница(Ответ);
			КонецЦикла;
		КонецЦикла;
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.омг_ИсточникиТрафика, Источник, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		// Часть форм могла не загрузиться — метку не сдвигаем, повторы отсекутся по ID лида.
		НовоеЗагруженоПо = ТекущееСостояние.ЗагруженоПо;
		ТекстРезультата = НСтр("ru = 'Ошибка: '") + Результат.Ошибка;
	Иначе
		ТекстРезультата = СтрШаблон(НСтр("ru = 'Получено лидов: %1, новых: %2'"), Результат.Получено, Результат.Создано);
	КонецЕсли;
	ЗаписатьСостояниеЗагрузки(Источник, НовоеЗагруженоПо, ТекстРезультата);
	
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ВызватьИсключение Результат.Ошибка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Загружает один лид по его ID (из уведомления вебхука leadgen).
//
// Параметры:
//  Источник - СправочникСсылка.омг_ИсточникиТрафика
//  ИдентификаторЛида - Строка
//
// Возвращаемое значение:
//  Булево - Истина, если создан новый лид.
//
Функция ЗагрузитьЛид(Источник, ИдентификаторЛида) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Подключение = ПодключениеИсточника(Источник);
	Адрес = СтрШаблон("/%1/%2?fields=%3&access_token=%4", ВерсияAPI(),
		КодироватьСтроку(ИдентификаторЛида, СпособКодированияСтроки.КодировкаURL), ПоляЛида(), Подключение.Токен);
	Возврат ЗарегистрироватьЛид(Источник, ВыполнитьЗапрос(Адрес));
	
КонецФункции

// ID лидов из тела уведомления вебхука Meta (object = page, field = leadgen).
//
// Параметры:
//  Тело - Строка - JSON.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИдентификаторыЛидовИзУведомления(Тело) Экспорт
	
	Идентификаторы = Новый Массив;
	Если Не ЗначениеЗаполнено(Тело) Тогда
		Возврат Идентификаторы;
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело);
	Уведомление = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Если ТипЗнч(Уведомление) <> Тип("Соответствие") Тогда
		Возврат Идентификаторы;
	КонецЕсли;
	
	Записи = Уведомление.Получить("entry");
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Возврат Идентификаторы;
	КонецЕсли;
	Для Каждого Запись Из Записи Цикл
		Изменения = Запись.Получить("changes");
		Если ТипЗнч(Изменения) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Изменение Из Изменения Цикл
			Значение = Изменение.Получить("value");
			Если Изменение.Получить("field") = "leadgen" И ТипЗнч(Значение) = Тип("Соответствие") Тогда
				Идентификатор = Значение.Получить("leadgen_id");
				Если Идентификатор <> Неопределено Тогда
					Идентификаторы.Добавить(СтрокаИдентификатора(Идентификатор));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Идентификаторы;
	
КонецФункции

// Сохраняет токен доступа источника в безопасном хранилище.
//
// Параметры:
//  Источник - СправочникСсылка.омг_ИсточникиТрафика
//  Токен - Строка - пустая строка удаляет токен.
//
Процедура СохранитьТокен(Источник, Токен) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Если ЗначениеЗаполнено(Токен) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Источник, СокрЛП(Токен), КлючТокена());
	Иначе
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(Источник, КлючТокена());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяСобытияЖурнала()
	
	Возврат НСтр("ru = 'Лиды.Загрузка из Meta'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

Функция ВерсияAPI()
	
	Возврат "v24.0";
	
КонецФункции

// Сколько секунд назад забирать лиды при первой загрузке источника.
//
Функция ГлубинаПервойЗагрузки()
	
	Возврат 86400;
	
КонецФункции

Функция КлючТокена()
	
	Возврат "ТокенДоступа";
	
КонецФункции

Функция ПоляЛида()
	
	Возврат "id,created_time,field_data,form_id,ad_id,ad_name,adset_name,campaign_name,platform,is_organic";
	
КонецФункции

// Токен страницы и настройки источника.
//
Функция ПодключениеИсточника(Источник)
	
	Настройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "ИдентификаторСтраницы, ИдентификаторыФорм");
	ИдентификаторСтраницы = СокрЛП(Настройки.ИдентификаторСтраницы);
	Если Не ЗначениеЗаполнено(ИдентификаторСтраницы) Тогда
		ВызватьИсключение НСтр("ru = 'В источнике трафика не указан ID страницы Facebook'");
	КонецЕсли;
	
	Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Источник, КлючТокена());
	Если Не ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение НСтр("ru = 'В источнике трафика не указан токен доступа Meta'");
	КонецЕсли;
	
	// Лиды читаются токеном страницы; токен системного пользователя меняем на него.
	Адрес = СтрШаблон("/%1/%2?fields=access_token&access_token=%3", ВерсияAPI(),
		КодироватьСтроку(ИдентификаторСтраницы, СпособКодированияСтроки.КодировкаURL), Токен);
	Ответ = ВыполнитьЗапрос(Адрес);
	ТокенСтраницы = Ответ.Получить("access_token");
	Если ЗначениеЗаполнено(ТокенСтраницы) Тогда
		Токен = ТокенСтраницы;
	КонецЕсли;
	
	Подключение = Новый Структура;
	Подключение.Вставить("ИдентификаторСтраницы", ИдентификаторСтраницы);
	Подключение.Вставить("ИдентификаторыФорм", Настройки.ИдентификаторыФорм);
	Подключение.Вставить("Токен", КодироватьСтроку(Токен, СпособКодированияСтроки.КодировкаURL));
	Возврат Подключение;
	
КонецФункции

Функция ФормыИсточника(Подключение)
	
	Формы = Новый Массив;
	Текст = СтрЗаменить(СтрЗаменить(Подключение.ИдентификаторыФорм, ";", ","), Символы.ПС, ",");
	Для Каждого Идентификатор Из СтрРазделить(Текст, ", ", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Идентификатор)) Тогда
			Формы.Добавить(СокрЛП(Идентификатор));
		КонецЕсли;
	КонецЦикла;
	Если Формы.Количество() > 0 Тогда
		Возврат Формы;
	КонецЕсли;
	
	// Все активные лид-формы страницы.
	Адрес = СтрШаблон("/%1/%2/leadgen_forms?fields=id,status&limit=100&access_token=%3", ВерсияAPI(),
		КодироватьСтроку(Подключение.ИдентификаторСтраницы, СпособКодированияСтроки.КодировкаURL), Подключение.Токен);
	Пока ЗначениеЗаполнено(Адрес) Цикл
		Ответ = ВыполнитьЗапрос(Адрес);
		Данные = Ответ.Получить("data");
		Если ТипЗнч(Данные) = Тип("Массив") Тогда
			Для Каждого Форма Из Данные Цикл
				Если Форма.Получить("status") = "ACTIVE" Тогда
					Формы.Добавить(СтрокаИдентификатора(Форма.Получить("id")));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Адрес = СледующаяСтраница(Ответ);
	КонецЦикла;
	
	Возврат Формы;
	
КонецФункции

// Создаёт лид из ответа Graph API.
//
// Возвращаемое значение:
//  Булево - Истина, если создан новый лид (не повтор и не дописан в действующий).
//
Функция ЗарегистрироватьЛид(Источник, ДанныеЛида)
	
	Если ТипЗнч(ДанныеЛида) <> Тип("Соответствие") Или ДанныеЛида.Получить("id") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИдентификаторЛида = СтрокаИдентификатора(ДанныеЛида.Получить("id"));
	
	Поля = Новый Массив;
	ДобавитьПоле(Поля, "leadid", ИдентификаторЛида);
	ПоляФормы = ДанныеЛида.Получить("field_data");
	Если ТипЗнч(ПоляФормы) = Тип("Массив") Тогда
		Для Каждого Поле Из ПоляФормы Цикл
			Значения = Поле.Получить("values");
			Если ТипЗнч(Значения) = Тип("Массив") Тогда
				Строки = Новый Массив;
				Для Каждого Значение Из Значения Цикл
					Строки.Добавить(Строка(Значение));
				КонецЦикла;
				ДобавитьПоле(Поля, Поле.Получить("name"), СтрСоединить(Строки, ", "));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Платформа = НРег(Строка(ДанныеЛида.Получить("platform")));
	Если Платформа = "ig" Тогда
		Платформа = "instagram";
	ИначеЕсли Платформа = "fb" Или Не ЗначениеЗаполнено(Платформа) Тогда
		Платформа = "facebook";
	КонецЕсли;
	ДобавитьПоле(Поля, "utm_source", Платформа);
	ДобавитьПоле(Поля, "utm_medium", ?(ДанныеЛида.Получить("is_organic") = Истина, "organic", "lead_ads"));
	ДобавитьПоле(Поля, "utm_campaign", ДанныеЛида.Получить("campaign_name"));
	ДобавитьПоле(Поля, "utm_term", ДанныеЛида.Получить("adset_name"));
	ДобавитьПоле(Поля, "utm_content", ДанныеЛида.Получить("ad_name"));
	ДобавитьПоле(Поля, "formid", ДанныеЛида.Получить("form_id"));
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, ДанныеЛида);
	ИсходныеДанные = Запись.Закрыть();
	
	Если ЗначениеЗаполнено(омг_ЛидыВходящиеЗаявки.НайтиЛидПоВнешнемуИдентификатору(Источник, ИдентификаторЛида)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Лид = омг_ЛидыВходящиеЗаявки.ЗарегистрироватьЗаявку(Источник, Поля, ИсходныеДанные);
	Возврат ЗначениеЗаполнено(Лид)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Лид, "ВнешнийИдентификатор") = ИдентификаторЛида;
	
КонецФункции

// ID в Graph API — строки, но в уведомлениях вебхука могут прийти числом.
//
Функция СтрокаИдентификатора(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

Процедура ДобавитьПоле(Поля, Имя, Значение)
	
	Если Имя = Неопределено Или Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Поля.Добавить(Новый Структура("Имя, Значение", СокрЛП(Строка(Имя)), СокрЛП(Строка(Значение))));
	
КонецПроцедуры

// GET к graph.facebook.com.
//
// Параметры:
//  Адрес - Строка - путь с параметрами, начиная с "/".
//
// Возвращаемое значение:
//  Соответствие - ответ JSON.
//
Функция ВыполнитьЗапрос(Адрес)
	
	Соединение = Новый HTTPСоединение("graph.facebook.com", 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
	Ответ = Соединение.Получить(Новый HTTPЗапрос(Адрес));
	Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	
	Данные = Неопределено;
	Если ЗначениеЗаполнено(Текст) Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Текст);
			Данные = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
		Исключение
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Соответствие") И ТипЗнч(Данные.Получить("error")) = Тип("Соответствие") Тогда
		Ошибка = Данные.Получить("error");
		// Адрес не выводим: в нём токен.
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Meta Graph API: %1 (код %2)'"),
			Ошибка.Получить("message"), Ошибка.Получить("code"));
	КонецЕсли;
	Если Ответ.КодСостояния <> 200 Или ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Meta Graph API: ответ %1'"), Ответ.КодСостояния);
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция СледующаяСтраница(Ответ)
	
	Страницы = Ответ.Получить("paging");
	Если ТипЗнч(Страницы) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Следующая = Страницы.Получить("next");
	Если Не ЗначениеЗаполнено(Следующая) Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Следующая, "graph.facebook.com");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Следующая, Позиция + СтрДлина("graph.facebook.com"));
	
КонецФункции

// "2026-11-16T09:12:33+0000" -> дата UTC.
//
Функция ДатаGraphAPI(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Значение, 19), "-", ""), ":", ""), "T", "");
	Попытка
		Возврат Дата(Цифры);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

Функция СостояниеЗагрузки(Источник)
	
	ДанныеСостояния = Новый Структура("ЗагруженоПо", Дата(1, 1, 1));
	Запись = РегистрыСведений.омг_СостояниеЗагрузкиЛидов.СоздатьМенеджерЗаписи();
	Запись.ИсточникТрафика = Источник;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		ДанныеСостояния.ЗагруженоПо = Запись.ЗагруженоПо;
	КонецЕсли;
	Возврат ДанныеСостояния;
	
КонецФункции

Процедура ЗаписатьСостояниеЗагрузки(Источник, ЗагруженоПо, ТекстРезультата)
	
	Запись = РегистрыСведений.омг_СостояниеЗагрузкиЛидов.СоздатьМенеджерЗаписи();
	Запись.ИсточникТрафика = Источник;
	Запись.ЗагруженоПо = ЗагруженоПо;
	Запись.ДатаЗагрузки = ТекущаяДатаСеанса();
	Запись.Результат = ТекстРезультата;
	Запись.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти

// Серверные вызовы для работы с лидами из клиентских форм:
// окно входящего трафика и вкладка «Лиды» в «Массовых обзвонах».

#Область ПрограммныйИнтерфейс

// Назначить лид на текущего пользователя.
//
// Возвращаемое значение:
//  Строка - текст ошибки, пустая строка при успехе.
//
Функция ВзятьВРаботу(Лид) Экспорт
	
	Возврат омг_ЛидыСервер.ВзятьВРаботу(Лид);
	
КонецФункции

// Телефон для звонка; незакрытый лид при этом берётся в работу.
//
// Возвращаемое значение:
//  Структура - Телефон, ТекстОшибки.
//
Функция ДанныеДляЗвонка(Лид) Экспорт
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Лид, "Телефон, Статус");
	Результат = Новый Структура("Телефон, ТекстОшибки", Реквизиты.Телефон, "");
	Если Не ЗначениеЗаполнено(Реквизиты.Телефон) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У лида не указан телефон.'");
		Возврат Результат;
	КонецЕсли;
	Если Не омг_ЛидыСервер.ЭтоЗавершающийСтатус(Реквизиты.Статус) Тогда
		Результат.ТекстОшибки = омг_ЛидыСервер.ВзятьВРаботу(Лид);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Подготовка к записи на приём или открытию карточки пациента.
//
// Возвращаемое значение:
//  Структура - Клиент (найденный по телефону или привязанный), Телефон, ФИО, ТекстОшибки.
//
Функция ПодготовитьЗапись(Лид) Экспорт
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Лид, "Телефон, Имя, Статус");
	Результат = Новый Структура("Клиент, Телефон, ФИО, ТекстОшибки", Неопределено, Реквизиты.Телефон,
		СокрЛП(Реквизиты.Имя), "");
	
	Если Реквизиты.Статус = Перечисления.омг_СтатусыЛидов.Упущен
		Или Реквизиты.Статус = Перечисления.омг_СтатусыЛидов.Нецелевой Тогда
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Лид закрыт со статусом «%1».'"), Реквизиты.Статус);
		Возврат Результат;
	КонецЕсли;
	Если Не омг_ЛидыСервер.ЭтоЗавершающийСтатус(Реквизиты.Статус) Тогда
		ТекстОшибки = омг_ЛидыСервер.ВзятьВРаботу(Лид);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Результат.ТекстОшибки = ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат.Клиент = омг_ЛидыСервер.ОбеспечитьКлиента(Лид);
	Возврат Результат;
	
КонецФункции

Процедура ПривязатьКлиента(Лид, Клиент) Экспорт
	
	омг_ЛидыСервер.ПривязатьКлиента(Лид, Клиент);
	
КонецПроцедуры

Функция ПараметрыЗаписи(Лид) Экспорт
	
	Возврат омг_ЛидыСервер.ПараметрыЗаписиПоЛиду(Лид);
	
КонецФункции

// Ключ очереди: количество и дата самого свежего лида, ещё никем не взятого в работу.
//
// Возвращаемое значение:
//  Строка - "<количество>|<дата>".
//
Функция КлючНовыхЛидов() Экспорт
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.омг_Лид) Тогда
		Возврат "0|";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Лид.Ссылка) КАК Количество,
	|	МАКСИМУМ(Лид.Дата) КАК Дата
	|ИЗ
	|	Документ.омг_Лид КАК Лид
	|ГДЕ
	|	Лид.Статус В (&Статусы)
	|	И Лид.Ответственный = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	И НЕ Лид.ПометкаУдаления";
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.омг_СтатусыЛидов.Новый);
	Статусы.Добавить(Перечисления.омг_СтатусыЛидов.Пропущен);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Количество) Тогда
		Возврат Формат(Выборка.Количество, "ЧГ=0") + "|" + Формат(Выборка.Дата, "ДФ=yyyyMMddHHmmss");
	КонецЕсли;
	Возврат "0|";
	
КонецФункции

#КонецОбласти

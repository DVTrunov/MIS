// Структурированные протоколы приёма (прототип).
//
// Шаблон протокола (справочник омг_ШаблоныПротоколов) описывается разделами и полями.
// Врач заполняет протокол в HTML-форме (обработка омг_ПротоколПриема), значения хранятся
// в регистре омг_ЗначенияПолейПротоколов по одной записи на поле (для таблиц - на ячейку),
// печатная форма строится табличным документом на сервере, поэтому печать и PDF работают
// одинаково в тонком клиенте и в браузере.
//
// Шаблон можно загрузить из документа Word (.docx), см. ПрочитатьШаблонИзWord.

#Область ПрограммныйИнтерфейс

// Возвращает модель протокола: шапку, разделы и поля с текущими значениями.
//
// Параметры:
//  Шаблон   - СправочникСсылка.омг_ШаблоныПротоколов, СправочникОбъект.омг_ШаблоныПротоколов
//  Документ - ДокументСсылка.Прием, Неопределено - если не указан, подставляются значения по умолчанию.
//
// Возвращаемое значение:
//  Структура - см. НоваяМодельПротокола.
//
Функция МодельПротокола(Шаблон, Документ = Неопределено, ЗначенияЗаполнения = Неопределено) Экспорт

	Модель = Новый Структура;
	Модель.Вставить("Заголовок", ?(ЗначениеЗаполнено(Шаблон.ЗаголовокПечати), Шаблон.ЗаголовокПечати, Шаблон.Наименование));
	Модель.Вставить("Логотип", Шаблон.Логотип.Получить());
	Модель.Вставить("Организация", ""); // Первая строка общей шапки (название клиники).
	Модель.Вставить("СтрокиШапки", Новый Массив); // Строки общей шапки: адрес, телефон, лицензия...
	Модель.Вставить("Шапка", Новый Массив); // Реквизиты приёма: Название, Значение.
	Модель.Вставить("Разделы", Новый Массив);
	// Оформление: шрифт и базовый размер шаблона; у разделов и полей - свой размер, жирный, курсив, выравнивание.
	Модель.Вставить("Шрифт", ?(ПустаяСтрока(Шаблон.Шрифт), "Arial", СокрЛП(Шаблон.Шрифт)));
	Модель.Вставить("РазмерШрифта", ?(Шаблон.РазмерШрифта > 0, Шаблон.РазмерШрифта, 10));
	// Значения подставлены из шаблона заполнения и ещё не записаны.
	Модель.Вставить("Изменен", Ложь);
	// Свободная вёрстка: HTML шаблона с плашками полей (см. ЭтоСвободнаяВерстка).
	Модель.Вставить("HTML", ?(Шаблон.ЭтоШапка, "", Шаблон.ТекстHTML));

	// Общая шапка заводится один раз (шаблон с флажком «Это общая шапка») и выводится во всех протоколах.
	Если Шаблон.ЭтоШапка Тогда
		Модель.Заголовок = "";
		ЗаполнитьОбщуюШапку(Модель, Шаблон, Документ);
		Возврат Модель;
	КонецЕсли;
	ШаблонШапки = Неопределено;
	Если Не Шаблон.НеИспользоватьШапку Тогда
		ФилиалПриема = ?(ЗначениеЗаполнено(Документ), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Филиал"), Неопределено);
		ШаблонШапки = ОбщаяШапка(ФилиалПриема);
	КонецЕсли;
	Если ШаблонШапки = Неопределено Тогда
		Модель.Шапка = ШапкаПротокола(Документ);
	Иначе
		ЗаполнитьОбщуюШапку(Модель, ШаблонШапки, Документ);
	КонецЕсли;

	// Значения по умолчанию полей, связанных с параметром ПараметрыHTML, вычисляются по приёму
	// (вычисляемые значения старого механизма: возраст, данные клиента и т.п.).
	Вычисление = НовоеВычисление(Шаблон, Документ);

	Значения = Неопределено;
	Если ЗначенияЗаполнения <> Неопределено Тогда
		// Поля, которых нет в шаблоне заполнения (добавлены позже), - значения по умолчанию.
		Значения = ЗначенияПоУмолчаниюСЗаполнением(Шаблон, ЗначенияЗаполнения, Вычисление);
		Модель.Изменен = Истина;
	ИначеЕсли ЗначениеЗаполнено(Документ) И ТипЗнч(Шаблон) = Тип("СправочникСсылка.омг_ШаблоныПротоколов") Тогда
		Значения = СохраненныеЗначения(Документ, Шаблон);
	КонецЕсли;
	Вычисление.Значения = Значения;

	Для Каждого СтрокаРаздела Из Шаблон.Разделы Цикл

		Раздел = Новый Структура;
		Раздел.Вставить("Ключ", СтрокаРаздела.Ключ);
		Раздел.Вставить("Наименование", СтрокаРаздела.Наименование);
		Раздел.Вставить("ПечататьЗаголовок", СтрокаРаздела.ПечататьЗаголовок);
		Раздел.Вставить("РазмерШрифта", СтрокаРаздела.РазмерШрифта);
		Раздел.Вставить("Выравнивание", СокрЛП(СтрокаРаздела.Выравнивание));
		Раздел.Вставить("Поля", Новый Массив);

		Для Каждого СтрокаПоля Из Шаблон.Поля Цикл
			Если СтрокаПоля.КлючРаздела <> СтрокаРаздела.Ключ Тогда
				Продолжить;
			КонецЕсли;
			Раздел.Поля.Добавить(ОписаниеПоля(СтрокаПоля, Значения, Вычисление));
		КонецЦикла;
		СвязатьФразыРаздела(Раздел);

		Модель.Разделы.Добавить(Раздел);

	КонецЦикла;

	// Данные пациента в самом протоколе - стандартные строки шапки (Пациент, Дата приёма) не дублируем.
	Если ЗаполнитьПоляИзПриема(Модель, Документ) И ШаблонШапки = Неопределено Тогда
		Модель.Шапка = Новый Массив;
	КонецЕсли;

	Возврат Модель;

КонецФункции

// Возвращает общую шапку протоколов филиала: шаблон с флажком «Это общая шапка»
// для указанного филиала, а если такого нет - для всех филиалов (филиал не заполнен).
//
// Параметры:
//  Филиал - СправочникСсылка.Филиалы, Неопределено
//
// Возвращаемое значение:
//  СправочникСсылка.омг_ШаблоныПротоколов, Неопределено
//
Функция ОбщаяШапка(Филиал) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Шаблоны.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Шаблоны.Филиал = &Филиал
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	Справочник.омг_ШаблоныПротоколов КАК Шаблоны
	|ГДЕ
	|	Шаблоны.ЭтоШапка
	|	И НЕ Шаблоны.ПометкаУдаления
	|	И (Шаблоны.Филиал = &Филиал
	|			ИЛИ Шаблоны.Филиал = ЗНАЧЕНИЕ(Справочник.Филиалы.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Шаблоны.Наименование";
	Запрос.УстановитьПараметр("Филиал", ?(ЗначениеЗаполнено(Филиал), Филиал, Справочники.Филиалы.ПустаяСсылка()));
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Возвращает шаблоны протоколов, по которым у приёма уже есть сохранённые значения.
//
// Параметры:
//  Документ - ДокументСсылка.Прием
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.омг_ШаблоныПротоколов
//
Функция ЗаполненныеШаблоныПриема(Документ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Значения.Шаблон КАК Шаблон
	|ИЗ
	|	РегистрСведений.омг_ЗначенияПолейПротоколов КАК Значения
	|ГДЕ
	|	Значения.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", Документ);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Шаблон");

КонецФункции

// Шаблоны, которые можно добавить в приём: шаблоны специализации приёма (если их нет - все),
// кроме общих шапок и уже заполненных по этому приёму.
//
// Возвращаемое значение:
//  СписокЗначений из СправочникСсылка.омг_ШаблоныПротоколов
//
Функция ШаблоныДляВыбора(Документ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Шаблоны.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Шаблоны.Специализация = &Специализация
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПоСпециализации
	|ИЗ
	|	Справочник.омг_ШаблоныПротоколов КАК Шаблоны
	|ГДЕ
	|	НЕ Шаблоны.ПометкаУдаления
	|	И НЕ Шаблоны.ЭтоШапка
	|	И НЕ Шаблоны.Ссылка В (&Заполненные)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Шаблоны.Наименование";
	Запрос.УстановитьПараметр("Специализация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Специализация"));
	Запрос.УстановитьПараметр("Заполненные", ЗаполненныеШаблоныПриема(Документ));
	Выгрузка = Запрос.Выполнить().Выгрузить();

	ПоСпециализации = Выгрузка.НайтиСтроки(Новый Структура("ПоСпециализации", Истина));
	Результат = Новый СписокЗначений;
	Если ПоСпециализации.Количество() > 0 Тогда
		Для Каждого СтрокаШаблона Из ПоСпециализации Цикл
			Результат.Добавить(СтрокаШаблона.Ссылка);
		КонецЦикла;
	Иначе
		Результат.ЗагрузитьЗначения(Выгрузка.ВыгрузитьКолонку("Ссылка"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Записывает протокол со значениями по умолчанию (с вычисляемыми значениями по приёму),
// если по приёму и шаблону ещё ничего не записано. Нужен при добавлении нескольких протоколов сразу.
//
// Параметры:
//  Документ - ДокументСсылка.Прием
//  Шаблон   - СправочникСсылка.омг_ШаблоныПротоколов
//
Процедура СоздатьПротоколПоУмолчанию(Документ, Шаблон) Экспорт

	Если СохраненныеЗначения(Документ, Шаблон) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Соответствие;
	Модель = МодельПротокола(Шаблон, Документ);
	Для Каждого Раздел Из Модель.Разделы Цикл
		Для Каждого Поле Из Раздел.Поля Цикл
			Если Поле.Тип = "Пояснение" Или Поле.Тип = "Фраза" Тогда
				Продолжить;
			КонецЕсли;
			Значения.Вставить(Поле.Ключ, ?(Поле.Тип = "Таблица", Поле.Строки, Поле.Значение));
		КонецЦикла;
	КонецЦикла;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значения);
	ЗаписатьЗначенияПротокола(Документ, Шаблон, Запись.Закрыть());

КонецПроцедуры

// Удаляет все сохранённые значения протокола по приёму и шаблону.
// Удаляет все сохранённые значения протокола по приёму и шаблону.
Процедура УдалитьПротокол(Документ, Шаблон) Экспорт

	НаборЗаписей = РегистрыСведений.омг_ЗначенияПолейПротоколов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(Документ);
	НаборЗаписей.Отбор.Шаблон.Установить(Шаблон);
	НаборЗаписей.Записать();

КонецПроцедуры

// Записывает значения протокола, полученные из HTML-формы ввода.
//
// Параметры:
//  Документ   - ДокументСсылка.Прием
//  Шаблон     - СправочникСсылка.омг_ШаблоныПротоколов
//  ТекстJSON  - Строка - объект {"<ключ поля>": "значение" | [["ячейка", ...], ...]}
//
Процедура ЗаписатьЗначенияПротокола(Документ, Шаблон, ТекстJSON) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	НаименованияПолей = Новый Соответствие;
	Для Каждого СтрокаПоля Из Шаблон.Поля Цикл
		НаименованияПолей.Вставить(СтрокаПоля.Ключ, СтрокаПоля.Наименование);
	КонецЦикла;

	НаборЗаписей = РегистрыСведений.омг_ЗначенияПолейПротоколов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(Документ);
	НаборЗаписей.Отбор.Шаблон.Установить(Шаблон);

	Для Каждого КлючИЗначение Из Данные Цикл

		КлючПоля = КлючИЗначение.Ключ;
		Если НаименованияПолей[КлючПоля] = Неопределено Тогда
			Продолжить; // Поле удалено из шаблона.
		КонецЕсли;

		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
			НомерСтроки = 0;
			Для Каждого Ячейки Из КлючИЗначение.Значение Цикл
				НомерСтроки = НомерСтроки + 1;
				НомерКолонки = 0;
				Для Каждого Ячейка Из Ячейки Цикл
					НомерКолонки = НомерКолонки + 1;
					Если ПустаяСтрока(Ячейка) Тогда
						Продолжить;
					КонецЕсли;
					Запись = НаборЗаписей.Добавить();
					Запись.Документ = Документ;
					Запись.Шаблон = Шаблон;
					Запись.КлючПоля = КлючПоля;
					Запись.НомерСтрокиТаблицы = НомерСтроки;
					Запись.НомерКолонки = НомерКолонки;
					Запись.Значение = Строка(Ячейка);
					Запись.НаименованиеПоля = НаименованияПолей[КлючПоля];
				КонецЦикла;
			КонецЦикла;
		Иначе
			// Пустое значение тоже пишем: так отличаем «очищено врачом» от «ещё не заполнялось».
			Запись = НаборЗаписей.Добавить();
			Запись.Документ = Документ;
			Запись.Шаблон = Шаблон;
			Запись.КлючПоля = КлючПоля;
			Запись.Значение = Строка(КлючИЗначение.Значение);
			Запись.НаименованиеПоля = НаименованияПолей[КлючПоля];
		КонецЕсли;

	КонецЦикла;

	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// Возвращает текст HTML-страницы ввода протокола.
//
// Параметры:
//  Шаблон   - СправочникСсылка.омг_ШаблоныПротоколов - если не заполнен, страница предложит выбрать шаблон.
//  Документ - ДокументСсылка.Прием
//  ЗначенияЗаполнения - Соответствие, Неопределено - значения из шаблона заполнения (см. ЗначенияШаблонаЗаполнения)
//                       вместо записанных; страница считается изменённой.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстHTMLФормыВвода(Шаблон, Документ, ЗначенияЗаполнения = Неопределено) Экспорт

	ТекстJSON = "null";
	// Шаблон может быть и объектом - для предпросмотра в форме шаблона до записи.
	Если Шаблон <> Неопределено
		И (ТипЗнч(Шаблон) <> Тип("СправочникСсылка.омг_ШаблоныПротоколов") Или ЗначениеЗаполнено(Шаблон)) Тогда
		ТекстJSON = СтрЗаменить(МодельВJSON(МодельПротокола(Шаблон, Документ, ЗначенияЗаполнения)), "</", "<\/");
	КонецЕсли;

	ТекстСтраницы = Обработки.омг_ПротоколПриема.ПолучитьМакет("ФормаВводаHTML").ПолучитьТекст();
	Возврат СтрЗаменить(ТекстСтраницы, "/*OMG_MODEL*/null", ТекстJSON);

КонецФункции

// Строит печатную форму протокола.
//
// Параметры:
//  Шаблон   - СправочникСсылка.омг_ШаблоныПротоколов, СправочникОбъект.омг_ШаблоныПротоколов
//  Документ - ДокументСсылка.Прием, Неопределено - для предпросмотра пустого шаблона.
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция ПечатнаяФормаПротокола(Шаблон, Документ = Неопределено) Экспорт

	Модель = МодельПротокола(Шаблон, Документ);
	Размер = Модель.РазмерШрифта;

	ТД = Новый ТабличныйДокумент;
	ТД.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_омг_ПротоколПриема";
	ТД.РазмерСтраницы = "A4";
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТД.АвтоМасштаб = Истина;
	ТД.ПолеСлева = 15;
	ТД.ПолеСправа = 10;
	ТД.ПолеСверху = 10;
	ТД.ПолеСнизу = 10;

	// Единая сетка на весь документ: колонка отступа и КолонокСетки() одинаковых узких колонок.
	// Название, значение, ячейки таблицы занимают несколько колонок сетки (объединение),
	// высота таких строк рассчитывается по длине текста. Разные ширины колонок в разных
	// строках (формат строк) в печатной форме не сохраняются, поэтому не используются.
	ТД.Область("C1").ШиринаКолонки = 2;
	Для НомерКолонки = 2 По КолонокСетки() + 1 Цикл
		ТД.Область("C" + Формат(НомерКолонки, "ЧГ=0")).ШиринаКолонки = ШиринаКолонкиСетки();
	КонецЦикла;
	Лист = Новый Структура("ТД, Строка", ТД, 0);

	Если ТипЗнч(Модель.Логотип) = Тип("ДвоичныеДанные") Тогда
		Рисунок = ТД.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
		Рисунок.Картинка = Новый Картинка(Модель.Логотип);
		Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
		Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
		Рисунок.Расположить(ТД.Область(1, 2, 4, КолонокСетки() + 1));
		Лист.Строка = 4;
	КонецЕсли;

	// Общая шапка: название клиники и строки (адрес, телефон, лицензия).
	Если Не ПустаяСтрока(Модель.Организация) Тогда
		ВывестиНаВсюШирину(Лист, Модель.Организация, НовоеОформление(Модель, Размер + 1, Истина, , "Центр"));
	КонецЕсли;
	Для Каждого СтрокаШапки Из Модель.СтрокиШапки Цикл
		ВывестиНаВсюШирину(Лист, СтрокаШапки, НовоеОформление(Модель, Макс(Размер - 2, 6), , , "Центр"));
	КонецЦикла;

	Если Не ПустаяСтрока(Модель.Заголовок) Тогда
		ВывестиПустуюСтроку(Лист);
		ВывестиНаВсюШирину(Лист, ВРег(Модель.Заголовок), НовоеОформление(Модель, Размер + 2, Истина, , "Центр"));
	КонецЕсли;
	ВывестиПустуюСтроку(Лист);

	ОформлениеНазвания = НовоеОформление(Модель, Размер, Истина);
	ОформлениеЗначения = НовоеОформление(Модель, Размер);
	Для Каждого СтрокаШапки Из Модель.Шапка Цикл
		Если ПустаяСтрока(СтрокаШапки.Значение) И ЗначениеЗаполнено(Документ) Тогда
			Продолжить; // Пустые реквизиты шапки не печатаем (в предпросмотре шаблона - печатаем названия).
		КонецЕсли;
		ВывестиНазваниеЗначение(Лист, СтрокаШапки.Название, СтрокаШапки.Значение, ОформлениеНазвания, ОформлениеЗначения);
	КонецЦикла;

	Для Каждого Раздел Из Модель.Разделы Цикл

		ПоляКПечати = Новый Массив;
		Для Каждого Поле Из Раздел.Поля Цикл
			Если ПолеПечатается(Поле) Тогда
				ПоляКПечати.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
		Если ПоляКПечати.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ВывестиПустуюСтроку(Лист);
		Если Раздел.ПечататьЗаголовок Тогда
			ВывестиНаВсюШирину(Лист, Раздел.Наименование,
				НовоеОформление(Модель, ?(Раздел.РазмерШрифта > 0, Раздел.РазмерШрифта, Размер + 1), Истина, , Раздел.Выравнивание));
		КонецЕсли;

		Для Каждого Поле Из ПоляКПечати Цикл
			ОформлениеПоля = НовоеОформление(Модель, ?(Поле.РазмерШрифта > 0, Поле.РазмерШрифта, Размер),
				Поле.Жирный, Поле.Курсив, Поле.Выравнивание);
			Если Поле.Тип = "Пояснение" Тогда
				ВывестиНаВсюШирину(Лист, Поле.Значение, ОформлениеПоля);
			ИначеЕсли Поле.Тип = "Фраза" Тогда
				ВывестиНаВсюШирину(Лист, ТекстФразы(Поле), ОформлениеПоля);
			ИначеЕсли Поле.Тип = "Таблица" Тогда
				ВывестиТаблицу(Лист, Поле, Модель);
			ИначеЕсли ПустаяСтрока(Поле.Наименование) Или Поле.Наименование = Раздел.Наименование Тогда
				ВывестиНаВсюШирину(Лист, ПредставлениеЗначения(Поле), ОформлениеПоля);
			Иначе
				ВывестиНазваниеЗначение(Лист, Поле.Наименование, ПредставлениеЗначения(Поле),
					НовоеОформление(Модель, ОформлениеПоля.Размер, Истина), ОформлениеПоля);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	ВывестиПустуюСтроку(Лист);
	ВывестиПустуюСтроку(Лист);
	Врач = "";
	Если ЗначениеЗаполнено(Документ) Тогда
		Врач = Строка(Документ.Врач);
	КонецЕсли;
	ВывестиНазваниеЗначение(Лист, "Врач", "____________________  " + Врач, ОформлениеНазвания, ОформлениеЗначения);

	Возврат ТД;

КонецФункции

// Коллекция печатных форм для УправлениеПечатьюКлиент.ПечатьДокументов (печать, сохранение в PDF).
//
// Параметры:
//  Шаблон   - СправочникСсылка.омг_ШаблоныПротоколов, СправочникОбъект.омг_ШаблоныПротоколов
//  Документ - ДокументСсылка.Прием, Неопределено
//
// Возвращаемое значение:
//  Массив - см. УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм.
//
Функция КоллекцияПечатныхФормПротокола(Шаблон, Документ = Неопределено) Экспорт

	Коллекция = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм("ПротоколПриема");
	ПечатнаяФорма = Коллекция[0];
	ПечатнаяФорма.СинонимМакета = ?(ЗначениеЗаполнено(Шаблон.ЗаголовокПечати), Шаблон.ЗаголовокПечати, Шаблон.Наименование);
	ПечатнаяФорма.ТабличныйДокумент = ПечатнаяФормаПротокола(Шаблон, Документ);
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = "Протокол " + ПечатнаяФорма.СинонимМакета;

	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Коллекция);

КонецФункции

// Заполняет разделы и поля шаблона из документа Word (.docx).
//
// Разметка в Word:
//  - абзац со стилем «Заголовок 1/2» (Heading) - раздел;
//  - метка {{Название | значение по умолчанию | тип | параметр}} - поле; тип и параметр необязательны:
//    текст, строка, число, дата, флажок, список, несколько. Для списка варианты
//    перечисляются через «;» во второй части: {{Сознание | ясное; спутанное | список}};
//    параметр - наименование или код параметра старого механизма (ПараметрыHTML); без него
//    параметр ищется по подписи поля;
//  - элементы управления содержимым Word (вкладка «Разработчик») - поле с типом по виду элемента:
//    текст, раскрывающийся список / поле со списком, дата, флажок; название - «Заголовок» элемента;
//  - таблица Word: первая строка - колонки, остальные - строки по умолчанию;
//    таблица из двух колонок с метками во второй колонке - набор полей «название - значение»;
//  - строка «Название: значение» без меток - текстовое поле (если РаспознаватьБезМеток);
//  - прочий текст - пояснение (печатается как есть);
//  - картинка в верхнем колонтитуле - логотип.
//
// Параметры:
//  ШаблонОбъект          - СправочникОбъект.омг_ШаблоныПротоколов - заполняется (разделы и поля заменяются).
//  ДвоичныеДанныеФайла   - ДвоичныеДанные - содержимое .docx
//  ИмяФайла              - Строка
//  РаспознаватьБезМеток  - Булево
//
// Возвращаемое значение:
//  Массив из Строка - предупреждения разбора.
//
Функция ЗаполнитьШаблонИзWord(ШаблонОбъект, ДвоичныеДанныеФайла, ИмяФайла = "", РаспознаватьБезМеток = Истина) Экспорт

	Результат = ПрочитатьШаблонИзWord(ДвоичныеДанныеФайла, РаспознаватьБезМеток);

	// Загрузка из Word даёт шаблон из разделов и полей; прежняя свободная вёрстка сбрасывается.
	ШаблонОбъект.ТекстHTML = "";
	ШаблонОбъект.Разделы.Очистить();
	ШаблонОбъект.Поля.Очистить();

	Для Каждого Раздел Из Результат.Разделы Цикл
		СтрокаРаздела = ШаблонОбъект.Разделы.Добавить();
		СтрокаРаздела.Ключ = Раздел.Ключ;
		СтрокаРаздела.Наименование = Лев(Раздел.Наименование, 150);
		СтрокаРаздела.ПечататьЗаголовок = Не Раздел.БезЗаголовка;
		СтрокаРаздела.РазмерШрифта = Раздел.РазмерШрифта;
		СтрокаРаздела.Выравнивание = Раздел.Выравнивание;
	КонецЦикла;

	Для Каждого Поле Из Результат.Поля Цикл
		СтрокаПоля = ШаблонОбъект.Поля.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоля, Поле,
			"КлючРаздела, Ключ, ЗначениеПоУмолчанию, ВариантыВыбора, КолонкиТаблицы, ЕдиницаИзмерения, Жирный, Курсив, РазмерШрифта, Выравнивание");
		СтрокаПоля.Наименование = Лев(Поле.Наименование, 250);
		СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола[Поле.Тип];
		СтрокаПоля.СкрыватьЕслиПусто = (Поле.Тип <> "Пояснение");
	КонецЦикла;

	// Параметры старого механизма: явно указанные в метке или найденные по подписи поля.
	ПоляДляПодбора = Новый Массив;
	СтрокиДляПодбора = Новый Массив;
	Для Индекс = 0 По Результат.Поля.ВГраница() Цикл
		Поле = Результат.Поля[Индекс];
		Если Поле.Тип <> "Пояснение" И Поле.Тип <> "Таблица" И Поле.Тип <> "Фраза" Тогда
			ПоляДляПодбора.Добавить(Поле);
			СтрокиДляПодбора.Добавить(ШаблонОбъект.Поля[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Найденные = ПодобратьПараметрыПолей(ПоляДляПодбора);
	Для Индекс = 0 По Найденные.ВГраница() Цикл
		СтрокиДляПодбора[Индекс].Параметр = Найденные[Индекс];
		ИмяПараметра = ПоляДляПодбора[Индекс].ИмяПараметра;
		Если ЗначениеЗаполнено(ИмяПараметра) И Не ЗначениеЗаполнено(Найденные[Индекс]) Тогда
			Результат.Предупреждения.Добавить(СтрШаблон(
				НСтр("ru = 'Поле «%1»: параметр «%2» не найден или неоднозначен, выберите его вручную.'"),
				ПоляДляПодбора[Индекс].Наименование, ИмяПараметра));
		КонецЕсли;
	КонецЦикла;

	Если Результат.Логотип <> Неопределено Тогда
		ШаблонОбъект.Логотип = Новый ХранилищеЗначения(Результат.Логотип, Новый СжатиеДанных(9));
	КонецЕсли;
	ШаблонОбъект.ИсходныйФайл = Новый ХранилищеЗначения(ДвоичныеДанныеФайла, Новый СжатиеДанных(9));
	ШаблонОбъект.ИмяИсходногоФайла = ИмяФайла;
	Если Не ПустаяСтрока(Результат.Название) Тогда
		ШаблонОбъект.ЗаголовокПечати = Лев(Результат.Название, 300);
	КонецЕсли;
	Если ПустаяСтрока(ШаблонОбъект.Наименование) Тогда
		ШаблонОбъект.Наименование = СтрЗаменить(ИмяФайла, ".docx", "");
	КонецЕсли;

	Возврат Результат.Предупреждения;

КонецФункции

// Разбирает документ Word в структуру шаблона, не записывая её никуда.
//
// Возвращаемое значение:
//  Структура:
//   * Разделы - Массив из Структура (Ключ, Наименование)
//   * Поля - Массив из Структура (КлючРаздела, Ключ, Наименование, Тип, ЗначениеПоУмолчанию,
//                                   ВариантыВыбора, КолонкиТаблицы, ЕдиницаИзмерения)
//   * Логотип - ДвоичныеДанные, Неопределено
//   * Предупреждения - Массив из Строка
//
Функция ПрочитатьШаблонИзWord(ДвоичныеДанныеФайла, РаспознаватьБезМеток = Истина) Экспорт

	ИмяАрхива = ПолучитьИмяВременногоФайла("docx");
	КаталогРаспаковки = ПолучитьИмяВременногоФайла("");
	ДвоичныеДанныеФайла.Записать(ИмяАрхива);

	Попытка
		Архив = Новый ЧтениеZipФайла(ИмяАрхива);
		Архив.ИзвлечьВсе(КаталогРаспаковки, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		Архив.Закрыть();
	Исключение
		УдалитьФайлы(ИмяАрхива);
		ВызватьИсключение НСтр("ru = 'Файл не похож на документ Word (.docx). Документы .doc нужно сначала сохранить в формате .docx.'");
	КонецПопытки;

	Контекст = Новый Структура;
	Контекст.Вставить("Разделы", Новый Массив);
	Контекст.Вставить("Поля", Новый Массив);
	Контекст.Вставить("Предупреждения", Новый Массив);
	Контекст.Вставить("ТекущийРаздел", Неопределено);
	Контекст.Вставить("ПоследнееПояснение", Неопределено);
	Контекст.Вставить("СчетчикТаблиц", 0);
	Контекст.Вставить("РаспознаватьБезМеток", РаспознаватьБезМеток);
	Контекст.Вставить("Заголовки", СтилиЗаголовков(КаталогРаспаковки + "/word/styles.xml"));
	Контекст.Вставить("Логотип", Неопределено);
	Контекст.Вставить("Название", "");

	Попытка

		ДокументDOM = ПрочитатьФайлXML(КаталогРаспаковки + "/word/document.xml");
		Тело = ДочернийW(ДокументDOM.ЭлементДокумента, "body");
		Если Тело = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В документе не найдено содержимое (word/document.xml).'");
		КонецЕсли;

		Для Каждого Узел Из Тело.ДочерниеУзлы Цикл
			РазобратьБлок(Узел, Контекст);
		КонецЦикла;

		Контекст.Логотип = ЛоготипИзКолонтитулов(КаталогРаспаковки);

	Исключение
		УдалитьФайлы(ИмяАрхива);
		УдалитьФайлы(КаталогРаспаковки);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ИмяАрхива);
	УдалитьФайлы(КаталогРаспаковки);

	Если Контекст.Поля.Количество() = 0 Тогда
		Контекст.Предупреждения.Добавить(НСтр("ru = 'В документе не найдено ни одного поля. Отметьте поля метками {{Название}} или элементами управления содержимым Word.'"));
	КонецЕсли;

	Возврат Новый Структура("Разделы, Поля, Логотип, Название, Предупреждения",
		Контекст.Разделы, Контекст.Поля, Контекст.Логотип, Контекст.Название, Контекст.Предупреждения);

КонецФункции

#Область ШаблоныЗаполнения

// Личные шаблоны заполнения протокола: врач сохраняет типичное заполнение и подставляет его в новый протокол.
// Шаблон заполнения подчинён шаблону протокола; Врач пустой - шаблон общий для всех врачей.

// Шаблоны заполнения, доступные текущему врачу: свои и общие.
//
// Параметры:
//  Шаблон - СправочникСсылка.омг_ШаблоныПротоколов
//
// Возвращаемое значение:
//  СписокЗначений - значение: СправочникСсылка.омг_ШаблоныЗаполненияПротоколов, представление: наименование.
//
Функция ШаблоныЗаполнения(Шаблон) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныЗаполнения.Ссылка КАК Ссылка,
	|	ШаблоныЗаполнения.Наименование КАК Наименование,
	|	ШаблоныЗаполнения.Врач = &Врач КАК Свой
	|ИЗ
	|	Справочник.омг_ШаблоныЗаполненияПротоколов КАК ШаблоныЗаполнения
	|ГДЕ
	|	ШаблоныЗаполнения.Владелец = &Шаблон
	|	И НЕ ШаблоныЗаполнения.ПометкаУдаления
	|	И (ШаблоныЗаполнения.Врач = &Врач
	|			ИЛИ ШаблоныЗаполнения.Врач = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Свой УБЫВ,
	|	Наименование";
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("Врач", ТекущийВрач());

	Список = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Ссылка,
			Выборка.Наименование + ?(Выборка.Свой, "", " " + НСтр("ru = '(общий)'")));
	КонецЦикла;
	Возврат Список;

КонецФункции

// Сохраняет заполнение протокола как шаблон заполнения текущего врача.
// Шаблон с тем же наименованием у этого врача перезаписывается.
//
// Параметры:
//  Шаблон       - СправочникСсылка.омг_ШаблоныПротоколов
//  Наименование - Строка
//  ТекстJSON    - Строка - значения полей со страницы протокола (omgGetData).
//
// Возвращаемое значение:
//  СправочникСсылка.омг_ШаблоныЗаполненияПротоколов
//
Функция СохранитьШаблонЗаполнения(Шаблон, Знач Наименование, ТекстJSON) Экспорт

	Наименование = СокрЛП(Наименование);
	Врач = ТекущийВрач();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШаблоныЗаполнения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.омг_ШаблоныЗаполненияПротоколов КАК ШаблоныЗаполнения
	|ГДЕ
	|	ШаблоныЗаполнения.Владелец = &Шаблон
	|	И ШаблоныЗаполнения.Врач = &Врач
	|	И ШаблоныЗаполнения.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("Врач", Врач);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ШаблонЗаполнения = Выборка.Ссылка.ПолучитьОбъект();
		ШаблонЗаполнения.ПометкаУдаления = Ложь;
	Иначе
		ШаблонЗаполнения = Справочники.омг_ШаблоныЗаполненияПротоколов.СоздатьЭлемент();
		ШаблонЗаполнения.Владелец = Шаблон;
		ШаблонЗаполнения.Врач = Врач;
		ШаблонЗаполнения.Наименование = Наименование;
	КонецЕсли;
	ШаблонЗаполнения.ЗначенияПолей = ТекстJSON;
	ШаблонЗаполнения.Записать();

	Возврат ШаблонЗаполнения.Ссылка;

КонецФункции

// Значения полей шаблона заполнения для подстановки в протокол (см. ТекстHTMLФормыВвода).
//
// Параметры:
//  ШаблонЗаполнения - СправочникСсылка.омг_ШаблоныЗаполненияПротоколов
//
// Возвращаемое значение:
//  Соответствие - ключ поля -> Строка или Массив строк таблицы (Массив из Массив из Строка).
//
Функция ЗначенияШаблонаЗаполнения(ШаблонЗаполнения) Экспорт

	Результат = Новый Соответствие;
	ТекстJSON = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонЗаполнения, "ЗначенияПолей");
	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат Результат;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Для Каждого КлючИЗначение Из Данные Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
			Строки = Новый Массив;
			Для Каждого Ячейки Из КлючИЗначение.Значение Цикл
				СтрокаТаблицы = Новый Массив;
				Если ТипЗнч(Ячейки) = Тип("Массив") Тогда
					Для Каждого Ячейка Из Ячейки Цикл
						СтрокаТаблицы.Добавить(Строка(Ячейка));
					КонецЦикла;
				КонецЕсли;
				Строки.Добавить(СтрокаТаблицы);
			КонецЦикла;
			Результат.Вставить(КлючИЗначение.Ключ, Строки);
		Иначе
			Результат.Вставить(КлючИЗначение.Ключ, Строка(КлючИЗначение.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СопоставлениеПараметров

// Подбирает полям шаблона параметры старого механизма (ПВХ ПараметрыHTML).
// Сравниваются наименование, наименование для врача и код параметра без учёта регистра,
// пробелов и знаков препинания; у двуязычной подписи «Жалобы / Шағымдар» проверяется каждая часть.
// Если имени соответствуют несколько параметров, поле не сопоставляется (выбирается вручную).
//
// Параметры:
//  Поля - Массив из Структура:
//   * Наименование - Строка - подпись поля;
//   * ИмяПараметра - Строка - необязательно: явное имя или код параметра (четвёртая часть метки Word).
//
// Возвращаемое значение:
//  Массив из ПланВидовХарактеристикСсылка.ПараметрыHTML - по полю на элемент, пустая ссылка - не найден.
//
Функция ПодобратьПараметрыПолей(Поля) Экспорт

	Индекс = ИндексПараметров();
	Результат = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		ИмяПараметра = "";
		Поле.Свойство("ИмяПараметра", ИмяПараметра);
		Если ЗначениеЗаполнено(ИмяПараметра) Тогда
			Результат.Добавить(НайтиПараметрВИндексе(Индекс, ИмяПараметра));
		Иначе
			Результат.Добавить(НайтиПараметрВИндексе(Индекс, Поле.Наименование));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СвободнаяВерстка

// Шаблон со свободной вёрсткой: текст шаблона - HTML (реквизит ТекстHTML), поля в нём - плашки
// <span class="omg-f" data-key="Ключ">Имя</span>; описания полей - в табличной части Поля, как обычно,
// поэтому значения, шаблоны заполнения, параметры работают одинаково для обоих видов шаблонов.

// Истина, если шаблон свёрстан свободно (HTML).
Функция ЭтоСвободнаяВерстка(Шаблон) Экспорт

	Если Шаблон = Неопределено Или (ТипЗнч(Шаблон) = Тип("СправочникСсылка.омг_ШаблоныПротоколов") И Не ЗначениеЗаполнено(Шаблон)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ПустаяСтрока(Шаблон.ТекстHTML);

КонецФункции

// Страница визуального редактора шаблона (макет РедакторШаблонаHTML) с текущим содержимым шаблона.
// Шаблон из разделов и полей (до свободной вёрстки) показывается переведённым в HTML.
//
// Параметры:
//  Шаблон - СправочникОбъект.омг_ШаблоныПротоколов, СправочникСсылка.омг_ШаблоныПротоколов
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстHTMLРедактора(Шаблон) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("font", ?(ПустаяСтрока(Шаблон.Шрифт), "Arial", СокрЛП(Шаблон.Шрифт)));
	Данные.Вставить("size", ?(Шаблон.РазмерШрифта > 0, Шаблон.РазмерШрифта, 10));
	Данные.Вставить("html", ?(ПустаяСтрока(Шаблон.ТекстHTML), HTMLИзСтруктуры(Шаблон), Шаблон.ТекстHTML));
	Поля = Новый Массив;
	Для Каждого СтрокаПоля Из Шаблон.Поля Цикл
		Если СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.Пояснение
			Или СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.Фраза Тогда
			Продолжить;
		КонецЕсли;
		Поля.Добавить(ОписаниеПоляРедактора(СтрокаПоля));
	КонецЦикла;
	Данные.Вставить("fields", Поля);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = СтрЗаменить(Запись.Закрыть(), "</", "<\/");

	ТекстСтраницы = Обработки.омг_ПротоколПриема.ПолучитьМакет("РедакторШаблонаHTML").ПолучитьТекст();
	Возврат СтрЗаменить(ТекстСтраницы, "/*OMG_EDITOR*/null", ТекстJSON);

КонецФункции

// Записывает в шаблон содержимое визуального редактора: HTML и поля по плашкам.
// Поля, плашек которых больше нет, удаляются; у оставшихся сохраняются ключи (и значения в приёмах).
//
// Параметры:
//  ШаблонОбъект - СправочникОбъект.омг_ШаблоныПротоколов
//  ТекстJSON    - Строка - результат omgEdGetData() страницы редактора: {html, fields: [...]}.
//
Процедура ПрименитьДанныеРедактора(ШаблонОбъект, ТекстJSON) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();

	Прежние = Новый Соответствие;
	Для Каждого СтрокаПоля Из ШаблонОбъект.Поля Цикл
		Копия = Новый Структура("КлючРаздела, Ключ, Наименование, ТипПоля, ЗначениеПоУмолчанию, ВариантыВыбора, КолонкиТаблицы,
			|ЕдиницаИзмерения, Обязательное, СкрыватьЕслиПусто, Параметр, Жирный, Курсив, РазмерШрифта, Выравнивание");
		ЗаполнитьЗначенияСвойств(Копия, СтрокаПоля);
		Прежние.Вставить(СтрокаПоля.Ключ, Копия);
	КонецЦикла;

	// В свободной вёрстке один служебный раздел: порядок полей задаёт сам текст.
	ШаблонОбъект.Разделы.Очистить();
	Раздел = ШаблонОбъект.Разделы.Добавить();
	Раздел.Ключ = "html";
	Раздел.Наименование = НСтр("ru = 'Поля'");
	Раздел.ПечататьЗаголовок = Ложь;

	ШаблонОбъект.Поля.Очистить();
	Для Каждого ОписаниеПоля Из Данные.fields Цикл
		СтрокаПоля = ШаблонОбъект.Поля.Добавить();
		Прежнее = Прежние[ОписаниеПоля.key];
		Если Прежнее <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаПоля, Прежнее);
		КонецЕсли;
		СтрокаПоля.КлючРаздела = Раздел.Ключ;
		СтрокаПоля.Ключ = ОписаниеПоля.key;
		ЗаполнитьПолеИзРедактора(СтрокаПоля, ОписаниеПоля);
	КонецЦикла;

	ШаблонОбъект.ТекстHTML = Данные.html;

КонецПроцедуры

// Описание нового поля по параметру старого механизма - для кнопки «+ Параметр» редактора.
//
// Возвращаемое значение:
//  Строка - JSON описания поля (см. ОписаниеПоляРедактора).
//
Функция ПолеРедактораПоПараметру(Параметр) Экспорт

	Описание = Новый Структура;
	Описание.Вставить("key", Строка(Новый УникальныйИдентификатор));
	Описание.Вставить("name", Строка(Параметр));
	Описание.Вставить("type", ТипПоляПоПараметру(Параметр));
	Описание.Вставить("typeTitle", Строка(Перечисления.омг_ТипыПолейПротокола[Описание.type]));
	Описание.Вставить("def", "");
	Описание.Вставить("opts", "");
	Описание.Вставить("cols", "");
	Описание.Вставить("unit", "");
	Описание.Вставить("param", XMLСтрока(Параметр));
	Описание.Вставить("paramName", Строка(Параметр));
	Описание.Вставить("req", Ложь);
	Возврат ЗначениеВСтрокуJSON(Описание);

КонецФункции

// HTML протокола для печати и просмотра: шапка клиники, текст шаблона, значения вместо плашек.
//
// Параметры:
//  Шаблон   - СправочникСсылка.омг_ШаблоныПротоколов, СправочникОбъект.омг_ШаблоныПротоколов
//  Документ - ДокументСсылка.Прием, Неопределено
//  ДляWord  - Булево - без логотипа и полей страницы (их задаёт сам документ Word).
//
// Возвращаемое значение:
//  Строка - HTML-страница.
//
Функция ТекстHTMLПечати(Шаблон, Документ = Неопределено, ДляWord = Ложь) Экспорт

	Модель = МодельПротокола(Шаблон, Документ);
	Значения = Новый Соответствие;
	Для Каждого Раздел Из Модель.Разделы Цикл
		Для Каждого Поле Из Раздел.Поля Цикл
			Значения.Вставить(Поле.Ключ, Поле);
		КонецЦикла;
	КонецЦикла;

	Части = Новый Массив;
	Части.Добавить("<!DOCTYPE html><html><head><meta charset=""utf-8""><title>" + ТекстHTML(Модель.Заголовок) + "</title><style>");
	Если Не ДляWord Тогда
		Части.Добавить("@page { size: A4; margin: 10mm 10mm 10mm 15mm; } html, body { background: #fff; }");
	КонецЕсли;
	Части.Добавить("body { margin: 0; font-family: """ + Модель.Шрифт + """, Arial, sans-serif; font-size: "
		+ Формат(Модель.РазмерШрифта, "ЧГ=0") + "pt; color: #000; }");
	Части.Добавить("p { margin: 0 0 3px; } table { border-collapse: collapse; width: 100%; } td, th { vertical-align: top; padding: 2px 4px; }");
	Части.Добавить("table.grid td, table.grid th, table.omg-t td, table.omg-t th { border: 1px solid #000; }");
	Части.Добавить("hr { border: none; border-top: 1px solid #000; } img { max-width: 100%; }");
	Части.Добавить(".omg-hdr { text-align: center; margin-bottom: 8px; } .omg-hdr img { max-height: 20mm; } .omg-org { font-weight: 700; }");
	Части.Добавить(".omg-line { font-size: 90%; } .omg-sign { margin-top: 18px; }");
	Части.Добавить("</style></head><body>");

	// Общая шапка клиники (логотип, название, строки), если шаблон её не отключил.
	Если Не ДляWord И ТипЗнч(Модель.Логотип) = Тип("ДвоичныеДанные") Тогда
		Части.Добавить("<div class=""omg-hdr""><img src=""data:image/" + РасширениеКартинки(Модель.Логотип) + ";base64,"
			+ СтрЗаменить(СтрЗаменить(Base64Строка(Модель.Логотип), Символы.ВК, ""), Символы.ПС, "") + """></div>");
	КонецЕсли;
	Если Не ПустаяСтрока(Модель.Организация) Или Модель.СтрокиШапки.Количество() > 0 Тогда
		Части.Добавить("<div class=""omg-hdr"">");
		Если Не ПустаяСтрока(Модель.Организация) Тогда
			Части.Добавить("<div class=""omg-org"">" + ТекстHTML(Модель.Организация) + "</div>");
		КонецЕсли;
		Для Каждого СтрокаШапки Из Модель.СтрокиШапки Цикл
			Части.Добавить("<div class=""omg-line"">" + ТекстHTML(СтрокаШапки) + "</div>");
		КонецЦикла;
		Части.Добавить("</div>");
	КонецЕсли;
	Для Каждого СтрокаШапки Из Модель.Шапка Цикл
		Если ПустаяСтрока(СтрокаШапки.Значение) И ЗначениеЗаполнено(Документ) Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить("<p><b>" + ТекстHTML(СтрокаШапки.Название) + ":</b> " + ТекстHTML(СтрокаШапки.Значение) + "</p>");
	КонецЦикла;

	Части.Добавить(ПодставитьЗначенияВHTML(Модель.HTML, Значения));
	Части.Добавить("</body></html>");
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Данные для команды «Печать» протокола: печатная форма (табличный документ) или HTML свободной вёрстки.
//
// Возвращаемое значение:
//  Структура:
//   * HTML      - Строка - HTML для печати (свободная вёрстка), иначе пустая строка;
//   * Коллекция - Массив - коллекция печатных форм для ОбщаяФорма.ПечатьДокументов (иначе Неопределено);
//   * Заголовок - Строка
//
Функция ДанныеПечатиПротокола(Шаблон, Документ = Неопределено) Экспорт

	Результат = Новый Структура("HTML, Коллекция, Заголовок", "", Неопределено, "");
	Результат.Заголовок = ?(ЗначениеЗаполнено(Шаблон.ЗаголовокПечати), Шаблон.ЗаголовокПечати, Шаблон.Наименование);
	Если ЭтоСвободнаяВерстка(Шаблон) Тогда
		Результат.HTML = ТекстHTMLПечати(Шаблон, Документ);
	Иначе
		Результат.Коллекция = КоллекцияПечатныхФормПротокола(Шаблон, Документ);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВыгрузкаВWord

// Документ Word (.docx) заполненного протокола: обычные абзацы, заголовки разделов,
// «Название: значение», таблицы Word, оформление шаблона, страница A4.
//
// Параметры:
//  Шаблон   - СправочникСсылка.омг_ШаблоныПротоколов
//  Документ - ДокументСсылка.Прием
//
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция ФайлWordПротокола(Шаблон, Документ = Неопределено) Экспорт

	Если ЭтоСвободнаяВерстка(Шаблон) Тогда
		Возврат ФайлWordСвободнойВерстки(Шаблон, Документ);
	КонецЕсли;

	Модель = МодельПротокола(Шаблон, Документ);
	Док = НовыйДокументWord(Модель);
	Размер = Модель.РазмерШрифта;

	Если ТипЗнч(Модель.Логотип) = Тип("ДвоичныеДанные") Тогда
		Док.Логотип = Модель.Логотип;
		Док.Тело.Добавить("<w:p>" + РисунокЛоготипаW(Док) + "</w:p>");
	КонецЕсли;

	Если Не ПустаяСтрока(Модель.Организация) Тогда
		ДобавитьАбзацW(Док, ФрагментW(Модель.Организация, Истина, , Размер + 1), "Центр");
	КонецЕсли;
	Для Каждого СтрокаШапки Из Модель.СтрокиШапки Цикл
		ДобавитьАбзацW(Док, ФрагментW(СтрокаШапки, , , Макс(Размер - 2, 6)), "Центр");
	КонецЦикла;
	Если Не ПустаяСтрока(Модель.Заголовок) Тогда
		ДобавитьАбзацW(Док, ФрагментW(ВРег(Модель.Заголовок)), , "Title");
	КонецЕсли;

	Для Каждого СтрокаШапки Из Модель.Шапка Цикл
		Если ПустаяСтрока(СтрокаШапки.Значение) И ЗначениеЗаполнено(Документ) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьНазваниеЗначениеW(Док, СтрокаШапки.Название, ФрагментW(СтрокаШапки.Значение));
	КонецЦикла;

	Для Каждого Раздел Из Модель.Разделы Цикл

		ПоляКПечати = Новый Массив;
		Для Каждого Поле Из Раздел.Поля Цикл
			Если ПолеПечатается(Поле) Тогда
				ПоляКПечати.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
		Если ПоляКПечати.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Раздел.ПечататьЗаголовок Тогда
			ДобавитьАбзацW(Док, ФрагментW(Раздел.Наименование, , , Раздел.РазмерШрифта), Раздел.Выравнивание, "Heading1");
		КонецЕсли;

		Для Каждого Поле Из ПоляКПечати Цикл
			Если Поле.Тип = "Таблица" Тогда
				Если Не ПустаяСтрока(Поле.Наименование) Тогда
					ДобавитьАбзацW(Док, ФрагментW(Поле.Наименование + ":", Истина));
				КонецЕсли;
				ДобавитьТаблицуW(Док, Поле.Колонки, Поле.Строки, ФрагментПоля(Поле, ""));
			ИначеЕсли Поле.Тип = "Пояснение" Тогда
				ДобавитьАбзацW(Док, ФрагментПоля(Поле, Поле.Значение), Поле.Выравнивание);
			ИначеЕсли Поле.Тип = "Фраза" Тогда
				ДобавитьАбзацW(Док, ФрагментПоля(Поле, ТекстФразы(Поле)), Поле.Выравнивание);
			ИначеЕсли ПустаяСтрока(Поле.Наименование) Или Поле.Наименование = Раздел.Наименование Тогда
				ДобавитьАбзацW(Док, ФрагментПоля(Поле, ПредставлениеЗначения(Поле)), Поле.Выравнивание);
			Иначе
				ДобавитьНазваниеЗначениеW(Док, Поле.Наименование, ФрагментПоля(Поле, ПредставлениеЗначения(Поле)), Поле.Выравнивание);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Врач = "";
	Если ЗначениеЗаполнено(Документ) Тогда
		Врач = Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Врач"));
	КонецЕсли;
	ДобавитьАбзацW(Док, ФрагментW(""));
	ДобавитьНазваниеЗначениеW(Док, "Врач", ФрагментW("____________________  " + Врач));

	Возврат СобратьDOCX(Док);

КонецФункции

// Свободная вёрстка: HTML протокола вкладывается в документ Word (altChunk), Word раскладывает его сам.
// Логотип - обычным рисунком в начале документа.
Функция ФайлWordСвободнойВерстки(Шаблон, Документ)

	Модель = МодельПротокола(Шаблон, Документ);
	Док = НовыйДокументWord(Модель);
	Если ТипЗнч(Модель.Логотип) = Тип("ДвоичныеДанные") Тогда
		Док.Логотип = Модель.Логотип;
		Док.Тело.Добавить("<w:p><w:pPr><w:jc w:val=""center""/></w:pPr>" + РисунокЛоготипаW(Док) + "</w:p>");
	КонецЕсли;
	Вложение = ВложениеWordИзHTML(ТекстHTMLПечати(Шаблон, Документ, Истина));
	Док.ВложенныйHTML = Вложение.Текст;
	Док.ВложениеMHT = Вложение.MHT;
	Док.Тело.Добавить("<w:altChunk r:id=""rIdChunk""/>");
	Возврат СобратьDOCX(Док);

КонецФункции

// HTML для вставки в Word (altChunk). Картинки data: (логотип в шапке, свёрстанной в документе) Word во вложенном
// HTML не показывает, поэтому HTML с картинками упаковывается в MHT: картинки - отдельными частями.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - HTML или MHT;
//   * MHT   - Булево
//
Функция ВложениеWordИзHTML(ТекстHTMLДокумента)

	Картинки = Новый Массив;
	Части = Новый Массив;
	Остаток = ТекстHTMLДокумента;
	Начало = "src=""data:";
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, Начало);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		НачалоДанных = Позиция + СтрДлина(Начало);
		Конец = СтрНайти(Остаток, """", , НачалоДанных);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Данные = Сред(Остаток, НачалоДанных, Конец - НачалоДанных); // image/png;base64,....
		Запятая = СтрНайти(Данные, ",");
		ТипКартинки = СтрЗаменить(Лев(Данные, Запятая - 1), ";base64", "");
		Если Запятая = 0 Или Не СтрНачинаетсяС(ТипКартинки, "image/") Тогда
			Части.Добавить(Лев(Остаток, Конец));
			Остаток = Сред(Остаток, Конец + 1);
			Продолжить;
		КонецЕсли;
		Адрес = "file:///C:/omg/image" + Формат(Картинки.Количество() + 1, "ЧГ=0") + "." + СтрЗаменить(ТипКартинки, "image/", "");
		Картинки.Добавить(Новый Структура("Тип, Адрес, Данные", ТипКартинки, Адрес, Сред(Данные, Запятая + 1)));
		Части.Добавить(Лев(Остаток, Позиция - 1) + "src=""" + Адрес + """");
		Остаток = Сред(Остаток, Конец + 1);
	КонецЦикла;
	Части.Добавить(Остаток);

	Если Картинки.Количество() = 0 Тогда
		Возврат Новый Структура("Текст, MHT", ТекстHTMLДокумента, Ложь);
	КонецЕсли;

	Граница = "----=_omg_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Строки = Новый Массив;
	Строки.Добавить("MIME-Version: 1.0");
	Строки.Добавить("Content-Type: multipart/related; boundary=""" + Граница + """; type=""text/html""");
	Строки.Добавить("");
	Строки.Добавить("--" + Граница);
	Строки.Добавить("Content-Type: text/html; charset=""utf-8""");
	Строки.Добавить("Content-Transfer-Encoding: base64");
	Строки.Добавить("Content-Location: file:///C:/omg/protocol.htm");
	Строки.Добавить("");
	Строки.Добавить(Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Части), КодировкаТекста.UTF8, Ложь)));
	Для Каждого Картинка Из Картинки Цикл
		Строки.Добавить("");
		Строки.Добавить("--" + Граница);
		Строки.Добавить("Content-Type: " + Картинка.Тип);
		Строки.Добавить("Content-Transfer-Encoding: base64");
		Строки.Добавить("Content-Location: " + Картинка.Адрес);
		Строки.Добавить("");
		// Перекодирование даёт base64 с переносами строк, как положено в MIME.
		Строки.Добавить(Base64Строка(Base64Значение(Картинка.Данные)));
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("--" + Граница + "--");
	Возврат Новый Структура("Текст, MHT", СтрСоединить(Строки, Символы.ВК + Символы.ПС), Истина);

КонецФункции

// Имя файла Word для протокола: «Шаблон - Пациент - дата приёма.docx» или «Шаблон.docx».
//
// Параметры:
//  Шаблон   - СправочникСсылка.омг_ШаблоныПротоколов, Строка
//  Документ - ДокументСсылка.Прием, Неопределено
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяФайлаWord(Шаблон, Документ = Неопределено) Экспорт

	Части = Новый Массив;
	Части.Добавить(СокрЛП(Шаблон));
	Если ЗначениеЗаполнено(Документ) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Клиент, Дата");
		Если ЗначениеЗаполнено(Реквизиты.Клиент) Тогда
			Части.Добавить(СокрЛП(Реквизиты.Клиент));
		КонецЕсли;
		Части.Добавить(Формат(Реквизиты.Дата, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	Возврат ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СтрСоединить(Части, " - ")) + ".docx";

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Модель

Функция ОписаниеПоля(СтрокаПоля, Значения, Вычисление = Неопределено)

	Поле = Новый Структура;
	Поле.Вставить("Ключ", СтрокаПоля.Ключ);
	Поле.Вставить("Наименование", СтрокаПоля.Наименование);
	Поле.Вставить("Тип", ?(ЗначениеЗаполнено(СтрокаПоля.ТипПоля), XMLСтрока(СтрокаПоля.ТипПоля), "Текст"));
	Поле.Вставить("ЕдиницаИзмерения", СтрокаПоля.ЕдиницаИзмерения);
	Поле.Вставить("Обязательное", СтрокаПоля.Обязательное);
	Поле.Вставить("СкрыватьЕслиПусто", СтрокаПоля.СкрыватьЕслиПусто);
	Поле.Вставить("ПоУмолчанию", СтрокаПоля.ЗначениеПоУмолчанию);
	Поле.Вставить("Параметр", СтрокаПоля.Параметр);
	Если Вычисление <> Неопределено И ЗначениеЗаполнено(СтрокаПоля.Параметр) Тогда
		ЗначениеПараметра = ЗначениеПоУмолчаниюПоПараметру(СтрокаПоля, Поле.Тип, Вычисление);
		Если ЗначениеПараметра <> Неопределено Тогда
			Поле.ПоУмолчанию = ЗначениеПараметра;
		КонецЕсли;
	КонецЕсли;
	Поле.Вставить("Варианты", СписокИзСтроки(СтрокаПоля.ВариантыВыбора));
	Поле.Вставить("Колонки", СписокИзСтроки(СтрокаПоля.КолонкиТаблицы));
	Поле.Вставить("Жирный", СтрокаПоля.Жирный);
	Поле.Вставить("Курсив", СтрокаПоля.Курсив);
	Поле.Вставить("РазмерШрифта", СтрокаПоля.РазмерШрифта);
	Поле.Вставить("Выравнивание", СокрЛП(СтрокаПоля.Выравнивание));
	Поле.Вставить("Значение", "");
	Поле.Вставить("Строки", Новый Массив);
	Поле.Вставить("Части", Новый Массив); // Фраза: Массив из Структура (Текст, Поле).
	Поле.Вставить("ВоФразе", Ложь); // Поле выводится внутри фразы, а не отдельной строкой.

	Если Поле.Тип = "Таблица" Тогда
		Если Значения = Неопределено Тогда
			Поле.Строки = СтрокиТаблицыПоУмолчанию(Поле.ПоУмолчанию, Поле.Колонки.Количество());
		Иначе
			Ячейки = Значения.Получить(СтрокаПоля.Ключ);
			Если Ячейки <> Неопределено Тогда
				Поле.Строки = Ячейки;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Поле.Тип = "Пояснение" Или Поле.Тип = "Фраза" Тогда
		Поле.Значение = Поле.ПоУмолчанию;
	ИначеЕсли Значения = Неопределено Тогда
		Поле.Значение = ?(Поле.Тип = "ВыборНесколько" Или Поле.Тип = "Выбор",
			ЗначениеВыбораПоУмолчанию(Поле.ПоУмолчанию, Поле.Варианты, Поле.Тип),
			Поле.ПоУмолчанию);
	Иначе
		Значение = Значения.Получить(СтрокаПоля.Ключ);
		Поле.Значение = ?(Значение = Неопределено, "", Значение);
	КонецЕсли;

	Возврат Поле;

КонецФункции

// Значения шаблона заполнения, дополненные значениями по умолчанию для полей, которых в нём нет.
// Вычисляемые поля (возраст, данные пациента) берутся по текущему приёму, а не из шаблона заполнения.
Функция ЗначенияПоУмолчаниюСЗаполнением(Шаблон, ЗначенияЗаполнения, Вычисление)

	Значения = Новый Соответствие;
	Для Каждого СтрокаПоля Из Шаблон.Поля Цикл
		Значение = ЗначенияЗаполнения.Получить(СтрокаПоля.Ключ);
		Если Значение <> Неопределено И Не ЭтоВычисляемоеПоле(СтрокаПоля, Вычисление) Тогда
			Значения.Вставить(СтрокаПоля.Ключ, Значение);
			Продолжить;
		КонецЕсли;
		ПоУмолчанию = ОписаниеПоля(СтрокаПоля, Неопределено, Вычисление);
		Значения.Вставить(СтрокаПоля.Ключ, ?(ПоУмолчанию.Тип = "Таблица", ПоУмолчанию.Строки, ПоУмолчанию.Значение));
	КонецЦикла;
	Возврат Значения;

КонецФункции

#Область ВычисляемыеЗначения

// Контекст вычисления значений по умолчанию: приём, шаблон, значения полей (для переменных алгоритма).
Функция НовоеВычисление(Шаблон, Документ)

	Вычисление = Новый Структура;
	Вычисление.Вставить("Шаблон", Шаблон);
	Вычисление.Вставить("Документ", ?(ЗначениеЗаполнено(Документ), Документ, Неопределено));
	Вычисление.Вставить("ДокументОбъект", Неопределено); // Получается при первом вычислении.
	Вычисление.Вставить("Значения", Неопределено);
	Вычисление.Вставить("ЗначенияПараметров", Новый Соответствие); // Кеш: Параметр -> ЗначениеПоУмолчанию.
	Возврат Вычисление;

КонецФункции

Функция ЗначениеПоУмолчаниюПараметра(Параметр, Вычисление)

	Значение = Вычисление.ЗначенияПараметров.Получить(Параметр);
	Если Значение = Неопределено Тогда
		Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметр, "ЗначениеПоУмолчанию");
		Вычисление.ЗначенияПараметров.Вставить(Параметр, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ЭтоВычисляемоеПоле(СтрокаПоля, Вычисление)

	Если Не ЗначениеЗаполнено(СтрокаПоля.Параметр) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТипЗнч(ЗначениеПоУмолчаниюПараметра(СтрокаПоля.Параметр, Вычисление))
		= Тип("СправочникСсылка.ВычисляемыеЗначенияПараметров");

КонецФункции

// Значение по умолчанию поля из его параметра ПараметрыHTML:
// вычисляемое значение - результат алгоритма по приёму; обычное - если у поля своё значение по умолчанию не задано.
//
// Возвращаемое значение:
//  Строка, Неопределено - Неопределено: оставить значение по умолчанию шаблона.
//
Функция ЗначениеПоУмолчаниюПоПараметру(СтрокаПоля, ТипПоля, Вычисление)

	ЗначениеПараметра = ЗначениеПоУмолчаниюПараметра(СтрокаПоля.Параметр, Вычисление);
	Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.ВычисляемыеЗначенияПараметров") Тогда
		Если Вычисление.Документ = Неопределено Или Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			Возврат Неопределено; // Без приёма (предпросмотр шаблона) вычислять не по чему.
		КонецЕсли;
		Результат = ВычисленноеЗначение(ЗначениеПараметра, СтрокаПоля.Параметр, Вычисление);
		Если Результат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(СтрокаПоля.ЗначениеПоУмолчанию) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		Результат = ЗначениеПараметра;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Возврат ТекстЗначенияПоля(Результат, ТипПоля);

КонецФункции

// Выполняет алгоритм вычисляемого значения так же, как старый механизм (РаботаСШаблонамиHTML):
// в безопасном режиме, с переменными ДокументОбъект, Параметр, Параметры, ШаблонПриема, ПланЛечения, Результат.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Неопределено при ошибке алгоритма.
//
Функция ВычисленноеЗначение(ВычисляемоеЗначение, Параметр, Вычисление)

	Если Вычисление.ДокументОбъект = Неопределено Тогда
		Вычисление.ДокументОбъект = Вычисление.Документ.ПолучитьОбъект();
	КонецЕсли;

	// Переменные контекста алгоритма.
	ДокументОбъект = Вычисление.ДокументОбъект;
	ШаблонПриема = Неопределено;
	ПланЛечения = Неопределено;
	Параметры = ПеременныеАлгоритма(ВычисляемоеЗначение, Параметр, Вычисление);
	Результат = "";

	Алгоритм = Справочники.ВычисляемыеЗначенияПараметров.ПолучитьАлгоритмВычисленияЗначения(ВычисляемоеЗначение);
	УстановитьБезопасныйРежим(Истина);
	Попытка
		Выполнить(Алгоритм);
	Исключение
		УстановитьБезопасныйРежим(Ложь);
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не удалось вычислить «%1»: %2'"),
			Параметр, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Неопределено;
	КонецПопытки;
	УстановитьБезопасныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Переменные алгоритма (табличная часть СписокПеременных): значения полей протокола с тем же параметром.
Функция ПеременныеАлгоритма(ВычисляемоеЗначение, Параметр, Вычисление)

	Параметры = Новый Структура;
	СписокПеременных = ВычисляемоеЗначение.СписокПеременных.НайтиСтроки(Новый Структура("Приемник", Параметр));
	Если СписокПеременных.Количество() = 0 Тогда
		СписокПеременных = ВычисляемоеЗначение.СписокПеременных.НайтиСтроки(
			Новый Структура("Приемник", ПланыВидовХарактеристик.ПараметрыHTML.ПустаяСсылка()));
	КонецЕсли;

	Для Каждого Переменная Из СписокПеременных Цикл
		ТипЗначения = Переменная.Параметр.ТипЗначения;
		Значение = ТипЗначения.ПривестиЗначение(Неопределено);
		Для Каждого СтрокаПоля Из Вычисление.Шаблон.Поля Цикл
			Если СтрокаПоля.Параметр <> Переменная.Параметр Тогда
				Продолжить;
			КонецЕсли;
			Текст = СтрокаПоля.ЗначениеПоУмолчанию;
			Если Вычисление.Значения <> Неопределено И ТипЗнч(Вычисление.Значения.Получить(СтрокаПоля.Ключ)) = Тип("Строка") Тогда
				Текст = Вычисление.Значения.Получить(СтрокаПоля.Ключ);
			КонецЕсли;
			Значение = ЗначениеИзТекста(Текст, ТипЗначения);
			Прервать;
		КонецЦикла;
		Попытка
			Параметры.Вставить(Переменная.ИмяПеременной, Значение);
		Исключение
			// Имя переменной не годится для ключа структуры - алгоритм её не получит.
		КонецПопытки;
	КонецЦикла;

	Возврат Параметры;

КонецФункции

Функция ЗначениеИзТекста(Знач Текст, ТипЗначения)

	Текст = СокрЛП(Текст);
	Попытка
		Если ТипЗначения.СодержитТип(Тип("Число")) Тогда
			Возврат ?(ПустаяСтрока(Текст), 0, Число(СтрЗаменить(Текст, ",", ".")));
		ИначеЕсли ТипЗначения.СодержитТип(Тип("Дата")) Тогда
			Возврат ?(ПустаяСтрока(Текст), Дата(1, 1, 1), Дата(СтрЗаменить(СтрЗаменить(Текст, "-", ""), ".", "")));
		ИначеЕсли ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			Возврат Текст = "Да";
		ИначеЕсли ТипЗначения.СодержитТип(Тип("Строка")) Тогда
			Возврат Текст;
		КонецЕсли;
	Исключение
		// Текст не приводится к типу параметра.
	КонецПопытки;
	Возврат ТипЗначения.ПривестиЗначение(Неопределено);

КонецФункции

// Значение в виде, который понимает поле страницы: дата поля «Дата» - ГГГГ-ММ-ДД, флажок - Да/Нет.
Функция ТекстЗначенияПоля(Значение, ТипПоля)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		Возврат ?(ТипПоля = "Дата", Формат(Значение, "ДФ=yyyy-MM-dd"), Формат(Значение, "ДЛФ=D"));
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧГ=0");
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

Функция ТекущийВрач()

	Пользователь = Пользователи.ТекущийПользователь();
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Сотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователь, "Сотрудник");
		Если ТипЗнч(Сотрудник) = Тип("СправочникСсылка.Сотрудники") Тогда
			Возврат Сотрудник;
		КонецЕсли;
	КонецЕсли;
	Возврат Справочники.Сотрудники.ПустаяСсылка();

КонецФункции

// Соответствие: ключ поля -> Строка или Массив строк таблицы (Массив из Массив из Строка).
// Неопределено, если по приёму и шаблону ещё ничего не сохранено.
Функция СохраненныеЗначения(Документ, Шаблон)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.КлючПоля КАК КлючПоля,
	|	Значения.НомерСтрокиТаблицы КАК НомерСтрокиТаблицы,
	|	Значения.НомерКолонки КАК НомерКолонки,
	|	Значения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.омг_ЗначенияПолейПротоколов КАК Значения
	|ГДЕ
	|	Значения.Документ = &Документ
	|	И Значения.Шаблон = &Шаблон
	|
	|УПОРЯДОЧИТЬ ПО
	|	КлючПоля,
	|	НомерСтрокиТаблицы,
	|	НомерКолонки";
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если Выборка.НомерСтрокиТаблицы = 0 Тогда
			Результат.Вставить(Выборка.КлючПоля, Выборка.Значение);
			Продолжить;
		КонецЕсли;
		Строки = Результат.Получить(Выборка.КлючПоля);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			Результат.Вставить(Выборка.КлючПоля, Строки);
		КонецЕсли;
		Пока Строки.Количество() < Выборка.НомерСтрокиТаблицы Цикл
			Строки.Добавить(Новый Массив);
		КонецЦикла;
		Ячейки = Строки[Выборка.НомерСтрокиТаблицы - 1];
		Пока Ячейки.Количество() < Выборка.НомерКолонки Цикл
			Ячейки.Добавить("");
		КонецЦикла;
		Ячейки[Выборка.НомерКолонки - 1] = Выборка.Значение;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Переносит в модель общую шапку: логотип, название клиники, строки-пояснения и поля.
// Поля шапки заполняются из приёма по названию (Пациент, Дата рождения, Врач, Дата приёма,
// Филиал, Специализация), остальные - значением по умолчанию.
Процедура ЗаполнитьОбщуюШапку(Модель, ШаблонШапки, Документ)

	Логотип = ШаблонШапки.Логотип.Получить();
	Если ТипЗнч(Логотип) = Тип("ДвоичныеДанные") Тогда
		Модель.Логотип = Логотип;
	КонецЕсли;
	Модель.Организация = ШаблонШапки.ЗаголовокПечати;

	Реквизиты = РеквизитыПриемаДляПолей(Документ);

	Для Каждого СтрокаПоля Из ШаблонШапки.Поля Цикл
		Если СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.Пояснение Тогда
			Если Не ПустаяСтрока(СтрокаПоля.ЗначениеПоУмолчанию) Тогда
				Модель.СтрокиШапки.Добавить(СтрокаПоля.ЗначениеПоУмолчанию);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеРеквизитаПриема(СтрокаПоля.Наименование, Реквизиты);
		Если Значение = Неопределено Тогда
			Значение = СтрокаПоля.ЗначениеПоУмолчанию;
		КонецЕсли;
		Модель.Шапка.Добавить(Новый Структура("Название, Значение", СтрокаПоля.Наименование, Значение));
	КонецЦикла;

КонецПроцедуры

// Реквизиты приёма, которыми заполняются поля шапки и протокола по названию (см. ЗначениеРеквизитаПриема).
Функция РеквизитыПриемаДляПолей(Документ)

	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИменаРеквизитов = Новый Структура("Дата, Клиент, Врач, Филиал, Специализация, МедицинскаяКарта");
	ИменаРеквизитов.Вставить("КлиентДатаРождения", "Клиент.ДатаРождения");
	ИменаРеквизитов.Вставить("КлиентИНН", "Клиент.ИНН");
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, ИменаРеквизитов);

КонецФункции

// Поля протокола с названием реквизита приёма («ФИО пациентки», «Дата рождения», «ИИН»,
// «№ медицинской карты»...) заполняются из приёма, как поля общей шапки.
// Возвращает Истина, если такие поля есть (тогда стандартные строки шапки не выводятся).
Функция ЗаполнитьПоляИзПриема(Модель, Документ)

	Реквизиты = РеквизитыПриемаДляПолей(Документ);
	Есть = Ложь;
	Для Каждого Раздел Из Модель.Разделы Цикл
		Для Каждого Поле Из Раздел.Поля Цикл
			Если Поле.Тип = "Пояснение" Или Поле.Тип = "Таблица" Или Поле.Тип = "Фраза"
				Или ЗначениеЗаполнено(Поле.Параметр) Тогда
				Продолжить; // У поля с параметром значение - вычисляемое значение параметра.
			КонецЕсли;
			Значение = ЗначениеРеквизитаПриема(Поле.Наименование, Реквизиты);
			Если Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Есть = Истина;
			Поле.ПоУмолчанию = Значение;
			Поле.Значение = Значение;
		КонецЦикла;
	КонецЦикла;
	Возврат Есть;

КонецФункции

// Значение реквизита приёма по названию поля шапки; Неопределено, если название не распознано.
Функция ЗначениеРеквизитаПриема(Название, Реквизиты)

	Имя = СтрЗаменить(НРег(СокрЛП(Название)), "ё", "е");
	Если СтрНайти(Имя, "/") > 0 Тогда
		Имя = СокрЛП(Лев(Имя, СтрНайти(Имя, "/") - 1)); // Двуязычная подпись «Дата рождения / Туған күні».
	КонецЕсли;
	Если Имя = "пациент" Или Имя = "пациентка" Или Имя = "клиент" Или Имя = "фио" Или Имя = "фио пациента"
		Или Имя = "фио пациентки" Тогда
		ИмяРеквизита = "Клиент";
	ИначеЕсли Имя = "дата рождения" Тогда
		ИмяРеквизита = "КлиентДатаРождения";
	ИначеЕсли Имя = "врач" Или Имя = "фио врача" Тогда
		ИмяРеквизита = "Врач";
	ИначеЕсли Имя = "дата" Или Имя = "дата приема" Или Имя = "дата осмотра" Тогда
		ИмяРеквизита = "Дата";
	ИначеЕсли Имя = "филиал" Тогда
		ИмяРеквизита = "Филиал";
	ИначеЕсли Имя = "специализация" Или Имя = "специальность" Тогда
		ИмяРеквизита = "Специализация";
	ИначеЕсли Имя = "иин" Или Имя = "иин пациента" Или Имя = "иин пациентки" Или Имя = "жсн" Тогда
		ИмяРеквизита = "КлиентИНН";
	ИначеЕсли Имя = "№ медицинской карты" Или Имя = "номер медицинской карты" Или Имя = "медицинская карта"
		Или Имя = "№ карты" Или Имя = "номер карты" Или Имя = "№ амбулаторной карты" Тогда
		ИмяРеквизита = "МедицинскаяКарта";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если Реквизиты = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = Реквизиты[ИмяРеквизита];
	Если ИмяРеквизита = "Дата" И Имя = "дата осмотра" Тогда
		Возврат Формат(Значение, "ДЛФ=D");
	ИначеЕсли ИмяРеквизита = "Дата" Тогда
		Возврат Формат(Значение, "ДЛФ=DT");
	ИначеЕсли ИмяРеквизита = "КлиентДатаРождения" Тогда
		Возврат Формат(Значение, "ДЛФ=D");
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Значение), Строка(Значение), "");

КонецФункции

Функция ШапкаПротокола(Документ)

	Шапка = Новый Массив;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Шапка.Добавить(Новый Структура("Название, Значение", НСтр("ru = 'Пациент'"), ""));
		Шапка.Добавить(Новый Структура("Название, Значение", НСтр("ru = 'Дата приёма'"), ""));
		Возврат Шапка;
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Дата, Клиент, Врач, Филиал");
	Шапка.Добавить(Новый Структура("Название, Значение", НСтр("ru = 'Пациент'"), Строка(Реквизиты.Клиент)));
	Шапка.Добавить(Новый Структура("Название, Значение", НСтр("ru = 'Дата приёма'"), Формат(Реквизиты.Дата, "ДЛФ=DT")));
	Шапка.Добавить(Новый Структура("Название, Значение", НСтр("ru = 'Врач'"), Строка(Реквизиты.Врач)));
	Если ЗначениеЗаполнено(Реквизиты.Филиал) Тогда
		Шапка.Добавить(Новый Структура("Название, Значение", НСтр("ru = 'Филиал'"), Строка(Реквизиты.Филиал)));
	КонецЕсли;
	Возврат Шапка;

КонецФункции

Функция СписокИзСтроки(Строка)

	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Строка, ";" + Символы.ПС, Ложь) Цикл
		Часть = СокрЛП(Часть);
		Если Не ПустаяСтрока(Часть) Тогда
			Результат.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строки таблицы по умолчанию хранятся текстом: строка таблицы - строка текста, ячейки через «;».
Функция СтрокиТаблицыПоУмолчанию(Текст, КоличествоКолонок)

	Строки = Новый Массив;
	Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Ячейки = Новый Массив;
		Для Каждого Ячейка Из СтрРазделить(СтрокаТекста, ";", Истина) Цикл
			Ячейки.Добавить(СокрЛП(Ячейка));
		КонецЦикла;
		Пока Ячейки.Количество() < КоличествоКолонок Цикл
			Ячейки.Добавить("");
		КонецЦикла;
		Строки.Добавить(Ячейки);
	КонецЦикла;
	Возврат Строки;

КонецФункции

Функция ЗначениеВыбораПоУмолчанию(ПоУмолчанию, Варианты, Тип)

	Если Не ПустаяСтрока(ПоУмолчанию) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если Тип = "Выбор" И Варианты.Количество() > 0 Тогда
		Возврат Варианты[0];
	КонецЕсли;
	Возврат "";

КонецФункции

// Модель для страницы ввода: латинские ключи, логотип как data URI.
// Фраза - текст с полями внутри: «менархе в {{Менархе}} лет, цикл {{Цикл}} дн.».
// В {{}} - наименование поля того же раздела; такие поля выводятся внутри фразы.
Процедура СвязатьФразыРаздела(Раздел)

	ПоИмени = Новый Соответствие;
	ЕстьФразы = Ложь;
	Для Каждого Поле Из Раздел.Поля Цикл
		Если Поле.Тип = "Фраза" Тогда
			ЕстьФразы = Истина;
		ИначеЕсли Поле.Тип <> "Пояснение" И Поле.Тип <> "Таблица" Тогда
			Ключ = НРег(СокрЛП(Поле.Наименование));
			Если ПоИмени[Ключ] = Неопределено Тогда
				ПоИмени.Вставить(Ключ, Поле);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьФразы Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Поле Из Раздел.Поля Цикл
		Если Поле.Тип <> "Фраза" Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Поле.Значение;
		Пока Истина Цикл
			Начало = СтрНайти(Остаток, "{{");
			Конец = ?(Начало = 0, 0, СтрНайти(Остаток, "}}", , Начало));
			Если Конец = 0 Тогда
				Прервать;
			КонецЕсли;
			Имя = Сред(Остаток, Начало + 2, Конец - Начало - 2);
			ПолеФразы = ПоИмени[НРег(СокрЛП(Имя))];
			Если ПолеФразы = Неопределено Тогда
				// Нет такого поля - оставляем текст как есть.
				Поле.Части.Добавить(Новый Структура("Текст, Поле", Лев(Остаток, Конец + 1), Неопределено));
			Иначе
				Поле.Части.Добавить(Новый Структура("Текст, Поле", Лев(Остаток, Начало - 1), ПолеФразы));
				ПолеФразы.ВоФразе = Истина;
			КонецЕсли;
			Остаток = Сред(Остаток, Конец + 2);
		КонецЦикла;
		Если Не ПустаяСтрока(Остаток) Тогда
			Поле.Части.Добавить(Новый Структура("Текст, Поле", Остаток, Неопределено));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Текст фразы для печати: значения полей подставлены, пустые - прочерком для записи от руки.
Функция ТекстФразы(Поле)

	Тексты = Новый Массив;
	Для Каждого Часть Из Поле.Части Цикл
		Тексты.Добавить(Часть.Текст);
		Если Часть.Поле <> Неопределено Тогда
			Значение = ПредставлениеЗначения(Часть.Поле);
			Тексты.Добавить(?(ПустаяСтрока(Значение), "____", Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, "");

КонецФункции

Функция МодельВJSON(Модель)

	Данные = Новый Структура;
	Данные.Вставить("title", Модель.Заголовок);
	Данные.Вставить("logo", "");
	Если ТипЗнч(Модель.Логотип) = Тип("ДвоичныеДанные") Тогда
		Base64 = СтрЗаменить(СтрЗаменить(Base64Строка(Модель.Логотип), Символы.ВК, ""), Символы.ПС, "");
		Данные.logo = "data:image/png;base64," + Base64;
	КонецЕсли;

	Данные.Вставить("org", Модель.Организация);
	Данные.Вставить("orgLines", Модель.СтрокиШапки);

	Шапка = Новый Массив;
	Для Каждого СтрокаШапки Из Модель.Шапка Цикл
		Шапка.Добавить(Новый Структура("label, value", СтрокаШапки.Название, СтрокаШапки.Значение));
	КонецЦикла;
	Данные.Вставить("header", Шапка);

	Разделы = Новый Массив;
	Для Каждого Раздел Из Модель.Разделы Цикл
		Поля = Новый Массив;
		Для Каждого Поле Из Раздел.Поля Цикл
			ДанныеПоля = Новый Структура;
			ДанныеПоля.Вставить("key", Поле.Ключ);
			ДанныеПоля.Вставить("title", Поле.Наименование);
			ДанныеПоля.Вставить("type", Поле.Тип);
			ДанныеПоля.Вставить("value", Поле.Значение);
			ДанныеПоля.Вставить("def", Поле.ПоУмолчанию);
			ДанныеПоля.Вставить("unit", Поле.ЕдиницаИзмерения);
			ДанныеПоля.Вставить("required", Поле.Обязательное);
			ДанныеПоля.Вставить("options", Поле.Варианты);
			ДанныеПоля.Вставить("columns", Поле.Колонки);
			ДанныеПоля.Вставить("rows", Поле.Строки);
			ДанныеПоля.Вставить("bold", Поле.Жирный);
			ДанныеПоля.Вставить("italic", Поле.Курсив);
			ДанныеПоля.Вставить("size", Поле.РазмерШрифта);
			ДанныеПоля.Вставить("align", Поле.Выравнивание);
			ДанныеПоля.Вставить("param", ?(ЗначениеЗаполнено(Поле.Параметр), XMLСтрока(Поле.Параметр), ""));
			ДанныеПоля.Вставить("inPhrase", Поле.ВоФразе);
			Если Поле.Тип = "Фраза" Тогда
				ЧастиФразы = Новый Массив;
				Для Каждого Часть Из Поле.Части Цикл
					ЧастиФразы.Добавить(Новый Структура("t, k", Часть.Текст, ?(Часть.Поле = Неопределено, "", Часть.Поле.Ключ)));
				КонецЦикла;
				ДанныеПоля.Вставить("parts", ЧастиФразы);
			КонецЕсли;
			Поля.Добавить(ДанныеПоля);
		КонецЦикла;
		Разделы.Добавить(Новый Структура("key, title, fields, size, align",
			Раздел.Ключ, Раздел.Наименование, Поля, Раздел.РазмерШрифта, Раздел.Выравнивание));
	КонецЦикла;
	Данные.Вставить("sections", Разделы);
	Данные.Вставить("font", Модель.Шрифт);
	Данные.Вставить("size", Модель.РазмерШрифта);
	Данные.Вставить("dirty", Модель.Изменен);
	Данные.Вставить("html", Модель.HTML);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область Печать

// Сетка печатной формы: 50 колонок по 2 единицы ширины - 100 на всю ширину страницы.
Функция КолонокСетки()
	Возврат 50;
КонецФункции

Функция ШиринаКолонкиСетки()
	Возврат 2;
КонецФункции

// Название поля занимает 15 колонок сетки (30%), значение - остальные.
Функция КолонокНазвания()
	Возврат 15;
КонецФункции

Функция МаксимумКолонокТаблицы()
	Возврат 10;
КонецФункции

Функция ПолеПечатается(Поле)

	Если Поле.ВоФразе Тогда
		Возврат Ложь; // Печатается в составе фразы.
	ИначеЕсли Поле.Тип = "Фраза" Тогда
		Для Каждого Часть Из Поле.Части Цикл
			Если Часть.Поле <> Неопределено И Не ПустаяСтрока(ПредставлениеЗначения(Часть.Поле)) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Не Поле.СкрыватьЕслиПусто;
	ИначеЕсли Поле.Тип = "Пояснение" Тогда
		Возврат Не ПустаяСтрока(Поле.Значение);
	ИначеЕсли Поле.Тип = "Таблица" Тогда
		Для Каждого Ячейки Из Поле.Строки Цикл
			Для Каждого Ячейка Из Ячейки Цикл
				Если Не ПустаяСтрока(Ячейка) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат Не Поле.СкрыватьЕслиПусто;
	КонецЕсли;

	Возврат Не (Поле.СкрыватьЕслиПусто И ПустаяСтрока(ПредставлениеЗначения(Поле)));

КонецФункции

Функция ПредставлениеЗначения(Поле)

	Значение = СокрЛП(Поле.Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Если Поле.Тип = "Флажок" Тогда
		Возврат ?(Значение = "Да", НСтр("ru = 'Да'"), НСтр("ru = 'Нет'"));
	ИначеЕсли Поле.Тип = "Дата" Тогда
		Попытка
			Возврат Формат(Дата(СтрЗаменить(Значение, "-", "")), "ДЛФ=D");
		Исключение
			Возврат Значение;
		КонецПопытки;
	ИначеЕсли Не ПустаяСтрока(Поле.ЕдиницаИзмерения) Тогда
		Возврат Значение + " " + Поле.ЕдиницаИзмерения;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Оформление ячейки печатной формы.
//
// Параметры:
//  Модель       - Структура - см. МодельПротокола (Шрифт).
//  Размер       - Число - размер шрифта в пунктах.
//  Жирный, Курсив - Булево
//  Выравнивание - Строка - "", "Лево", "Центр", "Право", "Ширина".
//
Функция НовоеОформление(Модель, Размер, Жирный = Ложь, Курсив = Ложь, Выравнивание = "")

	Оформление = Новый Структура;
	Оформление.Вставить("Шрифт", Модель.Шрифт);
	Оформление.Вставить("Размер", Размер);
	Оформление.Вставить("Жирный", Жирный = Истина);
	Оформление.Вставить("Курсив", Курсив = Истина);
	Оформление.Вставить("Выравнивание", Выравнивание);
	Возврат Оформление;

КонецФункции

Функция ГоризонтальноеПоложениеТекста(Выравнивание)

	Если Выравнивание = "Центр" Тогда
		Возврат ГоризонтальноеПоложение.Центр;
	ИначеЕсли Выравнивание = "Право" Тогда
		Возврат ГоризонтальноеПоложение.Право;
	ИначеЕсли Выравнивание = "Ширина" Тогда
		Возврат ГоризонтальноеПоложение.ПоШирине;
	КонецЕсли;
	Возврат ГоризонтальноеПоложение.Лево;

КонецФункции

// Выводит текст в ячейку из колонок сетки С..По текущей строки (объединяя их)
// и возвращает число строк текста при переносе по ширине ячейки.
Функция ВывестиЯчейку(Лист, КолонкаС, КолонкаПо, Текст, Оформление, Рамка = Ложь)

	Область = Лист.ТД.Область(Лист.Строка, КолонкаС + 1, Лист.Строка, КолонкаПо + 1);
	Если КолонкаПо > КолонкаС Тогда
		Область.Объединить();
	КонецЕсли;
	Область.Текст = Текст;
	Область.Шрифт = Новый Шрифт(Оформление.Шрифт, Оформление.Размер, Оформление.Жирный, Оформление.Курсив);
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложениеТекста(Оформление.Выравнивание);
	Если Рамка Тогда
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		Область.Обвести(Линия, Линия, Линия, Линия);
	КонецЕсли;

	Возврат ЧислоСтрокТекста(Текст, (КолонкаПо - КолонкаС + 1) * ШиринаКолонкиСетки() - ?(Рамка, 1, 0), Оформление);

КонецФункции

// Оценка числа строк текста в ячейке шириной Ширина (в единицах ширины колонки - примерно
// символы шрифта 10 пт). У объединённых ячеек платформа не подбирает высоту строки сама.
Функция ЧислоСтрокТекста(Текст, Ширина, Оформление)

	СимволовВСтроке = Ширина * 10 / Макс(Оформление.Размер, 6) * ?(Оформление.Жирный, 0.85, 0.95);
	СимволовВСтроке = Макс(Цел(СимволовВСтроке), 1);
	Строк = 0;
	Для Каждого Абзац Из СтрРазделить(СокрП(Текст), Символы.ПС, Истина) Цикл
		// Перенос идёт по словам, поэтому строка заполняется не полностью - запас 15%.
		Длина = СтрДлина(СокрП(Абзац)) * 1.15;
		Строк = Строк + Макс(1, Цел((Длина + СимволовВСтроке - 1) / СимволовВСтроке));
	КонецЦикла;
	Возврат Макс(Строк, 1);

КонецФункции

// Завершает текущую строку: высота по самой длинной ячейке.
Процедура УстановитьВысотуСтроки(Лист, ЧислоСтрок, Размер)

	Лист.ТД.Область(Лист.Строка, , Лист.Строка, ).ВысотаСтроки = ЧислоСтрок * Размер * 1.3 + 2;

КонецПроцедуры

// Строка "Название: значение": название слева, значение справа с переносом.
Процедура ВывестиНазваниеЗначение(Лист, Название, Значение, ОформлениеНазвания, ОформлениеЗначения)

	Лист.Строка = Лист.Строка + 1;
	Граница = КолонокНазвания();
	СтрокНазвания = ВывестиЯчейку(Лист, 1, Граница, Название + ":", ОформлениеНазвания);
	СтрокЗначения = ВывестиЯчейку(Лист, Граница + 1, КолонокСетки(), Значение, ОформлениеЗначения);
	УстановитьВысотуСтроки(Лист, Макс(СтрокНазвания, СтрокЗначения), Макс(ОформлениеНазвания.Размер, ОформлениеЗначения.Размер));

КонецПроцедуры

// Текст на всю ширину страницы.
Процедура ВывестиНаВсюШирину(Лист, Текст, Оформление)

	Лист.Строка = Лист.Строка + 1;
	Строк = ВывестиЯчейку(Лист, 1, КолонокСетки(), Текст, Оформление);
	УстановитьВысотуСтроки(Лист, Строк, Оформление.Размер);

КонецПроцедуры

Процедура ВывестиПустуюСтроку(Лист)

	Лист.Строка = Лист.Строка + 1;
	Лист.ТД.Область(Лист.Строка, , Лист.Строка, ).ВысотаСтроки = 6;

КонецПроцедуры

Процедура ВывестиТаблицу(Лист, Поле, Модель)

	РазмерТаблицы = ?(Поле.РазмерШрифта > 0, Поле.РазмерШрифта, Макс(Модель.РазмерШрифта - 1, 6));

	Если Не ПустаяСтрока(Поле.Наименование) Тогда
		ВывестиНаВсюШирину(Лист, Поле.Наименование + ":", НовоеОформление(Модель, Модель.РазмерШрифта, Истина));
	КонецЕсли;

	Колонок = Макс(Поле.Колонки.Количество(), 1);
	Для Каждого Ячейки Из Поле.Строки Цикл
		Колонок = Макс(Колонок, Ячейки.Количество());
	КонецЦикла;
	Колонок = Мин(Колонок, МаксимумКолонокТаблицы());

	// Колонки таблицы - равные части сетки, остаток отдаётся последней колонке.
	КолонокСеткиНаЯчейку = Цел(КолонокСетки() / Колонок);
	Границы = Новый Массив;
	Для НомерКолонки = 1 По Колонок Цикл
		Начало = (НомерКолонки - 1) * КолонокСеткиНаЯчейку + 1;
		Конец = ?(НомерКолонки = Колонок, КолонокСетки(), Начало + КолонокСеткиНаЯчейку - 1);
		Границы.Добавить(Новый Структура("С, По", Начало, Конец));
	КонецЦикла;

	ОформлениеЗаголовка = НовоеОформление(Модель, РазмерТаблицы, Истина);
	ОформлениеЯчейки = НовоеОформление(Модель, РазмерТаблицы, Поле.Жирный, Поле.Курсив, Поле.Выравнивание);

	Если Поле.Колонки.Количество() > 0 Тогда
		Лист.Строка = Лист.Строка + 1;
		Строк = 1;
		Для НомерКолонки = 1 По Колонок Цикл
			Заголовок = ?(НомерКолонки <= Поле.Колонки.Количество(), Поле.Колонки[НомерКолонки - 1], "");
			Строк = Макс(Строк, ВывестиЯчейку(Лист, Границы[НомерКолонки - 1].С, Границы[НомерКолонки - 1].По,
				Заголовок, ОформлениеЗаголовка, Истина));
		КонецЦикла;
		УстановитьВысотуСтроки(Лист, Строк, РазмерТаблицы);
	КонецЕсли;

	Для Каждого Ячейки Из Поле.Строки Цикл
		Лист.Строка = Лист.Строка + 1;
		Строк = 1;
		Для НомерКолонки = 1 По Колонок Цикл
			Текст = ?(НомерКолонки <= Ячейки.Количество(), Ячейки[НомерКолонки - 1], "");
			Строк = Макс(Строк, ВывестиЯчейку(Лист, Границы[НомерКолонки - 1].С, Границы[НомерКолонки - 1].По,
				Текст, ОформлениеЯчейки, Истина));
		КонецЦикла;
		УстановитьВысотуСтроки(Лист, Строк, РазмерТаблицы);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СвободнаяВерсткаСлужебные

Функция ОписаниеПоляРедактора(СтрокаПоля)

	Описание = Новый Структура;
	Описание.Вставить("key", СтрокаПоля.Ключ);
	Описание.Вставить("name", СтрокаПоля.Наименование);
	Описание.Вставить("type", ?(ЗначениеЗаполнено(СтрокаПоля.ТипПоля), XMLСтрока(СтрокаПоля.ТипПоля), "Текст"));
	Описание.Вставить("typeTitle", Строка(СтрокаПоля.ТипПоля));
	Описание.Вставить("def", СтрокаПоля.ЗначениеПоУмолчанию);
	Описание.Вставить("opts", СтрокаПоля.ВариантыВыбора);
	Описание.Вставить("cols", СтрокаПоля.КолонкиТаблицы);
	Описание.Вставить("unit", СтрокаПоля.ЕдиницаИзмерения);
	Описание.Вставить("param", ?(ЗначениеЗаполнено(СтрокаПоля.Параметр), XMLСтрока(СтрокаПоля.Параметр), ""));
	Описание.Вставить("paramName", ?(ЗначениеЗаполнено(СтрокаПоля.Параметр), Строка(СтрокаПоля.Параметр), ""));
	Описание.Вставить("req", СтрокаПоля.Обязательное);
	Возврат Описание;

КонецФункции

Процедура ЗаполнитьПолеИзРедактора(СтрокаПоля, Описание)

	ТипыПолей = "Текст,Строка,Число,Дата,Флажок,Выбор,ВыборНесколько,Таблица";
	ИмяТипа = СвойствоОписания(Описание, "type", "Текст");
	Если СтрРазделить(ТипыПолей, ",").Найти(ИмяТипа) = Неопределено Тогда
		ИмяТипа = "Текст";
	КонецЕсли;
	СтрокаПоля.Наименование = Лев(СокрЛП(СвойствоОписания(Описание, "name", "")), 250);
	Если ПустаяСтрока(СтрокаПоля.Наименование) Тогда
		СтрокаПоля.Наименование = НСтр("ru = 'Поле'");
	КонецЕсли;
	СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола[ИмяТипа];
	СтрокаПоля.ЗначениеПоУмолчанию = СвойствоОписания(Описание, "def", "");
	СтрокаПоля.ВариантыВыбора = СвойствоОписания(Описание, "opts", "");
	СтрокаПоля.КолонкиТаблицы = СвойствоОписания(Описание, "cols", "");
	СтрокаПоля.ЕдиницаИзмерения = СвойствоОписания(Описание, "unit", "");
	СтрокаПоля.Обязательное = (СвойствоОписания(Описание, "req", Ложь) = Истина);
	// В свободной вёрстке пустое поле печатается пустым местом, строка не скрывается.
	СтрокаПоля.СкрыватьЕслиПусто = Ложь;
	СтрокаПоля.Параметр = ПланыВидовХарактеристик.ПараметрыHTML.ПустаяСсылка();
	ИдентификаторПараметра = СвойствоОписания(Описание, "param", "");
	Если Не ПустаяСтрока(ИдентификаторПараметра) Тогда
		Попытка
			СтрокаПоля.Параметр = ПланыВидовХарактеристик.ПараметрыHTML.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторПараметра));
		Исключение
			СтрокаПоля.Параметр = ПланыВидовХарактеристик.ПараметрыHTML.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция СвойствоОписания(Описание, Имя, ПоУмолчанию)

	Значение = Неопределено;
	Если ТипЗнч(Описание) = Тип("Структура") И Описание.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Если ТипЗнч(ПоУмолчанию) = Тип("Строка") И ТипЗнч(Значение) <> Тип("Строка") Тогда
			Возврат Строка(Значение);
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

Функция ТипПоляПоПараметру(Параметр)

	Типы = Параметр.ТипЗначения;
	Если Типы.СодержитТип(Тип("Число")) Тогда
		Возврат "Число";
	ИначеЕсли Типы.СодержитТип(Тип("Дата")) Тогда
		Возврат "Дата";
	ИначеЕсли Типы.СодержитТип(Тип("Булево")) Тогда
		Возврат "Флажок";
	ИначеЕсли Типы.СодержитТип(Тип("Строка")) И Типы.КвалификаторыСтроки.Длина > 0 И Типы.КвалификаторыСтроки.Длина <= 150 Тогда
		Возврат "Строка";
	КонецЕсли;
	Возврат "Текст";

КонецФункции

Функция ЗначениеВСтрокуJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ТекстHTML(Знач Текст)

	Текст = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Возврат Текст;

КонецФункции

Функция ТекстHTMLМногострочный(Текст)

	Возврат СтрЗаменить(СтрЗаменить(ТекстHTML(Текст), Символы.ВК, ""), Символы.ПС, "<br>");

КонецФункции

// Плашки <span class="omg-f" data-key="...">Имя</span> заменяются значениями полей.
Функция ПодставитьЗначенияВHTML(ТекстHTMLШаблона, Значения)

	Начало = "<span class=""omg-f"" data-key=""";
	Результат = Новый Массив;
	Остаток = ТекстHTMLШаблона;
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, Начало);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		КонецКлюча = СтрНайти(Остаток, """", , Позиция + СтрДлина(Начало));
		Конец = СтрНайти(Остаток, "</span>", , Позиция);
		Если КонецКлюча = 0 Или Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Ключ = Сред(Остаток, Позиция + СтрДлина(Начало), КонецКлюча - Позиция - СтрДлина(Начало));
		Результат.Добавить(Лев(Остаток, Позиция - 1));
		Поле = Значения[Ключ];
		Результат.Добавить(?(Поле = Неопределено, "", ЗначениеПоляHTML(Поле)));
		Остаток = Сред(Остаток, Конец + СтрДлина("</span>"));
	КонецЦикла;
	Результат.Добавить(Остаток);
	Возврат СтрСоединить(Результат, "");

КонецФункции

Функция ЗначениеПоляHTML(Поле)

	Если Поле.Тип = "Таблица" Тогда
		Части = Новый Массив;
		Части.Добавить("<table class=""omg-t""><tr>");
		Для Каждого Колонка Из Поле.Колонки Цикл
			Части.Добавить("<th>" + ТекстHTML(Колонка) + "</th>");
		КонецЦикла;
		Части.Добавить("</tr>");
		Для Каждого Ячейки Из Поле.Строки Цикл
			Части.Добавить("<tr>");
			Для Каждого Ячейка Из Ячейки Цикл
				Части.Добавить("<td>" + ТекстHTMLМногострочный(Ячейка) + "</td>");
			КонецЦикла;
			Части.Добавить("</tr>");
		КонецЦикла;
		Части.Добавить("</table>");
		Возврат СтрСоединить(Части, "");
	КонецЕсли;

	Значение = ПредставлениеЗначения(Поле);
	Если ПустаяСтрока(Значение) Тогда
		Возврат "_______";
	КонецЕсли;
	Возврат ТекстHTMLМногострочный(Значение);

КонецФункции

// Шаблон из разделов и полей в виде HTML для визуального редактора.
Функция HTMLИзСтруктуры(Шаблон)

	Части = Новый Массив;
	Если Не Шаблон.ЭтоШапка Тогда
		Заголовок = ?(ЗначениеЗаполнено(Шаблон.ЗаголовокПечати), Шаблон.ЗаголовокПечати, Шаблон.Наименование);
		Если Не ПустаяСтрока(Заголовок) Тогда
			Части.Добавить("<p style=""text-align:center""><b><span style=""font-size:"
				+ Формат(?(Шаблон.РазмерШрифта > 0, Шаблон.РазмерШрифта, 10) + 2, "ЧГ=0") + "pt"">"
				+ ТекстHTML(ВРег(Заголовок)) + "</span></b></p>");
		КонецЕсли;
	КонецЕсли;

	Для Каждого СтрокаРаздела Из Шаблон.Разделы Цикл
		Раздел = Новый Структура("Наименование, Поля", СтрокаРаздела.Наименование, Новый Массив);
		Для Каждого СтрокаПоля Из Шаблон.Поля Цикл
			Если СтрокаПоля.КлючРаздела = СтрокаРаздела.Ключ Тогда
				Раздел.Поля.Добавить(ОписаниеПоля(СтрокаПоля, Неопределено));
			КонецЕсли;
		КонецЦикла;
		СвязатьФразыРаздела(Раздел);

		Если СтрокаРаздела.ПечататьЗаголовок Тогда
			Части.Добавить("<p style=""margin-top:8px" + СтильВыравниванияHTML(СтрокаРаздела.Выравнивание) + """><b>"
				+ ОбернутьРазмеромHTML(ТекстHTML(СтрокаРаздела.Наименование), СтрокаРаздела.РазмерШрифта) + "</b></p>");
		КонецЕсли;

		Для Каждого Поле Из Раздел.Поля Цикл
			Если Поле.ВоФразе Тогда
				Продолжить;
			КонецЕсли;
			Если Поле.Тип = "Пояснение" Тогда
				Содержимое = ТекстHTMLМногострочный(Поле.Значение);
			ИначеЕсли Поле.Тип = "Фраза" Тогда
				Тексты = Новый Массив;
				Для Каждого Часть Из Поле.Части Цикл
					Тексты.Добавить(ТекстHTML(Часть.Текст));
					Если Часть.Поле <> Неопределено Тогда
						Тексты.Добавить(ПлашкаHTML(Часть.Поле));
					КонецЕсли;
				КонецЦикла;
				Содержимое = СтрСоединить(Тексты, "");
			ИначеЕсли ПустаяСтрока(Поле.Наименование) Или Поле.Наименование = Раздел.Наименование Или Поле.Тип = "Таблица" Тогда
				Содержимое = ПлашкаHTML(Поле);
			Иначе
				Содержимое = "<b>" + ТекстHTML(Поле.Наименование) + ":</b> " + ПлашкаHTML(Поле)
					+ ?(ПустаяСтрока(Поле.ЕдиницаИзмерения) Или Поле.Тип = "Число", "", " " + ТекстHTML(Поле.ЕдиницаИзмерения));
			КонецЕсли;
			Если Поле.Жирный Тогда
				Содержимое = "<b>" + Содержимое + "</b>";
			КонецЕсли;
			Если Поле.Курсив Тогда
				Содержимое = "<i>" + Содержимое + "</i>";
			КонецЕсли;
			Части.Добавить("<p" + ?(ПустаяСтрока(Поле.Выравнивание), "", " style=""" + Сред(СтильВыравниванияHTML(Поле.Выравнивание), 2) + """")
				+ ">" + ОбернутьРазмеромHTML(Содержимое, Поле.РазмерШрифта) + "</p>");
		КонецЦикла;
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

Функция ПлашкаHTML(Поле)

	Возврат "<span class=""omg-f"" data-key=""" + ТекстHTML(Поле.Ключ) + """>" + ТекстHTML(Поле.Наименование) + "</span>";

КонецФункции

Функция СтильВыравниванияHTML(Выравнивание)

	Значения = Новый Структура("Центр, Право, Ширина", "center", "right", "justify");
	Значение = "";
	Если Не ПустаяСтрока(Выравнивание) И Значения.Свойство(СокрЛП(Выравнивание), Значение) Тогда
		Возврат ";text-align:" + Значение;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ОбернутьРазмеромHTML(Содержимое, Размер)

	Если Размер > 0 Тогда
		Возврат "<span style=""font-size:" + Формат(Размер, "ЧГ=0") + "pt"">" + Содержимое + "</span>";
	КонецЕсли;
	Возврат Содержимое;

КонецФункции

#КонецОбласти

#Область ПодборПараметров

// Соответствие «нормализованное имя» -> параметр; Ложь - имени соответствуют несколько параметров.
Функция ИндексПараметров()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Наименование КАК Наименование,
	|	П.НаименованиеДляВрача КАК НаименованиеДляВрача,
	|	П.Код КАК Код
	|ИЗ
	|	ПланВидовХарактеристик.ПараметрыHTML КАК П
	|ГДЕ
	|	НЕ П.ЭтоГруппа
	|	И НЕ П.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();

	Индекс = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ДобавитьВИндексПараметров(Индекс, КлючИмениПараметра(Выборка.Наименование), Выборка.Ссылка);
		ДобавитьВИндексПараметров(Индекс, КлючИмениПараметра(БезСкобок(Выборка.Наименование)), Выборка.Ссылка);
		ДобавитьВИндексПараметров(Индекс, КлючИмениПараметра(Выборка.НаименованиеДляВрача), Выборка.Ссылка);
		ДобавитьВИндексПараметров(Индекс, "#" + СокрЛП(Выборка.Код), Выборка.Ссылка);
	КонецЦикла;
	Возврат Индекс;

КонецФункции

Процедура ДобавитьВИндексПараметров(Индекс, Ключ, Параметр)

	Если Ключ = "" Или Ключ = "#" Тогда
		Возврат;
	КонецЕсли;
	Имеющийся = Индекс[Ключ];
	Если Имеющийся = Неопределено Тогда
		Индекс.Вставить(Ключ, Параметр);
	ИначеЕсли Имеющийся <> Параметр Тогда
		Индекс.Вставить(Ключ, Ложь);
	КонецЕсли;

КонецПроцедуры

Функция НайтиПараметрВИндексе(Индекс, Знач Имя)

	Имя = СокрЛП(Имя);
	Варианты = Новый Массив;
	Варианты.Добавить(Имя);
	Если СтрНайти(Имя, "/") > 0 Тогда
		Для Каждого Часть Из СтрРазделить(Имя, "/", Ложь) Цикл
			Варианты.Добавить(Часть);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Вариант Из Варианты Цикл
		Код = "#" + СокрЛП(Вариант);
		Ключи = Новый Массив;
		Ключи.Добавить(КлючИмениПараметра(Вариант));
		Ключи.Добавить(КлючИмениПараметра(БезСкобок(Вариант)));
		Ключи.Добавить(Код);
		Для Каждого Ключ Из Ключи Цикл
			Если Ключ = "" Тогда
				Продолжить;
			КонецЕсли;
			Найденный = Индекс[Ключ];
			Если Найденный <> Неопределено И Найденный <> Ложь Тогда
				Возврат Найденный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат ПланыВидовХарактеристик.ПараметрыHTML.ПустаяСсылка();

КонецФункции

// «Гинекологические заболевания» и «ГинекологическиеЗаболевания» дают один ключ.
Функция КлючИмениПараметра(Знач Имя)

	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Имя = СтрЗаменить(НРег(Имя), "ё", "е");
	Для Каждого Символ Из СтрРазделить(" |	|,|.|;|:|!|?|-|–|—|_|/|\|(|)|[|]|«|»|""|'|№", "|", Ложь) Цикл
		Имя = СтрЗаменить(Имя, Символ, "");
	КонецЦикла;
	Имя = СтрЗаменить(Имя, Символы.ПС, "");
	Имя = СтрЗаменить(Имя, Символы.ВК, "");
	Возврат Имя;

КонецФункции

// «Дата взятия на учет (дата)» -> «Дата взятия на учет».
Функция БезСкобок(Знач Имя)

	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Имя, "(");
	Пока Начало > 0 Цикл
		Конец = СтрНайти(Имя, ")", , Начало);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Имя = Лев(Имя, Начало - 1) + Сред(Имя, Конец + 1);
		Начало = СтрНайти(Имя, "(");
	КонецЦикла;
	Возврат СокрЛП(Имя);

КонецФункции

#КонецОбласти

#Область ИмпортИзWord

Функция ПространствоИменW()
	Возврат "http://schemas.openxmlformats.org/wordprocessingml/2006/main";
КонецФункции

Функция ПространствоИменW14()
	Возврат "http://schemas.microsoft.com/office/word/2010/wordml";
КонецФункции

Функция ПрочитатьФайлXML(ИмяФайла)

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	Построитель = Новый ПостроительDOM;
	ДокументDOM = Построитель.Прочитать(Чтение);
	Чтение.Закрыть();
	Возврат ДокументDOM;

КонецФункции

Функция ЭтоЭлемент(Узел, ЛокальноеИмя, Пространство = Неопределено)

	Если Узел.ТипУзла <> ТипУзлаDOM.Элемент Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Пространство = Неопределено Тогда
		Пространство = ПространствоИменW();
	КонецЕсли;
	Возврат Узел.ЛокальноеИмя = ЛокальноеИмя И Узел.URIПространстваИмен = Пространство;

КонецФункции

Функция ДочернийW(Узел, ЛокальноеИмя, Пространство = Неопределено)

	Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл
		Если ЭтоЭлемент(Дочерний, ЛокальноеИмя, Пространство) Тогда
			Возврат Дочерний;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция АтрибутW(Узел, ЛокальноеИмя)

	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	// Атрибуты Word (w:val, w:styleId...) - в пространстве имён w, ищем по локальному имени и URI.
	Пространство = ПространствоИменW();
	Для Каждого Атрибут Из Узел.Атрибуты Цикл
		Если Атрибут.ЛокальноеИмя = ЛокальноеИмя И Атрибут.URIПространстваИмен = Пространство Тогда
			Возврат Атрибут.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Стили заголовков: Соответствие идентификатор стиля -> Истина (раздел) или "Название" (заголовок печати).
Функция СтилиЗаголовков(ИмяФайлаСтилей)

	Результат = Новый Соответствие;
	Файл = Новый Файл(ИмяФайлаСтилей);
	Если Не Файл.Существует() Тогда
		Возврат Результат;
	КонецЕсли;

	ДокументDOM = ПрочитатьФайлXML(ИмяФайлаСтилей);
	Для Каждого Стиль Из ДокументDOM.ЭлементДокумента.ДочерниеУзлы Цикл
		Если Не ЭтоЭлемент(Стиль, "style") Или АтрибутW(Стиль, "type") <> "paragraph" Тогда
			Продолжить;
		КонецЕсли;
		ИмяСтиля = НРег(АтрибутW(ДочернийW(Стиль, "name"), "val"));
		Уровень = Неопределено;
		СвойстваАбзаца = ДочернийW(Стиль, "pPr");
		Если СвойстваАбзаца <> Неопределено Тогда
			УзелУровня = ДочернийW(СвойстваАбзаца, "outlineLvl");
			Если УзелУровня <> Неопределено Тогда
				Уровень = АтрибутW(УзелУровня, "val");
			КонецЕсли;
		КонецЕсли;
		Если ИмяСтиля = "title" Или ИмяСтиля = "название" Или ИмяСтиля = "заголовок документа" Тогда
			Результат.Вставить(АтрибутW(Стиль, "styleId"), "Название");
		ИначеЕсли СтрНачинаетсяС(ИмяСтиля, "heading") Или СтрНачинаетсяС(ИмяСтиля, "заголовок")
			Или Уровень = "0" Или Уровень = "1" Тогда
			Результат.Вставить(АтрибутW(Стиль, "styleId"), Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура РазобратьБлок(Узел, Контекст)

	Если ЭтоЭлемент(Узел, "p") Тогда
		РазобратьАбзац(Узел, Контекст);
	ИначеЕсли ЭтоЭлемент(Узел, "tbl") Тогда
		РазобратьТаблицу(Узел, Контекст);
	ИначеЕсли ЭтоЭлемент(Узел, "sdt") Тогда
		// Элемент управления содержимым уровня блока: это поле целиком.
		ОписаниеМетки = ОписаниеЭлементаУправления(Узел);
		Если ОписаниеМетки.БлочныйКонтейнер Тогда
			// Контейнер без собственного смысла (например, оглавление или группа) - разбираем содержимое.
			Содержимое = ДочернийW(Узел, "sdtContent");
			Если Содержимое <> Неопределено Тогда
				Для Каждого Дочерний Из Содержимое.ДочерниеУзлы Цикл
					РазобратьБлок(Дочерний, Контекст);
				КонецЦикла;
			КонецЕсли;
		Иначе
			ДобавитьПолеИзМетки(Контекст, ОписаниеМетки, ОписаниеМетки.Имя);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура РазобратьАбзац(Абзац, Контекст)

	ЭлементыУправления = Новый Массив;
	Текст = СокрЛП(ТекстУзла(Абзац, ЭлементыУправления));
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	БезМеток = (ЭлементыУправления.Количество() = 0 И СтрНайти(Текст, "{{") = 0);
	Если БезМеток И ЭтоНазваниеДокумента(Абзац, Контекст) Тогда
		// Стиль «Название» - заголовок печатной формы, а не раздел.
		Если ПустаяСтрока(Контекст.Название) Тогда
			Контекст.Название = Текст;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Оформление = ОформлениеАбзаца(Абзац);
	Если БезМеток И ЭтоЗаголовок(Абзац, Контекст) Тогда
		НовыйРаздел(Контекст, Текст);
		Контекст.ТекущийРаздел.РазмерШрифта = Оформление.РазмерШрифта;
		Контекст.ТекущийРаздел.Выравнивание = Оформление.Выравнивание;
		Возврат;
	КонецЕсли;

	ПолейДоАбзаца = Контекст.Поля.Количество();
	РазобратьПоляАбзаца(Контекст, Текст, ЭлементыУправления);
	// Оформление абзаца Word (жирный, курсив, размер, выравнивание) - полям, созданным из него.
	Для Индекс = ПолейДоАбзаца По Контекст.Поля.ВГраница() Цикл
		ЗаполнитьЗначенияСвойств(Контекст.Поля[Индекс], Оформление);
	КонецЦикла;

КонецПроцедуры

Процедура РазобратьПоляАбзаца(Контекст, Текст, ЭлементыУправления)

	Части = РазобратьМетки(Текст, ЭлементыУправления);
	Если Части.Количество() = 1 И Части[0].Метка = Неопределено Тогда
		ТекстБезМеток(Контекст, Текст);
		Возврат;
	КонецЕсли;

	Если ЭтоФраза(Части, Контекст) Тогда
		ДобавитьФразу(Контекст, Части);
		Возврат;
	КонецЕсли;

	Подпись = "";
	ПоследнееПоле = Неопределено;
	Для Каждого Часть Из Части Цикл
		Если Часть.Метка = Неопределено Тогда
			Подпись = Часть.Текст;
			Продолжить;
		КонецЕсли;
		ПоследнееПоле = ДобавитьПолеИзМетки(Контекст, Часть.Метка, ОчиститьПодпись(Подпись));
		Подпись = "";
	КонецЦикла;

	// Короткий текст после последней метки - единица измерения («{{Пульс}} уд/мин»).
	Хвост = СокрЛП(Подпись);
	Если ПоследнееПоле <> Неопределено И Не ПустаяСтрока(Хвост) И СтрДлина(Хвост) <= 20 Тогда
		ПоследнееПоле.ЕдиницаИзмерения = Хвост;
	КонецЕсли;

КонецПроцедуры

// Абзац - фраза с полями внутри, если в нём несколько меток («менархе в {{}} лет, цикл {{}} дн.»)
// или после метки идёт текст длиннее единицы измерения. «Пульс: {{Пульс}} уд/мин» - обычное поле.
// Метка с именем уже существующего поля раздела - тоже фраза (повтор поля, например на казахском).
Функция ЭтоФраза(Части, Контекст)

	Меток = 0;
	ТекстПослеМетки = Ложь;
	Для Каждого Часть Из Части Цикл
		Если Часть.Метка <> Неопределено Тогда
			Меток = Меток + 1;
			Если Не ПустаяСтрока(Часть.Метка.Имя) И ЕстьПолеВРазделе(Контекст, Часть.Метка.Имя) Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли Меток > 0 И СтрДлина(СокрЛП(Часть.Текст)) > 20 Тогда
			ТекстПослеМетки = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Меток > 1 Или ТекстПослеМетки;

КонецФункции

// Фраза: поле «Фраза» с текстом, где метки заменены на {{Имя поля}}, и поля для каждой метки.
// Имя поля - имя из метки, а если его нет - последние слова текста перед меткой.
Процедура ДобавитьФразу(Контекст, Части)

	Тексты = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если Часть.Метка = Неопределено Тогда
			Тексты.Добавить(Часть.Текст);
		КонецЕсли;
	КонецЦикла;
	Фраза = НовоеПоле(Контекст, "", "Фраза");
	Если Части[0].Метка = Неопределено Тогда
		// «Менструальная функция: менархе в» - название фразы до двоеточия.
		Начало = Части[0].Текст;
		ПозицияДвоеточия = СтрНайти(Начало, ":");
		Если ПозицияДвоеточия > 1 И ПозицияДвоеточия <= 60 Тогда
			Начало = Лев(Начало, ПозицияДвоеточия - 1);
		КонецЕсли;
		Фраза.Наименование = Лев(ОчиститьПодпись(Начало), 50);
	КонецЕсли;
	Если ПустаяСтрока(Фраза.Наименование) Тогда
		Фраза.Наименование = Лев(СокрЛП(СтрСоединить(Тексты, " ")), 50);
	КонецЕсли;

	Шаблон = Новый Массив;
	Перед = "";
	Для Каждого Часть Из Части Цикл
		Если Часть.Метка = Неопределено Тогда
			Шаблон.Добавить(Часть.Текст);
			Перед = Часть.Текст;
			Продолжить;
		КонецЕсли;
		Имя = Часть.Метка.Имя;
		Если Не ПустаяСтрока(Имя) И ЕстьПолеВРазделе(Контекст, Имя) Тогда
			// Поле уже есть (например, казахская строка повторяет русскую) - фраза ссылается на него.
			Шаблон.Добавить("{{" + Имя + "}}");
			Перед = "";
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(Имя) Тогда
			Имя = ПоследниеСлова(Перед, 3);
		КонецЕсли;
		Имя = УникальноеИмяВРазделе(Контекст, Имя);
		Метка = Часть.Метка;
		Метка.Имя = Имя;
		ДобавитьПолеИзМетки(Контекст, Метка, Имя);
		Шаблон.Добавить("{{" + Имя + "}}");
		Перед = "";
	КонецЦикла;
	Фраза.ЗначениеПоУмолчанию = СтрСоединить(Шаблон, "");
	Контекст.ПоследнееПояснение = Неопределено;

КонецПроцедуры

Функция ПоследниеСлова(Знач Текст, Количество)

	Текст = ОчиститьПодпись(Текст);
	Для Каждого Символ Из СтрРазделить(",|;|(|)|«|»", "|", Ложь) Цикл
		Текст = СтрЗаменить(Текст, Символ, " ");
	КонецЦикла;
	Слова = СтрРазделить(Текст, " ", Ложь);
	Результат = Новый Массив;
	Для Индекс = Макс(0, Слова.Количество() - Количество) По Слова.ВГраница() Цикл
		Результат.Добавить(Слова[Индекс]);
	КонецЦикла;
	Возврат СокрЛП(СтрСоединить(Результат, " "));

КонецФункции

Функция ЕстьПолеВРазделе(Контекст, Имя)

	Если Контекст.ТекущийРаздел = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Поле Из Контекст.Поля Цикл
		Если Поле.КлючРаздела = Контекст.ТекущийРаздел.Ключ И Поле.Тип <> "Фраза" И Поле.Тип <> "Пояснение"
			И НРег(СокрЛП(Поле.Наименование)) = НРег(СокрЛП(Имя)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Имя поля, не совпадающее с другими полями текущего раздела (фраза ссылается на поля по имени).
Функция УникальноеИмяВРазделе(Контекст, Знач Имя)

	Имя = СокрЛП(СтрЗаменить(СтрЗаменить(Имя, "{", ""), "}", ""));
	Если ПустаяСтрока(Имя) Тогда
		Имя = НСтр("ru = 'Поле'");
	КонецЕсли;
	Имена = Новый Соответствие;
	Если Контекст.ТекущийРаздел <> Неопределено Тогда
		Для Каждого Поле Из Контекст.Поля Цикл
			Если Поле.КлючРаздела = Контекст.ТекущийРаздел.Ключ И Поле.Тип <> "Фраза" И Поле.Тип <> "Пояснение" Тогда
				Имена.Вставить(НРег(СокрЛП(Поле.Наименование)), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат = Имя;
	Номер = 1;
	Пока Имена[НРег(Результат)] <> Неопределено Цикл
		Номер = Номер + 1;
		Результат = Имя + " " + Формат(Номер, "ЧГ=0");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Оформление абзаца Word: выравнивание абзаца и шрифт последнего фрагмента с текстом
// (у строки «Жалобы: {{Жалобы}}» это оформление метки, то есть значения поля).
// Берутся только явно заданные свойства, без стилей документа.
//
// Возвращаемое значение:
//  Структура - Жирный, Курсив, РазмерШрифта, Выравнивание.
//
Функция ОформлениеАбзаца(Абзац)

	Оформление = Новый Структура("Жирный, Курсив, РазмерШрифта, Выравнивание", Ложь, Ложь, 0, "");

	СвойстваАбзаца = ДочернийW(Абзац, "pPr");
	Если СвойстваАбзаца <> Неопределено Тогда
		Выравнивание = НРег(АтрибутW(ДочернийW(СвойстваАбзаца, "jc"), "val"));
		Если Выравнивание = "center" Тогда
			Оформление.Выравнивание = "Центр";
		ИначеЕсли Выравнивание = "right" Или Выравнивание = "end" Тогда
			Оформление.Выравнивание = "Право";
		ИначеЕсли Выравнивание = "both" Или Выравнивание = "distribute" Тогда
			Оформление.Выравнивание = "Ширина";
		КонецЕсли;
	КонецЕсли;

	СвойстваШрифта = Неопределено;
	Для Каждого Узел Из Абзац.ДочерниеУзлы Цикл
		Если ЭтоЭлемент(Узел, "r") И ДочернийW(Узел, "t") <> Неопределено
			И Не ПустаяСтрока(ДочернийW(Узел, "t").ТекстовоеСодержимое) Тогда
			СвойстваШрифта = ДочернийW(Узел, "rPr");
		КонецЕсли;
	КонецЦикла;
	Если СвойстваШрифта = Неопределено Тогда
		Возврат Оформление;
	КонецЕсли;

	Оформление.Жирный = ВключенПризнакW(ДочернийW(СвойстваШрифта, "b"));
	Оформление.Курсив = ВключенПризнакW(ДочернийW(СвойстваШрифта, "i"));
	РазмерВПолупунктах = АтрибутW(ДочернийW(СвойстваШрифта, "sz"), "val");
	Если Не ПустаяСтрока(РазмерВПолупунктах) Тогда
		Попытка
			Оформление.РазмерШрифта = Мин(Окр(Число(РазмерВПолупунктах) / 2), 72);
		Исключение
			Оформление.РазмерШрифта = 0;
		КонецПопытки;
	КонецЕсли;

	Возврат Оформление;

КонецФункции

// Признак Word вида <w:b/>, <w:b w:val="0"/>: включён, если элемент есть и val не "0"/"false".
Функция ВключенПризнакW(Узел)

	Если Узел = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Значение = НРег(АтрибутW(Узел, "val"));
	Возврат Значение <> "0" И Значение <> "false" И Значение <> "off";

КонецФункции

Процедура ТекстБезМеток(Контекст, Текст)

	ПозицияДвоеточия = СтрНайти(Текст, ":");
	Если Контекст.РаспознаватьБезМеток И ПозицияДвоеточия > 1 И ПозицияДвоеточия <= 60
		И СтрНайти(Лев(Текст, ПозицияДвоеточия), ".") = 0 Тогда

		Метка = НоваяМетка();
		Метка.Имя = СокрЛП(Лев(Текст, ПозицияДвоеточия - 1));
		Метка.ПоУмолчанию = СокрЛП(Сред(Текст, ПозицияДвоеточия + 1));
		Поле = ДобавитьПолеИзМетки(Контекст, Метка, Метка.Имя);
		Если ПустаяСтрока(Метка.ПоУмолчанию) Тогда
			// «Название:» без значения - может оказаться названием следующей таблицы.
			Контекст.ПоследнееПояснение = Поле;
		КонецЕсли;
		Возврат;

	КонецЕсли;

	Поле = НовоеПоле(Контекст, Лев(Текст, 50), "Пояснение");
	Поле.ЗначениеПоУмолчанию = Текст;
	Контекст.ПоследнееПояснение = Поле;

КонецПроцедуры

Процедура РазобратьТаблицу(Таблица, Контекст)

	Строки = Новый Массив;
	КоличествоКолонок = 0;
	Для Каждого УзелСтроки Из Таблица.ДочерниеУзлы Цикл
		Если Не ЭтоЭлемент(УзелСтроки, "tr") Тогда
			Продолжить;
		КонецЕсли;
		Ячейки = Новый Массив;
		Для Каждого УзелЯчейки Из УзелСтроки.ДочерниеУзлы Цикл
			Если ЭтоЭлемент(УзелЯчейки, "tc") Тогда
				ЭлементыУправления = Новый Массив;
				Текст = СокрЛП(ТекстЯчейки(УзелЯчейки, ЭлементыУправления));
				Ячейки.Добавить(Новый Структура("Текст, Части", Текст, РазобратьМетки(Текст, ЭлементыУправления)));
			КонецЕсли;
		КонецЦикла;
		КоличествоКолонок = Макс(КоличествоКолонок, Ячейки.Количество());
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если КоличествоКолонок = 2 И ЭтоТаблицаНазваниеЗначение(Строки) Тогда
		Для Каждого Ячейки Из Строки Цикл
			Если Ячейки.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			Подпись = ОчиститьПодпись(Ячейки[0].Текст);
			Метка = ПерваяМетка(Ячейки[1].Части);
			Если Метка = Неопределено Тогда
				Если ПустаяСтрока(Подпись) Тогда
					Продолжить;
				КонецЕсли;
				Метка = НоваяМетка();
				Метка.ПоУмолчанию = Ячейки[1].Текст;
				ДобавитьПолеИзМетки(Контекст, Метка, Подпись);
				Продолжить;
			КонецЕсли;
			Поле = ДобавитьПолеИзМетки(Контекст, Метка, Подпись);
			// Короткий текст после метки в ячейке - единица измерения («{{ЧСС}} уд/мин»).
			ПоследняяЧасть = Ячейки[1].Части[Ячейки[1].Части.ВГраница()];
			Хвост = ?(ПоследняяЧасть.Метка = Неопределено, СокрЛП(ПоследняяЧасть.Текст), "");
			Если Поле <> Неопределено И Не ПустаяСтрока(Хвост) И СтрДлина(Хвост) <= 20 Тогда
				Поле.ЕдиницаИзмерения = Хвост;
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	// Таблица данных: первая строка - колонки.
	Контекст.СчетчикТаблиц = Контекст.СчетчикТаблиц + 1;
	Имя = СтрШаблон(НСтр("ru = 'Таблица %1'"), Контекст.СчетчикТаблиц);
	// Абзац «Название:» прямо перед таблицей - название поля-таблицы.
	Пояснение = Контекст.ПоследнееПояснение;
	Если Пояснение <> Неопределено И Контекст.Поля.Количество() > 0
		И Контекст.Поля[Контекст.Поля.ВГраница()] = Пояснение Тогда
		Если Пояснение.Тип = "Пояснение" И СтрЗаканчиваетсяНа(Пояснение.ЗначениеПоУмолчанию, ":") Тогда
			Имя = ОчиститьПодпись(Пояснение.ЗначениеПоУмолчанию);
			Контекст.Поля.Удалить(Контекст.Поля.ВГраница());
		ИначеЕсли Пояснение.Тип = "Текст" И ПустаяСтрока(Пояснение.ЗначениеПоУмолчанию) Тогда
			Имя = Пояснение.Наименование;
			Контекст.Поля.Удалить(Контекст.Поля.ВГраница());
		КонецЕсли;
	КонецЕсли;

	Поле = НовоеПоле(Контекст, Имя, "Таблица");

	Колонки = Новый Массив;
	Для Каждого Ячейка Из Строки[0] Цикл
		Колонки.Добавить(СтрЗаменить(ТекстВнеМеток(Ячейка.Части), ";", ","));
	КонецЦикла;
	Поле.КолонкиТаблицы = СтрСоединить(Колонки, "; ");

	СтрокиПоУмолчанию = Новый Массив;
	Для Индекс = 1 По Строки.ВГраница() Цикл
		Значения = Новый Массив;
		ЕстьЗначения = Ложь;
		Для Каждого Ячейка Из Строки[Индекс] Цикл
			Метка = ПерваяМетка(Ячейка.Части);
			Значение = ?(Метка = Неопределено, ТекстВнеМеток(Ячейка.Части), Метка.ПоУмолчанию);
			Значение = СтрЗаменить(СтрЗаменить(Значение, ";", ","), Символы.ПС, " ");
			ЕстьЗначения = ЕстьЗначения Или Не ПустаяСтрока(Значение);
			Значения.Добавить(Значение);
		КонецЦикла;
		Если ЕстьЗначения Тогда
			СтрокиПоУмолчанию.Добавить(СтрСоединить(Значения, "; "));
		КонецЕсли;
	КонецЦикла;
	Поле.ЗначениеПоУмолчанию = СтрСоединить(СтрокиПоУмолчанию, Символы.ПС);

КонецПроцедуры

// Таблица «название - значение»: во второй колонке есть метки или первая строка не похожа на шапку.
Функция ЭтоТаблицаНазваниеЗначение(Строки)

	СтрокСМетками = 0;
	Для Каждого Ячейки Из Строки Цикл
		Если Ячейки.Количество() = 2 И ПерваяМетка(Ячейки[1].Части) <> Неопределено Тогда
			СтрокСМетками = СтрокСМетками + 1;
		КонецЕсли;
	КонецЦикла;
	Если СтрокСМетками > 0 Тогда
		Возврат СтрокСМетками * 2 >= Строки.Количество();
	КонецЕсли;

	// Без меток: если первая колонка заканчивается двоеточием - это подписи.
	СтрокСПодписью = 0;
	Для Каждого Ячейки Из Строки Цикл
		Если Ячейки.Количество() = 2 И СтрЗаканчиваетсяНа(Ячейки[0].Текст, ":") Тогда
			СтрокСПодписью = СтрокСПодписью + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокСПодписью * 2 >= Строки.Количество();

КонецФункции

Функция ЭтоНазваниеДокумента(Абзац, Контекст)

	СвойстваАбзаца = ДочернийW(Абзац, "pPr");
	Если СвойстваАбзаца = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИдентификаторСтиля = АтрибутW(ДочернийW(СвойстваАбзаца, "pStyle"), "val");
	Возврат Контекст.Заголовки.Получить(ИдентификаторСтиля) = "Название";

КонецФункции

Функция ЭтоЗаголовок(Абзац, Контекст)

	СвойстваАбзаца = ДочернийW(Абзац, "pPr");
	Если СвойстваАбзаца = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	УзелУровня = ДочернийW(СвойстваАбзаца, "outlineLvl");
	Если УзелУровня <> Неопределено И (АтрибутW(УзелУровня, "val") = "0" Или АтрибутW(УзелУровня, "val") = "1") Тогда
		Возврат Истина;
	КонецЕсли;
	ИдентификаторСтиля = АтрибутW(ДочернийW(СвойстваАбзаца, "pStyle"), "val");
	Возврат Контекст.Заголовки.Получить(ИдентификаторСтиля) = Истина;

КонецФункции

// Текст узла; элементы управления содержимым заменяются на {{#N}}, их описания - в ЭлементыУправления.
Функция ТекстУзла(Узел, ЭлементыУправления)

	Если Узел.ТипУзла <> ТипУзлаDOM.Элемент Тогда
		Возврат "";
	КонецЕсли;

	Если Узел.URIПространстваИмен = ПространствоИменW() Тогда
		Имя = Узел.ЛокальноеИмя;
		Если Имя = "t" Тогда
			Возврат Узел.ТекстовоеСодержимое;
		ИначеЕсли Имя = "tab" Тогда
			Возврат " ";
		ИначеЕсли Имя = "br" Или Имя = "cr" Тогда
			Возврат Символы.ПС;
		ИначеЕсли Имя = "pPr" Или Имя = "rPr" Или Имя = "delText" Или Имя = "instrText" Или Имя = "del" Тогда
			Возврат "";
		ИначеЕсли Имя = "sdt" Тогда
			ЭлементыУправления.Добавить(ОписаниеЭлементаУправления(Узел));
			Возврат "{{#" + Формат(ЭлементыУправления.ВГраница(), "ЧН=0; ЧГ=") + "}}";
		КонецЕсли;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл
		Части.Добавить(ТекстУзла(Дочерний, ЭлементыУправления));
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

Функция ТекстЯчейки(Ячейка, ЭлементыУправления)

	Абзацы = Новый Массив;
	Для Каждого Дочерний Из Ячейка.ДочерниеУзлы Цикл
		Если ЭтоЭлемент(Дочерний, "tcPr") Тогда
			Продолжить;
		КонецЕсли;
		Абзацы.Добавить(ТекстУзла(Дочерний, ЭлементыУправления));
	КонецЦикла;
	Возврат СтрСоединить(Абзацы, Символы.ПС);

КонецФункции

Функция НоваяМетка()
	Возврат Новый Структура("Имя, ПоУмолчанию, Тип, Варианты, БлочныйКонтейнер, ИмяПараметра", "", "", "", Новый Массив, Ложь, "");
КонецФункции

Функция ОписаниеЭлементаУправления(Узел)

	Метка = НоваяМетка();
	Свойства = ДочернийW(Узел, "sdtPr");
	Если Свойства <> Неопределено Тогда
		Метка.Имя = АтрибутW(ДочернийW(Свойства, "alias"), "val");
		Если ПустаяСтрока(Метка.Имя) Тогда
			Метка.Имя = АтрибутW(ДочернийW(Свойства, "tag"), "val");
		КонецЕсли;
		Список = ДочернийW(Свойства, "dropDownList");
		Если Список = Неопределено Тогда
			Список = ДочернийW(Свойства, "comboBox");
		КонецЕсли;
		Если Список <> Неопределено Тогда
			Метка.Тип = "Выбор";
			Для Каждого Вариант Из Список.ДочерниеУзлы Цикл
				Если ЭтоЭлемент(Вариант, "listItem") Тогда
					Текст = АтрибутW(Вариант, "displayText");
					Если ПустаяСтрока(Текст) Тогда
						Текст = АтрибутW(Вариант, "value");
					КонецЕсли;
					Если Не ПустаяСтрока(Текст) И СтрНайти(Текст, "Выберите элемент") = 0 Тогда
						Метка.Варианты.Добавить(СокрЛП(Текст));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ДочернийW(Свойства, "date") <> Неопределено Тогда
			Метка.Тип = "Дата";
		ИначеЕсли ДочернийW(Свойства, "checkbox", ПространствоИменW14()) <> Неопределено Тогда
			Метка.Тип = "Флажок";
		ИначеЕсли ДочернийW(Свойства, "docPartObj") <> Неопределено Или ДочернийW(Свойства, "group") <> Неопределено Тогда
			Метка.БлочныйКонтейнер = Истина;
		КонецЕсли;
		ЗаполнительПоказан = ДочернийW(Свойства, "showingPlcHdr") <> Неопределено;
	Иначе
		ЗаполнительПоказан = Ложь;
	КонецЕсли;

	Если Не ЗаполнительПоказан И Метка.Тип <> "Флажок" Тогда
		Содержимое = ДочернийW(Узел, "sdtContent");
		Если Содержимое <> Неопределено Тогда
			Метка.ПоУмолчанию = СокрЛП(ТекстУзла(Содержимое, Новый Массив));
		КонецЕсли;
	КонецЕсли;

	Если Метка.Тип = "" Тогда
		Метка.Тип = "Текст";
	КонецЕсли;

	Возврат Метка;

КонецФункции

// Делит текст на части: Структура(Текст, Метка), где Метка - Неопределено для обычного текста.
Функция РазобратьМетки(Текст, ЭлементыУправления)

	Части = Новый Массив;
	Остаток = Текст;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "{{");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Остаток, "}}", , Начало);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Перед = Лев(Остаток, Начало - 1);
		Если Не ПустаяСтрока(Перед) Тогда
			Части.Добавить(Новый Структура("Текст, Метка", Перед, Неопределено));
		КонецЕсли;
		ТекстМетки = Сред(Остаток, Начало + 2, Конец - Начало - 2);
		Части.Добавить(Новый Структура("Текст, Метка", "", ОписаниеМетки(ТекстМетки, ЭлементыУправления)));
		Остаток = Сред(Остаток, Конец + 2);
	КонецЦикла;
	Если Не ПустаяСтрока(Остаток) Или Части.Количество() = 0 Тогда
		Части.Добавить(Новый Структура("Текст, Метка", Остаток, Неопределено));
	КонецЕсли;
	Возврат Части;

КонецФункции

// {{Название | по умолчанию | тип}} или {{#N}} - ссылка на элемент управления содержимым.
Функция ОписаниеМетки(ТекстМетки, ЭлементыУправления)

	Если СтрНачинаетсяС(ТекстМетки, "#") Тогда
		Попытка
			Возврат ЭлементыУправления[Число(Сред(ТекстМетки, 2))];
		Исключение
			// Не наш маркер - разбираем как обычную метку.
		КонецПопытки;
	КонецЕсли;

	Метка = НоваяМетка();
	Части = СтрРазделить(ТекстМетки, "|", Истина);
	Метка.Имя = СокрЛП(Части[0]);
	Если Части.Количество() > 1 Тогда
		Метка.ПоУмолчанию = СокрЛП(Части[1]);
	КонецЕсли;
	Метка.Тип = "Текст";
	Если Части.Количество() > 2 Тогда
		Метка.Тип = ТипПоляПоСлову(Части[2]);
	КонецЕсли;
	Если Части.Количество() > 3 Тогда
		Метка.ИмяПараметра = СокрЛП(Части[3]);
	КонецЕсли;

	Если Метка.Тип = "Выбор" Или Метка.Тип = "ВыборНесколько" Тогда
		Для Каждого Вариант Из СтрРазделить(Метка.ПоУмолчанию, ";", Ложь) Цикл
			Если Не ПустаяСтрока(Вариант) Тогда
				Метка.Варианты.Добавить(СокрЛП(Вариант));
			КонецЕсли;
		КонецЦикла;
		Метка.ПоУмолчанию = ?(Метка.Тип = "Выбор" И Метка.Варианты.Количество() > 0, Метка.Варианты[0], "");
	КонецЕсли;

	Возврат Метка;

КонецФункции

Функция ТипПоляПоСлову(Слово)

	Слово = НРег(СокрЛП(Слово));
	Если Слово = "строка" Тогда
		Возврат "Строка";
	ИначеЕсли Слово = "число" Тогда
		Возврат "Число";
	ИначеЕсли Слово = "дата" Тогда
		Возврат "Дата";
	ИначеЕсли Слово = "флажок" Или Слово = "да/нет" Или Слово = "данет" Или Слово = "да-нет" Тогда
		Возврат "Флажок";
	ИначеЕсли Слово = "список" Или Слово = "выбор" Тогда
		Возврат "Выбор";
	ИначеЕсли Слово = "несколько" Или Слово = "множественный" Или Слово = "мультивыбор" Тогда
		Возврат "ВыборНесколько";
	КонецЕсли;
	Возврат "Текст";

КонецФункции

Функция ПерваяМетка(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Метка <> Неопределено Тогда
			Возврат Часть.Метка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ТекстВнеМеток(Части)

	Тексты = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если Часть.Метка = Неопределено Тогда
			Тексты.Добавить(Часть.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(СтрСоединить(Тексты, " "));

КонецФункции

Функция ОчиститьПодпись(Знач Подпись)

	Подпись = СокрЛП(СтрЗаменить(Подпись, Символы.ПС, " "));
	Пока СтрЗаканчиваетсяНа(Подпись, ":") Или СтрЗаканчиваетсяНа(Подпись, "-") Или СтрЗаканчиваетсяНа(Подпись, "—")
		Или СтрЗаканчиваетсяНа(Подпись, "_") Цикл
		Подпись = СокрЛП(Лев(Подпись, СтрДлина(Подпись) - 1));
	КонецЦикла;
	Возврат Подпись;

КонецФункции

Процедура НовыйРаздел(Контекст, Наименование)

	Раздел = Новый Структура("Ключ, Наименование", Строка(Новый УникальныйИдентификатор), ОчиститьПодпись(Наименование));
	Раздел.Вставить("РазмерШрифта", 0);
	Раздел.Вставить("Выравнивание", "");
	Раздел.Вставить("БезЗаголовка", Ложь);
	Контекст.Разделы.Добавить(Раздел);
	Контекст.ТекущийРаздел = Раздел;
	Контекст.ПоследнееПояснение = Неопределено;

КонецПроцедуры

Функция НовоеПоле(Контекст, Наименование, Тип)

	Если Контекст.ТекущийРаздел = Неопределено Тогда
		// Текст до первого заголовка (подзаголовок, данные пациента) - раздел без печатного заголовка.
		НовыйРаздел(Контекст, НСтр("ru = 'Протокол'"));
		Контекст.ТекущийРаздел.БезЗаголовка = Истина;
	КонецЕсли;

	Поле = Новый Структура;
	Поле.Вставить("КлючРаздела", Контекст.ТекущийРаздел.Ключ);
	Поле.Вставить("Ключ", Строка(Новый УникальныйИдентификатор));
	Поле.Вставить("Наименование", Наименование);
	Поле.Вставить("Тип", Тип);
	Поле.Вставить("ЗначениеПоУмолчанию", "");
	Поле.Вставить("ВариантыВыбора", "");
	Поле.Вставить("КолонкиТаблицы", "");
	Поле.Вставить("ЕдиницаИзмерения", "");
	Поле.Вставить("Жирный", Ложь);
	Поле.Вставить("Курсив", Ложь);
	Поле.Вставить("РазмерШрифта", 0);
	Поле.Вставить("Выравнивание", "");
	Поле.Вставить("ИмяПараметра", "");
	Контекст.Поля.Добавить(Поле);
	Контекст.ПоследнееПояснение = Неопределено;
	Возврат Поле;

КонецФункции

Функция ДобавитьПолеИзМетки(Контекст, Метка, Подпись)

	Имя = ?(ПустаяСтрока(Метка.Имя), Подпись, Метка.Имя);
	Если ПустаяСтрока(Имя) Тогда
		Имя = СтрШаблон(НСтр("ru = 'Поле %1'"), Контекст.Поля.Количество() + 1);
		Контекст.Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'У поля без подписи задано имя «%1», проверьте его.'"), Имя));
	КонецЕсли;

	Поле = НовоеПоле(Контекст, Имя, Метка.Тип);
	Поле.ЗначениеПоУмолчанию = Метка.ПоУмолчанию;
	Поле.ВариантыВыбора = СтрСоединить(Метка.Варианты, "; ");
	Поле.ИмяПараметра = Метка.ИмяПараметра;
	Возврат Поле;

КонецФункции

// Первая картинка из верхних колонтитулов (обычно логотип клиники).
Функция ЛоготипИзКолонтитулов(КаталогРаспаковки)

	Для Каждого ФайлСвязей Из НайтиФайлы(КаталогРаспаковки + "/word/_rels", "header*.xml.rels") Цикл
		ДокументDOM = ПрочитатьФайлXML(ФайлСвязей.ПолноеИмя);
		Для Каждого Связь Из ДокументDOM.ЭлементДокумента.ДочерниеУзлы Цикл
			Если Связь.ТипУзла <> ТипУзлаDOM.Элемент Тогда
				Продолжить;
			КонецЕсли;
			Цель = Связь.ПолучитьАтрибут("Target");
			Если Цель = Неопределено Или СтрНайти(Цель, "media/") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Расширение = НРег(Прав(Цель, 4));
			Если Расширение <> ".png" И Расширение <> ".jpg" И Расширение <> "jpeg" И Расширение <> ".gif" И Расширение <> ".bmp" Тогда
				Продолжить;
			КонецЕсли;
			ИмяКартинки = КаталогРаспаковки + "/word/" + СтрЗаменить(Цель, "../", "");
			ФайлКартинки = Новый Файл(ИмяКартинки);
			Если ФайлКартинки.Существует() Тогда
				Возврат Новый ДвоичныеДанные(ИмяКартинки);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ИмпортВерсткиИзWord

// Загрузка документа Word в шаблон со свободной вёрсткой: абзацы с оформлением (шрифт, размер, цвет, выделение,
// выравнивание, отступы, рамки), таблицы с объединёнными ячейками и картинки переносятся в HTML шаблона.
// Метки {{Название | по умолчанию | тип | параметр}} и элементы управления содержимым Word становятся полями;
// метки с одинаковым названием - одно поле (повтор значения, например в строке на казахском).
//
// Параметры:
//  ШаблонОбъект        - СправочникОбъект.омг_ШаблоныПротоколов
//  ДвоичныеДанныеФайла - ДвоичныеДанные - файл .docx
//  ИмяФайла            - Строка
//
// Возвращаемое значение:
//  Массив из Строка - предупреждения.
//
Функция ЗаполнитьВерсткуИзWord(ШаблонОбъект, ДвоичныеДанныеФайла, ИмяФайла = "") Экспорт

	ИмяАрхива = ПолучитьИмяВременногоФайла("docx");
	КаталогРаспаковки = ПолучитьИмяВременногоФайла("");
	ДвоичныеДанныеФайла.Записать(ИмяАрхива);

	Попытка
		Архив = Новый ЧтениеZipФайла(ИмяАрхива);
		Архив.ИзвлечьВсе(КаталогРаспаковки, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		Архив.Закрыть();
	Исключение
		УдалитьФайлы(ИмяАрхива);
		ВызватьИсключение НСтр("ru = 'Файл не похож на документ Word (.docx). Документы .doc нужно сначала сохранить в формате .docx.'");
	КонецПопытки;

	Попытка

		Контекст = НовыйКонтекстВерстки(КаталогРаспаковки);
		ДокументDOM = ПрочитатьФайлXML(КаталогРаспаковки + "/word/document.xml");
		Тело = ДочернийW(ДокументDOM.ЭлементДокумента, "body");
		Если Тело = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В документе не найдено содержимое (word/document.xml).'");
		КонецЕсли;
		Контекст.ШиринаТекста = ШиринаТекстаРазделаW(ДочернийW(Тело, "sectPr"));

		Части = Новый Массив;
		Для Каждого Узел Из Тело.ДочерниеУзлы Цикл
			Части.Добавить(БлокВерстки(Узел, Контекст));
		КонецЦикла;

		Логотип = Неопределено;
		Если Не Контекст.ЕстьКартинки Тогда
			Логотип = ЛоготипИзКолонтитулов(КаталогРаспаковки);
		КонецЕсли;

	Исключение
		УдалитьФайлы(ИмяАрхива);
		УдалитьФайлы(КаталогРаспаковки);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ИмяАрхива);
	УдалитьФайлы(КаталогРаспаковки);

	Предупреждения = Контекст.Предупреждения;
	Если Контекст.Поля.Количество() = 0 Тогда
		Предупреждения.Добавить(НСтр("ru = 'В документе не найдено ни одного поля. Отметьте поля метками {{Название}} или вставьте их в редакторе кнопкой «+ Поле».'"));
	КонецЕсли;

	// В свободной вёрстке один служебный раздел: порядок полей задаёт сам текст.
	ШаблонОбъект.Разделы.Очистить();
	Раздел = ШаблонОбъект.Разделы.Добавить();
	Раздел.Ключ = "html";
	Раздел.Наименование = НСтр("ru = 'Поля'");
	Раздел.ПечататьЗаголовок = Ложь;

	ШаблонОбъект.Поля.Очистить();
	Для Каждого Поле Из Контекст.Поля Цикл
		СтрокаПоля = ШаблонОбъект.Поля.Добавить();
		СтрокаПоля.КлючРаздела = Раздел.Ключ;
		СтрокаПоля.Ключ = Поле.Ключ;
		СтрокаПоля.Наименование = Лев(Поле.Наименование, 250);
		СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола[Поле.Тип];
		СтрокаПоля.ЗначениеПоУмолчанию = Поле.ЗначениеПоУмолчанию;
		СтрокаПоля.ВариантыВыбора = Поле.ВариантыВыбора;
		// В свободной вёрстке пустое поле печатается пустым местом, строка не скрывается.
		СтрокаПоля.СкрыватьЕслиПусто = Ложь;
	КонецЦикла;

	// Параметры старого механизма: явно указанные в метке или найденные по названию поля.
	Найденные = ПодобратьПараметрыПолей(Контекст.Поля);
	Для Индекс = 0 По Найденные.ВГраница() Цикл
		ШаблонОбъект.Поля[Индекс].Параметр = Найденные[Индекс];
		ИмяПараметра = Контекст.Поля[Индекс].ИмяПараметра;
		Если ЗначениеЗаполнено(ИмяПараметра) И Не ЗначениеЗаполнено(Найденные[Индекс]) Тогда
			Предупреждения.Добавить(СтрШаблон(
				НСтр("ru = 'Поле «%1»: параметр «%2» не найден или неоднозначен, выберите его вручную.'"),
				Контекст.Поля[Индекс].Наименование, ИмяПараметра));
		КонецЕсли;
	КонецЦикла;

	ШаблонОбъект.ТекстHTML = СтрСоединить(Части, Символы.ПС);
	ШаблонОбъект.Шрифт = Лев(Контекст.Шрифт, 50);
	ШаблонОбъект.РазмерШрифта = Контекст.Размер;
	Если Контекст.ЕстьКартинки Тогда
		// Шапка с логотипом свёрстана в самом документе - общая шапка клиники не нужна.
		ШаблонОбъект.НеИспользоватьШапку = Истина;
	ИначеЕсли Логотип <> Неопределено Тогда
		ШаблонОбъект.Логотип = Новый ХранилищеЗначения(Логотип, Новый СжатиеДанных(9));
	КонецЕсли;
	ШаблонОбъект.ИсходныйФайл = Новый ХранилищеЗначения(ДвоичныеДанныеФайла, Новый СжатиеДанных(9));
	ШаблонОбъект.ИмяИсходногоФайла = ИмяФайла;
	Если ПустаяСтрока(ШаблонОбъект.Наименование) Тогда
		ШаблонОбъект.Наименование = СтрЗаменить(ИмяФайла, ".docx", "");
	КонецЕсли;

	Возврат Предупреждения;

КонецФункции

#КонецОбласти

#Область ИмпортВерсткиИзWordСлужебные

Функция ПространствоИменDrawingML()
	Возврат "http://schemas.openxmlformats.org/drawingml/2006/main";
КонецФункции

Функция ПространствоИменWordprocessingDrawing()
	Возврат "http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing";
КонецФункции

Функция ПространствоИменСвязей()
	Возврат "http://schemas.openxmlformats.org/officeDocument/2006/relationships";
КонецФункции

Функция ПространствоИменVML()
	Возврат "urn:schemas-microsoft-com:vml";
КонецФункции

Функция НовыйКонтекстВерстки(КаталогРаспаковки)

	Контекст = Новый Структура;
	Контекст.Вставить("Каталог", КаталогРаспаковки);
	// Узлы стилей хранятся в контексте; их документ DOM должен жить столько же, иначе обращение к узлу роняет сервер.
	Контекст.Вставить("ДокументыDOM", Новый Массив);
	Контекст.Вставить("Стили", Новый Соответствие);
	Контекст.Вставить("СтильАбзацаПоУмолчанию", "");
	Контекст.Вставить("ТекстПоУмолчанию", НовыеСвойстваТекстаW());
	Контекст.Вставить("АбзацПоУмолчанию", НовыеСвойстваАбзацаW());
	Контекст.Вставить("Связи", Новый Соответствие);
	Контекст.Вставить("Поля", Новый Массив);
	Контекст.Вставить("ПоляПоИмени", Новый Соответствие);
	Контекст.Вставить("Предупреждения", Новый Массив);
	Контекст.Вставить("ЕстьКартинки", Ложь);
	Контекст.Вставить("ШиринаТекста", 9638);
	Контекст.Вставить("Шрифт", "Times New Roman");
	Контекст.Вставить("Размер", 10);

	ПрочитатьСтилиВерстки(Контекст, КаталогРаспаковки + "/word/styles.xml");
	ПрочитатьСвязиВерстки(Контекст, КаталогРаспаковки + "/word/_rels/document.xml.rels");

	// Основной шрифт документа - стиль обычного абзаца; в тексте указываются только отличия от него.
	Основа = ОсноваАбзацаВерстки(Неопределено, Контекст);
	Если Не ПустаяСтрока(Основа.Текст.Шрифт) Тогда
		Контекст.Шрифт = Основа.Текст.Шрифт;
	КонецЕсли;
	Если Основа.Текст.Размер > 0 Тогда
		Контекст.Размер = Основа.Текст.Размер;
	КонецЕсли;

	Возврат Контекст;

КонецФункции

// Дочерний элемент w: с проверкой, что сам узел есть.
Функция ВложенныйW(Узел, ЛокальноеИмя)

	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДочернийW(Узел, ЛокальноеИмя);

КонецФункции

Функция ЧислоW(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Признак оформления (w:b, w:i...): Истина/Ложь, Неопределено - если не задан.
Функция ПризнакW(Узел)

	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ВключенПризнакW(Узел) И НРег(АтрибутW(Узел, "val")) <> "none";

КонецФункции

Функция ЧислоCSS(Знач Значение)

	Возврат Формат(Окр(Значение, 2), "ЧРД=.; ЧГ=0; ЧН=0");

КонецФункции

Функция НовыеСвойстваТекстаW(Основа = Неопределено)

	Свойства = Новый Структура("Жирный, Курсив, Подчеркнутый, Зачеркнутый, Размер, Цвет, Фон, Шрифт, Положение",
		Ложь, Ложь, Ложь, Ложь, 0, "", "", "", "");
	Если Основа <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Свойства, Основа);
	КонецЕсли;
	Возврат Свойства;

КонецФункции

Функция НовыеСвойстваАбзацаW(Основа = Неопределено)

	Свойства = Новый Структура("Выравнивание, Перед, После, Слева, ПерваяСтрока, Фон, Список,
		|ГраницаСверху, ГраницаСнизу, ГраницаСлева, ГраницаСправа",
		"", 0, 0, 0, 0, "", Ложь, "", "", "", "");
	Если Основа <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Свойства, Основа);
	КонецЕсли;
	Возврат Свойства;

КонецФункции

// Свойства текста (w:rPr) поверх основы (стиля).
Функция СвойстваТекстаW(Узел, Основа)

	Свойства = НовыеСвойстваТекстаW(Основа);
	Если Узел = Неопределено Тогда
		Возврат Свойства;
	КонецЕсли;

	Признак = ПризнакW(ДочернийW(Узел, "b"));
	Если Признак <> Неопределено Тогда
		Свойства.Жирный = Признак;
	КонецЕсли;
	Признак = ПризнакW(ДочернийW(Узел, "i"));
	Если Признак <> Неопределено Тогда
		Свойства.Курсив = Признак;
	КонецЕсли;
	Признак = ПризнакW(ДочернийW(Узел, "strike"));
	Если Признак <> Неопределено Тогда
		Свойства.Зачеркнутый = Признак;
	КонецЕсли;
	Подчеркивание = ДочернийW(Узел, "u");
	Если Подчеркивание <> Неопределено Тогда
		Свойства.Подчеркнутый = (НРег(АтрибутW(Подчеркивание, "val")) <> "none");
	КонецЕсли;

	Размер = ЧислоW(АтрибутW(ДочернийW(Узел, "sz"), "val"));
	Если Размер > 0 Тогда
		Свойства.Размер = Размер / 2;
	КонецЕсли;
	Цвет = АтрибутW(ДочернийW(Узел, "color"), "val");
	Если Не ПустаяСтрока(Цвет) И НРег(Цвет) <> "auto" Тогда
		Свойства.Цвет = "#" + Цвет;
	КонецЕсли;
	Выделение = ДочернийW(Узел, "highlight");
	Если Выделение <> Неопределено Тогда
		Свойства.Фон = ЦветВыделенияW(АтрибутW(Выделение, "val"));
	КонецЕсли;
	Заливка = АтрибутW(ДочернийW(Узел, "shd"), "fill");
	Если Не ПустаяСтрока(Заливка) И НРег(Заливка) <> "auto" Тогда
		Свойства.Фон = "#" + Заливка;
	КонецЕсли;
	Шрифт = АтрибутW(ДочернийW(Узел, "rFonts"), "ascii");
	Если Не ПустаяСтрока(Шрифт) Тогда
		Свойства.Шрифт = Шрифт;
	КонецЕсли;
	Положение = ДочернийW(Узел, "vertAlign");
	Если Положение <> Неопределено Тогда
		Свойства.Положение = АтрибутW(Положение, "val");
	КонецЕсли;

	Возврат Свойства;

КонецФункции

// Свойства абзаца (w:pPr) поверх основы (стиля).
Функция СвойстваАбзацаW(Узел, Основа)

	Свойства = НовыеСвойстваАбзацаW(Основа);
	Если Узел = Неопределено Тогда
		Возврат Свойства;
	КонецЕсли;

	Выравнивание = ДочернийW(Узел, "jc");
	Если Выравнивание <> Неопределено Тогда
		Свойства.Выравнивание = АтрибутW(Выравнивание, "val");
	КонецЕсли;
	Интервал = ДочернийW(Узел, "spacing");
	Если Интервал <> Неопределено Тогда
		Если Не ПустаяСтрока(АтрибутW(Интервал, "before")) Тогда
			Свойства.Перед = ЧислоW(АтрибутW(Интервал, "before")) / 20;
		КонецЕсли;
		Если Не ПустаяСтрока(АтрибутW(Интервал, "after")) Тогда
			Свойства.После = ЧислоW(АтрибутW(Интервал, "after")) / 20;
		КонецЕсли;
	КонецЕсли;
	Отступ = ДочернийW(Узел, "ind");
	Если Отступ <> Неопределено Тогда
		Слева = АтрибутW(Отступ, "left");
		Если ПустаяСтрока(Слева) Тогда
			Слева = АтрибутW(Отступ, "start");
		КонецЕсли;
		Если Не ПустаяСтрока(Слева) Тогда
			Свойства.Слева = ЧислоW(Слева) / 20;
		КонецЕсли;
		Если Не ПустаяСтрока(АтрибутW(Отступ, "firstLine")) Тогда
			Свойства.ПерваяСтрока = ЧислоW(АтрибутW(Отступ, "firstLine")) / 20;
		КонецЕсли;
		Если Не ПустаяСтрока(АтрибутW(Отступ, "hanging")) Тогда
			Свойства.ПерваяСтрока = -ЧислоW(АтрибутW(Отступ, "hanging")) / 20;
		КонецЕсли;
	КонецЕсли;
	Границы = ДочернийW(Узел, "pBdr");
	Если Границы <> Неопределено Тогда
		ГраницаАбзацаW(Свойства, "ГраницаСверху", ДочернийW(Границы, "top"));
		ГраницаАбзацаW(Свойства, "ГраницаСнизу", ДочернийW(Границы, "bottom"));
		ГраницаАбзацаW(Свойства, "ГраницаСлева", ДочернийW(Границы, "left"));
		ГраницаАбзацаW(Свойства, "ГраницаСправа", ДочернийW(Границы, "right"));
	КонецЕсли;
	Заливка = АтрибутW(ДочернийW(Узел, "shd"), "fill");
	Если Не ПустаяСтрока(Заливка) И НРег(Заливка) <> "auto" Тогда
		Свойства.Фон = "#" + Заливка;
	КонецЕсли;
	Если ДочернийW(Узел, "numPr") <> Неопределено Тогда
		Свойства.Список = Истина;
	КонецЕсли;

	Возврат Свойства;

КонецФункции

Процедура ГраницаАбзацаW(Свойства, Имя, Узел)

	Если Узел <> Неопределено Тогда
		Свойства[Имя] = ГраницаCSS(Узел);
	КонецЕсли;

КонецПроцедуры

// Граница Word (w:top, w:bottom...) в виде CSS «1pt solid #000» или «none».
Функция ГраницаCSS(Узел)

	Вид = АтрибутW(Узел, "val");
	Если ПустаяСтрока(Вид) Или Вид = "nil" Или Вид = "none" Тогда
		Возврат "none";
	КонецЕсли;
	Толщина = ЧислоW(АтрибутW(Узел, "sz"));
	Толщина = Макс(?(Толщина = 0, 4, Толщина) / 8, 0.5);
	Цвет = АтрибутW(Узел, "color");
	Цвет = ?(ПустаяСтрока(Цвет) Или НРег(Цвет) = "auto", "#000", "#" + Цвет);
	Если Вид = "double" Тогда
		Линия = "double";
	ИначеЕсли СтрНайти(НРег(Вид), "dash") > 0 Тогда
		Линия = "dashed";
	ИначеЕсли СтрНайти(НРег(Вид), "dot") > 0 Тогда
		Линия = "dotted";
	Иначе
		Линия = "solid";
	КонецЕсли;
	Возврат ЧислоCSS(Толщина) + "pt " + Линия + " " + Цвет;

КонецФункции

Функция ЦветВыделенияW(Имя)

	Цвета = Новый Соответствие;
	Цвета.Вставить("yellow", "#ffff00");
	Цвета.Вставить("green", "#00ff00");
	Цвета.Вставить("cyan", "#00ffff");
	Цвета.Вставить("magenta", "#ff00ff");
	Цвета.Вставить("blue", "#0000ff");
	Цвета.Вставить("red", "#ff0000");
	Цвета.Вставить("darkBlue", "#000080");
	Цвета.Вставить("darkCyan", "#008080");
	Цвета.Вставить("darkGreen", "#008000");
	Цвета.Вставить("darkMagenta", "#800080");
	Цвета.Вставить("darkRed", "#800000");
	Цвета.Вставить("darkYellow", "#808000");
	Цвета.Вставить("darkGray", "#808080");
	Цвета.Вставить("lightGray", "#c0c0c0");
	Цвета.Вставить("black", "#000000");
	Цвета.Вставить("white", "#ffffff");
	Цвет = Цвета[Имя];
	Возврат ?(Цвет = Неопределено, "", Цвет);

КонецФункции

Процедура ПрочитатьСтилиВерстки(Контекст, ИмяФайла)

	Файл = Новый Файл(ИмяФайла);
	Если Не Файл.Существует() Тогда
		Возврат;
	КонецЕсли;

	ДокументСтилей = ПрочитатьФайлXML(ИмяФайла);
	Контекст.ДокументыDOM.Добавить(ДокументСтилей);
	Корень = ДокументСтилей.ЭлементДокумента;
	Умолчания = ДочернийW(Корень, "docDefaults");
	Если Умолчания <> Неопределено Тогда
		Контекст.ТекстПоУмолчанию = СвойстваТекстаW(ВложенныйW(ДочернийW(Умолчания, "rPrDefault"), "rPr"), Неопределено);
		Контекст.АбзацПоУмолчанию = СвойстваАбзацаW(ВложенныйW(ДочернийW(Умолчания, "pPrDefault"), "pPr"), Неопределено);
	КонецЕсли;

	Для Каждого Стиль Из Корень.ДочерниеУзлы Цикл
		Если Не ЭтоЭлемент(Стиль, "style") Тогда
			Продолжить;
		КонецЕсли;
		Идентификатор = АтрибутW(Стиль, "styleId");
		Контекст.Стили.Вставить(Идентификатор, Новый Структура("Основа, СвойстваТекста, СвойстваАбзаца, СвойстваТаблицы",
			АтрибутW(ДочернийW(Стиль, "basedOn"), "val"), ДочернийW(Стиль, "rPr"), ДочернийW(Стиль, "pPr"), ДочернийW(Стиль, "tblPr")));
		Если АтрибутW(Стиль, "type") = "paragraph" И (АтрибутW(Стиль, "default") = "1" Или НРег(АтрибутW(Стиль, "default")) = "true") Тогда
			Контекст.СтильАбзацаПоУмолчанию = Идентификатор;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьСвязиВерстки(Контекст, ИмяФайла)

	Файл = Новый Файл(ИмяФайла);
	Если Не Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	ДокументСвязей = ПрочитатьФайлXML(ИмяФайла);
	Для Каждого Связь Из ДокументСвязей.ЭлементДокумента.ДочерниеУзлы Цикл
		Если Связь.ТипУзла <> ТипУзлаDOM.Элемент Тогда
			Продолжить;
		КонецЕсли;
		Идентификатор = Связь.ПолучитьАтрибут("Id");
		Цель = Связь.ПолучитьАтрибут("Target");
		Если Идентификатор <> Неопределено И Цель <> Неопределено Тогда
			Контекст.Связи.Вставить(Идентификатор, Цель);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Стили от базового к указанному (наследование через w:basedOn).
Функция ЦепочкаСтилей(Контекст, Знач Идентификатор)

	Цепочка = Новый Массив;
	Пока Не ПустаяСтрока(Идентификатор) И Цепочка.Количество() < 20 Цикл
		Стиль = Контекст.Стили[Идентификатор];
		Если Стиль = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Цепочка.Вставить(0, Стиль);
		Идентификатор = Стиль.Основа;
	КонецЦикла;
	Возврат Цепочка;

КонецФункции

// Оформление абзаца и его текста по стилю абзаца (без собственных свойств абзаца).
Функция ОсноваАбзацаВерстки(СвойстваАбзаца, Контекст)

	Идентификатор = АтрибутW(ВложенныйW(СвойстваАбзаца, "pStyle"), "val");
	Если ПустаяСтрока(Идентификатор) Тогда
		Идентификатор = Контекст.СтильАбзацаПоУмолчанию;
	КонецЕсли;
	Текст = НовыеСвойстваТекстаW(Контекст.ТекстПоУмолчанию);
	Абзац = НовыеСвойстваАбзацаW(Контекст.АбзацПоУмолчанию);
	Для Каждого Стиль Из ЦепочкаСтилей(Контекст, Идентификатор) Цикл
		Текст = СвойстваТекстаW(Стиль.СвойстваТекста, Текст);
		Абзац = СвойстваАбзацаW(Стиль.СвойстваАбзаца, Абзац);
	КонецЦикла;
	Возврат Новый Структура("Текст, Абзац", Текст, Абзац);

КонецФункции

// CSS текста: только отличия от основного шрифта документа.
Функция СтильТекстаCSS(Свойства, Контекст)

	Стили = Новый Массив;
	Если Свойства.Жирный Тогда
		Стили.Добавить("font-weight:bold");
	КонецЕсли;
	Если Свойства.Курсив Тогда
		Стили.Добавить("font-style:italic");
	КонецЕсли;
	Если Свойства.Подчеркнутый И Свойства.Зачеркнутый Тогда
		Стили.Добавить("text-decoration:underline line-through");
	ИначеЕсли Свойства.Подчеркнутый Тогда
		Стили.Добавить("text-decoration:underline");
	ИначеЕсли Свойства.Зачеркнутый Тогда
		Стили.Добавить("text-decoration:line-through");
	КонецЕсли;
	Если Свойства.Размер > 0 И Свойства.Размер <> Контекст.Размер Тогда
		Стили.Добавить("font-size:" + ЧислоCSS(Свойства.Размер) + "pt");
	КонецЕсли;
	Если Не ПустаяСтрока(Свойства.Цвет) И НРег(Свойства.Цвет) <> "#000000" Тогда
		Стили.Добавить("color:" + Свойства.Цвет);
	КонецЕсли;
	Если Не ПустаяСтрока(Свойства.Фон) Тогда
		Стили.Добавить("background-color:" + Свойства.Фон);
	КонецЕсли;
	Если Не ПустаяСтрока(Свойства.Шрифт) И Свойства.Шрифт <> Контекст.Шрифт Тогда
		Стили.Добавить("font-family:'" + СтрЗаменить(СтрЗаменить(Свойства.Шрифт, "'", ""), """", "") + "'");
	КонецЕсли;
	Если Свойства.Положение = "superscript" Тогда
		Стили.Добавить("vertical-align:super;font-size:smaller");
	ИначеЕсли Свойства.Положение = "subscript" Тогда
		Стили.Добавить("vertical-align:sub;font-size:smaller");
	КонецЕсли;
	Возврат СтрСоединить(Стили, ";");

КонецФункции

Функция БлокВерстки(Узел, Контекст)

	Если ЭтоЭлемент(Узел, "p") Тогда
		Возврат АбзацВерстки(Узел, Контекст);
	ИначеЕсли ЭтоЭлемент(Узел, "tbl") Тогда
		Возврат ТаблицаВерстки(Узел, Контекст);
	ИначеЕсли ЭтоЭлемент(Узел, "sdt") Тогда
		Метка = ОписаниеЭлементаУправления(Узел);
		Если Не Метка.БлочныйКонтейнер И Не ПустаяСтрока(Метка.Имя) Тогда
			Возврат "<p style=""margin:0"">" + ПлашкаВерстки(Метка, "", Контекст) + "</p>";
		КонецЕсли;
		Части = Новый Массив;
		Содержимое = ДочернийW(Узел, "sdtContent");
		Если Содержимое <> Неопределено Тогда
			Для Каждого Дочерний Из Содержимое.ДочерниеУзлы Цикл
				Части.Добавить(БлокВерстки(Дочерний, Контекст));
			КонецЦикла;
		КонецЕсли;
		Возврат СтрСоединить(Части);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция АбзацВерстки(Абзац, Контекст)

	СвойстваУзла = ДочернийW(Абзац, "pPr");
	Основа = ОсноваАбзацаВерстки(СвойстваУзла, Контекст);
	Свойства = СвойстваАбзацаW(СвойстваУзла, Основа.Абзац);

	Стили = Новый Массив;
	Стили.Добавить("margin:" + ЧислоCSS(Свойства.Перед) + "pt 0 " + ЧислоCSS(Свойства.После) + "pt " + ЧислоCSS(Свойства.Слева) + "pt");
	Если Свойства.ПерваяСтрока <> 0 Тогда
		Стили.Добавить("text-indent:" + ЧислоCSS(Свойства.ПерваяСтрока) + "pt");
	КонецЕсли;
	Если Свойства.Выравнивание = "center" Тогда
		Стили.Добавить("text-align:center");
	ИначеЕсли Свойства.Выравнивание = "right" Или Свойства.Выравнивание = "end" Тогда
		Стили.Добавить("text-align:right");
	ИначеЕсли Свойства.Выравнивание = "both" Или Свойства.Выравнивание = "distribute" Тогда
		Стили.Добавить("text-align:justify");
	КонецЕсли;
	ДобавитьГраницуCSS(Стили, "top", Свойства.ГраницаСверху);
	ДобавитьГраницуCSS(Стили, "bottom", Свойства.ГраницаСнизу);
	ДобавитьГраницуCSS(Стили, "left", Свойства.ГраницаСлева);
	ДобавитьГраницуCSS(Стили, "right", Свойства.ГраницаСправа);
	Если Не ПустаяСтрока(Свойства.Фон) Тогда
		Стили.Добавить("background-color:" + Свойства.Фон);
	КонецЕсли;
	// Размер пустого абзаца (высота строки) задаёт знак абзаца.
	ЗнакАбзаца = СвойстваТекстаW(ВложенныйW(СвойстваУзла, "rPr"), Основа.Текст);
	Если ЗнакАбзаца.Размер > 0 И ЗнакАбзаца.Размер <> Контекст.Размер Тогда
		Стили.Добавить("font-size:" + ЧислоCSS(ЗнакАбзаца.Размер) + "pt");
	КонецЕсли;

	Фрагменты = Новый Массив;
	СобратьФрагментыВерстки(Абзац, Основа.Текст, Контекст, Фрагменты);
	Содержимое = ФрагментыВерсткиВHTML(Фрагменты, Контекст);
	Если Свойства.Список Тогда
		Содержимое = "&bull;&nbsp;" + Содержимое;
	КонецЕсли;

	Возврат "<p style=""" + СтрСоединить(Стили, ";") + """>" + ?(Содержимое = "", "<br>", Содержимое) + "</p>";

КонецФункции

Процедура ДобавитьГраницуCSS(Стили, Сторона, Граница)

	Если Не ПустаяСтрока(Граница) И Граница <> "none" Тогда
		Стили.Добавить("border-" + Сторона + ":" + Граница + ";padding-" + Сторона + ":1pt");
	КонецЕсли;

КонецПроцедуры

// Фрагменты абзаца: Структура(Вид, Значение, Стиль); Вид - «Текст» (значение - текст), «HTML» (готовая разметка),
// «Поле» (значение - описание метки элемента управления содержимым).
Процедура СобратьФрагментыВерстки(Узел, ОсноваТекста, Контекст, Фрагменты)

	Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл

		Если ЭтоЭлемент(Дочерний, "r") Тогда

			СвойстваПрогона = ДочернийW(Дочерний, "rPr");
			Основа = ОсноваТекста;
			СтильЗнаков = АтрибутW(ВложенныйW(СвойстваПрогона, "rStyle"), "val");
			Если Не ПустаяСтрока(СтильЗнаков) Тогда
				Основа = НовыеСвойстваТекстаW(ОсноваТекста);
				Для Каждого Стиль Из ЦепочкаСтилей(Контекст, СтильЗнаков) Цикл
					Основа = СвойстваТекстаW(Стиль.СвойстваТекста, Основа);
				КонецЦикла;
			КонецЕсли;
			СтильCSS = СтильТекстаCSS(СвойстваТекстаW(СвойстваПрогона, Основа), Контекст);

			Для Каждого Элемент Из Дочерний.ДочерниеУзлы Цикл
				Если ЭтоЭлемент(Элемент, "t") Тогда
					ДобавитьФрагментВерстки(Фрагменты, "Текст", Элемент.ТекстовоеСодержимое, СтильCSS);
				ИначеЕсли ЭтоЭлемент(Элемент, "tab") Тогда
					ДобавитьФрагментВерстки(Фрагменты, "HTML", "&emsp;", "");
				ИначеЕсли ЭтоЭлемент(Элемент, "br") Или ЭтоЭлемент(Элемент, "cr") Тогда
					ДобавитьФрагментВерстки(Фрагменты, "HTML", "<br>", "");
				ИначеЕсли ЭтоЭлемент(Элемент, "drawing") Или ЭтоЭлемент(Элемент, "pict") Тогда
					ДобавитьФрагментВерстки(Фрагменты, "HTML", КартинкаВерстки(Элемент, Контекст), "");
				КонецЕсли;
			КонецЦикла;

		ИначеЕсли ЭтоЭлемент(Дочерний, "hyperlink") Или ЭтоЭлемент(Дочерний, "ins") Или ЭтоЭлемент(Дочерний, "smartTag")
			Или ЭтоЭлемент(Дочерний, "fldSimple") Или ЭтоЭлемент(Дочерний, "customXml") Тогда

			СобратьФрагментыВерстки(Дочерний, ОсноваТекста, Контекст, Фрагменты);

		ИначеЕсли ЭтоЭлемент(Дочерний, "sdt") Тогда

			Метка = ОписаниеЭлементаУправления(Дочерний);
			Если Не Метка.БлочныйКонтейнер И Не ПустаяСтрока(Метка.Имя) Тогда
				ДобавитьФрагментВерстки(Фрагменты, "Поле", Метка, "");
			Иначе
				Содержимое = ДочернийW(Дочерний, "sdtContent");
				Если Содержимое <> Неопределено Тогда
					СобратьФрагментыВерстки(Содержимое, ОсноваТекста, Контекст, Фрагменты);
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Соседние куски текста с одинаковым оформлением склеиваются: Word делит текст на части (проверка орфографии,
// правки), и метка {{...}} иначе может оказаться разрезанной.
Процедура ДобавитьФрагментВерстки(Фрагменты, Вид, Значение, Стиль)

	Если Вид = "Текст" И Фрагменты.Количество() > 0 Тогда
		Последний = Фрагменты[Фрагменты.ВГраница()];
		Если Последний.Вид = "Текст" И Последний.Стиль = Стиль Тогда
			Последний.Значение = Последний.Значение + Значение;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Фрагменты.Добавить(Новый Структура("Вид, Значение, Стиль", Вид, Значение, Стиль));

КонецПроцедуры

// HTML абзаца: текст с оформлением, метки {{...}} - плашки полей (оформление плашки - по началу метки).
Функция ФрагментыВерсткиВHTML(Фрагменты, Контекст)

	Части = Новый Массив;
	ВнутриМетки = Ложь;
	ТекстМетки = "";
	СтильМетки = "";

	Для Каждого Фрагмент Из Фрагменты Цикл

		Если Фрагмент.Вид = "Поле" Тогда
			Части.Добавить(ПлашкаВерстки(Фрагмент.Значение, Фрагмент.Стиль, Контекст));
			Продолжить;
		ИначеЕсли Фрагмент.Вид = "HTML" Тогда
			Если Не ВнутриМетки Тогда
				Части.Добавить(Фрагмент.Значение);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Остаток = Фрагмент.Значение;
		Пока Остаток <> "" Цикл
			Если Не ВнутриМетки Тогда
				Позиция = СтрНайти(Остаток, "{{");
				Если Позиция = 0 Тогда
					ДобавитьТекстВерстки(Части, Остаток, Фрагмент.Стиль);
					Остаток = "";
				Иначе
					ДобавитьТекстВерстки(Части, Лев(Остаток, Позиция - 1), Фрагмент.Стиль);
					ВнутриМетки = Истина;
					ТекстМетки = "";
					СтильМетки = Фрагмент.Стиль;
					Остаток = Сред(Остаток, Позиция + 2);
				КонецЕсли;
			Иначе
				Позиция = СтрНайти(Остаток, "}}");
				Если Позиция = 0 Тогда
					ТекстМетки = ТекстМетки + Остаток;
					Остаток = "";
				Иначе
					ТекстМетки = ТекстМетки + Лев(Остаток, Позиция - 1);
					Части.Добавить(ПлашкаВерстки(ОписаниеМетки(ТекстМетки, Новый Массив), СтильМетки, Контекст));
					ВнутриМетки = Ложь;
					Остаток = Сред(Остаток, Позиция + 2);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Если ВнутриМетки Тогда
		// Незакрытая метка - обычный текст.
		ДобавитьТекстВерстки(Части, "{{" + ТекстМетки, СтильМетки);
	КонецЕсли;

	Возврат СтрСоединить(Части);

КонецФункции

Процедура ДобавитьТекстВерстки(Части, Текст, Стиль)

	Если Текст = "" Тогда
		Возврат;
	КонецЕсли;
	// Несколько пробелов подряд в HTML схлопываются - сохраняем их, как в Word.
	ТекстРазметки = СтрЗаменить(ТекстHTML(Текст), "  ", " &nbsp;");
	Если ПустаяСтрока(Стиль) Тогда
		Части.Добавить(ТекстРазметки);
	Иначе
		Части.Добавить("<span style=""" + Стиль + """>" + ТекстРазметки + "</span>");
	КонецЕсли;

КонецПроцедуры

// Плашка поля; поле с тем же названием уже было - та же плашка (повтор значения).
Функция ПлашкаВерстки(Метка, Стиль, Контекст)

	Имя = СокрЛП(Метка.Имя);
	Если ПустаяСтрока(Имя) Тогда
		Имя = СтрШаблон(НСтр("ru = 'Поле %1'"), Контекст.Поля.Количество() + 1);
		Контекст.Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'У поля без названия задано имя «%1», проверьте его.'"), Имя));
	КонецЕсли;
	КлючИмени = НРег(Имя);

	Поле = Контекст.ПоляПоИмени[КлючИмени];
	Если Поле = Неопределено Тогда
		Поле = Новый Структура("Ключ, Наименование, Тип, ЗначениеПоУмолчанию, ВариантыВыбора, ИмяПараметра",
			Строка(Новый УникальныйИдентификатор), Имя, Метка.Тип, Метка.ПоУмолчанию,
			СтрСоединить(Метка.Варианты, "; "), Метка.ИмяПараметра);
		Контекст.Поля.Добавить(Поле);
		Контекст.ПоляПоИмени.Вставить(КлючИмени, Поле);
	Иначе
		// Повтор поля может уточнять то, что не задано в первой метке.
		Если ПустаяСтрока(Поле.ЗначениеПоУмолчанию) И Не ПустаяСтрока(Метка.ПоУмолчанию) Тогда
			Поле.ЗначениеПоУмолчанию = Метка.ПоУмолчанию;
		КонецЕсли;
		Если ПустаяСтрока(Поле.ИмяПараметра) И Не ПустаяСтрока(Метка.ИмяПараметра) Тогда
			Поле.ИмяПараметра = Метка.ИмяПараметра;
		КонецЕсли;
	КонецЕсли;

	Плашка = "<span class=""omg-f"" data-key=""" + Поле.Ключ + """>" + ТекстHTML(Поле.Наименование) + "</span>";
	Если ПустаяСтрока(Стиль) Тогда
		Возврат Плашка;
	КонецЕсли;
	Возврат "<span style=""" + Стиль + """>" + Плашка + "</span>";

КонецФункции

Функция ТаблицаВерстки(Таблица, Контекст)

	СвойстваТаблицы = ДочернийW(Таблица, "tblPr");

	// Сетка колонок (ширины в twips).
	Сетка = Новый Массив;
	ШиринаСетки = 0;
	УзелСетки = ДочернийW(Таблица, "tblGrid");
	Если УзелСетки <> Неопределено Тогда
		Для Каждого Колонка Из УзелСетки.ДочерниеУзлы Цикл
			Если ЭтоЭлемент(Колонка, "gridCol") Тогда
				Ширина = ЧислоW(АтрибутW(Колонка, "w"));
				Сетка.Добавить(Ширина);
				ШиринаСетки = ШиринаСетки + Ширина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Границы: сначала из стиля таблицы, затем собственные.
	Границы = Новый Структура("top, bottom, left, right, insideH, insideV", "none", "none", "none", "none", "none", "none");
	Для Каждого Стиль Из ЦепочкаСтилей(Контекст, АтрибутW(ВложенныйW(СвойстваТаблицы, "tblStyle"), "val")) Цикл
		ГраницыТаблицыW(Границы, ВложенныйW(Стиль.СвойстваТаблицы, "tblBorders"));
	КонецЦикла;
	ГраницыТаблицыW(Границы, ВложенныйW(СвойстваТаблицы, "tblBorders"));

	Стили = Новый Массив;
	Стили.Добавить("border-collapse:collapse");
	УзелШирины = ВложенныйW(СвойстваТаблицы, "tblW");
	ВидШирины = АтрибутW(УзелШирины, "type");
	ЗначениеШирины = ЧислоW(АтрибутW(УзелШирины, "w"));
	Если ВидШирины = "pct" И ЗначениеШирины > 0 Тогда
		Стили.Добавить("width:" + ЧислоCSS(ЗначениеШирины / 50) + "%");
	ИначеЕсли ВидШирины = "dxa" И ЗначениеШирины > 0 И Контекст.ШиринаТекста > 0 Тогда
		Стили.Добавить("width:" + ЧислоCSS(Мин(ЗначениеШирины / Контекст.ШиринаТекста * 100, 115)) + "%");
	Иначе
		Стили.Добавить("width:100%");
	КонецЕсли;
	Отступ = ЧислоW(АтрибутW(ВложенныйW(СвойстваТаблицы, "tblInd"), "w"));
	Если Отступ <> 0 Тогда
		Стили.Добавить("margin-left:" + ЧислоCSS(Отступ / 20) + "pt");
	КонецЕсли;
	Для Каждого Сторона Из СтрРазделить("top,bottom,left,right", ",") Цикл
		Если Границы[Сторона] <> "none" Тогда
			Стили.Добавить("border-" + Сторона + ":" + Границы[Сторона]);
		КонецЕсли;
	КонецЦикла;

	// Ячейки по сетке: горизонтальное объединение - gridSpan, вертикальное - vMerge (продолжение не выводится,
	// верхней ячейке добавляется строка).
	Строки = Новый Массив;
	ЧислоКолонок = Сетка.Количество();
	Для Каждого УзелСтроки Из Таблица.ДочерниеУзлы Цикл
		Если Не ЭтоЭлемент(УзелСтроки, "tr") Тогда
			Продолжить;
		КонецЕсли;
		Ячейки = Новый Массив;
		Колонка = 0;
		Для Каждого УзелЯчейки Из УзелСтроки.ДочерниеУзлы Цикл
			Если Не ЭтоЭлемент(УзелЯчейки, "tc") Тогда
				Продолжить;
			КонецЕсли;
			СвойстваЯчейки = ДочернийW(УзелЯчейки, "tcPr");
			Объединение = Макс(ЧислоW(АтрибутW(ВложенныйW(СвойстваЯчейки, "gridSpan"), "val")), 1);
			УзелОбъединения = ВложенныйW(СвойстваЯчейки, "vMerge");
			Вертикально = "";
			Если УзелОбъединения <> Неопределено Тогда
				Вертикально = АтрибутW(УзелОбъединения, "val");
				Если ПустаяСтрока(Вертикально) Тогда
					Вертикально = "continue";
				КонецЕсли;
			КонецЕсли;
			Ячейки.Добавить(Новый Структура("Узел, Свойства, Колонка, Объединение, Вертикально, Строк",
				УзелЯчейки, СвойстваЯчейки, Колонка, Объединение, Вертикально, 1));
			Колонка = Колонка + Объединение;
		КонецЦикла;
		ЧислоКолонок = Макс(ЧислоКолонок, Колонка);
		Строки.Добавить(Новый Структура("Узел, Ячейки", УзелСтроки, Ячейки));
	КонецЦикла;

	Для Индекс = 0 По Строки.ВГраница() Цикл
		Для Каждого Ячейка Из Строки[Индекс].Ячейки Цикл
			Если Ячейка.Вертикально <> "continue" Тогда
				Продолжить;
			КонецЕсли;
			Выше = Индекс - 1;
			Пока Выше >= 0 Цикл
				Верхняя = ЯчейкаВКолонкеW(Строки[Выше].Ячейки, Ячейка.Колонка);
				Если Верхняя = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Если Верхняя.Вертикально <> "continue" Тогда
					Верхняя.Строк = Верхняя.Строк + 1;
					Прервать;
				КонецЕсли;
				Выше = Выше - 1;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Части = Новый Массив;
	Части.Добавить("<table style=""" + СтрСоединить(Стили, ";") + """>");
	Если ШиринаСетки > 0 Тогда
		Части.Добавить("<colgroup>");
		Для Каждого Ширина Из Сетка Цикл
			Части.Добавить("<col style=""width:" + ЧислоCSS(Ширина / ШиринаСетки * 100) + "%"">");
		КонецЦикла;
		Части.Добавить("</colgroup>");
	КонецЕсли;

	Для Индекс = 0 По Строки.ВГраница() Цикл
		ДанныеСтроки = Строки[Индекс];
		Высота = ЧислоW(АтрибутW(ВложенныйW(ДочернийW(ДанныеСтроки.Узел, "trPr"), "trHeight"), "val"));
		Части.Добавить(?(Высота > 0, "<tr style=""height:" + ЧислоCSS(Высота / 20) + "pt"">", "<tr>"));
		Для Каждого Ячейка Из ДанныеСтроки.Ячейки Цикл
			Если Ячейка.Вертикально = "continue" Тогда
				Продолжить;
			КонецЕсли;
			Части.Добавить(ЯчейкаВерстки(Ячейка, Индекс, Строки.Количество(), ЧислоКолонок, Границы, Контекст));
		КонецЦикла;
		Части.Добавить("</tr>");
	КонецЦикла;
	Части.Добавить("</table>");

	Возврат СтрСоединить(Части);

КонецФункции

Процедура ГраницыТаблицыW(Границы, Узел)

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Сторона Из СтрРазделить("top,bottom,left,right,insideH,insideV", ",") Цикл
		УзелГраницы = ДочернийW(Узел, Сторона);
		Если УзелГраницы = Неопределено И Сторона = "left" Тогда
			УзелГраницы = ДочернийW(Узел, "start");
		ИначеЕсли УзелГраницы = Неопределено И Сторона = "right" Тогда
			УзелГраницы = ДочернийW(Узел, "end");
		КонецЕсли;
		Если УзелГраницы <> Неопределено Тогда
			Границы[Сторона] = ГраницаCSS(УзелГраницы);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЯчейкаВКолонкеW(Ячейки, Колонка)

	Для Каждого Ячейка Из Ячейки Цикл
		Если Ячейка.Колонка = Колонка Тогда
			Возврат Ячейка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЯчейкаВерстки(Ячейка, ИндексСтроки, ЧислоСтрок, ЧислоКолонок, ГраницыТаблицы, Контекст)

	// Внешние стороны ячейки берут границу таблицы, внутренние - insideH/insideV; свои границы ячейки важнее.
	Границы = Новый Структура;
	Границы.Вставить("top", ?(ИндексСтроки = 0, ГраницыТаблицы.top, ГраницыТаблицы.insideH));
	Границы.Вставить("bottom", ?(ИндексСтроки + Ячейка.Строк >= ЧислоСтрок, ГраницыТаблицы.bottom, ГраницыТаблицы.insideH));
	Границы.Вставить("left", ?(Ячейка.Колонка = 0, ГраницыТаблицы.left, ГраницыТаблицы.insideV));
	Границы.Вставить("right", ?(Ячейка.Колонка + Ячейка.Объединение >= ЧислоКолонок, ГраницыТаблицы.right, ГраницыТаблицы.insideV));
	ГраницыЯчейки = Новый Структура("top, bottom, left, right, insideH, insideV",
		Границы.top, Границы.bottom, Границы.left, Границы.right, "none", "none");
	ГраницыТаблицыW(ГраницыЯчейки, ВложенныйW(Ячейка.Свойства, "tcBorders"));

	Стили = Новый Массив;
	Стили.Добавить("padding:1pt 3pt");
	Для Каждого Сторона Из СтрРазделить("top,bottom,left,right", ",") Цикл
		Если ГраницыЯчейки[Сторона] <> "none" Тогда
			Стили.Добавить("border-" + Сторона + ":" + ГраницыЯчейки[Сторона]);
		КонецЕсли;
	КонецЦикла;
	ПоВертикали = АтрибутW(ВложенныйW(Ячейка.Свойства, "vAlign"), "val");
	Если ПоВертикали = "center" Тогда
		Стили.Добавить("vertical-align:middle");
	ИначеЕсли ПоВертикали = "bottom" Тогда
		Стили.Добавить("vertical-align:bottom");
	Иначе
		Стили.Добавить("vertical-align:top");
	КонецЕсли;
	Заливка = АтрибутW(ВложенныйW(Ячейка.Свойства, "shd"), "fill");
	Если Не ПустаяСтрока(Заливка) И НРег(Заливка) <> "auto" Тогда
		Стили.Добавить("background-color:#" + Заливка);
	КонецЕсли;

	Атрибуты = "";
	Если Ячейка.Объединение > 1 Тогда
		Атрибуты = Атрибуты + " colspan=""" + Формат(Ячейка.Объединение, "ЧГ=0") + """";
	КонецЕсли;
	Если Ячейка.Строк > 1 Тогда
		Атрибуты = Атрибуты + " rowspan=""" + Формат(Ячейка.Строк, "ЧГ=0") + """";
	КонецЕсли;

	Содержимое = Новый Массив;
	Для Каждого Дочерний Из Ячейка.Узел.ДочерниеУзлы Цикл
		Содержимое.Добавить(БлокВерстки(Дочерний, Контекст));
	КонецЦикла;

	Возврат "<td" + Атрибуты + " style=""" + СтрСоединить(Стили, ";") + """>" + СтрСоединить(Содержимое) + "</td>";

КонецФункции

// Картинка из w:drawing (или старого w:pict) - img с данными внутри (data:), размер - как в документе.
Функция КартинкаВерстки(Узел, Контекст)

	Идентификатор = "";
	Картинки = Узел.ПолучитьЭлементыПоИмени(ПространствоИменDrawingML(), "blip");
	Если Картинки.Количество() > 0 Тогда
		Идентификатор = Картинки.Элемент(0).ПолучитьАтрибутNS(ПространствоИменСвязей(), "embed");
	Иначе
		Картинки = Узел.ПолучитьЭлементыПоИмени(ПространствоИменVML(), "imagedata");
		Если Картинки.Количество() > 0 Тогда
			Идентификатор = Картинки.Элемент(0).ПолучитьАтрибутNS(ПространствоИменСвязей(), "id");
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат "";
	КонецЕсли;
	Цель = Контекст.Связи[Идентификатор];
	Если Цель = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если СтрНачинаетсяС(Цель, "/") Тогда
		ИмяФайла = Контекст.Каталог + Цель;
	Иначе
		ИмяФайла = Контекст.Каталог + "/word/" + СтрЗаменить(Цель, "../", "");
	КонецЕсли;
	Расширение = НРег(Прав(Цель, 4));
	Если Расширение = ".emf" Или Расширение = ".wmf" Тогда
		Контекст.Предупреждения.Добавить(НСтр("ru = 'Картинка в формате EMF/WMF не переносится - вставьте её в документ как PNG или JPEG.'"));
		Возврат "";
	КонецЕсли;
	Файл = Новый Файл(ИмяФайла);
	Если Не Файл.Существует() Тогда
		Возврат "";
	КонецЕсли;
	Данные = Новый ДвоичныеДанные(ИмяФайла);
	Контекст.ЕстьКартинки = Истина;

	Размер = "";
	Размеры = Узел.ПолучитьЭлементыПоИмени(ПространствоИменWordprocessingDrawing(), "extent");
	Если Размеры.Количество() > 0 Тогда
		Ширина = Окр(ЧислоW(Размеры.Элемент(0).ПолучитьАтрибут("cx")) / 9525);
		Высота = Окр(ЧислоW(Размеры.Элемент(0).ПолучитьАтрибут("cy")) / 9525);
		Если Ширина > 0 И Высота > 0 Тогда
			Размер = " style=""width:" + Формат(Ширина, "ЧГ=0") + "px;height:" + Формат(Высота, "ЧГ=0") + "px""";
		КонецЕсли;
	КонецЕсли;

	Возврат "<img src=""data:image/" + РасширениеКартинки(Данные) + ";base64,"
		+ СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ВК, ""), Символы.ПС, "") + """" + Размер + ">";

КонецФункции

// Ширина текста страницы (twips) - для ширины таблиц в процентах.
Функция ШиринаТекстаРазделаW(Раздел)

	Если Раздел = Неопределено Тогда
		Возврат 9638;
	КонецЕсли;
	Ширина = ЧислоW(АтрибутW(ДочернийW(Раздел, "pgSz"), "w"));
	Поля = ДочернийW(Раздел, "pgMar");
	Ширина = Ширина - ЧислоW(АтрибутW(Поля, "left")) - ЧислоW(АтрибутW(Поля, "right"));
	Возврат ?(Ширина > 0, Ширина, 9638);

КонецФункции

#КонецОбласти

#Область ДокументWord

// Ширина текста страницы A4 в twips: 210 мм - поля 15 и 10 мм.
Функция ШиринаТекстаW()
	Возврат 10489;
КонецФункции

Функция НовыйДокументWord(Модель)

	Док = Новый Структура;
	Док.Вставить("Тело", Новый Массив);
	Док.Вставить("Шрифт", Модель.Шрифт);
	Док.Вставить("Размер", Модель.РазмерШрифта);
	Док.Вставить("Логотип", Неопределено);
	Док.Вставить("ВложениеMHT", Ложь); // ВложенныйHTML - MHT (HTML с картинками).
	Док.Вставить("ВложенныйHTML", ""); // Свободная вёрстка - HTML, который Word вставит при открытии.
	Возврат Док;

КонецФункции

// Фрагмент текста с оформлением. Размер 0 - размер абзаца (стиля).
Функция ФрагментW(Текст, Жирный = Ложь, Курсив = Ложь, Размер = 0)

	Возврат Новый Структура("Текст, Жирный, Курсив, Размер", Строка(Текст), Жирный = Истина, Курсив = Истина, Размер);

КонецФункции

Функция ФрагментПоля(Поле, Текст)

	Возврат ФрагментW(Текст, Поле.Жирный, Поле.Курсив, Поле.РазмерШрифта);

КонецФункции

Функция ТекстXMLW(Знач Текст)

	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Текст = СтрЗаменить(Текст, Символы.ВК, "");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Возврат Текст;

КонецФункции

Функция ВыравниваниеW(Выравнивание)

	Если Выравнивание = "Центр" Тогда
		Возврат "center";
	ИначеЕсли Выравнивание = "Право" Тогда
		Возврат "right";
	ИначеЕсли Выравнивание = "Ширина" Тогда
		Возврат "both";
	КонецЕсли;
	Возврат "";

КонецФункции

// Фрагмент текста абзаца (w:r); переносы строк - w:br.
Функция ПрогонW(Фрагмент)

	Свойства = "";
	Если Фрагмент.Жирный Тогда
		Свойства = Свойства + "<w:b/>";
	КонецЕсли;
	Если Фрагмент.Курсив Тогда
		Свойства = Свойства + "<w:i/>";
	КонецЕсли;
	Если Фрагмент.Размер > 0 Тогда
		Свойства = Свойства + СтрШаблон("<w:sz w:val=""%1""/><w:szCs w:val=""%1""/>", Формат(Фрагмент.Размер * 2, "ЧГ=0"));
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого СтрокаТекста Из СтрРазделить(Фрагмент.Текст, Символы.ПС, Истина) Цикл
		Строки.Добавить("<w:t xml:space=""preserve"">" + ТекстXMLW(СтрокаТекста) + "</w:t>");
	КонецЦикла;

	Возврат "<w:r>" + ?(ПустаяСтрока(Свойства), "", "<w:rPr>" + Свойства + "</w:rPr>")
		+ СтрСоединить(Строки, "<w:br/>") + "</w:r>";

КонецФункции

Функция АбзацW(Фрагменты, Выравнивание = "", Стиль = "")

	Если ТипЗнч(Фрагменты) = Тип("Структура") Тогда
		Массив = Новый Массив;
		Массив.Добавить(Фрагменты);
		Фрагменты = Массив;
	КонецЕсли;

	Свойства = "";
	Если Не ПустаяСтрока(Стиль) Тогда
		Свойства = Свойства + "<w:pStyle w:val=""" + Стиль + """/>";
	КонецЕсли;
	Выравнивание = ВыравниваниеW(Выравнивание);
	Если Не ПустаяСтрока(Выравнивание) Тогда
		Свойства = Свойства + "<w:jc w:val=""" + Выравнивание + """/>";
	КонецЕсли;

	Прогоны = "";
	Для Каждого Фрагмент Из Фрагменты Цикл
		Прогоны = Прогоны + ПрогонW(Фрагмент);
	КонецЦикла;

	Возврат "<w:p>" + ?(ПустаяСтрока(Свойства), "", "<w:pPr>" + Свойства + "</w:pPr>") + Прогоны + "</w:p>";

КонецФункции

Процедура ДобавитьАбзацW(Док, Фрагменты, Выравнивание = "", Стиль = "")

	Док.Тело.Добавить(АбзацW(Фрагменты, Выравнивание, Стиль));

КонецПроцедуры

// «Название: значение» одним абзацем: название жирным, значение - с оформлением поля.
Процедура ДобавитьНазваниеЗначениеW(Док, Название, ФрагментЗначения, Выравнивание = "")

	Фрагменты = Новый Массив;
	Фрагменты.Добавить(ФрагментW(Название + ": ", Истина, , ФрагментЗначения.Размер));
	Фрагменты.Добавить(ФрагментЗначения);
	ДобавитьАбзацW(Док, Фрагменты, Выравнивание);

КонецПроцедуры

// Таблица Word на всю ширину страницы: первая строка - колонки (повторяется на каждой странице).
Процедура ДобавитьТаблицуW(Док, Колонки, Строки, ОформлениеЯчейки)

	Колонок = Макс(Колонки.Количество(), 1);
	Для Каждого Ячейки Из Строки Цикл
		Колонок = Макс(Колонок, Ячейки.Количество());
	КонецЦикла;
	ШиринаКолонки = Цел(ШиринаТекстаW() / Колонок);
	ШиринаТекстом = Формат(ШиринаКолонки, "ЧГ=0");

	Граница = "w:val=""single"" w:sz=""4"" w:space=""0"" w:color=""000000""";
	Части = Новый Массив;
	Части.Добавить("<w:tbl><w:tblPr><w:tblW w:w=""" + Формат(ШиринаКолонки * Колонок, "ЧГ=0") + """ w:type=""dxa""/>"
		+ "<w:tblBorders><w:top " + Граница + "/><w:left " + Граница + "/><w:bottom " + Граница + "/>"
		+ "<w:right " + Граница + "/><w:insideH " + Граница + "/><w:insideV " + Граница + "/></w:tblBorders>"
		+ "<w:tblLayout w:type=""fixed""/>"
		+ "<w:tblCellMar><w:left w:w=""57"" w:type=""dxa""/><w:right w:w=""57"" w:type=""dxa""/></w:tblCellMar>"
		+ "</w:tblPr><w:tblGrid>");
	Для НомерКолонки = 1 По Колонок Цикл
		Части.Добавить("<w:gridCol w:w=""" + ШиринаТекстом + """/>");
	КонецЦикла;
	Части.Добавить("</w:tblGrid>");

	Если Колонки.Количество() > 0 Тогда
		Части.Добавить("<w:tr><w:trPr><w:tblHeader/></w:trPr>");
		Для НомерКолонки = 1 По Колонок Цикл
			Текст = ?(НомерКолонки <= Колонки.Количество(), Колонки[НомерКолонки - 1], "");
			Части.Добавить(ЯчейкаW(ШиринаТекстом, ФрагментW(Текст, Истина, , ОформлениеЯчейки.Размер)));
		КонецЦикла;
		Части.Добавить("</w:tr>");
	КонецЕсли;

	Для Каждого Ячейки Из Строки Цикл
		Части.Добавить("<w:tr>");
		Для НомерКолонки = 1 По Колонок Цикл
			Текст = ?(НомерКолонки <= Ячейки.Количество(), Ячейки[НомерКолонки - 1], "");
			Части.Добавить(ЯчейкаW(ШиринаТекстом,
				ФрагментW(Текст, ОформлениеЯчейки.Жирный, ОформлениеЯчейки.Курсив, ОформлениеЯчейки.Размер)));
		КонецЦикла;
		Части.Добавить("</w:tr>");
	КонецЦикла;

	Части.Добавить("</w:tbl>");
	Док.Тело.Добавить(СтрСоединить(Части, ""));
	// После таблицы обязателен абзац (иначе Word склеивает соседние таблицы и не закрывает документ).
	Док.Тело.Добавить("<w:p/>");

КонецПроцедуры

Функция ЯчейкаW(ШиринаТекстом, Фрагмент)

	Возврат "<w:tc><w:tcPr><w:tcW w:w=""" + ШиринаТекстом + """ w:type=""dxa""/></w:tcPr>"
		+ "<w:p><w:pPr><w:spacing w:after=""0""/></w:pPr>" + ПрогонW(Фрагмент) + "</w:p></w:tc>";

КонецФункции

// Картинка логотипа (w:drawing) высотой 1,5 см с сохранением пропорций.
Функция РисунокЛоготипаW(Док)

	Размеры = РазмерКартинкиВПикселях(Док.Логотип);
	Высота = 540000; // EMU, 1,5 см
	Ширина = Окр(Высота * Размеры.Ширина / Макс(Размеры.Высота, 1));
	Ширина = Мин(Ширина, 5400000); // не шире 15 см
	ВысотаТекстом = Формат(Высота, "ЧГ=0");
	ШиринаТекстом = Формат(Ширина, "ЧГ=0");

	Возврат "<w:r><w:drawing><wp:inline distT=""0"" distB=""0"" distL=""0"" distR=""0"">"
		+ "<wp:extent cx=""" + ШиринаТекстом + """ cy=""" + ВысотаТекстом + """/>"
		+ "<wp:docPr id=""1"" name=""Логотип""/>"
		+ "<a:graphic xmlns:a=""http://schemas.openxmlformats.org/drawingml/2006/main"">"
		+ "<a:graphicData uri=""http://schemas.openxmlformats.org/drawingml/2006/picture"">"
		+ "<pic:pic xmlns:pic=""http://schemas.openxmlformats.org/drawingml/2006/picture"">"
		+ "<pic:nvPicPr><pic:cNvPr id=""1"" name=""logo""/><pic:cNvPicPr/></pic:nvPicPr>"
		+ "<pic:blipFill><a:blip r:embed=""rIdLogo""/><a:stretch><a:fillRect/></a:stretch></pic:blipFill>"
		+ "<pic:spPr><a:xfrm><a:off x=""0"" y=""0""/><a:ext cx=""" + ШиринаТекстом + """ cy=""" + ВысотаТекстом + """/></a:xfrm>"
		+ "<a:prstGeom prst=""rect""><a:avLst/></a:prstGeom></pic:spPr>"
		+ "</pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r>";

КонецФункции

// Размер PNG/JPEG/GIF по заголовку файла; если формат не распознан - 3:1.
Функция РазмерКартинкиВПикселях(Данные)

	Результат = Новый Структура("Ширина, Высота", 300, 100);
	Hex = ВРег(ПолучитьHexСтрокуИзДвоичныхДанных(Данные));
	Попытка
		Если СтрНачинаетсяС(Hex, "89504E47") Тогда
			Результат.Ширина = ЧислоИзHex(Сред(Hex, 33, 8));
			Результат.Высота = ЧислоИзHex(Сред(Hex, 41, 8));
		ИначеЕсли СтрНачинаетсяС(Hex, "47494638") Тогда
			Результат.Ширина = ЧислоИзHex(Сред(Hex, 15, 2) + Сред(Hex, 13, 2));
			Результат.Высота = ЧислоИзHex(Сред(Hex, 19, 2) + Сред(Hex, 17, 2));
		ИначеЕсли СтрНачинаетсяС(Hex, "FFD8") Тогда
			// Маркеры JPEG: FFxx + длина; размеры - в маркере SOF0..SOF3.
			Позиция = 5;
			Пока Позиция < СтрДлина(Hex) - 18 Цикл
				Маркер = Сред(Hex, Позиция, 4);
				Длина = ЧислоИзHex(Сред(Hex, Позиция + 4, 4));
				Если Маркер = "FFC0" Или Маркер = "FFC1" Или Маркер = "FFC2" Или Маркер = "FFC3" Тогда
					Результат.Высота = ЧислоИзHex(Сред(Hex, Позиция + 10, 4));
					Результат.Ширина = ЧислоИзHex(Сред(Hex, Позиция + 14, 4));
					Прервать;
				КонецЕсли;
				Если Лев(Маркер, 2) <> "FF" Или Длина = 0 Тогда
					Прервать;
				КонецЕсли;
				Позиция = Позиция + 4 + Длина * 2;
			КонецЦикла;
		КонецЕсли;
	Исключение
		Результат = Новый Структура("Ширина, Высота", 300, 100);
	КонецПопытки;
	Если Результат.Ширина <= 0 Или Результат.Высота <= 0 Тогда
		Результат = Новый Структура("Ширина, Высота", 300, 100);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЧислоИзHex(Hex)

	Цифры = "0123456789ABCDEF";
	Результат = 0;
	Для Индекс = 1 По СтрДлина(Hex) Цикл
		Результат = Результат * 16 + СтрНайти(Цифры, Сред(Hex, Индекс, 1)) - 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РасширениеКартинки(Данные)

	Base64 = Лев(Base64Строка(Данные), 8);
	Если СтрНачинаетсяС(Base64, "/9j/") Тогда
		Возврат "jpeg";
	ИначеЕсли СтрНачинаетсяС(Base64, "R0lG") Тогда
		Возврат "gif";
	КонецЕсли;
	Возврат "png";

КонецФункции

Функция ПространстваИменW()

	Возврат "xmlns:w=""http://schemas.openxmlformats.org/wordprocessingml/2006/main"""
		+ " xmlns:r=""http://schemas.openxmlformats.org/officeDocument/2006/relationships"""
		+ " xmlns:wp=""http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing""";

КонецФункции

Функция СтилиW(Док)

	Размер = Формат(Док.Размер * 2, "ЧГ=0");
	РазмерНазвания = Формат((Док.Размер + 4) * 2, "ЧГ=0");
	РазмерЗаголовка = Формат((Док.Размер + 1) * 2, "ЧГ=0");
	Шрифт = ТекстXMLW(Док.Шрифт);
	Шрифты = "<w:rFonts w:ascii=""" + Шрифт + """ w:hAnsi=""" + Шрифт + """ w:cs=""" + Шрифт + """ w:eastAsia=""" + Шрифт + """/>";

	Возврат "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>"
		+ "<w:styles xmlns:w=""http://schemas.openxmlformats.org/wordprocessingml/2006/main"">"
		+ "<w:docDefaults><w:rPrDefault><w:rPr>" + Шрифты
		+ "<w:sz w:val=""" + Размер + """/><w:szCs w:val=""" + Размер + """/><w:lang w:val=""ru-RU""/></w:rPr></w:rPrDefault>"
		+ "<w:pPrDefault><w:pPr><w:spacing w:after=""60"" w:line=""240"" w:lineRule=""auto""/></w:pPr></w:pPrDefault></w:docDefaults>"
		+ "<w:style w:type=""paragraph"" w:default=""1"" w:styleId=""Normal""><w:name w:val=""Normal""/><w:qFormat/></w:style>"
		+ "<w:style w:type=""paragraph"" w:styleId=""Title""><w:name w:val=""Title""/><w:basedOn w:val=""Normal""/><w:next w:val=""Normal""/><w:qFormat/>"
		+ "<w:pPr><w:spacing w:before=""120"" w:after=""200""/><w:jc w:val=""center""/></w:pPr>"
		+ "<w:rPr><w:b/><w:sz w:val=""" + РазмерНазвания + """/><w:szCs w:val=""" + РазмерНазвания + """/></w:rPr></w:style>"
		+ "<w:style w:type=""paragraph"" w:styleId=""Heading1""><w:name w:val=""heading 1""/><w:basedOn w:val=""Normal""/><w:next w:val=""Normal""/><w:qFormat/>"
		+ "<w:pPr><w:keepNext/><w:spacing w:before=""200"" w:after=""60""/><w:outlineLvl w:val=""0""/></w:pPr>"
		+ "<w:rPr><w:b/><w:sz w:val=""" + РазмерЗаголовка + """/><w:szCs w:val=""" + РазмерЗаголовка + """/></w:rPr></w:style>"
		+ "</w:styles>";

КонецФункции

// Собирает пакет .docx во временном каталоге и упаковывает его.
Функция СобратьDOCX(Док)

	Каталог = ПолучитьИмяВременногоФайла("");
	Разделитель = ПолучитьРазделительПутиСервера();
	СоздатьКаталог(Каталог);
	СоздатьКаталог(Каталог + Разделитель + "_rels");
	СоздатьКаталог(Каталог + Разделитель + "word");
	СоздатьКаталог(Каталог + Разделитель + "word" + Разделитель + "_rels");

	ЕстьЛоготип = ТипЗнч(Док.Логотип) = Тип("ДвоичныеДанные");
	Расширение = ?(ЕстьЛоготип, РасширениеКартинки(Док.Логотип), "png");
	ТипСвязиКартинки = "http://schemas.openxmlformats.org/officeDocument/2006/relationships/image";
	СвязьКартинки = "<Relationship Id=""rIdLogo"" Type=""" + ТипСвязиКартинки + """ Target=""media/logo." + Расширение + """/>";
	ЗаголовокXML = "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>";

	ИмяВложения = ?(Док.ВложениеMHT, "afchunk.mht", "afchunk.htm");
	ТипыСодержимого = ЗаголовокXML
		+ "<Types xmlns=""http://schemas.openxmlformats.org/package/2006/content-types"">"
		+ "<Default Extension=""rels"" ContentType=""application/vnd.openxmlformats-package.relationships+xml""/>"
		+ "<Default Extension=""xml"" ContentType=""application/xml""/>"
		+ ?(ЕстьЛоготип, "<Default Extension=""" + Расширение + """ ContentType=""image/" + Расширение + """/>", "")
		+ "<Override PartName=""/word/document.xml"" ContentType=""application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml""/>"
		+ "<Override PartName=""/word/styles.xml"" ContentType=""application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml""/>"
		+ ?(ПустаяСтрока(Док.ВложенныйHTML), "", "<Override PartName=""/word/" + ИмяВложения + """ ContentType="""
			+ ?(Док.ВложениеMHT, "message/rfc822", "text/html") + """/>")
		+ "</Types>";
	ЗаписатьФайлW(Каталог, "[Content_Types].xml", ТипыСодержимого);

	ЗаписатьФайлW(Каталог, "_rels" + Разделитель + ".rels", ЗаголовокXML
		+ "<Relationships xmlns=""http://schemas.openxmlformats.org/package/2006/relationships"">"
		+ "<Relationship Id=""rId1"" Type=""http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument"" Target=""word/document.xml""/>"
		+ "</Relationships>");

	СвязиДокумента = "<Relationship Id=""rIdStyles"" Type=""http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles"" Target=""styles.xml""/>";
	Если ЕстьЛоготип Тогда
		КаталогКартинок = Каталог + Разделитель + "word" + Разделитель + "media";
		СоздатьКаталог(КаталогКартинок);
		Док.Логотип.Записать(КаталогКартинок + Разделитель + "logo." + Расширение);
		СвязиДокумента = СвязиДокумента + СвязьКартинки;
	КонецЕсли;
	Если Не ПустаяСтрока(Док.ВложенныйHTML) Тогда
		ЗаписатьФайлW(Каталог, "word" + Разделитель + ИмяВложения, Док.ВложенныйHTML);
		СвязиДокумента = СвязиДокумента + "<Relationship Id=""rIdChunk"" Type=""http://schemas.openxmlformats.org/officeDocument/2006/relationships/aFChunk"" Target=""" + ИмяВложения + """/>";
	КонецЕсли;
	ЗаписатьФайлW(Каталог, "word" + Разделитель + "_rels" + Разделитель + "document.xml.rels", ЗаголовокXML
		+ "<Relationships xmlns=""http://schemas.openxmlformats.org/package/2006/relationships"">" + СвязиДокумента + "</Relationships>");

	ЗаписатьФайлW(Каталог, "word" + Разделитель + "styles.xml", СтилиW(Док));

	// A4, поля: слева 15 мм, справа, сверху и снизу 10 мм.
	ПараметрыРаздела = "<w:sectPr>"
		+ "<w:pgSz w:w=""11906"" w:h=""16838""/>"
		+ "<w:pgMar w:top=""567"" w:right=""567"" w:bottom=""567"" w:left=""850"" w:header=""284"" w:footer=""284"" w:gutter=""0""/>"
		+ "</w:sectPr>";
	ЗаписатьФайлW(Каталог, "word" + Разделитель + "document.xml", ЗаголовокXML
		+ "<w:document " + ПространстваИменW() + "><w:body>"
		+ СтрСоединить(Док.Тело, "") + ПараметрыРаздела + "</w:body></w:document>");

	ИмяФайла = ПолучитьИмяВременногоФайла("docx");
	Попытка
		УправлениеПечатьюСлужебный.СобратьКонтейнерДокументаDOCX(ИмяФайла, Каталог);
		Результат = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		УдалитьФайлы(Каталог);
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(Каталог);
	УдалитьФайлы(ИмяФайла);

	Возврат Результат;

КонецФункции

// Части пакета пишутся в UTF-8 без BOM.
Процедура ЗаписатьФайлW(Каталог, ОтносительноеИмя, Текст)

	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(
		Каталог + ПолучитьРазделительПутиСервера() + ОтносительноеИмя);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

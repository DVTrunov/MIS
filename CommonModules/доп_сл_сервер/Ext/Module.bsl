		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ПараметрыКлиентаЛицензирования.ИдентификаторОсновногоПродукта", СтрЗначение);
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ПараметрыКлиентаЛицензирования.ПоддерживаетсяВыборВерсий", ПоддерживаетсяВыборВерсий);
		Возврат РезультатСоздать(0);
	Исключение
		Возврат РезультатСоздать(3, ОписаниеОшибки());
	КонецПопытки;
КонецФункции
Процедура УстановитьЯзыкКлиентаЛицензирования(КодЯзыка = "ru") Экспорт
	доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ПараметрыКлиентаЛицензирования.ЯзыкКлиентаЛицензирования", КодЯзыка);
КонецПроцедуры
Функция ПолучитьЛицензию(КлючПродукта) Экспорт
	ВремяКешированияУспешногоРезультата = 5;
	ОбъектОбработкиСтруктураУстановитьРеквизит("МожетТребоватьсяИзменениеВерсии", Ложь);
	Если МеханизмОтключен() Тогда
		ОбъектОбработкиСтруктураУстановитьРеквизит("СостояниеАктивации", доп_сл_общий.ПолучитьСтрокуСообщения("Активирован"));
		ОбъектОбработкиСтруктураУстановитьРеквизит("ОсновнаяНадпись", доп_сл_общий.ПолучитьСтрокуСообщения("ВсеОбъектыДоступны"));
		Возврат РезультатСоздать(0);
	КонецЕсли;
	ТребуетсяПереполучитьЛицензию = доп_сл_сервер_ассистент.ЗагрузитьПараметрИзХранилищаПользователя("ТребуетсяПереполучитьЛицензию");
	Если ТребуетсяПереполучитьЛицензию Тогда
		ПоместитьВКеш("LC:" + КлючПродукта, Ложь, ВремяКешированияУспешногоРезультата);
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ТребуетсяПереполучитьЛицензию", Ложь);
	КонецЕсли;
	ЛицензияБылаУспешноПолученаРанее = Ложь;
	Если Не ТребуетсяПереполучитьЛицензию И ПолучитьИзКеша("LC:" + КлючПродукта, ЛицензияБылаУспешноПолученаРанее) И ЛицензияБылаУспешноПолученаРанее Тогда
		Возврат РезультатСоздать(0);
	КонецЕсли;
	Func = tFunctionCreate("svGetLicense");
	AddFuncParam("prod_guid", КлючПродукта, Func.OutputParameters);
	РезультатВыполнения = FunctionExecuteViaAssistant(Func, Истина, Истина, Истина);
	Если НетОшибок(РезультатВыполнения) Тогда
		Если ЭтоСервернаяБаза() Тогда
			СтруктураПараметровСоединения = ПолучитьНастройкиСоединения();
			доп_сл_сервер_ассистент.ЗарегистрироватьСеансВРегистре(GetClHttpSessionId(), СтруктураПараметровСоединения.IP, СтруктураПараметровСоединения.Port, СтруктураПараметровСоединения.ПортАссистентаСервераЛицензий, СтруктураПараметровСоединения.ИспользоватьProxy);
		КонецЕсли;
		ПоместитьВКеш("LC:" + КлючПродукта, Истина, ВремяКешированияУспешногоРезультата);
		ПолучитьВерсиюСервера();
		ОбъектОбработкиСтруктураУстановитьРеквизит("СостояниеАктивации", доп_сл_общий.ПолучитьСтрокуСообщения("Активирован"));
		ОбъектОбработкиСтруктураУстановитьРеквизит("ИнформацияДляТехПоддержки", "");
		ИмяРешения = "";
		Если НетОшибок(ПолучитьИмяРешения(КлючПродукта, ИмяРешения)) Тогда
			ПараметрыСообщения = Новый Соответствие;
			ПараметрыСообщения.Вставить("##1##", ИмяРешения);
			ОбъектОбработкиСтруктураУстановитьРеквизит("ОсновнаяНадпись", доп_сл_общий.ПолучитьСтрокуСообщения("ПолученаЛицензияДля", ПараметрыСообщения));
		Иначе
			ОбъектОбработкиСтруктураУстановитьРеквизит("ОсновнаяНадпись", доп_сл_общий.ПолучитьСтрокуСообщения("ПолученаЛицензияДляВашегоПродукта"));
		КонецЕсли;
	Иначе
		Если РезультатВыполнения.Код <> 1 И РезультатВыполнения.Код <> 14 Тогда
			ПолучитьВерсиюСервера();
		Иначе
			ОбъектОбработкиСтруктураУстановитьРеквизит("ВерсияСервера", "");
		КонецЕсли;
		Если РезультатВыполнения.Код = 8 Тогда
			КлючИзПараметра = доп_сл_сервер_ассистент.ЗагрузитьПараметрИзХранилищаПользователя("ПараметрыКлиентаЛицензирования.ПоддерживаетсяВыборВерсий");
			ОбъектОбработкиСтруктураУстановитьРеквизит("МожетТребоватьсяИзменениеВерсии", КлючИзПараметра = Истина);
		КонецЕсли;
		ОбъектОбработкиСтруктураУстановитьРеквизит("СостояниеАктивации", доп_сл_общий.ПолучитьСтрокуСообщения("НеАктивирован"));
		ОбъектОбработкиСтруктураУстановитьРеквизит("ОсновнаяНадпись", ?(РезультатВыполнения.Комментарий <> "", РезультатВыполнения.Комментарий, РезультатВыполнения.Описание));
		ОбъектОбработкиСтруктураУстановитьРеквизит("ИнформацияДляТехПоддержки", РезультатВыполнения.ИнформацияДляТехПоддержки);
	КонецЕсли;
	Если НетОшибок(РезультатВыполнения) Тогда
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ВыполнятьПоддержкуКлиента", Истина);
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ПоддержкаКлиентаПоследняяОшибка", Неопределено);
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ЧислоОшибокПоддержкиРаботыКлиента", 0);
	КонецЕсли;
	Возврат РезультатВыполнения;
КонецФункции
Функция ПолучитьЛицензиюДляТекущегоПродукта() Экспорт
	КлючИзПараметра = ПолучитьКлючПоУмолчанию();
	Если КлючИзПараметра = "" Тогда
		Результат = РезультатСоздать(15);
		ОбъектОбработкиСтруктураУстановитьРеквизит("ОсновнаяНадпись", Результат.Описание);
		Возврат Результат;
	Иначе
		Возврат ПолучитьЛицензию(КлючИзПараметра);
	КонецЕсли;
КонецФункции
Функция ПолучитьИмяРешения(КлючПродукта, ИмяПродукта) Экспорт
	Если ПолучитьИзКеша(КлючПродукта, ИмяПродукта) Тогда
		Возврат РезультатСоздать(0);
	КонецЕсли;
	Если МеханизмОтключен() Тогда
		ИмяПродукта = "";
		Возврат РезультатСоздать(2);
	КонецЕсли;
	Func = tFunctionCreate("svGetProductNameByGuid");
	AddFuncParam("prod_guid", КлючПродукта, Func.OutputParameters);
	РезультатВыполнения = FunctionExecuteViaAssistant(Func);
	Если Не НетОшибок(РезультатВыполнения) Тогда
		ИмяПродукта = "";
		Возврат РезультатВыполнения;
	КонецЕсли;
	ИмяПродукта = "";
	Если Не GetFuncParam("ProdName", ИмяПродукта, Func.InputParameters) Тогда
		Возврат РезультатСоздать(6, "ProdName");
	КонецЕсли;
	ПоместитьВКеш(КлючПродукта, ИмяПродукта, Неопределено);
	Возврат РезультатСоздать(0);
КонецФункции
Функция ОпределитьДоступностьРешений(СписокКлючейСтрока) Экспорт
	ВремяКешированияУспешногоРезультата = 5;
	Если МеханизмОтключен() Тогда
		ВыходнаяСтрока = "";
		Для нСтр = 1 По СтрЧислоСтрок(СписокКлючейСтрока) Цикл
			ВыходнаяСтрока = ВыходнаяСтрока + СтрПолучитьСтроку(СписокКлючейСтрока, нСтр) + "=True";
			Если нСтр <> СтрЧислоСтрок(СписокКлючейСтрока) Тогда
				ВыходнаяСтрока = ВыходнаяСтрока + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		СписокКлючейСтрока = ВыходнаяСтрока;
		Возврат РезультатСоздать(0, доп_сл_общий.ПолучитьСтрокуСообщения("ВсеОбъектыДоступны"));
	КонецЕсли;
	ПредыдущийЗапрос = "";
	Если ПолучитьИзКеша("PA:Request", ПредыдущийЗапрос) И ПредыдущийЗапрос = СписокКлючейСтрока Тогда
		ХранимоеЗначение = "";
		Если ПолучитьИзКеша("PA:Result", ХранимоеЗначение) Тогда
			СписокКлючейСтрока = ХранимоеЗначение;
			Возврат РезультатСоздать(0);
		КонецЕсли;
	КонецЕсли;
	Func = tFunctionCreate("svCheckProductsAvailabilyty");
	AddFuncParam("prod_guid_list", СписокКлючейСтрока, Func.OutputParameters);
	ПоместитьВКеш("PA:Request", СписокКлючейСтрока, ВремяКешированияУспешногоРезультата);
	РезультатВыполнения = FunctionExecuteViaAssistant(Func);
	Если Не НетОшибок(РезультатВыполнения) Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	Если Не GetFuncParam("prod_guid_list_checked", СписокКлючейСтрока, Func.InputParameters) Тогда
		Возврат РезультатСоздать(6, "prod_guid_list_checked");
	КонецЕсли;
	ПоместитьВКеш("PA:Result", СписокКлючейСтрока, ВремяКешированияУспешногоРезультата);
	Возврат РезультатВыполнения;
КонецФункции
Функция ПолучитьПараметрЛицензии(КлючПродукта, ИмяПараметраЛицензии, ЗначениеПараметра) Экспорт
	Если МеханизмОтключен() Тогда
		ЗначениеПараметра = "";
		ПараметрНайден = Ложь;
		ЛокальныеПараметры = Новый СписокЗначений;
		НаборПараметров = Константы.доп_сл_НаборПараметров.Получить().Получить();
		Для каждого ЭлементЗн Из НаборПараметров Цикл
			Если ЭлементЗн.Представление = "{FE9A8A93-FD2D-4368-AB97-8907F9500DEA}" Тогда
				ЛокальныеПараметры = ЭлементЗн.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Для каждого ЭлементЗн Из ЛокальныеПараметры Цикл
			Если ЭлементЗн.Представление = ИмяПараметраЛицензии Тогда
				ЗначениеПараметра = ЭлементЗн.Значение;
				ПараметрНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПараметрНайден Тогда
			Возврат РезультатСоздать(0);
		Иначе
			Возврат РезультатСоздать(6);
		КонецЕсли;
	КонецЕсли;
	Func = tFunctionCreate("svGetLicenseParameter");
	AddFuncParam("prod_guid", КлючПродукта, Func.OutputParameters);
	AddFuncParam("license_parameter_name", ИмяПараметраЛицензии, Func.OutputParameters);
	РезультатВыполнения = FunctionExecuteViaAssistant(Func);
	Если Не НетОшибок(РезультатВыполнения) Тогда
		ЗначениеПараметра = "";
		Возврат РезультатВыполнения;
	КонецЕсли;
	Если Не GetFuncParam("res_parameter_value", ЗначениеПараметра, Func.InputParameters) Тогда
		ОписаниеОшибки = "";
		Если GetFuncParam("res_text", ОписаниеОшибки, Func.InputParameters) Тогда
			Возврат РезультатСоздать(8, ОписаниеОшибки);
		Иначе
			Возврат РезультатСоздать(6, "res_parameter_value");
		КонецЕсли;
	КонецЕсли;
	Возврат РезультатВыполнения;
КонецФункции
Функция ОжиданиеПереподключения() Экспорт
	ОбъектОбработкиСтруктураУстановитьРеквизит("СостояниеАктивации", доп_сл_общий.ПолучитьСтрокуСообщения("НеАктивирован"));
	ОбъектОбработкиСтруктураУстановитьРеквизит("ОсновнаяНадпись", доп_сл_общий.ПолучитьСтрокуСообщения("ПожалуйстаПодождите"));
КонецФункции
Функция ОтключитьсяОтСервера(ClHttpSessionId = "", ПараметрыСоединения = Неопределено) Экспорт
	Если МеханизмОтключен() Тогда
		Возврат РезультатСоздать(0);
	КонецЕсли;
	СтрокаАдресаДанныхВХ = "e1cib/tempstorage/" + ПараметрыСеанса.доп_сл_БуферЛицензированияВторой;
	Если ЭтоАдресВременногоХранилища(СтрокаАдресаДанныхВХ) Тогда
		УдалитьИзВременногоХранилища(СтрокаАдресаДанныхВХ);
		ПараметрыСеанса.доп_сл_БуферЛицензированияВторой = "";
	КонецЕсли;
	Если ЭтоСервернаяБаза() Тогда
		Func = tFunctionCreate("svHttpVirtualConnectionClose", ClHttpSessionId);
		РезультатВыполнения = FunctionExecuteViaAssistant(Func, , , , ПараметрыСоединения);
		Если ClHttpSessionId = "" Тогда
			ClHttpSessionId = GetClHttpSessionId();
		КонецЕсли;
		доп_сл_сервер_ассистент.УдалитьРегистрациюСеансаИзРегистра(ClHttpSessionId);
	Иначе
		SID = доп_сл_сервер_ассистент.ЗагрузитьПараметрИзХранилищаПользователя("SessionID");
		Если ЗначениеЗаполнено(SID) Тогда
			РезультатПроверкиАктульностиSID = доп_сл_сервер_ассистент.lsaAPI_EchoString("echo", SID);
			Если доп_сл_сервер_ассистент.НетОшибок(РезультатПроверкиАктульностиSID) Тогда
				доп_сл_сервер_ассистент.lsaAPI_DestroySession(SID);
			КонецЕсли;
		КонецЕсли;
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("SessionID", "");
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ВыполнятьПоддержкуКлиента", Ложь);
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ТребуетсяПереполучитьЛицензию", Истина);
		доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("ПоддержкаКлиентаПоследняяОшибка", Неопределено);
		РезультатВыполнения = РезультатСоздать(0);
	КонецЕсли;
	Возврат РезультатВыполнения;
КонецФункции
Функция ПолучитьСтруктуруНастроекСоединения(IP = Неопределено, Port = Неопределено, ПортАссистентаСервераЛицензий = Неопределено, ИспользоватьProxy = Неопределено) Экспорт
	СтруктураНастроекСоединения = Новый Структура;
	СтруктураНастроекСоединения.Вставить("IP", ?(ЗначениеОпределено(IP), IP, ""));
	СтруктураНастроекСоединения.Вставить("Port", ?(ЗначениеОпределено(Port), Port, 0));
	СтруктураНастроекСоединения.Вставить("ПортАссистентаСервераЛицензий", ?(ЗначениеОпределено(ПортАссистентаСервераЛицензий), ПортАссистентаСервераЛицензий, 0));
	СтруктураНастроекСоединения.Вставить("ИспользоватьProxy", ?(ЗначениеОпределено(ИспользоватьProxy), ИспользоватьProxy, Ложь));
	Возврат СтруктураНастроекСоединения;
КонецФункции
Функция ПолучитьНастройкиСоединения() Экспорт
	Результат = ПолучитьСтруктуруНастроекСоединения();
	СтрокаСоединения = "";
	Если ОбъектОбработкиСтруктура().общ_ПубликацияНастроек И Не ПользовательЕстьВСпискеИсключения() Тогда
		СтрокаСоединения = ОбъектОбработкиСтруктура().общ_АдресСервераИПорт;
	Иначе
		СтрокаСоединения = ОбъектОбработкиСтруктура().АдресСервераИПорт;
	КонецЕсли;
	Если ОбъектОбработкиСтруктура().общ_ПубликацияНастроек И Не ПользовательЕстьВСпискеИсключения() Тогда
		Результат.ПортАссистентаСервераЛицензий = ОбъектОбработкиСтруктура().общ_ПортАссистентаСервераЛицензий;
	Иначе
		Результат.ПортАссистентаСервераЛицензий = ОбъектОбработкиСтруктура().ПортАссистентаСервераЛицензий;
	КонецЕсли;
	Если ОбъектОбработкиСтруктура().общ_ПубликацияНастроек И Не ПользовательЕстьВСпискеИсключения() Тогда
		Результат.ИспользоватьProxy = ОбъектОбработкиСтруктура().общ_ИспользоватьProxyСервер;
	Иначе
		Результат.ИспользоватьProxy = ОбъектОбработкиСтруктура().ИспользоватьProxyСервер;
	КонецЕсли;
	ПозицияДвоеточия = Найти(СтрокаСоединения, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.IP = Лев(СтрокаСоединения, ПозицияДвоеточия - 1);
		Результат.Port = Прав(СтрокаСоединения, СтрДлина(СтрокаСоединения) - ПозицияДвоеточия);
		Если СтрДлина(Результат.Port) > 0 Тогда
			Попытка
				Результат.Port = Число(Результат.Port);
			Исключение
				Результат.Port = 10601;
			КонецПопытки;
		КонецЕсли;
	Иначе
		Результат.IP = СтрокаСоединения;
		Результат.Port = 10601;
	КонецЕсли;
	Возврат Результат;
КонецФункции

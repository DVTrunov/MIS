	ОбъектОбработкиСтруктураУстановитьРеквизит("ВерсияСервера", ВерсияСервераСтрока);
	Если МеханизмОтключен() Тогда
		Возврат РезультатСоздать(2);
	КонецЕсли;
	Func = tFunctionCreate("svGetServerVer");
	РезультатВыполнения = FunctionExecuteViaAssistant(Func);
	Если Не НетОшибок(РезультатВыполнения) Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	Если Не GetFuncParam("ServerVer", ВерсияСервераСтрока, Func.InputParameters) Тогда
		Возврат РезультатСоздать(6, "ServerVer");
	КонецЕсли;
	ОбъектОбработкиСтруктураУстановитьРеквизит("ВерсияСервера", ВерсияСервераСтрока);
	Возврат РезультатСоздать(0);

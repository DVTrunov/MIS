Функция ПолучитьМассивСтрок()
	Данные = СформироватьМассивДанных();
	РезультатМассив = Новый Массив;
	ГР1 = Данные[0] * Данные[1] * Данные[2] * Данные[3];
	ГР2 = Данные[4] * Данные[5] * Данные[6] * Данные[7];
	ГР3 = Данные[8] * Данные[9] * Данные[10] * Данные[11];
	ГР4 = Данные[12] + ГР1 + ГР2 + ГР3;
	СтрДелитель = "4";
	Для инт = 1 По СтрДлина(Формат(ГР1, "ЧН=0; ЧГ=0")) - 4 Цикл
		СтрДелитель = СтрДелитель + "0";
	КонецЦикла;
	РезультатМассив.Добавить(Данные[0]);
	РезультатМассив.Добавить(Данные[1]);
	РезультатМассив.Добавить(Данные[2]);
	РезультатМассив.Добавить(Данные[3]);
	РезультатМассив.Добавить(Окр(ГР1 / СтрДелитель, 0));
	СтрДелитель = "4";
	Для инт = 1 По СтрДлина(Формат(ГР2, "ЧН=0; ЧГ=0")) - 4 Цикл
		СтрДелитель = СтрДелитель + "0";
	КонецЦикла;
	РезультатМассив.Добавить(Данные[4]);
	РезультатМассив.Добавить(Данные[5]);
	РезультатМассив.Добавить(Данные[6]);
	РезультатМассив.Добавить(Данные[7]);
	РезультатМассив.Добавить(Окр(ГР2 / СтрДелитель, 0));
	СтрДелитель = "4";
	Для инт = 1 По СтрДлина(Формат(ГР3, "ЧН=0; ЧГ=0")) - 4 Цикл
		СтрДелитель = СтрДелитель + "0";
	КонецЦикла;
	РезультатМассив.Добавить(Данные[8]);
	РезультатМассив.Добавить(Данные[9]);
	РезультатМассив.Добавить(Данные[10]);
	РезультатМассив.Добавить(Данные[11]);
	РезультатМассив.Добавить(Окр(ГР3 / СтрДелитель, 0));
	РезультатМассив.Добавить(ГР4);
	Возврат РезультатМассив;
КонецФункции
Функция ПроверитьДанные(К1, К2, К3, КС = Неопределено)
	МассивДанных = ПолучитьМассивСтрок();
	ВнК1 = (Число(МассивДанных[1]) + Число(МассивДанных[5]) + Число(МассивДанных[10])) * Число(МассивДанных[2]) + Число(МассивДанных[3]);
	ВнК2 = (Число(МассивДанных[5]) + Число(МассивДанных[3]) + Число(МассивДанных[7])) * Число(МассивДанных[9]) + Число(МассивДанных[11]);
	ВнК3 = (Число(МассивДанных[6]) + Число(МассивДанных[5]) + Число(МассивДанных[7])) * Число(МассивДанных[8]) + Число(МассивДанных[1]);
	Если ЗначениеОпределено(КС) Тогда
		Возврат КС = ВнК1 + ВнК2 + ВнК3;
	Иначе
		Возврат К1 + К2 + К3 = ВнК1 + ВнК2 + ВнК3;
	КонецЕсли;
КонецФункции
Функция СформироватьМассивДанных()
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Пока СтрДлина(СтрокаСоединения) < 12 Цикл
		СтрокаСоединения = СтрокаСоединения + СтрокаСоединения;
	КонецЦикла;
	Множитель = Цел(СтрДлина(СтрокаСоединения) / 12);
	Массив = Новый Массив;
	Для Инт = 1 По 12 Цикл
		НомерСимвола = Инт * Множитель;
		КодСимвола = КодСимвола(СтрокаСоединения, НомерСимвола);
		КодСимвола = ?(КодСимвола > 0, КодСимвола, 100);
		Массив.Добавить(КодСимвола);
	КонецЦикла;
	Сумм = 0;
	Для Инт = 1 По СтрДлина(СтрокаСоединения) Цикл
		КодСимвола = КодСимвола(СтрокаСоединения, Инт);
		КодСимвола = ?(КодСимвола > 0, КодСимвола, 100);
		Сумм = Сумм + КодСимвола;
	КонецЦикла;
	Массив.Добавить(Сумм);
	Возврат Массив;
КонецФункции
Функция МеханизмОтключен()
	Результат = Ложь;
	СтрокаПараметраДеактивации = "";
	НаборПараметров = Константы.доп_сл_НаборПараметров.Получить().Получить();
	Если ТипЗнч(НаборПараметров) = Тип("СписокЗначений") Тогда
		Для каждого Параметр Из НаборПараметров Цикл
			Если Параметр.Представление = "{33F7A39A-6078-4F98-AB74-05A2A2758C8C}" Тогда
				СтрокаПараметраДеактивации = Параметр.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат = Ложь;
	Если СтрокаПараметраДеактивации <> "" Тогда
		Если ПроверитьДанные(, , , СтрокаПараметраДеактивации) Тогда
			СтрокаДеактивации = СтрокаПараметраДеактивации;
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции
Функция ПоместитьВКеш(Параметр, Значение, ВремяЖизни = Неопределено)
	ТекущийКеш = Неопределено;
	НеобходимоИнициализироватьКеш = Истина;
	СтрокаАдресаДанныхВХ = "e1cib/tempstorage/" + ПараметрыСеанса.доп_сл_БуферЛицензированияВторой;
	Если ЭтоАдресВременногоХранилища(СтрокаАдресаДанныхВХ) Тогда
		Попытка
			ТекущийКеш = ПолучитьИзВременногоХранилища(СтрокаАдресаДанныхВХ).Получить();
			Если ТипЗнч(ТекущийКеш) = Тип("Массив") Тогда
				НеобходимоИнициализироватьКеш = Ложь;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если НеобходимоИнициализироватьКеш Тогда
		ТекущийКеш = Новый Массив;
	КонецЕсли;
	иПараметр = 0;
	иЗначение = 1;
	иВремяЖизни = 2;
	иВремяЗаписи = 3;
	ПараметрНайден = Неопределено;
	Для каждого ЭлементМассива Из ТекущийКеш Цикл
		Если ЭлементМассива[иПараметр] = Параметр Тогда
			ПараметрНайден = ЭлементМассива;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ПараметрНайден) Тогда
		ПараметрНайден[иЗначение] = Значение;
		ПараметрНайден[иВремяЗаписи] = ТекущаяДата();
	Иначе
		ВременныйМассив = Новый Массив;
		ВременныйМассив.Добавить(Параметр);
		ВременныйМассив.Добавить(Значение);
		ВременныйМассив.Добавить(ВремяЖизни);
		ВременныйМассив.Добавить(ТекущаяДата());
		ТекущийКеш.Добавить(ВременныйМассив);
	КонецЕсли;
	СтрокаАдресаДанныхВХ = ПоместитьВоВременноеХранилище(Новый ХранилищеЗначения(ТекущийКеш), Новый УникальныйИдентификатор);
	ПараметрыСеанса.доп_сл_БуферЛицензированияВторой = Сред(СтрокаАдресаДанныхВХ, 19);
	Возврат Истина;

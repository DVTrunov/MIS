			Продолжить;
		КонецЕсли;
		ОбъектОбработкиСтруктураУстановитьРеквизит(Параметр.Представление, Параметр.Значение);
	КонецЦикла;
	Попытка
		НаборПараметровЛокальный = ХранилищеОбщихНастроек.Загрузить("доп_СистемаЛицензирования_1_6", "ПерсональныеНастройки");
	Исключение
		НаборПараметровЛокальный = Неопределено;
	КонецПопытки;
	Если ТипЗнч(НаборПараметровЛокальный) <> Тип("СписокЗначений") Тогда
		НаборПараметровЛокальный = Новый СписокЗначений;

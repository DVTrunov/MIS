Функция AddFuncParam(Param, Value, ParamList)
	Результат = РезультатСоздать(0);
	ЗначениеНайдено = Ложь;
	Для i = 0 По ParamList.Количество() - 1 Цикл
		Если ВРег(ParamList[i].Parameter) = ВРег(Param) Тогда
			ParamList[i].Value = Value;
			ЗначениеНайдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеНайдено Тогда
		ParamList.Добавить(tFunctionParametersCreate(Param, Value));
	КонецЕсли;
	Возврат Результат;

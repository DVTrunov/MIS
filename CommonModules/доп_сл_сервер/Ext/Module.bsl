Функция ПолучитьИзКеша(Параметр, Значение)
	ТекущийКеш = Неопределено;
	НеобходимоИнициализироватьКеш = Истина;
	СтрокаАдресаДанныхВХ = "e1cib/tempstorage/" + ПараметрыСеанса.доп_сл_БуферЛицензированияВторой;
	Если ЭтоАдресВременногоХранилища(СтрокаАдресаДанныхВХ) Тогда
		Попытка
			ТекущийКеш = ПолучитьИзВременногоХранилища(СтрокаАдресаДанныхВХ).Получить();
			Если ТипЗнч(ТекущийКеш) = Тип("Массив") Тогда
				НеобходимоИнициализироватьКеш = Ложь;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если НеобходимоИнициализироватьКеш Тогда
		Значение = Неопределено;
		Возврат Ложь;
	КонецЕсли;
	иПараметр = 0;
	иЗначение = 1;
	иВремяЖизни = 2;
	иВремяЗаписи = 3;
	ПараметрНайден = Неопределено;
	Для каждого ЭлементМассива Из ТекущийКеш Цикл
		Если ЭлементМассива[иПараметр] = Параметр Тогда
			Если Не ЗначениеОпределено(ЭлементМассива[иВремяЖизни]) Или ЭлементМассива[иВремяЗаписи] + ЭлементМассива[иВремяЖизни] * 60 > ТекущаяДата() Тогда
				ПараметрНайден = ЭлементМассива;
			Иначе
				ТекущийКеш.Удалить(ТекущийКеш.Найти(ЭлементМассива));
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ПараметрНайден) Тогда
		Значение = ПараметрНайден[иЗначение];
		Возврат Истина;
	Иначе
		Значение = Неопределено;
		Возврат Ложь;
	КонецЕсли;
КонецФункции

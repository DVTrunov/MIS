		НаборПараметровЛокальный.Добавить(10602, "ПортАссистентаСервераЛицензий");
		НаборПараметровЛокальный.Добавить(Ложь, "ИспользоватьProxyСервер");
		НаборПараметровЛокальный.Добавить(ПолучитьВерсиюКлиента(), "ВерсияДанныхКлиента");
	КонецЕсли;
	Для каждого Параметр Из НаборПараметровЛокальный Цикл
		Если Параметр.Представление = "ВерсияДанныхКлиента" Тогда
			Продолжить;
		КонецЕсли;
		ОбъектОбработкиСтруктураУстановитьРеквизит(Параметр.Представление, Параметр.Значение);

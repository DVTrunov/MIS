Функция ПолучитьВерсиюПлатформыНаСервере() Экспорт
	СтруктураВерсии = Новый Структура;
	СисИнфо = Новый СистемнаяИнформация;
	ВерсияПлатформы = СисИнфо.ВерсияПриложения;
	МассивВерсий = Новый Массив;
	Курсор = 0;
	ДлинаСтроки = СтрДлина(ВерсияПлатформы);
	Для итератор = 1 По ДлинаСтроки Цикл
		Если Сред(ВерсияПлатформы, итератор, 1) = "." Или итератор = ДлинаСтроки Тогда
			КонецСтроки = итератор = ДлинаСтроки;
			МассивВерсий.Добавить(Сред(ВерсияПлатформы, Курсор + 1, итератор - Курсор - ?(КонецСтроки, 0, 1)));
			Курсор = итератор;
		КонецЕсли;
	КонецЦикла;
	СтруктураВерсии.Вставить("в1", Число(МассивВерсий[0]));
	СтруктураВерсии.Вставить("в2", Число(МассивВерсий[1]));
	СтруктураВерсии.Вставить("в3", Число(МассивВерсий[2]));
	СтруктураВерсии.Вставить("в4", Число(МассивВерсий[3]));
	Возврат СтруктураВерсии;

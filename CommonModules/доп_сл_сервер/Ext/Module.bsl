Процедура ПроверкаИОбновлениеДанныхКлиента_ОбщиеДанные()
	НаборПараметров = Константы.доп_сл_НаборПараметров.Получить().Получить();
	Если ТипЗнч(НаборПараметров) = Тип("Неопределено") Тогда
		Возврат;
	Иначе
		ВерсияДанныхКлиента = СписокЗначенийНайтиПоПредставлению(НаборПараметров, "гл_ВерсияДанныхКлиента");
		ФизическаяВерсияКлиента = ПолучитьВерсиюКлиента();
		ОбновленнаяВерсияКлиента = ВерсияДанныхКлиента;
		ПроизведеноОбновление = Ложь;
	КонецЕсли;
	Если ВерсияДанныхКлиента = Неопределено Тогда
		СписокЗначенийУдалитьПоПредставлению(НаборПараметров, "общ_UDPПорт");
		СтрокаСоединения = СписокЗначенийНайтиПоПредставлению(НаборПараметров, "общ_АдресСервераИПорт");
		Если СтрокаСоединения <> Неопределено Тогда
			ПозицияДвоеточия = Найти(СтрокаСоединения, ":");
			Попытка
				Если ПозицияДвоеточия > 0 Тогда
					IP = Лев(СтрокаСоединения, ПозицияДвоеточия - 1);
					Port = Прав(СтрокаСоединения, СтрДлина(СтрокаСоединения) - ПозицияДвоеточия);
					Port = Формат(Число(Port) + 1, "ЧГ=0");
					СписокЗначенийУдалитьПоПредставлению(НаборПараметров, "общ_АдресСервераИПорт");
					НаборПараметров.Добавить(IP + ":" + Port, "общ_АдресСервераИПорт");
					ПараметрыСообщения = Новый Соответствие;
					ПараметрыСообщения.Вставить("##1##", СтрокаСоединения);
					ПараметрыСообщения.Вставить("##2##", IP);
					ПараметрыСообщения.Вставить("##3##", Port);
					Сообщить(доп_сл_общий.ПолучитьСтрокуСообщения("ОбщаяСтрокаСоединенияОбновлена", ПараметрыСообщения));
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
		ОбновленнаяВерсияКлиента = "1.6.3.2b";
		НаборПараметров.Добавить(ОбновленнаяВерсияКлиента, "гл_ВерсияДанныхКлиента");
		ПроизведеноОбновление = Истина;
	КонецЕсли;
	Если ВерсияДанныхКлиента <> ФизическаяВерсияКлиента И (ОбновленнаяВерсияКлиента = "1.6.3.2.b" Или ОбновленнаяВерсияКлиента = "1.6.3.3" Или ОбновленнаяВерсияКлиента = "1.6.3.4" Или ОбновленнаяВерсияКлиента = "1.6.3.5" Или ОбновленнаяВерсияКлиента = "1.6.4.10" Или ОбновленнаяВерсияКлиента = "1.6.4.12" Или ОбновленнаяВерсияКлиента = "1.6.5.1" Или ОбновленнаяВерсияКлиента = "1.6.5.2" Или ОбновленнаяВерсияКлиента = "1.6.5.3" Или ОбновленнаяВерсияКлиента = "1.6.5.4" Или ОбновленнаяВерсияКлиента = "1.6.5.5" Или ОбновленнаяВерсияКлиента = "1.6.5.6" Или ОбновленнаяВерсияКлиента = "1.6.5.7" Или ОбновленнаяВерсияКлиента = "1.6.5.8" Или ОбновленнаяВерсияКлиента = "1.6.5.9" Или ОбновленнаяВерсияКлиента = "1.6.5.10") Тогда
		СписокЗначенийУдалитьПоПредставлению(НаборПараметров, "общ_ВремяОжиданияДоАктивации");
		НаборПараметров.Добавить(2, "общ_ВремяОжиданияДоАктивации");
		НаборПараметров.Добавить(10602, "общ_ПортАссистентаСервераЛицензий");
		ОбновленнаяВерсияКлиента = "1.6.6.1.b";
		СписокЗначенийУдалитьПоПредставлению(НаборПараметров, "гл_ВерсияДанныхКлиента");
		НаборПараметров.Добавить(ОбновленнаяВерсияКлиента, "гл_ВерсияДанныхКлиента");
		ПроизведеноОбновление = Истина;
	КонецЕсли;
	Если ВерсияДанныхКлиента <> ФизическаяВерсияКлиента И (ОбновленнаяВерсияКлиента = "1.6.6.1.b" Или ОбновленнаяВерсияКлиента = "1.6.6.2.b" Или ОбновленнаяВерсияКлиента = "1.6.6.3" Или ОбновленнаяВерсияКлиента = "1.6.6.4" Или ОбновленнаяВерсияКлиента = "1.6.6.5.b" Или ОбновленнаяВерсияКлиента = "1.6.6.7.b") Тогда
		НаборПараметров.Добавить(Ложь, "общ_ИспользоватьProxyСервер");
		ОбновленнаяВерсияКлиента = "1.6.6.7";
		СписокЗначенийУдалитьПоПредставлению(НаборПараметров, "гл_ВерсияДанныхКлиента");
		НаборПараметров.Добавить(ОбновленнаяВерсияКлиента, "гл_ВерсияДанныхКлиента");
		ПроизведеноОбновление = Истина;
	КонецЕсли;
	Если ВерсияДанныхКлиента <> ФизическаяВерсияКлиента И (ОбновленнаяВерсияКлиента = "1.6.6.7" Или ОбновленнаяВерсияКлиента = "1.6.6.8" Или ОбновленнаяВерсияКлиента = "1.6.6.9" Или ОбновленнаяВерсияКлиента = "1.6.6.10" Или ОбновленнаяВерсияКлиента = "1.6.6.11") Тогда
		доп_сл_сервер_ассистент.НастроитьРегламентноеЗадание();
		ОбновленнаяВерсияКлиента = "1.6.6.12";
		СписокЗначенийУдалитьПоПредставлению(НаборПараметров, "гл_ВерсияДанныхКлиента");
		НаборПараметров.Добавить(ОбновленнаяВерсияКлиента, "гл_ВерсияДанныхКлиента");
		ПроизведеноОбновление = Истина;
	КонецЕсли;
	Если ОбновленнаяВерсияКлиента <> ФизическаяВерсияКлиента Тогда
		ОбновленнаяВерсияКлиента = ФизическаяВерсияКлиента;
		СписокЗначенийУдалитьПоПредставлению(НаборПараметров, "гл_ВерсияДанныхКлиента");
		НаборПараметров.Добавить(ОбновленнаяВерсияКлиента, "гл_ВерсияДанныхКлиента");
		ПроизведеноОбновление = Истина;
	КонецЕсли;
	Если ПроизведеноОбновление Тогда
		ХранилищеЗН = Новый ХранилищеЗначения(НаборПараметров);
		Константы.доп_сл_НаборПараметров.Установить(ХранилищеЗН);
		ПараметрыСообщения = Новый Соответствие;
		ПараметрыСообщения.Вставить("##1##", ?(ВерсияДанныхКлиента = Неопределено, "1.6.2.х", ВерсияДанныхКлиента));
		ПараметрыСообщения.Вставить("##2##", ОбновленнаяВерсияКлиента);
		Сообщить(доп_сл_общий.ПолучитьСтрокуСообщения("ПроизведеноОбновлениеКлиента", ПараметрыСообщения));
	КонецЕсли;
КонецПроцедуры

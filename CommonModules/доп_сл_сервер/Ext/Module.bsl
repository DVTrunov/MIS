		Сообщить(доп_сл_общий.ПолучитьСтрокуСообщения("НеПравильныйТипВходящегоОбъекта"));
		Возврат Ложь;
	КонецЕсли;
	Класс = ОбъектРезультат.ИмяКласса;
	Если Не ЗначениеОпределено(Класс) Или Класс <> "tОбъектРезультат" Тогда
		Сообщить(доп_сл_общий.ПолучитьСтрокуСообщения("ОшибкаПриВыводеСообщенияОбОшибке"));
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбъектРезультат.Код = 0;

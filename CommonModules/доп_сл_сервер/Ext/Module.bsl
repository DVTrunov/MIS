Процедура AddAuthData(Func, ClHttpSessionId = "")
	Version = ПолучитьВерсиюКлиента();
	UserName = ?(ИмяПользователя() <> "", ИмяПользователя() + " (1С)", "(1С)");
	Password = "";
	HttpSessionId = ?(ClHttpSessionId = "", GetClHttpSessionId(), ClHttpSessionId);
	ЗапрещенныеСимволы = "&";
	UserName_ = "";
	Для итератор = 1 По СтрДлина(UserName) Цикл
		ТекСимвол = Сред(UserName, итератор, 1);
		Если Найти(ЗапрещенныеСимволы, ТекСимвол) = 0 Тогда
			UserName_ = UserName_ + ТекСимвол;
		КонецЕсли;
	КонецЦикла;
	UserName = UserName_;
	AddFuncParam("@ClVersion", Version, Func.OutputParameters);
	AddFuncParam("@ClUserName", UserName, Func.OutputParameters);
	AddFuncParam("@ClPassword", Password, Func.OutputParameters);
	AddFuncParam("@ClHttpSessionId", HttpSessionId, Func.OutputParameters);
КонецПроцедуры

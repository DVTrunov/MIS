КонецФункции
Функция DecToHex(DecNumber, Digits)
	stringHex = "";
	arrHex = Новый Array;
	arrHex.Add("0");
	arrHex.Add("1");
	arrHex.Add("2");
	arrHex.Add("3");
	arrHex.Add("4");
	arrHex.Add("5");
	arrHex.Add("6");
	arrHex.Add("7");
	arrHex.Add("8");
	arrHex.Add("9");
	arrHex.Add("A");
	arrHex.Add("B");
	arrHex.Add("C");
	arrHex.Add("D");
	arrHex.Add("E");
	arrHex.Add("F");
	Если DecNumber = 0 Тогда
		stringHex = stringHex + "0";
	Иначе
		i = 0;
		tempNumber = DecNumber;
		rem = tempNumber % 16;
		Если rem = 0 Тогда
			newStr = DecToHex(Цел(tempNumber / 16), 0);
			stringHex = newStr + "0" + stringHex;
			tempNumber = 0;
		Иначе
			stringHex = arrHex[rem] + stringHex;
			tempNumber = tempNumber - rem * Pow(16, i);
			Если tempNumber > 0 Тогда
				newStr = DecToHex(Цел(tempNumber / 16), 0);
				stringHex = newStr + stringHex;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Delta = Digits - СтрДлина(stringHex);
	Если Delta > 0 Тогда
		Для i = 1 По Delta Цикл
			stringHex = "0" + stringHex;
		КонецЦикла;
	КонецЕсли;
	Возврат stringHex;
КонецФункции
Функция CodeStringHttp(fStream)
	Час = Число(Формат(ТекущаяДата(), "ДФ=Ч"));
	Минута = Число(Формат(ТекущаяДата(), "ДФ=м"));
	Секунда = Число(Формат(ТекущаяДата(), "ДФ=с"));
	Час = ?(Час > 0, Час, 1);
	РандомноеЧисло = (Час * Минута + Час * Секунда) * ?(Час > 20, Час - 8, Час);
	Если РандомноеЧисло > 25000 Тогда
		РандомноеЧисло = РандомноеЧисло - 25000;
	КонецЕсли;
	КонтрольнаяСумма = 0;
	ShiftByte = 100 + РандомноеЧисло;
	fCodedStream = "";
	Для Итератор = 1 По СтрДлина(fStream) Цикл
		buffer = КодСимвола(Сред(fStream, Итератор, 1), 1);
		КонтрольнаяСумма = КонтрольнаяСумма + buffer * Итератор;
		Если КонтрольнаяСумма > 9000000000000000000 Тогда
			КонтрольнаяСумма = Цел(КонтрольнаяСумма / 2);
		КонецЕсли;
		b = buffer + ShiftByte;
		Если b > 55000 Тогда
			buffer = b - 55000;
		Иначе
			buffer = b;
		КонецЕсли;
		fCodedStream = fCodedStream + Символ(buffer);
	КонецЦикла;
	fCodedStream = fCodedStream + Символ(ShiftByte);
	Hash = DecToHex(КонтрольнаяСумма, 16);
	fCodedStream = fCodedStream + Hash;
	fStream = fCodedStream;
	Возврат РезультатСоздать(0);
КонецФункции
Функция DeCodeStringHttp(fCodedStream)
	Result = РезультатСоздать(0);
	КонтрольнаяСумма = 0;
	Если СтрДлина(fCodedStream) < 18 Тогда
		Result = РезультатСоздать(13, доп_сл_общий.ПолучитьСтрокуСообщения("РазмерПакетаНеСоотвТребованиям"));
	КонецЕсли;
	Если НетОшибок(Result) Тогда
		Hash = Прав(fCodedStream, 16);
		fCodedStream = Лев(fCodedStream, СтрДлина(fCodedStream) - 16);
		Если НетОшибок(Result) Тогда
			ShiftByte = КодСимвола(Прав(fCodedStream, 1), 1);
			fCodedStream = Лев(fCodedStream, СтрДлина(fCodedStream) - 1);
			fStream = "";
			Для н = 1 По СтрДлина(fCodedStream) Цикл
				buffer = КодСимвола(Сред(fCodedStream, н, 1), 1);
				b = buffer - ShiftByte;
				Если b < 0 Тогда
					buffer = b + 55000;
				Иначе
					buffer = b;
				КонецЕсли;
				КонтрольнаяСумма = КонтрольнаяСумма + buffer * н;
				Если КонтрольнаяСумма > 9000000000000000000 Тогда
					КонтрольнаяСумма = Цел(КонтрольнаяСумма / 2);
				КонецЕсли;
				fStream = fStream + Символ(buffer);
			КонецЦикла;
			HashReal = DecToHex(КонтрольнаяСумма, 16);
			Если Hash <> HashReal Тогда
				Result = РезультатСоздать(13, доп_сл_общий.ПолучитьСтрокуСообщения("ДанныеПакетаПовреждены") + " (SB:" + Формат(ShiftByte, "ЧН=0; ЧГ=0") + ")");
			Иначе
				fCodedStream = fStream;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Result;
КонецФункции

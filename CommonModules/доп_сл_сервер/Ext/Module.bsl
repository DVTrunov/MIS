Функция MakeOutputCommandStrV2(Func)
	Заголовок = "<?xml version=""1.0"" encoding=""utf-8""?>" + Символы.ПС + "<CustomFile>";
	Подвал = Символы.ПС + "</CustomFile>";
	Тело = "<pv><p>@CommandName</p><v>" + Func.CommandName + "</v></pv>";
	Тело = Тело + Символы.ПС + "<pv><p>@ResponseText</p><v>" + Func.ResponseText + "</v></pv>";
	Для каждого Параметр Из Func.OutputParameters Цикл
		Тело = Тело + Символы.ПС + "<pv><p>" + Параметр.Parameter + "</p><v>" + Параметр.Value + "</v></pv>";
	КонецЦикла;
	Func.OutputCommandStr = Заголовок + Тело + Подвал;
	РезультатКодирования = CodeStringHttp(Func.OutputCommandStr);
	Возврат РезультатКодирования;
КонецФункции
Функция ParseInputCommandStrV2(Func)
	Func.InputParameters.Очистить();
	РезультатДекодирования = DeCodeStringHttp(Func.InputCommandStr);
	Если Не НетОшибок(РезультатДекодирования) Тогда
		Возврат РезультатДекодирования;
	КонецЕсли;
	хмл = Новый ЧтениеXML;
	хмл.УстановитьСтроку(Func.InputCommandStr);
	хмл.Прочитать();
	ТипСодержимого = хмл.Имя;
	Если ВРег(ТипСодержимого) <> ВРег("CustomFile") Тогда
		Возврат РезультатСоздать(7);
	КонецЕсли;
	БлокПараметраЗначения = Ложь;
	БлокПараметра = Ложь;
	БлокЗначения = Ложь;
	Параметр = "";
	Значение = "";
	ЗначениеДобавлено = Ложь;
	Пока хмл.Прочитать() Цикл
		Если хмл.Имя = "pv" Тогда
			Если хмл.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				БлокПараметраЗначения = Истина;
			ИначеЕсли хмл.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				БлокПараметраЗначения = Ложь;
			КонецЕсли;
			БлокПараметра = Ложь;
			БлокЗначения = Ложь;
			Параметр = "";
			Значение = "";
			Продолжить;
		ИначеЕсли хмл.Имя = "p" Тогда
			Если хмл.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				БлокПараметра = Истина;
			ИначеЕсли хмл.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				БлокПараметра = Ложь;
			КонецЕсли;
			БлокЗначения = Ложь;
			Продолжить;
		ИначеЕсли хмл.Имя = "v" Тогда
			Если хмл.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				БлокЗначения = Истина;
				ЗначениеДобавлено = Ложь;
			ИначеЕсли хмл.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				БлокЗначения = Ложь;
				Если Не ЗначениеДобавлено Тогда
					AddFuncParam(Параметр, "", Func.InputParameters);
				КонецЕсли;
				ЗначениеДобавлено = Ложь;
			КонецЕсли;
			БлокПараметра = Ложь;
			Продолжить;
		КонецЕсли;
		Если БлокПараметраЗначения Тогда
			Если БлокПараметра Тогда
				Параметр = хмл.Значение;
				Продолжить;
			ИначеЕсли БлокЗначения Тогда
				Значение = хмл.Значение;
				AddFuncParam(Параметр, Значение, Func.InputParameters);
				ЗначениеДобавлено = Истина;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	РезультатВыполненияФункции = "";
	Если Не GetFuncParam("Result", РезультатВыполненияФункции, Func.InputParameters) Тогда
		ОшибкаПротокола = "";
		Если GetFuncParam("ProtocolError", ОшибкаПротокола, Func.InputParameters) Тогда
			Возврат РезультатСоздать(12, ОшибкаПротокола);
		Иначе
			Возврат РезультатСоздать(9);
		КонецЕсли;
	Иначе
		Если РезультатВыполненияФункции = "1" Тогда
			Возврат РезультатСоздать(0);
		Иначе
			ОписаниеОшибки = "";
			Если GetFuncParam("Error", ОписаниеОшибки, Func.InputParameters) И ОписаниеОшибки <> "" Тогда
				Если Лев(ОписаниеОшибки, 46) = "На сервере лицензий не зарегистрирован продукт" Тогда
					ПараметрыСообщения = Новый Соответствие;
					ПараметрыСообщения.Вставить("##1##", Прав(ОписаниеОшибки, СтрДлина(ОписаниеОшибки) - 47));
					ОписаниеОшибки = доп_сл_общий.ПолучитьСтрокуСообщения("НаСервереЛицензийНеЗарегистрированПродукт", ПараметрыСообщения);
				КонецЕсли;
				Возврат РезультатСоздать(8, ОписаниеОшибки);
			Иначе
				Возврат РезультатСоздать(8);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецФункции
Функция FunctionExecuteViaAssistant(Func, PassThruVirtualConnectionID = Ложь, СохранитьLsaApiИдСеанса = Ложь, АктуализироватьLsaApiИдСеансаПередОтправкой = Ложь, ПараметрыСоединения = Неопределено)
	ВерсияМодуля = ПолучитьВерсиюКлиента();
	ВерсияОбработки = Обработки.доп_сл_КлиентЛицензирования.ПолучитьМакет(Метаданные.Обработки.доп_сл_КлиентЛицензирования.Макеты.ls_версия_обработки).ПолучитьТекст();
	Если ВерсияОбработки <> ВерсияМодуля Тогда
		Возврат РезультатСоздать(10);
	КонецЕсли;
	SID = "";
	КлючИсходящегоПакета = СоздатьGUID(Истина, Ложь, Истина);
	Func.ResponseText = КлючИсходящегоПакета;
	Результат = MakeOutputCommandStrV2(Func);
	Если Не НетОшибок(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	НастройкиСоединения = ?(ЗначениеОпределено(ПараметрыСоединения), ПараметрыСоединения, ПолучитьНастройкиСоединения());
	Попытка
		ClHttpSessionId = "";
		Если PassThruVirtualConnectionID Тогда
			ClHttpSessionId = GetClHttpSessionId();
		КонецЕсли;
		Если АктуализироватьLsaApiИдСеансаПередОтправкой Тогда
			SID = доп_сл_сервер_ассистент.ЗагрузитьПараметрИзХранилищаПользователя("SessionID");
			Если ЗначениеЗаполнено(SID) Тогда
				РезультатАктуализации = доп_сл_сервер_ассистент.lsaAPI_EchoString("echo", SID);
				Если Не доп_сл_сервер_ассистент.НетОшибок(РезультатАктуализации) Тогда
					SID = "";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если PassThruVirtualConnectionID И ЭтоСервернаяБаза() Тогда
			AutoReleaseLicense = Ложь;
		Иначе
			AutoReleaseLicense = Истина;
		КонецЕсли;
		РезультатАссистента = доп_сл_сервер_ассистент.lsaAPI_SlCallLicenseServerMethod(НастройкиСоединения.Port, Func.OutputCommandStr, ClHttpSessionId, SID, AutoReleaseLicense);
		Если доп_сл_сервер_ассистент.НетОшибок(РезультатАссистента) Тогда
			Func.InputCommandStr = РезультатАссистента.fields.MethodResult.fields.CodedString;
			Если СохранитьLsaApiИдСеанса Тогда
				доп_сл_сервер_ассистент.ЗаписатьПараметрВХранилищеПользователя("SessionID", РезультатАссистента.fields.MethodResult.fields.SessionID);
			КонецЕсли;
		Иначе
			Результат = РезультатСоздать(14);
			Результат.Комментарий = Результат.Описание + Символы.ПС + доп_сл_общий.ПолучитьСтрокуСообщения("ПоПричине") + РезультатАссистента.fields.Description + " (" + Формат(РезультатАссистента.fields.Code, "ЧН=0; ЧГ=0") + ")";
			Результат.ИнформацияДляТехПоддержки = РезультатАссистента.fields.Comment;
			Результат.ВремяВызоваИз1с = РезультатАссистента.fields.ExecutionTimeFrom1c;
			Результат.ВремяВызоваИз1сТолькоHttpВызов = РезультатАссистента.fields.ExecutionTimeFrom1cHttpOnly;
			Если Результат.ИнформацияДляТехПоддержки <> "" Тогда
				ПозицияОбщейЧасти = Найти(Результат.ИнформацияДляТехПоддержки, "}:");
				Если ПозицияОбщейЧасти <> 0 Тогда
					Результат.ИнформацияДляТехПоддержки = Прав(Результат.ИнформацияДляТехПоддержки, СтрДлина(Результат.ИнформацияДляТехПоддержки) - ПозицияОбщейЧасти - 2);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат = РезультатСоздать(5, ОписаниеОшибки());
	КонецПопытки;
	Если НетОшибок(Результат) Тогда
		Результат = ParseInputCommandStrV2(Func);
		Если НетОшибок(Результат) И КлючИсходящегоПакета <> Func.ResponseText Тогда
			Результат = РезультатСоздать(11);
		КонецЕсли;
		Результат.ВремяВызоваИз1с = РезультатАссистента.fields.ExecutionTimeFrom1c;
		Результат.ВремяВызоваИз1сТолькоHttpВызов = РезультатАссистента.fields.ExecutionTimeFrom1cHttpOnly;
	КонецЕсли;
	Возврат Результат;
КонецФункции
Функция ПоддержкаКода(В1, В2 = Неопределено, В3 = Неопределено, В4 = Неопределено) Экспорт
	Если Не ПлатформаНеНиже(В1, В2, В3, В4) Тогда
		Возврат Ложь;
	Иначе
		Если ПлатформаНеНиже(8, 2, 14) И Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_2_13 Тогда
			Возврат ПлатформаНеНиже(В1, В2, В3, В4, Новый Структура("в1,в2,в3,в4", 8, 2, 13, 219));
		КонецЕсли;
		Если ПлатформаНеНиже(8, 3) И Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_2_16 Тогда
			Возврат ПлатформаНеНиже(В1, В2, В3, В4, Новый Структура("в1,в2,в3,в4", 8, 2, 16, 368));
		КонецЕсли;
		Если ПлатформаНеНиже(8, 3, 2) И Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_1 Тогда

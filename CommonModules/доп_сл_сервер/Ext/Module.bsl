		СписокЗначенийУдалитьПоПредставлению(НаборПараметров, "ФильтроватьСписок");
		СтрокаСоединения = СписокЗначенийНайтиПоПредставлению(НаборПараметров, "АдресСервераИПорт");
		Если ЗначениеОпределено(СтрокаСоединения) Тогда
			ПозицияДвоеточия = Найти(СтрокаСоединения, ":");
			Попытка
				Если ПозицияДвоеточия > 0 Тогда
					IP = Лев(СтрокаСоединения, ПозицияДвоеточия - 1);
					Port = Прав(СтрокаСоединения, СтрДлина(СтрокаСоединения) - ПозицияДвоеточия);
					Port = Формат(Число(Port) + 1, "ЧН=0; ЧГ=0");

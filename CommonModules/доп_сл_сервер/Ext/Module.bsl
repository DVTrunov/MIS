Функция РезультатСоздать(Код = -1, Комментарий = "", ИнформацияДляТехПоддержки = "")
	Результат = Новый Структура;
	Результат.Вставить("ИмяКласса", "tОбъектРезультат");
	Результат.Вставить("Код", Код);
	КодСтрока = "ОписаниеКодаРезультата_" + Формат(Код, "ЧГ=0;ЧН=0");
	СтрокаОписания = доп_сл_общий.ПолучитьСтрокуСообщения(КодСтрока);
	Результат.Вставить("Описание", СтрокаОписания);
	Результат.Вставить("Комментарий", Комментарий);
	Результат.Вставить("ИнформацияДляТехПоддержки", ИнформацияДляТехПоддержки);
	Результат.Вставить("ВремяВызоваИз1с", - 1);
	Результат.Вставить("ВремяВызоваИз1сТолькоHttpВызов", - 1);
	Возврат Результат;
КонецФункции
Функция СписокЗначенийНайтиПоПредставлению(СписокЗначений, Представление)
	Результат = Неопределено;
	Для каждого Элемент Из СписокЗначений Цикл
		Если Элемент.Представление = Представление Тогда
			Результат = Элемент.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
Функция СписокЗначенийУдалитьПоПредставлению(СписокЗначений, Представление)
	Результат = Ложь;
	Для каждого Элемент Из СписокЗначений Цикл
		Если Элемент.Представление = Представление Тогда
			СписокЗначений.Удалить(СписокЗначений.Индекс(Элемент));
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
Функция ПлатформаНеНиже(В1, В2 = Неопределено, В3 = Неопределено, В4 = Неопределено, ТекущаяВерсияПлатформыСтруктура = Неопределено)
	Если ЗначениеОпределено(ТекущаяВерсияПлатформыСтруктура) Тогда

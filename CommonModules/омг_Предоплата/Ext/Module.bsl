				СоединениеHTTP = Новый HTTPСоединение("api.tiptoppay.kz",,Логин,Пароль,,,Новый ЗащищенноеСоединениеOpenSSL(),);
				ЗаголовокЗапросаHTTP = Новый Соответствие();
				ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
				ЗапросHTTP = Новый HTTPЗапрос("/payments/refund",ЗаголовокЗапросаHTTP); 
				
				СтрукnураОтправки = Новый Структура("TransactionId,Amount",ВыборкаДетальныеЗаписи.TransactionId,ВыборкаДетальныеЗаписи.Сумма);
				
				ЗаписьJSON = Новый ЗаписьJSON;               
				ЗаписьJSON.УстановитьСтроку();
				ЗаписатьJSON(ЗаписьJSON, СтрукnураОтправки);

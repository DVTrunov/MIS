#Область ПрограммныйИнтерфейс

// Возвращает статус последней предоплаты по документу.
//
// Параметры:
//  Документ - ДокументСсылка.Заявка, ДокументСсылка.ОплатаПлатежнойКартой, ДокументСсылка.ПриходныйКассовыйОрдер
//
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса с полями Статус, Ссылка, ПлатежныйДокумент, либо Неопределено, если записи нет.
//
Функция ВернутьСтатусОплаты(Документ) Экспорт
	
	ВозврЗнач = Неопределено;
	ТипДокумента = "";
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.Заявка") Тогда
		ТипДокумента = Символы.ПС + " омг_Предоплаты.Заявка = &Документ" + Символы.ПС
	Иначе
		ТипДокумента = Символы.ПС + " омг_Предоплаты.ПлатежныйДокумент = &Документ" + Символы.ПС
	КонецЕсли;   
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	омг_Предоплаты.Статус КАК Статус,
	|	омг_Предоплаты.Ссылка КАК Ссылка,
	|	омг_Предоплаты.ПлатежныйДокумент КАК ПлатежныйДокумент
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|
	|ГДЕ " + ТипДокумента+ 
	"
	|УПОРЯДОЧИТЬ ПО
	|	омг_Предоплаты.РегистраторЗаписи.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ВозврЗнач = ВыборкаДетальныеЗаписи;
	КонецЕсли;
	
	Возврат ВозврЗнач;
	
КонецФункции	

// Регистрирует принятие предоплаты при проведении документа оплаты (наличные/касса).
Процедура омг_ПринятьПредоплату(Источник, ИсточникОснование = Неопределено) Экспорт   
	
	ИсточникОБъект = Источник.Ссылка.ПолучитьОбъект();
	
	Если Не ИсточникОБъект.ПометкаУдаления И ИсточникОБъект.омг_ВидОплаты = Перечисления.омг_ВидыОплаты.Предоплата Тогда   
		
		Если ПолучитьСтатусПредоплаты(ИсточникОБъект.Ссылка) = Неопределено Тогда
			
			ГУиД = СокрЛП(ИсточникОБъект.Ссылка.УникальныйИдентификатор());  
			СсылкаНаОплату = "Оплата принята через кассу";
			Менеджер = РегистрыСведений.омг_Предоплаты.СоздатьМенеджерЗаписи();
			Менеджер.РегистраторЗаписи = ИсточникОБъект.Ссылка;
			Менеджер.Заявка = ИсточникОБъект.ДокументОснование.Ссылка;		
			Менеджер.Сумма = ИсточникОБъект.СуммаДокумента; 
			Менеджер.ПлатежныйДокумент = ИсточникОБъект.Ссылка; 
			Менеджер.InvoiceId = ГУиД;
			ЗаявкаОбъект = ИсточникОБъект.ДокументОснование.Ссылка.ПолучитьОбъект();
			
			Если ТипЗнч(ИсточникОБъект) = Тип("ДокументОбъект.ОплатаПлатежнойКартой") Тогда   
				Организация = омг_ДополнительныеАлгоритмы.омг_ВернутьОрганизациюПоФилиалу(ИсточникОБъект.Филиал);
				ИНН = омг_ДополнительныеАлгоритмы.омг_ВернутьИНН(Организация);
				РезультатСоздания = ПолучитьСсылкаНаПредоплату(ИсточникОБъект.СуммаДокумента, ГУиД, Организация, ИНН);
				СсылкаНаОплату = РезультатСоздания.Ссылка;
				Менеджер.OrderId = РезультатСоздания.OrderId;
				Менеджер.ДатаСоздания = ТекущаяДата();
				Менеджер.Статус = Перечисления.омг_СтатусыПредоплаты.ОжиданиеОплаты;
			иначе
				Менеджер.Статус = Перечисления.омг_СтатусыПредоплаты.ОплатаПринята;
				Менеджер.ОплатаПринятаБыла = Истина;
				Если Не ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована Тогда
					ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована;
					ЗаявкаОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
			
			Менеджер.Ссылка = СсылкаНаОплату;
			Менеджер.Записать();
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры  

// Возвращает первую найденную запись предоплаты по Заявке или платежному документу.
Функция ПолучитьСтатусПредоплаты(Источник) Экспорт
	
	ВозЗначение = Неопределено;
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Источник) = Тип("ДокументСсылка.Заявка") Тогда
		Условия = " омг_Предоплаты.Заявка = &Заявка "; 
		Запрос.УстановитьПараметр("Заявка", Источник); 
	Иначе
		Условия = " омг_Предоплаты.ПлатежныйДокумент = &ПлатежныйДокумент ";
		Запрос.УстановитьПараметр("ПлатежныйДокумент", Источник); 
	КонецЕсли;	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	омг_Предоплаты.Заявка КАК Заявка,
	|	омг_Предоплаты.Сумма КАК Сумма,
	|	омг_Предоплаты.Статус КАК Статус,
	|	омг_Предоплаты.ПлатежныйДокумент КАК ПлатежныйДокумент,
	|	омг_Предоплаты.InvoiceId КАК InvoiceId
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|ГДЕ" + Условия;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ВозЗначение = ВыборкаДетальныеЗаписи
	КонецЕсли;
	
	Возврат ВозЗначение;
	
КонецФункции  

// Создает заказ (ссылку на оплату) в TipTop Pay. Данные для формирования
// онлайн-чека передаются сразу в теле запроса - система сама сформирует
// и отправит чек прихода асинхронно в момент успешной оплаты по ссылке.
//
// Параметры:
//  Сумма, ГУИД (InvoiceId), Организация, ИНН
//
// Возвращаемое значение:
//  Строка - ссылка на оплату, либо "" при ошибке
//
Функция ПолучитьСсылкаНаПредоплату(Сумма, ГУИД, Организация, ИНН) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура("Ссылка, OrderId", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	омг_НастройкиTipTop.Логин КАК Логин,
	|	омг_НастройкиTipTop.Пароль КАК Пароль
	|ИЗ
	|	РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|ГДЕ
	|	омг_НастройкиTipTop.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Логин = ВыборкаДетальныеЗаписи.Логин;
		Пароль = ВыборкаДетальныеЗаписи.Пароль;
		
		Попытка
			
			СоединениеHTTP = Новый HTTPСоединение("api.tiptoppay.kz",,Логин,Пароль,,,Новый ЗащищенноеСоединениеOpenSSL(),);
			
			СтрокаТовара = Новый Структура;
			СтрокаТовара.Вставить("Label", "Бронирование времени врача");
			СтрокаТовара.Вставить("Price", Сумма);
			СтрокаТовара.Вставить("Quantity", 1);
			СтрокаТовара.Вставить("Amount", Сумма);
			СтрокаТовара.Вставить("Vat", Неопределено);
			СтрокаТовара.Вставить("MeasurementUnit", "усл.");
			
			Items = Новый Массив;
			Items.Добавить(СтрокаТовара);
			
			CustomerReceipt = Новый Структура;
			CustomerReceipt.Вставить("Items", Items);
			CustomerReceipt.Вставить("Amounts", Новый Структура("Electronic", Сумма));
			CustomerReceipt.Вставить("IsBso", Ложь);
			
			PaymentData = Новый Структура("CustomerReceipt", CustomerReceipt);
			
			СтруктураОтправки = Новый Структура("Amount,Currency,Description,RequireConfirmation,SendEmail,InvoiceId,JsonData",
				Сумма, "KZT", "Бронирование времени врача", Ложь, Ложь, ГУИД, Новый Структура("PaymentData", PaymentData));
			
			ЗаписьJSON = Новый ЗаписьJSON;               
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
			СтрокаДляТела = ЗаписьJSON.Закрыть();
			
			ЗаголовокЗапросаHTTP = Новый Соответствие();
			ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
			ЗаголовокЗапросаHTTP.Вставить("X-Request-ID", ГУИД);
			
			ЗапросHTTP = Новый HTTPЗапрос("/orders/create", ЗаголовокЗапросаHTTP); 
			ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаДляТела);
			Ответ = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
			
			Если Ответ.КодСостояния = 200 Тогда
				
				Сообщение = Ответ.ПолучитьТелоКакСтроку("UTF-8");
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(Сообщение);
				ДанныеВозврата = ПрочитатьJSON(ЧтениеJSON);
				ЧтениеJSON.Закрыть();
				
				Если ТипЗнч(ДанныеВозврата) = Тип("Структура") И ДанныеВозврата.Свойство("Success") И ДанныеВозврата.Success Тогда
					Результат.Ссылка = ДанныеВозврата.Model.Url;
					Результат.OrderId = ДанныеВозврата.Model.Id;
				Иначе
					ЗаписьЖурналаРегистрации("омг_Предоплата.ПолучитьСсылкаНаПредоплату", УровеньЖурналаРегистрации.Ошибка,,,
						"ГУИД=" + ГУИД + "; Ответ: " + Сообщение);
				КонецЕсли;
				
			Иначе
				ЗаписьЖурналаРегистрации("омг_Предоплата.ПолучитьСсылкаНаПредоплату", УровеньЖурналаРегистрации.Ошибка,,,
					"ГУИД=" + ГУИД + "; HTTP " + Ответ.КодСостояния);
			КонецЕсли; 
			
		Исключение
			ЗаписьЖурналаРегистрации("омг_Предоплата.ПолучитьСсылкаНаПредоплату", УровеньЖурналаРегистрации.Ошибка,,,
				"ГУИД=" + ГУИД + "; " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции    

// Регламентное задание: страховочный опрос статуса предоплат в ожидании
// оплаты на случай недоставки Pay/Fail-вебхука.
Процедура омг_ОбновитьСтатусыПредоплат() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);       
		 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	омг_Предоплаты.Заявка КАК Заявка,
	|	омг_Предоплаты.ПлатежныйДокумент КАК ПлатежныйДокумент,
	|	омг_Предоплаты.InvoiceId КАК InvoiceId,
	|	омг_Предоплаты.Заявка.Филиал.Организация КАК ЗаявкаФилиалОрганизация,
	|	омг_Предоплаты.Заявка.Дата КАК ЗаявкаДата,
	|	омг_НастройкиTipTop.Логин КАК Логин,
	|	омг_НастройкиTipTop.Пароль КАК Пароль,
	|	омг_НастройкиTipTop.омг_КоличествоПроверокПредоплаты КАК КоличествоПроверок
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|		ПО омг_Предоплаты.Заявка.Филиал.Организация = омг_НастройкиTipTop.Организация
	|ГДЕ
	|	омг_Предоплаты.КоличествоПроверок < омг_НастройкиTipTop.омг_КоличествоПроверокПредоплаты
	|	И омг_Предоплаты.Статус = ЗНАЧЕНИЕ(Перечисление.омг_СтатусыПредоплаты.ОжиданиеОплаты)
	|	И омг_НастройкиTipTop.омг_ИспользоватьПредоплату
	|
	|СГРУППИРОВАТЬ ПО
	|	омг_Предоплаты.InvoiceId,
	|	омг_Предоплаты.ПлатежныйДокумент,
	|	омг_Предоплаты.Заявка,
	|	омг_НастройкиTipTop.Пароль,
	|	омг_НастройкиTipTop.Логин,
	|	омг_Предоплаты.Заявка.Филиал.Организация,
	|	омг_Предоплаты.Заявка.Дата,
	|	омг_НастройкиTipTop.омг_КоличествоПроверокПредоплаты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаявкаФилиалОрганизация,
	|	ЗаявкаДата
	|ИТОГИ ПО
	|	ЗаявкаФилиалОрганизация";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаявкаФилиалОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаявкаФилиалОрганизация.Следующий() Цикл
		
		ВыборкаДетальныеЗаписи = ВыборкаЗаявкаФилиалОрганизация.Выбрать();  
		
		СЧ = Истина;   
		Логин = "";
		Пароль = "";
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если СЧ Тогда
				Логин = ВыборкаДетальныеЗаписи.Логин;
				Пароль = ВыборкаДетальныеЗаписи.Пароль;	
				СоединениеHTTP = Новый HTTPСоединение("api.tiptoppay.kz",,Логин,Пароль,,,Новый ЗащищенноеСоединениеOpenSSL(),);
				ЗаголовокЗапросаHTTP = Новый Соответствие();
				ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
				ЗапросHTTP = Новый HTTPЗапрос("/v2/payments/find", ЗаголовокЗапросаHTTP); 
				СЧ = Ложь;
			КонецЕсли;  
			
			ИНН = омг_ДополнительныеАлгоритмы.омг_ВернутьИНН(ВыборкаДетальныеЗаписи.ЗаявкаФилиалОрганизация);
			
			СтруктураОтправки = Новый Структура("InvoiceId", ВыборкаДетальныеЗаписи.InvoiceId);
			
			ЗаписьJSON = Новый ЗаписьJSON;               
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
			СтрокаДляТела = ЗаписьJSON.Закрыть();
			
			ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаДляТела);
			Ответ = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
			
			Если Ответ.КодСостояния = 200 Тогда
				
				Сообщение = Ответ.ПолучитьТелоКакСтроку("UTF-8");
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(Сообщение);
				ДанныеВозврата = ПрочитатьJSON(ЧтениеJSON);
				ЧтениеJSON.Закрыть();
				TransactionId = "";
				
				Если ДанныеВозврата.Message = "Not found" Тогда
					Статус = Перечисления.омг_СтатусыПредоплаты.ОжиданиеОплаты
				Иначе 
					Если ДанныеВозврата.Model.Status = "Completed" Тогда
						Статус = Перечисления.омг_СтатусыПредоплаты.ОплатаПринята;
						TransactionId = ДанныеВозврата.Model.TransactionId;
					иначе
						Статус = Перечисления.омг_СтатусыПредоплаты.НетОплаты 
					КонецЕсли; 
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.InvoiceId) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Заявка) Тогда
					омг_ОбновитьСтатусыПредоплатВРегистре(
						ВыборкаДетальныеЗаписи.Заявка, Статус, ВыборкаДетальныеЗаписи.КоличествоПроверок, TransactionId,
						ВыборкаДетальныеЗаписи.ПлатежныйДокумент, ВыборкаДетальныеЗаписи.ЗаявкаФилиалОрганизация,
						ИНН, Логин, Пароль);
				КонецЕсли; 
				
			Иначе
				ЗаписьЖурналаРегистрации("омг_Предоплата.омг_ОбновитьСтатусыПредоплат", УровеньЖурналаРегистрации.Ошибка,,,
					"InvoiceId=" + ВыборкаДетальныеЗаписи.InvoiceId + "; HTTP " + Ответ.КодСостояния);
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Обновляет статус предоплаты в регистре и выполняет сопутствующие действия:
// перепроведение платежного документа, смену состояния Заявки, постановку
// в очередь на отмену. Формирование чека выполняется системой TipTop Pay
// автоматически (передан вместе с созданием заказа) и отдельного вызова
// здесь не требует.
//
// Используется и регламентным заданием, и HTTP-сервисом обработки вебхука.
//
Процедура омг_ОбновитьСтатусыПредоплатВРегистре(Заявка, Статус, КоличествоПроверок, TransactionId, ПлатежныйДокумент, Организация, ИНН, Логин, Пароль, НеУвеличиватьСчетчик = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина); 

	Запись = РегистрыСведений.омг_Предоплаты.СоздатьМенеджерЗаписи();
	Запись.Заявка = Заявка;
	Запись.РегистраторЗаписи = ПлатежныйДокумент;
	Запись.Прочитать();
	
	Если Не Запись.Выбран() Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;

	Запись.Статус = Статус;
	Запись.TransactionId = TransactionId;
	
	Если Статус = Перечисления.омг_СтатусыПредоплаты.ОплатаПринята Тогда
		Запись.ОплатаПринятаБыла = Истина;
	КонецЕсли;

	Если НеУвеличиватьСчетчик = Ложь Тогда
		Запись.КоличествоПроверок = Запись.КоличествоПроверок + 1; 
	КонецЕсли;  
	
	Если Запись.КоличествоПроверок >= КоличествоПроверок И Запись.Статус = Перечисления.омг_СтатусыПредоплаты.ОжиданиеОплаты Тогда
		Запись.Статус = Перечисления.омг_СтатусыПредоплаты.НетОплаты;
	КонецЕсли;	
	
	Если Запись.Статус = Перечисления.омг_СтатусыПредоплаты.НетОплаты Тогда
		ЗаявкаОбъект = Заявка.Ссылка.ПолучитьОбъект();
		Если Не ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена Тогда
			МенеджерЗаписи = РегистрыСведений.ОчередьЗаявокНаОтмену.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Заявка = Заявка.Ссылка;
			МенеджерЗаписи.ДатаВремя = ТекущаяДата();
			МенеджерЗаписи.Записать(); 
		КонецЕсли;
	КонецЕсли;	
	
	Запись.Записать(); 
	
	Если Статус = Перечисления.омг_СтатусыПредоплаты.ОплатаПринята Тогда
		
		ПлатежныйДокументОбъект = ПлатежныйДокумент.ПолучитьОбъект();
		Если ПлатежныйДокументОбъект.Проведен Тогда
			ПлатежныйДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли; 
		
		ЗаявкаОбъект = Заявка.Ссылка.ПолучитьОбъект();
		Если Не ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована Тогда
			ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована;
			ЗаявкаОбъект.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры     

// Выполняет возврат предоплаты: наличными (создает запись без обращения к API)
// либо через TipTop Pay (/payments/refund с встроенным чеком возврата).
// Возврат через API часто завершается асинхронно (проходит суточным оборотом),
// поэтому окончательный статус ПроизведенВозврат проставляется по факту
// получения официального уведомления Refund, а не сразу по ответу метода.
//
// Параметры:
//  ДокументОснование - ДокументСсылка.ОплатаПлатежнойКартой / ПриходныйКассовыйОрдер
//  Объект            - ДокументОбъект.ВозвратПоПлатежнойКарте
//
// Возвращаемое значение:
//  Структура("Успех, ТекстОшибки")
//
Функция омг_СделатьВозвратПредоплаты(Знач ДокументОснование, Знач Объект) Экспорт
		
	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");
	
	СтатусОплаты = ВернутьСтатусОплаты(ДокументОснование);
	
	Если СтатусОплаты = Неопределено Тогда
		Результат.ТекстОшибки = "По документу не найдена предоплата.";
		Возврат Результат;
	КонецЕсли;
	
	Если СтатусОплаты.Статус <> Перечисления.омг_СтатусыПредоплаты.ОплатаПринята Тогда
		Результат.ТекстОшибки = "Предоплата по документу не находится в статусе ""Оплата принята"".";
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	омг_Предоплаты.Заявка КАК Заявка,
	|	омг_Предоплаты.ПлатежныйДокумент КАК ПлатежныйДокумент,
	|	омг_Предоплаты.InvoiceId КАК InvoiceId,
	|	омг_Предоплаты.Заявка.Филиал.Организация КАК ЗаявкаФилиалОрганизация,
	|	омг_НастройкиTipTop.Логин КАК Логин,
	|	омг_НастройкиTipTop.Пароль КАК Пароль,
	|	омг_Предоплаты.Сумма КАК Сумма, 
	|	омг_Предоплаты.Ссылка КАК СсылкаПредоплаты,
	|	омг_Предоплаты.TransactionId КАК TransactionId
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|		ПО омг_Предоплаты.Заявка.Филиал.Организация = омг_НастройкиTipTop.Организация
	|ГДЕ
	|	омг_Предоплаты.ПлатежныйДокумент = &ПлатежныйДокумент
	|	И омг_Предоплаты.Статус = ЗНАЧЕНИЕ(Перечисление.омг_СтатусыПредоплаты.ОплатаПринята)
	|
	|СГРУППИРОВАТЬ ПО
	|	омг_Предоплаты.InvoiceId, омг_Предоплаты.ПлатежныйДокумент, омг_Предоплаты.Заявка,
	|	омг_НастройкиTipTop.Пароль, омг_НастройкиTipTop.Логин,
	|	омг_Предоплаты.Заявка.Филиал.Организация, омг_Предоплаты.Сумма,омг_Предоплаты.Ссылка, омг_Предоплаты.TransactionId
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОказаниеУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрНакопления.омг_ОстаткиПредоплаты.Обороты(, , Регистратор, ) КАК омг_ОстаткиПредоплатыОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг КАК ОказаниеУслуг
	|		ПО омг_ОстаткиПредоплатыОбороты.Регистратор = ОказаниеУслуг.ДокументОснование
	|ГДЕ
	|	омг_ОстаткиПредоплатыОбороты.ДокументПоступления = &ПлатежныйДокумент
	|	И ОказаниеУслуг.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ВозвратКлиенту)
	|	И ОказаниеУслуг.Проведен";
	
	Запрос.УстановитьПараметр("ПлатежныйДокумент", ДокументОснование);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать();
	ВыборкаДетальныеОказание = РезультатЗапроса[1].Выбрать();  
	
	ОказаниеВозврат = Документы.ОказаниеУслуг.ПустаяСсылка();
	Если ВыборкаДетальныеОказание.Следующий() Тогда
		ОказаниеВозврат = ВыборкаДетальныеОказание.Ссылка
	КонецЕсли;	

	Если Не ВыборкаДетальныеЗаписи.Следующий() Тогда
		Результат.ТекстОшибки = "Не найдена запись предоплаты для платежного документа.";
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда 
		
		Набор = РегистрыСведений.омг_Предоплаты.СоздатьНаборЗаписей();
		Набор.Отбор.Заявка.Установить(ДокументОснование.ДокументОснование);
		Набор.Отбор.РегистраторЗаписи.Установить(Объект.Ссылка);
		Запись = Набор.Добавить(); 
		Запись.Заявка = ДокументОснование.ДокументОснование;
		Запись.РегистраторЗаписи = Объект.Ссылка;
		Запись.Сумма = ВыборкаДетальныеЗаписи.Сумма;  
		Запись.Статус = Перечисления.омг_СтатусыПредоплаты.ПроизведенВозврат;
		Запись.ПлатежныйДокумент = Объект.ДокументОснование.Ссылка;
		Запись.ПлатежныйДокументВозврата = Объект.Ссылка;
		Запись.ВозвратУслуг = ОказаниеВозврат;
		Запись.InvoiceId = СокрЛП(Объект.Ссылка.УникальныйИдентификатор());
		Запись.TransactionId = "";
		Запись.Ссылка = ВыборкаДетальныеЗаписи.СсылкаПредоплаты;
		Набор.Записать();
		
		Результат.Успех = Истина;
		Возврат Результат;
		
	Иначе	
		
		Попытка
			
			СоединениеHTTP = Новый HTTPСоединение("api.tiptoppay.kz",,ВыборкаДетальныеЗаписи.Логин,ВыборкаДетальныеЗаписи.Пароль,,,Новый ЗащищенноеСоединениеOpenSSL(),);
			ЗаголовокЗапросаHTTP = Новый Соответствие();
			ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
			ГУИДСтрокой = СокрЛП(Объект.Ссылка.УникальныйИдентификатор());
			ЗаголовокЗапросаHTTP.Вставить("X-Request-ID", ГУИДСтрокой);
			ЗапросHTTP = Новый HTTPЗапрос("/payments/refund", ЗаголовокЗапросаHTTP); 
			
			СтрокаТовара = Новый Структура;
			СтрокаТовара.Вставить("Label", "Бронирование времени врача");
			СтрокаТовара.Вставить("Price", ВыборкаДетальныеЗаписи.Сумма);
			СтрокаТовара.Вставить("Quantity", 1);
			СтрокаТовара.Вставить("Amount", ВыборкаДетальныеЗаписи.Сумма);
			СтрокаТовара.Вставить("Vat", Неопределено);
			СтрокаТовара.Вставить("MeasurementUnit", "усл.");
			
			Items = Новый Массив;
			Items.Добавить(СтрокаТовара);
			
			CustomerReceipt = Новый Структура;
			CustomerReceipt.Вставить("Items", Items);
			CustomerReceipt.Вставить("Amounts", Новый Структура("Electronic", ВыборкаДетальныеЗаписи.Сумма));
			CustomerReceipt.Вставить("IsBso", Ложь);
			
			PaymentData = Новый Структура("CustomerReceipt", CustomerReceipt);
			
			СтруктураОтправки = Новый Структура("TransactionId,Amount,JsonData",
				ВыборкаДетальныеЗаписи.TransactionId, ВыборкаДетальныеЗаписи.Сумма,
				Новый Структура("PaymentData", PaymentData));
			
			ЗаписьJSON = Новый ЗаписьJSON;               
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
			СтрокаДляТела = ЗаписьJSON.Закрыть();
			
			ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаДляТела);
			Ответ = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
			
			Если Ответ.КодСостояния = 200 Тогда
				
				Сообщение = Ответ.ПолучитьТелоКакСтроку("UTF-8");
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(Сообщение);
				ДанныеВозврата = ПрочитатьJSON(ЧтениеJSON);
				ЧтениеJSON.Закрыть(); 
				
				Если ТипЗнч(ДанныеВозврата) = Тип("Структура") И ДанныеВозврата.Свойство("Success") И ДанныеВозврата.Success Тогда
					
					Набор = РегистрыСведений.омг_Предоплаты.СоздатьНаборЗаписей();
					Набор.Отбор.Заявка.Установить(ДокументОснование.ДокументОснование);
					Набор.Отбор.РегистраторЗаписи.Установить(Объект.Ссылка);
					Запись = Набор.Добавить(); 
					Запись.Заявка = ДокументОснование.ДокументОснование;
					Запись.РегистраторЗаписи = Объект.Ссылка;
					Запись.Сумма = ВыборкаДетальныеЗаписи.Сумма;  
					Запись.Статус = Перечисления.омг_СтатусыПредоплаты.ВозвратВОбработке;
					Запись.ПлатежныйДокумент = Объект.ДокументОснование.Ссылка;
					Запись.ПлатежныйДокументВозврата = Объект.Ссылка;
					Запись.ВозвратУслуг = ОказаниеВозврат;
					Запись.InvoiceId = ГУИДСтрокой;
					Запись.TransactionId = ДанныеВозврата.Model.TransactionId;
					Запись.Ссылка = ВыборкаДетальныеЗаписи.СсылкаПредоплаты;
					Набор.Записать();
					
					// Транзакция возврата может приземлиться в статусе Authorized,
					// требующем явного подтверждения (см. документацию, таблица
					// "Статусы операций": Authorized -> Подтверждение, Отмена).
					// Без этого шага возврат зависает и не переходит в Completed.
					ЗапросПодтверждения = Новый HTTPЗапрос("/payments/confirm", ЗаголовокЗапросаHTTP);
					СтруктураПодтверждения = Новый Структура("TransactionId,Amount",
						ДанныеВозврата.Model.TransactionId, ВыборкаДетальныеЗаписи.Сумма);
					
					ЗаписьJSONПодтв = Новый ЗаписьJSON;
					ЗаписьJSONПодтв.УстановитьСтроку();
					ЗаписатьJSON(ЗаписьJSONПодтв, СтруктураПодтверждения);
					ЗапросПодтверждения.УстановитьТелоИзСтроки(ЗаписьJSONПодтв.Закрыть());
					
					Попытка
						ОтветПодтверждения = СоединениеHTTP.ОтправитьДляОбработки(ЗапросПодтверждения);
						Если ОтветПодтверждения.КодСостояния <> 200 Тогда
							ЗаписьЖурналаРегистрации("омг_Предоплата.омг_СделатьВозвратПредоплаты", УровеньЖурналаРегистрации.Предупреждение,,,
								"Не удалось подтвердить возврат (TransactionId="
								+ ДанныеВозврата.Model.TransactionId + "): HTTP " + ОтветПодтверждения.КодСостояния);
						КонецЕсли;
					Исключение
						ЗаписьЖурналаРегистрации("омг_Предоплата.омг_СделатьВозвратПредоплаты", УровеньЖурналаРегистрации.Предупреждение,,,
							"Ошибка подтверждения возврата (TransactionId=" + ДанныеВозврата.Model.TransactionId
							+ "): " + ОписаниеОшибки());
					КонецПопытки;
					
					Результат.Успех = Истина;
					
				Иначе
					Результат.ТекстОшибки = "TipTop Pay вернул ошибку: " + Сообщение;
					ЗаписьЖурналаРегистрации("омг_Предоплата.омг_СделатьВозвратПредоплаты", УровеньЖурналаРегистрации.Ошибка,,, Результат.ТекстОшибки);
				КонецЕсли;	
				
			Иначе
				Результат.ТекстОшибки = "HTTP " + Ответ.КодСостояния + " при вызове /payments/refund";
				ЗаписьЖурналаРегистрации("омг_Предоплата.омг_СделатьВозвратПредоплаты", УровеньЖурналаРегистрации.Ошибка,,, Результат.ТекстОшибки);
			КонецЕсли;	
			
		Исключение
			Результат.ТекстОшибки = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("омг_Предоплата.омг_СделатьВозвратПредоплаты", УровеньЖурналаРегистрации.Ошибка,,, Результат.ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции 	

// Проверяет включена ли предоплата для организации.
Функция омг_ИспользуетсяПредоплата(Организация) Экспорт
		
	ВозЗначение = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_НастройкиTipTop.омг_ИспользоватьПредоплату КАК омг_ИспользоватьПредоплату
		|ИЗ
		|	РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
		|ГДЕ
		|	омг_НастройкиTipTop.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ВозЗначение = ВыборкаДетальныеЗаписи.омг_ИспользоватьПредоплату
	КонецЕсли;	
	
	Возврат ВозЗначение;	
	
КонецФункции	
	
Функция ВернутьСуммуПредоплаты(Клиент, Регистратор, Период, Заявка = Неопределено) Экспорт
	
	ДопУсловие = ""; 
	
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(Заявка) Тогда
		ДопУсловие = " И Заявка = &Заявка ";
		Запрос.УстановитьПараметр("Заявка", Заявка);
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(омг_ОстаткиПредоплатыОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	омг_ОстаткиПредоплатыОстатки.ДокументПоступления КАК ДокументПоступления
	|ИЗ
	|	РегистрНакопления.омг_ОстаткиПредоплаты.Остатки(&Период, Клиент = &Клиент" + ДопУсловие + ") КАК омг_ОстаткиПредоплатыОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	омг_ОстаткиПредоплатыОстатки.ДокументПоступления
	|
	|УПОРЯДОЧИТЬ ПО
	|	омг_ОстаткиПредоплатыОстатки.ДокументПоступления.Дата";
	
	Запрос.УстановитьПараметр("Клиент", Клиент); 
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Период", Период);
	
	Возврат Запрос.Выполнить().Выгрузить();	
	
КонецФункции	

// Возвращает сумму подтвержденной предоплаты (Статус = ОплатаПринята) по документу.
Функция ВернутьСуммуПредоплатыПоДокументу(Регистратор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(омг_Предоплаты.Сумма) КАК Сумма
		|ИЗ
		|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
		|ГДЕ
		|	омг_Предоплаты.ПлатежныйДокумент = &ПлатежныйДокумент
		|	И омг_Предоплаты.Статус = ЗНАЧЕНИЕ(Перечисление.омг_СтатусыПредоплаты.ОплатаПринята)";
	
	Запрос.УстановитьПараметр("ПлатежныйДокумент", Регистратор);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	ВыборкаДетальныеЗаписи.Следующий(); 
	
	Возврат ?(ВыборкаДетальныеЗаписи.Сумма = NULL, 0, ВыборкаДетальныеЗаписи.Сумма);	
		
КонецФункции	

// Ручная (по требованию) проверка статуса предоплаты для конкретной Заявки.
Процедура омг_ОбновитьСтатусПредоплатПоЗапросу(Заявка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);       
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	омг_Предоплаты.Заявка КАК Заявка,
	|	омг_Предоплаты.ПлатежныйДокумент КАК ПлатежныйДокумент,
	|	омг_Предоплаты.InvoiceId КАК InvoiceId,
	|	омг_Предоплаты.Заявка.Филиал.Организация КАК ЗаявкаФилиалОрганизация,
	|	омг_НастройкиTipTop.Логин КАК Логин,
	|	омг_НастройкиTipTop.Пароль КАК Пароль,
	|	омг_НастройкиTipTop.омг_КоличествоПроверокПредоплаты КАК КоличествоПроверок
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|		ПО омг_Предоплаты.Заявка.Филиал.Организация = омг_НастройкиTipTop.Организация
	|ГДЕ
	|	омг_Предоплаты.Заявка = &Заявка
	|
	|СГРУППИРОВАТЬ ПО
	|	омг_Предоплаты.InvoiceId,
	|	омг_Предоплаты.ПлатежныйДокумент,
	|	омг_Предоплаты.Заявка,
	|	омг_НастройкиTipTop.Пароль,
	|	омг_НастройкиTipTop.Логин,
	|	омг_Предоплаты.Заявка.Филиал.Организация,
	|	омг_НастройкиTipTop.омг_КоличествоПроверокПредоплаты";
	
	Запрос.УстановитьПараметр("Заявка", Заявка);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Логин = ВыборкаДетальныеЗаписи.Логин;
		Пароль = ВыборкаДетальныеЗаписи.Пароль;
		ИНН = омг_ДополнительныеАлгоритмы.омг_ВернутьИНН(ВыборкаДетальныеЗаписи.ЗаявкаФилиалОрганизация);
		
		СоединениеHTTP = Новый HTTPСоединение("api.tiptoppay.kz",,Логин,Пароль,,,Новый ЗащищенноеСоединениеOpenSSL(),);
		ЗаголовокЗапросаHTTP = Новый Соответствие();
		ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
		ЗапросHTTP = Новый HTTPЗапрос("/v2/payments/find", ЗаголовокЗапросаHTTP); 
		
		СтруктураОтправки = Новый Структура("InvoiceId", ВыборкаДетальныеЗаписи.InvoiceId);
		
		ЗаписьJSON = Новый ЗаписьJSON;               
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
		СтрокаДляТела = ЗаписьJSON.Закрыть();
		
		ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаДляТела);
		Ответ = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
		
		Если Ответ.КодСостояния = 200 Тогда
			
			Сообщение = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Сообщение);
			ДанныеВозврата = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			TransactionId = "";
			
			Если ДанныеВозврата.Message = "Not found" Тогда
				Статус = Перечисления.омг_СтатусыПредоплаты.ОжиданиеОплаты
			Иначе 
				Если ДанныеВозврата.Model.Status = "Completed" Тогда
					Статус = Перечисления.омг_СтатусыПредоплаты.ОплатаПринята;
					TransactionId = ДанныеВозврата.Model.TransactionId;
				иначе
					Статус = Перечисления.омг_СтатусыПредоплаты.НетОплаты 
				КонецЕсли; 
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.InvoiceId) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Заявка) Тогда
				омг_ОбновитьСтатусыПредоплатВРегистре(
					ВыборкаДетальныеЗаписи.Заявка, Статус, ВыборкаДетальныеЗаписи.КоличествоПроверок, TransactionId,
					ВыборкаДетальныеЗаписи.ПлатежныйДокумент, ВыборкаДетальныеЗаписи.ЗаявкаФилиалОрганизация,
					ИНН, Логин, Пароль, Истина)
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры

// Проставляет окончательный статус ПроизведенВозврат для записи, находящейся
// в статусе ВозвратВОбработке, по номеру транзакции - вызывается из
// обработчика Refund-уведомления после подтверждения фактического возврата.
Процедура омг_ЗавершитьВозвратПоTransactionId(Знач TransactionId) Экспорт
	
 	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	омг_Предоплаты.Заявка КАК Заявка,
	|	омг_Предоплаты.РегистраторЗаписи КАК РегистраторЗаписи
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|ГДЕ
	|	омг_Предоплаты.TransactionId = &TransactionId
	|	И омг_Предоплаты.Статус = ЗНАЧЕНИЕ(Перечисление.омг_СтатусыПредоплаты.ВозвратВОбработке)";
	
	Запрос.УстановитьПараметр("TransactionId", TransactionId);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Запись = РегистрыСведений.омг_Предоплаты.СоздатьМенеджерЗаписи();
		Запись.Заявка = Выборка.Заявка;
		Запись.РегистраторЗаписи = Выборка.РегистраторЗаписи;
		Запись.Прочитать();
		
		Если Запись.Выбран() Тогда
			Запись.Статус = Перечисления.омг_СтатусыПредоплаты.ПроизведенВозврат;
			Запись.Записать();
			
			// РегистраторЗаписи для записи возврата - это сам документ ВозвратПоПлатежнойКарте.
			// Проводим его теперь, когда возврат официально подтвержден - движения
			// (касса/взаиморасчеты) создадутся корректно благодаря гейтингу
			// в ОбработкаПроведения, а не в момент клика "Сделать возврат".
			Попытка
				ДокументВозврата = Выборка.РегистраторЗаписи.ПолучитьОбъект();
				ДокументВозврата.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаписьЖурналаРегистрации("омг_Предоплата.омг_ЗавершитьВозвратПоTransactionId", УровеньЖурналаРегистрации.Ошибка,,,
					"TransactionId=" + TransactionId + "; " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Поиск данных предоплаты по InvoiceId - используется HTTP-сервисом обработки вебхука.
Функция НайтиДанныеПредоплатыПоInvoiceId(Знач InvoiceId) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура(
		"Найдено, Заявка, ПлатежныйДокумент, КоличествоПроверок, Организация, ИНН, Логин, Пароль, Сумма",
		Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	омг_Предоплаты.Заявка КАК Заявка,
	|	омг_Предоплаты.ПлатежныйДокумент КАК ПлатежныйДокумент,
	|	омг_Предоплаты.Сумма КАК Сумма,
	|	омг_Предоплаты.Заявка.Филиал.Организация КАК Организация,
	|	омг_НастройкиTipTop.Логин КАК Логин,
	|	омг_НастройкиTipTop.Пароль КАК Пароль,
	|	омг_НастройкиTipTop.омг_КоличествоПроверокПредоплаты КАК КоличествоПроверок
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|		ПО омг_Предоплаты.Заявка.Филиал.Организация = омг_НастройкиTipTop.Организация
	|ГДЕ
	|	омг_Предоплаты.InvoiceId = &InvoiceId";
	
	Запрос.УстановитьПараметр("InvoiceId", InvoiceId);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.Найдено = Истина;
		Результат.Заявка = Выборка.Заявка;
		Результат.ПлатежныйДокумент = Выборка.ПлатежныйДокумент;
		Результат.Сумма = Выборка.Сумма;
		Результат.Организация = Выборка.Организация;
		Результат.ИНН = омг_ДополнительныеАлгоритмы.омг_ВернутьИНН(Выборка.Организация);
		Результат.Логин = Выборка.Логин;
		Результат.Пароль = Выборка.Пароль;
		Результат.КоличествоПроверок = Выборка.КоличествоПроверок;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Проверка подлинности вебхук-уведомления по алгоритму HMAC-SHA256.
// Сверяется с заголовком Content-HMAC (вычисляется системой из URL-encoded
// параметров, что соответствует сырому телу POST-запроса без декодирования).
Функция омг_ПроверитьПодписьУведомления(Запрос, Знач ApiSecret) Экспорт
	
	ЗаголовокHMAC = Запрос.Заголовки.Получить("Content-HMAC");
	
	Если ПустаяСтрока(ЗаголовокHMAC) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТелоЗапроса = Запрос.ПолучитьТелоКакДвоичныеДанные();
	КлючДвоичныеДанные = омг_СтрокаВДвоичныеДанные(ApiSecret);
	
	ХешСумма = омг_ВычислитьHMACSHA256(КлючДвоичныеДанные, ТелоЗапроса);
	
	ВычисленнаяПодпись = Base64Строка(ХешСумма);
	
	Возврат ВычисленнаяПодпись = ЗаголовокHMAC;
	
КонецФункции

// Вычисляет HMAC-SHA256 по классическому алгоритму (ipad/opad + двойное
// хеширование), поскольку платформа 1С не предоставляет HMAC как готовую
// возможность - только базовое хеширование без ключа (ХешированиеДанных).
// Реализация основана на общеизвестном алгоритме HMAC (RFC 2104),
// адаптирована под работу с ДвоичныеДанные через БуферДвоичныхДанных.
//
// Параметры:
//  Ключ      - ДвоичныеДанные - секретный ключ (API Secret в байтах)
//  Сообщение - ДвоичныеДанные - данные для подписи (сырое тело запроса)
//
// Возвращаемое значение:
//  ДвоичныеДанные - результат HMAC-SHA256 (32 байта)
//
Функция омг_ВычислитьHMACSHA256(Знач Ключ, Знач Сообщение) Экспорт
	
	РазмерБлока = 64; // размер блока для SHA256
	
	БуферКлюча = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Ключ);
	Если БуферКлюча.Размер > РазмерБлока Тогда
		ХешерКлюча = Новый ХешированиеДанных(ХешФункция.SHA256);
		ХешерКлюча.Добавить(Ключ);
		Ключ = ХешерКлюча.ХешСумма;
		БуферКлюча = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Ключ);
	КонецЕсли;
	
	БуферНули = Новый БуферДвоичныхДанных(РазмерБлока);
	БуферНули.ЗаписатьПобитовоеИли(0, БуферКлюча);
	КлючДополненный = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферНули);
	
	БуферIpad = Новый БуферДвоичныхДанных(РазмерБлока);
	БуферOpad = Новый БуферДвоичныхДанных(РазмерБлока);
	Для Индекс = 0 По РазмерБлока - 1 Цикл
		БуферIpad[Индекс] = 54;  // 0x36
		БуферOpad[Индекс] = 92;  // 0x5C
	КонецЦикла;
	
	БуферКлючДляIpad = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(КлючДополненный);
	БуферIpad.ЗаписатьПобитовоеИсключительноеИли(0, БуферКлючДляIpad);
	КлючXorIpad = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферIpad);
	
	БуферВнутренний1 = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(КлючXorIpad);
	БуферСообщения    = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Сообщение);
	БуферВнутренний   = БуферВнутренний1.Соединить(БуферСообщения);
	ДанныеВнутренние  = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферВнутренний);
	
	ХешерВнутренний = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешерВнутренний.Добавить(ДанныеВнутренние);
	ХешВнутренний = ХешерВнутренний.ХешСумма;
	
	БуферКлючДляOpad = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(КлючДополненный);
	БуферOpad.ЗаписатьПобитовоеИсключительноеИли(0, БуферКлючДляOpad);
	КлючXorOpad = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферOpad);
	
	БуферВнешний1 = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(КлючXorOpad);
	БуферВнешний2 = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ХешВнутренний);
	БуферВнешний  = БуферВнешний1.Соединить(БуферВнешний2);
	ДанныеВнешние = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферВнешний);
	
	ХешерВнешний = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешерВнешний.Добавить(ДанныеВнешние);
	
	Возврат ХешерВнешний.ХешСумма;
	
КонецФункции

Функция омг_СтрокаВДвоичныеДанные(Знач Строка) Экспорт
	
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Строка, КодировкаТекста.UTF8, Ложь);
	
КонецФункции

// Проверяет, входит ли IP-адрес в список доверенных адресов TipTop Pay,
// с которых система отправляет уведомления.
Функция омг_IPАдресДоверенный(Знач IPАдрес) Экспорт
	
	Если IPАдрес = "213.148.13.240" 
		ИЛИ IPАдрес = "185.47.167.149" 
		ИЛИ омг_IPВПодсети(IPАдрес, "91.216.178.240", 29)
		ИЛИ омг_IPВПодсети(IPАдрес, "185.102.72.105", 29)
	Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция омг_IPВПодсети(Знач IPАдрес, Знач БазовыйIP, Знач Маска) Экспорт
	
	Попытка
		МассивIP = СтрРазделить(IPАдрес, ".");
		МассивБазовый = СтрРазделить(БазовыйIP, ".");
		Если МассивIP.Количество() <> 4 Или МассивБазовый.Количество() <> 4 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ЧислоIP = Число(МассивIP[0]) * 16777216 + Число(МассивIP[1]) * 65536 + Число(МассивIP[2]) * 256 + Число(МассивIP[3]);
		ЧислоБазовый = Число(МассивБазовый[0]) * 16777216 + Число(МассивБазовый[1]) * 65536 + Число(МассивБазовый[2]) * 256 + Число(МассивБазовый[3]);
		
		РазмерБлока = омг_СтепеньДвойки(32 - Маска);
		
		Возврат (ЧислоIP - ЧислоIP % РазмерБлока) = (ЧислоБазовый - ЧислоБазовый % РазмерБлока);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Возвращает 2 в степени Показатель (только для целых неотрицательных
// показателей от 0 до 32 - используется для вычисления размера блока подсети).
Функция омг_СтепеньДвойки(Знач Показатель) Экспорт
	
	Результат = 1;
	Для Сч = 1 По Показатель Цикл
		Результат = Результат * 2;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
// Настраивает уведомление указанного типа на сайте TipTop Pay через API.
// Работает для типов Check, Pay, Fail, Confirm, Refund, Recurrent, Cancel.
Функция омг_НастроитьУведомлениеTipTop(Знач Логин, Знач Пароль, Знач ТипУведомления, Знач АдресУведомления) Экспорт
	
	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");
	
	Попытка
		
		СоединениеHTTP = Новый HTTPСоединение("api.tiptoppay.kz",,Логин,Пароль,,,Новый ЗащищенноеСоединениеOpenSSL(),);
		ЗаголовокЗапросаHTTP = Новый Соответствие();
		ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
		
		ЗапросHTTP = Новый HTTPЗапрос("/site/notifications/" + НРег(ТипУведомления) + "/update", ЗаголовокЗапросаHTTP);
		
		СтруктураОтправки = Новый Структура;
		СтруктураОтправки.Вставить("IsEnabled", Истина);
		СтруктураОтправки.Вставить("Address", АдресУведомления);
		СтруктураОтправки.Вставить("HttpMethod", "POST");
		СтруктураОтправки.Вставить("Encoding", "UTF8");
		СтруктураОтправки.Вставить("Format", "TipTop Pay");
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
		ЗапросHTTP.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
		
		Ответ = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
		
		Если Ответ.КодСостояния = 200 Тогда
			Сообщение = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Сообщение);
			ДанныеВозврата = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Если ТипЗнч(ДанныеВозврата) = Тип("Структура") И ДанныеВозврата.Свойство("Success") И ДанныеВозврата.Success Тогда
				Результат.Успех = Истина;
			Иначе
				Результат.ТекстОшибки = Сообщение;
			КонецЕсли;
		Иначе
			Результат.ТекстОшибки = "HTTP " + Ответ.КодСостояния;
		КонецЕсли;
		
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Настраивает Pay-, Fail- и Refund-уведомления сразу для всех организаций,
// у которых заведены настройки TipTop Pay - используется один раз при
// внедрении или при подключении нового филиала.
Процедура омг_НастроитьУведомленияДляВсехФилиалов(Знач БазовыйURL) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	омг_НастройкиTipTop.Организация КАК Организация,
	|	омг_НастройкиTipTop.Логин КАК Логин,
	|	омг_НастройкиTipTop.Пароль КАК Пароль
	|ИЗ
	|	РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Для Каждого Тип Из Новый Массив("pay", "fail", "refund") Цикл
			Результат = омг_НастроитьУведомлениеTipTop(Выборка.Логин, Выборка.Пароль, Тип, БазовыйURL + "/hs/tiptoppay/" + Тип);
			Если Не Результат.Успех Тогда
				ЗаписьЖурналаРегистрации("омг_Предоплата.НастройкаУведомлений", УровеньЖурналаРегистрации.Ошибка,,,
					"Организация=" + Выборка.Организация + "; " + Тип + ": " + Результат.ТекстОшибки);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Регламентное задание: автоматическая отмена заявок по истечении таймаута ожидания оплаты.
Процедура ПроверкаОчередиЗаявокНаОтмену() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОчередьЗаявокНаОтмену.Заявка КАК Заявка,
	|	ОчередьЗаявокНаОтмену.ДатаВремя КАК ДатаВремя,
	|	ЕСТЬNULL(омг_НастройкиTipTop.МинутыДоОтмены, 0) КАК МинутДоОтмены,
	|	ОчередьЗаявокНаОтмену.Заявка.Состояние КАК ЗаявкаСостояние
	|ИЗ
	|	РегистрСведений.ОчередьЗаявокНаОтмену КАК ОчередьЗаявокНаОтмену
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|		ПО ОчередьЗаявокНаОтмену.Заявка.Филиал.Организация = омг_НастройкиTipTop.Организация";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЗаявки = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаЗаявки.Следующий() Цикл
		
		ЭтоВремяПрошло = ТекущаяДата() >= НачалоМинуты(ВыборкаЗаявки.ДатаВремя + (ВыборкаЗаявки.МинутДоОтмены * 60));
		
		Если ВыборкаЗаявки.ЗаявкаСостояние = Справочники.ВидыСостоянийЗаявок.Отменена
			ИЛИ ВыборкаЗаявки.МинутДоОтмены = 0
			ИЛИ ЭтоВремяПрошло Тогда
			
			Если ЭтоВремяПрошло И Не ВыборкаЗаявки.ЗаявкаСостояние = Справочники.ВидыСостоянийЗаявок.Отменена Тогда
				ЗаявкаОбъект = ВыборкаЗаявки.Заявка.Ссылка.ПолучитьОбъект();
				ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена;
				ЗаявкаОбъект.Записать();  
			КонецЕсли;	
			
			НаборЗаписей = РегистрыСведений.ОчередьЗаявокНаОтмену.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Заявка.Установить(ВыборкаЗаявки.Заявка);
			НаборЗаписей.Записать();
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура омг_ПриПроведениеОплатаПлатежнойКартой(Источник, Отказ, РежимПроведения) Экспорт
	// Вставить содержимое обработчика.
КонецПроцедуры  

// Поиск данных предоплаты по TransactionId исходного платежа - используется
// при проверке подлинности Refund-уведомления (для получения пароля терминала).
Функция НайтиДанныеПредоплатыПоTransactionId(Знач TransactionId) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура("Найдено, Пароль", Ложь, "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	омг_НастройкиTipTop.Пароль КАК Пароль
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|		ПО омг_Предоплаты.Заявка.Филиал.Организация = омг_НастройкиTipTop.Организация
	|ГДЕ
	|	омг_Предоплаты.TransactionId = &TransactionId";
	
	Запрос.УстановитьПараметр("TransactionId", TransactionId);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.Найдено = Истина;
		Результат.Пароль = Выборка.Пароль;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Отменяет ранее созданную ссылку на оплату (заказ) в TipTop Pay.
// Отмена возможна пока предоплата в статусе ОжиданиеОплаты или уже
// переведена в НетОплаты (ссылка технически ещё может быть оплачиваемой
// у TipTop, пока её явно не отменить) - но не после ОплатаПринята
// (для этого случая нужен возврат - омг_СделатьВозвратПредоплаты).
//
// Параметры:
//  ДокументОснование - ДокументСсылка.ОплатаПлатежнойКартой
//
// Возвращаемое значение:
//  Структура("Успех, ТекстОшибки")
//
Функция омг_ОтменитьСсылкуНаПредоплату(Знач ДокументОснование) Экспорт
	
	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	омг_Предоплаты.Заявка КАК Заявка,
	|	омг_Предоплаты.OrderId КАК OrderId,
	|	омг_Предоплаты.Статус КАК Статус,
	|	омг_НастройкиTipTop.Логин КАК Логин,
	|	омг_НастройкиTipTop.Пароль КАК Пароль
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|		ПО омг_Предоплаты.Заявка.Филиал.Организация = омг_НастройкиTipTop.Организация
	|ГДЕ
	|	омг_Предоплаты.ПлатежныйДокумент = &ПлатежныйДокумент";
	
	Запрос.УстановитьПараметр("ПлатежныйДокумент", ДокументОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Результат.ТекстОшибки = "Не найдена запись предоплаты по документу.";
		Возврат Результат;
	КонецЕсли;
	
	Если Выборка.Статус <> Перечисления.омг_СтатусыПредоплаты.ОжиданиеОплаты
		И Выборка.Статус <> Перечисления.омг_СтатусыПредоплаты.НетОплаты
	Тогда
		Результат.ТекстОшибки = "Отменить ссылку можно только пока оплата не подтверждена (текущий статус: "
			+ Выборка.Статус + "). Если оплата уже прошла - используйте возврат.";
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Выборка.OrderId) Тогда
		Результат.ТекстОшибки = "Не найден идентификатор заказа (OrderId) - невозможно отменить.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		СоединениеHTTP = Новый HTTPСоединение("api.tiptoppay.kz",,Выборка.Логин,Выборка.Пароль,,,Новый ЗащищенноеСоединениеOpenSSL(),);
		ЗаголовокЗапросаHTTP = Новый Соответствие();
		ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
		ЗапросHTTP = Новый HTTPЗапрос("/orders/cancel", ЗаголовокЗапросаHTTP);
		
		СтруктураОтправки = Новый Структура("Id", Выборка.OrderId);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
		ЗапросHTTP.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
		
		Ответ = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
		
		Если Ответ.КодСостояния = 200 Тогда
			
			Сообщение = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Сообщение);
			ДанныеВозврата = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Если ТипЗнч(ДанныеВозврата) = Тип("Структура") И ДанныеВозврата.Свойство("Success") И ДанныеВозврата.Success Тогда
				
				УстановитьПривилегированныйРежим(Истина);
				
				Запись = РегистрыСведений.омг_Предоплаты.СоздатьМенеджерЗаписи();
				Запись.Заявка = Выборка.Заявка;
				Запись.РегистраторЗаписи = ДокументОснование;
				Запись.Прочитать();
				Если Запись.Выбран() Тогда
					Запись.Статус = Перечисления.омг_СтатусыПредоплаты.НетОплаты;
					Запись.Записать();
				КонецЕсли;
				
				ЗаявкаОбъект = Выборка.Заявка.Ссылка.ПолучитьОбъект();
				Если Не ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена Тогда
					МенеджерЗаписи = РегистрыСведений.ОчередьЗаявокНаОтмену.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.Заявка = Выборка.Заявка;
					МенеджерЗаписи.ДатаВремя = ТекущаяДата();
					МенеджерЗаписи.Записать();
				КонецЕсли;
				
				УстановитьПривилегированныйРежим(Ложь);
				
				Результат.Успех = Истина;
				
			Иначе
				Результат.ТекстОшибки = "TipTop Pay вернул ошибку: " + Сообщение;
				ЗаписьЖурналаРегистрации("омг_Предоплата.омг_ОтменитьСсылкуНаПредоплату", УровеньЖурналаРегистрации.Ошибка,,, Результат.ТекстОшибки);
			КонецЕсли;
			
		Иначе
			Результат.ТекстОшибки = "HTTP " + Ответ.КодСостояния + " при вызове /orders/cancel";
			ЗаписьЖурналаРегистрации("омг_Предоплата.омг_ОтменитьСсылкуНаПредоплату", УровеньЖурналаРегистрации.Ошибка,,, Результат.ТекстОшибки);
		КонецЕсли;
		
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("омг_Предоплата.омг_ОтменитьСсылкуНаПредоплату", УровеньЖурналаРегистрации.Ошибка,,, Результат.ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Регламентное задание: обрабатывает три независимо настраиваемых таймаута
// жизненного цикла ссылки на предоплату, отсчитываемых от омг_Предоплаты.ДатаСоздания:
//  1) смена локального статуса ОжиданиеОплаты -> НетОплаты;
//  2) отмена Заявки, если оплата так и не подтверждена;
//  3) аннулирование ссылки на оплату в TipTop Pay (/orders/cancel).
// Каждое действие включается и настраивается отдельно в омг_НастройкиTipTop
// в разрезе организации/филиала. Действие 3 переиспользует уже написанную
// омг_ОтменитьСсылкуНаПредоплату - без дублирования логики отмены.
Процедура омг_ОбработатьТаймаутыПредоплаты() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	омг_Предоплаты.Заявка КАК Заявка,
	|	омг_Предоплаты.ПлатежныйДокумент КАК ПлатежныйДокумент,
	|	омг_Предоплаты.Статус КАК Статус,
	|	омг_Предоплаты.ДатаСоздания КАК ДатаСоздания,
	|	ЕСТЬNULL(омг_НастройкиTipTop.омг_ИспользоватьСменуСтатусаНетОплаты, ЛОЖЬ) КАК ИспользоватьСменуСтатуса,
	|	ЕСТЬNULL(омг_НастройкиTipTop.омг_МинутыДоСменыСтатусаНетОплаты, 0) КАК МинутыДоСмены,
	|	ЕСТЬNULL(омг_НастройкиTipTop.омг_ИспользоватьТаймаутОтменыЗаявки, ЛОЖЬ) КАК ИспользоватьОтменуЗаявки,
	|	ЕСТЬNULL(омг_НастройкиTipTop.омг_МинутыДоТаймаутОтменыЗаявки, 0) КАК МинутыДоОтменыЗаявки,
	|	ЕСТЬNULL(омг_НастройкиTipTop.омг_ИспользоватьАннулированиеСсылки, ЛОЖЬ) КАК ИспользоватьАннулирование,
	|	ЕСТЬNULL(омг_НастройкиTipTop.омг_МинутыДоАннулированияСсылки, 0) КАК МинутыДоАннулирования
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка КАК ЗаявкаКонтроль
	|		ПО омг_Предоплаты.Заявка = ЗаявкаКонтроль.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|		ПО (ЗаявкаКонтроль.Филиал.Организация = омг_НастройкиTipTop.Организация)
	|ГДЕ
	|	омг_Предоплаты.Статус В (ЗНАЧЕНИЕ(Перечисление.омг_СтатусыПредоплаты.ОжиданиеОплаты), ЗНАЧЕНИЕ(Перечисление.омг_СтатусыПредоплаты.НетОплаты))
	|	И омг_Предоплаты.ДатаСоздания <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И ЗаявкаКонтроль.ОМГ_ПричинаОтсутствияПредоплаты = ЗНАЧЕНИЕ(Справочник.ОМГ_ПричинаОтсутствияПредоплаты.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			Если Не ЗначениеЗаполнено(Выборка.ПлатежныйДокумент)
				ИЛИ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ПлатежныйДокумент, "Ссылка") = Неопределено
			Тогда
				Продолжить;
			КонецЕсли;
			
			МинутыПрошло = (ТекущаяДата() - Выборка.ДатаСоздания) / 60;
			
			// Действие 1: смена статуса на "Нет оплаты"
			Если Выборка.Статус = Перечисления.омг_СтатусыПредоплаты.ОжиданиеОплаты
				И Выборка.ИспользоватьСменуСтатуса
				И Выборка.МинутыДоСмены > 0
				И МинутыПрошло >= Выборка.МинутыДоСмены
			Тогда
				
				Запись = РегистрыСведений.омг_Предоплаты.СоздатьМенеджерЗаписи();
				Запись.Заявка = Выборка.Заявка;
				Запись.РегистраторЗаписи = Выборка.ПлатежныйДокумент;
				Запись.Прочитать();
				Если Запись.Выбран() И Запись.Статус = Перечисления.омг_СтатусыПредоплаты.ОжиданиеОплаты Тогда
					Запись.Статус = Перечисления.омг_СтатусыПредоплаты.НетОплаты;
					Запись.Записать();
				КонецЕсли;
				
			КонецЕсли;
			
			// Действие 2: отмена Заявки (существование объекта гарантировано ВНУТРЕННИМ СОЕДИНЕНИЕМ в запросе)
			Если Выборка.ИспользоватьОтменуЗаявки
				И Выборка.МинутыДоОтменыЗаявки > 0
				И МинутыПрошло >= Выборка.МинутыДоОтменыЗаявки
				Тогда
				
				ЗаявкаОбъект = Выборка.Заявка.ПолучитьОбъект();
				Если ЗаявкаОбъект = Неопределено Тогда
					// Ссылка удалена между выполнением запроса и обработкой строки - пропускаем.
					Продолжить;
				КонецЕсли;
				
				Если Не ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена
					И Не ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована
					Тогда  
					
					//ЗаявкаОбъект.ОМГ_ПричинаОтсутствияПредоплаты = Справочники.ОМГ_ПричинаОтсутствияПредоплаты.ПредопределенныйНетОплатыБронирования;
					//ЗаявкаОбъект.ОтменитьЗаявку(Ложь, Справочники.ВидыСостоянийЗаявок.Отменена); 
					ПричинаОтменыЗаявок = Справочники.ПричиныОтменыЗаявок.НайтиПоНаименованию("Нет оплаты бронирования"); 
					
					Если ПричинаОтменыЗаявок = Неопределено Тогда	
						ЗаявкаОбъект.ОтменитьЗаявку(Ложь, Справочники.ВидыСостоянийЗаявок.Отменена);
					иначе
						
						СтруктураЗаписи = Новый Структура;
						СтруктураЗаписи.Вставить("Период", 					ТекущаяДата());
						СтруктураЗаписи.Вставить("Заявка", 					ЗаявкаОбъект);
						СтруктураЗаписи.Вставить("ПричинаОтменыЗаявки", 	ПричинаОтменыЗаявок);
						СтруктураЗаписи.Вставить("Комментарий",				 "Нет оплаты бронирования");
						СтруктураЗаписи.Вставить("Ответственный",			);
						СтруктураЗаписи.Вставить("СостояниеПередЗакрытием",	ЗаявкаОбъект.Состояние);
						
						КалендарьПланирования.ОтменитьЗаявкуСервер(СтруктураЗаписи, ЗаявкаОбъект.Ссылка, Справочники.ВидыСостоянийЗаявок.Отменена);
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;

			// Действие 3: аннулирование ссылки у TipTop Pay
			Если Выборка.ИспользоватьАннулирование
				И Выборка.МинутыДоАннулирования > 0
				И МинутыПрошло >= Выборка.МинутыДоАннулирования
			Тогда
				
				РезультатОтмены = омг_ОтменитьСсылкуНаПредоплату(Выборка.ПлатежныйДокумент);
				Если Не РезультатОтмены.Успех Тогда
					ЗаписьЖурналаРегистрации("омг_Предоплата.омг_ОбработатьТаймаутыПредоплаты", УровеньЖурналаРегистрации.Предупреждение,,,
						"Аннулирование ссылки, ПлатежныйДокумент=" + Выборка.ПлатежныйДокумент + "; " + РезультатОтмены.ТекстОшибки);
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			ЗаписьЖурналаРегистрации("омг_Предоплата.омг_ОбработатьТаймаутыПредоплаты", УровеньЖурналаРегистрации.Ошибка,,,
				"Заявка=" + Выборка.Заявка + "; ПлатежныйДокумент=" + Выборка.ПлатежныйДокумент + "; " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры         

// Возвращает Истина, если по платежному документу статус предоплаты хотя бы
// один раз достигал значения ОплатаПринята. Признак не сбрасывается при
// последующей смене статуса (НетОплаты, ПроизведенВозврат и т.п.).
Функция омг_ОплатаКогдаЛибоБылаПринята(ПлатежныйДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	омг_Предоплаты.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	|ГДЕ
	|	омг_Предоплаты.ПлатежныйДокумент = &ПлатежныйДокумент
	|	И омг_Предоплаты.Статус = Значение(Перечисление.омг_СтатусыПредоплаты.ОплатаПринята)";
	
	Запрос.УстановитьПараметр("ПлатежныйДокумент", ПлатежныйДокумент);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ВернутьДатуПереходаУчетаПоЗаявкам(Организация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	омг_НастройкиTipTop.ДатаПереходаНаУчетПоЗаявкам КАК ДатаПереходаНаУчетПоЗаявкам
	|ИЗ
	|	РегистрСведений.омг_НастройкиTipTop КАК омг_НастройкиTipTop
	|ГДЕ
	|	омг_НастройкиTipTop.Организация = &Организация
	|	И омг_НастройкиTipTop.ДатаПереходаНаУчетПоЗаявкам <> &ПустаяДата";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Возврат	ВыборкаДетальныеЗаписи.ДатаПереходаНаУчетПоЗаявкам
	
	иначе
		
		Возврат Дата(1,1,1) 
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти
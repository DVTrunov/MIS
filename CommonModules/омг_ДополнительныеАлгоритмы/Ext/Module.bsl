Процедура УстановитьЗапретСортировки(Список, ПоляСортировки = Неопределено, ПоляОграничения = Неопределено) Экспорт

    ЗапрещенныеСортировки = Новый Массив;

    РазрешенныеПоля = Новый Массив;
	Если ПоляСортировки = Неопределено Тогда
	    РазрешенныеПоля.Добавить("НОМЕР");
	    РазрешенныеПоля.Добавить("ДАТА");
	Иначе
		МассивПолей = СтрРазделить(ВРег(ПоляСортировки), ",");
		Для Каждого Поле Из МассивПолей Цикл
	    	РазрешенныеПоля.Добавить(Поле);
		КонецЦикла;
	КонецЕсли;    
	
	Если Не ПоляОграничения = Неопределено Тогда
		ПоляОграниченияМассив = СтрРазделить(ВРег(ПоляОграничения), ",");
	КонецЕсли;
	

    ДоступныеПоляПорядка = Список.КомпоновщикНастроек.Настройки.ДоступныеПоляПорядка.Элементы;

    Для Каждого ДоступноеПоле Из ДоступныеПоляПорядка Цикл
        
        ИмяПоля = Строка(ДоступноеПоле.Поле);

		Если РазрешенныеПоля.Найти(ВРег(ИмяПоля)) = Неопределено Тогда
			Если ПоляОграничения = Неопределено Тогда
            	ЗапрещенныеСортировки.Добавить(ИмяПоля);
			ИначеЕсли ПоляОграниченияМассив.Найти(ИмяПоля) = Неопределено Тогда 
            	ЗапрещенныеСортировки.Добавить(ИмяПоля);
			КонецЕсли;
        КонецЕсли;

    КонецЦикла;

    Если ЗапрещенныеСортировки.Количество() > 0 Тогда
        Список.УстановитьОграниченияИспользованияВПорядке(ЗапрещенныеСортировки);
    КонецЕсли;

КонецПроцедуры



Функция ВернутьАктуальностьСоглашения(Соглашение,ДатаПроверки) Экспорт
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоглашенияСтрахования.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Справочник.СоглашенияСтрахования КАК СоглашенияСтрахования
		|ГДЕ
		|	СоглашенияСтрахования.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Соглашение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		
		Если ВыборкаДетальныеЗаписи.ДатаОкончания >= ДатаПроверки Тогда
			 Возврат Истина
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция омг_ВернутьОрганизациюПоФилиалу(Филиал) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Филиалы.Организация КАК Организация
		|ИЗ
		|	Справочник.Филиалы КАК Филиалы
		|ГДЕ
		|	Филиалы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Филиал);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Организация
	КонецЕсли;
	
	Возврат Справочники.Организации.ПустаяСсылка(); 

КонецФункции

Функция ПроверкаВозвратовОказанийУслуг(ДокументОснование = Неопределено,ДокументВозврат = Неопределено, ЭтоПроведение = Ложь,ВозвратИсключение = Неопределено, СуммаВозвратаТек = 0) Экспорт
	
	Если ДокументОснование = Неопределено Тогда 
		
		ДокументОснование = ДокументВозврат.ДокументОснование 
		
	КонецЕсли; 
	
	Если ВозвратИсключение = Неопределено Тогда 
		
		ВозвратИсключение = Документы.ОказаниеУслуг.ПустаяСсылка() 
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ОказаниеУслугРаботы.Ссылка.СуммаДокумента, 0)) КАК СуммаДокумента
	|ИЗ
	|	Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
	|ГДЕ
	|	ОказаниеУслугРаботы.Ссылка = &Основание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ОказаниеУслугРаботы.Ссылка.СуммаДокумента, 0)) КАК СуммаДокумента
	|ИЗ
	|	Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
	|ГДЕ
	|	ОказаниеУслугРаботы.Ссылка.ДокументОснование = &Основание
	|	И ОказаниеУслугРаботы.Ссылка.Проведен
	|	И ОказаниеУслугРаботы.Ссылка <> &ВозвратИсключение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОказаниеУслугРаботы.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ОказаниеУслугРаботы.Количество, 0) КАК Количество,
	|	СУММА(ЕСТЬNULL(ОказаниеУслугРаботы1.Количество, 0)) КАК Количество1
	|ИЗ
	|	Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы1
	|		ПО ОказаниеУслугРаботы.Ссылка = ОказаниеУслугРаботы1.Ссылка.ДокументОснование
	|			И ОказаниеУслугРаботы.Номенклатура = ОказаниеУслугРаботы1.Номенклатура
	|ГДЕ
	|	ОказаниеУслугРаботы.Ссылка = &Основание
	|	И ОказаниеУслугРаботы1.Ссылка.Проведен
	|	И ОказаниеУслугРаботы1.Ссылка <> &ВозвратИсключение
	|
	|СГРУППИРОВАТЬ ПО
	|	ОказаниеУслугРаботы.Номенклатура,
	|	ЕСТЬNULL(ОказаниеУслугРаботы.Количество, 0)";
	
	Запрос.УстановитьПараметр("Основание", ДокументОснование);
	Запрос.УстановитьПараметр("ВозвратИсключение",ВозвратИсключение);                                       
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ОснованиеСумма = РезультатЗапроса[0].Выбрать();
	ОснованиеСумма.Следующий();
	ОснованиеСумма = ОснованиеСумма.СуммаДокумента;
	
	ВозвратыСумма = РезультатЗапроса[1].Выбрать();
	
	ВозвратыСумма.Следующий();
	ВозвратыСумма = ?(ВозвратыСумма.СуммаДокумента = NULL,0,ВозвратыСумма.СуммаДокумента);
	
	СуммаВозвратаТек = СуммаВозвратаТек - ВозвратИсключение.омг_СуммаПредоплатыСписать;	 
	
	ВозвратыСумма = ВозвратыСумма + СуммаВозвратаТек;
	
	Если ВозвратыСумма > ОснованиеСумма Тогда 
		Возврат "По документу " + ДокументОснование + " превышение суммы возврата!";
	КонецЕсли; 
	
	ВыборкаНоменклатура = РезультатЗапроса[2].Выбрать();
	
	Если ЭтоПроведение Тогда
		ВозЗначение = Новый ТаблицаЗначений;
		ВозЗначение.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ВозЗначение.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	иначе
		ВозЗначение = "По документу " + ДокументОснование + " были возвращены все услуги!";
	КонецЕсли;
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		Если ВыборкаНоменклатура.Количество > ВыборкаНоменклатура.Количество1 Тогда
			Если ЭтоПроведение Тогда
				НоваяСтрока = ВозЗначение.Добавить();
				НоваяСтрока.Номенклатура = ВыборкаНоменклатура.Номенклатура;
				НоваяСтрока.Количество = ВыборкаНоменклатура.Количество - ВыборкаНоменклатура.Количество1;
			иначе
				ВозЗначение = "";
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;     
	
	Возврат ВозЗначение;

КонецФункции	

Функция ПолучитьСписокПросматривающих(СсылкаНаДокумент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозЗначение = "";
	
	МассивСеансов = ПолучитьСеансыИнформационнойБазы();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОткрытыеДокументы.Пользователь.Наименование КАК Пользователь,
	|	ОткрытыеДокументы.ДатаОткрытия КАК ДатаОткрытия,
	|	ОткрытыеДокументы.Пользователь КАК ПользовательСсылка,
	|	ОткрытыеДокументы.НачалоСеанса КАК НачалоСеанса,
	|	ОткрытыеДокументы.НомерСеанса КАК НомерСеанса,
	|	ОткрытыеДокументы.УникальныйИдентификаторПользователяИБ КАК УникальныйИдентификаторПользователяИБ
	|ИЗ
	|	РегистрСведений.омг_ОткрытыеДокументы КАК ОткрытыеДокументы
	|ГДЕ
	|	ОткрытыеДокументы.Документ = &СсылкаНаДокумент";
	
	Запрос.УстановитьПараметр("СсылкаНаДокумент", СсылкаНаДокумент);
	
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НайденСеанс = Ложь;	
		Для Каждого Сеанс Из МассивСеансов Цикл
			Если Сеанс.НомерСеанса = ВыборкаДетальныеЗаписи.НомерСеанса 
				и Сеанс.НачалоСеанса = ВыборкаДетальныеЗаписи.НачалоСеанса 
				и Строка(Сеанс.Пользователь.УникальныйИдентификатор) = ВыборкаДетальныеЗаписи.УникальныйИдентификаторПользователяИБ Тогда
				ВозЗначение = ВозЗначение + ВыборкаДетальныеЗаписи.Пользователь + ". Дата/время открытия: "+  ВыборкаДетальныеЗаписи.ДатаОткрытия+"; " + Символы.ПС;
				НайденСеанс = Истина;
				прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если не НайденСеанс Тогда
			
			МенеджерЗаписи = РегистрыСведений.омг_ОткрытыеДокументы.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Документ     = СсылкаНаДокумент;
			МенеджерЗаписи.Пользователь = ВыборкаДетальныеЗаписи.ПользовательСсылка; 
			МенеджерЗаписи.НачалоСеанса = ВыборкаДетальныеЗаписи.НачалоСеанса;
			МенеджерЗаписи.НомерСеанса = ВыборкаДетальныеЗаписи.НомерСеанса;
			МенеджерЗаписи.УникальныйИдентификаторПользователяИБ = ВыборкаДетальныеЗаписи.УникальныйИдентификаторПользователяИБ;
			МенеджерЗаписи.Удалить();
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ВозЗначение;
	

КонецФункции     

Функция ДатаНачалаСеанса(НомерСеанса) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивСеансов = ПолучитьСеансыИнформационнойБазы();
	
	Для Каждого Сеанс Из МассивСеансов Цикл
		Если Сеанс.НомерСеанса = НомерСеанса Тогда
			Возврат Сеанс.НачалоСеанса;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Дата('00010101');
	
КонецФункции

Функция ПроверитьДокументыНаОсновании(ЭтаЗаявкаСсылка) Экспорт
	  
	  	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Прием.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Прием КАК Прием
		|ГДЕ
		|	Прием.ДокументОснование = &ЭтаЗаявкаСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОказаниеУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.ДокументОснование = &ЭтаЗаявкаСсылка
		|	И НЕ ОказаниеУслуг.НомерЧекаККМ = 0";
	
	Запрос.УстановитьПараметр("ЭтаЗаявкаСсылка", ЭтаЗаявкаСсылка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать();  
	ВыборкаДетальныеЗаписи1 = РезультатЗапроса[1].Выбрать();

	
	Если ВыборкаДетальныеЗаписи.Следующий() или ВыборкаДетальныеЗаписи1.Следующий() Тогда
		
		Возврат Истина
		
	иначе
		
		Возврат ложь
		
	КонецЕсли;



Функция ПолучитьЗначениеПараметраМедкарты(Док, КодПараметра, ИмяПараметра) Экспорт
	
	ЗаполняемыеПараметры = Док.МедицинскаяКарта.ЗаполняемыеПараметры;
	
	НужноеЗначение = "";
	Для каждого СтрокаПараметра Из ЗаполняемыеПараметры Цикл
		Если СтрокаПараметра.ИмяПараметра.Код = КодПараметра Тогда
			НужноеЗначение = СтрокаПараметра.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(НужноеЗначение) Тогда
		ДанныеПараметров = МедицинскаяДеятельность.ПолучитьВычисляемыеЗначенияПараметровМедкарты(Док.МедицинскаяКарта, 
		Док.МедицинскаяКарта.ВидКарты, Док.МедицинскаяКарта.ЗаполняемыеПараметры);
		
		
		НужноеЗначение = "";
		Для каждого СтрокаПараметра Из ДанныеПараметров.Параметры Цикл
			Если СтрокаПараметра.Ключ = ИмяПараметра Тогда
				Если ЗначениеЗаполнено(СтрокаПараметра.Значение.ВычисленноеЗначение) Тогда
					НужноеЗначение = СтрокаПараметра.Значение.ВычисленноеЗначение.Значение;
				Иначе
					НужноеЗначение = "";
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
	
	Результат = НужноеЗначение; 
	
КонецФункции

Функция ВернутьСписокУслугСприоритетом(МассивГрупп) Экспорт
	
 	Если МассивГрупп.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	СоответствиеИсходныхГрупп = Новый Соответствие;
	Для Каждого Группа Из МассивГрупп Цикл
		СоответствиеИсходныхГрупп.Вставить(Группа, Истина);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Родитель КАК Родитель,
		|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В ИЕРАРХИИ(&МассивГрупп)
		|	И НЕ Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("МассивГрупп", МассивГрупп);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СоответствиеРодителей = Новый Соответствие;
	МассивУслуг            = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		СоответствиеРодителей.Вставить(Выборка.Ссылка, Выборка.Родитель);
		Если Не Выборка.ЭтоГруппа Тогда
			МассивУслуг.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	ТабВозврата = Новый ТаблицаЗначений;
	ТабВозврата.Колонки.Добавить("Услуга",               Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТабВозврата.Колонки.Добавить("Приоритет",            Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	ТабВозврата.Колонки.Добавить("ИсходнаяУслугаГруппа", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Для Каждого Услуга Из МассивУслуг Цикл
		
		ИсходнаяГруппа          = Неопределено;
		Приоритет               = 1;
		НепосредственныйРодитель = СоответствиеРодителей.Получить(Услуга);
		ТекущийРодитель          = НепосредственныйРодитель;
		
		Пока ЗначениеЗаполнено(ТекущийРодитель) Цикл
			Если СоответствиеИсходныхГрупп.Получить(ТекущийРодитель) <> Неопределено Тогда
				ИсходнаяГруппа = ТекущийРодитель;
				Прервать;
			КонецЕсли;
			Приоритет       = Приоритет + 1;
			ТекущийРодитель = СоответствиеРодителей.Получить(ТекущийРодитель);
		КонецЦикла;
		
		Если ИсходнаяГруппа = Неопределено Тогда
			// Нештатная ситуация: цепочка родителей не привела к исходной группе.
			ИсходнаяГруппа = НепосредственныйРодитель;
			Приоритет      = 1;
		КонецЕсли;
		
		СтрокаТаб = ТабВозврата.Добавить();
		СтрокаТаб.Услуга               = Услуга;
		СтрокаТаб.Приоритет            = Приоритет;
		СтрокаТаб.ИсходнаяУслугаГруппа = ИсходнаяГруппа;
		
	КонецЦикла;
	
	Возврат ТабВозврата;
	
КонецФункции	



// Параметры:
//  МассивНоменклатуры - Массив из СправочникСсылка.Номенклатура - начальные элементы.
//
// Возвращаемое значение:
//  Соответствие - Ключ СправочникСсылка.Номенклатура, Значение СправочникСсылка.Номенклатура (родитель).
//        

Функция ПолучитьЦепочкиРодителейНоменклатуры(МассивНоменклатуры) Экспорт
	
	СоответствиеРодителей = Новый Соответствие;
	
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат СоответствиеРодителей;
	КонецЕсли;
	
	ТекущийУровень = МассивНоменклатуры;
	
	Пока ТекущийУровень.Количество() > 0 Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка,
			|	Номенклатура.Родитель КАК Родитель
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Ссылка В(&ТекущийУровень)";
		
		Запрос.УстановитьПараметр("ТекущийУровень", ТекущийУровень);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		НовыеРодители = Новый Соответствие;
		
		Пока Выборка.Следующий() Цикл
			
			СоответствиеРодителей.Вставить(Выборка.Ссылка, Выборка.Родитель);
			
			Если ЗначениеЗаполнено(Выборка.Родитель) И СоответствиеРодителей.Получить(Выборка.Родитель) = Неопределено Тогда
				НовыеРодители.Вставить(Выборка.Родитель, Истина);
			КонецЕсли;
			
		КонецЦикла;
		
		ТекущийУровень = Новый Массив;
		Для Каждого КлючЗначение Из НовыеРодители Цикл
			ТекущийУровень.Добавить(КлючЗначение.Ключ);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СоответствиеРодителей;
	
КонецФункции           

 // Сравнивает старую и новую таблицы УслугиПодробно (колонки Услуга, Приоритет,
// ИсходнаяУслугаГруппа) по ключу Услуга.
//
// Возвращаемое значение:
//  Структура(Удаленные, Добавленные, Измененные) - каждое поле Массив из
//  СправочникСсылка.Номенклатура.
Функция ВычислитьДиффУслуг(СтараяТаблица, НоваяТаблица) Экспорт
	
	СтараяПоУслуге = Новый Соответствие;
	Для Каждого Строка Из СтараяТаблица Цикл
		СтараяПоУслуге.Вставить(Строка.Услуга, Строка);
	КонецЦикла;
	
	НоваяПоУслуге = Новый Соответствие;
	Для Каждого Строка Из НоваяТаблица Цикл
		НоваяПоУслуге.Вставить(Строка.Услуга, Строка);
	КонецЦикла;
	
	Удаленные   = Новый Массив;
	Добавленные = Новый Массив;
	Измененные  = Новый Массив;
	
	Для Каждого Строка Из СтараяТаблица Цикл
		НоваяСтрока = НоваяПоУслуге.Получить(Строка.Услуга);
		Если НоваяСтрока = Неопределено Тогда
			Удаленные.Добавить(Строка.Услуга);
		ИначеЕсли НоваяСтрока.Приоритет <> Строка.Приоритет Или НоваяСтрока.ИсходнаяУслугаГруппа <> Строка.ИсходнаяУслугаГруппа Тогда
			Измененные.Добавить(Строка.Услуга);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из НоваяТаблица Цикл
		Если СтараяПоУслуге.Получить(Строка.Услуга) = Неопределено Тогда
			Добавленные.Добавить(Строка.Услуга);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Удаленные, Добавленные, Измененные", Удаленные, Добавленные, Измененные);
	
КонецФункции

Функция ВернутьОказанияУслугПоЗаявке(Заявка) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОказаниеУслугЗаявки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОказаниеУслуг.Заявки КАК ОказаниеУслугЗаявки
		|ГДЕ
		|	ОказаниеУслугЗаявки.Заявка.Ссылка = &Заявка
		|
		|СГРУППИРОВАТЬ ПО
		|	ОказаниеУслугЗаявки.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОказаниеУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.Ссылка.ДокументОснование.Ссылка = &Заявка";
	
	Запрос.УстановитьПараметр("Заявка", Заявка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВозМассив = РезультатЗапроса[0].Выгрузить(); 
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		 ЗаполнитьЗначенияСвойств(ВозМассив.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;	
	
	ВозМассив.Свернуть("Ссылка");
	ВозМассив = ВозМассив.ВыгрузитьКолонку("Ссылка");
		 
	Возврат ВозМассив;
	
КонецФункции	

Функция ПолучитьОрганизациюСотрудника() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ЗначениеНастроек.Значение КАК Значение
	             |ИЗ
	             |	ПланВидовХарактеристик.НастройкиПользователей КАК Настройки
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПользователей КАК ЗначениеНастроек
	             |		ПО (ЗначениеНастроек.Настройка = Настройки.Ссылка)
	             |			И (ЗначениеНастроек.Пользователь = &Пользователь)
	             |ГДЕ
	             |	НЕ Настройки.ПометкаУдаления
	             |	И Настройки.Ссылка = &омг_ОсновнаяОрганизация
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Настройки.ЭтоГруппа ИЕРАРХИЯ,
	             |	Настройки.Наименование";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("омг_ОсновнаяОрганизация",ПланыВидовХарактеристик.НастройкиПользователей.омг_ОсновнаяОрганизация);
    Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Значение;

КонецФункции   


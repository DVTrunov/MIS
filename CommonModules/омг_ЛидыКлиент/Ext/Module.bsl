// Действия с лидом из клиентских форм: окно входящего трафика и вкладка «Лиды»
// в «Массовых обзвонах». Форма-владелец передаётся параметром.

#Область ПрограммныйИнтерфейс

Процедура ВзятьВРаботу(Лид) Экспорт
	
	ТекстОшибки = омг_ЛидыВызовСервера.ВзятьВРаботу(Лид);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	ОповеститьОбИзменении(Лид);
	
КонецПроцедуры

// Начинает звонок через Битфон по номеру лида.
//
// Возвращаемое значение:
//  Булево - Истина, если звонок начат.
//
Функция Позвонить(Лид) Экспорт
	
	ДанныеЛида = омг_ЛидыВызовСервера.ДанныеДляЗвонка(Лид);
	Если ЗначениеЗаполнено(ДанныеЛида.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ДанныеЛида.ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	ОповеститьОбИзменении(Лид);
	
	доп_БитфонКлиент.ОткрытьБитфонНачатьРазговор(ДанныеЛида.Телефон);
	Возврат Истина;
	
КонецФункции

Процедура ОткрытьРезультатЗвонка(Лид, Форма) Экспорт
	
	ДополнительныеПараметры = Новый Структура("Лид, Форма", Лид, Форма);
	Оповещение = Новый ОписаниеОповещения("РезультатЗвонкаЗавершение", омг_ЛидыКлиент, ДополнительныеПараметры);
	ОткрытьФорму("Обработка.омг_ОкноВходящегоТрафика.Форма.ФормаРезультатаЗвонка", Новый Структура("Лид", Лид),
		Форма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура РезультатЗвонкаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОповеститьОбИзменении(ДополнительныеПараметры.Лид);
	Если Результат = "Записать" Тогда
		ОбработатьЛидСКлиентом(ДополнительныеПараметры.Лид, "Записать", ДополнительныеПараметры.Форма);
	КонецЕсли;
	
КонецПроцедуры

// Действие "Записать" (календарь) или "Карточка" (открыть карточку пациента).
// Если клиент по телефону не найден, открывается стандартный поиск клиента по ИИН
// (ОбщаяФорма.ФормаПоискаКлиентаУпр_85) с ФИО и телефоном из лида. Выбранный там клиент
// приходит в ОбработкаВыбора формы-владельца, которая вызывает ОбработкаВыбораКлиента.
//
Процедура ОбработатьЛидСКлиентом(Лид, Действие, Форма) Экспорт
	
	ДанныеЗаписи = омг_ЛидыВызовСервера.ПодготовитьЗапись(Лид);
	Если ЗначениеЗаполнено(ДанныеЗаписи.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ДанныеЗаписи.ТекстОшибки);
		Возврат;
	КонецЕсли;
	ОповеститьОбИзменении(Лид);
	
	Если ЗначениеЗаполнено(ДанныеЗаписи.Клиент) Тогда
		ПродолжитьСКлиентом(Лид, ДанныеЗаписи.Клиент, Действие);
		Возврат;
	КонецЕсли;
	
	ПараметрыПриложения.Вставить(ИмяПараметраОжиданияКлиента(),
		Новый Структура("Лид, Действие, ИдентификаторФормы", Лид, Действие, Форма.УникальныйИдентификатор));
	ФормаПоиска = ОткрытьФорму("ОбщаяФорма.ФормаПоискаКлиентаУпр_85", , Форма, Новый УникальныйИдентификатор);
	Если ФормаПоиска <> Неопределено Тогда
		ФормаПоиска.ФИО = ДанныеЗаписи.ФИО;
		ФормаПоиска.Телефон = ТелефонПоМаске(ДанныеЗаписи.Телефон, ФормаПоиска.Элементы.Телефон.Маска);
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из ОбработкаВыбора формы-владельца.
//
// Возвращаемое значение:
//  Булево - Истина, если выбор относился к лиду и обработан.
//
Функция ОбработкаВыбораКлиента(Форма, ВыбранноеЗначение) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("СправочникСсылка.Клиенты") Тогда
		Возврат Ложь;
	КонецЕсли;
	Ожидание = ПараметрыПриложения.Получить(ИмяПараметраОжиданияКлиента());
	Если Ожидание = Неопределено Или Ожидание.ИдентификаторФормы <> Форма.УникальныйИдентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	ПараметрыПриложения.Удалить(ИмяПараметраОжиданияКлиента());
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат Истина;
	КонецЕсли;
	
	омг_ЛидыВызовСервера.ПривязатьКлиента(Ожидание.Лид, ВыбранноеЗначение);
	ОповеститьОбИзменении(Ожидание.Лид);
	ПродолжитьСКлиентом(Ожидание.Лид, ВыбранноеЗначение, Ожидание.Действие);
	Возврат Истина;
	
КонецФункции

// Проверка очереди новых лидов для обработчика ожидания формы.
//
// Параметры:
//  ИзвестныйКлюч - Строка - ключ с прошлой проверки, обновляется.
//
// Возвращаемое значение:
//  Булево - Истина, если очередь изменилась (список нужно обновить).
//
Функция ПроверитьНовыеЛиды(ИзвестныйКлюч) Экспорт
	
	НовыйКлюч = омг_ЛидыВызовСервера.КлючНовыхЛидов();
	Если НовыйКлюч = ИзвестныйКлюч Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтарыеЧасти = СтрРазделить(ИзвестныйКлюч, "|");
	НовыеЧасти = СтрРазделить(НовыйКлюч, "|");
	ИзвестныйКлюч = НовыйКлюч;
	
	// Сообщаем, только если появился более свежий лид.
	Если НовыеЧасти.Количество() > 1 И СтарыеЧасти.Количество() > 1 И НовыеЧасти[1] > СтарыеЧасти[1] Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Новый лид'"), ,
			СтрШаблон(НСтр("ru = 'Ждут обработки: %1'"), НовыеЧасти[0]));
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

// Число лидов в очереди из ключа ПроверитьНовыеЛиды.
//
Функция КоличествоВОчереди(Ключ) Экспорт
	
	Части = СтрРазделить(Ключ, "|");
	Возврат Число("0" + Части[0]);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПродолжитьСКлиентом(Лид, Клиент, Действие)
	
	Если Действие = "Записать" Тогда
		ПараметрыЗаписи = омг_ЛидыВызовСервера.ПараметрыЗаписи(Лид);
		КалендарьПланированияКлиент.ОткрытьАктивизироватьКалендарьПланирования();
		Оповестить("НамерениеЗаписиПоДокументу", ПараметрыЗаписи, ПараметрыЗаписи.ДокументЗаписи);
	Иначе
		ПоказатьЗначение(, Клиент);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбИзменении(Лид)
	
	Оповестить("Запись_омг_Лид", , Лид);
	
КонецПроцедуры

Функция ИмяПараметраОжиданияКлиента()
	
	Возврат "омг_Лиды.ОжиданиеКлиента";
	
КонецФункции

// Телефон лида (цифры) в формате маски поля: девятки маски заменяются последними цифрами номера.
//
Функция ТелефонПоМаске(Цифры, Маска)
	
	Если Не ЗначениеЗаполнено(Маска) Тогда
		Возврат Цифры;
	КонецЕсли;
	Позиций = СтрЧислоВхождений(Маска, "9");
	Если Позиций = 0 Или СтрДлина(Цифры) < Позиций Тогда
		Возврат Цифры;
	КонецЕсли;
	Остаток = Прав(Цифры, Позиций);
	Результат = "";
	Для Н = 1 По СтрДлина(Маска) Цикл
		Символ = Сред(Маска, Н, 1);
		Если Символ = "9" Тогда
			Результат = Результат + Лев(Остаток, 1);
			Остаток = Сред(Остаток, 2);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

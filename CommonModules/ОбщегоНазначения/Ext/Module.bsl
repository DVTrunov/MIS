// Функция преобразует значение время значения типа Дата в Число - число секунд этого времени.
//
// Параметры:
//  ДатаВремя	 - Дата	 - дата.
// 
// Возвращаемое значение:
//  Число.
//
Функция ВремяВСекунды(ДатаВремя) Экспорт
	Если ТипЗнч(ДатаВремя) = Тип("Дата") Тогда
		Возврат ДатаВремя-НачалоДня(ДатаВремя);
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

// Функция возращает истина если Элемент имеет предка Предок в иерархичном справочнике.
//
// Параметры:
//  Элемент	 - СправочникСсылка	 - проверяемый элемент справочника.
//  Предок	 - СправочникСсылка	 - возможный элемент-предок справочника.
// 
// Возвращаемое значение:
//  Булево.
//
Функция ПроверкаРодственнойСвязи(Элемент,Предок) Экспорт
	Если Элемент.Родитель.Ссылка.Пустая() Тогда Возврат Ложь; КонецЕсли;
	Если Предок = Элемент.Родитель Тогда Возврат Истина; КонецЕсли;
	Если Элемент.Родитель.Родитель.Ссылка.Пустая() Тогда
		Возврат Ложь;	
	Иначе	
		Если ПроверкаРодственнойСвязи(Элемент.Родитель,Предок) Тогда Возврат Истина КонецЕсли;
    КонецЕсли;
    Возврат Ложь;
КонецФункции

// Функция возвращает строковое представление дня недели заданной даты.
//
// Параметры:
//  Дата - Дата	 - дата
// 
// Возвращаемое значение:
//  Строка - название дня недели.
//
Функция ПолучитьНаименованиеДняНедели(Дата) Экспорт 
	
	
	мДеньНедели = ДеньНедели(Дата);
	СтруктураНаименований = Новый Структура("Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье"
	                                         ,1,2,3,4,5,6,7);
	Для Каждого КлючЗначение Из СтруктураНаименований Цикл
		Если КлючЗначение.Значение = мДеньНедели Тогда
			
			Возврат КлючЗначение.Ключ;
			
		КонецЕсли;
	КонецЦикла;												
												 
	
КонецФункции

// Добавляет к префиксу номера/кода объекта префикс узла распределенной базы данных.
//
// Параметры:
//  Префикс	 - Строка	 - префикс.
//
Процедура ДобавитьПрефиксУзла(Префикс) Экспорт
	
	Если ПараметрыСеанса.ИспользованиеРИБ Тогда
		Префикс = ПараметрыСеанса.ПрефиксУзлаРаспределеннойИнформационнойБазы + Префикс;
	КонецЕсли;
	
КонецПроцедуры

// Добавляет к префиксу номера документа префикс кассы, выбранной в документе.
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъект	 - документ.
//  Префикс			 - Строка			 - префикс.
//
Процедура ДобавитьПрефиксКассы(ДокументОбъект, Префикс) Экспорт

	ИмяДокумента = ДокументОбъект.Метаданные().Имя;
	Если НЕ (ИмяДокумента="ПриходныйКассовыйОрдер" ИЛИ ИмяДокумента="РасходныйКассовыйОрдер")
		 ИЛИ НЕ ЗначениеЗаполнено(ДокументОбъект.Касса.Префикс)
	Тогда
		Если ПустаяСтрока(Префикс) Тогда
			Префикс = "0";
		КонецЕсли;
	Иначе
		Префикс = ДокументОбъект.Касса.Префикс;
	КонецЕсли;

КонецПроцедуры

// Заполняет в коллекции свойство "ВидНоменклатуры" по свойству "Номенклатура".
// Параметры:
//  КоллекцияНоменклатуры - Массив.
//
Процедура ЗаполнитьВидНоменклатурыВКоллекции(КоллекцияНоменклатуры) Экспорт
	
	Если ТипЗнч(КоллекцияНоменклатуры) = Тип("ТаблицаЗначений")
		И КоллекцияНоменклатуры.Колонки.Найти("ВидНоменклатуры") = Неопределено
	Тогда
		КоллекцияНоменклатуры.Колонки.Добавить("ВидНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыНоменклатуры"));
	КонецЕсли;
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого ЭлементКоллекции Из КоллекцияНоменклатуры Цикл
		МассивНоменклатуры.Добавить(ЭлементКоллекции.Номенклатура);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.ВидНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&Номенклатура)"
	;
	Выб = Запрос.Выполнить().Выбрать();
	Отбор = Новый Структура("Номенклатура");
	
	Для Каждого ЭлементКоллекции Из КоллекцияНоменклатуры Цикл
		
		Отбор.Номенклатура = ЭлементКоллекции.Номенклатура;
		Выб.Сбросить();
		Если Выб.НайтиСледующий(Отбор) Тогда
			ВидНоменклатуры = Выб.ВидНоменклатуры;
		Иначе
			ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ПустаяСсылка();
		КонецЕсли;
		
		Если ТипЗнч(КоллекцияНоменклатуры) = Тип("ТаблицаЗначений") Тогда
			ЭлементКоллекции.ВидНоменклатуры = ВидНоменклатуры;
		ИначеЕсли ТипЗнч(КоллекцияНоменклатуры) = Тип("Массив") Тогда
			ЭлементКоллекции.Вставить("ВидНоменклатуры", ВидНоменклатуры);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует соотвествие, хранящее виды номенклатуры для ссылок на номенклатуру.
//
// Параметры:
//  КоллекцияНоменклатуры	 - ТаблицаЗначений - Коллекция с номенклатурой, соответсвие которой нужно сформировать.
//
// Возвращаемое значение
// 	Соответствие - ключ - Номенклатура, значение - Вид номенклатуры.
//
// Возвращаемое значение:
//  Неопределено.
//
Функция ПолучитьСоответствиеВидовНоменклатуры(Знач КоллекцияНоменклатуры) Экспорт
	
	ВидыНоменклатуры = Новый Соответствие;
	
	Если КоллекцияНоменклатуры.Количество() <> 0 Тогда
		
		Если ТипЗнч(КоллекцияНоменклатуры) = Тип("ТаблицаЗначений") Тогда
			МассивНоменклатуры = КоллекцияНоменклатуры.Выгрузить().ВыгрузитьКолонку("Номенклатура");
		ИначеЕсли ТипЗнч(КоллекцияНоменклатуры) = Тип("Массив") Тогда
			МассивНоменклатуры = КоллекцияНоменклатуры;
		Иначе
			Возврат ВидыНоменклатуры;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	Номенклатура.ВидНоменклатуры
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В (&МассивНоменклатуры)"
		;
		Выб = Запрос.Выполнить().Выбрать();
		Пока Выб.Следующий() Цикл
			ВидыНоменклатуры.Вставить(Выб.Номенклатура, Выб.ВидНоменклатуры);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ВидыНоменклатуры;

КонецФункции

// Заполняет реквизит "КраткийСоставДокумента" документа по его табличным частям.
//
// Параметры:
//  МасСотр - Неопределено
//  ИмяРеквизита - Строка - По умолчанию "Сотрудник"
//
// Возвращаемое значение:
// 	Cтрока - значение реквизита "КраткийСоставДокумента".
//
Функция ЗаполнитьКраткийСоставДокумента(МасСотр, ИмяРеквизита = "Сотрудник") Экспорт
	
	КраткийСоставДокумента = "";
	
	КоличествоТЧ = 1;
	КраткийСоставДокументаЗаполнен = Ложь;
	
	Если НЕ КраткийСоставДокументаЗаполнен Тогда
		
		Для Инд = 0 По МасСотр.Количество() - 1 Цикл
			
			ФИОФизЛица = ОбщегоНазначения.ФамилияИнициалыФизЛица(МасСотр[Инд]);
			Если Найти(КраткийСоставДокумента, ФИОФизЛица) = 0 Тогда
				
				Если СтрДлина(КраткийСоставДокумента) < 100 Тогда
					КраткийСоставДокумента = КраткийСоставДокумента + ", " + ФИОФизЛица;
				Иначе
					
					Если КоличествоТЧ = 1 Тогда
						КраткийСоставДокумента = Сред(КраткийСоставДокумента,3,95) + "...";
					Иначе
						
						Если Лев(КраткийСоставДокумента,2) = ", " Тогда
							КраткийСоставДокумента = Сред(КраткийСоставДокумента,3,95) + "...";
						Иначе
							КраткийСоставДокумента = Лев(КраткийСоставДокумента,97) + "...";
						КонецЕсли;
						
					КонецЕсли; 
					
					КраткийСоставДокументаЗаполнен = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЕсли; 
			
			
			Если КраткийСоставДокументаЗаполнен Тогда
				Прервать
			КонецЕсли; 
			
		КонецЦикла;
		
		КоличествоТЧ = КоличествоТЧ + 1;
		
	КонецЕсли; 
		
	Если Лев(КраткийСоставДокумента,2) = ", " Тогда
		ДлинаСтроки = СтрДлина(КраткийСоставДокумента);
		Если ДлинаСтроки < 100 Тогда
			КраткийСоставДокумента = Сред(КраткийСоставДокумента,3)
		Иначе
			КраткийСоставДокумента = Сред(КраткийСоставДокумента,3,95) + "...";
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат КраткийСоставДокумента;
	
КонецФункции // ЗаполнитьКраткийСоставДокумента()	

// Возвращает краткое наименование валюты, указанной в учетной политике как основная.
//
// Возвращаемое значение: 
//	Строка - краткое наименование валюты.
//
Функция ПолучитьКраткоеНаименованиеОсновнойВалюты() Экспорт
	
	ВалютаУчета = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ВалютаУчета");
	Если ЗначениеЗаполнено(ВалютаУчета) Тогда
		Возврат ВалютаУчета.Наименование;
	Иначе
		Возврат "руб.";
	КонецЕсли;
	
КонецФункции 

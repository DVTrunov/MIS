// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С ФИО

// Функция формирует фамилию и инициалы либо по наименованию элемента спр-ка ФизическиеЛица
//  либо по переданным строкам.
//  Если передан Объект, то извлеченная из него строка считается совокупностью.
//  Фамилия + Имя + Отчество, разделенными пробелами.
//
// Параметры:
//  Объект	 - Строка	 - строка или ссылка или объект элемента спр-ка ФизическиеЛица.
//  Фамилия	 - Строка	 - фамилия физ. лица.
//  Имя		 - Строка	 - имя физ. лица.
//  Отчество - Строка	 - отчество физ. лица.
// 
// Возвращаемое значение:
//  Строка - Фамилия и Инициалы одной строкой. Побочные эффекты - переданная целая строка.
//	  Побочные эффекты - переданная целая строка разбивается на подстроки, соответствующие
//	  отдельным Фамилии,Имени и Отчеству.
//
Функция ФамилияИнициалыФизЛица(Объект = Неопределено, Знач Фамилия = " ", Знач Имя = " ", Знач Отчество = " ") Экспорт

	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("Строка") Тогда
		ФИО = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(Объект)," ");
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Клиенты")	  	Или	ТипОбъекта = Тип("СправочникОбъект.Клиенты") Или 
			  ТипОбъекта = Тип("СправочникСсылка.Сотрудники")	Или	ТипОбъекта = Тип("СправочникОбъект.Сотрудники") 
	Тогда 
		Если ЗначениеЗаполнено(Объект.Фамилия) И ЗначениеЗаполнено(Объект.Имя) И ЗначениеЗаполнено(Объект.Отчество) Тогда
			ФИО = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(Объект.Фамилия + " " + Объект.Имя + " " + Объект.Отчество)," ");
	    Иначе
			ФИО = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(Объект.Наименование)," ");
		КонецЕсли;
	Иначе                                                           
		
		// Используем возможно переданные отдельные строки.
		Возврат ?(НЕ ПустаяСтрока(Фамилия), 
				Фамилия + ?(НЕ ПустаяСтрока(Имя)," " + Лев(Имя,1) + "." + ?(НЕ ПустаяСтрока(Отчество),Лев(Отчество,1)+".", ""), ""),
				"")
	КонецЕсли;
			
	КоличествоПодстрок = ФИО.Количество();
	Фамилия = ?(КоличествоПодстрок > 0,ФИО[0],"");
	Имя		= ?(КоличествоПодстрок > 1,ФИО[1],"");
	Отчество= ?(КоличествоПодстрок > 2,ФИО[2],"");
	
	Возврат ?(НЕ ПустаяСтрока(Фамилия), 
				Фамилия + ?(НЕ ПустаяСтрока(Имя)," " + Лев(Имя,1) + "." + ?(НЕ ПустаяСтрока(Отчество),Лев(Отчество,1)+".", ""), ""),
				"");

КонецФункции

// Функция формирует фамилию и инициалы либо по наименованию элемента спр-ка ФизическиеЛица
//  либо по переданным строкам.
//  Если передан Объект, то извлеченная из него строка считается совокупностью.
//  Фамилия + Имя + Отчество, разделенными пробелами.
//
// Параметры:
//  Объект - СправочникСсылка, Строка - строка или ссылка или объект элемента спр-ка ФизическиеЛица.
//
// Возвращаемое значение: 
//  Строка - Фамилия и Инициалы одной строкой. Побочные эффекты - переданная целая строка.
//  		Побочные эффекты - переданная целая строка разбивается на подстроки, соответствующие
//  		отдельным Фамилии,Имени и Отчеству.
//
Функция ФИОФизЛица(Объект) Экспорт

	ТипОбъекта = ТипЗнч(Объект);
	Если  ТипОбъекта = Тип("СправочникСсылка.Клиенты")	  	Или	ТипОбъекта = Тип("СправочникОбъект.Клиенты") Или 
		  ТипОбъекта = Тип("СправочникСсылка.Сотрудники")	Или	ТипОбъекта = Тип("СправочникОбъект.Сотрудники") 
	Тогда
		ФИО = СокрЛП(СокрЛП(Объект.Фамилия) + " " + СокрЛП(Объект.Имя) + " " + СокрЛП(Объект.Отчество));
		ФИО = СтрЗаменить(ФИО, "  ", " ");
		Возврат ФИО;
	Иначе                                                           
		Возврат Строка(Объект);
	КонецЕсли;
			
КонецФункции


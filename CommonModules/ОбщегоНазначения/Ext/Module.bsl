 	#КонецЕсли

КонецПроцедуры

// Функция - Таблицу значений в табличный документ.
//
// Параметры:
//  Таблица		 - ТаблицаЗначений	 - Преобразуемая таблица значений.
//  ВывестиШапку - Булево	 - Вывести ли названия колонок таблицы в первую строку табличного документа.
// 
// Возвращаемое значение:
//   - ТабличныйДокумент.
//
Функция ТаблицуЗначенийВТабличныйДокумент(Таблица, ВывестиШапку = Ложь) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	Если ВывестиШапку Тогда
		Для Сч = 1 По Таблица.Колонки.Количество() Цикл
			Колонка = Таблица.Колонки[Сч - 1];
			ТабДок.Область(1, Сч).Текст = ?(ЗначениеЗаполнено(Колонка.Заголовок), Колонка.Заголовок, Колонка.Имя);
		КонецЦикла;
	КонецЕсли;
	
	Для СчСтр = 1 По Таблица.Количество() Цикл
		Для Сч = 1 По Таблица.Колонки.Количество() Цикл
			
			ТабДок.Область(СчСтр + ?(ВывестиШапку, 1, 0), Сч).Текст = Таблица[СчСтр - 1][Сч - 1];
		
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции


// ПРОЦЕДУРЫ И ФУНКЦИИ МЕХАНИЗМА РИБ

// Функция возвращает признак того, что текущий сеанс программы является сейчас единственным сеансом
// программы, работающим в режиме "Предприятие".
// Возвращаемое значение:
//  Неопределено.
//
Функция ОпределитьТекущийРежимРаботыМонопольный() Экспорт
	
	МассивСоединений = ПолучитьСоединенияИнформационнойБазы();
	НомерТекущегоСоединения = НомерСоединенияИнформационнойБазы();
	
	Для каждого Соединение Из МассивСоединений Цикл
		
		Если Соединение.ИмяПриложения <> "Designer" 
			И Соединение.НомерСоединения <> НомерТекущегоСоединения Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Функция возвращает признак того, что база работает в режиме файл-сервер.
// Параметры:
//  СтрокаСоединенияСБД - Строка - По умолчанию ""
//
// Возвращаемое значение:
//  Булево.
//
Функция ОпределитьЭтаИнформационнаяБазаФайловая(СтрокаСоединенияСБД = "") Экспорт
			
	СтрокаСоединенияСБД = ?(ПустаяСтрока(СтрокаСоединенияСБД), СтрокаСоединенияИнформационнойБазы(), СтрокаСоединенияСБД);
	
	// В зависимости от того файловый это вариант БД или нет немного по-разному путь в БД формируется.
	ПозицияПоиска = Найти(Врег(СтрокаСоединенияСБД), "FILE=");
	
	Возврат ПозицияПоиска = 1;	
	
КонецФункции


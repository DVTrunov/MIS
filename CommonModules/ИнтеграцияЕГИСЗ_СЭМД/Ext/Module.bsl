Функция ПолучитьПредставлениеАтрибутаПоLocalid(ЗначениеУзла, Атрибут)
	
	ПредставлениеАтрибута = Неопределено;
	Попытка
		ПредставлениеАтрибутаСтрока = ЗначениеУзла.Атрибуты.Найти(Атрибут, "Ключ");
		Если ПредставлениеАтрибутаСтрока <> Неопределено Тогда
			ПредставлениеАтрибута = ПредставлениеАтрибутаСтрока.Значение;
		КонецЕсли;
	Исключение КонецПопытки;
	

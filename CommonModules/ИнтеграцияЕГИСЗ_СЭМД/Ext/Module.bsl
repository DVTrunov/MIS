КонецПроцедуры

Процедура ЗаполнитьТекстовоеСодержаниеУзла(Узел, ТаблицаПараметров, СоответствиеВышестоящихLocalId, НезаполненныеПараметры = Неопределено, РодительскийУзел = Неопределено, УзлыДляУдаления = Неопределено, СтрокаГруппирующегоПоля = Неопределено)
	
	Результат = ПолучитьРезультат(Узел, Узел.ЗначениеУзла, ТаблицаПараметров, СоответствиеВышестоящихLocalId, СтрокаГруппирующегоПоля);
	Если ЗначениеЗаполнено(Результат) Тогда
		Узел.ЗначениеУзла = Результат;
	ИначеЕсли РодительскийУзел <> Неопределено
		И (СтрНайти(Узел.ЗначениеУзла, "$") > 0
			Или Лев(Узел.ЗначениеУзла,1) = "*"
			Или Лев(Узел.ЗначениеУзла,1) = "%")
	Тогда
		ОбработатьУзелБезЗаполненногоПараметра(Узел, РодительскийУзел, УзлыДляУдаления, ТаблицаПараметров, НезаполненныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Функция ОчиститьУзелОтАтрибутов(Узел)
	
	Для Каждого СлужебныйАтрибутТела Из ПолучитьСлужебныеАтрибутыТела() Цикл
		Узел.УдалитьАтрибут(СлужебныйАтрибутТела);
	КонецЦикла;
	
КонецФункции

Функция ПолучитьРезультат(Узел, Сущность, ТаблицаПараметров, СоответствиеВышестоящихLocalId, СтрокаГруппирующегоПоля = Неопределено, Знач ФорматнаяСтрока = Неопределено)
	
	Результат = Неопределено;
	Если СтрНайти(Сущность, "$") > 0 Тогда
		
		// Зарезервированный
		ЗарезервированноеСлово = СтрРазделить(Сущность, "$", Ложь)[0];
		ЗарезервированноеСлово = Прав(ЗарезервированноеСлово, СтрДлина(ЗарезервированноеСлово)-1);
		
		ПараметрЗарезервированноегоСлова = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid", ЗарезервированноеСлово));
		Если ПараметрЗарезервированноегоСлова.Количество() = 0 Тогда
			Результат = Неопределено;
		Иначе
			ЗначениеПараметра = ПараметрЗарезервированноегоСлова[0].Значение;
			Результат = ОпределитьЧислоПоЗарезервированномуСловуОрганизация(Сущность, ЗначениеПараметра);
		КонецЕсли;
		
	ИначеЕсли Лев(Сущность,1) = "*" Тогда
		
		// Функция
		Результат = ВычислитьФункцию(Сущность, ТаблицаПараметров, СоответствиеВышестоящихLocalId, СтрокаГруппирующегоПоля);
		
	ИначеЕсли Лев(Сущность,1) = "%" Тогда
		
		// Значение
		ЗначениеПоLocalIdИзСтроки = ПолучитьЗначениеLocalIdИзСтроки(Сущность, ТаблицаПараметров, СоответствиеВышестоящихLocalId, СтрокаГруппирующегоПоля);
		
		Если Не ЗначениеЗаполнено(ФорматнаяСтрока) Тогда
			СформироватьФорматнуюСтрокуПоТипуУзла(ФорматнаяСтрока, Узел);
		КонецЕсли;
		
		Попытка
			Результат = Формат(ЗначениеПоLocalIdИзСтроки, ФорматнаяСтрока);
		Исключение
			Результат = Строка(ЗначениеПоLocalIdИзСтроки);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВычислитьФункцию(Сущность, ТаблицаПараметров = Неопределено, СоответствиеВышестоящихLocalId = Неопределено, СтрокаГруппирующегоПоля = Неопределено)
	
	СтрокаФункции = Прав(Сущность, СтрДлина(Сущность)-1);
	
	ВычисляемыеПараметры = Новый Массив;
	ЗаполнитьВычисляемыеПараметры(СтрокаФункции, ВычисляемыеПараметры);
	
	ЗначенияВычисляемыхПараметров = Новый Массив;
	
	Для Инд = 1 - ВычисляемыеПараметры.Количество() По 0 Цикл
		ДанныеПараметра = ВычисляемыеПараметры[-Инд];
		ЗначениеИзСтроки = ПолучитьЗначениеLocalIdИзСтроки(ДанныеПараметра.СтрокаПараметра, ТаблицаПараметров, СоответствиеВышестоящихLocalId, СтрокаГруппирующегоПоля);
		НоваяСтрокаПараметра = СтрШаблон("ЗначенияВычисляемыхПараметров[%1]", ЗначенияВычисляемыхПараметров.Количество());
		ЗначенияВычисляемыхПараметров.Добавить(ЗначениеИзСтроки);
		СтрокаФункции = Лев(СтрокаФункции, ДанныеПараметра.Начало - 1) + НоваяСтрокаПараметра + Прав(СтрокаФункции, СтрДлина(СтрокаФункции) - ДанныеПараметра.Конец);
	КонецЦикла;
	
	Результат = Неопределено;
	Выполнить(СтрШаблон("Результат = %1", СтрокаФункции));
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьВычисляемыеПараметры(ИсходноеИмяФункции, ВычисляемыеПараметры)
	
	ГраницыСтрок = Новый Массив;
	ЗаполнитьГраницыСтрок(ИсходноеИмяФункции, ГраницыСтрок);
	
	НомерВхождения = 1;
	Пока Истина Цикл
		
		Позиция = СтрНайти(ИсходноеИмяФункции, "%",,,НомерВхождения);
		Если Позиция = 0 Тогда
			Прервать;
		Иначе
			НомерВхождения = НомерВхождения + 1;
		КонецЕсли;
		
		СимволВСтроке = Ложь;
		Для Каждого ГраницыСтроки Из ГраницыСтрок Цикл
			Если Позиция > ГраницыСтроки.Начало
				И Позиция < ГраницыСтроки.Конец
			Тогда
				СимволВСтроке = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СимволВСтроке Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСтрокиПараметра = ПолучитьДанныеСтрокиПараметра(ИсходноеИмяФункции, Позиция);
		Если ДанныеСтрокиПараметра <> Неопределено Тогда
			ВычисляемыеПараметры.Добавить(ДанныеСтрокиПараметра);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьГраницыСтрок(Знач ИсходноеИмяФункции, ГраницыСтрок)
	
	РазмерТекста = СтрДлина(ИсходноеИмяФункции);
	НачалоСтроки = Неопределено;
	
	Для Позиция = 1 По РазмерТекста Цикл
		Если КодСимвола(ИсходноеИмяФункции, Позиция) = КодСимвола("""") Тогда
			Если НачалоСтроки = Неопределено Тогда
				НачалоСтроки = Позиция;
			Иначе
				Если Позиция <> РазмерТекста И КодСимвола(ИсходноеИмяФункции, Позиция + 1) = КодСимвола("""") Тогда
					Позиция = Позиция + 1;
				Иначе
					ГраницыСтрок.Добавить(Новый Структура("Начало, Конец", НачалоСтроки, Позиция));
					НачалоСтроки = Неопределено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НачалоСтроки <> Неопределено Тогда
		ГраницыСтрок.Добавить(Новый Структура("Начало, Конец", НачалоСтроки, РазмерТекста));
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеСтрокиПараметра(Знач ИсходноеИмяФункции, НачальнаяПозиция)
	
	КонечнаяПозиция = НачальнаяПозиция;
	ВключаяЦифры = Ложь; // Первый символ не может быть цифрой
	Для Позиция = НачальнаяПозиция + 1 По СтрДлина(ИсходноеИмяФункции) Цикл
		Если Не СимволНаименованияПараметра(КодСимвола(ИсходноеИмяФункции, Позиция), ВключаяЦифры) Тогда
			Прервать;
		КонецЕсли;
		КонечнаяПозиция = Позиция;
		ВключаяЦифры = Истина;
	КонецЦикла;
	
	Если КонечнаяПозиция <= НачальнаяПозиция Тогда
		Возврат Неопределено
	КонецЕсли;
	
	СтрокаПараметра = Сред(ИсходноеИмяФункции, НачальнаяПозиция, КонечнаяПозиция+1-НачальнаяПозиция);
	
	Возврат Новый Структура("СтрокаПараметра, Начало, Конец", СтрокаПараметра, НачальнаяПозиция, КонечнаяПозиция);
	
КонецФункции

Функция СимволНаименованияПараметра(КодСимвола, ВключаяЦифры = Истина) Экспорт
	
	Диапазоны = Новый Массив;
	Если ВключаяЦифры Тогда
		Диапазоны.Добавить(Новый Структура("Мин,Макс", 48, 57));	// цифры
	КонецЕсли;
	
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 65, 90));		// латиница большие
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 97, 122));		// латиница маленькие
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 1040, 1103));	// кириллица
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 1025, 1025));	// символ "Ё"
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 1105, 1105));	// символ "ё"
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 95, 95));		// символ "_"
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 46, 46));		// символ "."
	
	Для Каждого Диапазон Из Диапазоны Цикл
		Если КодСимвола >= Диапазон.Мин И КодСимвола <= Диапазон.Макс Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ОпределитьЧислоПоЗарезервированномуСловуОрганизация(ПараметрОрганизация, Организация)
	
	OIDОрганизации = СокрЛП(Организация.МедицинскаяОрганизация.OIDОрганизации);
	ИдентификацияОбъекта = ПолучитьИдентификациюОбъекта(СтрРазделить(ПараметрОрганизация, "$", Ложь)[1]);
	
	Возврат СтрШаблон("%1.100.1.1.%2", OIDОрганизации, ИдентификацияОбъекта);
	
КонецФункции


				ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(73), "ЗаключениеОториноларинголога");
			Иначе
				ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(74), "ЗаключениеОториноларинголога");

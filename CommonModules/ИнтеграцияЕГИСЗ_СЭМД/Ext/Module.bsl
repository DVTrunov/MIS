Процедура ДополнитьПараметрамиПоРЭМД_186(ИдентификаторРЭМД, ТаблицаПараметров, Ссылка)
	
	УникальноеОборудование = Новый Массив;
	Для Каждого СтрокаОборудования Из ТаблицаПараметров.НайтиСтроки(Новый Структура("localid", "ИспользуемоеОборудование")) Цикл
		Если ЗначениеЗаполнено(СтрокаОборудования.Значение)
			И УникальноеОборудование.Найти(СтрокаОборудования.Значение) = Неопределено
		Тогда
			УникальноеОборудование.Добавить(СтрокаОборудования.Значение);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, СтрокаОборудования.Значение, "ОборудованиеИнструментальногоИсследования");
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаУслуги Из ТаблицаПараметров.НайтиСтроки(Новый Структура("localid", "ВыполненнаяМедицинскаяУслуга")) Цикл
		
		Если СтрокаУслуги.Параметр <> Неопределено Тогда
			ГруппирующееПоле	= СтрокаУслуги.Параметр;
			ИдентификаторСтроки	= СтрокаУслуги.ИдентификаторСтроки;
		Иначе
			// Константа
			ГруппирующееПоле	= ТаблицаПараметров.Индекс(СтрокаУслуги);
			ИдентификаторСтроки	= Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			ПараметрыДатыТекущейУслуги = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid, ГруппирующееПоле, ИдентификаторСтроки", "ДатаВыполненнойМедицинскойУслуги", ГруппирующееПоле, ИдентификаторСтроки));
		Иначе
			ПараметрыДатыТекущейУслуги = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid, ГруппирующееПоле", "ДатаВыполненнойМедицинскойУслуги", ГруппирующееПоле));
		КонецЕсли;
		
		Если ПараметрыДатыТекущейУслуги.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаОказанияУслуги = ПараметрыДатыТекущейУслуги[0].Значение;
		ДополнитьТаблицуПараметров(ТаблицаПараметров, СтрокаУслуги.Значение, "ОказаннаяУслуга");
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ДатаОказанияУслуги, "ДатаОказанияУслуги", Новый Структура("ГруппирующееПоле", ТаблицаПараметров.Количество() - 1));
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьПараметрамиПоРЭМД_189(ИдентификаторРЭМД, ТаблицаПараметров, Ссылка)
	
	// Не заставляем пользователя заполнять булевы значения вручную если можем определить сами по коду
	СтрокаПремедикация = ТаблицаПараметров.Найти("ОписаниеПроведеннойПремедикации", "localid"); 
	Если СтрокаПремедикация <> Неопределено И ЗначениеЗаполнено(СтрокаПремедикация.Значение) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Истина, "ПремедикацияПроведена");
	Иначе
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Ложь, "ПремедикацияПроведена");
	КонецЕсли;
	
	СтрокаАнтибиотикопрофилактика = ТаблицаПараметров.Найти("ОписаниеПериоперационнойАнтибиотикопрофилактики", "localid"); 
	Если СтрокаАнтибиотикопрофилактика <> Неопределено И ЗначениеЗаполнено(СтрокаАнтибиотикопрофилактика.Значение) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Истина, "ПериоперационнаяАнтибиотикопрофилактикаПроведена");
	Иначе
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Ложь, "ПериоперационнаяАнтибиотикопрофилактикаПроведена");
	КонецЕсли;
	
	// Считаем количество услуг сами
	КоличествоОказанныхУслуг = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid", "ОказаннаяУслуга")).Количество();
	ДополнитьТаблицуПараметров(ТаблицаПараметров, КоличествоОказанныхУслуг, "КоличествоОказанныхУслуг");
	
	// В зависимости от типа параметра ХирургическаяОперация заполняем связанные реквизиты
	СтрокаХирургическаяОперация = ТаблицаПараметров.Найти("ХирургическаяОперация", "localid"); 
	Если СтрокаХирургическаяОперация <> Неопределено И ЗначениеЗаполнено(СтрокаХирургическаяОперация.Значение) Тогда
		Операция = СтрокаХирургическаяОперация.Значение;
		Если ПараметрУказанногоТипа(Операция, "СправочникСсылка.НоменклатураМедицинскихУслуг") Тогда
			
			НаименованиеУслуги = ?(ЗначениеЗаполнено(Операция.ПолноеНаименование), Операция.ПолноеНаименование, Операция.Наименование);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, НаименованиеУслуги, "НаименованиеХирургическойОперации");
			
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Операция, "ХирургическаяОперация");
			
		ИначеЕсли ПараметрУказанногоТипа(Операция, "Строка") Тогда
			
			// Из-за того, что "ХирургическаяОперация" строка, в code подставится nullFlavor="OTH"
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Операция, "ХирургическаяОперация");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Операция, "НаименованиеХирургическойОперации");
			
		КонецЕсли;
	КонецЕсли;
	
	// Дополняем общие секции performer
	Для Каждого СтрокаЧленаБригады Из ТаблицаПараметров.НайтиСтроки(Новый Структура("localid", "ЧленОперационнойБригады")) Цикл
		ЧленБригады = СтрокаЧленаБригады.Значение;
		
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ЧленБригады, "ЧленКомиссии");
		
		// Ищем должность в таблице параметров
		ДолжностьЧленаМедкомиссии = Неопределено;
		СтрокиДолжностей = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid, ГруппирующееПоле", "ДолжностьЧленаОперационнойБригады", СтрокаЧленаБригады.Параметр));
		// Добавить учет констант в группирующих полях
		Если СтрокиДолжностей.Количество() <> 0 Тогда
			ДолжностьЧленаМедкомиссии = СтрокиДолжностей[0].Значение;
		КонецЕсли;
		
		// Дополнительный поиск для констант
		Если ДолжностьЧленаМедкомиссии = Неопределено Тогда
			СтрокиДолжностей = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid, ГруппирующееПоле", "ДолжностьЧленаОперационнойБригады", ТаблицаПараметров.Индекс(СтрокаЧленаБригады)));
			Если СтрокиДолжностей.Количество() <> 0 Тогда
				ДолжностьЧленаМедкомиссии = СтрокиДолжностей[0].Значение;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДолжностьЧленаМедкомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		// Ищем роль в таблице параметров
		РольЧленаКомиссии = Неопределено;
		СтрокиРолей = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid, ГруппирующееПоле", "РольЧленаОперационнойБригады", СтрокаЧленаБригады.Параметр));
		// Добавить учет констант в группирующих полях
		Если СтрокиРолей.Количество() <> 0 Тогда
			РольЧленаКомиссии = СтрокиРолей[0].Значение;
		КонецЕсли;
		
		// Дополнительный поиск для констант
		Если РольЧленаКомиссии = Неопределено Тогда
			СтрокиДолжностей = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid, ГруппирующееПоле", "РольЧленаОперационнойБригады", ТаблицаПараметров.Индекс(СтрокаЧленаБригады)));
			Если СтрокиДолжностей.Количество() <> 0 Тогда
				РольЧленаКомиссии = СтрокиДолжностей[0].Значение;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(РольЧленаКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураЗаполнения = Новый Структура();
		СтруктураЗаполнения.Вставить("ГруппирующееПоле", ТаблицаПараметров.Количество() - 1);
		
		ДополнитьТаблицуПараметров(ТаблицаПараметров, РольЧленаКомиссии,								"РольСотрудникаЧленаМедкомиссииПриПодписанииМД", СтруктураЗаполнения);
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(ЧленБригады.УникальныйИдентификатор()),	"УИДЧленаМедкомиссии",							 СтруктураЗаполнения);
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ДолжностьЧленаМедкомиссии,						"ДолжностьЧленаМедкомиссии",					 СтруктураЗаполнения);
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ПолучитьРабочуюПочту(ЧленБригады),				"КонтактыЧленаМедкомиссии",						 СтруктураЗаполнения);
		
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ЧленБригады.Фамилия,	 "ФамилияЧленаМедкомиссии",	 СтруктураЗаполнения);
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ЧленБригады.Имя,		 "ИмяЧленаМедкомиссии",		 СтруктураЗаполнения);
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ЧленБригады.Отчество, "ОтчествоЧленаМедкомиссии", СтруктураЗаполнения);
	КонецЦикла;
	
	// Дополняем данными о дате начала и дате окончания документированного события
	ДатаНачалаОперации = Неопределено;
	
	СтрокаДатаНачала = ТаблицаПараметров.Найти("ДатаНачалаОперации", "localid"); 
	Если СтрокаДатаНачала <> Неопределено И ЗначениеЗаполнено(СтрокаДатаНачала.Значение) Тогда
		ДатаНачалаОперации = ИнтеграцияЕГИСЗСервер.ПредставлениеЛокальнойДатыСоСмещением(СтрокаДатаНачала.Значение, "ДФ=ггггММддЧЧмм");
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ДатаНачалаОперации, "ДатаНачалаСобытия");
	КонецЕсли;
	
	СтрокаДатаОкончания = ТаблицаПараметров.Найти("ДатаОкончанияОперации", "localid"); 
	Если СтрокаДатаОкончания <> Неопределено И ЗначениеЗаполнено(СтрокаДатаОкончания.Значение) Тогда
		ДатаОкончанияОперации = ИнтеграцияЕГИСЗСервер.ПредставлениеЛокальнойДатыСоСмещением(СтрокаДатаОкончания.Значение, "ДФ=ггггММддЧЧмм");
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ДатаОкончанияОперации, "ДатаОкончанияСобытия");
	// Постраховка если дата окончания не заполнена, чтобы не подставлялась дата документа (избежать отрицательной длительности операции)
	ИначеЕсли ДатаНачалаОперации <> Неопределено Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ДатаНачалаОперации, "ДатаОкончанияСобытия");
	КонецЕсли;
	
	
КонецПроцедуры


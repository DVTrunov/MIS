Функция ПолучитьДанныеСвязанныхОсмотровВрачейСпециалистов230(ПМО) Экспорт
	
	МодульМедосмотрыСервер = ДопСерверныеФункции.ОбщийМодуль("МедосмотрыСервер");
	
	ТаблицаКонсультаций = Новый ТаблицаЗначений;
	ТаблицаКонсультаций.Колонки.Добавить("ДействиеМедосмотра");
	ТаблицаКонсультаций.Колонки.Добавить("ПриемСсылка");
	ТаблицаКонсультаций.Колонки.Добавить("ДатаВыполненияДействияМедосмотра");
	ТаблицаКонсультаций.Колонки.Добавить("ВыявленыПротивопоказания");
	ТаблицаКонсультаций.Колонки.Добавить("Сотрудник");
	ТаблицаКонсультаций.Колонки.Добавить("СвязьСКлассификатором");
	ТаблицаКонсультаций.Колонки.Добавить("Заключение");
	ТаблицаКонсультаций.Колонки.Добавить("ТитрСерологическогоОбследования");
	
	ДопустимыеУИДЕГИСЗДолжностей = ДопустимыеУИДЕГИСЗДолжностей230();
	
	// Опеределим консультации с врачами с должностями из перечня должностей для СЭМД 
	СписокДействий = Новый Массив;
	Для Каждого СтрокаДействия Из ПМО.ДействияМедосмотра Цикл
		Если ТипЗнч(СтрокаДействия.Действие.СвязьСКлассификатором) = Тип("СправочникСсылка.КлассификаторыМинЗдрава")
			И СтрокаДействия.Действие.СвязьСКлассификатором.ВидКлассификатора = Перечисления.ВидыКлассификаторовМинЗдрава.ДолжностиРаботниковМедОрганизаций
			И ДопустимыеУИДЕГИСЗДолжностей.Найти(СтрокаДействия.Действие.СвязьСКлассификатором.УИДЕГИСЗ) <> Неопределено 
		Тогда
			СписокДействий.Добавить(СтрокаДействия.Действие);
		КонецЕсли;
	КонецЦикла;
	
	ПриемыПоДействиямМедосмотров = МодульМедосмотрыСервер.ПриемыПоДействиямМедосмотров(ПМО, СписокДействий);
	
	ТаблицаПараметровИЗначений	 = МедосмотрыСервер.ПолучитьТаблицуДействийМедосмотраИЗначений(ПМО, СписокДействий);
	СписокПротивопоказаний = Документы.ПрохождениеМедосмотра.ПротивопоказанияМедОсмотра(ПМО);
	
	Для Каждого Действие Из СписокДействий Цикл
		ПриемПоДействию = ПриемыПоДействиямМедосмотров.Получить(Действие);
		
		// Проверка наличия приема и сотрудника приема. Если у сотрудника есть должность для 230, то добавляем строку
		Если ПриемПоДействию = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаКонсультации = ТаблицаКонсультаций.Добавить();
		СтрокаКонсультации.ДействиеМедосмотра = Действие;
		СтрокаКонсультации.ПриемСсылка = ПриемПоДействию;
		СтрокаКонсультации.Сотрудник = ПриемПоДействию.Врач;
		СтрокаКонсультации.СвязьСКлассификатором = Действие.СвязьСКлассификатором;
		СтрокаКонсультации.ДатаВыполненияДействияМедосмотра = ПриемПоДействию.Дата;
		
		// Профнепригодность устанавливается по приему однозначно, если он не выполнял других действий медосмотров
		СтрокаКонсультации.ВыявленыПротивопоказания = НаличиеПротивопоказанийПоДействию230(ПриемПоДействию, Действие, ПМО);
		
		// Рассчитываем автозаключение
		ОтборДействиеМедосмотра = Новый Структура("ДействиеМедосмотра");
		ОтборДействиеМедосмотра.ДействиеМедосмотра = Действие;
		
		ТаблицаПараметровДействия = ТаблицаПараметровИЗначений.Скопировать(ТаблицаПараметровИЗначений.НайтиСтроки(ОтборДействиеМедосмотра));
		СтрокиВредныхФакторов = СписокПротивопоказаний.НайтиСтроки(Новый Структура("Действие", Действие));
		СписокВредныхФакторов = СписокПротивопоказаний.Скопировать(СтрокиВредныхФакторов, "ВредныйФактор").ВыгрузитьКолонку("ВредныйФактор");
		
		АвтоматическоеЗаключение = МедосмотрыСервер.ЗаключениеДляДействияМедОсмотра(СписокВредныхФакторов, "", ТаблицаПараметровДействия, Действие.Вид);
		Если ЗначениеЗаполнено(АвтоматическоеЗаключение) Тогда
			СтрокаКонсультации.Заключение = АвтоматическоеЗаключение;
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнитьСведениямиИзОтметокДляВыписки230(ПМО, ТаблицаКонсультаций, СписокДействий);
	
	// При наличии подходящего сотрудника подставляем из актуального на дату прохождения ПМО состава
	ДополнитьСотрудникамиИзСоставаКомиссии230(ПМО, ТаблицаКонсультаций, СписокДействий);
	
	Возврат СформироватьОбъединеннуюТаблицуРезультатовДействий230(ТаблицаКонсультаций, ПМО, Истина);
КонецФункции

Процедура ДополнитьТаблицуДаннымиОсмотров230(ТаблицаПараметров, ДанныеОсмотров, ПМО)
	
	// Дополнение одновременно в секцию тела и общие секции
	Для Каждого Осмотр Из ДанныеОсмотров Цикл
		
		Если Не ЗначениеЗаполнено(Осмотр.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		// Секции тела
		Если Осмотр.СвязьСКлассификатором.УИДЕГИСЗ = 24 Тогда
			
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.СвязьСКлассификатором, "ДолжностьДерматовенеролога");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Сотрудник, "Дерматовенеролог");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.ДатаВыполненияДействияМедосмотра, "ДатаОсмотраДерматовенеролога");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Заключение, "ПримечаниеДерматовенеролога");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Сотрудник.Подразделение.ПодразделениеМинздрава, "ПодразделениеДерматовенеролога");
			
			// Проверка на случай если попадет неопределено
			Если Осмотр.ВыявленыПротивопоказания = Истина Тогда
				ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(73), "ЗаключениеДерматовенеролога");
			Иначе
				ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(74), "ЗаключениеДерматовенеролога");
			КонецЕсли;
			
			ФилиалСотрудника = Осмотр.Сотрудник.Подразделение.Филиал;
			ОрганизацияСотрудника = ФилиалСотрудника.Организация;
			
			Если ЗначениеЗаполнено(ОрганизацияСотрудника) Тогда
				
				ДополнитьТаблицуПараметров(ТаблицаПараметров, ОрганизацияСотрудника.МедицинскаяОрганизация.ПолноеНаименование, "ОрганизацияДерматовенеролога");
				КонтактыОрганизации = КонтактыОрганизацииФилиала(ФилиалСотрудника);
				Если КонтактыОрганизации <> Неопределено Тогда
					ДополнитьТаблицуПараметров(ТаблицаПараметров, КонтактыОрганизации, "КонтактыОрганизацииДерматовенеролога");
				КонецЕсли;
				
				АдресОрганизации = АдресОрганизацииФилиала(ФилиалСотрудника);
				Если ЗначениеЗаполнено(АдресОрганизации) Тогда
					ДополнитьТаблицуПараметров(ТаблицаПараметров, АдресОрганизации, "АдресОрганизацииДерматовенеролога");
				КонецЕсли;
			// Если заполнено подразделение минздрава но нет связи с организацией, то тянем наименование МО из классификатора МО
			ИначеЕсли ЗначениеЗаполнено(Осмотр.Сотрудник.Подразделение.ПодразделениеМинздрава) Тогда
				МОПодразделения = ПолучитьМОПоПодразделениюСотрудника(Осмотр.Сотрудник);
				Если ЗначениеЗаполнено(МОПодразделения) Тогда
					ДополнитьТаблицуПараметров(ТаблицаПараметров, МОПодразделения.ПолноеНаименование, "ОрганизацияДерматовенеролога");
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Осмотр.ПриемСсылка) Тогда
				ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(Осмотр.ПриемСсылка.УникальныйИдентификатор()), "ИдентификаторМИСОсмотраДерматовенеролога");
				// ДополнитьТаблицуПараметров(ТаблицаПараметров, , "ИдентификаторРЭМДОсмотраДерматовенеролога"); 

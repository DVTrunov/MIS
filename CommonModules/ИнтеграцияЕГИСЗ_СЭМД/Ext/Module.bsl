Процедура ДополнитьТаблицуПараметров(ТаблицаПараметров, Значение = Неопределено, localid = Неопределено, ДругиеЗначения = Неопределено)
	
	НоваяСтрока = ТаблицаПараметров.Добавить();
	НоваяСтрока.Значение	= Значение;
	НоваяСтрока.localid		= localid;
	
	Если ДругиеЗначения <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ДругиеЗначения Цикл
			Попытка
				НоваяСтрока[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			Исключение КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ДолжностьУчаствуетВПодписании(Должность)
	
	УИДДолжности = Должность.УИДЕГИСЗ;
	ВыборкаПравил = Справочники.РЭМДПравилаПодписи.Выбрать();
	Пока ВыборкаПравил.Следующий() Цикл
		Если Не ЗначениеЗаполнено(ВыборкаПравил.Роль) Тогда
			Продолжить;
		КонецЕсли;
		СписокДолжностей = СтрРазделить(ВыборкаПравил.Должности, ", ", Ложь);
		Если СписокДолжностей.Найти(Строка(УИДДолжности)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьПрофнепригодностьВТаблицеДиагнозов(Прием) Экспорт
	
	Если Не ЗначениеЗаполнено(Прием) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ДиагнозПриема Из Прием.Диагнозы Цикл
		Если ЗначениеЗаполнено(ДиагнозПриема.ПрофнепригодностьВременная) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ДолжностиВрачаПриемаДля230(Прием)
	
	Если Не ЗначениеЗаполнено(Прием) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ДопустимыеУИДЕГИСЗ = ДопустимыеУИДЕГИСЗДолжностей230();
	
	ДолжностиВрача = ИнтеграцияЕГИСЗВызовСервера.ДолжностиМЗ(Прием.Врач);
	
	ДолжностиВрачаПо230 = Новый Массив;
	Для Каждого ДолжностьВрача Из ДолжностиВрача Цикл
		Если ДопустимыеУИДЕГИСЗ.Найти(ДолжностьВрача.УИДЕГИСЗ) <> Неопределено Тогда
			ДолжностиВрачаПо230.Добавить(ДолжностьВрача);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДолжностиВрачаПо230;
	
КонецФункции

Функция ДопустимыеУИДЕГИСЗДолжностей230() Экспорт
	
	ДопустимыеУИДЕГИСЗ = Новый Массив;
	ДопустимыеУИДЕГИСЗ.Добавить(24);
	ДопустимыеУИДЕГИСЗ.Добавить(53);
	ДопустимыеУИДЕГИСЗ.Добавить(100);
	ДопустимыеУИДЕГИСЗ.Добавить(109);
	
	Возврат ДопустимыеУИДЕГИСЗ; 
	
КонецФункции

Функция УСотрудникаЕстьДолжностьДействияМедосмотра230(Врач, ДействиеМедосмотра, СообщатьПользователю = Ложь) Экспорт
	
	Если ДопустимыеУИДЕГИСЗДолжностей230().Найти(ДействиеМедосмотра.СвязьСКлассификатором.УИДЕГИСЗ) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДолжностиВрача = ИнтеграцияЕГИСЗВызовСервера.ДолжностиМЗ(Врач);
	
	Для Каждого ДолжностьВрача Из ДолжностиВрача Цикл
		Если ДолжностьВрача.УИДЕГИСЗ = ДействиеМедосмотра.СвязьСКлассификатором.УИДЕГИСЗ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если СообщатьПользователю Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='У врача, выполнившего действие медосмотра '") + Символ(34) + ДействиеМедосмотра.Наименование 
				+ Символ(34) + НСтр("ru=', нет должности '") 
				+ Символ(34) +ДействиеМедосмотра.СвязьСКлассификатором.Наименование 
				+ Символ(34) + НСтр("ru=' для его выполнения.'"))
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьВредныйФакторПоКлассификатору(ПриказВредныйФактор)
	
	УИДыЕГИСЗПоФакторам = Новый Соответствие;
	УИДыЕГИСЗПоФакторам.Вставить("23", 211);
	УИДыЕГИСЗПоФакторам.Вставить("24", 212);
	УИДыЕГИСЗПоФакторам.Вставить("25", 213);
	УИДыЕГИСЗПоФакторам.Вставить("26", 214);
	
	УИДЕГИСЗФактора = УИДыЕГИСЗПоФакторам.Получить(ПриказВредныйФактор.НомерПП);
	
	Если УИДЕГИСЗФактора = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(УИДЕГИСЗФактора, Перечисления.ВидыКлассификаторовМинЗдрава.ПрофессиональныеВредностиПациента);
	
КонецФункции

Функция ПолучитьКонстантыПоШаблону(ШаблонОсмотра, ТаблицаПараметров, МедицинскийДокумент, ИндексШаблона)
	
	ТаблицаКонстант = ШаблонОсмотра.КонстантыCDAДокумента.Выгрузить();
	//Если ДопСерверныеФункции.ИмяСсылочногоТипа(МедицинскийДокумент) = "Документ.ПрохождениеМедосмотра" Тогда
	//	Возврат ТаблицаКонстант;
	//КонецЕсли;
	
	ВычисляемыеКонстанты = ТаблицаКонстант.НайтиСтроки(Новый Структура("Вычисляется", Истина));
	Если ВычисляемыеКонстанты.Количество() = 0 Тогда
		Возврат ТаблицаКонстант;
	КонецЕсли;
	
	ВременнаяТаблица = ТаблицаПараметров.Скопировать(ТаблицаПараметров.НайтиСтроки(Новый Структура("ИдентификаторСтрокиШаблона", ИндексШаблона)), "Параметр, Значение");
	ТаблицаЗависимыхПараметров = ВременнаяТаблица.СкопироватьКолонки();
	ТаблицаЗависимыхПараметров.Колонки.Добавить("ЗависимыйПараметр");
	
	Для Каждого СтрокаКонстанты Из ВычисляемыеКонстанты Цикл
		НоваяСтрокаПараметра = ВременнаяТаблица.Добавить();
		НоваяСтрокаПараметра.Параметр = Новый Структура("УИД, ЗначениеПоУмолчанию, ФорматнаяСтрока", Новый УникальныйИдентификатор, СтрокаКонстанты.ВычисляемоеЗначение, "");
		Попытка
			ЗначенияПоУмолчанию = РаботаСШаблонамиHTML.ПолучитьЗначенияПараметровПоУмолчанию(ВременнаяТаблица, ТаблицаЗависимыхПараметров, МедицинскийДокумент, НоваяСтрокаПараметра.Параметр,,, Истина);
		Исключение
			Продолжить;
		КонецПопытки;
		Если ЗначенияПоУмолчанию.Количество() > 0 Тогда
			СтрокаКонстанты.Значение = ЗначенияПоУмолчанию[0].Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаКонстант;
	
КонецФункции


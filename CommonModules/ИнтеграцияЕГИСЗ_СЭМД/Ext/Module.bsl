Функция ЕдиницаИзмеренияВитальногоПараметра(ВитальныйПараметр) Экспорт
	
	Если Не ЗначениеЗаполнено(ВитальныйПараметр)
		Или ДопСерверныеФункции.ИмяСсылочногоТипа(ВитальныйПараметр) <> "Справочник.КлассификаторыМинЗдрава"
	Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕдиницаИзмерения = ВитальныйПараметр.Атрибуты.Найти("UnitCode", "Ключ");
	Если ЕдиницаИзмерения = Неопределено
		Или Не ЗначениеЗаполнено(ЕдиницаИзмерения.Значение)
	Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УИДЕГИСЗ = ЕдиницаИзмерения.Значение;
	Если ТипЗнч(УИДЕГИСЗ) = Тип("Строка") Тогда
		ЦифрыСтрокиУИДЕГИСЗ = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(УИДЕГИСЗ);
		Если ЗначениеЗаполнено(ЦифрыСтрокиУИДЕГИСЗ) Тогда
			УИДЕГИСЗ = Число(ЦифрыСтрокиУИДЕГИСЗ);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли ТипЗнч(УИДЕГИСЗ) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЕдиницыИзмерения(УИДЕГИСЗ);
	
КонецФункции

Функция ПустоеЗначениеОсобоеУсловие(ВидРЭМД, ТипУзла, ТаблицаПараметров)
	
	Если ВидРЭМД = 158 И ВыпискаСпециализированнаяИлиВысокотехнологичнаяПомощь(ТаблицаПараметров) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПустоеЗначение(ВидРЭМД, ТипУзла);
КонецФункции

Функция ВыпискаСпециализированнаяИлиВысокотехнологичнаяПомощь(ТаблицаПараметров)
	
	ЦельВрачебнойКомиссии = ТаблицаПараметров.Найти("ЦельПроведенияВрачебнойКомиссии", "localid");
	Если ЗначениеЗаполнено(ЦельВрачебнойКомиссии)
		И ЗначениеЗаполнено(ЦельВрачебнойКомиссии.Значение.УИДЕГИСЗ)
		И (ЦельВрачебнойКомиссии.Значение.УИДЕГИСЗ = 21 Или ЦельВрачебнойКомиссии.Значение.УИДЕГИСЗ = 28)
	Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция НаименованиеОборудования(Оборудование) Экспорт
	
	Если Не ЗначениеЗаполнено(Оборудование)
		Или ДопСерверныеФункции.ИмяСсылочногоТипа(Оборудование) <> "Справочник.МедицинскоеОборудование"
	Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Оборудование.НаименованиеПолное) Тогда
		Возврат Оборудование.НаименованиеПолное;
	ИначеЕсли ЗначениеЗаполнено(Оборудование.Наименование) Тогда
		Возврат Оборудование.Наименование;
	Иначе
		Возврат "—";
	КонецЕсли;
	
КонецФункции

Функция ПустоеЗначениеИННПоТипуДокументаОснования(ВидРЭМД, ТипДокументаОснования)
	
	// Если не заполнено, то секция не сформируется
	Если Не ЗначениеЗаполнено(ТипДокументаОснования) Тогда
		Возврат "NI";
	КонецЕсли;
	
	// identity:INN обязательный
	Если ВидРЭМД = 100 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Для типа документа основания "Договор на оказание платных медицинских услуг" значение из функции
	Если ТипДокументаОснования = 3 Тогда
		Возврат ПустоеЗначение(ВидРЭМД, "ИНН");
	КонецЕсли;
	
	// Для остальных типов оплаты не заполняется
	Возврат "NI";
	
КонецФункции


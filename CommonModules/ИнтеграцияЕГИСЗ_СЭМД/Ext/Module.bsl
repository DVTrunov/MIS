КонецФункции

Функция ИсточникОплатыПМОПоДоговоруСКлиентом(ПМО)
	
	Возврат ТипЗнч(ПМО.ВидПолиса) = Тип("ДокументСсылка.ДоговорСКлиентом");
	
КонецФункции

Процедура СформироватьФорматнуюСтрокуПоТипуУзла(ФорматнаяСтрока, Узел);
	
	Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
		Возврат;
	КонецЕсли;
	
	АтрибутТипа = Узел.ПолучитьАтрибут("http://www.w3.org/2001/XMLSchema-instance", "type");
	
	Если Не ЗначениеЗаполнено(АтрибутТипа) Тогда
		Возврат;
	КонецЕсли;
	
	ФорматныеСтрокиТипов = Новый Соответствие;
	ФорматныеСтрокиТипов.Вставить("PQ",		"ЧГ=0;ЧРД=.");
	ФорматныеСтрокиТипов.Вставить("INT",	"ЧГ=0");
	ФорматныеСтрокиТипов.Вставить("REAL",	"ЧГ=0;ЧДЦ=0;ЧРД=.");
	
	ФорматнаяСтрока = ФорматныеСтрокиТипов.Получить(ВРег(АтрибутТипа));
	
КонецПроцедуры

Процедура УдалитьНаименееЗаполненныеДублиДействий230(ТаблицаПоВидуДействийМедосмотровОбъединенная, МассивДействий, ЭтоДействияВрача, ЭтоИнструментальноеИсследование)
	
	КоличествоДействий = МассивДействий.Количество();
	Если КоличествоДействий < 2 Тогда
		// Дублей нет
		Возврат;
	КонецЕсли;
	
	// Если не врач и не инструментальное, то лабораторное
	ЭтоЛабораторныеИсследования = Не ЭтоДействияВрача И Не ЭтоИнструментальноеИсследование;
	
	ТекстЗаключенияПоУмолчанию = МедосмотрыКлиентСервер.ТекстЗаключенияПоУмолчанию();
	
	// Ищем различные действия с совпадающим СвязьСКлассификатором.УИДЕГИСЗ 
	Для СчетчикВнеш = 0 По КоличествоДействий - 2 Цикл
		Для СчетчикВнут = СчетчикВнеш + 1 По КоличествоДействий - 1 Цикл
			// Для инструментальных исследований должно остаться только одно
			Если ЭтоИнструментальноеИсследование 
				Или МассивДействий[СчетчикВнеш].СвязьСКлассификатором.УИДЕГИСЗ = МассивДействий[СчетчикВнут].СвязьСКлассификатором.УИДЕГИСЗ 
			Тогда
				// Находим строки в ТаблицаПоВидуДействийМедосмотровОбъединенная по действиям
				СтрокаВнеш = ТаблицаПоВидуДействийМедосмотровОбъединенная.Найти(МассивДействий[СчетчикВнеш], "ДействиеМедосмотра");
				Если СтрокаВнеш = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаВнут = ТаблицаПоВидуДействийМедосмотровОбъединенная.Найти(МассивДействий[СчетчикВнут], "ДействиеМедосмотра");
				Если СтрокаВнут = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СуммаБалловСтрокиВнеш = 0;
				СуммаБалловСтрокиВнут = 0;
				// Каждой строке присваиваем баллы за заполненные поля
				Если ЗначениеЗаполнено(СтрокаВнеш.ПриемСсылка) Тогда
					СуммаБалловСтрокиВнеш = СуммаБалловСтрокиВнеш + 2;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаВнут.ПриемСсылка) Тогда
					СуммаБалловСтрокиВнут = СуммаБалловСтрокиВнут + 2;
				КонецЕсли;
				
				// Обязательный реквизит
				Если ЗначениеЗаполнено(СтрокаВнеш.ДатаВыполненияДействияМедосмотра) Тогда
					СуммаБалловСтрокиВнеш = СуммаБалловСтрокиВнеш + 20;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаВнут.ДатаВыполненияДействияМедосмотра) Тогда
					СуммаБалловСтрокиВнут = СуммаБалловСтрокиВнут + 20;
				КонецЕсли;
				
				// Отдаем приоритет действию, выявившему противопоказание
				Если СтрокаВнеш.ВыявленыПротивопоказания = Истина Тогда
					СуммаБалловСтрокиВнеш = СуммаБалловСтрокиВнеш + 3;
				КонецЕсли;
				Если СтрокаВнут.ВыявленыПротивопоказания = Истина Тогда
					СуммаБалловСтрокиВнут = СуммаБалловСтрокиВнут + 3;
				КонецЕсли;
				
				Если ЭтоДействияВрача Тогда
					// Обязательно для консультаций
					Если ЗначениеЗаполнено(СтрокаВнеш.Сотрудник) Тогда
						СуммаБалловСтрокиВнеш = СуммаБалловСтрокиВнеш + 20;
					КонецЕсли; 
					Если ЗначениеЗаполнено(СтрокаВнут.Сотрудник) Тогда
						СуммаБалловСтрокиВнут = СуммаБалловСтрокиВнут + 20;
					КонецЕсли;
				КонецЕсли;
				
				// Ищем заключение введенное пользователем вручную
				Если ЗначениеЗаполнено(СтрокаВнеш.Заключение) 
					И СтрокаВнеш.Заключение <> СтрокаВнеш.ДействиеМедосмотра.ТекстЗаключенияПоУмолчанию 
					И СтрокаВнеш.Заключение <> ТекстЗаключенияПоУмолчанию 
				Тогда
					СуммаБалловСтрокиВнеш = СуммаБалловСтрокиВнеш + 1;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаВнут.Заключение) 
					И СтрокаВнут.Заключение <> СтрокаВнут.ДействиеМедосмотра.ТекстЗаключенияПоУмолчанию 
					И СтрокаВнут.Заключение <> ТекстЗаключенияПоУмолчанию 
				Тогда
					СуммаБалловСтрокиВнут = СуммаБалловСтрокиВнут + 1;
				КонецЕсли;
				
				// Для лабораторного исследования ищем заполненный титр серологического обследования
				Если ЭтоЛабораторныеИсследования Тогда
					Если ЗначениеЗаполнено(СтрокаВнеш.ТитрСерологическогоОбследования) Тогда
						СуммаБалловСтрокиВнеш = СуммаБалловСтрокиВнеш + 2;
					КонецЕсли; 
					Если ЗначениеЗаполнено(СтрокаВнут.ТитрСерологическогоОбследования) Тогда
						СуммаБалловСтрокиВнут = СуммаБалловСтрокиВнут + 2;
					КонецЕсли;
				КонецЕсли;
				
				// При равенстве баллов оставляем первую
				Если СуммаБалловСтрокиВнеш >= СуммаБалловСтрокиВнут Тогда
					ТаблицаПоВидуДействийМедосмотровОбъединенная.Удалить(СтрокаВнут);
				Иначе
					ТаблицаПоВидуДействийМедосмотровОбъединенная.Удалить(СтрокаВнеш);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьКритичныеОшибкиПоФактору230(ПМО, ПриказВредныйФактор)
	
	ВредныйФактор = ПолучитьВредныйФакторПоКлассификатору(ПриказВредныйФактор);
	
	Если ВредныйФактор = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЕстьКритичныеОшибки = Ложь;
	
	ЕстьПрививкаОтКори = Ложь;
	
	ТаблицаВакцинацийПоФактору = ТаблицаВакцинацийПоФактору230(ПМО, ВредныйФактор, ЕстьПрививкаОтКори);
	
	ЗаключениеПоФактору = ЗаключениеПоФакторуПМО(ВредныйФактор, ПМО);
	Если Не ЗначениеЗаполнено(ЗаключениеПоФактору) Тогда
		ЕстьКритичныеОшибки = Истина;
	КонецЕсли;
	
	ДанныеКонсультаций = ПолучитьДанныеСвязанныхОсмотровВрачейСпециалистов230(ПМО);
	Если ДанныеКонсультаций.Количество() <> 4 Тогда
		ЕстьКритичныеОшибки = Истина;
	КонецЕсли;
	Для Каждого Консультация Из ДанныеКонсультаций Цикл
		Если Не (ЗначениеЗаполнено(Консультация.Сотрудник)
			И ЗначениеЗаполнено(Консультация.СвязьСКлассификатором)
			И ЗначениеЗаполнено(Консультация.ДатаВыполненияДействияМедосмотра)
			И ДатаВ20Или21Веке(Консультация.ДатаВыполненияДействияМедосмотра))
		Тогда
			ЕстьКритичныеОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// Лабораторные исследования
	ТаблицаДляПроверки = Неопределено;
	ДанныеЛабИсследований = ПолучитьДанныеЛабораторныхИсследований230(ПМО, ВредныйФактор, ЕстьПрививкаОтКори, ТаблицаДляПроверки);
	Если ДанныеЛабИсследований.Количество() = 0 Тогда
		ЕстьКритичныеОшибки = Истина;
	КонецЕсли;
	
	Для Каждого ЛабИсследование Из ТаблицаДляПроверки Цикл
		Если ЛабИсследование.ИсследованиеУИДЕГИСЗ = 10268
			Или ЛабИсследование.ИсследованиеУИДЕГИСЗ = 10479
			Или ЛабИсследование.ИсследованиеУИДЕГИСЗ = 10506
			Или ЛабИсследование.ИсследованиеУИДЕГИСЗ = 10507
			Или ЛабИсследование.ИсследованиеУИДЕГИСЗ = 10508
			Или ЛабИсследование.ИсследованиеУИДЕГИСЗ = 10509
			Или ЛабИсследование.ИсследованиеУИДЕГИСЗ = 10510
		Тогда
			ЕстьКритичныеОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЛабИсследование Из ДанныеЛабИсследований Цикл
		Если Не (ЗначениеЗаполнено(ЛабИсследование.СвязьСКлассификатором) 
			И ЗначениеЗаполнено(ЛабИсследование.ДатаВыполненияДействияМедосмотра)
			И ДатаВ20Или21Веке(ЛабИсследование.ДатаВыполненияДействияМедосмотра))
		Тогда
			ЕстьКритичныеОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// Инструментальные исследования (только одна строка)
	ДанныеИнстрИсследований = ПолучитьДанныеИнструментальногоИсследования230(ПМО, ВредныйФактор);
	Если ДанныеИнстрИсследований.Количество() = 0 Тогда
		ЕстьКритичныеОшибки = Истина;
	КонецЕсли;
	
	Для Каждого ИнстрИсследование Из ДанныеИнстрИсследований Цикл
		Если Не (ЗначениеЗаполнено(ИнстрИсследование.СвязьСКлассификатором) 
			И ЗначениеЗаполнено(ИнстрИсследование.ДатаВыполненияДействияМедосмотра)
			И ДатаВ20Или21Веке(ИнстрИсследование.ДатаВыполненияДействияМедосмотра))
		Тогда
			ЕстьКритичныеОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьКритичныеОшибки;
	
КонецФункции

Функция ТаблицаВакцинацийПоФактору230(ПМО, ВредныйФактор, ЕстьПрививкаОтКори)
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ГруппаЗаболеваний");
	ТаблицаРезультат.Колонки.Добавить("ДатаВакцинации");
	ТаблицаРезультат.Колонки.Добавить("НаименованиеПрививки");
	ТаблицаРезультат.Колонки.Добавить("Повторная");
	ТаблицаРезультат.Колонки.Добавить("ПорядковыйНомер");
	
	ЕстьЗаполненнаяСтрока = Ложь;
	
	Если ВредныйФактор.УИДЕГИСЗ = 211 Тогда
		СтрокаОграничений = СтрокаОграниченийВакцинацииФактор23_230(ПМО.ПрофильРаботы);
	ИначеЕсли ВредныйФактор.УИДЕГИСЗ = 212 Тогда
		СтрокаОграничений = СтрокаОграниченийВакцинацииФактор24_230();
	ИначеЕсли ВредныйФактор.УИДЕГИСЗ = 213 Тогда
		СтрокаОграничений = СтрокаОграниченийВакцинацииФактор25_230();
	ИначеЕсли ВредныйФактор.УИДЕГИСЗ = 214 Тогда
		СтрокаОграничений = СтрокаОграниченийВакцинацииФактор26_230();
	КонецЕсли;
	
	СтрокаОграничений = СтрЗаменить(СтрокаОграничений, " ", "");
	СтрокаОграничений = СтрЗаменить(СтрокаОграничений, Символы.ПС, "");
	МассивОграничений = СтрРазделить(СтрокаОграничений, ",", Ложь);
	ОграниченияВакцинацииУИДЕГИСЗ = Новый Массив;
	Для Каждого Ограничение Из МассивОграничений Цикл
		Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Ограничение) Тогда
			ОграниченияВакцинацииУИДЕГИСЗ.Добавить(Число(Ограничение));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПрофПрививка Из ПМО.ПрофилактическиеПрививки Цикл
		
		Если Не ЗначениеЗаполнено(ПрофПрививка.ГруппаЗаболеваний) 
			Или ОграниченияВакцинацииУИДЕГИСЗ.Найти(ПрофПрививка.ГруппаЗаболеваний.УИДЕГИСЗ) = Неопределено 
		Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРез = ТаблицаРезультат.Добавить();
		СтрокаРез.ГруппаЗаболеваний = ПрофПрививка.ГруппаЗаболеваний;
		СтрокаРез.ДатаВакцинации = ПрофПрививка.ДатаВакцинации;
		СтрокаРез.НаименованиеПрививки = ПрофПрививка.НаименованиеПрививки;
		СтрокаРез.Повторная = ПрофПрививка.Повторная;
		СтрокаРез.ПорядковыйНомер = ПрофПрививка.ПорядковыйНомер;
		
		Если ПрофПрививка.ГруппаЗаболеваний.УИДЕГИСЗ = 18 Тогда
			ЕстьПрививкаОтКори = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ДатаВ20Или21Веке(ПроверяемаяДата) Экспорт
	
	Если ПроверяемаяДата > Дата("18991231")
		И ПроверяемаяДата < Дата("21000101")
	Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция НаличиеПротивопоказанийПоДействию230(Прием, Действие, ПМО)
	
	// Истина только если есть профнепригодность и один прием отвечает за одно действие медосмотра
	ЕстьПрофнепригодностьПоДействию = Ложь;
	
	СписокПротивопоказаний = Документы.ПрохождениеМедосмотра.ПротивопоказанияМедОсмотра(ПМО);
	ФакторыМедкнижки = МедосмотрыСервер.ПунктыВредныхФакторовДляМедкнижки();
	СтрокиПротивопоказаний = СписокПротивопоказаний.НайтиСтроки(Новый Структура("Действие", Действие));
	Для Каждого СтрокаПротивопоказания Из СтрокиПротивопоказаний Цикл
		Если СтрокаПротивопоказания.ВредныйФактор.Приказ = Справочники.ПриказыМедосмотров.Приказ29н 
			И ФакторыМедкнижки.Найти(СтрокаПротивопоказания.ВредныйФактор.НомерПП) <> Неопределено
		Тогда
			ЕстьПрофнепригодностьПоДействию = Истина; 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьПрофнепригодностьПоДействию Тогда
		НаборЗаписей = РегистрыСведений.ОтметкиВыполненияДействий.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПрохождениеМедОсмотра.Установить(ПМО);
		НаборЗаписей.Прочитать();
		Счетчик = 0;
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.ДокументРегистратор = Прием Тогда
				Счетчик = Счетчик + 1;
				Если Счетчик > 1 Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если Счетчик = 1 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаполнитьТаблицуПараметровПоРецепту148_1_у_04_л(ТаблицаПараметров, Ссылка, СоответствияПараметрам)
	
	ЕдиницаИзмеренияСуткиПоКлассификатору = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(24, Перечисления.ВидыКлассификаторовМинЗдрава.ЕдиницыИзмерения);
	ДополнитьТаблицуПараметров(ТаблицаПараметров, ЕдиницаИзмеренияСуткиПоКлассификатору, "ЕдиницаИзмеренияСуткиПоКлассификатору");
	
	Срочность = Неопределено;
	Если Ссылка.Срочность = "cito" Тогда
		Срочность = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(1, Перечисления.ВидыКлассификаторовМинЗдрава.ПриоритетИсполненияРецепта);
	ИначеЕсли Ссылка.Срочность = "statim" Тогда
		Срочность = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(2, Перечисления.ВидыКлассификаторовМинЗдрава.ПриоритетИсполненияРецепта);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка.Серия) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.Серия, "СерияРецепта");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка.Номер) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.Номер, "НомерРецепта");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Срочность) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Срочность, "ПриоритетИсполненияРецепта");
	КонецЕсли;
	
	ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.ПоСпециальномуНазначению, "СпециальноеНазначение");
	
	// Данная отметка может иметь значение true в случае назначения медицинского изделия (не поддерживается)
	ДополнитьТаблицуПараметров(ТаблицаПараметров, Ложь, "НаличиеХроническихЗаболеваний");
	
	Если ЗначениеЗаполнено(Ссылка.Диагноз) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.Диагноз, "Диагноз");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка.ЛьготнаяКатегория) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.ЛьготнаяКатегория, "ЛьготнаяКатегория");
		Если ЗначениеЗаполнено(Ссылка.ТипЛьготы) Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.ТипЛьготы, "ИсточикФинансирования");
			ВидЛьготы = ВидЛьготыПоКатегорииИТипу(Ссылка.ЛьготнаяКатегория, Ссылка.ТипЛьготы);
			Если ВидЛьготы <> Неопределено Тогда
				ДополнитьТаблицуПараметров(ТаблицаПараметров, ВидЛьготы, "ВидПредоставляемойЛьготы");
				СтрокаРазмерЛьготы = ВидЛьготы.Атрибуты.Найти("PERCENT");
				Если СтрокаРазмерЛьготы <> Неопределено Тогда
					ДополнитьТаблицуПараметров(ТаблицаПараметров, Число(СтрокаРазмерЛьготы.Значение), "РазмерЛьготы");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Вычислим срок действия рецепта в днях по кодам
	// Доступные сроки действия рецепта на лекарственный препарат или специализированный продукт лечебного питания: 15 дней, 30 дней и 90 дней
	СрокДействияРецептаВДнях = 0;
	СрокДействияРецепта = Неопределено;
	Если Ссылка.Срок = 50 Тогда
		СрокДействияРецептаВДнях = 15;
		СрокДействияРецепта = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(1, Перечисления.ВидыКлассификаторовМинЗдрава.СрокДействияРецепта);
	ИначеЕсли Ссылка.Срок = 0 Тогда
		СрокДействияРецептаВДнях = 30;
		СрокДействияРецепта = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(2, Перечисления.ВидыКлассификаторовМинЗдрава.СрокДействияРецепта);
	ИначеЕсли Ссылка.Срок = 60 Тогда
		СрокДействияРецептаВДнях = 90;
		СрокДействияРецепта = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(4, Перечисления.ВидыКлассификаторовМинЗдрава.СрокДействияРецепта);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СрокДействияРецептаВДнях) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.Дата + СрокДействияРецептаВДнях * 86400, "ДатаОкончанияДействияРецепта");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СрокДействияРецепта) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, СрокДействияРецепта, "СрокДействияРецепта");
	КонецЕсли;
	
	// Заполнение данных по первой номенклатуре
	Если ЗначениеЗаполнено(Ссылка.Номенклатура1) Тогда
		
		Если ТипЗнч(Ссылка.Номенклатура1) = Тип("СправочникСсылка.СправочникМеждународныхНепатентованныхНаименований") Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.Номенклатура1, "ЛекарственныйПрепарат");
		ИначеЕсли ТипЗнч(Ссылка.Номенклатура1) = Тип("СправочникСсылка.Номенклатура") Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.Номенклатура1.Наименование, "ЛекарственныйПрепаратСтрокой");
		ИначеЕсли ТипЗнч(Ссылка.Номенклатура1) = Тип("Строка") Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.Номенклатура1, "ЛекарственныйПрепаратСтрокой");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Ссылка.СколькоДней1) Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.СколькоДней1, "ДлительностьПриемаПрепарата");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Ссылка.ПутьВведенияПрепарата1) Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.ПутьВведенияПрепарата1, "ПутьВведенияПрепарата");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Ссылка.РазВДень1) Тогда
			ЧастотаПриемаПрепарата1 = Окр(1 / Ссылка.РазВДень1, 4, РежимОкругления.Окр15как10);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, ЧастотаПриемаПрепарата1, "ЧастотаПриемаПрепарата");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Ссылка.Количество1)
			И ЗначениеЗаполнено(Ссылка.ЕдиницаИзмерения1)
		Тогда
			ЕдиницаИзмеренияКоличества1 = Неопределено;
			Если ТипЗнч(Ссылка.ЕдиницаИзмерения1) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
				ЕдиницаИзмеренияКоличества1 = Ссылка.ЕдиницаИзмерения1;
			ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Ссылка.ЕдиницаИзмерения1, "ЕдиницаПоКлассификатору")
				И ЗначениеЗаполнено(Ссылка.ЕдиницаИзмерения1.ЕдиницаПоКлассификатору)
			Тогда
				ЕдиницаИзмеренияКоличества1 = Ссылка.ЕдиницаИзмерения1.ЕдиницаПоКлассификатору;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКоличества1) Тогда
				ЕдиницаИзмеренияКоличестваПоКлассификаторуНСИ1 = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЕдиницаИзмененияНСИПоОКЕИ(ЕдиницаИзмеренияКоличества1);
				Если ЗначениеЗаполнено(ЕдиницаИзмеренияКоличестваПоКлассификаторуНСИ1) Тогда
					ДополнитьТаблицуПараметров(ТаблицаПараметров, Ссылка.Количество1, "РазоваяДозаПрепарата");
					ДополнитьТаблицуПараметров(ТаблицаПараметров, ЕдиницаИзмеренияКоличестваПоКлассификаторуНСИ1, "ЕдиницаИзмеренияДозыПрепарата");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Ссылка.РазВДень1)
			И ЗначениеЗаполнено(Ссылка.СколькоДней1)
		Тогда
			КоличествоНазначенныхДоз1 = Ссылка.РазВДень1 * Ссылка.СколькоДней1;
			ДополнитьТаблицуПараметров(ТаблицаПараметров, КоличествоНазначенныхДоз1, "КоличествоНазначенныхДоз");
		КонецЕсли;
		
		ОсобыеУказания1 = "";
		
		Если ЗначениеЗаполнено(Ссылка.СпособПрименения1) Тогда
			ОсобыеУказания1 = ОсобыеУказания1 + "Способ применения:" + Символы.ПС + Ссылка.СпособПрименения1 + Символы.ПС;
		КонецЕсли;
		Если ЗначениеЗаполнено(Ссылка.Дозировка1) Тогда
			ОсобыеУказания1 = ОсобыеУказания1 + "Дозировка:" + Символы.ПС + Ссылка.Дозировка1 + Символы.ПС;
		КонецЕсли;
		Если ЗначениеЗаполнено(Ссылка.ВремяПриемаОтносительноЕды1) Тогда
			ОсобыеУказания1 = ОсобыеУказания1 + "Время приема относительно еды:" + Символы.ПС + Ссылка.ВремяПриемаОтносительноЕды1 + Символы.ПС;
		КонецЕсли;
		Если ЗначениеЗаполнено(Ссылка.ВремяПриемаОтносительноСна1) Тогда
			ОсобыеУказания1 = ОсобыеУказания1 + "Время приема относительно сна:" + Символы.ПС + Ссылка.ВремяПриемаОтносительноСна1 + Символы.ПС;
		КонецЕсли;
		Если ЗначениеЗаполнено(Ссылка.Дополнение1) Тогда
			ОсобыеУказания1 = ОсобыеУказания1 + "Дополнительно:" + Символы.ПС + Ссылка.Дополнение1 + Символы.ПС;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОсобыеУказания1) Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, ОсобыеУказания1, "ОсобыеУказания");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ВидЛьготыПоКатегорииИТипу(ЛьготнаяКатегория, ТипЛьготы)
	
	СтрокаАтрибута = ЛьготнаяКатегория.Атрибуты.Найти("ID");
	Если СтрокаАтрибута = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Льготы.Ссылка КАК Ссылка
		|ИЗ
		|	(ВЫБРАТЬ
		|		КлассификаторыМинЗдрава.Ссылка КАК Ссылка
		|	ИЗ
		|		Справочник.КлассификаторыМинЗдрава КАК КлассификаторыМинЗдрава
		|	ГДЕ
		|		КлассификаторыМинЗдрава.ВидКлассификатора = &ВидКлассификатора) КАК Льготы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторыМинЗдрава.Атрибуты КАК Атрибут_ID_LGOTA
		|		ПО Льготы.Ссылка = Атрибут_ID_LGOTA.Ссылка
		|			И ((ВЫРАЗИТЬ(Атрибут_ID_LGOTA.Ключ КАК СТРОКА(100))) = ""ID_LGOTA"")
		|			И ((ВЫРАЗИТЬ(Атрибут_ID_LGOTA.Значение КАК СТРОКА(100))) = &ID_LGOTA)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторыМинЗдрава.Атрибуты КАК Атрибут_ID_LGOTA_LIST
		|		ПО Льготы.Ссылка = Атрибут_ID_LGOTA_LIST.Ссылка
		|			И ((ВЫРАЗИТЬ(Атрибут_ID_LGOTA_LIST.Ключ КАК СТРОКА(100))) = ""ID_LGOTA_LIST"")
		|			И ((ВЫРАЗИТЬ(Атрибут_ID_LGOTA_LIST.Значение КАК СТРОКА(100))) = &ID_LGOTA_LIST)";
	
	Запрос.УстановитьПараметр("ВидКлассификатора",	Перечисления.ВидыКлассификаторовМинЗдрава.ВидыПредоставляемыхЛьгот);
	Запрос.УстановитьПараметр("ID_LGOTA",			СтрокаАтрибута.Значение);
	Запрос.УстановитьПараметр("ID_LGOTA_LIST",		Строка(ТипЛьготы.УИДЕГИСЗ));
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьПорядковыйНомерИИдентификаторВитальныхПараметров(ТаблицаПараметров, LocalidВитальногоПараметра = "ВитальныйПараметр")
	
	ПорядковыйНомерПараметра = 1;
	ВитальныеПараметры = ТаблицаПараметров.НайтиСтроки(Новый Структура("localid", LocalidВитальногоПараметра));
	Для Каждого ВитальныйПараметр Из ВитальныеПараметры Цикл
		Если ЗначениеЗаполнено(ВитальныйПараметр.КлассификацияПоля)
			И ЗначениеЗаполнено(ВитальныйПараметр.КлассификацияПоля.УИДЕГИСЗ)
		Тогда
			Если ТипЗнч(ВитальныйПараметр.Параметр) = Тип("ПланВидовХарактеристикСсылка.ПараметрыHTML") Тогда
				Если ЗначениеЗаполнено(ВитальныйПараметр.ТаблицаШаблонов) Тогда
					// Параметр в многострочной таблице
					СтруктураЗаполнения = Новый Структура();
					СтруктураЗаполнения.Вставить("ГруппирующееПоле",				ВитальныйПараметр.Параметр);
					СтруктураЗаполнения.Вставить("ИдентификаторРодительскойСтроки",	ВитальныйПараметр.ИдентификаторРодительскойСтроки);
					СтруктураЗаполнения.Вставить("ИдентификаторСтроки",				ВитальныйПараметр.ИдентификаторСтроки);
					СтруктураЗаполнения.Вставить("ИдентификаторСтрокиШаблона",		ВитальныйПараметр.ИдентификаторСтрокиШаблона);
					СтруктураЗаполнения.Вставить("НомерСтрокиТаблицы",				ВитальныйПараметр.НомерСтрокиТаблицы);
					
					ДополнитьТаблицуПараметров(ТаблицаПараметров, ПорядковыйНомерПараметра, "ПорядковыйНомер", СтруктураЗаполнения);
					ДополнитьТаблицуПараметров(ТаблицаПараметров, ВитальныйПараметр.КлассификацияПоля.УИДЕГИСЗ, "ИдентификаторВитальногоПараметра", СтруктураЗаполнения);
					
				Иначе
					// Параметр в теле шаблона приёма, но не в многострочной таблице
					СтруктураЗаполнения = Новый Структура();
					СтруктураЗаполнения.Вставить("ГруппирующееПоле", ВитальныйПараметр.Параметр);
					ДополнитьТаблицуПараметров(ТаблицаПараметров, ПорядковыйНомерПараметра, "ПорядковыйНомер", СтруктураЗаполнения);
					ДополнитьТаблицуПараметров(ТаблицаПараметров, ВитальныйПараметр.КлассификацияПоля.УИДЕГИСЗ, "ИдентификаторВитальногоПараметра", СтруктураЗаполнения);
				КонецЕсли;
			ИначеЕсли ВитальныйПараметр.Параметр = Неопределено Тогда
				// Параметр в константе
				ИндексВитальногоПараметра = -1;
				// Ищем индекс строки для подстановки в группирующее поле
				Для Индекс = 0 По ТаблицаПараметров.Количество() - 1 Цикл
					СтрокаТЗ = ТаблицаПараметров[Индекс];
					Если СтрокаТЗ.localid = ВитальныйПараметр.localid
						И СтрокаТЗ.КлассификацияПоля = ВитальныйПараметр.КлассификацияПоля
						И СтрокаТЗ.Значение = ВитальныйПараметр.Значение
					Тогда
						ИндексВитальногоПараметра = Индекс;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ИндексВитальногоПараметра > -1 Тогда
					СтруктураЗаполнения = Новый Структура();
					СтруктураЗаполнения.Вставить("ГруппирующееПоле", ИндексВитальногоПараметра);
					ДополнитьТаблицуПараметров(ТаблицаПараметров, ПорядковыйНомерПараметра, "ПорядковыйНомер", СтруктураЗаполнения);
					ДополнитьТаблицуПараметров(ТаблицаПараметров, ВитальныйПараметр.КлассификацияПоля.УИДЕГИСЗ, "ИдентификаторВитальногоПараметра", СтруктураЗаполнения);
				КонецЕсли;
			КонецЕсли;
			ПорядковыйНомерПараметра = ПорядковыйНомерПараметра + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоЭлементКлассификатора(Объект)
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Объект)
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "УИДЕГИСЗ")
	Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДобавитьИдентификаторыКомпонентов(ТаблицаПараметров, СвойстваЭМД)
	
	Если СвойстваЭМД <> Неопределено Тогда
		ПрефиксИдентификатораКомпонента = СвойстваЭМД.УИДДокумента;
	Иначе
		ПрефиксИдентификатораКомпонента = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ДобавитьИдентификаторКомпонента(ТаблицаПараметров, ПрефиксИдентификатораКомпонента, "ПрофильЛабораторногоИсследования", "УникальныйИдентификаторКомпонентаЛабИсследования");
	ДобавитьИдентификаторКомпонента(ТаблицаПараметров, ПрефиксИдентификатораКомпонента, "ТипКлиническойШкалы", "УникальныйИдентификаторКомпонентаШкалы");
	
КонецПроцедуры

Процедура ДобавитьИдентификаторКомпонента(ТаблицаПараметров, ПрефиксИдентификатораКомпонента, LocalidКомпонента, LocalidУИДаКомпонента)
	
	Для Каждого СтрокаПрофиля Из ТаблицаПараметров.НайтиСтроки(Новый Структура("localid", LocalidКомпонента)) Цикл
		
		Если ЗначениеЗаполнено(СтрокаПрофиля.ИдентификаторСтроки) Тогда
			УИДКомпонента = СтрШаблон("%1_%2", ПрефиксИдентификатораКомпонента, СтрокаПрофиля.ИдентификаторСтроки);
		ИначеЕсли ЗначениеЗаполнено(СтрокаПрофиля.Параметр) Тогда
			УИДКомпонента = СтрШаблон("%1_%2", ПрефиксИдентификатораКомпонента, Строка(СтрокаПрофиля.ИдентификаторСтроки.УникальныйИдентификатор()));
		ИначеЕсли СтрокаПрофиля.Параметр = Неопределено Тогда
			УИДКомпонента = СтрШаблон("%1_%2", ПрефиксИдентификатораКомпонента, Строка(ТаблицаПараметров.Индекс(СтрокаПрофиля)));
		Иначе
			УИДКомпонента = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		
		Если ТипЗнч(СтрокаПрофиля.Параметр) = Тип("ПланВидовХарактеристикСсылка.ПараметрыHTML") Тогда
			Если ЗначениеЗаполнено(СтрокаПрофиля.ТаблицаШаблонов) Тогда
				// Параметр в многострочной таблице
				СтруктураЗаполнения = Новый Структура();
				СтруктураЗаполнения.Вставить("ГруппирующееПоле",				СтрокаПрофиля.Параметр);
				СтруктураЗаполнения.Вставить("ИдентификаторРодительскойСтроки",	СтрокаПрофиля.ИдентификаторРодительскойСтроки);
				СтруктураЗаполнения.Вставить("ИдентификаторСтроки",				СтрокаПрофиля.ИдентификаторСтроки);
				СтруктураЗаполнения.Вставить("ИдентификаторСтрокиШаблона",		СтрокаПрофиля.ИдентификаторСтрокиШаблона);
				СтруктураЗаполнения.Вставить("НомерСтрокиТаблицы",				СтрокаПрофиля.НомерСтрокиТаблицы);
				
				ДополнитьТаблицуПараметров(ТаблицаПараметров, УИДКомпонента, LocalidУИДаКомпонента, СтруктураЗаполнения);
				
			Иначе
				// Параметр в теле шаблона приёма, но не в многострочной таблице
				УИДКомпонента = СтрШаблон("%1_%2", ПрефиксИдентификатораКомпонента, СтрокаПрофиля.ИдентификаторСтроки);
				ДополнитьТаблицуПараметров(ТаблицаПараметров, УИДКомпонента, LocalidУИДаКомпонента, Новый Структура("ГруппирующееПоле", СтрокаПрофиля.Параметр));
			КонецЕсли;
		ИначеЕсли СтрокаПрофиля.Параметр = Неопределено Тогда
			// Параметр в константе
			ИндексСтроки = ТаблицаПараметров.Индекс(СтрокаПрофиля);
			Если ИндексСтроки > -1 Тогда
				ДополнитьТаблицуПараметров(ТаблицаПараметров, УИДКомпонента, LocalidУИДаКомпонента, Новый Структура("ГруппирующееПоле", ИндексСтроки));
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
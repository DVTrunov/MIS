				// ДополнитьТаблицуПараметров(ТаблицаПараметров, , "ИдентификаторРЭМДОсмотраСтоматолога"); 
			Иначе
				ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(ПМО.УникальныйИдентификатор()), "ИдентификаторМИСОсмотраСтоматолога");
			КонецЕсли;
			
		ИначеЕсли Осмотр.СвязьСКлассификатором.УИДЕГИСЗ = 109 Тогда
			
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.СвязьСКлассификатором, "ДолжностьТерапевта");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Сотрудник, "Терапевт");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.ДатаВыполненияДействияМедосмотра, "ДатаОсмотраТерапевта");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Заключение, "ПримечаниеТерапевта");
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Сотрудник.Подразделение.ПодразделениеМинздрава, "ПодразделениеТерапевта");
			
			// Проверка на случай если попадет неопределено
			Если Осмотр.ВыявленыПротивопоказания = Истина Тогда
				ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(73), "ЗаключениеТерапевта");
			Иначе
				ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(74), "ЗаключениеТерапевта");
			КонецЕсли;
			
			ФилиалСотрудника = Осмотр.Сотрудник.Подразделение.Филиал;
			ОрганизацияСотрудника = ФилиалСотрудника.Организация;
			
			Если ЗначениеЗаполнено(ОрганизацияСотрудника) Тогда
				
				ДополнитьТаблицуПараметров(ТаблицаПараметров, ОрганизацияСотрудника.МедицинскаяОрганизация.ПолноеНаименование, "ОрганизацияТерапевта");
				КонтактыОрганизации = КонтактыОрганизацииФилиала(ФилиалСотрудника);
				Если КонтактыОрганизации <> Неопределено Тогда
					ДополнитьТаблицуПараметров(ТаблицаПараметров, КонтактыОрганизации, "КонтактыОрганизацииТерапевта");
				КонецЕсли;
				
				АдресОрганизации = АдресОрганизацииФилиала(ФилиалСотрудника);
				Если ЗначениеЗаполнено(АдресОрганизации) Тогда
					ДополнитьТаблицуПараметров(ТаблицаПараметров, АдресОрганизации, "АдресОрганизацииТерапевта");
				КонецЕсли;
			// Если заполнено подразделение минздрава но нет связи с организацией, то тянем наименование МО из классификатора МО
			ИначеЕсли ЗначениеЗаполнено(Осмотр.Сотрудник.Подразделение.ПодразделениеМинздрава) Тогда
				МОПодразделения = ПолучитьМОПоПодразделениюСотрудника(Осмотр.Сотрудник);
				Если ЗначениеЗаполнено(МОПодразделения) Тогда
					ДополнитьТаблицуПараметров(ТаблицаПараметров, МОПодразделения.ПолноеНаименование, "ОрганизацияТерапевта");
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Осмотр.ПриемСсылка) Тогда
				ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(Осмотр.ПриемСсылка.УникальныйИдентификатор()), "ИдентификаторМИСОсмотраТерапевта");
				// ДополнитьТаблицуПараметров(ТаблицаПараметров, , "ИдентификаторРЭМДОсмотраТерапевта");
			Иначе
				ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(ПМО.УникальныйИдентификатор()), "ИдентификаторМИСОсмотраТерапевта");
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИнтеграцияЕГИСЗ_СЭМД.УСотрудникаЕстьДолжностьДействияМедосмотра230(Осмотр.Сотрудник, Осмотр.ДействиеМедосмотра) Тогда
			// Общие секции: данные исполнителя
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Сотрудник, "ЧленКомиссии");
			
			СтруктураЗаполнения = Новый Структура();
			СтруктураЗаполнения.Вставить("ГруппирующееПоле", ТаблицаПараметров.Количество() - 1);
			
			ДополнитьТаблицуПараметров(ТаблицаПараметров, ПолучитьРольЧленаКомиссии(),												"РольСотрудникаЧленаМедкомиссииПриПодписанииМД", СтруктураЗаполнения);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(Осмотр.Сотрудник.УникальныйИдентификатор()),						"УИДЧленаМедкомиссии",							 СтруктураЗаполнения);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(Осмотр.Сотрудник.СНИЛС),	"СНИЛСЧленаМедкомиссии",						 СтруктураЗаполнения);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.СвязьСКлассификатором,												"ДолжностьЧленаМедкомиссии",					 СтруктураЗаполнения);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, ПолучитьРабочуюПочту(Осмотр.Сотрудник),									"КонтактыЧленаМедкомиссии",						 СтруктураЗаполнения);
			
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Сотрудник.Фамилия,	 "ФамилияЧленаМедкомиссии",	 СтруктураЗаполнения);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Сотрудник.Имя,		 "ИмяЧленаМедкомиссии",		 СтруктураЗаполнения);
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.Сотрудник.Отчество, "ОтчествоЧленаМедкомиссии", СтруктураЗаполнения);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМОПоПодразделениюСотрудника(Сотрудник)
	
	ПодразделениеМЗ = Сотрудник.Подразделение.ПодразделениеМинздрава;
	OIDМОПодразделения = ПодразделениеМЗ.Атрибуты.Найти("mo_oid");
	Если OIDМОПодразделения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеестрМедицинскихОрганизаций.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РеестрМедицинскихОрганизаций КАК РеестрМедицинскихОрганизаций
		|ГДЕ
		|	РеестрМедицинскихОрганизаций.OIDОрганизации = &OIDОрганизации
		|	И РеестрМедицинскихОрганизаций.ТестовыйКонтур = &ТестовыйКонтур
		|	И НЕ РеестрМедицинскихОрганизаций.Архив
		|	И НЕ РеестрМедицинскихОрганизаций.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("OIDОрганизации", OIDМОПодразделения.Значение);
	Запрос.УстановитьПараметр("ТестовыйКонтур", ПодразделениеМЗ.ТестовыйКонтур);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьДанныеЛабораторныхИсследований230(ПМО, ВредныйФактор, ЕстьПрививкаОтКори, ТаблицаДляПроверкиКорректностиЗаполнения = Неопределено) Экспорт
	
	МодульМедосмотрыСервер = ДопСерверныеФункции.ОбщийМодуль("МедосмотрыСервер");
	
	ПМОПредварительный = ПМО.ТипМедосмотра = Перечисления.ТипыМедосмотров.Предварительный;
	
	ДопустимыеИсследования = ПереченьДопустимыхЛабораторныхИсследований(ВредныйФактор, ПМОПредварительный, ЕстьПрививкаОтКори);
	
	// Используется для проверки того, что все обязательные действия выполнены
	ТаблицаДляПроверкиКорректностиЗаполнения = ДопустимыеИсследования;
	
	// Удаляем необязательные действия
	Для Каждого СтрокаНеобязательногоДействия Из ТаблицаДляПроверкиКорректностиЗаполнения.НайтиСтроки(Новый Структура("Обязательное", Ложь)) Цикл
		ТаблицаДляПроверкиКорректностиЗаполнения.Удалить(СтрокаНеобязательногоДействия);
	КонецЦикла;
	
	ТаблицаЛабИсследований = Новый ТаблицаЗначений;
	ТаблицаЛабИсследований.Колонки.Добавить("ДействиеМедосмотра");
	ТаблицаЛабИсследований.Колонки.Добавить("ПриемСсылка");
	ТаблицаЛабИсследований.Колонки.Добавить("ДатаВыполненияДействияМедосмотра");
	ТаблицаЛабИсследований.Колонки.Добавить("ВыявленыПротивопоказания");
	ТаблицаЛабИсследований.Колонки.Добавить("Сотрудник");
	ТаблицаЛабИсследований.Колонки.Добавить("СвязьСКлассификатором");
	ТаблицаЛабИсследований.Колонки.Добавить("Заключение");
	ТаблицаЛабИсследований.Колонки.Добавить("ТитрСерологическогоОбследования");
	
	// Опеределим исследования передаваемые для текущего фактора 
	СписокДействий = Новый Массив;
	Для Каждого СтрокаДействия Из ПМО.ДействияМедосмотра Цикл
		Если ТипЗнч(СтрокаДействия.Действие.СвязьСКлассификатором) = Тип("СправочникСсылка.КлассификаторыМинЗдрава")
			И СтрокаДействия.Действие.СвязьСКлассификатором.ВидКлассификатора = Перечисления.ВидыКлассификаторовМинЗдрава.ПрофилиЛабораторныхИсследований
			И ДопустимыеИсследования.Найти(СтрокаДействия.Действие.СвязьСКлассификатором.УИДЕГИСЗ, "ИсследованиеУИДЕГИСЗ") <> Неопределено 
		Тогда
			СписокДействий.Добавить(СтрокаДействия.Действие);
		КонецЕсли;
	КонецЦикла;
	
	ПриемыПоДействиямМедосмотров = МодульМедосмотрыСервер.ПриемыПоДействиямМедосмотров(ПМО, СписокДействий);
	
	ТаблицаПараметровИЗначений = МедосмотрыСервер.ПолучитьТаблицуДействийМедосмотраИЗначений(ПМО, СписокДействий);
	СписокПротивопоказаний = Документы.ПрохождениеМедосмотра.ПротивопоказанияМедОсмотра(ПМО);
	
	Для Каждого Действие Из СписокДействий Цикл
		
		ПриемПоДействию = ПриемыПоДействиямМедосмотров.Получить(Действие);
		
		// Проверка наличия приема
		Если ПриемПоДействию = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаЛабИсследования = ТаблицаЛабИсследований.Добавить();
		СтрокаЛабИсследования.ДействиеМедосмотра = Действие;
		СтрокаЛабИсследования.ПриемСсылка = ПриемПоДействию;
		СтрокаЛабИсследования.СвязьСКлассификатором = Действие.СвязьСКлассификатором;
		СтрокаЛабИсследования.ДатаВыполненияДействияМедосмотра = ПриемПоДействию.Дата;
		
		// Профнепригодность устанавливается по приему однозначно, если он не выполнял других действий медосмотров
		СтрокаЛабИсследования.ВыявленыПротивопоказания = НаличиеПротивопоказанийПоДействию230(ПриемПоДействию, Действие, ПМО);
		
		// Рассчитываем автозаключение
		ОтборДействиеМедосмотра = Новый Структура("ДействиеМедосмотра");
		ОтборДействиеМедосмотра.ДействиеМедосмотра = Действие;
		
		ТаблицаПараметровДействия = ТаблицаПараметровИЗначений.Скопировать(ТаблицаПараметровИЗначений.НайтиСтроки(ОтборДействиеМедосмотра));
		СтрокиВредныхФакторов = СписокПротивопоказаний.НайтиСтроки(Новый Структура("Действие", Действие));
		СписокВредныхФакторов = СписокПротивопоказаний.Скопировать(СтрокиВредныхФакторов, "ВредныйФактор").ВыгрузитьКолонку("ВредныйФактор");
		
		АвтоматическоеЗаключение = МедосмотрыСервер.ЗаключениеДляДействияМедОсмотра(СписокВредныхФакторов, "", ТаблицаПараметровДействия, Действие.Вид);
		Если ЗначениеЗаполнено(АвтоматическоеЗаключение) Тогда
			СтрокаЛабИсследования.Заключение = АвтоматическоеЗаключение;
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнитьСведениямиИзОтметокДляВыписки230(ПМО, ТаблицаЛабИсследований, СписокДействий);
	
	Для Каждого ЛабораторноеИсследование Из ТаблицаЛабИсследований Цикл
		Если ЗначениеЗаполнено(ЛабораторноеИсследование.СвязьСКлассификатором) Тогда
			// Удаляем все заполненные строки, оставляем только невыполненные обязательные действия
			СтрокаДляУдаления = ТаблицаДляПроверкиКорректностиЗаполнения.Найти(ЛабораторноеИсследование.СвязьСКлассификатором.УИДЕГИСЗ, "ИсследованиеУИДЕГИСЗ");
			Если СтрокаДляУдаления <> Неопределено Тогда
				ТаблицаДляПроверкиКорректностиЗаполнения.Удалить(СтрокаДляУдаления);
			КонецЕсли
		КонецЕсли;
	КонецЦикла;
	
	Возврат СформироватьОбъединеннуюТаблицуРезультатовДействий230(ТаблицаЛабИсследований, ПМО);
	
КонецФункции

Процедура ДополнитьТаблицуДаннымиЛабИсследований(ТаблицаПараметров, ДанныеЛабораторныхИсследований, ПМО)
	
	Для Каждого Исследование Из ДанныеЛабораторныхИсследований Цикл
		
		Если Не ЗначениеЗаполнено(Исследование.СвязьСКлассификатором) Тогда
			Продолжить;
		КонецЕсли;
		
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Исследование.СвязьСКлассификатором, "ПрофильЛабораторногоИсследования");
		
		СтруктураЗаполнения = Новый Структура();
		СтруктураЗаполнения.Вставить("ГруппирующееПоле",ТаблицаПараметров.Количество() - 1);
		
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Исследование.ДатаВыполненияДействияМедосмотра, "ДатаОбследования", СтруктураЗаполнения);
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Исследование.Заключение, "ПримечаниеИсследования", СтруктураЗаполнения);
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Исследование.ТитрСерологическогоОбследования, "ТитрПоРезультатамСерологическихОбследований", СтруктураЗаполнения);
		
		// Проверка на случай если попадет неопределено
		Если Исследование.ВыявленыПротивопоказания = Истина Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(55), "ЗаключениеЛабораторногоИсследования", СтруктураЗаполнения);
		Иначе
			ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(54), "ЗаключениеЛабораторногоИсследования", СтруктураЗаполнения);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Исследование.ПриемСсылка) Тогда
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(Исследование.ПриемСсылка.УникальныйИдентификатор()), "ИдентификаторМИСЛабораторногоИсследования", СтруктураЗаполнения);
			// ДополнитьТаблицуПараметров(ТаблицаПараметров, , "ИдентификаторРЭМДЛабораторногоИсследования", СтруктураЗаполнения); 
		Иначе
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(ПМО.УникальныйИдентификатор()), "ИдентификаторМИСЛабораторногоИсследования", СтруктураЗаполнения);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеИнструментальногоИсследования230(ПМО, ВредныйФактор) Экспорт
	
	МодульМедосмотрыСервер = ДопСерверныеФункции.ОбщийМодуль("МедосмотрыСервер");
	
	ДопустимыеИсследования = ПереченьДопустимыхИнструментальныхИсследований(ВредныйФактор);
	
	ТаблицаИнстрИсследований = Новый ТаблицаЗначений;
	ТаблицаИнстрИсследований.Колонки.Добавить("ДействиеМедосмотра");
	ТаблицаИнстрИсследований.Колонки.Добавить("ПриемСсылка");
	ТаблицаИнстрИсследований.Колонки.Добавить("ДатаВыполненияДействияМедосмотра");
	ТаблицаИнстрИсследований.Колонки.Добавить("ВыявленыПротивопоказания");
	ТаблицаИнстрИсследований.Колонки.Добавить("Сотрудник");
	ТаблицаИнстрИсследований.Колонки.Добавить("СвязьСКлассификатором");
	ТаблицаИнстрИсследований.Колонки.Добавить("Заключение");
	ТаблицаИнстрИсследований.Колонки.Добавить("ТитрСерологическогоОбследования");
	 
	СписокДействий = Новый Массив;
	Для Каждого СтрокаДействия Из ПМО.ДействияМедосмотра Цикл
		Если ТипЗнч(СтрокаДействия.Действие.СвязьСКлассификатором) = Тип("СправочникСсылка.ИнструментальныеИсследования")
			И ДопустимыеИсследования.Найти(СтрокаДействия.Действие.СвязьСКлассификатором.УИДЕГИСЗ) <> Неопределено 
		Тогда
			СписокДействий.Добавить(СтрокаДействия.Действие);
		КонецЕсли;
	КонецЦикла;
	
	ПриемыПоДействиямМедосмотров = МодульМедосмотрыСервер.ПриемыПоДействиямМедосмотров(ПМО, СписокДействий);
	
	ТаблицаПараметровИЗначений	 = МедосмотрыСервер.ПолучитьТаблицуДействийМедосмотраИЗначений(ПМО, СписокДействий);
	СписокПротивопоказаний = Документы.ПрохождениеМедосмотра.ПротивопоказанияМедОсмотра(ПМО);
	
	Для Каждого Действие Из СписокДействий Цикл
		
		ПриемПоДействию = ПриемыПоДействиямМедосмотров.Получить(Действие);
		
		// Проверка наличия приема
		Если ПриемПоДействию = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаИнстрИсследования = ТаблицаИнстрИсследований.Добавить();
		СтрокаИнстрИсследования.ДействиеМедосмотра = Действие;
		СтрокаИнстрИсследования.ПриемСсылка = ПриемПоДействию;
		СтрокаИнстрИсследования.СвязьСКлассификатором = Действие.СвязьСКлассификатором;
		СтрокаИнстрИсследования.ДатаВыполненияДействияМедосмотра = ПриемПоДействию.Дата;
		
		// Профнепригодность устанавливается по приему однозначно, если он не выполнял других действий медосмотров
		СтрокаИнстрИсследования.ВыявленыПротивопоказания = НаличиеПротивопоказанийПоДействию230(ПриемПоДействию, Действие, ПМО);
		
		// Рассчитываем автозаключение
		ОтборДействиеМедосмотра = Новый Структура("ДействиеМедосмотра");
		ОтборДействиеМедосмотра.ДействиеМедосмотра = Действие;
		
		ТаблицаПараметровДействия = ТаблицаПараметровИЗначений.Скопировать(ТаблицаПараметровИЗначений.НайтиСтроки(ОтборДействиеМедосмотра));
		СтрокиВредныхФакторов = СписокПротивопоказаний.НайтиСтроки(Новый Структура("Действие", Действие));
		СписокВредныхФакторов = СписокПротивопоказаний.Скопировать(СтрокиВредныхФакторов, "ВредныйФактор").ВыгрузитьКолонку("ВредныйФактор");
		
		АвтоматическоеЗаключение = МедосмотрыСервер.ЗаключениеДляДействияМедОсмотра(СписокВредныхФакторов, "", ТаблицаПараметровДействия, Действие.Вид);
		Если ЗначениеЗаполнено(АвтоматическоеЗаключение) Тогда
			СтрокаИнстрИсследования.Заключение = АвтоматическоеЗаключение;
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнитьСведениямиИзОтметокДляВыписки230(ПМО, ТаблицаИнстрИсследований, СписокДействий);
	
	Возврат СформироватьОбъединеннуюТаблицуРезультатовДействий230(ТаблицаИнстрИсследований, ПМО, , Истина);
	
КонецФункции

Процедура ДополнитьТаблицуДаннымиИнстрИсследования(ТаблицаПараметров, ДанныеИнструментальногоИсследования, ПМО)
	
	Если ДанныеИнструментальногоИсследования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИнструментальноеИсследование = ДанныеИнструментальногоИсследования[0];
	
	Если Не ЗначениеЗаполнено(ИнструментальноеИсследование.СвязьСКлассификатором) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнитьТаблицуПараметров(ТаблицаПараметров, ИнструментальноеИсследование.СвязьСКлассификатором, "ИнструментальноеОбследование");
	
	ДополнитьТаблицуПараметров(ТаблицаПараметров, ИнструментальноеИсследование.ДатаВыполненияДействияМедосмотра, "ДатаИнструментальногоОбследования");
	ДополнитьТаблицуПараметров(ТаблицаПараметров, ИнструментальноеИсследование.Заключение, "ПримечаниеИнструментальногоОбследования");
	
	// Проверка на случай если попадет неопределено
	Если ИнструментальноеИсследование.ВыявленыПротивопоказания = Истина Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(57), "ЗаключениеИнструментальногоОбследования");
	Иначе
		ДополнитьТаблицуПараметров(ТаблицаПараметров, ЗаключениеМедосмотра(56), "ЗаключениеИнструментальногоОбследования");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнструментальноеИсследование.ПриемСсылка) Тогда
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(ИнструментальноеИсследование.ПриемСсылка.УникальныйИдентификатор()), "ИдентификаторМИСИнструментальногоОбследования");
		// ДополнитьТаблицуПараметров(ТаблицаПараметров, , "ИдентификаторРЭМДИнструментальногоОбследования", СтруктураЗаполнения); 
	Иначе
		ДополнитьТаблицуПараметров(ТаблицаПараметров, Строка(ПМО.УникальныйИдентификатор()), "ИдентификаторМИСИнструментальногоОбследования");
	КонецЕсли;
	
КонецПроцедуры

Функция ПереченьДопустимыхЛабораторныхИсследований(ВредныйФактор, ПМОПредварительный, ЕстьПрививкаОтКори) Экспорт
	
	ЛабораторныеИсследования = Новый ТаблицаЗначений;
	ЛабораторныеИсследования.Колонки.Добавить("ИсследованиеУИДЕГИСЗ");
	ЛабораторныеИсследования.Колонки.Добавить("Обязательное", Новый ОписаниеТипов("Булево"));
	
	Если ЕстьПрививкаОтКори Тогда
		ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10510, Ложь);
	Иначе
		ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10510, Истина);
	КонецЕсли;
	
	Если ВредныйФактор.УИДЕГИСЗ = 211 Тогда
		Если ПМОПредварительный Тогда
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10268, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10479, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10506, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10507, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10508, Истина);
		Иначе
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10268, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10506, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10479, Ложь);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10507, Ложь);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10508, Ложь);
		КонецЕсли;
	ИначеЕсли ВредныйФактор.УИДЕГИСЗ = 212 Тогда
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10268, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10506, Истина);
	ИначеЕсли ВредныйФактор.УИДЕГИСЗ = 213 Тогда
		Если ПМОПредварительный Тогда
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10268, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10479, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10506, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10507, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10509, Истина);
		Иначе
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10268, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10506, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10479, Ложь);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10507, Ложь);
		КонецЕсли;
	ИначеЕсли ВредныйФактор.УИДЕГИСЗ = 214 Тогда
		Если ПМОПредварительный Тогда
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10479, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10506, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10507, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10509, Истина);
		Иначе
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10506, Истина);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10479, Ложь);
			ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, 10507, Ложь);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЛабораторныеИсследования;
	
КонецФункции

Функция ПереченьДопустимыхИнструментальныхИсследований(ВредныйФактор) Экспорт
	
	ИнструментальныеИсследования = Новый Массив;
	
	// Рентгенография флюорография легких
	ИнструментальныеИсследования.Добавить(7003320);
	
	// Рентгенография грудной клетки
	ИнструментальныеИсследования.Добавить(7002892);
	
	// Компьютерная томография груди
	ИнструментальныеИсследования.Добавить(7001894);
	
	// Рентгеноскопия грудной клетки
	ИнструментальныеИсследования.Добавить(7003288);
	
	Возврат ИнструментальныеИсследования;
	
КонецФункции

Процедура ДобавитьСтрокуВТЧЛабИсследований230(ЛабораторныеИсследования, ИсследованиеУИДЕГИСЗ, Обязательное)
	
	НоваяСтрока = ЛабораторныеИсследования.Добавить();
	НоваяСтрока.ИсследованиеУИДЕГИСЗ = ИсследованиеУИДЕГИСЗ;
	НоваяСтрока.Обязательное = Обязательное;
	
КонецПроцедуры

Функция ПолучитьПриемыСВидомЛабораторноеИсследование(ПМО) Экспорт
	
	МодульМедосмотрыСервер = ДопСерверныеФункции.ОбщийМодуль("МедосмотрыСервер");
	
	ТаблицаЛабораторныхИсследований = Новый ТаблицаЗначений;
	ТаблицаЛабораторныхИсследований.Колонки.Добавить("ДействиеМедосмотра");
	ТаблицаЛабораторныхИсследований.Колонки.Добавить("ПриемСсылка");
	ТаблицаЛабораторныхИсследований.Колонки.Добавить("ДатаВыполненияДействияМедосмотра");
	ТаблицаЛабораторныхИсследований.Колонки.Добавить("Заключение");
	
	// Из отметок для выписки
	
	// Сначала получаем для тех, которые были сопоставлены с приемами
	СписокДействий = Новый Массив;
	Для Каждого СтрокаДействия Из ПМО.ДействияМедосмотра Цикл
		Если СтрокаДействия.Действие.Вид = Перечисления.ВидыДействийМедицинскогоОсмотра.Исследование Тогда
			// Либо проверяем по виду исследования, либо по галочке "Анализ" в номенклатуре
			Если ЗначениеЗаполнено(СтрокаДействия.Действие.ВидИсследования) 
					И СтрокаДействия.Действие.ВидИсследования = Перечисления.ВидыИсследованийДействийМедосмотра.ЛабораторноеИсследование
				Или ЗначениеЗаполнено(СтрокаДействия.Действие.Номенклатура)
					И СтрокаДействия.Действие.Номенклатура.Анализ
			Тогда
				СписокДействий.Добавить(СтрокаДействия.Действие);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПриемСоответствие Из МодульМедосмотрыСервер.ПриемыПоДействиямМедосмотров(ПМО, СписокДействий) Цикл
		СтрокаИсследования = ТаблицаЛабораторныхИсследований.Добавить();
		СтрокаИсследования.ДействиеМедосмотра = ПриемСоответствие.Ключ;
		СтрокаИсследования.ПриемСсылка = ПриемСоответствие.Значение;
		СтрокаИсследования.ДатаВыполненияДействияМедосмотра = ПриемСоответствие.Значение.Дата;
	КонецЦикла;
	
	// Затем добавляем отметки введенные вручную
	ДополнитьСведениямиИзОтметокДляВыписки(ПМО, ТаблицаЛабораторныхИсследований, Перечисления.ВидыДействийМедицинскогоОсмотра.Исследование, Перечисления.ВидыИсследованийДействийМедосмотра.ЛабораторноеИсследование);
	
	// Убираем дубли. Формируем массив структур. Если таблица пустая, добавляем значение по ПМО
	ВидДокумента = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(7, ,"Справочник.ВидыМедицинскихДокументов");
	
	Возврат СформироватьМассивСтруктурРезультатов(ТаблицаЛабораторныхИсследований, ПМО, ВидДокумента);
	
КонецФункции

Функция ПолучитьПриемыСВидомИнструментальноеИсследование(ПМО) Экспорт
	
	ТаблицаИнструментальныхИсследований = Новый ТаблицаЗначений;
	ТаблицаИнструментальныхИсследований.Колонки.Добавить("ДействиеМедосмотра");
	ТаблицаИнструментальныхИсследований.Колонки.Добавить("ПриемСсылка");
	ТаблицаИнструментальныхИсследований.Колонки.Добавить("ДатаВыполненияДействияМедосмотра");
	ТаблицаИнструментальныхИсследований.Колонки.Добавить("Заключение");
	
	// Из отметок для выписки
	
	// Сначала получаем для тех, которые были сопоставлены с приемами
	СписокДействий = Новый Массив;
	Для Каждого СтрокаДействия Из ПМО.ДействияМедосмотра Цикл
		Если СтрокаДействия.Действие.Вид = Перечисления.ВидыДействийМедицинскогоОсмотра.Исследование Тогда
			// Либо проверяем по виду исследования, либо по галочке "Анализ" в номенклатуре
			Если ЗначениеЗаполнено(СтрокаДействия.Действие.ВидИсследования) 
					И СтрокаДействия.Действие.ВидИсследования = Перечисления.ВидыИсследованийДействийМедосмотра.ИнструментальноеИсследование
				Или ЗначениеЗаполнено(СтрокаДействия.Действие.Номенклатура)
					И Не СтрокаДействия.Действие.Номенклатура.Анализ
					И Не ЗначениеЗаполнено(СтрокаДействия.Действие.ВидИсследования)
			Тогда
				СписокДействий.Добавить(СтрокаДействия.Действие);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПриемСоответствие Из МедосмотрыСервер.ПриемыПоДействиямМедосмотров(ПМО, СписокДействий) Цикл
		СтрокаИсследования = ТаблицаИнструментальныхИсследований.Добавить();
		СтрокаИсследования.ДействиеМедосмотра = ПриемСоответствие.Ключ;
		СтрокаИсследования.ПриемСсылка = ПриемСоответствие.Значение;
		СтрокаИсследования.ДатаВыполненияДействияМедосмотра = ПриемСоответствие.Значение.Дата;
	КонецЦикла;
	
	// Затем добавляем отметки введенные вручную
	ДополнитьСведениямиИзОтметокДляВыписки(ПМО, ТаблицаИнструментальныхИсследований, Перечисления.ВидыДействийМедицинскогоОсмотра.Исследование, Перечисления.ВидыИсследованийДействийМедосмотра.ИнструментальноеИсследование);
	
	// Убираем дубли. Формируем массив структур. Если таблица пустая, оставляем пустой
	ВидДокумента = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(6, ,"Справочник.ВидыМедицинскихДокументов");
	
	Возврат СформироватьМассивСтруктурРезультатов(ТаблицаИнструментальныхИсследований, ПМО, ВидДокумента, Ложь);
	
КонецФункции

Функция ПолучитьПриемыСВидомКонсультация(ПМО) Экспорт
	
	МодульМедосмотрыСервер = ДопСерверныеФункции.ОбщийМодуль("МедосмотрыСервер");
	
	ТаблицаКонсультаций = Новый ТаблицаЗначений;
	ТаблицаКонсультаций.Колонки.Добавить("ДействиеМедосмотра");
	ТаблицаКонсультаций.Колонки.Добавить("ПриемСсылка");
	ТаблицаКонсультаций.Колонки.Добавить("ДатаВыполненияДействияМедосмотра");
	ТаблицаКонсультаций.Колонки.Добавить("Заключение");
	
	// Приёмы с отметкой действия Врача
	СписокДействий = Новый Массив;
	Для Каждого СтрокаДействия Из ПМО.ДействияМедосмотра Цикл
		Если СтрокаДействия.Действие.Вид = Перечисления.ВидыДействийМедицинскогоОсмотра.Врач Тогда
			СписокДействий.Добавить(СтрокаДействия.Действие);
		КонецЕсли;
	КонецЦикла;
	
	ПриемыПоДействиямМедосмотров = МодульМедосмотрыСервер.ПриемыПоДействиямМедосмотров(ПМО, СписокДействий);
	Для Каждого ПриемСоответствие Из ПриемыПоДействиямМедосмотров Цикл
		СтрокаКонсультации = ТаблицаКонсультаций.Добавить();
		СтрокаКонсультации.ДействиеМедосмотра = ПриемСоответствие.Ключ;
		СтрокаКонсультации.ПриемСсылка = ПриемСоответствие.Значение;
		СтрокаКонсультации.ДатаВыполненияДействияМедосмотра = ПриемСоответствие.Значение.Дата;
	КонецЦикла;
	
	// Из отметок для выписки
	ДополнитьСведениямиИзОтметокДляВыписки(ПМО, ТаблицаКонсультаций, Перечисления.ВидыДействийМедицинскогоОсмотра.Врач);
	
	ВидДокумента = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(5, ,"Справочник.ВидыМедицинскихДокументов");
	
	Возврат СформироватьМассивСтруктурРезультатов(ТаблицаКонсультаций, ПМО, ВидДокумента);
	
КонецФункции

Процедура ДополнитьСведениямиИзОтметокДляВыписки230(ПМО, ТаблицаПоВидуДействийМедосмотров, ДействияМедосмотра)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаключенияПоДействиямМедосмотра.Действие КАК Действие,
		|	ЗаключенияПоДействиямМедосмотра.ДатаВыполнения КАК ДатаВыполнения,
		|	ЗаключенияПоДействиямМедосмотра.Заключение КАК Заключение,
		|	ЗаключенияПоДействиямМедосмотра.Сотрудник КАК Сотрудник,
		|	ЗаключенияПоДействиямМедосмотра.ВыявленыПротивопоказания КАК ВыявленыПротивопоказания,
		|	ЗаключенияПоДействиямМедосмотра.ТитрСерологическогоОбследования КАК ТитрСерологическогоОбследования
		|ИЗ
		|	РегистрСведений.ЗаключенияПоДействиямМедосмотра КАК ЗаключенияПоДействиямМедосмотра
		|ГДЕ
		|	ЗаключенияПоДействиямМедосмотра.ПрохождениеМедОсмотра = &ПрохождениеМедОсмотра
		|	И ЗаключенияПоДействиямМедосмотра.Действие.Ссылка В(&ДействияМедосмотра)";
	
	Запрос.УстановитьПараметр("ПрохождениеМедОсмотра", ПМО);
	Запрос.УстановитьПараметр("ДействияМедосмотра", ДействияМедосмотра);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = ТаблицаПоВидуДействийМедосмотров.Добавить();
		СтрокаТаблицы.ДействиеМедосмотра = Выборка.Действие;
		СтрокаТаблицы.ДатаВыполненияДействияМедосмотра = Выборка.ДатаВыполнения;
		СтрокаТаблицы.Заключение = Выборка.Заключение;
		СтрокаТаблицы.ВыявленыПротивопоказания = Выборка.ВыявленыПротивопоказания;
		СтрокаТаблицы.Сотрудник = Выборка.Сотрудник;
		СтрокаТаблицы.СвязьСКлассификатором = Выборка.Действие.СвязьСКлассификатором;
		СтрокаТаблицы.ТитрСерологическогоОбследования = Выборка.ТитрСерологическогоОбследования;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьСотрудникамиИзСоставаКомиссии230(ПМО, ТаблицаКонсультаций, СписокДействий)
	
	АктуальныйНаДатуЗавершенияСостав = МедосмотрыСерверПовтИсп.ПолучитьСоставМедкомиссии(ПМО.ДатаЗавершения, Истина, ПМО.Филиал);
	
	Для Каждого Действие Из СписокДействий Цикл
		Для Каждого ЧленМедкомиссии Из АктуальныйНаДатуЗавершенияСостав Цикл
			Если Не ЗначениеЗаполнено(ЧленМедкомиссии.Должность) Тогда
				Продолжить;
			КонецЕсли;
			Если ЧленМедкомиссии.Должность.УИДЕГИСЗ = Действие.СвязьСКлассификатором.УИДЕГИСЗ Тогда
				СтрокаТаблицы = ТаблицаКонсультаций.Добавить();
				СтрокаТаблицы.ДействиеМедосмотра = Действие;
				СтрокаТаблицы.Сотрудник = ЧленМедкомиссии.Сотрудник;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьСведениямиИзОтметокДляВыписки(ПМО, ТаблицаПоВидуДействийМедосмотров, ВидДействияМедосмотра, ВидИсследования = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаключенияПоДействиямМедосмотра.Действие КАК Действие,
		|	ЗаключенияПоДействиямМедосмотра.ДатаВыполнения КАК ДатаВыполнения,
		|	ЗаключенияПоДействиямМедосмотра.Заключение КАК Заключение
		|ИЗ
		|	РегистрСведений.ЗаключенияПоДействиямМедосмотра КАК ЗаключенияПоДействиямМедосмотра
		|ГДЕ
		|	ЗаключенияПоДействиямМедосмотра.ПрохождениеМедОсмотра = &ПрохождениеМедОсмотра
		|	И ЗаключенияПоДействиямМедосмотра.Действие.Вид = &ВидДействияМедосмотра
		|	И &УсловиеВидаИсследования
		|	И ЗаключенияПоДействиямМедосмотра.ДатаВыполнения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";
	
	Запрос.УстановитьПараметр("ПрохождениеМедОсмотра", ПМО);
	Запрос.УстановитьПараметр("ВидДействияМедосмотра", ВидДействияМедосмотра);
	
	Если ЗначениеЗаполнено(ВидИсследования) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидаИсследования", "ЗаключенияПоДействиямМедосмотра.Действие.ВидИсследования = &ВидИсследования");
		Запрос.УстановитьПараметр("ВидИсследования", ВидИсследования);
	Иначе
		Запрос.УстановитьПараметр("УсловиеВидаИсследования", Истина);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = ТаблицаПоВидуДействийМедосмотров.Добавить();
		СтрокаТаблицы.ДействиеМедосмотра = Выборка.Действие;
		СтрокаТаблицы.ДатаВыполненияДействияМедосмотра = Выборка.ДатаВыполнения;
		СтрокаТаблицы.Заключение = Выборка.Заключение;
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьОбъединеннуюТаблицуРезультатовДействий230(ТаблицаПоВидуДействийМедосмотров, ПМО, ЭтоДействияВрача = Ложь, ЭтоИнструментальноеИсследование = Ложь)
	
	ТекстЗаключенияПоУмолчанию = МедосмотрыКлиентСервер.ТекстЗаключенияПоУмолчанию();
	
	ТаблицаУникальныеДействия = ТаблицаПоВидуДействийМедосмотров.Скопировать(, "ДействиеМедосмотра");
	ТаблицаУникальныеДействия.Свернуть("ДействиеМедосмотра");
	МассивДействий = ТаблицаУникальныеДействия.ВыгрузитьКолонку("ДействиеМедосмотра");
	
	// Объединяем строки оставляя максимальное количество данных
	ТаблицаПоВидуДействийМедосмотровОбъединенная = ТаблицаПоВидуДействийМедосмотров.СкопироватьКолонки();
	Для Каждого ДействиеПМО Из МассивДействий Цикл
		ДействиеМедосмотра = ДействиеПМО;
		ПриемСсылка = Неопределено;
		ДатаВыполненияДействияМедосмотра = Неопределено;
		Заключение = "";
		ВыявленыПротивопоказания = Ложь;
		Сотрудник = Неопределено;
		СвязьСКлассификатором = ДействиеПМО.СвязьСКлассификатором;
		ТитрСерологическогоОбследования = "";
		
		СтрокиДляОбъединения = ТаблицаПоВидуДействийМедосмотров.НайтиСтроки(Новый Структура("ДействиеМедосмотра", ДействиеПМО));
		
		Для Каждого СтрокаДляОбъединения Из СтрокиДляОбъединения Цикл
			Если Не ЗначениеЗаполнено(ПриемСсылка) Тогда
				ПриемСсылка = СтрокаДляОбъединения.ПриемСсылка;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ДатаВыполненияДействияМедосмотра) Тогда
				ДатаВыполненияДействияМедосмотра = СтрокаДляОбъединения.ДатаВыполненияДействияМедосмотра;
			КонецЕсли;
			Если Не ВыявленыПротивопоказания 
				И СтрокаДляОбъединения.ВыявленыПротивопоказания <> Неопределено 
			Тогда
				ВыявленыПротивопоказания = СтрокаДляОбъединения.ВыявленыПротивопоказания;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Сотрудник) Тогда
				Сотрудник = СтрокаДляОбъединения.Сотрудник;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ТитрСерологическогоОбследования) Тогда
				ТитрСерологическогоОбследования = СтрокаДляОбъединения.ТитрСерологическогоОбследования;
			КонецЕсли;
			// Запоминаем первый отличный от стандартного текст заключения
			Если ЗначениеЗаполнено(СтрокаДляОбъединения.Заключение)
				И (ЗначениеЗаполнено(ДействиеПМО.ТекстЗаключенияПоУмолчанию) 
				И СтрокаДляОбъединения.Заключение <> ДействиеПМО.ТекстЗаключенияПоУмолчанию
				Или Не ЗначениеЗаполнено(ДействиеПМО.ТекстЗаключенияПоУмолчанию)
				И СтрокаДляОбъединения.Заключение <> ТекстЗаключенияПоУмолчанию)
			Тогда
				Заключение = СтрокаДляОбъединения.Заключение;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаОбъединеннойТаблицы = ТаблицаПоВидуДействийМедосмотровОбъединенная.Добавить();
		
		СтрокаОбъединеннойТаблицы.ДействиеМедосмотра				= ДействиеМедосмотра;
		СтрокаОбъединеннойТаблицы.ПриемСсылка						= ПриемСсылка;
		СтрокаОбъединеннойТаблицы.ДатаВыполненияДействияМедосмотра	= ДатаВыполненияДействияМедосмотра;
		СтрокаОбъединеннойТаблицы.ВыявленыПротивопоказания			= ВыявленыПротивопоказания;
		СтрокаОбъединеннойТаблицы.Сотрудник							= Сотрудник;
		СтрокаОбъединеннойТаблицы.СвязьСКлассификатором				= СвязьСКлассификатором;
		СтрокаОбъединеннойТаблицы.ТитрСерологическогоОбследования	= ТитрСерологическогоОбследования;
		
		Если Не ЗначениеЗаполнено(Заключение) Тогда
			Если ЗначениеЗаполнено(ДействиеМедосмотра.ТекстЗаключенияПоУмолчанию) Тогда
				СтрокаОбъединеннойТаблицы.Заключение = ДействиеМедосмотра.ТекстЗаключенияПоУмолчанию;
			Иначе
				СтрокаОбъединеннойТаблицы.Заключение = ТекстЗаключенияПоУмолчанию;
			КонецЕсли;
		Иначе
			СтрокаОбъединеннойТаблицы.Заключение = Заключение;
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьНаименееЗаполненныеДублиДействий230(ТаблицаПоВидуДействийМедосмотровОбъединенная, МассивДействий, ЭтоДействияВрача, ЭтоИнструментальноеИсследование);
	
	Возврат ТаблицаПоВидуДействийМедосмотровОбъединенная;
	
КонецФункции

Функция СформироватьМассивСтруктурРезультатов(ТаблицаПоВидуДействийМедосмотров, ПМО, ВидДокумента, ДополнитьПМО = Истина)
	
	ОписаниеСвязанногоДокументаПоУмолчанию = ОписаниеСвязанногоДокументаПоУмолчанию_194(ВидДокумента);
	ТекстЗаключенияПоУмолчанию = МедосмотрыКлиентСервер.ТекстЗаключенияПоУмолчанию();
	МассивСтруктурПоВидуДействийМедосмотра = Новый Массив;
	
	Если ТаблицаПоВидуДействийМедосмотров.Количество() = 0
		И ДополнитьПМО 
	Тогда
		СтруктураПоВидуДействийМедосмотра = Новый Структура;
		СтруктураПоВидуДействийМедосмотра.Вставить("Дата",				ПМО.Дата);
		СтруктураПоВидуДействийМедосмотра.Вставить("Документ",			ПМО);
		СтруктураПоВидуДействийМедосмотра.Вставить("Описание",			ОписаниеСвязанногоДокументаПоУмолчанию);
		СтруктураПоВидуДействийМедосмотра.Вставить("ВидДокумента",		ВидДокумента);
		СтруктураПоВидуДействийМедосмотра.Вставить("ИдентификаторМИС",	Строка(ПМО.УникальныйИдентификатор()));
		СтруктураПоВидуДействийМедосмотра.Вставить("ИдентификаторРЭМД",	Неопределено);
		МассивСтруктурПоВидуДействийМедосмотра.Добавить(СтруктураПоВидуДействийМедосмотра);
		Возврат МассивСтруктурПоВидуДействийМедосмотра;
	КонецЕсли;
	
	ТаблицаУникальныеДействия = ТаблицаПоВидуДействийМедосмотров.Скопировать(, "ДействиеМедосмотра");
	ТаблицаУникальныеДействия.Свернуть("ДействиеМедосмотра");
	МассивДействий = ТаблицаУникальныеДействия.ВыгрузитьКолонку("ДействиеМедосмотра");
	
	ЗаключенияДействий = ПолучитьЗаключенияПриемов(МассивДействий, ПМО);
	ТаблицаПараметровИЗначений = МедосмотрыСервер.ПолучитьТаблицуДействийМедосмотраИЗначений(ПМО, МассивДействий);
	СписокПротивопоказаний = Документы.ПрохождениеМедосмотра.ПротивопоказанияМедОсмотра(ПМО);
	
	// Объединяем строки оставляя максимальное количество данных
	ТаблицаПоВидуДействийМедосмотровОбъединенная = ТаблицаПоВидуДействийМедосмотров.СкопироватьКолонки();
	Для Каждого ДействиеПМО Из МассивДействий Цикл
		ДействиеМедосмотра = ДействиеПМО;
		ПриемСсылка = Неопределено;
		ДатаВыполненияДействияМедосмотра = Неопределено;
		Заключение = Неопределено;
		
		СтрокиДляОбъединения = ТаблицаПоВидуДействийМедосмотров.НайтиСтроки(Новый Структура("ДействиеМедосмотра", ДействиеПМО));
		
		Для Каждого СтрокаДляОбъединения Из СтрокиДляОбъединения Цикл
			Если Не ЗначениеЗаполнено(ПриемСсылка) Тогда
				ПриемСсылка = СтрокаДляОбъединения.ПриемСсылка;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ДатаВыполненияДействияМедосмотра) Тогда
				ДатаВыполненияДействияМедосмотра = СтрокаДляОбъединения.ДатаВыполненияДействияМедосмотра;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Заключение) Тогда
				Если ЗначениеЗаполнено(СтрокаДляОбъединения.Заключение) Тогда
					Заключение = СтрокаДляОбъединения.Заключение;
				Иначе
					Заключения = ЗаключенияДействий.НайтиСтроки(Новый Структура("Действие", ДействиеПМО));
					Если Заключения.Количество() <> 0 Тогда
						Заключение = Заключения[0].Заключение;
					Иначе
						ОтборДействиеМедосмотра = Новый Структура("ДействиеМедосмотра");
						ОтборДействиеМедосмотра.ДействиеМедосмотра = ДействиеПМО;
						ТаблицаПараметровДействия = ТаблицаПараметровИЗначений.Скопировать(ТаблицаПараметровИЗначений.НайтиСтроки(ОтборДействиеМедосмотра));
						СтрокиВредныхФакторов = СписокПротивопоказаний.НайтиСтроки(Новый Структура("Действие", ДействиеПМО));
						СписокВредныхФакторов = СписокПротивопоказаний.Скопировать(СтрокиВредныхФакторов, "ВредныйФактор").ВыгрузитьКолонку("ВредныйФактор");
						АвтоматическоеЗаключение = МедосмотрыСервер.ЗаключениеДляДействияМедОсмотра(СписокВредныхФакторов, "", ТаблицаПараметровДействия, ДействиеПМО.Вид);
						Если ЗначениеЗаполнено(АвтоматическоеЗаключение) Тогда
							Заключение = АвтоматическоеЗаключение;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаОбъединеннойТаблицы = ТаблицаПоВидуДействийМедосмотровОбъединенная.Добавить();
		
		СтрокаОбъединеннойТаблицы.ДействиеМедосмотра				 = ДействиеМедосмотра;
		СтрокаОбъединеннойТаблицы.ПриемСсылка						 = ПриемСсылка;
		СтрокаОбъединеннойТаблицы.ДатаВыполненияДействияМедосмотра	 = ДатаВыполненияДействияМедосмотра;
		СтрокаОбъединеннойТаблицы.Заключение						 = Заключение;
	КонецЦикла;
	
	ТаблицаУникальныеПриемы = ТаблицаПоВидуДействийМедосмотров.Скопировать(, "ПриемСсылка");
	ТаблицаУникальныеПриемы.Свернуть("ПриемСсылка");
	МассивПриемов = ТаблицаУникальныеПриемы.ВыгрузитьКолонку("ПриемСсылка");
	
	Для Каждого Прием Из МассивПриемов Цикл
		
		Если Не ЗначениеЗаполнено(Прием) Тогда
			Продолжить;
		КонецЕсли;
		
		мЧастиОписания = Новый Массив;
		СтрокиПоПриему = ТаблицаПоВидуДействийМедосмотровОбъединенная.НайтиСтроки(Новый Структура("ПриемСсылка", Прием));
		Для Каждого СтрокаПоПриему Из СтрокиПоПриему Цикл
			мЧастиОписания.Добавить(ФормированиеОписанияДокумента(СтрокаПоПриему, ТекстЗаключенияПоУмолчанию, ОписаниеСвязанногоДокументаПоУмолчанию));
		КонецЦикла;
		
		Если мЧастиОписания.Количество() > 0 Тогда
			Описание = СтрСоединить(мЧастиОписания, "; ");
		Иначе
			Описание = ОписаниеСвязанногоДокументаПоУмолчанию;
		КонецЕсли;
		
		СтруктураПоВидуДействийМедосмотра = Новый Структура;
		СтруктураПоВидуДействийМедосмотра.Вставить("Дата",				Прием.Дата);
		СтруктураПоВидуДействийМедосмотра.Вставить("Документ",			Прием);
		СтруктураПоВидуДействийМедосмотра.Вставить("Описание",			Описание);
		СтруктураПоВидуДействийМедосмотра.Вставить("ВидДокумента",		ВидДокумента);
		СтруктураПоВидуДействийМедосмотра.Вставить("ИдентификаторМИС",	Строка(Прием.УникальныйИдентификатор()));
		СтруктураПоВидуДействийМедосмотра.Вставить("ИдентификаторРЭМД",	Неопределено);
		МассивСтруктурПоВидуДействийМедосмотра.Добавить(СтруктураПоВидуДействийМедосмотра);
	КонецЦикла;
	
	СтрокиБезПриема = ТаблицаПоВидуДействийМедосмотровОбъединенная.НайтиСтроки(Новый Структура("ПриемСсылка", Неопределено));
	
	Для Каждого СтрокаБезПриема Из СтрокиБезПриема Цикл
		
		Описание = ФормированиеОписанияДокумента(СтрокаБезПриема, ТекстЗаключенияПоУмолчанию, ОписаниеСвязанногоДокументаПоУмолчанию);
		
		СтруктураПоВидуДействийМедосмотра = Новый Структура;
		СтруктураПоВидуДействийМедосмотра.Вставить("Дата",				СтрокаБезПриема.ДатаВыполненияДействияМедосмотра);
		СтруктураПоВидуДействийМедосмотра.Вставить("Документ",			Неопределено);
		СтруктураПоВидуДействийМедосмотра.Вставить("Описание",			Описание);
		СтруктураПоВидуДействийМедосмотра.Вставить("ВидДокумента",		ВидДокумента);
		СтруктураПоВидуДействийМедосмотра.Вставить("ИдентификаторМИС",	Неопределено);
		СтруктураПоВидуДействийМедосмотра.Вставить("ИдентификаторРЭМД",	Неопределено);
		МассивСтруктурПоВидуДействийМедосмотра.Добавить(Новый Структура("Описание, ВидДокумента, Дата, ИдентификаторМИС, ИдентификаторРЭМД, Документ", Описание, ВидДокумента, СтрокаБезПриема.ДатаВыполненияДействияМедосмотра));
	КонецЦикла;
	
	Возврат МассивСтруктурПоВидуДействийМедосмотра;
	
КонецФункции

Функция ФормированиеОписанияДокумента(СтрокаТаблицыПоВиду, ТекстЗаключенияПоУмолчанию, ОписаниеСвязанногоДокументаПоУмолчанию)
	
	Описание = "";
	Если ЗначениеЗаполнено(СтрокаТаблицыПоВиду.ДействиеМедосмотра) Тогда
		НаименованиеВидаДокумента = "Протокол осмотра";
		Если ЗначениеЗаполнено(СтрокаТаблицыПоВиду.ДействиеМедосмотра.ВидИсследования) 
			И СтрокаТаблицыПоВиду.ДействиеМедосмотра.ВидИсследования = Перечисления.ВидыИсследованийДействийМедосмотра.ЛабораторноеИсследование 
		Тогда
			НаименованиеВидаДокумента = "Протокол лабораторного исследования";
		КонецЕсли;
		
		ДатаДействия = "";
		Если ЗначениеЗаполнено(СтрокаТаблицыПоВиду.ДатаВыполненияДействияМедосмотра) Тогда
			ДатаДействия = "от " + Формат(СтрокаТаблицыПоВиду.ДатаВыполненияДействияМедосмотра, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		ТекстЗаключенияПоУмолчанию = ?(ЗначениеЗаполнено(СтрокаТаблицыПоВиду.ДействиеМедосмотра.ТекстЗаключенияПоУмолчанию),СтрокаТаблицыПоВиду.ДействиеМедосмотра.ТекстЗаключенияПоУмолчанию,ТекстЗаключенияПоУмолчанию);
		Если ЗначениеЗаполнено(СтрокаТаблицыПоВиду.Заключение) Тогда
			Заключение = СтрокаТаблицыПоВиду.Заключение;
		Иначе
			Заключение = ТекстЗаключенияПоУмолчанию;
		КонецЕсли;
		Описание = СтрШаблон("%1 %2 %3: %4", НаименованиеВидаДокумента, ДатаДействия, СтрокаТаблицыПоВиду.ДействиеМедосмотра.Наименование, Заключение);
	Иначе
		Описание = ОписаниеСвязанногоДокументаПоУмолчанию;
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ПолучитьЗаключенияПриемов(МассивДействий, ПМО)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаключенияПоДействиямМедосмотра.Заключение КАК Заключение,
	               |	ЗаключенияПоДействиямМедосмотра.Действие КАК Действие
	               |ИЗ
	               |	РегистрСведений.ЗаключенияПоДействиямМедосмотра КАК ЗаключенияПоДействиямМедосмотра
	               |ГДЕ
	               |	ЗаключенияПоДействиямМедосмотра.ПрохождениеМедОсмотра = &ПрохождениеМедОсмотра
	               |	И ЗаключенияПоДействиямМедосмотра.Действие В(&Действия)";
	
	Запрос.УстановитьПараметр("ПрохождениеМедОсмотра", ПМО);
	Запрос.УстановитьПараметр("Действия", МассивДействий);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеСвязанногоДокументаПоУмолчанию_194(ВидДокумента)
	
	Если ВидДокумента = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(5, ,"Справочник.ВидыМедицинскихДокументов") Тогда
		Возврат "Консультация";
	ИначеЕсли ВидДокумента = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(7, ,"Справочник.ВидыМедицинскихДокументов") Тогда
		Возврат "Лабораторное исследование";
	КонецЕсли;
	
	Возврат "—";
	
КонецФункции


			КонецЕсли;
			
		ИначеЕсли Осмотр.СвязьСКлассификатором.УИДЕГИСЗ = 53 Тогда
			
			ДополнитьТаблицуПараметров(ТаблицаПараметров, Осмотр.СвязьСКлассификатором, "ДолжностьОториноларинголога");

#Область СериализацияДанных

// Заполняем постоянные данные MWL
// Формируем массив структур для заполнения таблицы статических данных для формирования 
Функция СформироватьМассивСтатичнойСериализации(КлиентСсылка, СотрудникСсылка) Экспорт
	
	ДанныеDICOM = Новый Массив;
	
	// Сразу заполняем ID пациента и в уникальных и в текущих данных
	ВычПромежДанныеWL = Строка(КлиентСсылка.УникальныйИдентификатор());
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","а00100020", "LO","PatientID", ВычПромежДанныеWL));

	// Patient Name, имя пациента имеет три значения 
	ВычПромежДанныеWL = СтрШаблон("%1 %2 %3",DICOMОбщий.ПрямаяТранслитерация(ДопСерверныеФункции.ПолучитьРеквизит(КлиентСсылка,"Фамилия")),
						DICOMОбщий.ПрямаяТранслитерация(ДопСерверныеФункции.ПолучитьРеквизит(КлиентСсылка,"Имя")),
						DICOMОбщий.ПрямаяТранслитерация(ДопСерверныеФункции.ПолучитьРеквизит(КлиентСсылка,"Отчество")));	
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","а00100010", "PN","PatientName", ВычПромежДанныеWL));	
			
	// 	Patient's Birth Date, Дата рождения пациента 
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","а00100030", "DA","PatientBirthDate", Формат(ДопСерверныеФункции.ПолучитьРеквизит(КлиентСсылка,"ДатаРождения"), "ДФ=yyyyMMdd")));
		     
	// 	Patient's Sex, Пол пациента, может быть неизвестным
	ВычПромежДанныеWL = ДопСерверныеФункции.ПолучитьРеквизит(КлиентСсылка,"Пол");
	Если ВычПромежДанныеWL = ПредопределенноеЗначение("Перечисление.ПолФизическихЛиц.Женский") Тогда
		ВычПромежДанныеWL = "F";
	ИначеЕсли ВычПромежДанныеWL = ПредопределенноеЗначение("Перечисление.ПолФизическихЛиц.Мужской") Тогда
		ВычПромежДанныеWL = "M";
	Иначе
		ВычПромежДанныеWL = "Undefine";
	КонецЕсли;	
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","а00100040", "CS","PatientSex", ВычПромежДанныеWL));	
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","а00100021", "LO","IssuerOfPatientID", "1C"));
	
	// Данные по сотрудникам
	// Requesting Physician и Scheduled Performing Physicians Name 
	// Врач, назначенный на исплнение заявки  и Врач, назначенный на исплнение заявки
	ВычПромежДанныеWL = DICOMОбщий.ПрямаяТранслитерация(ДопСерверныеФункции.ПолучитьРеквизит(СотрудникСсылка,"Наименование"));
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","б00321032", "PN","RequestingPhysician", ВычПромежДанныеWL));
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения,ТегРодитель","б00400006", "PN","ScheduledPerformingPhysiciansName", ВычПромежДанныеWL,"р00400100"));

	
	// Заносим в таблицу неизменные статичные данные
	// ScheduledProcedureStepID формируется на стороне dcm4chee, но указывать придётся, поэтому при получении обратно ответа необходимо запоминать его значение
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения,ТегРодитель","в00400009", "SH","ScheduledProcedureStepID", "0","р00400100"));
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","в00401003", "SH","RequestedProcedurePriority", "ROUTINE"));
	
	// Input Readiness State. Введённое состояние готовности. Обычно должно быть READY
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","н00404041","CS","InputReadinessState","READY"));	
	
	// (0074,1000) - дефолтное значение WL, без него будут ошибки отказа
    ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения,ТегРодитель","н00400020","CS","ProcedureStepState", "SCHEDULED","р00400100"));	     
	
	//(0074,1200)  Scheduled Procedure Step Priority. Введённое состояние приоритета. Может быть LOW, MEDIUM, HIGH
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","н00741200", "CS","RequestedProcedurePriority", "MEDIUM"));
	//(0074,1204) Procedure Step Label. Обозначение процедуры, используется для понимания врачей. К примеру, "CT Scan - Chest" или "Blood Culture Analysis - Urgent"
	// В базе такая инфа не хранится, подумать над её значимостью. Для ворклистов она необходима
	ДанныеDICOM.Добавить(Новый Структура("Тег,Визуализация,Описание,ЗначЗаполнения","н00741204","LO","ProcedureStepLabel","No info"));	
	
	//Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ДанныеDICOM);  
    Возврат ДанныеDICOM;

КонецФункции

// ОбщегоНазначения.ТаблицаЗначенийВМассив(ДанныеDICOM)
Функция СформироватьМассивДинамическойСериализации(Знач ТаблицаСтатичных, СсылкаНоменклатура, СсылкаОборудование) Экспорт
	
	Возврат DICOMОбщий.СформироватьМассивСериализации(ТаблицаСтатичных,СсылкаНоменклатура, СсылкаОборудование, ТекущаяДата());	

КонецФункции

#КонецОбласти

#Область ФормированиеЗапроса

Функция ПолучитьСоединениеDICOM(НестандартныйХост = Неопределено,НестандартныйПорт = Неопределено, Таймаут = 5) Экспорт		
	
	Если ТипЗнч(НестандартныйПорт) = Тип("Строка")
		И Не ПустаяСтрока(НестандартныйПорт)
	Тогда 
		Порт = Число(НестандартныйПорт);	
	Иначе
		Порт = ?(НестандартныйПорт = Неопределено,8080,НестандартныйПорт);
	КонецЕсли;
	
	Если НестандартныйХост = Неопределено
		Или ПустаяСтрока(НестандартныйХост)
	Тогда 
		Хост = "localhost";	
	Иначе
		Хост = НестандартныйХост;
	КонецЕсли;
	
	Попытка
		Возврат Новый HTTPСоединение(Хост,Порт,,,,Таймаут);				
	Исключение
		СообщениеОбОшибке = СтрШаблон(НСтр("ru='Не удалось установить соединение. Причина: %1'"), ОписаниеОшибки());
		ОбщегоНазначенияКлиентСервер.СообщитьОбОшибке(СообщениеОбОшибке);
	КонецПопытки;
	
КонецФункции


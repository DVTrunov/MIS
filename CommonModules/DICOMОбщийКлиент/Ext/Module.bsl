
#Область ОбщаяОбработкаКоманд

// Общая функция, которая по имени команды определяет что делать, настройкиDICOM передаются в команду
//
// Параметры:
//  ИмяКоманды			 - Строка	 - Значение, которое определяет какая функция будет вызвана
//  ВидЗапроса			 - Строка	 - Значение вида запроса, такие как GET, PUT, DELETE и т.д.
//  НастройкиСистемыDICOM - Список значений	 -  Список, сформированный на основе регистра сведений DICOMНастройкаСистемы,
//		В т.ч. и расшифровка AETL - Его порт и хост, в формате PACS - AETLМенеджера, AETLМенеджераХост, AETLМенеджераПорт
//  КлассификацияСервера - Строка	 - Значение "AETLЛистов" или "AETLМенеджера", используется для спецификации названия расшифровки AETL
//	ПараметрыКоманды	 - Структура - Структура заранее известных параметров, которые нужны для работы команды (смотреть по команде)
// 
// Возвращаемое значение:
//   HTTPОтвет, Неопределено - Ответ, сформированный на основе ИмяКоманды или Неопределено, если что-то пошло не так
//
Функция ПолучитьОтветПоЗапросуDICOM(ИмяКоманды, ВидЗапроса = "GET", НастройкиСистемыDICOM, КлассификацияСервера = "AETLЛистов", ПараметрыКоманды, Каталог = Неопределено) Экспорт
		
	// Получение соединения едино для всех
	AETLХоста = НастройкиСистемыDICOM.НайтиПоЗначению((КлассификацияСервера + "Хост")).Представление;
	AETLПорта = НастройкиСистемыDICOM.НайтиПоЗначению((КлассификацияСервера + "Порт")).Представление;
	
	Соединение = ПолучитьСоединениеDICOM(AETLХоста,AETLПорта); 
	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	

	Запрос = ПередатьСоответствующемуМодулюКомандуЗапроса(НастройкиСистемыDICOM.НайтиПоЗначению("ИмяСистемыDICOM").Представление,
															ИмяКоманды, НастройкиСистемыDICOM, ПараметрыКоманды);
	Если Запрос = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	РезультатОтветHTTP = ПолучитьHTTPОтветDICOM(Соединение, Запрос, ВидЗапроса,, Каталог);

	Возврат РезультатОтветHTTP;
КонецФункции

#Область РаспределениеМеждуРазнымиСистемами

Функция ПередатьСоответствующемуМодулюКомандуЗапроса(ИмяСистемыDICOM, ИмяКоманды, НастройкиDICOM, ПараметрыКоманды)

	Если ИмяСистемыDICOM = "DCM4CHEE" Тогда	
		Возврат DCM4CHEEКлиент.ОбработатьКомандуПоИмени(ИмяКоманды, НастройкиDICOM, ПараметрыКоманды);		
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции
	
Функция ПолучитьКоррекныйПоОСфайл(ИмяФайла) Экспорт

	// Получаем корректно расширение по ОС
	Если ОбщегоНазначения.ЭтоWindowsСервер() Тогда
		РасширениеИсполняемогоФайла = "bat";
	ИначеЕсли ОбщегоНазначения.ЭтоLinuxСервер() Тогда
		РасширениеИсполняемогоФайла = "sh";
	Иначе
		// Пока нет других вариантов, используем bat расширение. 
		РасширениеИсполняемогоФайла = "bat";
	КонецЕсли;
	
    Возврат СтрШаблон("%1.%2",ИмяФайла,РасширениеИсполняемогоФайла);
КонецФункции


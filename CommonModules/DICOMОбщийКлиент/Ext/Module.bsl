// Функция - Сформировать адрес нового файла. Получаем после расшифровки MIME файла или одно файла
//ДЛЯ РАЗРАБОТКИ - изменить на уникальное расположение? Или изменять это в Директиве?
//
// Параметры:
//  ТипДанных	 - Строка	 - Строка-обозначение типа данных. Находится в Content-Type, либо изначально задавалась пользователем
//  Директива	 - Строка	 - Строка-директива папки, где будут храниться файлы
//  Количество	 - Число	 - ПорядковоеЧислоФайла
// 
// Возвращаемое значение:
// Строка  -  Адрес расположения файла
//
Функция СформироватьПолноеИмяФайла(ТипДанных, Директива, Количество)

	СтрокаРасположенияФайла = СтрШаблон("%1_%2",Директива,Строка(Количество));
	СтрокаРасшифровкиТипа = СтрРазделить(ТипДанных,"/")[1];
	
	//задаём расширения для некоторых расшифровок, остальные варианты имеют готовое правильное расширение
	Если СтрокаРасшифровкиТипа = "dicom" Тогда
		СтрокаРасшифровкиТипа = "dcm";	
	ИначеЕсли СтрокаРасшифровкиТипа = "dicom-rle" Тогда
		//СтрокаРасшифровкиТипа = "drle";
		СтрокаРасшифровкиТипа = "rle";
	ИначеЕсли СтрокаРасшифровкиТипа = "octet-stream" Тогда
		СтрокаРасшифровкиТипа = "bin";
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(СтрокаРасположенияФайла,СтрокаРасшифровкиТипа,".");	
	
	Возврат СтрокаРасположенияФайла;
	
КонецФункции

// Читаем сообщение MIME и записываем в файл (ТОЛЬКО для файлов .dcm) Экспорт
Функция ПрочитатьСообщениеMIMEФайлDCM(Разделитель,ТипДанных,СтрокаАдресаФайла,ТелоДвоичныеДанные) Экспорт
	
	МассивИменВременныхФайлов = Новый Массив;
	
	// Создаём массив возможных маркеров-буферов
	Маркеры = Новый Массив();
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель + Символы.ПС));	
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель + Символы.ВК));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель + Символы.ВК + Символы.ПС));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель + "--"));
		
	// Текст ответа в двоичных данных, от 1 до n блоков одного заранее известного типа
	// Перейдём сразу к началу первой части. 
	ЧтениеДанныхОтвета = Новый ЧтениеДанных(ТелоДвоичныеДанные);       
	ЧтениеДанныхОтвета.ПропуститьДо(Маркеры);

	БуферДвоичныхДанных = ЧтениеДанныхОтвета.ПрочитатьВБуферДвоичныхДанных();
	РазделенныеБуферыДанных = БуферДвоичныхДанных.Разделить(Маркеры);
		
	СчетчикФайлов = 1;
	Для каждого БлокДанныхБуфер Из РазделенныеБуферыДанных Цикл
		
		Если БлокДанныхБуфер.Размер = 0 Тогда		
			Продолжить;	
		КонецЕсли;
		
		ИмяФайла = СформироватьПолноеИмяФайла(ТипДанных,СтрокаАдресаФайла,СчетчикФайлов);
		МассивИменВременныхФайлов.Добавить(ИмяФайла);
		
		// Переведём в UTF-16, дабы 00 не стало 20. Кто удалит - самолично найду дикого опоссума и кину виновнику в лицо 
		ПотокБлокаДанных = Новый ПотокВПамяти(БлокДанныхБуфер);
		ЧтениеБлокаДанных = Новый ЧтениеДанных(ПотокБлокаДанных,"UTF-16",,,"");	
		ДвоичныеДанныеНаЗапись = ЧтениеБлокаДанных.Прочитать().ПолучитьДвоичныеДанные();	
		ЧетноеКоличествоБайтов = (ДвоичныеДанныеНаЗапись.Размер()%2 = 0);
		МассивРазделенныхДвоичныхДанных = РазделитьДвоичныеДанные(ДвоичныеДанныеНаЗапись,?(ЧетноеКоличествоБайтов,2,1));
		
		// Убираем заведомо известные данные. В dcm эти байты формируют добавочный заголовок к файлу. Работает только
		// с файлами dcm, они всегда одинаково формируются. Сильно оптимизирует время выполнения кода.
		ИндексМассива = 0;
		Для ИндексМассива = 1 По ?(ЧетноеКоличествоБайтов,70,140) Цикл
			МассивРазделенныхДвоичныхДанных.Удалить(0);	
		КонецЦикла; 
		
		// Убираем заголовок неопределённой длинны (он оканчивается 0D0A, после которого идут 0000)
		Для ИндексМассива = 0 По МассивРазделенныхДвоичныхДанных.Количество() - 1 Цикл
			Если МассивРазделенныхДвоичныхДанных[0] = Base64Значение(?(ЧетноеКоличествоБайтов,"AAA=","AA==")) Тогда			
				// Мы дошли до конца заголовка - подготовим данные на следующую проверку и уходим
				ИндексМассива = МассивРазделенныхДвоичныхДанных.Количество() - 1;
				Прервать;	
			Иначе                               
				МассивРазделенныхДвоичныхДанных.Удалить(0);
			КонецЕсли;	
		КонецЦикла;
				                     
		// Убираем приписываемый в процессе считывания 0D0A в самом конце, если он был добавлен
		Если ЧетноеКоличествоБайтов Тогда	
			Если МассивРазделенныхДвоичныхДанных[ИндексМассива] = Base64Значение("DQo=") Тогда		
				МассивРазделенныхДвоичныхДанных.Удалить(ИндексМассива); 
			КонецЕсли;		
		Иначе			
			Если МассивРазделенныхДвоичныхДанных[ИндексМассива] = Base64Значение("Cg==") Тогда		
				МассивРазделенныхДвоичныхДанных.Удалить(ИндексМассива); 
				ИндексМассива = МассивРазделенныхДвоичныхДанных.Количество() - 1;
			КонецЕсли;
			Если МассивРазделенныхДвоичныхДанных[ИндексМассива] = Base64Значение("DQ==") Тогда		
				МассивРазделенныхДвоичныхДанных.Удалить(ИндексМассива); 
			КонецЕсли;
		КонецЕсли;
				
		ДвоичныеДанныеНаЗапись = СоединитьДвоичныеДанные(МассивРазделенныхДвоичныхДанных);	
		ДвоичныеДанныеНаЗапись.Записать(ИмяФайла);
	
		ЧтениеБлокаДанных.Закрыть();
		ПотокБлокаДанных.Закрыть();
		СчетчикФайлов = СчетчикФайлов + 1;		
	КонецЦикла;
	
	ЧтениеДанныхОтвета.Закрыть();
	Возврат МассивИменВременныхФайлов;
	
КонецФункции

// Читаем сообщение MIME и записываем в файл (для любых вариантов рендеров)
Функция ПрочитатьСообщениеMIMEУниверсальное(Разделитель,ТипДанных,СтрокаАдресаФайла,ТелоПотоковыеДанные) Экспорт
	
	МассивИменВременныхФайлов = Новый Массив;
	
	// Создаём массив возможных маркеров разделения блоков
	Маркеры = Новый Массив();
	Маркеры.Добавить("--" + Разделитель);
	Маркеры.Добавить("--" + Разделитель + Символы.ПС);
	Маркеры.Добавить("--" + Разделитель + Символы.ВК);
	Маркеры.Добавить("--" + Разделитель + Символы.ВК + Символы.ПС);
	Маркеры.Добавить("--" + Разделитель + "--");	
	
	// Текст ответа в двоичных данных, от 1 до n блоков одного заранее известного типа
	// Перейдём сразу к началу первой части. 
	ЧтениеДанныхОтвета = Новый ЧтениеДанных(ТелоПотоковыеДанные,,,"","");       
	ЧтениеДанныхОтвета.ПропуститьДо(Маркеры);
	
	СчетчикФайлов = 1;
	// Прочитать в цикле все части тела сообщения.	
	Пока Истина Цикл
				
		БлокДанных = ЧтениеДанныхОтвета.ПрочитатьДо(Маркеры);
		Если Не БлокДанных.МаркерНайден Тогда
			// Неправильно сформированное сообщение или конец
			Прервать;
		КонецЕсли;
		
		ИмяФайла = СформироватьПолноеИмяФайла(ТипДанных,СтрокаАдресаФайла,СчетчикФайлов);
		МассивИменВременныхФайлов.Добавить(ИмяФайла);
		ЧтениеБлокаДанных = Новый ЧтениеДанных(БлокДанных.ОткрытьПотокДляЧтения(),,,"","");		
		
		// Убираем заголовок
		Пока Истина Цикл
			Строка = ЧтениеБлокаДанных.ПрочитатьСтроку();			
			Если Строка = "" Тогда	
				Прервать;
			КонецЕсли;			
		КонецЦикла;		                             

		// Переведём в UTF-16, дабы 00 не стало 20. Кто удалит - самолично найду дикого опоссума и кину виновнику в лицо 
		ЧтениеОбрезанногоБлока = Новый ЧтениеДанных(ЧтениеБлокаДанных.Прочитать().ОткрытьПотокДляЧтения(),"UTF-16",,"","");
		ДвоичныеДанныеНаЗапись = ЧтениеОбрезанногоБлока.Прочитать().ПолучитьДвоичныеДанные();		
		
		МассивРазделённый = РазделитьДвоичныеДанные(ДвоичныеДанныеНаЗапись,2);
		МассивРазделённый.Удалить(МассивРазделённый.Количество() - 1);
		ДвоичныеДанныеНаЗапись = СоединитьДвоичныеДанные(МассивРазделённый);	
		ДвоичныеДанныеНаЗапись.Записать(ИмяФайла);
		
		ЧтениеБлокаДанных.Закрыть();
		СчетчикФайлов = СчетчикФайлов + 1;		
	КонецЦикла;
	
	ЧтениеДанныхОтвета.Закрыть(); 
	Возврат МассивИменВременныхФайлов;
	
КонецФункции

#КонецОбласти
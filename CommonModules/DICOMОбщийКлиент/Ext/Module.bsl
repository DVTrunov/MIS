#Область ОбработкаОтветаЗапроса

// Функция - Получить HTTPОтвет DCM4CHEE, если соединение не было получено выводится ошибка
//
// Параметры:
//  Соединение			 - HTTPСоединение	 -  Готовое соединение по которому отправляет запрос
//  Запрос				 - HTTPЗапрос	 -   Готовый HTTP запрос который должен быть отправлен
//  ВидОтправкиЗапроса	 - Строка	 - Вид отправки запроса, ЗАГЛАВНЫМИ БУКВАМИ. К примеру, GET для получения данных, смотреть документацию API
//  СообщатьОбОшибке	 - Булево	 - Должно ли выводится предупреждение пользователю
//  ДирективаСохранения	 - Строка	 - Имя Выходного Файла (полное), куда идёт запись. Файл должен быть указан с расширением!
//  
// Возвращаемое значение: HTTPОтвет в случае успеха, Неопределено в случае ошибки. ВАЖНО проверить сначала на Неопределено
//
Функция ПолучитьHTTPОтветDICOM(Соединение, Запрос, ВидОтправкиЗапроса = "GET", СообщатьОбОшибке = Истина, ДирективаСохранения = Неопределено) Экспорт
	
	// При попытке получить ответHTTP при лежачем сервере или отсутствия интернета будет выдано исключение
	Попытка
		// Есть разные виды запросов: get, put, post, delete и т.д.
		Если (ВидОтправкиЗапроса = "GET") Тогда
			
			Если ДирективаСохранения <> Неопределено Тогда
				Ответ = Соединение.Получить(Запрос,ДирективаСохранения);
			Иначе
				Ответ = Соединение.Получить(Запрос);
			КонецЕсли;
			
		ИначеЕсли (ВидОтправкиЗапроса = "POST") Тогда
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
			
		ИначеЕсли (ВидОтправкиЗапроса = "PUT") Тогда
			Ответ = Соединение.Записать(Запрос);
			
		ИначеЕсли (ВидОтправкиЗапроса = "DELETE") Тогда
			Ответ = Соединение.Удалить(Запрос);
			
		ИначеЕсли (ВидОтправкиЗапроса = "PATCH") Тогда
			Ответ = Соединение.Изменить(Запрос);	
		КонецЕсли;	
	Исключение
		Если СообщатьОбОшибке Тогда
			СообщениеОбОшибке = СтрШаблон(НСтр("ru='Не удалось установить соединение. Причина: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияКлиентСервер.СообщитьОбОшибке(СообщениеОбОшибке);
		КонецЕсли;
		
		Ответ = Неопределено;	
	КонецПопытки;
	
	Возврат Ответ;			
КонецФункции

// Функция - КодВозвратаУспех, определяет попадает ли код ответаHTTP в диапазон правильных
//
// Параметры:
//  КодСостояния - HTTPОтвет.КодСостояния - Код состояния ответа на  запрос
// 
// Возвращаемое значение: Код в границе с 200 до 299 является выполнением запроса без ошибки 
//
Функция КодВозвратаУспех(КодСостояния,КонкретныйКод = Неопределено) Экспорт
	
	Если КонкретныйКод = Неопределено Тогда		
		Возврат (КодСостояния >= 200 И КодСостояния <=299);	
	Иначе			
		Возврат КодСостояния = КонкретныйКод;				
	КонецЕсли;
	
КонецФункции

// Возвращает значение, полученное из тела http-ответа, представленного в виде JSON-текста.
//
// Параметры:
//  Ответ - HTTPОтвет - ответ сервера, из которого нужно получить возвращаемое значение.
//
// Возвращаемое значение:
//  Произвольный - значение тела ответа после десериализации.
Функция ПрочитатьJSONОбъектаHTTP(ОбъектHTTP, ПрочитатьВСоответствие = Ложь) Экспорт
	
	ТекстJSON = ОбъектHTTP.ПолучитьТелоКакСтроку();
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	
	Попытка
		Возврат ПрочитатьJSON(Чтение, ПрочитатьВСоответствие);
	Исключение
		// Ошибка чтения JSON.
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Функция получения задаваемых значений раздилителей в искомом соответствии заголовков из HTTPОтвета
//
// Параметры:
//  ЗаголовкиHTTPОтвета  - Соответствие - Соответствие из заголовков HTTPОтвета
//  СтрокаИскомыхТипов  - Строка - Строка всех искомых тегов, перечисленных через запятую без лишних пробелов. Прим: "boundary,type"
//  КлючСоответствияПоиска  - Строка - Значение ключа соответствия, в чьих данных будет проводится поиск  
//  ПроводитьАтомарно  - Булево - Возвращать данные только если все заданные типы были найдены 
// Возвращаемое значение:
//   Структура   - с искомыми свойствами, либо Неопределено
//
Функция ПолучитьТипИРазделительОтвета(ЗаголовкиHTTPОтвета, СтрокаИскомыхТипов, КлючСоответствияПоиска = "Content-Type", ПроводитьАтомарно = Истина) Экспорт
	
	//multipart/related;start="<a718a98b-98a6-4838-bcf1-56bf6df49cb1@resteasy-multipart>";transfer-syntax=1.2.840.10008.1.2.1;type="application/dicom"; boundary=05243897-df37-4014-88bd-81f6b133dc30
	ТипСодержимого = ЗаголовкиHTTPОтвета.Получить(КлючСоответствияПоиска);
	
	Свойства = СтрРазделить(ТипСодержимого, ";", Ложь);
	ИскомыеЗначения = СтрРазделить(СтрокаИскомыхТипов,",",Ложь);
	
	СтруктураРазделителей = Новый Структура();
	
	Для Каждого Свойство Из Свойства Цикл
		
		Части = СтрРазделить(Свойство, "=", Ложь);		
		ИмяСвойства = СокрЛП(Части[0]);
		Если ИскомыеЗначения.Найти(ИмяСвойства) = Неопределено Тогда			
			Продолжить;	
		КонецЕсли; 
		
		ЗначениеТега = СтрЗаменить(СокрЛП(Части[1]),"""","");
		СтруктураРазделителей.Вставить(ИмяСвойства,ЗначениеТега);
		
	КонецЦикла;
	
	Если ПроводитьАтомарно И 
		СтруктураРазделителей.Количество() <>  ИскомыеЗначения.Количество()
		Тогда
	
		Возврат Неопределено;
	ИначеЕсли СтруктураРазделителей.Количество() = 0 Тогда
		
		Возврат Неопределено;	
	Иначе
	   	Возврат СтруктураРазделителей;
	КонецЕсли;
	
КонецФункции

#КонецОбласти  


			Запись.Комментарий = "Состав блокированных позиций:";
			
			Пока ВыборкаИсследований.Следующий() Цикл
				
				Запись.Комментарий = Запись.Комментарий + Символы.ПС + "Артикул: " + 
					ВыборкаИсследований.Артикул + ", Наименование: " + ВыборкаИсследований.НоменклатураПредставление;
				
			КонецЦикла;
			Запись.Записать();
			
		КонецЦикла;
		
	КонецЦикла;
	
	Пока СтруктураНастроек.ИспользоватьДополнительнуюПриостановкуИсследований И ВыборкаПрочихИсследованийПоФилиаламБезЦен.Следующий() Цикл
		
		ВыборкаНаборов = ВыборкаПрочихИсследованийПоФилиаламБезЦен.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаНаборов.Следующий() Цикл
			

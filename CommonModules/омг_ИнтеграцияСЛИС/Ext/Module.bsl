Функция ЕстьКлючОбновления(СтруктураНастроек, Ключ)
	
	Возврат Не СтруктураНастроек.ОбновляемыеДанные.Ключи.Найти(Ключ) = Неопределено;
	
КонецФункции

Процедура ЗагрузкаСправочниковИсследований(СтруктураНастроек, СтруктураДанных)

	ОбновлениеАнализовЛИС = ЕстьКлючОбновления(СтруктураНастроек, Перечисления.омг_КлючиОбновленийСправочников.ОбновлениеАнализовЛИС);
	ОбновлениеЦенЛИС = ЕстьКлючОбновления(СтруктураНастроек, Перечисления.омг_КлючиОбновленийСправочников.ОбновлениеЦенЛИС);
	ОбновлениеАрхивированных = ЕстьКлючОбновления(СтруктураНастроек, Перечисления.омг_КлючиОбновленийСправочников.ОбновлениеАрхивированных);
	
	Если ОбновлениеАнализовЛИС Тогда
		
		ОбновлениеДопРеквизитовИсследований(СтруктураНастроек, СтруктураДанных);
	
		ТаблицаИсследований = ЗагрузкаДанныхПоИсследованиям(СтруктураНастроек, СтруктураДанных);
	
		ЗагрузкаДанныхПоНаборамИсследований(СтруктураНастроек, СтруктураДанных, ТаблицаИсследований);
		
	КонецЕсли;
	
	Если ОбновлениеАнализовЛИС Или ОбновлениеАрхивированных Тогда
		
		АрхивироватьЗаблокированныеИсследованияЛИС(СтруктураНастроек, СтруктураДанных);
		
	КонецЕсли;

	Если ОбновлениеАнализовЛИС Тогда

		ОбновлениеДополнительнойИнформацииПоИсследованиям(СтруктураДанных);
		
	КонецЕсли;

	Если ОбновлениеЦенЛИС Тогда
		ЗагрузкаПрайслиста(СтруктураНастроек, СтруктураДанных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузкаСправочниковБиоматериалов(СтруктураНастроек, СтруктураДанныхОбщие)
	
	Если Не ЕстьКлючОбновления(СтруктураНастроек, Перечисления.омг_КлючиОбновленийСправочников.ОбновлениеБиоматериаловЛИС) Тогда
		Возврат;
	КонецЕсли;
	
	Событие = "Интеграция с ЛИС: Обновление биоматериалов и контейнеров";
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Начало обновления биоматериалов и контейнеров";
	Сообщение.Сообщить();
	                                      
	ТаблицаАнализов = Новый ТаблицаЗначений;
	ТаблицаАнализов.Колонки.Добавить("Код", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаАнализов.Колонки.Добавить("КодБиоматериала", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаАнализов.Колонки.Добавить("КодКонтейнера", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаАнализов.Колонки.Добавить("Филиал", Новый ОписаниеТипов("СправочникСсылка.Филиалы"));
	ТаблицаАнализов.Колонки.Добавить("ПоУмолчанию", Новый ОписаниеТипов("Булево"));
	ТаблицаАнализов.Колонки.Добавить("ЕстьКолонкаПоУмолчанию", Новый ОписаниеТипов("Булево"));
	ТаблицаАнализов.Колонки.Добавить("КоличествоКонтейнеров", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	ТаблицаАнализов.Колонки.Добавить("Преаналитика", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	
	ТаблицаБиоматериалов = Новый ТаблицаЗначений;
	ТаблицаБиоматериалов.Колонки.Добавить("Наименование", ОбщегоНазначения.ОписаниеТипаСтрока(150));

				Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, ТекстОшибки, ОписаниеОшибки());
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			Возврат;
		КонецПопытки;
		HTTPЗапрос = Новый HTTPЗапрос("query-dictionaries?format=json");
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("date", ЗаписатьДатуJSON(ТекущаяДата(), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
		HTTPЗапрос.УстановитьТелоИзСтроки(ЗаписатьЗначениеJSON(СтруктураЗапроса));
		
		Попытка
			Ответ = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
		Исключение
			ТекстОшибки = "Не удалось выполнить запрос к серверу.";
			
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка,
				Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, ТекстОшибки, ОписаниеОшибки());
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			Продолжить;
		КонецПопытки;
		
		Попытка
			СтруктураДанных = ПрочитатьЗначениеJSON(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
			
			Если Не СтруктураДанных.Свойство("delayedTargets") Тогда
				ВызватьИсключение("Не найдено поле ""delayedTargets""");
			КонецЕсли;
			
		Исключение
			ТекстОшибки = "Филиал: """ + ВыборкаФилиалов.ФилиалПредставление + """. Не удалось прочитать данные из ЛИС, невеный формат.
			|Поле ""delayedTargets"" не найдено.";
			Если СтруктураДанных.Свойство("error") Тогда
				ТекстОшибки = ТекстОшибки + "
				|Ошибка ЛИС: " + СтруктураДанных.error;
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка,

	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаТекущихБлокировок = ПакетРезультатов.Получить(9).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаТекущихБлокировокПрочие = ПакетРезультатов.Получить(10).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТекущихБлокировок.Следующий() Цикл
		
		Запись = РегистрыСведений.омг_ПриостановленныеИсследованияЛИС.СоздатьМенеджерЗаписи();
		Запись.Филиал = ВыборкаТекущихБлокировок.Филиал;
		Запись.Номенклатура = ВыборкаТекущихБлокировок.Номенклатура;
		Запись.Удалить();
		
	КонецЦикла;
	
	Пока СтруктураНастроек.ИспользоватьДополнительнуюПриостановкуИсследований И ВыборкаТекущихБлокировокПрочие.Следующий() Цикл
		
		Запись = РегистрыСведений.омг_ПрочиеПриостановленныеИсследования.СоздатьМенеджерЗаписи();
		Запись.Филиал = ВыборкаТекущихБлокировокПрочие.Филиал;
		Запись.Номенклатура = ВыборкаТекущихБлокировокПрочие.Номенклатура;
		Запись.Удалить();
		
	КонецЦикла;
	
	ВыборкаИсследованийПоФилиалам = ПакетРезультатов.Получить(11).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПрочихИсследованийПоФилиалам = ПакетРезультатов.Получить(12).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПрочихИсследованийПоФилиаламБезЦен = ПакетРезультатов.Получить(13).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
	
	Пока ВыборкаИсследованийПоФилиалам.Следующий() Цикл
		
		
		ВыборкаИсследований = ВыборкаИсследованийПоФилиалам.Выбрать();
		
		Пока ВыборкаИсследований.Следующий() Цикл
			
			Запись = РегистрыСведений.омг_ПриостановленныеИсследованияЛИС.СоздатьМенеджерЗаписи();
			Запись.Номенклатура = ВыборкаИсследований.Номенклатура;
			Запись.Филиал = ВыборкаИсследований.Филиал;
			Запись.ДатаБлокировки = ВыборкаИсследований.Дата;
			Запись.Причина = ВыборкаИсследований.Причина;
			Запись.Комментарий = ВыборкаИсследований.Комментарий;

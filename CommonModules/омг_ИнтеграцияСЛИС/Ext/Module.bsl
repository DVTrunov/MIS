
#Область ОбщиеПроцедурыФункции

Функция ПолучитьДополнительныеНастройкиПоФилиалам(Соответствием = Ложь) Экспорт
	
	ДанныеФилиаловИзБД = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("омг_ДополнительныеНастройкиИнтеграцииЛИС", "ДанныеФилиалов");
	
	Если Соответствием Тогда
		ДанныеФилиалов = Новый Соответствие;
	Иначе
		ДанныеФилиалов = Новый ТаблицаЗначений;
		//ДанныеФилиала.Колонки.Добавить("Адрес", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		//ДанныеФилиала.Колонки.Добавить("Порт", ОбщегоНазначения.ОписаниеТипаЧисло(10));
		//ДанныеФилиала.Колонки.Добавить("Пользователь", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		//ДанныеФилиала.Колонки.Добавить("Пароль", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		//ДанныеФилиала.Колонки.Добавить("ИмяПриемника", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		//ДанныеФилиала.Колонки.Добавить("Используется", Новый ОписаниеТипов("Булево"));
		//ДанныеФилиала.Колонки.Добавить("Филиал", Новый ОписаниеТипов("СправочникСсылка.Филиалы"));
	КонецЕсли;
	
	Если Не ДанныеФилиаловИзБД = Неопределено Тогда
		СоответвиеФилиалов = ДанныеФилиаловИзБД.Получить();
		Для Каждого ПозицияСоответствия Из СоответвиеФилиалов Цикл
			Если Соответствием Тогда
				ДанныеФилиалов.Вставить(ПозицияСоответствия.Ключ, ПозицияСоответствия.Значение);
			Иначе
				Если ДанныеФилиалов.Колонки.Количество() = 0 Тогда
					Для Каждого ЭлементСтруктуры Из ПозицияСоответствия.Значение Цикл
						МассивТипов = Новый Массив;
						МассивТипов.Добавить(ТипЗнч(ЭлементСтруктуры.Значение));
						ДанныеФилиалов.Колонки.Добавить(ЭлементСтруктуры.Ключ, Новый ОписаниеТипов(МассивТипов,,, Новый КвалификаторыЧисла(10), Новый КвалификаторыСтроки(100)));
					КонецЦикла;
				КонецЕсли;
				СтрокаДанных = ДанныеФилиалов.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаДанных, ПозицияСоответствия.Значение);
				СтрокаДанных.Филиал = ПозицияСоответствия.Ключ;
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
	Возврат ДанныеФилиалов;
	
КонецФункции

Функция ПолучитьОсновныеНастройки() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС";
	РезультатЗапроса = Запрос.Выполнить();
	СтруктураНастроек = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		СтруктураНастроек.Вставить(Колонка.Имя);
	КонецЦикла;
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтруктураНастроек[Колонка.Имя] = Выборка[Колонка.Имя];
		КонецЦикла;
	КонецЕсли;
	
	ДанныеПароля = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("омг_ИнтеграцияСЛИС", "Пароль");
	СтруктураНастроек.Вставить("Пароль", ?(ДанныеПароля = Неопределено, "", ДанныеПароля.Получить()));

	ДанныеПароля = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("омг_ИнтеграцияСЛИС", "ПарольFTP");
	СтруктураНастроек.Вставить("ПарольFTP", ?(ДанныеПароля = Неопределено, "", ДанныеПароля.Получить()));

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураНастроек;
	
КонецФункции

Функция ЭтоОтменаЗаявки(СтруктураДанных)
	
	Если СтруктураДанных.Свойство("warnings") И СтруктураДанных.warnings.Количество() > 0 Тогда
		
		Для Каждого Ошибка Из СтруктураДанных.warnings Цикл
			
			Если Не СтрНайти(НРег(Ошибка.text), "направление удалено") = 0 Тогда
				Возврат Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; 
	
	Возврат Ложь;
	
КонецФункции

Процедура ОбработатьWarnings(СтруктураДанных, СтруктураОтветаПоЗаявке, ВыборкаДокументов, Событие, МассивОшибок = Неопределено)
	
	Если СтруктураДанных.Свойство("warnings") И СтруктураДанных.warnings.Количество() > 0 Тогда
		
		ОшибкиИзЛИС = "";
		
		Если МассивОшибок = Неопределено Тогда
			МассивОшибок = Новый Массив;
		КонецЕсли;
		
		СтруктураОтветаПоЗаявке.Вставить("Ошибки", МассивОшибок);
		
		Для Каждого Ошибка Из СтруктураДанных.warnings Цикл
			
			Если Не СтрНайти(НРег(Ошибка.text), "направление удалено") = 0 Тогда
				МассивОшибок.Очистить();
				Возврат;
			КонецЕсли;
			
			ОшибкиИзЛИС = ОшибкиИзЛИС + "
			|" + (СтруктураДанных.warnings.Найти(Ошибка) + 1) + ": " + Ошибка.text;
			
			МассивОшибок.Добавить(Ошибка.text);
		КонецЦикла;
		
		ТекстОшибки = "Заявка """ + ВыборкаДокументов.Ссылка + """ отправлена в ЛИС, но есть ошибки со стороны заполнения.";

		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, ТекстОшибки, ОшибкиИзЛИС);
			

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки + "
		|" + ОшибкиИзЛИС;
		Сообщение.Сообщить();
		
	КонецЕсли;

	
КонецПроцедуры

Функция ПолучитьСписокПропускаемыхОшибок() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	омг_ПропускаемыеОшибкиОбновленияСтатуса.ТекстОшибки КАК ТекстОшибки
	|ИЗ
	|	РегистрСведений.омг_ПропускаемыеОшибкиОбновленияСтатуса КАК омг_ПропускаемыеОшибкиОбновленияСтатуса";
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивОшибок = Новый Массив;
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат МассивОшибок;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МассивОшибок.Добавить(Выборка.ТекстОшибки);
	КонецЦикла;
	
	Возврат МассивОшибок;
	
КонецФункции

#Область СкопироватьРекурсивно

Функция СкопироватьСтруктуру(СтруктураИсточник, ФиксироватьДанные) Экспорт 
	
	СтруктураРезультат = Новый Структура;
	
	Для Каждого КлючИЗначение Из СтруктураИсточник Цикл
		СтруктураРезультат.Вставить(КлючИЗначение.Ключ, 
			СкопироватьРекурсивно(КлючИЗначение.Значение, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина 
		Или ФиксироватьДанные = Неопределено
		И ТипЗнч(СтруктураИсточник) = Тип("ФиксированнаяСтруктура") Тогда 
		Возврат Новый ФиксированнаяСтруктура(СтруктураРезультат);
	КонецЕсли;
	
	Возврат СтруктураРезультат;
	
КонецФункции

Функция СкопироватьСоответствие(СоответствиеИсточник, ФиксироватьДанные) Экспорт 
	
	СоответствиеРезультат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СоответствиеИсточник Цикл
		СоответствиеРезультат.Вставить(КлючИЗначение.Ключ, 
			СкопироватьРекурсивно(КлючИЗначение.Значение, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина 
		Или ФиксироватьДанные = Неопределено
		И ТипЗнч(СоответствиеИсточник) = Тип("ФиксированноеСоответствие") Тогда 
		Возврат Новый ФиксированноеСоответствие(СоответствиеРезультат);
	КонецЕсли;
	
	Возврат СоответствиеРезультат;
	
КонецФункции

Функция СкопироватьМассив(МассивИсточник, ФиксироватьДанные) Экспорт 
	
	МассивРезультат = Новый Массив;
	
	Для Каждого Элемент Из МассивИсточник Цикл
		МассивРезультат.Добавить(СкопироватьРекурсивно(Элемент, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина 
		Или ФиксироватьДанные = Неопределено
		И ТипЗнч(МассивИсточник) = Тип("ФиксированныйМассив") Тогда 
		Возврат Новый ФиксированныйМассив(МассивРезультат);
	КонецЕсли;
	
	Возврат МассивРезультат;
	
КонецФункции

Функция СкопироватьСписокЗначений(СписокИсточник, ФиксироватьДанные) Экспорт
	
	СписокРезультат = Новый СписокЗначений;
	
	Для Каждого ЭлементСписка Из СписокИсточник Цикл
		СписокРезультат.Добавить(
			СкопироватьРекурсивно(ЭлементСписка.Значение, ФиксироватьДанные), 
			ЭлементСписка.Представление, 
			ЭлементСписка.Пометка, 
			ЭлементСписка.Картинка);
	КонецЦикла;
	
	Возврат СписокРезультат;
	
КонецФункции

#КонецОбласти

// Создает полную копию структуры, соответствия, массива, списка или таблицы значений, рекурсивно,
// с учетом типов дочерних элементов. При этом содержимое значений объектных типов
// (СправочникОбъект, ДокументОбъект и т.п.) не копируются, а возвращаются ссылки на исходный объект.
//
// См. ОбщегоНазначения.СкопироватьРекурсивно
//
// Параметры:
//  Источник - Структура, ФиксированнаяСтруктура,
//             Соответствие, ФиксированноеСоответствие,
//             Массив, ФиксированныйМассив,
//             СписокЗначений - объект, который необходимо скопировать.
//  ФиксироватьДанные - Булево, Неопределено - если Истина - фиксировать,
//                          если Ложь - снять фиксацию, если Неопределено - не изменять.
//
// Возвращаемое значение:
//  Структура - , ФиксированнаяСтруктура,
//  Соответствие, ФиксированноеСоответствие,
//  Массив, ФиксированныйМассив,
//  СписокЗначений - копия объекта, переданного в параметре Источник.
//
Функция СкопироватьРекурсивно(Источник, ФиксироватьДанные = Неопределено) Экспорт
	
	Перем Приемник;
	
	ТипИсточника = ТипЗнч(Источник);
	
	Если ТипИсточника = Тип("Структура")
		Или ТипИсточника = Тип("ФиксированнаяСтруктура") Тогда
		Приемник = СкопироватьСтруктуру(Источник, ФиксироватьДанные);
	ИначеЕсли ТипИсточника = Тип("Соответствие")
		Или ТипИсточника = Тип("ФиксированноеСоответствие") Тогда
		Приемник = СкопироватьСоответствие(Источник, ФиксироватьДанные);
	ИначеЕсли ТипИсточника = Тип("Массив")
		Или ТипИсточника = Тип("ФиксированныйМассив") Тогда
		Приемник = СкопироватьМассив(Источник, ФиксироватьДанные);
	ИначеЕсли ТипИсточника = Тип("СписокЗначений") Тогда
		Приемник = СкопироватьСписокЗначений(Источник, ФиксироватьДанные);
	Иначе
		Приемник = Источник;
	КонецЕсли;
	
	Возврат Приемник;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеСправочников

Процедура ОбновлениеДополнительнойИнформацииПоИсследованиям(СтруктураДанных)
	
	ЗаписьЖурналаРегистрации("ЛИС: Начало обновления дополнительных сведений", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль);
		
	Если Не СтруктураДанных.Свойство("prices") Тогда 
		ЗаписьЖурналаРегистрации("ЛИС: Обновление дополнительных сведений", 
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, 
			"Обновление сведений не прошло из за отсутствия поля ""prices"".");
		Возврат;
	КонецЕсли;
	
	ТаблицаСведений = Новый ТаблицаЗначений;
	ТаблицаСведений.Колонки.Добавить("Артикул", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаСведений.Колонки.Добавить("КоличествоДнейМинимум", ОбщегоНазначения.ОписаниеТипаСтрока(2));
	ТаблицаСведений.Колонки.Добавить("КоличествоДнейМаксимум", ОбщегоНазначения.ОписаниеТипаСтрока(2));
	
	Для Каждого ДанныеПрайса Из СтруктураДанных.prices Цикл
		Если Не ДанныеПрайса.Свойство("minDuration") 
			Или Не ДанныеПрайса.Свойство("maxDuration") Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = ТаблицаСведений.Добавить();
		СтрокаТаблицы.Артикул = ДанныеПрайса.serviceCode;
		СтрокаТаблицы.КоличествоДнейМинимум = ДанныеПрайса.minDuration;
		СтрокаТаблицы.КоличествоДнейМаксимум = ДанныеПрайса.maxDuration;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСведений", ТаблицаСведений);
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ГруппаНоменклатуры
	               |ИЗ
	               |	РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаСведений.Артикул КАК Артикул,
	               |	ТаблицаСведений.КоличествоДнейМинимум КАК КоличествоДнейМинимум,
	               |	ТаблицаСведений.КоличествоДнейМаксимум КАК КоличествоДнейМаксимум
	               |ПОМЕСТИТЬ ВТ_ТаблицаСведений
	               |ИЗ
	               |	&ТаблицаСведений КАК ТаблицаСведений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаСведений.Артикул КАК Артикул,
	               |	ВТ_ТаблицаСведений.КоличествоДнейМинимум + ""-"" + ВТ_ТаблицаСведений.КоличествоДнейМаксимум + "" дней"" КАК КоличествоДней,
	               |	Номенклатура.Ссылка КАК Номенклатура
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаСведений КАК ВТ_ТаблицаСведений
	               |		ПО (Номенклатура.Артикул = ВТ_ТаблицаСведений.Артикул
	               |				И НЕ Номенклатура.омг_СрокИсполненияЛаб = ВТ_ТаблицаСведений.КоличествоДнейМинимум + ""-"" + ВТ_ТаблицаСведений.КоличествоДнейМаксимум + "" дней"")
	               |ГДЕ
	               |	Номенклатура.Ссылка В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				ВТ_ГруппаНоменклатуры.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |			ИЗ
	               |				ВТ_ГруппаНоменклатуры КАК ВТ_ГруппаНоменклатуры)";
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ЗаписьЖурналаРегистрации("ЛИС: Окончание обновления дополнительных сведений", 
			УровеньЖурналаРегистрации.Информация,
			Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, "Всего обновлено ""0"" позиций.");
		Возврат;
	КонецЕсли;
	
	ВыборкаНоменклатуры = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаНоменклатуры.Следующий() Цикл
		
		НоменклатураОбъект = ВыборкаНоменклатуры.Номенклатура.ПолучитьОбъект();
		НоменклатураОбъект.омг_СрокИсполненияЛаб = ВыборкаНоменклатуры.КоличествоДней;
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
		НоменклатураОбъект.Записать();
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("ЛИС: Окончание обновления дополнительных сведений", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, "Всего обновлено """ + ВыборкаНоменклатуры.Количество() + """ позиций.");

КонецПроцедуры

Функция ЗагрузкаДанныхПоИсследованиям(СтруктураНастроек, СтруктураДанных)
	
	Событие = "Интеграция с ЛИС: Обновление номенклатуры";
	
	ЗаписьЖурналаРегистрации("ЛИС: Начало загрузки данных по исследованиям", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль);

	ТаблицаИсследований = Новый ТаблицаЗначений;
	ТаблицаИсследований.Колонки.Добавить("Наименование", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТаблицаИсследований.Колонки.Добавить("НаименованиеПолное", ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТаблицаИсследований.Колонки.Добавить("Артикул", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаИсследований.Колонки.Добавить("АртикулГруппы", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаИсследований.Колонки.Добавить("ДатаОбновления", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаИсследований.Колонки.Добавить("АртикулНабора", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаИсследований.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	ТаблицаИсследований.Колонки.Добавить("ЕстьДопПоля", Новый ОписаниеТипов("Булево"));
	
	ТаблицаДопПолейИсследований = Новый ТаблицаЗначений;
	ТаблицаДопПолейИсследований.Колонки.Добавить("Код", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаДопПолейИсследований.Колонки.Добавить("Обязательное", Новый ОписаниеТипов("Булево"));
	ТаблицаДопПолейИсследований.Колонки.Добавить("Артикул", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	
	Для Каждого СтруктураИсследования Из СтруктураДанных.analyses Цикл
		Если СтруктураИсследования.Свойство("removed") И СтруктураИсследования.removed Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = ТаблицаИсследований.Добавить();
		СтрокаТаблицы.Наименование = СтруктураИсследования.name;
		СтрокаТаблицы.НаименованиеПолное = СтруктураИсследования.name;
		СтрокаТаблицы.Артикул = СтруктураИсследования.code;
		СтрокаТаблицы.АртикулГруппы = СтруктураИсследования.analysisGroupCode;
		СтрокаТаблицы.ДатаОбновления = ПрочитатьДатуJSON(СтруктураИсследования.updateTime, ФорматДатыJSON.ISO);
		Если СтруктураИсследования.Свойство("fields") Тогда 
			Для Каждого СтруктураДопПоля Из СтруктураИсследования.fields Цикл
				СтрокаТаблицыДопПолей = ТаблицаДопПолейИсследований.Добавить();
				СтрокаТаблицыДопПолей.Код = СтруктураДопПоля.fieldCode;
				СтрокаТаблицыДопПолей.Обязательное = СтруктураДопПоля.mandatory;
				СтрокаТаблицыДопПолей.Артикул = СтруктураИсследования.code;
			КонецЦикла;
			СтрокаТаблицы.ЕстьДопПоля = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтруктураИсследования Из СтруктураДанных.analysisGroups Цикл
		Если СтруктураИсследования.Свойство("removed") И СтруктураИсследования.removed Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = ТаблицаИсследований.Добавить();
		СтрокаТаблицы.Наименование = СтруктураИсследования.name;
		СтрокаТаблицы.Артикул = СтруктураИсследования.code;
		СтрокаТаблицы.ДатаОбновления = ПрочитатьДатуJSON(СтруктураИсследования.updateTime, ФорматДатыJSON.ISO);
		СтрокаТаблицы.ЭтоГруппа = Истина;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ТаблицаИсследований", ТаблицаИсследований);
	Запрос.УстановитьПараметр("ТаблицаДопПолейИсследований", ТаблицаДопПолейИсследований);
	Запрос.УстановитьПараметр("ТолькоИзмененияНоменклатурыИЦен", СтруктураНастроек.ТолькоИзмененияНоменклатуры);
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ГруппаНоменклатурыЛИС
	               |ИЗ
	               |	РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаДопПолейИсследований.Код КАК Код,
	               |	ТаблицаДопПолейИсследований.Артикул КАК Артикул,
	               |	ТаблицаДопПолейИсследований.Обязательное КАК Обязательное
	               |ПОМЕСТИТЬ ВТ_ТаблицаДопПолейИсследований
	               |ИЗ
	               |	&ТаблицаДопПолейИсследований КАК ТаблицаДопПолейИсследований
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаИсследований.Наименование КАК Наименование,
	               |	ТаблицаИсследований.НаименованиеПолное КАК НаименованиеПолное,
	               |	ТаблицаИсследований.Артикул КАК Артикул,
	               |	ТаблицаИсследований.ДатаОбновления КАК ДатаОбновления,
	               |	ТаблицаИсследований.ЭтоГруппа КАК ЭтоГруппа,
	               |	ТаблицаИсследований.АртикулГруппы КАК АртикулГруппы,
	               |	ТаблицаИсследований.ЕстьДопПоля КАК ЕстьДопПоля
	               |ПОМЕСТИТЬ ВТ_ТаблицаИсследований
	               |ИЗ
	               |	&ТаблицаИсследований КАК ТаблицаИсследований
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаИсследований.Наименование КАК Наименование,
	               |	ВТ_ТаблицаИсследований.НаименованиеПолное КАК НаименованиеПолное,
	               |	ВТ_ТаблицаИсследований.Артикул КАК Артикул,
	               |	ВТ_ТаблицаИсследований.ДатаОбновления КАК ДатаОбновления,
	               |	ЕСТЬNULL(Номенклатура.Ссылка, НЕОПРЕДЕЛЕНО) КАК Номенклатура,
	               |	ВТ_ТаблицаИсследований.ЭтоГруппа КАК ЭтоГруппа,
	               |	ВТ_ТаблицаИсследований.АртикулГруппы КАК АртикулГруппы,
	               |	ВТ_ТаблицаИсследований.ЕстьДопПоля КАК ЕстьДопПоля
	               |ПОМЕСТИТЬ ВТ_Номенклатура
	               |ИЗ
	               |	ВТ_ТаблицаИсследований КАК ВТ_ТаблицаИсследований
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО ВТ_ТаблицаИсследований.Артикул = Номенклатура.Артикул
	               |			И ВТ_ТаблицаИсследований.ЭтоГруппа = Номенклатура.ЭтоГруппа
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ТолькоИзмененияНоменклатурыИЦен
	               |				ТОГДА Номенклатура.Ссылка ЕСТЬ NULL
	               |						ИЛИ Номенклатура.омг_ДатаПоследнегоОбновленияЛИС < ВТ_ТаблицаИсследований.ДатаОбновления
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Номенклатура.Наименование КАК Наименование,
	               |	ВТ_Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	               |	ВТ_Номенклатура.Артикул КАК Артикул,
	               |	ВТ_Номенклатура.ДатаОбновления КАК ДатаОбновления,
	               |	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	               |	ВТ_Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	               |	ВТ_Номенклатура.АртикулГруппы КАК АртикулГруппы,
	               |	ЕСТЬNULL(ВТ_НоменклатураГруппы.Номенклатура, НЕОПРЕДЕЛЕНО) КАК НоменклатураГруппа,
	               |	ВТ_Номенклатура.ЕстьДопПоля КАК ЕстьДопПоля,
	               |	ВТ_Номенклатура.Номенклатура В ИЕРАРХИИ
	               |		(ВЫБРАТЬ
	               |			ВТ_ГруппаНоменклатурыЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |		ИЗ
	               |			ВТ_ГруппаНоменклатурыЛИС КАК ВТ_ГруппаНоменклатурыЛИС) КАК НоменклатураВГруппеЛИС
	               |ИЗ
	               |	ВТ_Номенклатура КАК ВТ_Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_НоменклатураГруппы
	               |		ПО ВТ_Номенклатура.АртикулГруппы = ВТ_НоменклатураГруппы.Артикул
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭтоГруппа УБЫВ";
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	ИсследованияРезультатЗапроса = ПакетРезультатов.Получить(4);

	Если Не ИсследованияРезультатЗапроса.Пустой() Тогда
		
		НовыеГруппыНоменклатуры = Новый Соответствие;
		
		ВыборкаИсследований = ИсследованияРезультатЗапроса.Выбрать();
		Пока ВыборкаИсследований.Следующий() Цикл
			Если Не ВыборкаИсследований.Номенклатура = Неопределено Тогда 
				НоменклатураОбъект = ВыборкаИсследований.Номенклатура.ПолучитьОбъект();
				Если ВыборкаИсследований.НоменклатураВГруппеЛИС Тогда
					НоменклатураОбъект.Наименование = ВыборкаИсследований.Наименование;
					НоменклатураОбъект.НаименованиеПолное = ВыборкаИсследований.НаименованиеПолное;
				КонецЕсли;
			Иначе
				Если ВыборкаИсследований.ЭтоГруппа Тогда
					НоменклатураОбъект = Справочники.Номенклатура.СоздатьГруппу();
				Иначе
					НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
					НоменклатураОбъект.КатегорияВыработки = СтруктураНастроек.СпециализацияПоУмолчанию;
					НоменклатураОбъект.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга;
				КонецЕсли;
				НоменклатураОбъект.Наименование = ВыборкаИсследований.Наименование;
				НоменклатураОбъект.Артикул = ВыборкаИсследований.Артикул;
			КонецЕсли;
			
			Если ВыборкаИсследований.ЭтоГруппа И НоменклатураОбъект.Родитель.Пустая() Тогда
				НоменклатураОбъект.Родитель = СтруктураНастроек.ГруппаНоменклатуры;
				Если НоменклатураОбъект.ЭтоНовый() Тогда
					СсылкаГруппы = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор);
					НоменклатураОбъект.УстановитьСсылкуНового(СсылкаГруппы);
					НовыеГруппыНоменклатуры.Вставить(ВыборкаИсследований.Артикул, СсылкаГруппы);
				КонецЕсли;
			КонецЕсли;
			Если Не ВыборкаИсследований.ЭтоГруппа И НоменклатураОбъект.Родитель.Пустая() Тогда
				НоменклатураОбъект.НаименованиеПолное = ВыборкаИсследований.НаименованиеПолное;
				Если ВыборкаИсследований.НоменклатураГруппа = Неопределено Тогда
					НоменклатураОбъект.Родитель = НовыеГруппыНоменклатуры.Получить(ВыборкаИсследований.АртикулГруппы);
					Если НоменклатураОбъект.Родитель.Пустая() Тогда
						НоменклатураОбъект.Родитель = СтруктураНастроек.ГруппаНоменклатуры;
					КонецЕсли;
				Иначе
					НоменклатураОбъект.Родитель = ВыборкаИсследований.НоменклатураГруппа;
				КонецЕсли;
			КонецЕсли;
			НоменклатураОбъект.омг_ДатаПоследнегоОбновленияЛИС = ВыборкаИсследований.ДатаОбновления;
			
			НоменклатураОбъект.Записать();
						
		КонецЦикла;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ТаблицаДопПолейИсследований.Код КАК Код,
	               |	ВТ_ТаблицаДопПолейИсследований.Артикул КАК Артикул,
	               |	ВТ_ТаблицаДопПолейИсследований.Обязательное КАК Обязательное,
	               |	СвойстваОбъектов.Ссылка КАК Свойство,
	               |	Номенклатура.Ссылка КАК Объект
	               |ИЗ
	               |	ВТ_ТаблицаДопПолейИсследований КАК ВТ_ТаблицаДопПолейИсследований
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.омг_ДополнительныеПоляЛИС КАК СвойстваОбъектов
	               |		ПО ВТ_ТаблицаДопПолейИсследований.Код = СвойстваОбъектов.КодЛИС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО ВТ_ТаблицаДопПолейИсследований.Артикул = Номенклатура.Артикул
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НазначенияСвойствОбъектов.Объект КАК Объект,
	               |	НазначенияСвойствОбъектов.Свойство КАК Свойство
	               |ИЗ
	               |	ВТ_Номенклатура КАК ВТ_Номенклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.омг_СоответствиеДопПолейНоменклатуре КАК НазначенияСвойствОбъектов
	               |		ПО ВТ_Номенклатура.Номенклатура = НазначенияСвойствОбъектов.Объект
	               |ГДЕ
	               |	НЕ НазначенияСвойствОбъектов.Свойство.КодЛИС = """"";
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();

  	ДопПоляПоРезультатЗапроса = ПакетРезультатов.Получить(0);
	СуществующиеНазначенияДопПолейРезультатЗапроса = ПакетРезультатов.Получить(1);
	
	Если Не СуществующиеНазначенияДопПолейРезультатЗапроса.Пустой() Тогда
		
		ВыборкаСуществующиеНазначенияДопПолей = СуществующиеНазначенияДопПолейРезультатЗапроса.Выбрать();
		Пока ВыборкаСуществующиеНазначенияДопПолей.Следующий() Цикл
			Запись = РегистрыСведений.омг_СоответствиеДопПолейНоменклатуре.СоздатьМенеджерЗаписи();
			Запись.Объект = ВыборкаСуществующиеНазначенияДопПолей.Объект;
			Запись.Свойство = ВыборкаСуществующиеНазначенияДопПолей.Свойство;
			Запись.Удалить();
		КонецЦикла;
		
	КонецЕсли;
	
	ВыборкаДопПолей = ДопПоляПоРезультатЗапроса.Выбрать();
	
	Пока ВыборкаДопПолей.Следующий() Цикл
		Запись = РегистрыСведений.омг_СоответствиеДопПолейНоменклатуре.СоздатьМенеджерЗаписи();
		Запись.Объект = ВыборкаДопПолей.Объект;
		Запись.Свойство = ВыборкаДопПолей.Свойство;
		Запись.Обязательное = ВыборкаДопПолей.Обязательное;
		Запись.Записать();
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("ЛИС: Окончание загрузки данных по исследованиям", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль);

	Возврат ТаблицаИсследований;
	
КонецФункции  

Функция ЗагрузкаДанныхПоНаборамИсследований(СтруктураНастроек, СтруктураДанных, ТаблицаИсследований)
	
	Событие = "Интеграция с ЛИС: Обновление номенклатуры";
	
	ЗаписьЖурналаРегистрации("ЛИС: Начало загрузки данных по наборам исследованиям", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль);

	ТаблицаНаборов = Новый ТаблицаЗначений;
	ТаблицаНаборов.Колонки.Добавить("Наименование", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТаблицаНаборов.Колонки.Добавить("НаименованиеПолное", ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТаблицаНаборов.Колонки.Добавить("Артикул", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаНаборов.Колонки.Добавить("АртикулГруппы", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаНаборов.Колонки.Добавить("ДатаОбновления", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаНаборов.Колонки.Добавить("ЕстьДопПоля", Новый ОписаниеТипов("Булево"));
	
	ТаблицаИсследований.Очистить();
	
	ТаблицаДопПолейИсследований = Новый ТаблицаЗначений;
	ТаблицаДопПолейИсследований.Колонки.Добавить("Код", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаДопПолейИсследований.Колонки.Добавить("Обязательное", Новый ОписаниеТипов("Булево"));
	ТаблицаДопПолейИсследований.Колонки.Добавить("Артикул", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	
	ОтборПоАртикулуНабора = ""; // Для целей отладки
	
	Для Каждого СтруктураНабора Из СтруктураДанных.panels Цикл
		Если СтруктураНабора.Свойство("removed") И СтруктураНабора.removed Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ОтборПоАртикулуНабора = "" И Не СтруктураНабора.code = ОтборПоАртикулуНабора Тогда
			Продолжить;
		КонецЕсли;
		СтрокаНабора = ТаблицаНаборов.Добавить();
		СтрокаНабора.Наименование = СтруктураНабора.name;
		СтрокаНабора.НаименованиеПолное = СтруктураНабора.name;
		СтрокаНабора.Артикул = СтруктураНабора.code;
		СтрокаНабора.АртикулГруппы = СтруктураНабора.analysisGroupCode;
		СтрокаНабора.ДатаОбновления = ПрочитатьДатуJSON(СтруктураНабора.updateTime, ФорматДатыJSON.ISO);
		Для Каждого СтруктураИсследования Из СтруктураНабора.panelAnalyses Цикл
			СтрокаИсследования = ТаблицаИсследований.Добавить();
			СтрокаИсследования.Артикул = СтруктураИсследования.analysisCode;
			СтрокаИсследования.АртикулНабора = СтрокаНабора.Артикул;
		КонецЦикла;
		Если СтруктураНабора.Свойство("fields") Тогда 
			Для Каждого СтруктураДопПоля Из СтруктураНабора.fields Цикл
				СтрокаТаблицыДопПолей = ТаблицаДопПолейИсследований.Добавить();
				СтрокаТаблицыДопПолей.Код = СтруктураДопПоля.fieldCode;
				СтрокаТаблицыДопПолей.Обязательное = СтруктураДопПоля.mandatory;
				СтрокаТаблицыДопПолей.Артикул = СтруктураНабора.code;
			КонецЦикла;
			СтрокаНабора.ЕстьДопПоля = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаНаборов", ТаблицаНаборов);
	Запрос.УстановитьПараметр("ТаблицаДопПолейИсследований", ТаблицаДопПолейИсследований);
	Запрос.УстановитьПараметр("ТаблицаИсследованийНаборов", ТаблицаИсследований);
	Запрос.УстановитьПараметр("ТолькоИзмененияНоменклатурыИЦен", СтруктураНастроек.ТолькоИзмененияНаборов);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаДопПолейИсследований.Код КАК Код,
	               |	ТаблицаДопПолейИсследований.Артикул КАК Артикул,
	               |	ТаблицаДопПолейИсследований.Обязательное КАК Обязательное
	               |ПОМЕСТИТЬ ВТ_ТаблицаДопПолейИсследований
	               |ИЗ
	               |	&ТаблицаДопПолейИсследований КАК ТаблицаДопПолейИсследований
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаНаборов.Наименование КАК Наименование,
	               |	ВТ_ТаблицаНаборов.НаименованиеПолное КАК НаименованиеПолное,
	               |	ВТ_ТаблицаНаборов.Артикул КАК Артикул,
	               |	ВТ_ТаблицаНаборов.АртикулГруппы КАК АртикулГруппы,
	               |	ВТ_ТаблицаНаборов.ДатаОбновления КАК ДатаОбновления,
	               |	ВТ_ТаблицаНаборов.ЕстьДопПоля КАК ЕстьДопПоля
	               |ПОМЕСТИТЬ ВТ_ТаблицаНаборов
	               |ИЗ
	               |	&ТаблицаНаборов КАК ВТ_ТаблицаНаборов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаИсследованийНаборов.Артикул КАК Артикул,
	               |	ТаблицаИсследованийНаборов.АртикулНабора КАК АртикулНабора
	               |ПОМЕСТИТЬ ВТ_ТаблицаИсследованийНаборов
	               |ИЗ
	               |	&ТаблицаИсследованийНаборов КАК ТаблицаИсследованийНаборов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаНаборов.Наименование КАК Наименование,
	               |	ВТ_ТаблицаНаборов.НаименованиеПолное КАК НаименованиеПолное,
	               |	ВТ_ТаблицаНаборов.Артикул КАК АртикулНабора,
	               |	ВТ_ТаблицаНаборов.ДатаОбновления КАК ДатаОбновления,
	               |	ЕСТЬNULL(НоменклатураНаборов.Ссылка, НЕОПРЕДЕЛЕНО) КАК НоменклатураНабора,
	               |	ВТ_ТаблицаИсследованийНаборов.Артикул КАК АртикулИсследования,
	               |	НоменклатураИсследований.Ссылка КАК НоменклатураИсследования,
	               |	НоменклатураГруппы.Ссылка КАК НоменклатураГруппы,
	               |	ВТ_ТаблицаНаборов.ЕстьДопПоля КАК ЕстьДопПоля
	               |ПОМЕСТИТЬ ВТ_НаборыИсследований
	               |ИЗ
	               |	ВТ_ТаблицаИсследованийНаборов КАК ВТ_ТаблицаИсследованийНаборов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаНаборов КАК ВТ_ТаблицаНаборов
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураНаборов
	               |			ПО ВТ_ТаблицаНаборов.Артикул = НоменклатураНаборов.Артикул
	               |				И (НЕ НоменклатураНаборов.ЭтоГруппа)
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураГруппы
	               |			ПО ВТ_ТаблицаНаборов.АртикулГруппы = НоменклатураГруппы.Артикул
	               |		ПО ВТ_ТаблицаИсследованийНаборов.АртикулНабора = ВТ_ТаблицаНаборов.Артикул
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураИсследований
	               |		ПО ВТ_ТаблицаИсследованийНаборов.Артикул = НоменклатураИсследований.Артикул
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ТолькоИзмененияНоменклатурыИЦен
	               |				ТОГДА НоменклатураНаборов.Ссылка ЕСТЬ NULL
	               |						ИЛИ НоменклатураНаборов.омг_ДатаПоследнегоОбновленияЛИС < ВТ_ТаблицаНаборов.ДатаОбновления
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НаборыИсследований.Наименование КАК Наименование,
	               |	ВТ_НаборыИсследований.НаименованиеПолное КАК НаименованиеПолное,
	               |	ВТ_НаборыИсследований.АртикулНабора КАК АртикулНабора,
	               |	ВТ_НаборыИсследований.ДатаОбновления КАК ДатаОбновления,
	               |	МАКСИМУМ(ВТ_НаборыИсследований.НоменклатураНабора) КАК НоменклатураНабора,
	               |	ВТ_НаборыИсследований.АртикулИсследования КАК АртикулИсследования,
	               |	МАКСИМУМ(ВТ_НаборыИсследований.НоменклатураИсследования) КАК НоменклатураИсследования,
	               |	МАКСИМУМ(ВТ_НаборыИсследований.НоменклатураГруппы) КАК НоменклатураГруппы,
	               |	ВТ_НаборыИсследований.ЕстьДопПоля КАК ЕстьДопПоля
	               |ИЗ
	               |	ВТ_НаборыИсследований КАК ВТ_НаборыИсследований
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_НаборыИсследований.АртикулНабора,
	               |	ВТ_НаборыИсследований.АртикулИсследования,
	               |	ВТ_НаборыИсследований.НаименованиеПолное,
	               |	ВТ_НаборыИсследований.Наименование,
	               |	ВТ_НаборыИсследований.ЕстьДопПоля,
	               |	ВТ_НаборыИсследований.ДатаОбновления
	               |ИТОГИ
	               |	МАКСИМУМ(Наименование),
	               |	МАКСИМУМ(НаименованиеПолное),
	               |	МАКСИМУМ(ДатаОбновления),
	               |	МАКСИМУМ(НоменклатураНабора),
	               |	МАКСИМУМ(НоменклатураГруппы),
	               |	МАКСИМУМ(ЕстьДопПоля)
	               |ПО
	               |	АртикулНабора
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаДопПолейИсследований.Код КАК Код,
	               |	ВТ_ТаблицаДопПолейИсследований.Артикул КАК Артикул,
	               |	ВТ_ТаблицаДопПолейИсследований.Обязательное КАК Обязательное,
	               |	СвойстваОбъектов.Ссылка КАК Свойство
	               |ИЗ
	               |	ВТ_ТаблицаДопПолейИсследований КАК ВТ_ТаблицаДопПолейИсследований
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.омг_ДополнительныеПоляЛИС КАК СвойстваОбъектов
	               |		ПО ВТ_ТаблицаДопПолейИсследований.Код = СвойстваОбъектов.КодЛИС
	               |ИТОГИ ПО
	               |	Артикул
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	НазначенияСвойствОбъектов.Объект КАК Объект,
	               |	НазначенияСвойствОбъектов.Свойство КАК Свойство
	               |ИЗ
	               |	ВТ_НаборыИсследований КАК ВТ_НаборыИсследований
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.омг_СоответствиеДопПолейНоменклатуре КАК НазначенияСвойствОбъектов
	               |		ПО ВТ_НаборыИсследований.НоменклатураНабора = НазначенияСвойствОбъектов.Объект
	               |ГДЕ
	               |	НЕ НазначенияСвойствОбъектов.Свойство.КодЛИС = """"";
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	НаборыРезультат = ПакетРезультатов.Получить(4);
	ДопПоляПоВладельцуРезультатЗапроса = ПакетРезультатов.Получить(5);
	СуществующиеНазначенияДопПолейРезультатЗапроса = ПакетРезультатов.Получить(6);
	
	Если Не СуществующиеНазначенияДопПолейРезультатЗапроса.Пустой() Тогда
		
		ВыборкаСуществующиеНазначенияДопПолей = СуществующиеНазначенияДопПолейРезультатЗапроса.Выбрать();
		Пока ВыборкаСуществующиеНазначенияДопПолей.Следующий() Цикл
			Запись = РегистрыСведений.омг_СоответствиеДопПолейНоменклатуре.СоздатьМенеджерЗаписи();
			Запись.Объект = ВыборкаСуществующиеНазначенияДопПолей.Объект;
			Запись.Свойство = ВыборкаСуществующиеНазначенияДопПолей.Свойство;
			Запись.Удалить();
		КонецЦикла;
		
	КонецЕсли;

	Если Не НаборыРезультат.Пустой() Тогда
		
		ВыборкаДопПолейПоВладельцу = ДопПоляПоВладельцуРезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		ВыборкаНаборов = НаборыРезультат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНаборов.Следующий() Цикл
			Если Не ВыборкаНаборов.НоменклатураНабора = Неопределено Тогда 
				НоменклатураОбъект = ВыборкаНаборов.НоменклатураНабора.ПолучитьОбъект();
				НоменклатураОбъект.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор;
			Иначе
				НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
				НоменклатураОбъект.КатегорияВыработки = СтруктураНастроек.СпециализацияПоУмолчанию;
				НоменклатураОбъект.Родитель = СтруктураНастроек.ГруппаНоменклатуры;
				НоменклатураОбъект.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор;
			КонецЕсли;
			
			НоменклатураОбъект.Артикул = ВыборкаНаборов.АртикулНабора;
			НоменклатураОбъект.Наименование = ВыборкаНаборов.Наименование;
			НоменклатураОбъект.НаименованиеПолное = ВыборкаНаборов.НаименованиеПолное;
			НоменклатураОбъект.омг_ДатаПоследнегоОбновленияЛИС = ВыборкаНаборов.ДатаОбновления;
			
			ВыборкаИсследований = ВыборкаНаборов.Выбрать();
			НоменклатураОбъект.КомплектующиеНоменклатуры.Очистить();
			Пока ВыборкаИсследований.Следующий() Цикл
				СтрокаНабора = НоменклатураОбъект.КомплектующиеНоменклатуры.Добавить();
				СтрокаНабора.Комплектующая = ВыборкаИсследований.НоменклатураИсследования;
				СтрокаНабора.Количество = 1;
			КонецЦикла;
			НоменклатураОбъект.Родитель = ВыборкаНаборов.НоменклатураГруппы;
			Если НоменклатураОбъект.Родитель.Пустая() Тогда 
				НоменклатураОбъект.Родитель = СтруктураНастроек.ГруппаНоменклатуры;
			КонецЕсли;
			НоменклатураОбъект.Записать();
			
			Если ВыборкаНаборов.ЕстьДопПоля Тогда
				ВыборкаДопПолейПоВладельцу.Сбросить();
				Если ВыборкаДопПолейПоВладельцу.НайтиСледующий(ВыборкаНаборов.АртикулНабора, "Артикул") Тогда
					ВыборкаДопПолей = ВыборкаДопПолейПоВладельцу.Выбрать();
					
					Пока ВыборкаДопПолей.Следующий() Цикл
						Запись = РегистрыСведений.омг_СоответствиеДопПолейНоменклатуре.СоздатьМенеджерЗаписи();
						Запись.Объект = ВыборкаНаборов.НоменклатураНабора;
						Запись.Свойство = ВыборкаДопПолей.Свойство;
						Запись.Обязательное = ВыборкаДопПолей.Обязательное;
						Запись.Записать();
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("ЛИС: Окончание загрузки данных по наборам исследованиям", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль);

	
КонецФункции

Процедура ОбработкаПозицийЗагрузкиПрайслиста(ЦеныЛИСРезультатЗапроса, ОсновнойПрейскурант)
	
	КоличествоСформированныхДокументов = 0;
	Если Не ЦеныЛИСРезультатЗапроса.Пустой() Тогда 
		
		ТекущиеЦеныПрейскурантов = Неопределено; 
		ВыборкаПоВидам = ЦеныЛИСРезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоВидам.Следующий() Цикл
			
			ВыборкаПоОрганизациям = ВыборкаПоВидам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПоОрганизациям.Следующий() Цикл
				
				ВыборкаПоФилиалам = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаПоФилиалам.Следующий() Цикл
					
					УстановкаЦенОбъект = Документы.УстановкаЦен.СоздатьДокумент();
					Если ВыборкаПоВидам.ДокументыПоВиду = "Набор" Тогда
						УстановкаЦенОбъект.ВидОперации = Перечисления.ВидыОперацийУстановкиЦен.омг_ЦеныНаборов;
					Иначе
						УстановкаЦенОбъект.ВидОперации = Перечисления.ВидыОперацийУстановкиЦен.ЦеныПрейскурантов;
						Если ТекущиеЦеныПрейскурантов = Неопределено Тогда
							ТекущиеЦеныПрейскурантов = УстановкаЦенОбъект;
						КонецЕсли;
					КонецЕсли;
					
					УстановкаЦенОбъект.омг_Организация = ВыборкаПоОрганизациям.Организация;
					УстановкаЦенОбъект.омг_Прейскуранты.Добавить().Прейскурант = ОсновнойПрейскурант;
					
					УстановкаЦенОбъект.омг_Филиалы.Добавить().Филиал = ВыборкаПоФилиалам.Филиал;
					ВыборкаЦен = ВыборкаПоФилиалам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаЦен.Следующий() Цикл
						СтрокаЦен = УстановкаЦенОбъект.Номенклатура.Добавить();
						СтрокаЦен.Номенклатура = ВыборкаЦен.Номенклатура;
						СтрокаЦен.омг_ИсходнаяЦена = ВыборкаЦен.Цена;
						СтрокаЦен.Цена = ВыборкаЦен.Цена;
						ИтоговаяЦенаНабора = 0;
						Если ВыборкаПоВидам.ДокументыПоВиду = "Набор" Тогда
							ВыборкаПоКомплектам = ВыборкаЦен.Выбрать();
							
							ОбщаяЦенаКомплектующих = 0;
							Пока ВыборкаПоКомплектам.Следующий() Цикл
								ЦенаКомплектующей = 1;
								Если ВыборкаПоКомплектам.ЦенаКомплектующей = 0 И Не ТекущиеЦеныПрейскурантов = Неопределено Тогда
									НайденнаяСтрока = ТекущиеЦеныПрейскурантов.Номенклатура.Найти(ВыборкаПоКомплектам.Комплектующая, "Номенклатура");
									Если Не НайденнаяСтрока = Неопределено Тогда
										ЦенаКомплектующей = НайденнаяСтрока.Цена;
									КонецЕсли;
								ИначеЕсли Не ВыборкаПоКомплектам.ЦенаКомплектующей = 0 Тогда
									ЦенаКомплектующей = ВыборкаПоКомплектам.ЦенаКомплектующей;    
								КонецЕсли;
								
								ОбщаяЦенаКомплектующих = ОбщаяЦенаКомплектующих + ЦенаКомплектующей;
							КонецЦикла;
							ВыборкаПоКомплектам.Сбросить();
							Пока ВыборкаПоКомплектам.Следующий() Цикл
								СтрокаКомплекта = УстановкаЦенОбъект.омг_НоменклатураНаборов.Добавить();
								СтрокаКомплекта.Набор = ВыборкаЦен.Номенклатура;
								СтрокаКомплекта.Номенклатура = ВыборкаПоКомплектам.Комплектующая;
								ЦенаКомплектующей = 1;
								Если ВыборкаПоКомплектам.ЦенаКомплектующей = 0 И Не ТекущиеЦеныПрейскурантов = Неопределено Тогда
									НайденнаяСтрока = ТекущиеЦеныПрейскурантов.Номенклатура.Найти(СтрокаКомплекта.Номенклатура, "Номенклатура");
									Если Не НайденнаяСтрока = Неопределено Тогда
										ЦенаКомплектующей = НайденнаяСтрока.Цена;
									КонецЕсли;
								ИначеЕсли Не ВыборкаПоКомплектам.ЦенаКомплектующей = 0 Тогда
									ЦенаКомплектующей = ВыборкаПоКомплектам.ЦенаКомплектующей;    
								КонецЕсли;
								СтрокаКомплекта.ЦенаОбщая = ЦенаКомплектующей;
								Если ЦенаКомплектующей > 0 Тогда
									СтрокаКомплекта.Коэффициент = ВыборкаЦен.Цена / ОбщаяЦенаКомплектующих;
									СтрокаКомплекта.ЦенаВНаборе = Окр(СтрокаКомплекта.Коэффициент * ЦенаКомплектующей);
									ИтоговаяЦенаНабора = ИтоговаяЦенаНабора + СтрокаКомплекта.ЦенаВНаборе;
								КонецЕсли;
								
							КонецЦикла;
							Если НЕ СтрокаЦен.Цена = ИтоговаяЦенаНабора Тогда
								СтрокаКомплекта.ЦенаВНаборе = СтрокаКомплекта.ЦенаВНаборе + (СтрокаЦен.Цена - ИтоговаяЦенаНабора);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
					УстановкаЦенОбъект.Дата = КонецДня(ТекущаяДата());
					Попытка
						УстановкаЦенОбъект.Комментарий = "#Цены загружены из ЛИС.(" + ТекущаяДата() + ")";
						УстановкаЦенОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Документ " + УстановкаЦенОбъект.Ссылка + " проведен";
						Сообщение.Сообщить();
						
					Исключение
						УстановкаЦенОбъект.Комментарий = "#Цены загружены из ЛИС.(" + ТекущаяДата() + ")";
						УстановкаЦенОбъект.Записать();

						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Документ " + УстановкаЦенОбъект.Ссылка + " записан.";
						Сообщение.Сообщить();

						ЗаписьЖурналаРегистрации("ЛИС: Ошибка записи установки цен", 
							УровеньЖурналаРегистрации.Ошибка,
							Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль,
							"Не удалось провести цены по филиалу " + ВыборкаПоФилиалам.ФилиалПредставление + ", документ записан без проведения.", 
							ОписаниеОшибки());
					КонецПопытки;
					
					КоличествоСформированныхДокументов = КоличествоСформированныхДокументов + 1;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("ЛИС: Окончание загрузки прайс листов", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, "Количество сформированных документов """ + КоличествоСформированныхДокументов + """");

	
КонецПроцедуры

Функция ПолучитьВыборкуФилиалов(Филиал = Неопределено)
	
	ДанныеФилиалов = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("омг_ДополнительныеНастройкиИнтеграцииЛИС", "ДанныеФилиалов");
	
	ДанныеПодключений = ПолучитьДополнительныеНастройкиПоФилиалам();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДанныеПодключений", ДанныеПодключений);
	Запрос.УстановитьПараметр("Филиал", Филиал);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеПодключений.Адрес КАК Адрес,
	               |	ДанныеПодключений.Порт КАК Порт,
	               |	ДанныеПодключений.Пользователь КАК Пользователь,
	               |	ДанныеПодключений.Пароль КАК Пароль,
	               |	ДанныеПодключений.Филиал КАК Филиал,
	               |	ДанныеПодключений.Используется КАК Используется
	               |ПОМЕСТИТЬ ВТ_ДанныеПодключений
	               |ИЗ
	               |	&ДанныеПодключений КАК ДанныеПодключений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Филиалы.Ссылка КАК Ссылка,
	               |	Филиалы.Организация КАК Организация,
	               |	ВТ_ДанныеПодключений.Адрес КАК Адрес,
	               |	ВТ_ДанныеПодключений.Порт КАК Порт,
	               |	ВТ_ДанныеПодключений.Пользователь КАК Пользователь,
	               |	ВТ_ДанныеПодключений.Пароль КАК Пароль
	               |ПОМЕСТИТЬ ВТ_Филиалы
	               |ИЗ
	               |	Справочник.Филиалы КАК Филиалы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеПодключений КАК ВТ_ДанныеПодключений
	               |		ПО Филиалы.Ссылка = ВТ_ДанныеПодключений.Филиал
	               |ГДЕ
	               |	НЕ ЕСТЬNULL(ВТ_ДанныеПодключений.Адрес, """") = """"
	               |	И ЕСТЬNULL(ВТ_ДанныеПодключений.Используется, ЛОЖЬ)
	               |	И ВЫБОР
	               |			КОГДА &Филиал = НЕОПРЕДЕЛЕНО
	               |					ИЛИ &Филиал = ЗНАЧЕНИЕ(Справочник.Филиалы.ПустаяСсылка)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ Филиалы.Ссылка = &Филиал
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Филиалы.Ссылка КАК Филиал,
	               |	ВТ_Филиалы.Организация КАК Организация,
	               |	ВТ_Филиалы.Адрес КАК Адрес,
	               |	ВТ_Филиалы.Порт КАК Порт,
	               |	ВТ_Филиалы.Пользователь КАК Пользователь,
	               |	ВТ_Филиалы.Пароль КАК Пароль,
	               |	ВТ_Филиалы.Ссылка.Представление КАК ФилиалПредставление
	               |ИЗ
	               |	ВТ_Филиалы КАК ВТ_Филиалы";
	ВыборкаФилиалов = Запрос.Выполнить().Выбрать();

	Возврат ВыборкаФилиалов;
	
КонецФункции

Процедура ЗагрузкаПрайслиста(СтруктураНастроек, СтруктураДанных)
	
	Событие = "Интеграция с ЛИС: Обновление цен номенклатуры";
	
	ЗаписьЖурналаРегистрации("ЛИС: Начало загрузки прайс листов", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль);

	Филиал = Неопределено;
	СтруктураНастроек.ОбновляемыеДанные.Свойство("Филиал", Филиал);
		
	ВыборкаФилиалов = ПолучитьВыборкуФилиалов(Филиал);
	
	ЦеныПоФилиалам = Новый ТаблицаЗначений;
	ЦеныПоФилиалам.Колонки.Добавить("Артикул", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ЦеныПоФилиалам.Колонки.Добавить("Цена", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ЦеныПоФилиалам.Колонки.Добавить("Филиал", Новый ОписаниеТипов("СправочникСсылка.Филиалы"));
	ЦеныПоФилиалам.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ЦеныПоФилиалам.Колонки.Добавить("Прейскурант", Новый ОписаниеТипов("СправочникСсылка.Прейскуранты"));
	
	ОтборПоНоменклатуре = ""; // Для целей отладки
	
	ОсновнойПрейскурант = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ОсновнойПрейскурант");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЦен", ЦеныПоФилиалам);
	Запрос.УстановитьПараметр("ОсновнойПрейскурант", ОсновнойПрейскурант);
	Запрос.УстановитьПараметр("ТолькоИзмененияНоменклатурыИЦен", СтруктураНастроек.ТолькоИзмененияЦен);
	Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДата()));

	#Область ТекстЗапроса
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ГруппаНоменклатуры
	               |ИЗ
	               |	РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаЦен.Филиал КАК Филиал,
	               |	ТаблицаЦен.Артикул КАК Артикул,
	               |	ТаблицаЦен.Цена КАК Цена,
	               |	ТаблицаЦен.Прейскурант КАК Прейскурант,
	               |	ТаблицаЦен.Организация КАК Организация
	               |ПОМЕСТИТЬ ВТ_ТаблицаЦен
	               |ИЗ
	               |	&ТаблицаЦен КАК ТаблицаЦен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Номенклатура.Ссылка КАК Ссылка,
	               |	Номенклатура.Артикул КАК Артикул
	               |ПОМЕСТИТЬ ВТ_Номенклатура
	               |ИЗ
	               |	ВТ_ТаблицаЦен КАК ВТ_ТаблицаЦен
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО ВТ_ТаблицаЦен.Артикул = Номенклатура.Артикул
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	               |	ЦеныНоменклатурыСрезПоследних.омг_Филиал КАК омг_Филиал,
	               |	МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена,
	               |	МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Период) КАК Период
	               |ПОМЕСТИТЬ ВТ_ТекущиеЦеныПоФилиалам
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |			,
	               |			(омг_Филиал, Номенклатура, Прейскурант) В
	               |					(ВЫБРАТЬ
	               |						ВТ_ТаблицаЦен.Филиал КАК Филиал,
	               |						ВТ_Номенклатура.Ссылка КАК Ссылка,
	               |						&ОсновнойПрейскурант КАК Прейскурант
	               |					ИЗ
	               |						ВТ_ТаблицаЦен КАК ВТ_ТаблицаЦен
	               |							ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	               |							ПО
	               |								ВТ_ТаблицаЦен.Артикул = ВТ_Номенклатура.Артикул)
	               |				И омг_Набор = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК ЦеныНоменклатурыСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	               |	ЦеныНоменклатурыСрезПоследних.омг_Филиал
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ВТ_ТаблицаЦен.Филиал КАК Справочник.Филиалы) КАК Филиал,
	               |	ВТ_ТаблицаЦен.Артикул КАК Артикул,
	               |	ВТ_ТаблицаЦен.Цена КАК Цена,
	               |	ВТ_Номенклатура.Ссылка КАК Номенклатура,
	               |	ВТ_ТаблицаЦен.Организация КАК Организация,
	               |	ВЫБОР
	               |		КОГДА ВТ_Номенклатура.Ссылка.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
	               |			ТОГДА ""Набор""
	               |		ИНАЧЕ ""Услуга""
	               |	КОНЕЦ КАК ДокументыПоВиду,
	               |	ВЫБОР
	               |		КОГДА ВТ_Номенклатура.Ссылка.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ПорядокПоВиду
	               |ПОМЕСТИТЬ ВТ_ИтоговыеНаборы
	               |ИЗ
	               |	ВТ_ТаблицаЦен КАК ВТ_ТаблицаЦен
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	               |		ПО ВТ_ТаблицаЦен.Артикул = ВТ_Номенклатура.Артикул
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущиеЦеныПоФилиалам КАК ВТ_ТекущиеЦеныПоФилиалам
	               |		ПО (ВТ_Номенклатура.Ссылка = ВТ_ТекущиеЦеныПоФилиалам.Номенклатура)
	               |			И ВТ_ТаблицаЦен.Филиал = ВТ_ТекущиеЦеныПоФилиалам.омг_Филиал
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ИСТИНА = ЛОЖЬ
	               |					ИЛИ &ТолькоИзмененияНоменклатурыИЦен
	               |				ТОГДА НЕ ВТ_ТаблицаЦен.Цена = ЕСТЬNULL(ВТ_ТекущиеЦеныПоФилиалам.Цена, 0)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И НЕ ВТ_Номенклатура.Ссылка ЕСТЬ NULL
	               |	И (ВТ_Номенклатура.Ссылка В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					ВТ_ГруппаНоменклатуры.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |				ИЗ
	               |					ВТ_ГруппаНоменклатуры КАК ВТ_ГруппаНоменклатуры)
	               |			ИЛИ ВТ_Номенклатура.Ссылка.Анализ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ИтоговыеНаборы.Номенклатура КАК Набор,
	               |	НоменклатураКомплектующиеНоменклатуры.Комплектующая КАК Комплектующая,
	               |	ВТ_ИтоговыеНаборы.Филиал КАК Филиал
	               |ПОМЕСТИТЬ ВТ_Комплектующие
	               |ИЗ
	               |	ВТ_ИтоговыеНаборы КАК ВТ_ИтоговыеНаборы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.КомплектующиеНоменклатуры КАК НоменклатураКомплектующиеНоменклатуры
	               |		ПО ВТ_ИтоговыеНаборы.Номенклатура = НоменклатураКомплектующиеНоменклатуры.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НоменклатураКомплектующиеНоменклатуры.Комплектующая,
	               |	ВТ_ИтоговыеНаборы.Номенклатура,
	               |	ВТ_ИтоговыеНаборы.Филиал
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ИтоговыеНаборы.Филиал КАК Филиал,
	               |	ВТ_ИтоговыеНаборы.Артикул КАК Артикул,
	               |	ЕСТЬNULL(ВТ_ИтоговыеНаборы.Цена, 0) КАК Цена,
	               |	ВТ_ИтоговыеНаборы.Номенклатура КАК Номенклатура,
	               |	ВТ_ИтоговыеНаборы.Организация КАК Организация,
	               |	ВТ_ИтоговыеНаборы.ДокументыПоВиду КАК ДокументыПоВиду,
	               |	ВТ_Комплектующие.Комплектующая КАК Комплектующая,
	               |	ЕСТЬNULL(Цены.Цена, 0) КАК ЦенаКомплектующей,
	               |	ЕСТЬNULL(ВТ_ТекущиеЦеныПоФилиалам.Цена, 0) КАК ЦенаНабораТекущая,
	               |	ВТ_ИтоговыеНаборы.ПорядокПоВиду КАК ПорядокПоВиду,
	               |	Цены.Период КАК Период,
	               |	ВТ_ИтоговыеНаборы.Филиал.Представление КАК ФилиалПредставление
	               |ИЗ
	               |	ВТ_ИтоговыеНаборы КАК ВТ_ИтоговыеНаборы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Комплектующие КАК ВТ_Комплектующие
	               |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				ЦеныНоменклатурыСрезПоследних.омг_Филиал КАК омг_Филиал,
	               |				ЦеныНоменклатурыСрезПоследних.омг_Набор КАК омг_Набор,
	               |				ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	               |				МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена,
	               |				МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Период) КАК Период
	               |			ИЗ
	               |				РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |						,
	               |						омг_Набор = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |							И Номенклатура В
	               |								(ВЫБРАТЬ
	               |									ВТ_Комплектующие.Комплектующая КАК Комплектующая
	               |								ИЗ
	               |									ВТ_Комплектующие КАК ВТ_Комплектующие)) КАК ЦеныНоменклатурыСрезПоследних
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				ЦеныНоменклатурыСрезПоследних.омг_Набор,
	               |				ЦеныНоменклатурыСрезПоследних.Номенклатура,
	               |				ЦеныНоменклатурыСрезПоследних.омг_Филиал) КАК Цены
	               |			ПО ВТ_Комплектующие.Комплектующая = Цены.Номенклатура
	               |				И ВТ_Комплектующие.Филиал = Цены.омг_Филиал
	               |		ПО ВТ_ИтоговыеНаборы.Номенклатура = ВТ_Комплектующие.Набор
	               |			И ВТ_ИтоговыеНаборы.Филиал = ВТ_Комплектующие.Филиал
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущиеЦеныПоФилиалам КАК ВТ_ТекущиеЦеныПоФилиалам
	               |		ПО ВТ_ИтоговыеНаборы.Филиал = ВТ_ТекущиеЦеныПоФилиалам.омг_Филиал
	               |			И ВТ_ИтоговыеНаборы.Номенклатура = ВТ_ТекущиеЦеныПоФилиалам.Номенклатура
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ТолькоИзмененияНоменклатурыИЦен
	               |				ТОГДА НЕ ВТ_ИтоговыеНаборы.Цена = ЕСТЬNULL(ВТ_ТекущиеЦеныПоФилиалам.Цена, 0)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И НЕ ВТ_ИтоговыеНаборы.Номенклатура ЕСТЬ NULL
	               |	И (НЕ КОНЕЦПЕРИОДА(ЕСТЬNULL(ВТ_ТекущиеЦеныПоФилиалам.Период, ДАТАВРЕМЯ(1, 1, 1)), ДЕНЬ) = &ТекущаяДата
	               |			ИЛИ ВЫБОР
	               |				КОГДА ВТ_ИтоговыеНаборы.ПорядокПоВиду = 1
	               |					ТОГДА НЕ КОНЕЦПЕРИОДА(ЕСТЬNULL(Цены.Период, ДАТАВРЕМЯ(1, 1, 1)), ДЕНЬ) = &ТекущаяДата
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядокПоВиду,
	               |	Филиал,
	               |	Номенклатура,
	               |	Комплектующая
	               |ИТОГИ
	               |	МАКСИМУМ(Цена),
	               |	СУММА(ЦенаКомплектующей),
	               |	МАКСИМУМ(ЦенаНабораТекущая)
	               |ПО
	               |	ДокументыПоВиду,
	               |	Организация,
	               |	Филиал,
	               |	Номенклатура
	               |АВТОУПОРЯДОЧИВАНИЕ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЦеныНоменклатурыСрезПоследних.Прейскурант КАК Прейскурант,
	               |	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	               |	ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЦеныНоменклатурыСрезПоследних.омг_Филиал КАК Филиал,
	               |	ЦеныНоменклатурыСрезПоследних.омг_Набор КАК омг_Набор,
	               |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	               |	ЦеныНоменклатурыСрезПоследних.омг_Филиал.Организация КАК Организация,
	               |	ЦеныНоменклатурыСрезПоследних.омг_Филиал.Представление КАК ФилиалПредставление
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |			,
	               |			омг_Филиал В
	               |					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |						ВТ_ТаблицаЦен.Филиал КАК Филиал
	               |					ИЗ
	               |						ВТ_ТаблицаЦен КАК ВТ_ТаблицаЦен)
	               |				И НЕ Номенклатура В
	               |						(ВЫБРАТЬ
	               |							ВТ_Номенклатура.Ссылка КАК Ссылка
	               |						ИЗ
	               |							ВТ_Номенклатура КАК ВТ_Номенклатура)
	               |				И Номенклатура В ИЕРАРХИИ
	               |					(ВЫБРАТЬ
	               |						ВТ_ГруппаНоменклатуры.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |					ИЗ
	               |						ВТ_ГруппаНоменклатуры КАК ВТ_ГруппаНоменклатуры)
	               |				И омг_Набор = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |				И Прейскурант = &ОсновнойПрейскурант) КАК ЦеныНоменклатурыСрезПоследних
	               |ГДЕ
	               |	НЕ ЦеныНоменклатурыСрезПоследних.Цена = 0
	               |ИТОГИ ПО
	               |	Филиал";
	
	#КонецОбласти

	Пока ВыборкаФилиалов.Следующий() Цикл
		
		ЦеныПоФилиалам.Очистить();
		
		Попытка
			HTTPСоединение = Новый HTTPСоединение(ВыборкаФилиалов.Адрес, ВыборкаФилиалов.Порт, 
				ВыборкаФилиалов.Пользователь, ВыборкаФилиалов.Пароль,, СтруктураНастроек.ВремяОжиданияСоединения);
			
		Исключение
			ТекстОшибки = "Не удалось установить соединение. Проверьте настройки.";
			
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка,
				Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, ТекстОшибки, ОписаниеОшибки());
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			Возврат;
		КонецПопытки;
		HTTPЗапрос = Новый HTTPЗапрос("query-dictionaries?format=json");
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("date", ЗаписатьДатуJSON(ТекущаяДата(), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
		HTTPЗапрос.УстановитьТелоИзСтроки(ЗаписатьЗначениеJSON(СтруктураЗапроса));
		
		Попытка
			Ответ = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
		Исключение
			ТекстОшибки = "Не удалось выполнить запрос к серверу.";
			
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка,
				Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, ТекстОшибки, ОписаниеОшибки());
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			Продолжить;
		КонецПопытки;
		
		Попытка
			СтруктураДанных = ПрочитатьЗначениеJSON(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
			
			Если Не СтруктураДанных.Свойство("prices") Тогда
				ВызватьИсключение("Не найдено поле ""prices""");
			КонецЕсли;
			
		Исключение
			ТекстОшибки = "Филиал: """ + ВыборкаФилиалов.ФилиалПредставление + """. Не удалось прочитать данные из ЛИС, невеный формат.
			|Поле ""prices"" не найдено.";
			Если СтруктураДанных.Свойство("error") Тогда
				ТекстОшибки = ТекстОшибки + "
				|Ошибка ЛИС: " + СтруктураДанных.error;
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка,
				Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, ТекстОшибки, ОписаниеОшибки());
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			Продолжить;
		КонецПопытки;
		
		Для Каждого СтруктураЦен Из СтруктураДанных.prices Цикл
			Если Не ОтборПоНоменклатуре = "" И Не СтруктураЦен.serviceCode = ОтборПоНоменклатуре Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаЦен = ЦеныПоФилиалам.Добавить();
			СтрокаЦен.Организация = ВыборкаФилиалов.Организация;
			СтрокаЦен.Филиал = ВыборкаФилиалов.Филиал;
			СтрокаЦен.Артикул = СтруктураЦен.serviceCode;
			СтрокаЦен.Цена = СтруктураЦен.price;
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации("ЛИС: Загрузка данных по прайс листам", 
			УровеньЖурналаРегистрации.Информация,
			Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль,,
			"Филиал: " + ВыборкаФилиалов.ФилиалПредставление + ", подготовлено """ + ЦеныПоФилиалам.Количество() + """ позиций.");

		ПакетРезультатов = Запрос.ВыполнитьПакет();
		
		ЦеныЛИСРезультатЗапроса = ПакетРезультатов.Получить(6);
		НулевыеПозицииРезультатЗапроса = ПакетРезультатов.Получить(7);
		
		ОбработкаПозицийЗагрузкиПрайслиста(ЦеныЛИСРезультатЗапроса, ОсновнойПрейскурант);

		Если Не НулевыеПозицииРезультатЗапроса.Пустой() Тогда
			
			КоличествоСформированныхДокументов = 0;
			
			ЗаписьЖурналаРегистрации("ЛИС: Начало обнуления цен по отсутствующим позициям", 
				УровеньЖурналаРегистрации.Информация,
				Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, "Количество сформированных документов """ + КоличествоСформированныхДокументов + """");
			
			
			ВыборкаПоФилиалам = НулевыеПозицииРезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПоФилиалам.Следующий() Цикл
				
				УстановкаЦенОбъект = Документы.УстановкаЦен.СоздатьДокумент();
				УстановкаЦенОбъект.омг_Организация = ВыборкаПоФилиалам.Организация; 
				УстановкаЦенОбъект.омг_Филиалы.Добавить().Филиал = ВыборкаПоФилиалам.Филиал;
				УстановкаЦенОбъект.Дата = ТекущаяДата();
				УстановкаЦенОбъект.ВидОперации = Перечисления.ВидыОперацийУстановкиЦен.ЦеныПрейскурантов;
				УстановкаЦенОбъект.омг_Прейскуранты.Добавить().Прейскурант = ОсновнойПрейскурант;
				
				ВыборкаПозиций = ВыборкаПоФилиалам.Выбрать();
				
				Пока ВыборкаПозиций.Следующий() Цикл
					СтрокаТабличнойЧасти = УстановкаЦенОбъект.Номенклатура.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ВыборкаПозиций);
					СтрокаТабличнойЧасти.Цена = 0;
				КонецЦикла;
				
				Попытка
					УстановкаЦенОбъект.Комментарий = "#Обнуление цен из ЛИС";
					УстановкаЦенОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
					
				Исключение
					УстановкаЦенОбъект.Комментарий = "#Обнуление цен из ЛИС";
					УстановкаЦенОбъект.Записать();
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Документ " + УстановкаЦенОбъект.Ссылка + " записан без проведения.";
					Сообщение.Сообщить();

					ЗаписьЖурналаРегистрации("ЛИС: Ошибка обнуления цен по отсутствующим позициям", 
						УровеньЖурналаРегистрации.Ошибка,
						Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль,
						"Не удалось провести обнуление цен по филиалу " + ВыборкаПоФилиалам.ФилиалПредставление + ", документ записан без проведения.", 
						ОписаниеОшибки());
				КонецПопытки;
				
				КоличествоСформированныхДокументов = КоличествоСформированныхДокументов + 1;
				
			КонецЦикла;
			
			ЗаписьЖурналаРегистрации("ЛИС: Окончание обнуления цен по отсутствующим позициям", 
				УровеньЖурналаРегистрации.Информация,
				Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль, "Количество сформированных документов """ + КоличествоСформированныхДокументов + """");

		КонецЕсли;
	КонецЦикла;
	
	
	
		
	
КонецПроцедуры

Процедура АрхивироватьЗаблокированныеИсследованияЛИС(СтруктураНастроек, СтруктураДанных)

	Событие = "Интеграция с ЛИС: Приостановка исследований ЛИС ";
	
	ЗаписьЖурналаРегистрации("ЛИС: Начало загрузки данных по приостановленным исследованиям ЛИС", 
		УровеньЖурналаРегистрации.Информация,
		Метаданные.ОбщиеМодули.омг_ИнтеграцияСЛИС.Модуль);

	ДанныеФилиалов = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("омг_ДополнительныеНастройкиИнтеграцииЛИС", "ДанныеФилиалов");
	
	ВыборкаФилиалов = ПолучитьВыборкуФилиалов();
	
	ТаблицаБлокировок = Новый ТаблицаЗначений;
	ТаблицаБлокировок.Колонки.Добавить("Артикул", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаБлокировок.Колонки.Добавить("Дата", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ТаблицаБлокировок.Колонки.Добавить("Причина", ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТаблицаБлокировок.Колонки.Добавить("Комментарий", ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТаблицаБлокировок.Колонки.Добавить("Филиал", Новый ОписаниеТипов("СправочникСсылка.Филиалы"));
	
	ОтборПоНоменклатуре = ""; // Для целей отладки
	
	Пока ВыборкаФилиалов.Следующий() Цикл
		
		Попытка
			HTTPСоединение = Новый HTTPСоединение(ВыборкаФилиалов.Адрес, ВыборкаФилиалов.Порт, 
				ВыборкаФилиалов.Пользователь, ВыборкаФилиалов.Пароль,, СтруктураНастроек.ВремяОжиданияСоединения);
			
		Исключение
			ТекстОшибки = "Не удалось установить соединение. Проверьте настройки.";
			

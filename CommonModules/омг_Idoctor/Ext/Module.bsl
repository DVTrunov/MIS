		//	"Общая ошибка подготовки переноса bookingId=" + Строка(ДокЗаявка.Омг_bookingId) + ": " + ОписаниеОшибки());
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ОпределитьПолПоФИО(Фамилия = "", Имя = "", Отчество = "") Экспорт

	Если Не ПустаяСтрока(Отчество) Тогда
		ОтчествоНижний = НРег(Отчество);
		ОкончаниеОтчества = Прав(ОтчествоНижний, 3);

		Если ОкончаниеОтчества = "вна" Или ОкончаниеОтчества = "чна" Или ОкончаниеОтчества = "льна"
			Или ОкончаниеОтчества = "vna" Или ОкончаниеОтчества = "chna" Или ОкончаниеОтчества = "lna"
			Или ОкончаниеОтчества = "кызы" Или ОкончаниеОтчества = "qyzy" Или ОкончаниеОтчества = "kyzy"
			Или ОкончаниеОтчества = "қызы" Тогда
			Возврат Перечисления.ПолФизическихЛиц.Женский;
		ИначеЕсли ОкончаниеОтчества = "вич" Или ОкончаниеОтчества = "ьич" Или ОкончаниеОтчества = "тич"
			Или ОкончаниеОтчества = "vich" Или ОкончаниеОтчества = "ich" Или ОкончаниеОтчества = "tich"
			Или ОкончаниеОтчества = "tych" Или ОкончаниеОтчества = "uly" Или ОкончаниеОтчества = "улы"
			Или ОкончаниеОтчества = "ұлы" Тогда
			Возврат Перечисления.ПолФизическихЛиц.Мужской;
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(Фамилия) Тогда
		ФамилияНижний = НРег(Фамилия);
		ОкончаниеФамилии = Прав(ФамилияНижний, 2);

		Если ОкончаниеФамилии = "va" Или ОкончаниеФамилии = "na" Тогда
			Возврат Перечисления.ПолФизическихЛиц.Женский;
		ИначеЕсли ОкончаниеФамилии = "ov" Или ОкончаниеФамилии = "ev" Или ОкончаниеФамилии = "in" Тогда
			Возврат Перечисления.ПолФизическихЛиц.Мужской;
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(Имя) Тогда
		ИмяНижний = НРег(Имя);
		ПоследнийСимвол = Прав(ИмяНижний, 1);

		Если ПоследнийСимвол = "а" Или ПоследнийСимвол = "я" Или ПоследнийСимвол = "ь" Или ПоследнийСимвол = "a" Тогда
			Возврат Перечисления.ПолФизическихЛиц.Женский;
		Иначе
			Возврат Перечисления.ПолФизическихЛиц.Мужской;
		КонецЕсли;
	КонецЕсли;

	Возврат Перечисления.ПолФизическихЛиц.Мужской;

КонецФункции

Функция РазобратьФИО(ФИОСтрока) Экспорт

	МассивФИО = СтрРазделить(ФИОСтрока, " ", Ложь);

	Результат = Новый Структура("Фамилия, Имя, Отчество", "", "", "");

	Если МассивФИО.Количество() >= 1 Тогда
		Результат.Фамилия = МассивФИО[0];
	КонецЕсли;
	Если МассивФИО.Количество() >= 2 Тогда
		Результат.Имя = МассивФИО[1];
	КонецЕсли;
	Если МассивФИО.Количество() >= 3 Тогда
		Результат.Отчество = МассивФИО[2];
	КонецЕсли;

	Возврат Результат;

КонецФункции

// -------------------------------------------------------------------------------
// GET /doctors, /services, /appointments - без изменений по сути от предыдущей
// версии (см. предыдущий комплект файлов), включены сюда для полноты единого
// ядра. Комментарии сокращены - подробности см. в README.
// -------------------------------------------------------------------------------

// GET /doctors - список активных врачей. Идентификатор врача (id) зависит
// от источника запроса:
//   "idoctor" - Сотрудники.омг_idoctorId (значение вносится вручную);
//   иначе     - РегистрСведений.омг_ВнешнийIdВрачаНашФормат (значение
//               генерируется автоматически при создании сотрудника, общее
//               для всех партнёров "нашего формата" - см. п.1 алгоритма
//               генерации ID врачей). Сотрудник без записи в этом регистре
//               в выдачу для "нашего формата" не попадает.
Функция ПолучитьАктивныхВрачей(Источник) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;

	Если НРЕГ(Источник) = "idoctor" Тогда

		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.Ссылка КАК Ссылка,
		|	Сотрудники.омг_idoctorId КАК Id,
		|	Сотрудники.Наименование КАК ФИО
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботы КАК ГрафикиРаботы
		|		ПО ГрафикиРаботы.Сотрудник = Сотрудники.Ссылка
		|			И ГрафикиРаботы.Дата >= &НачалоСегодня
		|			И ГрафикиРаботы.ВидВремени = ЗНАЧЕНИЕ(Справочник.ВидыВремениГрафика.РабочееВремя)
		|ГДЕ
		|	НЕ Сотрудники.ПометкаУдаления
		|	И НЕ Сотрудники.омг_idoctorНеВыгружать
		|	И Сотрудники.омг_idoctorId <> 0";

	Иначе

		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.Ссылка КАК Ссылка,
		|	омг_ВнешнийIdВрачаНашФормат.Id КАК Id,
		|	Сотрудники.Наименование КАК ФИО
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботы КАК ГрафикиРаботы
		|		ПО ГрафикиРаботы.Сотрудник = Сотрудники.Ссылка
		|			И ГрафикиРаботы.Дата >= &НачалоСегодня
		|			И ГрафикиРаботы.ВидВремени = ЗНАЧЕНИЕ(Справочник.ВидыВремениГрафика.РабочееВремя)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.омг_ВнешнийIdВрачаНашФормат КАК омг_ВнешнийIdВрачаНашФормат
		|		ПО омг_ВнешнийIdВрачаНашФормат.Сотрудник = Сотрудники.Ссылка
		|ГДЕ
		|	НЕ Сотрудники.ПометкаУдаления
		|	И НЕ Сотрудники.омг_idoctorНеВыгружать";

	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоСегодня", НачалоДня(ТекущаяДата()));

	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;

	Пока Выборка.Следующий() Цикл

		Специализации = Новый Массив;
		Для Каждого СтрокаСпециализации Из Выборка.Ссылка.Специализации Цикл
			Если ЗначениеЗаполнено(СтрокаСпециализации.Специализация) Тогда
				Специализации.Добавить(Строка(СтрокаСпециализации.Специализация));
			КонецЕсли;
		КонецЦикла;

		Врач = Новый Структура;
		Врач.Вставить("id", Выборка.Id);
		Врач.Вставить("fullName", Выборка.ФИО);
		Врач.Вставить("specialties", Специализации);

		Результат.Добавить(Врач);

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

Функция ПолучитьУслуги(FilialId) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Филиал = ПолучитьФилиалПоID(FilialId);
	Если Филиал = Неопределено Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Новый Массив;
	КонецЕсли;

	Организация = омг_ДополнительныеАлгоритмы.омг_ВернутьОрганизациюПоФилиалу(Филиал);

	// ВАЖНО ПРИ ПЕРЕНОСЕ МЕЖДУ БАЗАМИ: название прайса "по умолчанию"
	// РАЗЛИЧАЕТСЯ между базами - в базе 83 (текущее значение ниже) это
	// "Розничная цена", в базе 85 - "Розничный". Решение вынести в
	// константу отложено (пока оставляем в коде по решению от 05.09.2026) -
	// при переносе этого кода в базу 85 нужно вручную заменить строку
	// ниже на "Розничный".
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Прейскуранты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Прейскуранты КАК Прейскуранты
	|ГДЕ
	|	Прейскуранты.Наименование = ""Розничная цена""
	|	И Прейскуранты.омг_Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);

	Выборка = Запрос.Выполнить().Выбрать();
	Если не Выборка.Следующий() Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Новый Массив;
	КонецЕсли;
	Прейскурант = Выборка.Ссылка;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Ссылка,
	|	СпрНоменклатура.омг_idoctorId КАК Id,
	|	СпрНоменклатура.Наименование КАК Наименование,
	|	СпрНоменклатура.КатегорияВыработки КАК Категория,
	|	СпрНоменклатура.ПродолжительностьЧас КАК ПродолжительностьЧас,
	|	СпрНоменклатура.ПродолжительностьМин КАК ПродолжительностьМин,
	|	ЦеныНоменклатуры.Цена КАК Цена
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Прейскурант = &Прейскурант И омг_Филиал = &Филиал) КАК ЦеныНоменклатуры
	|		ПО ВЫРАЗИТЬ(ЦеныНоменклатуры.Номенклатура КАК Справочник.Номенклатура) = СпрНоменклатура.Ссылка
	|ГДЕ
	|	СпрНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
	|	И НЕ СпрНоменклатура.Архив
	|	И СпрНоменклатура.омг_idoctorId <> 0";

	Запрос.УстановитьПараметр("Прейскурант", Прейскурант);
	Запрос.УстановитьПараметр("Филиал", Филиал);

	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;

	Пока Выборка.Следующий() Цикл

		ДлительностьМин = Выборка.ПродолжительностьЧас * 60 + Выборка.ПродолжительностьМин;

		Услуга = Новый Структура;
		Услуга.Вставить("id", Выборка.Id);
		Услуга.Вставить("name", Выборка.Наименование);
		Услуга.Вставить("price", ?(ЗначениеЗаполнено(Выборка.Цена), Выборка.Цена, 0));
		Услуга.Вставить("durationMinutes", ДлительностьМин);
		Услуга.Вставить("category", ?(ЗначениеЗаполнено(Выборка.Категория), Строка(Выборка.Категория), ""));

		Результат.Добавить(Услуга);

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

Функция ПолучитьЗаявки(ДатаНачала = Неопределено, ДатаОкончания = Неопределено, Телефон = "", BookingId = "", Источник = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);

	УсловияТекст = "";

	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) Тогда
		УсловияТекст = УсловияТекст + "
		|	И Заявка.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания";
	КонецЕсли;

	Если ЗначениеЗаполнено(BookingId) Тогда
		УсловияТекст = УсловияТекст + "
		|	И Заявка.Омг_bookingId = &BookingId";
	КонецЕсли;

	Если ЗначениеЗаполнено(Источник) Тогда
		УсловияТекст = УсловияТекст + "
		|	И Заявка.ИсточникБронирования = &Источник";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявка.Ссылка КАК Ссылка,
	|	Заявка.Омг_bookingId КАК BookingId,
	|	Заявка.ИсточникБронирования КАК Источник,
	|	Заявка.Клиент КАК Клиент,
	|	ЕСТЬNULL(Заявка.Клиент.Наименование, """") КАК ПациентФИО,
	|	Заявка.Состояние КАК Состояние,
	|	Заявка.Состояние.ТипСостояния КАК ТипСостояния
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|ГДЕ
	|	НЕ Заявка.ПометкаУдаления"
	+ УсловияТекст + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заявка.ДатаНачала";

	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) Тогда
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	КонецЕсли;
	Если ЗначениеЗаполнено(BookingId) Тогда
		Запрос.УстановитьПараметр("BookingId", BookingId);
	КонецЕсли;
	Если ЗначениеЗаполнено(Источник) Тогда
		Запрос.УстановитьПараметр("Источник", Источник);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;

	Пока Выборка.Следующий() Цикл

		Если ЗначениеЗаполнено(Телефон) Тогда
			ТелефонКлиента = ПолучитьТелефонКлиента(Выборка.Клиент);
			Если СтрНайти(ТелефонКлиента, Телефон) = 0 Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			ТелефонКлиента = ПолучитьТелефонКлиента(Выборка.Клиент);
		КонецЕсли;

		ЭтоОтменена = (Выборка.ТипСостояния = Перечисления.ТипыСостоянийЗаявок.Отменена);

		// Слоты записи - каждая строка табличной части "Работы" соответствует
		// одному слоту (одна услуга/врач/время). Данные, относящиеся к заявке
		// в целом (пациент, статус), приводятся один раз на объект, а не
		// дублируются по слотам (см. Спецификацию протокола обмена, п. 10.3).
		Слоты = Новый Массив;
		Для Каждого СтрРаботы Из Выборка.Ссылка.Работы Цикл

			ВрачId    = ?(ЗначениеЗаполнено(СтрРаботы.Сотрудник), СтрРаботы.Сотрудник.омг_idoctorId, 0);
			ServiceId = ?(ЗначениеЗаполнено(СтрРаботы.Номенклатура), СтрРаботы.Номенклатура.омг_idoctorId, 0);

			Слот = Новый Структура;
			Слот.Вставить("slotId", СтрРаботы.омг_SlotId);
			Слот.Вставить("doctorId", ВрачId);
			Слот.Вставить("serviceId", ServiceId);
			Слот.Вставить("startAt", Формат(СтрРаботы.ДатаНачала, "ДФ='yyyy-MM-dd HH:mm:ss'"));
			Слот.Вставить("endAt", Формат(СтрРаботы.ДатаОкончания, "ДФ='yyyy-MM-dd HH:mm:ss'"));

			Слоты.Добавить(Слот);

		КонецЦикла;

		Заявка = Новый Структура;
		Заявка.Вставить("bookingId", Выборка.BookingId);
		Заявка.Вставить("source", Выборка.Источник);
		Заявка.Вставить("patientName", Выборка.ПациентФИО);
		Заявка.Вставить("patientPhone", ТелефонКлиента);
		Заявка.Вставить("status", Строка(Выборка.Состояние));
		Заявка.Вставить("isCancelled", ЭтоОтменена);
		Заявка.Вставить("slots", Слоты);

		Результат.Добавить(Заявка);

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

Функция ПолучитьТелефонКлиента(Клиент) Экспорт

	Если Клиент = Неопределено Или Клиент.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление КАК Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Клиент
	|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонСотовый)";
	Запрос.УстановитьПараметр("Клиент", Клиент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Представление;
	КонецЕсли;

	Возврат "";

КонецФункции

// -------------------------------------------------------------------------------
// АВТОГЕНЕРАЦИЯ: Номенклатура.омг_idoctorId для НОВЫХ услуг.
//
// Требуемая подписка на событие (создаётся в конфигураторе):
//   Источник:   СправочникОбъект.Номенклатура
//   Событие:    ПриЗаписи
//   Обработчик: омг_Idoctor.омг_ПриЗаписиНоменклатурыПриЗаписи
//
// Присваивает ID только позициям с ВидНоменклатуры = Услуга - остальные
// виды номенклатуры (товары и т.п.) для API не нужны, омг_idoctorId у них
// остаётся 0. Значение пишется напрямую в реквизит объекта - отдельный
// регистр (в отличие от врачей) не требуется, поскольку у услуг нет
// конкурирующего идентификатора от iDoctor (в их протоколе понятия
// "услуга" не существует).
// -------------------------------------------------------------------------------
Процедура омг_ПриЗаписиНоменклатурыПриЗаписи(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не Источник.ЭтоНовый() Тогда
		Возврат; // генерация выполняется один раз, при создании
	КонецЕсли;

	Если Источник.ВидНоменклатуры <> Перечисления.ВидыНоменклатуры.Услуга Тогда
		Возврат; // ID нужен только услугам - товары и т.п. не участвуют в API
	КонецЕсли;

	Если Источник.омг_idoctorId <> 0 Тогда
		Возврат; // значение уже установлено вручную - не перезаписываем
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.Номенклатура");
		ЭлементБлокировки.РежимБлокировки = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать(); // работает внутри уже открытой транзакции ПриЗаписи

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(Номенклатура.омг_idoctorId) КАК МаксId
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура";

		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();

		НовыйId = ?(ЗначениеЗаполнено(Выборка.МаксId), Выборка.МаксId + 1, 1);

		Источник.омг_idoctorId = НовыйId;

	Исключение
		//ЗаписьЖурналаРегистрации("омг_Idoctor.омг_ПриЗаписиНоменклатурыПриЗаписи", УровеньЖурналаРегистрации.Ошибка, , ,
			//"Не удалось сгенерировать внешний ID для услуги: " + ОписаниеОшибки());
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

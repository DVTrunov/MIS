// =====================================================================================
// ОБЩИЙ МОДУЛЬ: омг_Idoctor (ЕДИНАЯ версия для базы 83 и базы 85)
//
// АРХИТЕКТУРНОЕ РЕШЕНИЕ: СоздатьЗаявкуНаСервере теперь принимает ОДНУ структуру
// с именованными полями вместо 14 позиционных параметров. Это устраняет целый
// КЛАСС багов, обнаруженных за время работы над интеграцией:
//   - в базе 85: metod=BOOKING передавал bookingId в 10-й параметр вместо 14-го;
//   - в базе 83: bookingCode/bookingId/comment были сдвинуты по позициям
//     (bookingCode попадал в Омг_bookingId, bookingId - в ДатаРождения,
//     склеенная строка комментария - в Пол).
// С именованными полями структуры такая ошибка становится трудноосуществимой:
// спутать Стр.bookingId и Стр.bookingCode в коде адаптера гораздо заметнее,
// чем перепутать 10-й и 11-й позиционный аргумент функции.
//
// ВТОРОЕ АРХИТЕКТУРНОЕ РЕШЕНИЕ: составной ключ поиска/идемпотентности
// (Источник + bookingId) вместо одного bookingId. Критично для мульти-партнёрской
// базы 85 (iDoctor + Жасыл) - bookingId каждого партнёра не гарантированно
// уникален относительно другого партнёра.
//
// Требуемое изменение метаданных: добавить реквизит Документ.Заявка.ИсточникБронирования
// (Строка(20) или ПеречислениеСсылка) со значениями "idoctor", "jazyl", ... -
// см. README к этому комплекту.
// =====================================================================================

&НаСервере
Процедура ОтправитьРасписаниеНаСервере(Сотрудник = Неопределено, Филиал = Неопределено, Дата = Неопределено, Сотрудники = Неопределено, Дата2 = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если не Дата2 = Неопределено Тогда
		МаксДата = Макс(Дата, Дата2);
		МинДата = Мин(Дата, Дата2);
		МасРасписаний = ПолучитьРасписание(Сотрудник, Филиал, Дата, Сотрудники, МинДата, МаксДата);
	Иначе
		МасРасписаний = ПолучитьРасписание(Сотрудник, Филиал, Дата, Сотрудники);
	КонецЕсли;

	КэшПараметров = Новый Соответствие; // ключ: medcenterId -> Структура(Синхронизации, Ключи)
	КэшФилиалов    = Новый Соответствие; // ключ: medcenterId -> СправочникСсылка.Филиалы

	Для Каждого ДанныеОРасписании Из МасРасписаний Цикл

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеОРасписании);
		СтрокаДляТела = ЗаписьJSON.Закрыть();

		medcenterId = ДанныеОРасписании.medcenter.id;

		ПараметрыОбмена = КэшПараметров[medcenterId];
		Если ПараметрыОбмена = Неопределено Тогда

			ФилиалТек = КэшФилиалов[medcenterId];
			Если ФилиалТек = Неопределено Тогда
				ФилиалТек = ПолучитьФилиалПоID(medcenterId);
				КэшФилиалов.Вставить(medcenterId, ФилиалТек);
			КонецЕсли;

			Если ФилиалТек = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ПараметрыОбмена = ПолучитьПараметрыОбменаДаннымиСВнешнимиСистемами(ФилиалТек);
			КэшПараметров.Вставить(medcenterId, ПараметрыОбмена);

		КонецЕсли;

		Синхронизации = ПараметрыОбмена.Синхронизации;
		Ключи         = ПараметрыОбмена.Ключи;

		ОбработанныеСинхронизации = Новый Соответствие;
		Соединение = Неопределено;
		СинхронизацияТек = Неопределено;

		Для Каждого СтрокаСинхронизации Из Синхронизации Цикл

			Если ОбработанныеСинхронизации[СтрокаСинхронизации.Синхронизация] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ОбработанныеСинхронизации.Вставить(СтрокаСинхронизации.Синхронизация, Истина);

			Если ПустаяСтрока(СокрЛП(СтрокаСинхронизации.СинхронизацияЭндПоинт)) Тогда
				//ЗаписьЖурналаРегистрации(
					//"омг_Idoctor.ОтправитьРасписаниеНаСервере", УровеньЖурналаРегистрации.Ошибка, , ,
					//"Пустой ЭндПоинт для синхронизации " + Строка(СтрокаСинхронизации.Синхронизация));
				Продолжить;
			КонецЕсли;

			Если не СинхронизацияТек = СтрокаСинхронизации.Синхронизация Тогда

				СинхронизацияТек = СтрокаСинхронизации.Синхронизация;

				ПортСоединения = ?(СтрокаСинхронизации.СинхронизацияПорт = 0, Неопределено, СтрокаСинхронизации.СинхронизацияПорт);
				ПользовательСоединения = ?(ПустаяСтрока(СтрокаСинхронизации.СинхронизацияПользователь), Неопределено, СтрокаСинхронизации.СинхронизацияПользователь);
				ПарольСоединения       = ?(ПользовательСоединения = Неопределено, Неопределено, СтрокаСинхронизации.СинхронизацияПароль);

				Соединение = Новый HTTPСоединение(
					СтрокаСинхронизации.СинхронизацияСервер, ПортСоединения,
					ПользовательСоединения, ПарольСоединения, ,
					СтрокаСинхронизации.СинхронизацияТаймаут, Новый ЗащищенноеСоединениеOpenSSL(),
					СтрокаСинхронизации.СинхронизацияИспользоватьАутентификациюОС);

			КонецЕсли;

			Запрос = Новый HTTPЗапрос(СокрЛП(СтрокаСинхронизации.СинхронизацияЭндПоинт));

			НайденныеКлючи = Ключи.НайтиСтроки(Новый Структура("Ссылка", СинхронизацияТек));
			Для Каждого СтрокаКлюча Из НайденныеКлючи Цикл
				Запрос.Заголовки.Вставить(СтрокаКлюча.Ключ, СтрокаКлюча.Значение);
			КонецЦикла;

			Запрос.УстановитьТелоИзСтроки(СтрокаДляТела, "UTF-8");

			Попытка
				Ответ = Соединение.ОтправитьДляОбработки(Запрос);
				Если Ответ.КодСостояния >= 300 Тогда
					//ЗаписьЖурналаРегистрации(
						//"омг_Idoctor.ОтправитьРасписаниеНаСервере", УровеньЖурналаРегистрации.Предупреждение, , ,
						//"Код ответа " + Ответ.КодСостояния + " от " + СтрокаСинхронизации.СинхронизацияСервер
						//+ СтрокаСинхронизации.СинхронизацияЭндПоинт + ". Тело: " + Ответ.ПолучитьТелоКакСтроку());
				КонецЕсли;
			Исключение
				//ЗаписьЖурналаРегистрации(
					//"омг_Idoctor.ОтправитьРасписаниеНаСервере", УровеньЖурналаРегистрации.Ошибка, , ,
					//"Ошибка отправки на " + СтрокаСинхронизации.СинхронизацияСервер + СтрокаСинхронизации.СинхронизацияЭндПоинт
					//+ ": " + ОписаниеОшибки());
			КонецПопытки;

		КонецЦикла;

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ПроверитьРасписаниеНаСервере(doctorId, medcenterId, startAt, endAt, Дата, Источник = "", ИсключитьBookingId = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикиРаботы.Филиал КАК Филиал,
	|	ГрафикиРаботы.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.ГрафикиРаботы КАК ГрафикиРаботы
	|ГДЕ
	|	ГрафикиРаботы.ВремяНачала <= &ВремяНачала
	|	И ГрафикиРаботы.Филиал.омг_idoctorId = &medcenterId
	|	И ГрафикиРаботы.Сотрудник.омг_idoctorId = &doctorId
	|	И ГрафикиРаботы.ВремяОкончания >= &ВремяОкончания
	|	И ГрафикиРаботы.Дата = &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	ГрафикиРаботы.Филиал,
	|	ГрафикиРаботы.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	омг_ЗанятоеВремяЗаявок.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.омг_ЗанятоеВремяЗаявок КАК омг_ЗанятоеВремяЗаявок
	|ГДЕ
	|	омг_ЗанятоеВремяЗаявок.ДатаНачала = &ДатаНачалаЗаявки
	|	И омг_ЗанятоеВремяЗаявок.ДатаОкончания = &ДатаОкончанияЗаявки
	|	И омг_ЗанятоеВремяЗаявок.Сотрудник.омг_idoctorId = &doctorId
	|	И омг_ЗанятоеВремяЗаявок.Регистратор.Филиал.омг_idoctorId = &medcenterId
	|	И НЕ (омг_ЗанятоеВремяЗаявок.Регистратор.Омг_bookingId = &ИсключитьBookingId
	|		И омг_ЗанятоеВремяЗаявок.Регистратор.ИсточникБронирования = &Источник)"; // ИСПРАВЛЕНО:
	// составной ключ - исключаем ТОЛЬКО заявку с совпадающими (Источник, bookingId),
	// а не любую заявку с таким же bookingId у другого партнёра.

	Запрос.УстановитьПараметр("medcenterId", medcenterId);
	Запрос.УстановитьПараметр("doctorId", doctorId);
	Запрос.УстановитьПараметр("ВремяНачала", startAt);
	Запрос.УстановитьПараметр("ВремяОкончания", endAt);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ДатаНачалаЗаявки", Дата + (startAt - Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("ДатаОкончанияЗаявки", Дата + (endAt - Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("ИсключитьBookingId", ИсключитьBookingId);

	РезультатЗапроса = Запрос.ВыполнитьПакет();

	ВыборкаЗанятоеВремя = РезультатЗапроса[1].Выбрать();
	ВыборкаСотрудник     = РезультатЗапроса[0].Выбрать();

	ВозЗначение = Ложь;

	Если ВыборкаСотрудник.Следующий() И не ВыборкаЗанятоеВремя.Следующий() Тогда
		ВозЗначение = Истина;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат ВозЗначение;

КонецФункции

// =====================================================================================
// ЕДИНАЯ ТОЧКА ВХОДА для всех партнёров: принимает СТРУКТУРУ с именованными полями.
//
// Обязательные поля структуры Данные:
//   Источник      - "idoctor" | "jazyl" | ... (кто вызвал; определяется адаптером)
//   Событие       - "created" | "cancelled" | "rebooked"
//   BookingId     - идентификатор брони СО СТОРОНЫ ПАРТНЁРА (ключ идемпотентности
//                   вместе с Источник), тип Число
//
// Общие поля заявки (для created/rebooked):
//   MedcenterId, Иин, Телефон, ФИО, ДатаРождения, Пол, Комментарий
//
// Слоты (для created/rebooked) - МАССИВ структур, каждая содержит:
//   DoctorId, ServiceId (обязателен, если элементов массива >= 2),
//   ВремяНачала, ВремяОкончания, Дата, SlotId (необязателен - указывается
//   только при частичном обновлении конкретного слота ранее созданной заявки)
//
// Возврат:
//   Неопределено         - операция не выполнена (см. журнал регистрации)
//   Структура("GUID,Слоты") - успех; ГУИД документа + массив структур
//                             {"SlotId"} по каждой строке итогового состава
//                             заявки (для cancelled - пустой массив)
// =====================================================================================
&НаСервере
Функция ОбработатьБронирование(Знач Данные) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если Не Данные.Свойство("Источник") Или ПустаяСтрока(Данные.Источник) Тогда
		//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Ошибка, , , "Не указан Источник");
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Неопределено;
	КонецЕсли;

	Если Не Данные.Свойство("BookingId") Или Не ЗначениеЗаполнено(Данные.BookingId) Тогда
		//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Ошибка, , , "Не указан BookingId, Источник=" + Данные.Источник);
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Неопределено;
	КонецЕсли;

	Источник  = Данные.Источник;
	BookingId = Данные.BookingId; // Число(15) - тип реквизита Заявка.Омг_bookingId
	Событие   = ?(Данные.Свойство("Событие"), Данные.Событие, "");

	// --- CANCELLED ---------------------------------------------------------------
	Если НРЕГ(Событие) = НРЕГ("cancelled") Тогда

		СсылкаДокумента = НайтиЗаявкуПоКлючу(Источник, BookingId);
		Если СсылкаДокумента = Неопределено Тогда
			//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Предупреждение, , ,
				//"cancelled: не найдена заявка (Источник=" + Источник + ", BookingId=" + Строка(BookingId) + ")");
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Неопределено;
		КонецЕсли;

		ДокЗаявка = СсылкаДокумента.ПолучитьОбъект();
		ДокЗаявка.ОбменДанными.Загрузка = Истина;
		// Маркер источника этого конкретного изменения - используется подпиской
		// омг_ПриЗаписиЗаявки, чтобы НЕ уведомлять iDoctor через B2 (cancel) об
		// отмене, которую они сами и инициировали через этот же вебхук (иначе
		// возникла бы петля уведомлений "они нам - мы им обратно").
		ДокЗаявка.ДополнительныеСвойства.Вставить("омг_ПартнёрИнициатор", Источник);
		ДокЗаявка.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена;
		ДокЗаявка.Записать();

		Набор = РегистрыСведений.омг_ЗанятоеВремяЗаявок.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ДокЗаявка.Ссылка);
		Набор.Записать();

		ОтправитьРасписаниеНаСервере(ДокЗаявка.Сотрудник, , ДокЗаявка.ДатаНачала);

		УстановитьПривилегированныйРежим(Ложь);
		Возврат Новый Структура("GUID,Слоты", Строка(ДокЗаявка.Ссылка.УникальныйИдентификатор()), Новый Массив);

	КонецЕсли;

	// --- REBOOKED: находим существующий документ ---------------------------------
	ЭтоСоздание = НРЕГ(Событие) = НРЕГ("created");
	ДокЗаявка = Неопределено;

	Если Не ЭтоСоздание Тогда

		СсылкаДокумента = НайтиЗаявкуПоКлючу(Источник, BookingId);
		Если СсылкаДокумента = Неопределено Тогда
			//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Предупреждение, , ,
				//"rebooked: не найдена заявка (Источник=" + Источник + ", BookingId=" + Строка(BookingId) + ")");
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Неопределено;
		КонецЕсли;

		ДокЗаявка = СсылкаДокумента.ПолучитьОбъект();

	Иначе

		// ИДЕМПОТЕНТНОСТЬ: повтор запроса на создание с тем же (Источник, BookingId)
		Существующая = НайтиЗаявкуПоКлючу(Источник, BookingId);
		Если Существующая <> Неопределено Тогда
			ДокСуществующий = Существующая.ПолучитьОбъект();
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Новый Структура("GUID,Слоты", Строка(Существующая.УникальныйИдентификатор()), СобратьСлотыИзРабот(ДокСуществующий));
		КонецЕсли;

	КонецЕсли;

	// --- Проверка наличия и корректности массива слотов ---------------------------
	Если Не Данные.Свойство("Слоты") Или Данные.Слоты.Количество() = 0 Тогда
		//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Ошибка, , ,
			//"Не передан ни один слот. Источник=" + Источник + ", BookingId=" + Строка(BookingId));
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Неопределено;
	КонецЕсли;

	ИсходныеСлоты = Данные.Слоты;

	// Правило обязательности ServiceId при количестве слотов от двух -
	// продублировано здесь как защитный уровень, даже если адаптер уже
	// проверил это до вызова ядра (см. п. 3.3 инструкции по доработке).
	Если ИсходныеСлоты.Количество() >= 2 Тогда
		Для Каждого ИсхСлот Из ИсходныеСлоты Цикл
			Если Не ИсхСлот.Свойство("ServiceId") Или Не ЗначениеЗаполнено(ИсхСлот.ServiceId) Тогда
				//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Ошибка, , ,
					//"ServiceId не указан при количестве слотов >= 2. Источник=" + Источник + ", BookingId=" + Строка(BookingId));
				УстановитьПривилегированныйРежим(Ложь);
				Возврат Неопределено;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// --- Резолвинг клиента/клиники (общий для всей заявки) -----------------------
	medcenterId = ?(Данные.Свойство("MedcenterId"), Данные.MedcenterId, "");
	ИИН         = ?(Данные.Свойство("Иин"), Данные.Иин, "");
	Тел         = ?(Данные.Свойство("Телефон"), Данные.Телефон, "");
	Имя         = ?(Данные.Свойство("ФИО"), Данные.ФИО, "");
	ДатаРождения = ?(Данные.Свойство("ДатаРождения"), Данные.ДатаРождения, Неопределено);
	Пол          = ?(Данные.Свойство("Пол"), Данные.Пол, 0);
	Комментарий  = ?(Данные.Свойство("Комментарий"), Данные.Комментарий, "");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Клиенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Клиенты КАК Клиенты
	|ГДЕ
	|	Клиенты.ИНН = &ИИН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Филиалы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Филиалы КАК Филиалы
	|ГДЕ
	|	Филиалы.омг_idoctorId = &medcenterId
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Клиенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Клиенты КАК Клиенты
	|ГДЕ
	|	Клиенты.Наименование = &Имя
	|	И Клиенты.ДатаРождения = &ДатаРождения";

	Запрос.УстановитьПараметр("ИИН", ИИН);
	Запрос.УстановитьПараметр("medcenterId", medcenterId);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ДатаРождения", ?(ЗначениеЗаполнено(ДатаРождения), ДатаРождения, Дата(1, 1, 1)));

	РезультатЗапроса = Запрос.ВыполнитьПакет();

	ВыборкаКлиент  = РезультатЗапроса[0].Выбрать();
	ВыборкаКлиника = РезультатЗапроса[1].Выбрать();
	ВыборкаКлиент2 = РезультатЗапроса[2].Выбрать();

	Клиент = Неопределено;

	Если ВыборкаКлиент.Следующий() И ЗначениеЗаполнено(ИИН) Тогда
		Клиент = ВыборкаКлиент.Ссылка;
	ИначеЕсли ВыборкаКлиент2.Следующий() Тогда
		Клиент = ВыборкаКлиент2.Ссылка;
	Иначе
		Клиент = СоздатьКлиента(ИИН, Имя, Тел, ДатаРождения, Пол);
	КонецЕсли;

	Клиника = ?(ВыборкаКлиника.Следующий(), ВыборкаКлиника.Ссылка, Неопределено);

	Если Клиника = Неопределено Или Клиент = Неопределено Тогда
		//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Предупреждение, , ,
			//"Не удалось определить Клинику/Клиента. Источник=" + Источник
			//+ ", medcenterId=" + medcenterId + ", ИИН=" + ИИН + ", BookingId=" + Строка(BookingId));
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Неопределено;
	КонецЕсли;

	// --- Резолвинг врача по каждому слоту -----------------------------------------
	МассивСлотов = Новый Массив; // структуры {Врач, ServiceId, ДатаНачала, ДатаОкончания, SlotId}

	Для Каждого ИсхСлот Из ИсходныеСлоты Цикл

		Врач = НайтиВрачаПоDoctorId(?(ИсхСлот.Свойство("DoctorId"), ИсхСлот.DoctorId, ""), Источник);
		Если Врач = Неопределено Тогда
			//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Предупреждение, , ,
				//"Не найден врач по DoctorId. Источник=" + Источник + ", BookingId=" + Строка(BookingId));
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Неопределено;
		КонецЕсли;

		startAt    = ИсхСлот.ВремяНачала;
		endAt      = ИсхСлот.ВремяОкончания;
		ДатаПриема = ИсхСлот.Дата;

		СтрСлота = Новый Структура;
		СтрСлота.Вставить("Врач", Врач);
		СтрСлота.Вставить("ServiceId", ?(ИсхСлот.Свойство("ServiceId"), ИсхСлот.ServiceId, ""));
		СтрСлота.Вставить("ДатаНачала", НачалоДня(ДатаПриема) + (startAt - Дата(1, 1, 1)));
		СтрСлота.Вставить("ДатаОкончания", НачалоДня(ДатаПриема) + (endAt - Дата(1, 1, 1)));
		СтрСлота.Вставить("SlotId", ?(ИсхСлот.Свойство("SlotId"), ИсхСлот.SlotId, ""));

		МассивСлотов.Добавить(СтрСлота);

	КонецЦикла;

	Если ЭтоСоздание Тогда
		ДокЗаявка = Документы.Заявка.СоздатьДокумент();
		ДокЗаявка.Омг_bookingId = BookingId;
		ДокЗаявка.ИсточникБронирования = Источник;
	КонецЕсли;

	ДокЗаявка.Клиент             = Клиент;
	ДокЗаявка.Филиал             = Клиника;
	ДокЗаявка.Сотрудник          = МассивСлотов[0].Врач; // основной врач шапки - первый слот
	ДокЗаявка.НесколькоСотрудников = (МассивСлотов.Количество() > 1);

	Если ЗначениеЗаполнено(Комментарий) Тогда
		ДокЗаявка.Примечание = Комментарий;
	КонецЕсли;

	Если ЭтоСоздание Тогда
		ДокЗаявка.Состояние = Справочники.ВидыСостоянийЗаявок.СозданаНаСайте;
		ДокЗаявка.Дата = ТекущаяДата();
		ДокЗаявка.Проведен = Истина;
		ДокЗаявка.ПометкаУдаления = Ложь;
	КонецЕсли;

	// --- Формирование/обновление табличной части "Работы" -------------------------
	Если ЭтоСоздание Тогда

		ПостроитьРаботыЗаново(ДокЗаявка, МассивСлотов);

	Иначе

		// Определение режима: все переданные SlotId должны совпасть с уже
		// существующими строками - иначе трактуется как полная замена.
		РежимЧастичный = Истина;
		Для Каждого Слот Из МассивСлотов Цикл
			Если ПустаяСтрока(Слот.SlotId) Или НайтиСтрокуРаботПоSlotId(ДокЗаявка, Слот.SlotId) = Неопределено Тогда
				РежимЧастичный = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если РежимЧастичный Тогда

			Для Каждого Слот Из МассивСлотов Цикл
				СтрокаРаботы = НайтиСтрокуРаботПоSlotId(ДокЗаявка, Слот.SlotId);
				СтрокаРаботы.Сотрудник     = Слот.Врач;
				СтрокаРаботы.ДатаНачала    = Слот.ДатаНачала;
				СтрокаРаботы.ДатаОкончания = Слот.ДатаОкончания;
				СтрокаРаботы.Продолжительность = Дата(1, 1, 1) + (Слот.ДатаОкончания - Слот.ДатаНачала);
				Если ЗначениеЗаполнено(Слот.ServiceId) Тогда
					УслугаСсылка = НайтиУслугуПоServiceId(Слот.ServiceId);
					Если УслугаСсылка <> Неопределено Тогда
						СтрокаРаботы.Номенклатура = УслугаСсылка;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

		Иначе

			ПостроитьРаботыЗаново(ДокЗаявка, МассивСлотов);

		КонецЕсли;

	КонецЕсли;

	// --- Реквизиты шапки: минимум/максимум по итоговому составу строк -------------
	МинНачало = Неопределено;
	МаксОкончание = Неопределено;
	Для Каждого СтрРаб Из ДокЗаявка.Работы Цикл
		Если МинНачало = Неопределено Или СтрРаб.ДатаНачала < МинНачало Тогда
			МинНачало = СтрРаб.ДатаНачала;
		КонецЕсли;
		Если МаксОкончание = Неопределено Или СтрРаб.ДатаОкончания > МаксОкончание Тогда
			МаксОкончание = СтрРаб.ДатаОкончания;
		КонецЕсли;
	КонецЦикла;

	Если МинНачало <> Неопределено Тогда
		ДокЗаявка.ДатаНачала     = МинНачало;
		ДокЗаявка.ВремяНачала    = Дата(1, 1, 1) + (МинНачало - НачалоДня(МинНачало));
		ДокЗаявка.ДатаОкончания  = МаксОкончание;
		ДокЗаявка.ВремяОкончания = Дата(1, 1, 1) + (МаксОкончание - НачалоДня(МаксОкончание));
	КонецЕсли;

	// --- Врачи, затронутые изменением, для актуализации расписания ----------------
	МассивВрачейДляОтправки = Новый Массив;
	Для Каждого Слот Из МассивСлотов Цикл
		Если МассивВрачейДляОтправки.Найти(Слот.Врач) = Неопределено Тогда
			МассивВрачейДляОтправки.Добавить(Слот.Врач);
		КонецЕсли;
	КонецЦикла;

	// Тот же маркер источника, что и в ветке cancelled (см. выше) - нужен
	// подписке омг_ПриЗаписиЗаявки, чтобы не уведомлять партнёра о переносе,
	// который он сам и инициировал этим же запросом (rebooked от iDoctor).
	ДокЗаявка.ДополнительныеСвойства.Вставить("омг_ПартнёрИнициатор", Источник);

	Попытка
		ДокЗаявка.Записать(РежимЗаписиДокумента.Проведение);
		ОтправитьРасписаниеНаСервере(, ДокЗаявка.Филиал, ДокЗаявка.ДатаНачала, МассивВрачейДляОтправки);
	Исключение
		//ЗаписьЖурналаРегистрации("омг_Idoctor.ОбработатьБронирование", УровеньЖурналаРегистрации.Ошибка, , ,
			//"Ошибка записи заявки (Источник=" + Источник + ", BookingId=" + Строка(BookingId) + "): " + ОписаниеОшибки());
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Неопределено;
	КонецПопытки;

	РезультатСлоты = СобратьСлотыИзРабот(ДокЗаявка);

	УстановитьПривилегированныйРежим(Ложь);
	Возврат Новый Структура("GUID,Слоты", Строка(ДокЗаявка.Ссылка.УникальныйИдентификатор()), РезультатСлоты);

КонецФункции

// Формирует табличную часть "Работы" заново из массива слотов (используется
// при создании и при полной замене состава пакета). Каждой строке
// присваивается новый порядковый идентификатор омг_SlotId.
&НаСервере
Процедура ПостроитьРаботыЗаново(ДокЗаявка, МассивСлотов)

	ДокЗаявка.Работы.Очистить();

	Для Инд = 0 По МассивСлотов.Количество() - 1 Цикл

		Слот = МассивСлотов[Инд];

		СтрРаботы = ДокЗаявка.Работы.Добавить();
		СтрРаботы.Сотрудник          = Слот.Врач;
		СтрРаботы.ДатаНачала         = Слот.ДатаНачала;
		СтрРаботы.ДатаОкончания      = Слот.ДатаОкончания;
		СтрРаботы.Продолжительность  = Дата(1, 1, 1) + (Слот.ДатаОкончания - Слот.ДатаНачала);
		СтрРаботы.Количество         = 1;
		СтрРаботы.омг_SlotId         = Строка(Инд + 1);

		Если ЗначениеЗаполнено(Слот.ServiceId) Тогда
			УслугаСсылка = НайтиУслугуПоServiceId(Слот.ServiceId);
			Если УслугаСсылка <> Неопределено Тогда
				СтрРаботы.Номенклатура = УслугаСсылка;
			Иначе
				//ЗаписьЖурналаРегистрации("омг_Idoctor.ПостроитьРаботыЗаново", УровеньЖурналаРегистрации.Предупреждение, , ,
					//"Услуга с ServiceId=" + Строка(Слот.ServiceId) + " не найдена.");
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Поиск строки табличной части "Работы" по идентификатору слота.
&НаСервере
Функция НайтиСтрокуРаботПоSlotId(ДокЗаявка, SlotId)

	Для Каждого СтрРаб Из ДокЗаявка.Работы Цикл
		Если СтрРаб.омг_SlotId = SlotId Тогда
			Возврат СтрРаб;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Формирует массив {"slotId"} по всем строкам итогового состава заявки -
// используется в ответе на created/rebooked и при идемпотентном повторе.
// Регистр ключа ("slotId", не "SlotId") согласован с ответом GETAPPOINTMENTS
// и с документацией для партнёров (05.09.2026 - исправлено расхождение,
// найденное при тестировании: created/rebooked отдавали "SlotId").
&НаСервере
Функция СобратьСлотыИзРабот(ДокЗаявка) Экспорт

	Результат = Новый Массив;

	Для Каждого СтрРаб Из ДокЗаявка.Работы Цикл
		Результат.Добавить(Новый Структура("slotId", СтрРаб.омг_SlotId));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поиск сотрудника по внешнему идентификатору - используется отдельно на
// каждый слот (в отличие от резолвинга клиента/клиники, общего на заявку).
//
// Источник определяет, по какому идентификатору вести поиск:
//   "idoctor" - по реквизиту Сотрудники.омг_idoctorId (значение присваивается
//               вручную, источник идентификатора - сам iDoctor);
//   любой другой источник ("jazyl" и последующие партнёры "нашего формата") -
//               по регистру сведений омг_ВнешнийIdВрачаНашФормат (значение
//               генерируется автоматически, общее для всех таких партнёров -
//               см. Алгоритм_генерации_ID_врачей.md, раздел 1, обоснование).
&НаСервере
Функция НайтиВрачаПоDoctorId(doctorId, Источник) Экспорт

	Если Не ЗначениеЗаполнено(doctorId) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;

	Если НРЕГ(Источник) = "idoctor" Тогда

		Запрос.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.омг_idoctorId = &doctorId";
		Запрос.УстановитьПараметр("doctorId", doctorId);

	Иначе

		Запрос.Текст =
		"ВЫБРАТЬ
		|	омг_ВнешнийIdВрачаНашФормат.Сотрудник КАК Ссылка
		|ИЗ
		|	РегистрСведений.омг_ВнешнийIdВрачаНашФормат КАК омг_ВнешнийIdВрачаНашФормат
		|ГДЕ
		|	омг_ВнешнийIdВрачаНашФормат.Id = &doctorId";
		Запрос.УстановитьПараметр("doctorId", doctorId);

	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Составной ключ поиска - ИСПРАВЛЕНИЕ обоих обнаруженных багов сразу:
// не позволяет одному партнёру найти/задеть заявку другого партнёра
// с таким же bookingId.
&НаСервере
Функция НайтиЗаявкуПоКлючу(Источник, BookingId) Экспорт

	Если Не ЗначениеЗаполнено(BookingId) Или ПустаяСтрока(Источник) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|ГДЕ
	|	Заявка.Омг_bookingId = &BookingId
	|	И Заявка.ИсточникБронирования = &Источник";
	Запрос.УстановитьПараметр("BookingId", BookingId);
	Запрос.УстановитьПараметр("Источник", Источник);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция СоздатьКлиента(ИИН, Имя, Тел, ДатаРождения, Пол)

	Клиент = Справочники.Клиенты.СоздатьЭлемент();
	Клиент.ИНН = ИИН;

	Если ЗначениеЗаполнено(ДатаРождения) Тогда
		Клиент.ДатаРождения = ДатаРождения;
	КонецЕсли;

	Если ЗначениеЗаполнено(Пол) Тогда
		Клиент.Пол = ?(Пол = 2, Перечисления.ПолФизическихЛиц.Женский, Перечисления.ПолФизическихЛиц.Мужской);
	КонецЕсли;

	Если ЗначениеЗаполнено(ИИН) Тогда
		СедьмойСимволИИН = Сред(ИИН, 7, 1);
		ГодИИН   = Лев(ИИН, 2);
		МесяцИИН = Сред(ИИН, 3, 2);
		ДеньИИН  = Сред(ИИН, 5, 2);

		Если СедьмойСимволИИН = "3" Тогда
			Клиент.Пол = Перечисления.ПолФизическихЛиц.Мужской;
			Клиент.ДатаРождения = Дата("19" + ГодИИН, МесяцИИН, ДеньИИН);
		ИначеЕсли СедьмойСимволИИН = "4" Тогда
			Клиент.Пол = Перечисления.ПолФизическихЛиц.Женский;
			Клиент.ДатаРождения = Дата("19" + ГодИИН, МесяцИИН, ДеньИИН);
		ИначеЕсли СедьмойСимволИИН = "5" Тогда
			Клиент.Пол = Перечисления.ПолФизическихЛиц.Мужской;
			Клиент.ДатаРождения = Дата("20" + ГодИИН, МесяцИИН, ДеньИИН);
		ИначеЕсли СедьмойСимволИИН = "6" Тогда
			Клиент.Пол = Перечисления.ПолФизическихЛиц.Женский;
			Клиент.ДатаРождения = Дата("20" + ГодИИН, МесяцИИН, ДеньИИН);
		Иначе
			Если не ЗначениеЗаполнено(Клиент.Пол) Тогда
				ФИО = РазобратьФИО(Имя);
				Клиент.Пол = ОпределитьПолПоФИО(ФИО.Фамилия, ФИО.Имя, ФИО.Отчество);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Клиент.Наименование = Имя;
	ФИО = РазобратьФИО(Имя);
	Клиент.Фамилия  = ФИО.Фамилия;
	Клиент.Имя      = ФИО.Имя;
	Клиент.Отчество = ФИО.Отчество;
	Клиент.Комментарий = "idoctor";
	Клиент.ОбменДанными.Загрузка = Истина;
	Клиент.Записать();
	Клиент = Клиент.Ссылка;

	Если ЗначениеЗаполнено(Тел) Тогда
		ТелКлиента = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		ТелКлиента.Объект = Клиент;
		ТелКлиента.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
		ТелКлиента.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		ТелКлиента.Представление = Тел;
		ТелКлиента.Прочитать();

		Если не ТелКлиента.Выбран() Тогда
			ТелКлиента = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			ТелКлиента.Объект = Клиент;
			ТелКлиента.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
			ТелКлиента.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			ТелКлиента.Представление = Тел;
			ТелКлиента.Записать();
		КонецЕсли;
	КонецЕсли;

	Возврат Клиент;

КонецФункции

&НаСервере
Функция НайтиУслугуПоServiceId(ServiceId) Экспорт

	Если ПустаяСтрока(Строка(ServiceId)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// омг_idoctorId у Номенклатуры имеет тип Число(10) - тот же тип, что уже
	// используется у Сотрудники.омг_idoctorId и Филиалы.омг_idoctorId. ServiceId
	// может прийти от партнёра как число (обычный случай) ИЛИ как строка в
	// кавычках (если партнёр реализует JSON не строго) - приводим явно, чтобы
	// сравнение в запросе не сломалось при несовпадении типов параметра и реквизита.
	Попытка
		ServiceIdЧисло = Число(ServiceId);
	Исключение
		//ЗаписьЖурналаРегистрации("омг_Idoctor.НайтиУслугуПоServiceId", УровеньЖурналаРегистрации.Предупреждение, , ,
			//"Не удалось привести ServiceId к числу: " + Строка(ServiceId));
		Возврат Неопределено;
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.омг_idoctorId = &ServiceId
	|	И НЕ Номенклатура.Архив";
	Запрос.УстановитьПараметр("ServiceId", ServiceIdЧисло);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// -------------------------------------------------------------------------------
// Определение партнёра по ключу (X-Partner-Key) - используется универсальным
// адаптером "наш формат" (3_Адаптер_НашФормат.bsl) для ВСЕХ партнёров, кроме
// iDoctor (у него фиксированный отдельный протокол, ключ не требуется).
//
// Требуемое изменение метаданных: Справочник.ПартнёрыИнтеграции
//   Код            - Строка(20), значение поля Источник в заявках ("jazyl", ...)
//   СекретныйКлюч  - Строка(50), сверяется со значением заголовка X-Partner-Key
//   Активна        - Булево, флаг включения/отключения партнёра без удаления
//
// Подключение нового партнёра = добавить одну строку в этот справочник и
// выдать ему значение СекретныйКлюч. Никаких изменений в коде не требуется.
// -------------------------------------------------------------------------------
&НаСервере
Функция ОпределитьИсточникПоКлючу(КлючПартнёра) Экспорт

	Если ПустаяСтрока(КлючПартнёра) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПартнёрыИнтеграции.Код КАК Код
	|ИЗ
	|	Справочник.ПартнёрыИнтеграции КАК ПартнёрыИнтеграции
	|ГДЕ
	|	ПартнёрыИнтеграции.СекретныйКлюч = &КлючПартнёра
	|	И ПартнёрыИнтеграции.Активна";
	Запрос.УстановитьПараметр("КлючПартнёра", КлючПартнёра);

	Выборка = Запрос.Выполнить().Выбрать();

	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Код;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Приведение входного bookingId (может прийти из JSON как число или как строка
// в кавычках, в зависимости от того, насколько строго партнёр формирует JSON)
// к числовому типу - реквизит Заявка.Омг_bookingId имеет тип Число(15).
// Используется обоими адаптерами перед вызовом ОбработатьБронирование.
Функция ПривестиBookingIdКЧислу(ИсходноеЗначение) Экспорт

	Если ИсходноеЗначение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Число(ИсходноеЗначение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// ПЕРЕРАБОТАНО (24.08.2026): ночная пакетная отправка вместо построчного
// вызова на каждый документ "УстановкаГрафиковРаботы". Параметров больше
// нет - процедура сама читает всё, что накопилось в регистре
// омг_ИзмененияГрафиковРабот за день, группирует по филиалу и отправляет
// расписание одним вызовом на каждый филиал, затем удаляет из очереди
// только успешно обработанные документы. Подписка
// омг_ПриПроведенииУстановкиГрафиковРаботОбработкаПроведения (наполнение
// очереди) не изменилась - продолжает копить записи в течение дня.
Процедура омг_ОбновитьРасписаниеIDoctor() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	омг_ИзмененияГрафиковРабот.Сотрудник КАК Сотрудник,
	|	омг_ИзмененияГрафиковРабот.УстановкаГрафиковРабот КАК УстановкаГрафиковРабот,
	|	омг_ИзмененияГрафиковРабот.УстановкаГрафиковРабот.Филиал КАК Филиал
	|ИЗ
	|	РегистрСведений.омг_ИзмененияГрафиковРабот КАК омг_ИзмененияГрафиковРабот
	|
	|СГРУППИРОВАТЬ ПО
	|	омг_ИзмененияГрафиковРабот.Сотрудник,
	|	омг_ИзмененияГрафиковРабот.УстановкаГрафиковРабот,
	|	омг_ИзмененияГрафиковРабот.УстановкаГрафиковРабот.Филиал";

	Выборка = Запрос.Выполнить().Выбрать();

	СотрудникиПоФилиалам = Новый Соответствие; // Филиал -> Массив(Сотрудник)
	ДокументыПоФилиалам  = Новый Соответствие; // Филиал -> Массив(УстановкаГрафиковРабот)

	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.Филиал) Тогда
			Продолжить; // документ без филиала - пропускаем, отправлять некуда
		КонецЕсли;

		СписокСотрудников = СотрудникиПоФилиалам[Выборка.Филиал];
		Если СписокСотрудников = Неопределено Тогда
			СписокСотрудников = Новый Массив;
			СотрудникиПоФилиалам.Вставить(Выборка.Филиал, СписокСотрудников);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Сотрудник) И СписокСотрудников.Найти(Выборка.Сотрудник) = Неопределено Тогда
			СписокСотрудников.Добавить(Выборка.Сотрудник);
		КонецЕсли;

		СписокДокументов = ДокументыПоФилиалам[Выборка.Филиал];
		Если СписокДокументов = Неопределено Тогда
			СписокДокументов = Новый Массив;
			ДокументыПоФилиалам.Вставить(Выборка.Филиал, СписокДокументов);
		КонецЕсли;
		Если СписокДокументов.Найти(Выборка.УстановкаГрафиковРабот) = Неопределено Тогда
			СписокДокументов.Добавить(Выборка.УстановкаГрафиковРабот);
		КонецЕсли;

	КонецЦикла;

	Если СотрудникиПоФилиалам.Количество() = 0 Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат; // за день изменений не было
	КонецЕсли;

	ГраницаОтправки = ДобавитьМесяц(НачалоДня(ТекущаяДата()), 1);

	Для Каждого ЭлементФилиал Из СотрудникиПоФилиалам Цикл

		Филиал     = ЭлементФилиал.Ключ;
		Сотрудники = ЭлементФилиал.Значение;

		Попытка

			ОтправитьРасписаниеНаСервере(, Филиал, НачалоДня(ТекущаяДата()), Сотрудники, ГраницаОтправки);

			Для Каждого Документ Из ДокументыПоФилиалам[Филиал] Цикл
				Набор = РегистрыСведений.омг_ИзмененияГрафиковРабот.СоздатьНаборЗаписей();
				Набор.Отбор.УстановкаГрафиковРабот.Установить(Документ);
				Набор.Записать(); // пустой набор с отбором = удаление записей по документу
			КонецЦикла;

		Исключение
			// Записи этого филиала намеренно НЕ удаляются - попадут в
			// обработку на следующем ночном запуске.
			//ЗаписьЖурналаРегистрации(
				//"омг_Idoctor.омг_ОбновитьРасписаниеIDoctor", УровеньЖурналаРегистрации.Ошибка, , ,
				//"Ошибка отправки расписания для филиала " + Строка(Филиал) + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// ИЗМЕНЕНО (подход к отправке): раньше расписание при изменении графика
// уходило только ночью (пакетно, чтобы не нагружать систему при массовом
// вводе графиков). Требование изменилось - внешние партнёры должны видеть
// изменения расписания СРАЗУ. Решение: отправляем немедленно и точечно -
// именно по сотрудникам ЭТОГО документа (а не всей глобальной очереди
// сразу, как было бы при вызове омг_ОбновитьРасписаниеIDoctor() без
// параметров прямо здесь - это отправило бы вперемешку и чужие, ещё не
// готовые изменения из других документов, и заблокировало бы проведение
// на время HTTP-запросов ко ВСЕМ филиалам разом, а не только к этому).
//
// Очередь омг_ИзмененияГрафиковРабот при этом СОХРАНЕНА как подстраховка:
// если немедленная отправка не удалась (сеть, недоступность партнёра),
// запись остаётся в очереди и будет подхвачена ночным регламентным
// заданием омг_ОбновитьРасписаниеIDoctor - тем же принципом "мгновенная
// доставка + периодическая сверка на подстраховку", который использует
// сам iDoctor в своей документации (см. их "Сценарий 6").
Процедура омг_ПриПроведенииУстановкиГрафиковРаботОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Если не Отказ Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УстановкаГрафиковРаботыУчастники.Участник КАК Сотрудник,
		|	УстановкаГрафиковРаботыУчастники.Ссылка КАК УстановкаГрафиковРабот,
		|	&Период КАК Период,
		|	&Регистратор КАК Регистратор
		|ИЗ
		|	Документ.УстановкаГрафиковРаботы.Участники КАК УстановкаГрафиковРаботыУчастники
		|ГДЕ
		|	НЕ УстановкаГрафиковРаботыУчастники.Участник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|	И УстановкаГрафиковРаботыУчастники.Ссылка = &Ссылка
		|	И УстановкаГрафиковРаботыУчастники.Участник.омг_idoctorНеВыгружать = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаГрафиковРаботыУчастники.Ссылка,
		|	УстановкаГрафиковРаботыУчастники.Участник";

		Запрос.УстановитьПараметр("Период", Источник.Дата);
		Запрос.УстановитьПараметр("Регистратор", Источник.Ссылка);
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);

		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

		НаборЗаписей = РегистрыСведений.омг_ИзмененияГрафиковРабот.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.УстановкаГрафиковРабот.Установить(Источник.Ссылка);

		МассивЗатронутыхСотрудников = Новый Массив;

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Сотрудник) Тогда
				ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), ВыборкаДетальныеЗаписи);
				Если МассивЗатронутыхСотрудников.Найти(ВыборкаДетальныеЗаписи.Сотрудник) = Неопределено Тогда
					МассивЗатронутыхСотрудников.Добавить(ВыборкаДетальныеЗаписи.Сотрудник);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		НаборЗаписей.Записать(); // очередь на случай сбоя немедленной отправки ниже

		Если МассивЗатронутыхСотрудников.Количество() > 0 Тогда

			Попытка

				ОтправитьРасписаниеНаСервере(, Источник.Филиал, Источник.ПлДата, МассивЗатронутыхСотрудников,ДобавитьМесяц(Источник.ПлДата,1)-1);

				// Немедленная отправка прошла успешно - убираем ИМЕННО ЭТОТ
				// документ из очереди, чтобы ночное задание не отправило его
				// повторно (оно затронуло бы только этого сотрудника/дату,
				// но лучше не делать двойную работу без необходимости).
				НаборОчистки = РегистрыСведений.омг_ИзмененияГрафиковРабот.СоздатьНаборЗаписей();
				НаборОчистки.Отбор.УстановкаГрафиковРабот.Установить(Источник.Ссылка);
				НаборОчистки.Записать();

			Исключение
				// Немедленная отправка не удалась - запись НАМЕРЕННО остаётся
				// в очереди (см. НаборЗаписей.Записать() выше), подхватится
				// ночным регламентным заданием как подстраховка.
			КонецПопытки;

		КонецЕсли;

	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ПолучитьРасписание(Сотрудник = Неопределено, Филиал = Неопределено, Дата = Неопределено, Сотрудники = Неопределено, ДатаНачала = Неопределено, ДатаОкончания = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	МасВозвозврата = Новый Массив;

	Запрос = Новый Запрос;
	ТекстУсловия1 = "";
	ТекстУсловия2 = "";

	Если не Филиал = Неопределено Тогда
		ТекстУсловия1 = "
		|	И ГрафикиРаботы.Филиал = &Филиал
		|";
		ТекстУсловия2 = "
		|	И омг_ЗанятоеВремяЗаявок.Филиал = &Филиал
		|";
		Запрос.УстановитьПараметр("Филиал", Филиал);
	КонецЕсли;

	Если не Сотрудник = Неопределено Тогда
		ТекстУсловия1 = "
		|	И ГрафикиРаботы.Сотрудник = &Сотрудник
		|";
		ТекстУсловия2 = "
		|	И омг_ЗанятоеВремяЗаявок.Сотрудник = &Сотрудник
		|";
		Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	ИначеЕсли не Сотрудники = Неопределено Тогда
		ТекстУсловия1 = "
		|	И ГрафикиРаботы.Сотрудник в (&Сотрудники)
		|";
		ТекстУсловия2 = "
		|	И омг_ЗанятоеВремяЗаявок.Сотрудник в (&Сотрудники)
		|";
		Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
	КонецЕсли;

	Если ДатаНачала = Неопределено И ДатаОкончания = Неопределено Тогда
		Если Дата = Неопределено Тогда
			ДатаНачалаИ    = ТекущаяДата();
			ДатаОкончанияИ = ДобавитьМесяц(ДатаНачалаИ, 1);
		Иначе
			ДатаНачалаИ    = Дата;
			ДатаОкончанияИ = Дата;
		КонецЕсли
	Иначе
		ДатаНачалаИ    = ДатаНачала;
		ДатаОкончанияИ = ДатаОкончания;
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикиРаботы.Филиал КАК Филиал,
	|	ГрафикиРаботы.Филиал.Наименование КАК ФилиалНаименование,
	|	ГрафикиРаботы.Филиал.омг_idoctorId КАК ФилиалКод,
	|	ГрафикиРаботы.Сотрудник КАК Сотрудник,
	|	ГрафикиРаботы.Сотрудник.омг_idoctorId КАК СотрудникКод,
	|	ГрафикиРаботы.ВремяНачала КАК ВремяНачала,
	|	ГрафикиРаботы.ВремяОкончания КАК ВремяОкончания,
	|	ГрафикиРаботы.Дата КАК Дата,
	|	ГрафикиРаботы.Сотрудник.ДлительностьПриема КАК СотрудникДлительностьПриема,
	|	ГрафикиРаботы.Сотрудник.Имя КАК firstName,
	|	ГрафикиРаботы.Сотрудник.Фамилия КАК lastName,
	|	ГрафикиРаботы.Сотрудник.Отчество КАК patronymic,
	|	ГрафикиРаботы.Сотрудник.Наименование КАК fullName
	|ИЗ
	|	РегистрСведений.ГрафикиРаботы КАК ГрафикиРаботы
	|ГДЕ
	|	ГрафикиРаботы.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ГрафикиРаботы.ВидВремени = ЗНАЧЕНИЕ(Справочник.ВидыВремениГрафика.РабочееВремя)
	|	И НЕ ГрафикиРаботы.Сотрудник.омг_idoctorНеВыгружать
	|	И ГрафикиРаботы.Сотрудник.омг_idoctorId <> 0
	|"
	+ ТекстУсловия1 +
	"	СГРУППИРОВАТЬ ПО
	|	ГрафикиРаботы.Филиал,
	|	ГрафикиРаботы.Филиал.Наименование,
	|	ГрафикиРаботы.Сотрудник,
	|	ГрафикиРаботы.Дата,
	|	ГрафикиРаботы.Сотрудник.ДлительностьПриема,
	|	ГрафикиРаботы.ВремяНачала,
	|	ГрафикиРаботы.ВремяОкончания,
	|	ГрафикиРаботы.Филиал.омг_idoctorId,
	|	ГрафикиРаботы.Сотрудник.омг_idoctorId,
	|	ГрафикиРаботы.Сотрудник.Имя,
	|	ГрафикиРаботы.Сотрудник.Фамилия,
	|	ГрафикиРаботы.Сотрудник.Отчество,
	|	ГрафикиРаботы.Сотрудник.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	Филиал,
	|	Сотрудник,
	|	Дата
	|ИТОГИ ПО
	|	Филиал,
	|	Сотрудник,
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	омг_ЗанятоеВремяЗаявок.Сотрудник КАК Сотрудник,
	|	омг_ЗанятоеВремяЗаявок.ДатаНачала КАК ДатаНачала,
	|	омг_ЗанятоеВремяЗаявок.ДатаОкончания КАК ДатаОкончания,
	|	омг_ЗанятоеВремяЗаявок.Филиал КАК Филиал
	|ИЗ
	|	РегистрСведений.омг_ЗанятоеВремяЗаявок КАК омг_ЗанятоеВремяЗаявок
	|ГДЕ
	|	омг_ЗанятоеВремяЗаявок.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
	|"
	+ ТекстУсловия2;

	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачалаИ));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончанияИ));

	РезультатЗапроса = Запрос.ВыполнитьПакет();

	ТаблицаЗанятости = РезультатЗапроса[1].Выгрузить();

	ИндексЗанятости = Новый Соответствие;

	Для Каждого СтрокаЗанятости Из ТаблицаЗанятости Цикл
		Ключ = КлючЗанятости(СтрокаЗанятости.Сотрудник, СтрокаЗанятости.Филиал, СтрокаЗанятости.ДатаНачала);
		СписокИнтервалов = ИндексЗанятости[Ключ];
		Если СписокИнтервалов = Неопределено Тогда
			СписокИнтервалов = Новый Массив;
			ИндексЗанятости.Вставить(Ключ, СписокИнтервалов);
		КонецЕсли;
		СписокИнтервалов.Добавить(СтрокаЗанятости);
	КонецЦикла;

	ВыборкаФилиал = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаФилиал.Следующий() Цикл

		ВыборкаСотрудник = ВыборкаФилиал.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаСотрудник.Следующий() Цикл

			medcenter = Новый Структура("id,name", ВыборкаСотрудник.ФилиалКод, ВыборкаСотрудник.ФилиалНаименование);
			doctor = Новый Структура("id,firstName,lastName,patronymic,fullName", ВыборкаСотрудник.СотрудникКод, ВыборкаСотрудник.firstName, ВыборкаСотрудник.lastName, ВыборкаСотрудник.patronymic, ВыборкаСотрудник.fullName);

			schedules = Новый Массив;
			ДлительностьПриема = ?(ЗначениеЗаполнено(ВыборкаСотрудник.СотрудникДлительностьПриема), ВыборкаСотрудник.СотрудникДлительностьПриема - Дата(1, 1, 1), 30 * 60);

			ВыборкаДата = ВыборкаСотрудник.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

			Пока ВыборкаДата.Следующий() Цикл

				ВыборкаДетальныеЗаписи = ВыборкаДата.Выбрать();
				ТаблицаГрафика = Новый ТаблицаЗначений;
				ТаблицаГрафика.Колонки.Добавить("ДатаВремяНачалаСлот", Новый ОписаниеТипов("Дата"));
				ТаблицаГрафика.Колонки.Добавить("ДатаВремяОкончанияСлот", Новый ОписаниеТипов("Дата"));
				ТаблицаГрафика.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
				timeslots = Новый Массив;

				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

					ДатаВремяОкончанияСлот = Дата(1, 1, 1);
					ДатаВремяНачалаСлот = ВыборкаДетальныеЗаписи.Дата + (ВыборкаДетальныеЗаписи.ВремяНачала - Дата(1, 1, 1));
					ДатаВремяОкончанияСмены = ВыборкаДетальныеЗаписи.Дата + (ВыборкаДетальныеЗаписи.ВремяОкончания - Дата(1, 1, 1));

					Пока ДатаВремяОкончанияСмены > ДатаВремяОкончанияСлот Цикл
						ДатаВремяОкончанияСлот = ДатаВремяНачалаСлот + ДлительностьПриема;
						СтрокаТаблицаГрафика = ТаблицаГрафика.Добавить();
						СтрокаТаблицаГрафика.ДатаВремяНачалаСлот = ДатаВремяНачалаСлот;
						СтрокаТаблицаГрафика.ДатаВремяОкончанияСлот = ДатаВремяОкончанияСлот;
						СтрокаТаблицаГрафика.Сотрудник = ВыборкаДетальныеЗаписи.Сотрудник;
						ДатаВремяНачалаСлот = ДатаВремяОкончанияСлот;
					КонецЦикла;
				КонецЦикла;

				КлючТек = КлючЗанятости(ВыборкаСотрудник.Сотрудник, ВыборкаДата.Филиал, ВыборкаДата.Дата);
				СписокЗанятыхИнтервалов = ИндексЗанятости[КлючТек];
				Если СписокЗанятыхИнтервалов = Неопределено Тогда
					СписокЗанятыхИнтервалов = Новый Массив;
				КонецЕсли;

				Для Каждого строкаТаблицаГрафика Из ТаблицаГрафика Цикл

					timeslotsСтр = Новый Структура();
					timeslotsСтр.Вставить("startAt", "" + Формат(строкаТаблицаГрафика.ДатаВремяНачалаСлот, "ДФ='yyyy-MM-dd HH:mm:ss'"));
					timeslotsСтр.Вставить("endAt", "" + Формат(строкаТаблицаГрафика.ДатаВремяОкончанияСлот, "ДФ='yyyy-MM-dd HH:mm:ss'"));

					Свободно = Истина;

					Для Каждого Интервал Из СписокЗанятыхИнтервалов Цикл
						Если Интервал.ДатаНачала < строкаТаблицаГрафика.ДатаВремяОкончанияСлот
							И Интервал.ДатаОкончания > строкаТаблицаГрафика.ДатаВремяНачалаСлот Тогда
							Свободно = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;

					timeslotsСтр.Вставить("isAvailable", Свободно);
					timeslots.Добавить(timeslotsСтр);

				КонецЦикла;

				schedulesСтруктура = Новый Структура;
				schedulesСтруктура.Вставить("date", "" + Формат(ДатаВремяОкончанияСмены, "ДФ='yyyy-MM-dd'"));
				schedulesСтруктура.Вставить("timeslots", timeslots);
				schedules.Добавить(schedulesСтруктура);

			КонецЦикла;

			ДанныеОРасписании = Новый Структура("medcenter,doctor,cabinetName,schedules", medcenter, doctor, "", schedules);
			МасВозвозврата.Добавить(ДанныеОРасписании);

		КонецЦикла;
	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат МасВозвозврата;

КонецФункции

Функция КлючЗанятости(Сотрудник, Филиал, Дата)
	Возврат Строка(Сотрудник) + "_" + Строка(Филиал) + "_" + Формат(НачалоДня(Дата), "ДФ=yyyyMMdd");
КонецФункции

Функция ПолучитьФилиалПоID(ID) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Филиалы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Филиалы КАК Филиалы
		|ГДЕ
		|	Филиалы.омг_idoctorId = &ID";

	Запрос.УстановитьПараметр("ID", ID);

	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьСотрудниковПоID(МассивID) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.омг_idoctorId В(&МассивID)
		|
		|СГРУППИРОВАТЬ ПО
		|	Сотрудники.Ссылка";

	Запрос.УстановитьПараметр("МассивID", МассивID);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// -------------------------------------------------------------------------------
// Автогенерация внешнего ID врача для партнёров "нашего формата"
// (см. Алгоритм_генерации_ID_врачей.md). Не применяется к iDoctor - тот ID
// присваивается только вручную в реквизите Сотрудники.омг_idoctorId.
//
// Требуемая подписка на событие (создаётся в конфигураторе):
//   Источник: СправочникОбъект.Сотрудники
//   Событие:  ПриЗаписи
//   Обработчик: омг_Idoctor.омг_ПриЗаписиСотрудникаПриЗаписи
// -------------------------------------------------------------------------------
Процедура омг_ПриЗаписиСотрудникаПриЗаписи(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не Источник.ЭтоНовый() Тогда
		Возврат; // генерация выполняется один раз, при создании
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		// Блокировка без собственной НачатьТранзакцию() - процедура выполняется
		// внутри УЖЕ ОТКРЫТОЙ платформой транзакции события ПриЗаписи; вложенный
		// вызов НачатьТранзакцию()/ОтменитьТранзакцию() здесь приводит к ошибке
		// "Транзакция не активна" (платформа иногда сама завершает транзакцию
		// до попадания в блок Исключение). Управляемая блокировка при этом
		// работает штатно и без своей транзакции.
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.омг_ВнешнийIdВрачаНашФормат");
		ЭлементБлокировки.РежимБлокировки = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();

		// Существующая запись для этого сотрудника (защита от повторной
		// генерации при редких сценариях перезаписи нового элемента).
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	омг_ВнешнийIdВрачаНашФормат.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.омг_ВнешнийIdВрачаНашФормат КАК омг_ВнешнийIdВрачаНашФормат
		|ГДЕ
		|	омг_ВнешнийIdВрачаНашФормат.Сотрудник = &Сотрудник";
		Запрос.УстановитьПараметр("Сотрудник", Источник.Ссылка);

		Если Не Запрос.Выполнить().Пустой() Тогда
			УстановитьПривилегированныйРежим(Ложь);
			Возврат;
		КонецЕсли;

		// Следующее свободное значение - максимум по регистру + 1.
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(омг_ВнешнийIdВрачаНашФормат.Id) КАК МаксId
		|ИЗ
		|	РегистрСведений.омг_ВнешнийIdВрачаНашФормат КАК омг_ВнешнийIdВрачаНашФормат";

		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();

		НовыйId = ?(ЗначениеЗаполнено(Выборка.МаксId), Выборка.МаксId + 1, 1);

		НаборЗаписей = РегистрыСведений.омг_ВнешнийIdВрачаНашФормат.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Сотрудник.Установить(Источник.Ссылка);
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Сотрудник = Источник.Ссылка;
		НоваяЗапись.Id = НовыйId;
		НаборЗаписей.Записать();

	Исключение
		//ЗаписьЖурналаРегистрации("омг_Idoctor.омг_ПриЗаписиСотрудникаПриЗаписи", УровеньЖурналаРегистрации.Ошибка, , ,
			//"Не удалось сгенерировать внешний ID для сотрудника: " + ОписаниеОшибки());
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ОтветJSON(КодСтатуса, Данные) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТелоJSON = ЗаписьJSON.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСтатуса);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТелоJSON, "UTF-8");

	Возврат Ответ;

КонецФункции

Функция ПолучитьПараметрыОбменаДаннымиСВнешнимиСистемами(Филиал) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация КАК Синхронизация,
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация.Сервер КАК СинхронизацияСервер,
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация.Порт КАК СинхронизацияПорт,
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация.Пользователь КАК СинхронизацияПользователь,
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация.Пароль КАК СинхронизацияПароль,
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация.Таймаут КАК СинхронизацияТаймаут,
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация.ИспользоватьАутентификациюОС КАК СинхронизацияИспользоватьАутентификациюОС,
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация.ЭндПоинт КАК СинхронизацияЭндПоинт
		|ИЗ
		|	РегистрСведений.ПараметрыСинхронизацииСВнешнимиСистемами КАК ПараметрыСинхронизацииСВнешнимиСистемами
		|ГДЕ
		|	ПараметрыСинхронизацииСВнешнимиСистемами.Филиал = &Филиал
		|	И ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация <> ЗНАЧЕНИЕ(Справочник.СинхронизацияРасписанияСВнешнимиСистемами.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Синхронизация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СинхронизацияРасписанияСВнешнимиСистемамиЗаголовки.Ссылка КАК Ссылка,
		|	СинхронизацияРасписанияСВнешнимиСистемамиЗаголовки.Ключ КАК Ключ,
		|	СинхронизацияРасписанияСВнешнимиСистемамиЗаголовки.Значение КАК Значение
		|ИЗ
		|	Справочник.СинхронизацияРасписанияСВнешнимиСистемами.Заголовки КАК СинхронизацияРасписанияСВнешнимиСистемамиЗаголовки
		|ГДЕ
		|	СинхронизацияРасписанияСВнешнимиСистемамиЗаголовки.Ссылка В
		|		(ВЫБРАТЬ
		|			ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация
		|		ИЗ
		|			РегистрСведений.ПараметрыСинхронизацииСВнешнимиСистемами КАК ПараметрыСинхронизацииСВнешнимиСистемами
		|		ГДЕ
		|			ПараметрыСинхронизацииСВнешнимиСистемами.Филиал = &Филиал
		|			И ПараметрыСинхронизацииСВнешнимиСистемами.Синхронизация <> ЗНАЧЕНИЕ(Справочник.СинхронизацияРасписанияСВнешнимиСистемами.ПустаяСсылка))";

	Запрос.УстановитьПараметр("Филиал", Филиал);

	РезультатЗапроса = Запрос.ВыполнитьПакет();

	Возврат Новый Структура("Синхронизации,Ключи", РезультатЗапроса[0].Выгрузить(), РезультатЗапроса[1].Выгрузить());

КонецФункции

// =====================================================================================
// ОБРАТНЫЙ КАНАЛ К iDoctor (реализация B2/B3 из их официального API, добавлено
// 05.09.2026 по итогам получения актуальной документации).
//
// НАЗНАЧЕНИЕ: если заявка, изначально пришедшая ОТ iDoctor (ИсточникБронирования
// = "idoctor"), отменяется или переносится ВРУЧНУЮ в 1С (регистратурой, через
// обычную форму документа) - iDoctor должен об этом узнать через их собственные
// эндпоинты POST /booking/{id}/cancel и POST /booking/{id}/rebook, иначе
// пациент продолжит видеть у себя актуальной уже несуществующую запись.
//
// ЗАЩИТА ОТ ПЕТЛИ: если отмена/перенос пришли ОТ САМОГО iDoctor через входящий
// вебхук (обработка в ОбработатьБронирование), в документ проставляется маркер
// ДополнительныеСвойства.омг_ПартнёрИнициатор = "idoctor" перед записью. Вызов
// функций ниже должен ПРЕДВАРЯТЬСЯ проверкой этого маркера на стороне вызывающего
// кода (см. 4_Подписка_омг_ПриЗаписиЗаявки.bsl) - если маркер установлен и равен
// "idoctor", уведомлять iDoctor обратно не нужно (они и так знают о своём же
// действии).
//
// БАЗОВЫЙ URL: "/mis-api/v2" - зафиксированное значение из официальной
// документации iDoctor (см. partner-api-ru.md, раздел "Адреса"). Используются
// те же Сервер/Порт/аутентификация/заголовки, что уже настроены в справочнике
// СинхронизацияРасписанияСВнешнимиСистемами для отправки расписания (B1) -
// дополнительной настройки в справочниках не требуется, если там уже заведены
// заголовки X-Integration-Key/X-Integration-Auth-Key.
// =====================================================================================

// B2. Уведомление iDoctor об отмене записи, инициированной в 1С.
Процедура омг_ОтправитьОтменуIDoctor(ДокЗаявка, ПричинаТекст = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если Не ЗначениеЗаполнено(ДокЗаявка.Филиал) Или ДокЗаявка.Омг_bookingId = 0 Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;

	Попытка

		ПараметрыОбмена = ПолучитьПараметрыОбменаДаннымиСВнешнимиСистемами(ДокЗаявка.Филиал);

		Для Каждого СтрокаСинхронизации Из ПараметрыОбмена.Синхронизации Цикл

			Данные = Новый Структура("reason", ?(ЗначениеЗаполнено(ПричинаТекст), ПричинаТекст, "Отменено в МИС"));
			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, Данные);
			ТелоЗапроса = ЗаписьJSON.Закрыть();

			ПортСоединения = ?(СтрокаСинхронизации.СинхронизацияПорт = 0, Неопределено, СтрокаСинхронизации.СинхронизацияПорт);
			ПользовательСоединения = ?(ПустаяСтрока(СтрокаСинхронизации.СинхронизацияПользователь), Неопределено, СтрокаСинхронизации.СинхронизацияПользователь);
			ПарольСоединения       = ?(ПользовательСоединения = Неопределено, Неопределено, СтрокаСинхронизации.СинхронизацияПароль);

			Соединение = Новый HTTPСоединение(
				СтрокаСинхронизации.СинхронизацияСервер, ПортСоединения,
				ПользовательСоединения, ПарольСоединения, ,
				СтрокаСинхронизации.СинхронизацияТаймаут, Новый ЗащищенноеСоединениеOpenSSL(),
				СтрокаСинхронизации.СинхронизацияИспользоватьАутентификациюОС);

			Запрос = Новый HTTPЗапрос("/mis-api/v2/booking/" + Строка(ДокЗаявка.Омг_bookingId) + "/cancel");
			Запрос.Заголовки.Вставить("Content-Type", "application/json");

			НайденныеКлючи = ПараметрыОбмена.Ключи.НайтиСтроки(Новый Структура("Ссылка", СтрокаСинхронизации.Синхронизация));
			Для Каждого СтрокаКлюча Из НайденныеКлючи Цикл
				Запрос.Заголовки.Вставить(СтрокаКлюча.Ключ, СтрокаКлюча.Значение);
			КонецЦикла;

			Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8");

			Попытка
				Ответ = Соединение.ОтправитьДляОбработки(Запрос);
				Если Ответ.КодСостояния >= 300 Тогда
					//ЗаписьЖурналаРегистрации("омг_Idoctor.омг_ОтправитьОтменуIDoctor", УровеньЖурналаРегистрации.Предупреждение, , ,
					//	"Код ответа " + Ответ.КодСостояния + " при отмене bookingId=" + Строка(ДокЗаявка.Омг_bookingId)
					//	+ ". Тело: " + Ответ.ПолучитьТелоКакСтроку());
				КонецЕсли;
			Исключение
				//ЗаписьЖурналаРегистрации("омг_Idoctor.омг_ОтправитьОтменуIDoctor", УровеньЖурналаРегистрации.Ошибка, , ,
				//	"Ошибка отправки отмены bookingId=" + Строка(ДокЗаявка.Омг_bookingId) + ": " + ОписаниеОшибки());
			КонецПопытки;

		КонецЦикла;

	Исключение
		//ЗаписьЖурналаРегистрации("омг_Idoctor.омг_ОтправитьОтменуIDoctor", УровеньЖурналаРегистрации.Ошибка, , ,
		//	"Общая ошибка подготовки отмены bookingId=" + Строка(ДокЗаявка.Омг_bookingId) + ": " + ОписаниеОшибки());
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// B3. Уведомление iDoctor о переносе записи, инициированном в 1С.
// ВАЖНО (ограничение самого iDoctor, не наше): целевой слот должен УЖЕ
// существовать у того же врача в их расписании и быть свободным - то есть
// расписание (B1) должно быть отправлено ДО вызова этой процедуры, иначе

Процедура ОбменСGoogleРегистрацияЗаявкиПриЗаписи(Источник, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если Константы.ИспользоватьОбменСКалендаремGoogle.Получить() Тогда
		
		ТЗРаботы =  Источник.Работы.Выгрузить(,"Сотрудник, Номенклатура, ДатаНачала, ДатаОкончания");
		// Заменим незаполненного сотрудника сотрудником из шапки
		ПустыеСотрудники = ТЗРаботы.НайтиСтроки(Новый Структура("Сотрудник",Справочники.Сотрудники.ПустаяСсылка()));
		Для каждого СтрокаПустойСотрудник из ПустыеСотрудники Цикл
			СтрокаПустойСотрудник.Сотрудник = Источник.Сотрудник;
		КонецЦикла;
		
		МсСотрудника = Новый Массив;
		ОбщегоНазначения.ЗаполнитьМассивУникальнымиЗначениями(МсСотрудника,ТЗРаботы.ВыгрузитьКолонку("Сотрудник"));
		
		ТЗВремяСотрудников = Источник.Работы.ВыгрузитьКолонки("Сотрудник, ДатаНачала, ДатаОкончания");
		Для каждого СтрокаВремениРабот из ТЗРаботы Цикл
			СтрокаТЗКонечная = ТЗВремяСотрудников.Найти(СтрокаВремениРабот.Сотрудник,"Сотрудник");
			Если СтрокаТЗКонечная = Неопределено Тогда
				СтрокаТЗКонечная = ТЗВремяСотрудников.Добавить();
				СтрокаТЗКонечная.Сотрудник = СтрокаВремениРабот.Сотрудник;				
			КонецЕсли;
			СтрокаТЗКонечная.ДатаНачала = ?(ЗначениеЗаполнено(СтрокаТЗКонечная.ДатаНачала), СтрокаТЗКонечная.ДатаНачала, СтрокаВремениРабот.ДатаНачала);
			СтрокаТЗКонечная.ДатаОкончания = СтрокаВремениРабот.ДатаОкончания;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗаписиКалендаряСотрудника.Ссылка,
		|	ЗаписиКалендаряСотрудника.Календарь
		|ИЗ
		|	Справочник.ЗаписиКалендаряСотрудника КАК ЗаписиКалендаряСотрудника
		|ГДЕ
		|	ЗаписиКалендаряСотрудника.Источник = &Заявка";
		
		Запрос.УстановитьПараметр("Заявка", Источник.Ссылка); 
		РезультатЗаписи = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ЗаписьКалендаля Из РезультатЗаписи Цикл
			
			ЗаписьОбъект = ЗаписьКалендаля.Ссылка.ПолучитьОбъект();
			ЗаписьОбъект.УдаленаОтменена = Истина;
			ЗаписьОбъект.Записать();
			
		КонецЦикла;
			 
		Для Каждого СтрокаСотрудникВремя Из ТЗВремяСотрудников Цикл
			
			// Смотрим есть ли календари у сотрудников
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	КалендариСотрудников.Ссылка
			|ИЗ
			|	Справочник.КалендариСотрудников КАК КалендариСотрудников
			|ГДЕ
			|	КалендариСотрудников.ВладелецКалендаря = &ВладелецКалендаря
			|	И КалендариСотрудников.СинхронизироватьСGoogle = ИСТИНА
			|	И НЕ КалендариСотрудников.ПометкаУдаления";
			
			Запрос.УстановитьПараметр("ВладелецКалендаря", СтрокаСотрудникВремя.Сотрудник); 
			Результат = Запрос.Выполнить().Выгрузить();
			
			Если Результат.Количество() = 0 Тогда 
				Продолжить;
			КонецЕсли;
						
			Для Каждого Элем Из Результат Цикл 
				СтруктураОтбора = Новый Структура("Календарь", Элем.Ссылка);
				Найд = РезультатЗаписи.НайтиСтроки(СтруктураОтбора);
				
				Если Найд.Количество() > 0 Тогда 
					врОбъект = Найд[0].Ссылка.ПолучитьОбъект();
					Если врОбъект.ПометкаУдаления Тогда 
						врОбъект.ПометкаУдаления = Ложь;
					КонецЕсли;
				Иначе 
					врОбъект = Справочники.ЗаписиКалендаряСотрудника.СоздатьЭлемент();
				КонецЕсли;
				
				врОбъект.Наименование = ОбменСGoogleПереопределяемый.ПолучитьНаименованиеСобытия(Источник.Ссылка, СтрокаСотрудникВремя.Сотрудник, ТЗРаботы);
				
				врОбъект.Источник = Источник.Ссылка;
				врОбъект.Календарь = Элем.Ссылка;
				врОбъект.Начало = СтрокаСотрудникВремя.ДатаНачала;
				врОбъект.Окончание = СтрокаСотрудникВремя.ДатаОкончания;
				врОбъект.МестоПроведения = ОбменСGoogleПереопределяемый.ПолучитьМестоСобытия(Источник.Ссылка);
				
				Если Источник.Ссылка.Работы.Количество() > 0 Тогда 
					врОбъект.Описание = ОбменСGoogleПереопределяемый.ПолучитьОписаниеСобытия(Источник.Ссылка, СтрокаСотрудникВремя.Сотрудник, ТЗРаботы);
				КонецЕсли;
				Если Источник.Ссылка.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена Или Источник.Ссылка.ПометкаУдаления Тогда
					врОбъект.УдаленаОтменена = Истина;
				Иначе
					врОбъект.УдаленаОтменена = Ложь;
				КонецЕсли;
				Основание = Источник.Основание;		
				
				Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЛистОжидания") и ЗначениеЗаполнено(Основание.GoogleIDСобытия) и Основание.GoogleКалендарьИмпорта = врОбъект.Календарь Тогда
					врОбъект.Идентификатор = Основание.GoogleIDСобытия;
				КонецЕсли;
				
				Попытка
					врОбъект.Записать();
				Исключение
					ЗаписьЖурналаРегистрации("Создание записи календаря сотрудника", , Источник.Ссылка, ОписаниеОшибки());
				КонецПопытки;
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура СоздатьЛистОжиданияНаОсновеЗаписиКалендаря(ЗаписьКалендаря)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ЗаписьКалендаря.РезультатНовойЗаписи) Тогда
		ЛистОжидания = ЗаписьКалендаря.РезультатНовойЗаписи.ПолучитьОбъект();
		ЛистОжидания.ЖелаемоеВремя.Очистить();
	Иначе
		ЛистОжидания = Документы.ЛистОжидания.СоздатьДокумент();
		ЛистОжидания.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ВладелецКалендаря = ЗаписьКалендаря.Календарь.ВладелецКалендаря;
	ЛистОжидания.GoogleIDСобытия = ЗаписьКалендаря.Идентификатор;
	ЛистОжидания.GoogleКалендарьИмпорта = ЗаписьКалендаря.Календарь; 
	ЛистОжидания.Примечание = ЗаписьКалендаря.Наименование + Символы.ПС 
							+ ЗаписьКалендаря.МестоПроведения + Символы.ПС 
							+ ЗаписьКалендаря.Описание + Символы.ПС
							+ "С " + Строка(ЗаписьКалендаря.Начало) + " До " + Строка(ЗаписьКалендаря.Окончание) + Символы.ПС
							+ "Импортировано из Google-календаря сотрудника " 
							+ СтрШаблон("%1 %2.%3.",ВладелецКалендаря.Фамилия,Лев(ВладелецКалендаря.Имя,1),Лев(ВладелецКалендаря.Отчество,1));
	ЛистОжидания.Сотрудник = ВладелецКалендаря;
	ЛистОжидания.Выполнен = Ложь;
	ЛистОжидания.ПометкаУдаления = Ложь;
	
	ЛистОжидания.ДатаНачалаПлан = ЗаписьКалендаря.Начало;
	ЛистОжидания.ДатаОкончанияПлан = ЗаписьКалендаря.Окончание;
	Стр = ЛистОжидания.ЖелаемоеВремя.Добавить();
	Стр.Дата = ЗаписьКалендаря.Начало;
	Стр.Начало = ЗаписьКалендаря.Начало;
	Стр.Окончание = ЗаписьКалендаря.Окончание;
	
	ЛистОжидания.Записать();
	
	Если Не ЗначениеЗаполнено(ЗаписьКалендаря.РезультатНовойЗаписи) Тогда
		ЗаписьКалендаряОбъект = ЗаписьКалендаря.ПолучитьОбъект();
		ЗаписьКалендаряОбъект.РезультатНовойЗаписи = ЛистОжидания.Ссылка;
		ЗаписьКалендаряОбъект.Записать();
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.НепросмотренныеДокументыССайта.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = ЛистОжидания.Ссылка;
	МенеджерЗаписи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПолучитьИДПоследнегоПриложения() Экспорт
	
	ИдентификацияКлиента = РегистрыСведений.СеансовыеДанныеGoogle.ПолучитьМакет("client_secret_json").ПолучитьТекст();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ИдентификацияКлиента);
	
	РезультатЧтенияJSON = ПрочитатьJSON(ЧтениеJSON);
	
	ИД = РезультатЧтенияJSON.Количество() - 1;
	
	Возврат ИД; 
		
КонецФункции

Функция ИдПриложенияДляНовойСинхронизации() Экспорт
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриложенияGoogle.ИдентификаторПриложения КАК ИдентификаторПриложения
	               |ИЗ
	               |	РегистрСведений.ПриложенияGoogle КАК ПриложенияGoogle
	               |ГДЕ
	               |	ПриложенияGoogle.Используется
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИдентификаторПриложения УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторПриложения;	
	КонецЕсли; 
	
	ПараметрыПриложенийGoogle = РегистрыСведений.СеансовыеДанныеGoogle.ПолучитьМакет("client_secret_json");
	Возврат ПараметрыПриложенийGoogle.КоличествоСтрок() - 1;
	
КонецФункции



Процедура Омг_СобратьУслуги(Страховые = Истина) Экспорт
		
	Запрос = Новый Запрос; 
	УсловиеСтраховые = ""; 
	ТекДата = НачалоДня(ТекущаяДата()); 
	
	Запрос.Текст = "ВЫБРАТЬ
	|	РеестрОказанныхУслугПоСоглашениям.Ссылка КАК Ссылка,
	|	РеестрОказанныхУслугПоСоглашениям.НачалоПериода КАК НачалоПериода,
	|	РеестрОказанныхУслугПоСоглашениям.КонецПериода КАК КонецПериода,
	|	РеестрОказанныхУслугПоСоглашениям.Филиал КАК Филиал,
	|	РеестрОказанныхУслугПоСоглашениям.Контрагент КАК Контрагент,
	|	РеестрОказанныхУслугПоСоглашениям.Соглашение КАК Соглашение
	|ИЗ
	|	Документ.РеестрОказанныхУслугПоСоглашениям КАК РеестрОказанныхУслугПоСоглашениям
	|ГДЕ
	|	РеестрОказанныхУслугПоСоглашениям.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И РеестрОказанныхУслугПоСоглашениям.ПометкаУдаления = ЛОЖЬ
	|	И РеестрОказанныхУслугПоСоглашениям.омг_АвтоСтраховые = &омг_АвтоСтраховые
	|
	|СГРУППИРОВАТЬ ПО
	|	РеестрОказанныхУслугПоСоглашениям.Ссылка, 
	|	РеестрОказанныхУслугПоСоглашениям.НачалоПериода,
	|	РеестрОказанныхУслугПоСоглашениям.КонецПериода,
	|	РеестрОказанныхУслугПоСоглашениям.Филиал,
	|	РеестрОказанныхУслугПоСоглашениям.Контрагент,
	|	РеестрОказанныхУслугПоСоглашениям.Соглашение
	|	УПОРЯДОЧИТЬ ПО
	|	Филиал,
	|	НачалоПериода";  
	
	Если Страховые Тогда
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоМесяца(ТекДата)));
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецМесяца(ТекДата)));
		
	иначе
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ТекДата));
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТекДата));
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("омг_АвтоСтраховые", Страховые);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРеестры = РезультатЗапроса.Выбрать();   
	
	Если Страховые Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОказаниеУслуг.омг_СтраховаяПрограмма.Владелец КАК омг_СтраховаяПрограммаВладелец, 
		|	ОказаниеУслуг.Филиал КАК Филиал,
		|	НАЧАЛОПЕРИОДА(ОказаниеУслуг.Дата, МЕСЯЦ) КАК Дата,
		|	ОказаниеУслуг.омг_СтраховаяПрограмма КАК омг_СтраховаяПрограмма
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.Дата >= &НачалоМесяца
		|	И ОказаниеУслуг.омг_СтраховаяПрограмма <> Значение(Справочник.СоглашенияСтрахования.ПустаяСсылка)
		|	И ОказаниеУслуг.Дата <= &КонецМесяца
		|	И ОказаниеУслуг.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	ОказаниеУслуг.омг_СтраховаяПрограмма,
		|	ОказаниеУслуг.омг_СтраховаяПрограмма.Владелец,
		|	ОказаниеУслуг.Филиал,
		|	НАЧАЛОПЕРИОДА(ОказаниеУслуг.Дата, МЕСЯЦ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Филиал,
		|	омг_СтраховаяПрограммаВладелец,
		|	омг_СтраховаяПрограмма";
		
		Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ТекДата));
		Запрос.УстановитьПараметр("КонецМесяца",КонецМесяца(ТекДата));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СслкаДокумент = Неопределено;	
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("НачалоПериода",НачалоДня(ВыборкаДетальныеЗаписи.Дата));
			СтрПоиска.Вставить("Филиал",ВыборкаДетальныеЗаписи.Филиал);
			СтрПоиска.Вставить("Соглашение",ВыборкаДетальныеЗаписи.омг_СтраховаяПрограмма);
			ВыборкаРеестры.Сбросить();
			Если ВыборкаРеестры.НайтиСледующий(СтрПоиска) Тогда	
				СслкаДокумент = ВыборкаРеестры.Ссылка
			КонецЕсли;
			
			ЗаполнитьДокумент(ВыборкаДетальныеЗаписи.Филиал,ВыборкаДетальныеЗаписи.Дата,СслкаДокумент,ВыборкаДетальныеЗаписи.омг_СтраховаяПрограмма,ВыборкаДетальныеЗаписи.омг_СтраховаяПрограммаВладелец); 
		КонецЦикла;
		
	иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Филиалы.Ссылка КАК Филиал
		|ИЗ
		|	Справочник.Филиалы КАК Филиалы
		|
		|СГРУППИРОВАТЬ ПО
		|	Филиалы.Ссылка";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
			
			ПервыйДень = ТекДата;
			Сч = Ложь;	
			Пока НачалоДня(ПервыйДень) <= НачалоДня(ТекДата) Цикл
				СслкаДокумент = Неопределено;	
				СтрПоиска = Новый Структура;
				СтрПоиска.Вставить("НачалоПериода",НачалоДня(ПервыйДень));
				СтрПоиска.Вставить("Филиал",ВыборкаДетальныеЗаписи.Филиал); 
				ВыборкаРеестры.Сбросить();
				Если ВыборкаРеестры.НайтиСледующий(СтрПоиска) Тогда	
					СслкаДокумент = ВыборкаРеестры.Ссылка
				КонецЕсли;
				
				ЗаполнитьДокумент(ВыборкаДетальныеЗаписи.Филиал,ПервыйДень,СслкаДокумент);  
				ПервыйДень = ПервыйДень + 60*60*24;
			КонецЦикла;
		КонецЦикла;		
	КонецЕсли;
	
	//ТаблицаНовыхДокументов = Новый ТаблицаЗначений;

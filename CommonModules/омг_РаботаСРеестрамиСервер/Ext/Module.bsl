	               |		КОГДА ТИПЗНАЧЕНИЯ(омг_ОстаткиПредоплатыОбороты.ДокументПоступления) = ТИП(Документ.ПриходныйКассовыйОрдер)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.омг_ВидОплаты.Наличный)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.омг_ВидОплаты.БезНаличный)
	               |	КОНЕЦ КАК омг_ВидОплаты,
	               |	СУММА(ВЫБОР
	               |			КОГДА НЕ омг_ОстаткиПредоплатыОбороты.СуммаПриход = 0
	               |				ТОГДА омг_ОстаткиПредоплатыОбороты.СуммаПриход
	               |		КОНЕЦ) КАК омг_Сумма,   
				   |	СУММА(ВЫБОР
	               |				КОГДА НЕ омг_ОстаткиПредоплатыОбороты.СуммаРасход = 0
	               |						ТОГДА омг_ОстаткиПредоплатыОбороты.СуммаРасход
	               |		КОНЕЦ) КАК СуммаЗачет,
	               |	омг_ОстаткиПредоплатыОбороты.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрНакопления.омг_ОстаткиПредоплаты.Обороты(, , Регистратор, ) КАК омг_ОстаткиПредоплатыОбороты
	               |ГДЕ
	               |	омг_ОстаткиПредоплатыОбороты.ДокументПоступления.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания"
					+ УсловияПредоплаты + 
				   "
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	омг_ОстаткиПредоплатыОбороты.ДокументПоступления,
	               |	омг_ОстаткиПредоплатыОбороты.Регистратор,
	               |	омг_ОстаткиПредоплатыОбороты.Клиент,
	               |	омг_ОстаткиПредоплатыОбороты.ДокументПоступления.омг_ИспользуемыйТерминал,
	               |	омг_ОстаткиПредоплатыОбороты.ДокументПоступления.Касса
	               |
	               |УПОРЯДОЧИТЬ ПО   
				   |	Клиент, 
				   |	ДокументОплаты,
	               |	омг_ОстаткиПредоплатыОбороты.Регистратор.Дата 
				   |;
	               |
				   |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	омг_Предоплаты.Заявка.Клиент КАК Клиент,
	               |	омг_Предоплаты.ПлатежныйДокумент.Ссылка КАК ДокументОплаты,
	               |	омг_Предоплаты.ПлатежныйДокумент.омг_ИспользуемыйТерминал КАК омг_ЭквайринговыйТерминал,
	               |	омг_Предоплаты.ПлатежныйДокумент.Касса КАК омг_Касса,
	               |	омг_Предоплаты.Сумма КАК омг_Сумма, 
				    |	омг_Предоплаты.ВозвратУслуг КАК ВозвратУслуг,
	               |	омг_Предоплаты.РегистраторЗаписи КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.омг_Предоплаты КАК омг_Предоплаты
	               |ГДЕ
	               |	омг_Предоплаты.ПлатежныйДокументВозврата.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И омг_Предоплаты.Статус = ЗНАЧЕНИЕ(Перечисление.омг_СтатусыПредоплаты.ПроизведенВозврат)" 
				   + УсловияВозврата +
	               " 
				   |
				   | 	УПОРЯДОЧИТЬ ПО
	               |	Клиент,
	               |	омг_Предоплаты.РегистраторЗаписи.Дата";

							
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ПустаяДата",Дата("00010101"));
	РезультатЗапросаПакетов = Запрос.ВыполнитьПакет(); 
	ВыборкаПоСтрокам = РезультатЗапросаПакетов[1].Выбрать();   
	РезультатЗапросаПоДокументам = РезультатЗапросаПакетов[2].Выбрать();
	РезультатЗапросаПоОплатам = РезультатЗапросаПакетов[3].Выбрать(); 
	РезультатЗапросаПоПредоплатам = РезультатЗапросаПакетов[4].Выгрузить();
	РезультатЗапросаПоВозвратуПредоплатам = РезультатЗапросаПакетов[5].Выгрузить();
	ОказаниеУслуг = Документы.ОказаниеУслуг.ПустаяСсылка();  
	СуммаДокументаНал = 0;
	СуммаДокументаБезНал = 0;
	КолСтрокДок = 0;   
	СуммаДокументаНалОстаток = 0;  
	СуммаДокументаБезНалОстаток = 0; 
	СтрокаТаблицы = Неопределено; 
	ПромежуточныйПоследняяСтрокаНал  = 0; 
	ПромежуточныйПоследняяСтрокаБезНал = 0;
	Пока ВыборкаПоСтрокам.Следующий() Цикл
		СуммаСтрокиНал = 0;
		СуммаСтрокиБезНал = 0;
		Если ОказаниеУслуг <> ВыборкаПоСтрокам.ДокументПродажи Тогда  
			Если не СтрокаТаблицы = Неопределено и не ПромежуточныйПоследняяСтрокаНал  = 0 и  не ПромежуточныйПоследняяСтрокаБезНал = 0 Тогда
				СтрокаТаблицы.омг_СуммаНаличный = ПромежуточныйПоследняяСтрокаНал; 
				СтрокаТаблицы.омг_СуммаБезналичный = ПромежуточныйПоследняяСтрокаБезНал; 
				Если  СтрокаТаблицы.омг_СуммаБезналичный = 0  Тогда	
					СтрПоиска = Новый Структура;
					СтрПоиска.Вставить("Ссылка",СтрокаТаблицы.ДокументПродажи);
					РезультатЗапросаПоОплатам.НайтиСледующий(стрПоиска);
					СтрокаТаблицы.омг_ЭквайринговыйТерминал = РезультатЗапросаПоОплатам.омг_ЭквайринговыйТерминал;
					РезультатЗапросаПоОплатам.Сбросить(); 
					
				КонецЕсли;
				
			КонецЕсли; 
			Коэф = ВыборкаПоСтрокам.ЭтоТекущийВозврат;
			ОказаниеУслуг =  ВыборкаПоСтрокам.ДокументПродажи;
			СуммаДокументаНал    = ВыборкаПоСтрокам.омг_СуммаНаличный* Коэф;
			СуммаДокументаБезНал = ВыборкаПоСтрокам.омг_СуммаБезналичный* Коэф;
			СуммаДокументаНалОстаток = СуммаДокументаНал;
			СуммаДокументаБезНалОстаток = СуммаДокументаБезНал;
			ИтогПоДокументуНал = 0;
			ИтогПоДокументуБезНал = 0;
			ЭтоПоследняяСтрока = Ложь;
			стрПоиска = Новый Структура;
			стрПоиска.Вставить("Ссылка",ВыборкаПоСтрокам.ДокументПродажи);
			РезультатЗапросаПоДокументам.НайтиСледующий(стрПоиска);
			КолСтрокДокЗнаменатель = РезультатЗапросаПоДокументам.КлючСтроки;
			КолСтрокДок = РезультатЗапросаПоДокументам.КлючСтроки;
			РезультатЗапросаПоДокументам.Сбросить();
			Если ВыборкаПоСтрокам.СуммаДокумента = 0 Тогда
				СуммаДокумента = ВыборкаПоСтрокам.ДокументПродажи.Работы.Итог("Сумма")	
			иначе
				СуммаДокумента = ВыборкаПоСтрокам.СуммаДокумента;	
			КонецЕсли;  
			Если не ВыборкаПоСтрокам.ЭтоВозврат Тогда   // нов
				
				СтрОплаты = омг_Оплаты.Добавить();
				ЗаполнитьЗначенияСвойств(СтрОплаты,ВыборкаПоСтрокам); 
				СтрОплаты.омг_СуммаБезналичный = СтрОплаты.омг_СуммаБезналичный * Коэф;
				СтрОплаты.омг_СуммаНаличный = СтрОплаты.омг_СуммаНаличный * Коэф;
				СтрОплаты.омг_СуммаСкидки = СтрОплаты.омг_СуммаСкидки * Коэф;
				Если не СтрОплаты.омг_СуммаБезналичный = 0 Тогда
					
					СтрПоиска = Новый Структура;
					СтрПоиска.Вставить("Ссылка",СтрОплаты.ДокументПродажи);
					РезультатЗапросаПоОплатам.НайтиСледующий(стрПоиска);
					СтрОплаты.омг_ЭквайринговыйТерминал = РезультатЗапросаПоОплатам.омг_ЭквайринговыйТерминал;
					РезультатЗапросаПоОплатам.Сбросить(); 
					
				КонецЕсли;
				
			КонецЕсли;	                             // нов
		КонецЕсли;	
		
		Если КолСтрокДок > 1 Тогда
			КолСтрокДок = КолСтрокДок - 1;
			Если СуммаДокументаНал <> 0 Тогда 
				Если ВыборкаПоСтрокам.Сумма = 0 Тогда   
					СуммаСтрокиНал = 0;	
				Иначе	
					СуммаСтрокиНал = СуммаДокументаНал / (СуммаДокумента/ВыборкаПоСтрокам.Сумма);
				КонецЕсли;
				//СуммаДокументаНалОстаток = СуммаДокументаНалОстаток - СуммаСтрокиНал;
			КонецЕсли; 
			Если СуммаДокументаБезНал <> 0 Тогда
				Если ВыборкаПоСтрокам.Сумма = 0 Тогда   
					СуммаСтрокиБезНал = 0;	
				Иначе	
					СуммаСтрокиБезНал = СуммаДокументаБезНал / (СуммаДокумента/ВыборкаПоСтрокам.Сумма);
				КонецЕсли;
				//СуммаДокументаБезНалОстаток = СуммаДокументаБезНалОстаток - СуммаСтрокиБезНал;
			КонецЕсли;  
			ЭтоПоследняяСтрока = Ложь;
		иначе
			Если СуммаДокументаНал <> 0 Тогда
				СуммаСтрокиНал = СуммаДокументаНалОстаток;
			КонецЕсли; 
			Если СуммаДокументаБезНал <> 0 Тогда
				СуммаСтрокиБезНал = СуммаДокументаБезНалОстаток;
			КонецЕсли;
			ЭтоПоследняяСтрока = Истина;
		КонецЕсли;
		ЭтоУслуга = Ложь;
		//Если ВыборкаПоСтрокам.ЭтоВозврат и ЗначениеЗаполнено(ВыборкаПоСтрокам.ДатаДокументаОснования) и КонецДня(ВыборкаПоСтрокам.ДатаДокументаОснования) < НачалоДня(ВыборкаПоСтрокам.Дата)  Тогда				
		Если ВыборкаПоСтрокам.ЭтоВозврат  Тогда
			СтрокаТаблицы = омг_УслугиВозврат.Добавить();	
		иначе
			СтрокаТаблицы = Услуги.Добавить();
			ЭтоУслуга = Истина; 
		КонецЕсли;   
		Коэф = ВыборкаПоСтрокам.ЭтоТекущийВозврат; 
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыборкаПоСтрокам);
		Если ЭтоУслуга Тогда  // нов
			СтрокаТаблицы.омг_ЭтоТекущийВозврат = ?(Коэф<0,Истина,Ложь);
		КонецЕсли;	          // нов
		СтрокаТаблицы.омг_СуммаБезналичный = СуммаСтрокиБезНал ;
		СтрокаТаблицы.омг_СуммаНаличный = СуммаСтрокиНал;  
		Если не СтрокаТаблицы.омг_СуммаБезналичный = 0 и не СтрокаТаблицы.омг_СуммаНаличный = 0 Тогда
			СтрокаТаблицы.омг_СуммаБезналичный = Окр(СтрокаТаблицы.омг_СуммаБезналичный);
			СтрокаТаблицы.омг_СуммаНаличный = Окр(СтрокаТаблицы.омг_СуммаНаличный);
		КонецЕсли;   
		
		СуммаДокументаНалОстаток = СуммаДокументаНалОстаток - СтрокаТаблицы.омг_СуммаНаличный;
		СуммаДокументаБезНалОстаток = СуммаДокументаБезНалОстаток - СтрокаТаблицы.омг_СуммаБезналичный;
		
		ИтогПоДокументуНал = ИтогПоДокументуНал + СтрокаТаблицы.омг_СуммаНаличный;
		ИтогПоДокументуБезНал = ИтогПоДокументуБезНал + СтрокаТаблицы.омг_СуммаБезналичный;
		
		ПромежуточныйПоследняяСтрокаНал = 0; 
		ПромежуточныйПоследняяСтрокаБезНал = 0;
		
		//Если ЭтоПоследняяСтрока Тогда // в последней строке проверяем результаты округления
		ИтогПоДокументуНалМодуль = ?(ИтогПоДокументуНал <0,ИтогПоДокументуНал*-1,ИтогПоДокументуНал);
		СуммаДокументаНалМодуль  = ?(СуммаДокументаНал <0,СуммаДокументаНал*-1,СуммаДокументаНал);
		ИтогПоДокументуБезНалМодуль = ?(ИтогПоДокументуБезНал <0,ИтогПоДокументуБезНал*-1,ИтогПоДокументуБезНал);
		СуммаДокументаБезНалМодуль = ?(СуммаДокументаБезНал <0,СуммаДокументаБезНал*-1,СуммаДокументаБезНал);
		
		Если не ИтогПоДокументуНалМодуль = СуммаДокументаНалМодуль или не ИтогПоДокументуБезНалМодуль = СуммаДокументаБезНалМодуль Тогда
			
			РазНал = ИтогПоДокументуНалМодуль - СуммаДокументаНалМодуль;
			
			РазБезНал = ИтогПоДокументуБезНалМодуль - СуммаДокументаБезНалМодуль; 
			
			РазНал = ?(СтрокаТаблицы.омг_СуммаНаличный<0,РазНал*-1,РазНал);
			РазБезНал = ?(СтрокаТаблицы.омг_СуммаБезналичный<0,РазБезНал*-1,РазБезНал);
			
			ПромежуточныйПоследняяСтрокаНал = СтрокаТаблицы.омг_СуммаНаличный - РазНал;
			ПромежуточныйПоследняяСтрокаБезНал = СтрокаТаблицы.омг_СуммаБезналичный - РазБезНал;
		КонецЕсли;	
		//КонецЕсли; 
		Если ЭтоУслуга и СтрокаТаблицы.омг_СуммаСкидки <> 0 Тогда
			СтрокаТаблицы.Сумма = (СтрокаТаблицы.Сумма + СтрокаТаблицы.омг_СуммаСкидки)
		КонецЕсли;  
		СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма * Коэф; 
		СтрокаТаблицы.Количество = СтрокаТаблицы.Количество * Коэф; 
		СтрокаТаблицы.омг_СуммаСкидки = СтрокаТаблицы.омг_СуммаСкидки * Коэф;  
		//Если не СтрокаТаблицы.омг_СуммаБезналичный = 0 и не ЗначениеЗаполнено(СтрокаТаблицы.омг_ЭквайринговыйТерминал) Тогда
		Если не СтрокаТаблицы.омг_СуммаБезналичный = 0 Тогда
			
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("Ссылка",СтрокаТаблицы.ДокументПродажи);
			РезультатЗапросаПоОплатам.НайтиСледующий(стрПоиска);
			СтрокаТаблицы.омг_ЭквайринговыйТерминал = РезультатЗапросаПоОплатам.омг_ЭквайринговыйТерминал;
			РезультатЗапросаПоОплатам.Сбросить(); 
			
		КонецЕсли;
	КонецЦикла;	
	Если не СтрокаТаблицы = Неопределено и не ПромежуточныйПоследняяСтрокаНал  = 0 и  не ПромежуточныйПоследняяСтрокаБезНал = 0 Тогда
		СтрокаТаблицы.омг_СуммаНаличный = ПромежуточныйПоследняяСтрокаНал; 
		СтрокаТаблицы.омг_СуммаБезналичный = ПромежуточныйПоследняяСтрокаБезНал; 
		Если  СтрокаТаблицы.омг_СуммаБезналичный = 0  Тогда	
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("Ссылка",СтрокаТаблицы.ДокументПродажи);
			РезультатЗапросаПоОплатам.НайтиСледующий(стрПоиска);
			СтрокаТаблицы.омг_ЭквайринговыйТерминал = РезультатЗапросаПоОплатам.омг_ЭквайринговыйТерминал;
			РезультатЗапросаПоОплатам.Сбросить(); 
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрВозврата = Новый Структура;
	СтрВозврата.Вставить("Услуги",Услуги);
	СтрВозврата.Вставить("омг_УслугиВозврат",омг_УслугиВозврат);  
	омг_Оплаты.Свернуть("омг_ВидОплаты,омг_ЭквайринговыйТерминал,омг_Касса,ДокументПродажи","омг_СуммаБезналичный,омг_СуммаНаличный,омг_СуммаСкидки");
	СтрВозврата.Вставить("омг_Оплаты",омг_Оплаты);
	СтрВозврата.Вставить("омг_Предоплаты",РезультатЗапросаПоПредоплатам); 
	СтрВозврата.Вставить("РезультатЗапросаПоВозвратуПредоплатам",РезультатЗапросаПоВозвратуПредоплатам);
	
	
	
	Возврат СтрВозврата;
	
КонецФункции

Процедура омг_СоздатьРеестры() Экспорт
	Омг_СобратьУслуги(Ложь)
КонецПроцедуры

Процедура ОбменСБКЗарегистрироватьИзменениеДокументаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	УзелОбмена = ПланыОбмена.омг_ОбменУМЦБухгалтерияПредприятия30.НайтиПоКоду("ОМ"); // узел услуг 

	Если ЗначениеЗаполнено(УзелОбмена.ДатаНачалаВыгрузкиДокументов) и Метаданные.Документы.Содержит(Метаданные.НайтиПоТипу(ТипЗнч(Источник))) Тогда
		 Если УзелОбмена.ДатаНачалаВыгрузкиДокументов > Источник.Дата Тогда
		      Отказ = Истина;
			  Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если типЗнч(Источник) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда
		Если Источник.ВидОперации = Перечисления.ВидыОперацийРКО.ВзносНаличнымиВБанк  или  Источник.ВидОперации = Перечисления.ВидыОперацийРКО.ПеремещениеВКассу  Тогда  
			//ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена,Источник);
			ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписьюДокумента("омг_ОбменУМЦБухгалтерияПредприятия30", Источник, Отказ, РежимЗаписи, РежимПроведения);
		КонецЕсли;
	КонецЕсли;
	
	Если типЗнч(Источник) = Тип("ДокументОбъект.РеестрОказанныхУслугПоСоглашениям") Тогда
		
		ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписьюДокумента("омг_ОбменУМЦБухгалтерияПредприятия30", Источник, Отказ, РежимЗаписи, РежимПроведения);	
		
		Для каждого стрНоменклатура из  Источник.Услуги Цикл
			
			НоменклатураОбъект = стрНоменклатура.Номенклатура.ПолучитьОбъект();
			
			//ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписью("омг_ОбменУМЦБухгалтерияПредприятия30",НоменклатураОбъект, Отказ, Истина);
			
			
			Если Источник.ПометкаУдаления Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена,НоменклатураОбъект);
			Иначе	
				ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена,НоменклатураОбъект);
			КонецЕсли;	
			
		КонецЦикла;	    
		
		Для каждого стрНоменклатура из  Источник.омг_УслугиВозврат Цикл  
			
			НоменклатураОбъект = стрНоменклатура.Номенклатура.ПолучитьОбъект();	
			
			//ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписью("омг_ОбменУМЦБухгалтерияПредприятия30", НоменклатураОбъект, Отказ, Истина);
			
			Если Источник.ПометкаУдаления Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена,НоменклатураОбъект);
			Иначе	
				ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена,НоменклатураОбъект);
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры

Функция УдалитьДублиСтрокТаблицыЗначений(Таблица, Колонки = "") Экспорт

		КолонкиЗапроса = "ТЗ." + СтрЗаменить(Колонки, ",", ",ТЗ.");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
					   |	" + КолонкиЗапроса + "
					   |ПОМЕСТИТЬ ВТ_ТЗ
					   |ИЗ
					   |	&ТЗ КАК ТЗ
					   |;
					   |
					   |////////////////////////////////////////////////////////////////////////////////
					   |ВЫБРАТЬ РАЗЛИЧНЫЕ
					   |	" + СтрЗаменить(КолонкиЗапроса, "ТЗ.", "ВТ_ТЗ.") + "
					   |ИЗ
					   |	ВТ_ТЗ КАК ВТ_ТЗ
					   |";

		Запрос.УстановитьПараметр("ТЗ", Таблица);
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаЗапроса = РезультатЗапроса.Выгрузить();
		ТаблицаРезультат = Таблица.СкопироватьКолонки();
		Для каждого СтрокаТЗ Из ТаблицаЗапроса Цикл
		
			СтруктураОтбора = Новый Структура(Колонки);
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаТЗ);
			
			РезультатОтбора = Таблица.НайтиСтроки(СтруктураОтбора);
			Для каждого СтрокаОтбора Из РезультатОтбора Цикл
				
				НоваяСтрока = ТаблицаРезультат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтбора);
				Прервать;
				
			КонецЦикла;
		
		КонецЦикла;
		
	
	Возврат ТаблицаРезультат;

КонецФункции

Процедура ЗаполнитьДокумент(Филиал,ДатаНачалаДокумента,СслкаДокумент = Неопределено,омг_СтраховаяПрограмма= Неопределено,Контрагент= Неопределено) 
	
	Если СслкаДокумент = Неопределено Тогда
		
		ДокументОбъект = Документы.РеестрОказанныхУслугПоСоглашениям.СоздатьДокумент(); 
		ДокументОбъект.Дата = КонецДня(ДатаНачалаДокумента) - 1;
		ДокументОбъект.НачалоПериода = НачалоДня(ДатаНачалаДокумента); 
		Если омг_СтраховаяПрограмма = Неопределено Тогда
			ДокументОбъект.КонецПериода =  НачалоДня(ДатаНачалаДокумента);
		Иначе
			ДокументОбъект.КонецПериода =  КонецМесяца(ДатаНачалаДокумента);
			ДокументОбъект.омг_АвтоСтраховые = Истина;
			ДокументОбъект.Соглашение = омг_СтраховаяПрограмма;	
			ДокументОбъект.Контрагент = Контрагент;
		КонецЕсли;
		ДокументОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Комментарий = "Создано автоматически " +ТекущаяДата()+" обработкой!";	
		ДокументОбъект.Комментарий = Комментарий; 
		ДокументОбъект.Филиал = Филиал;  	
	иначе     
		
		ДокументОбъект = СслкаДокумент.ПолучитьОбъект();
		
	КонецЕсли;    
	
	СтрВозврата = омг_ВернутьУслугиНаСервере(не омг_СтраховаяПрограмма= Неопределено,Ложь,Филиал,ДокументОбъект.НачалоПериода,КонецДня(ДокументОбъект.КонецПериода),Контрагент,омг_СтраховаяПрограмма);
	ДокументОбъект.Услуги.Очистить();
	ДокументОбъект.омг_УслугиВозврат.Очистить(); 
	ДокументОбъект.омг_Оплаты.Очистить();
	
	ДокументОбъект.Услуги.Загрузить(СтрВозврата.Услуги);
	ДокументОбъект.омг_УслугиВозврат.Загрузить(СтрВозврата.омг_УслугиВозврат); 
	ДокументОбъект.омг_Оплаты.Загрузить(СтрВозврата.омг_Оплаты);
	
	Если ДокументОбъект.Услуги.Количество() > 0 или ДокументОбъект.омг_УслугиВозврат.Количество() > 0 
		или ДокументОбъект.омг_Оплаты.Количество() > 0 или ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда 
		ДокументОбъект.ПометкаУдаления = Ложь;
		Если омг_СтраховаяПрограмма = Неопределено Тогда
			ДокументОбъект.Проведен = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);	
		Иначе
			ДокументОбъект.Записать(); 
		КонецЕсли;	
	КонецЕсли; 
	
КонецПроцедуры



Функция омг_ВернутьУслугиНаСервере(ВключатьСтраховые = Ложь, ЭтоЗакрытиеСмены = Ложь, Филиал = Неопределено,НачалоПериода,КонецПериода,Контрагент = Неопределено, Соглашение = Неопределено) Экспорт
	
	ДокументОбьектРеестр = Документы.РеестрОказанныхУслугПоСоглашениям.СоздатьДокумент(); 
	
	Услуги = ДокументОбьектРеестр.Услуги.Выгрузить(); 
	Услуги.Колонки.Добавить("Филиал", Новый ОписаниеТипов("СправочникСсылка.Филиалы"));
	
	омг_УслугиВозврат = ДокументОбьектРеестр.омг_УслугиВозврат.Выгрузить();
	омг_УслугиВозврат.Колонки.Добавить("Филиал", Новый ОписаниеТипов("СправочникСсылка.Филиалы"));
	
	омг_Оплаты = ДокументОбьектРеестр.омг_Оплаты.Выгрузить();
	омг_Оплаты.Колонки.Добавить("Филиал", Новый ОписаниеТипов("СправочникСсылка.Филиалы")); 
	
	ДокументОбьектРеестр = Неопределено;
	
	Запрос = Новый Запрос; 
	Условия = "";  
	УсловияПредоплаты = ""; 
	УсловияВозврата = "";
	
	Если ЗначениеЗаполнено(Филиал) Тогда
		
		Условия = Условия + 
		"
		|	И ОказаниеУслугРаботы.Ссылка.Филиал = &Филиал";	
		
		УсловияПредоплаты = УсловияПредоплаты + 
		"
		|	И омг_ОстаткиПредоплатыОбороты.ДокументПоступления.Филиал = &Филиал";
		
		Запрос.УстановитьПараметр("Филиал", Филиал);  
		

Функция ПолучитьТаблицуПорядкаЗубов() Экспорт 
	
	ТаблицаПорядок = Новый ТаблицаЗначений;
	ТаблицаПорядок.Колонки.Добавить("НаименованиеЗуба", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(10)));
	ТаблицаПорядок.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	ДиапазонЗубов = стомСтоматология.ПолучитьДиапазонЗубовЧелюсти();
	ТаблицаПорядок.ЗагрузитьКолонку(ДиапазонЗубов, "НаименованиеЗуба");
	Для Сч = 0 По ДиапазонЗубов.Количество() - 1 Цикл
		НоваяСтрока = ТаблицаПорядок.Добавить();
		НоваяСтрока.НаименованиеЗуба = ДиапазонЗубов[Сч];
		НоваяСтрока.Порядок = Сч;
	КонецЦикла;
	
	Возврат ТаблицаПорядок;
	
КонецФункции

Функция ПолучитьЗубыВДиапазоне(Знач НачальныйЗуб, Знач КонечныйЗуб, ДиапазонЗубов = Неопределено) Экспорт
	
	НачальныйЗуб = Строка(НачальныйЗуб);
	КонечныйЗуб = Строка(КонечныйЗуб);
	
	Если ДиапазонЗубов = Неопределено Тогда 
		ДиапазонЗубов = ПолучитьДиапазонЗубовЧелюсти();
	КонецЕсли;
	
	мсВозврат = Новый Массив;
	ПервыйИндекс = ДиапазонЗубов.Найти(НачальныйЗуб);
	ВторойИндекс = ДиапазонЗубов.Найти(КонечныйЗуб);
	
	Для Сч = Мин(ПервыйИндекс, ВторойИндекс) По Макс(ПервыйИндекс, ВторойИндекс) Цикл
		мсВозврат.Добавить(ДиапазонЗубов[Сч]);
	КонецЦикла;
	
	Возврат мсВозврат;
	
КонецФункции

Функция СформироватьЗубнуюКартуHTML(Клиент, ЗубнаяКарта, Прием = Неопределено, Дата = Неопределено, 
	ВыводитьСостояния = Истина, ВыводитьВарианты = Истина, ВыводитьКонструкции = Ложь, ВыводитьРасшифровкуОбозначений = Истина, Оформление = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда 
		Дата = Дата(1,1,1);
	КонецЕсли;
	
	// Добавился параметр ВыводитьРасшифровкуОбозначений перед Оформление в 2.0.26.2.
	Если ТипЗнч(ВыводитьРасшифровкуОбозначений) = Тип("Структура") Тогда
		Оформление = ВыводитьРасшифровкуОбозначений;
		ВыводитьРасшифровкуОбозначений = Истина;
	КонецЕсли;
	
	ТаблицаПорядок = Новый ТаблицаЗначений;
	ТаблицаПорядок.Колонки.Добавить("НаименованиеЗуба", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(10)));
	ТаблицаПорядок.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	ТаблицаПорядок.ЗагрузитьКолонку(ПолучитьДиапазонЗубовЧелюсти(), "НаименованиеЗуба");
	ДиапазонЗубов = ПолучитьДиапазонЗубовЧелюсти();
	Для Сч = 0 По ДиапазонЗубов.Количество() - 1 Цикл
		НоваяСтрока = ТаблицаПорядок.Добавить();
		НоваяСтрока.НаименованиеЗуба = ДиапазонЗубов[Сч];
		НоваяСтрока.Порядок = Сч;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ЗубнаяКарта", ЗубнаяКарта);
	Запрос.УстановитьПараметр("БезПриема", Прием = Неопределено);
	Запрос.УстановитьПараметр("Прием", Прием);
	Запрос.УстановитьПараметр("ПорядокЗубов", ТаблицаПорядок);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПорядокЗубов.НаименованиеЗуба,
	|	ПорядокЗубов.Порядок
	|ПОМЕСТИТЬ ПорядокЗубов
	|ИЗ
	|	&ПорядокЗубов КАК ПорядокЗубов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стомЗубыКарты.Ссылка КАК ЗубВКарте,
	|	ВЫБОР
	|		КОГДА стомЗубыКарты.Наименование ПОДОБНО ""[12]_""
	|			ТОГДА ""Верх""
	|		КОГДА стомЗубыКарты.Наименование ПОДОБНО ""[34]_""
	|			ТОГДА ""Низ""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Расположение,
	|	ПорядокЗубов.Порядок
	|ПОМЕСТИТЬ ВсеЗубыКарты
	|ИЗ
	|	Справочник.стомЗубыКарты КАК стомЗубыКарты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокЗубов КАК ПорядокЗубов
	|		ПО стомЗубыКарты.Наименование = ПорядокЗубов.НаименованиеЗуба
	|ГДЕ
	|	стомЗубыКарты.Владелец = &ЗубнаяКарта
	|	И ВЫБОР
	|			КОГДА стомЗубыКарты.Наименование ПОДОБНО ""[12]_""
	|				ТОГДА ""Верх""
	|			КОГДА стомЗубыКарты.Наименование ПОДОБНО ""[34]_""
	|				ТОГДА ""Низ""
	|			ИНАЧЕ """"
	|		КОНЕЦ <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стомВариантыЗубовСрезПоследних.Клиент,
	|	стомВариантыЗубовСрезПоследних.ЗубнаяКарта,
	|	ВсеЗубыКарты.ЗубВКарте,
	|	стомВариантыЗубовСрезПоследних.ВариантЗуба,
	|  стомВариантыЗубовСрезПоследних.Область КАК КонструкцияОбласть,
	|	стомВариантыЗубовСрезПоследних.Конструкция,
	|	ВсеЗубыКарты.Расположение КАК Расположение,
	|	ВсеЗубыКарты.Порядок
	|ПОМЕСТИТЬ ВариантыКарты
	|ИЗ
	|	ВсеЗубыКарты КАК ВсеЗубыКарты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стомВариантыЗубов.СрезПоследних(
	|				&Дата,
	|				ЗубнаяКарта = &ЗубнаяКарта
	|						И Клиент = &Клиент
	|						И &БезПриема
	|					ИЛИ Регистратор = &Прием) КАК стомВариантыЗубовСрезПоследних
	|		ПО ВсеЗубыКарты.ЗубВКарте = стомВариантыЗубовСрезПоследних.ЗубВКарте
	|			И (стомВариантыЗубовСрезПоследних.ВидРедактирования = ЗНАЧЕНИЕ(Перечисление.стомВидыРедактированияЭлементовКарты.Добавление))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеЗубыКарты.ЗубВКарте,
	|	стомОбозначенияЗубовСрезПоследних.ОбозначениеЗуба КАК Обозначение,
	|	ВсеЗубыКарты.Расположение КАК Расположение
	|ИЗ
	|	ВсеЗубыКарты КАК ВсеЗубыКарты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стомОбозначенияЗубов.СрезПоследних(
	|				&Дата,
	|				ЗубнаяКарта = &ЗубнаяКарта
	|					И Клиент = &Клиент) КАК стомОбозначенияЗубовСрезПоследних
	|		ПО ВсеЗубыКарты.ЗубВКарте = стомОбозначенияЗубовСрезПоследних.ЗубВКарте
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВсеЗубыКарты.Порядок
	|ИТОГИ ПО
	|	Расположение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВариантыКарты.ЗубВКарте КАК ЗубВКарте,
	|	ВариантыКарты.ВариантЗуба,
	|	ВариантыКарты.Расположение КАК Расположение,
	|	ВариантыКарты.ВариантЗуба.Обозначение КАК Обозначение,
	|	ВариантыКарты.ВариантЗуба.Основной КАК Основной,
	|	ВариантыКарты.Порядок
	|ИЗ
	|	ВариантыКарты КАК ВариантыКарты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВариантыКарты.Порядок,
	|	Основной УБЫВ
	|ИТОГИ ПО
	|	Расположение,
	|	ЗубВКарте
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеЗубыКарты.ЗубВКарте КАК ЗубВКарте,
	|	стомСостоянияЗубовСрезПоследних.СостояниеСегмента,
	|	ВсеЗубыКарты.Расположение КАК Расположение,
	|	стомСостоянияЗубовСрезПоследних.СостояниеСегмента.КраткоеОбозначение КАК Обозначение,
	|	ВсеЗубыКарты.Порядок
	|ИЗ
	|	ВсеЗубыКарты КАК ВсеЗубыКарты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стомСостоянияЗубов.СрезПоследних(
	|				&Дата,
	|				ЗубнаяКарта = &ЗубнаяКарта
	|						И Клиент = &Клиент
	|						И &БезПриема
	|					ИЛИ Регистратор = &Прием) КАК стомСостоянияЗубовСрезПоследних
	|		ПО ВсеЗубыКарты.ЗубВКарте = стомСостоянияЗубовСрезПоследних.ЗубВКарте
	|			И (стомСостоянияЗубовСрезПоследних.ВидРедактирования = ЗНАЧЕНИЕ(Перечисление.стомВидыРедактированияЭлементовКарты.Добавление))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВсеЗубыКарты.Порядок
	|ИТОГИ ПО
	|	Расположение,
	|	ЗубВКарте
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВариантыКарты.КонструкцияОбласть,
	|	ВсеЗубыКарты.ЗубВКарте КАК ЗубВКарте,
	|	ВсеЗубыКарты.Расположение КАК Расположение,
	|	ВариантыКарты.КонструкцияОбласть.Обозначение КАК Обозначение,
	|	ВсеЗубыКарты.Порядок КАК Порядок,
	|	ВариантыКарты.Конструкция КАК Конструкция
	|ИЗ
	|	ВсеЗубыКарты КАК ВсеЗубыКарты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВариантыКарты КАК ВариантыКарты
	|		ПО ВсеЗубыКарты.ЗубВКарте = ВариантыКарты.ЗубВКарте
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|ИТОГИ ПО
	|	Расположение,
	|	ЗубВКарте";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаОбозначения = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаВарианты = Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаСостояния = Результат[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКонструкции = Результат[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	ПараметрыОформления = стомПараметрыЗубов.ПолучитьОформлениеПоУмолчаниюДляТаблицЗубнойФормулы(Оформление);
	
	ДокументHTML = РаботаСDOMКлиентСервер.СоздатьДокументDOM(СтрШаблон("<DIV>%1</DIV>", ТаблицаЗубнойКартыОбъявлениеHTML()));
	Таблица = РаботаСHTMLКлиентСервер.ПолучитьЭлементыПоИмени(ДокументHTML, "TBODY", Истина)[0];
	КорневойЭлемент = РаботаСHTMLКлиентСервер.ПолучитьЭлементыПоИмени(ДокументHTML, "DIV", Истина)[0];;
	
	ЗаголовокТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "CAPTION", Таблица);
	ТекстЗаголовка = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, "Зубная формула", ЗаголовокТаблицы, , ПараметрыОформления.АтрибутыЗаголовкаТаблицы);
	
	СтрокиНаДобавление = Новый Структура("Верх, Низ", Новый Массив, Новый Массив);
	
	СоотвОбозначенияЧелюсти = Новый Соответствие;
	СоотвОбозначенияЧелюсти.Вставить("Верх", "Верхняя");
	СоотвОбозначенияЧелюсти.Вставить("Низ", "Нижняя");
	
	СтруктРасшифровкаОбозначений = Новый Структура("Варианты, Состояния", Новый Соответствие, Новый Соответствие);
	
	// Выводим обозначения
	Пока ВыборкаОбозначения.Следующий() Цикл
		
		СтрокаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TR", , , ПараметрыОформления.АтрибутыСтрокОбозначения);
		СтрокиНаДобавление[ВыборкаОбозначения.Расположение].Добавить(СтрокаТаблицы);
		
		// Колонка обозначения челюсти
		КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы, , ПараметрыОформления.АтрибутыКолонкиПараметров);
		ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, СоотвОбозначенияЧелюсти[ВыборкаОбозначения.Расположение], КолонкаТаблицы);
		
		ВыборкаЗуб = ВыборкаОбозначения.Выбрать();
		Пока ВыборкаЗуб.Следующий() Цикл
			
			КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы);
			ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, ВыборкаЗуб.Обозначение, КолонкаТаблицы);
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Добавляем варианты
	Если ВыводитьВарианты Тогда 
		Пока ВыборкаВарианты.Следующий() Цикл
			
			СтрокаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TR", , , ПараметрыОформления.АтрибутыСтрокСостоянийЗубов);
			СтрокиНаДобавление[ВыборкаВарианты.Расположение].Добавить(СтрокаТаблицы);
			
			КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы, , ПараметрыОформления.АтрибутыКолонкиПараметров);
			ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, "Варианты", КолонкаТаблицы);
			
			ВыборкаЗуб = ВыборкаВарианты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗуб.Следующий() Цикл
				
				СтрокаОсновнойВариант = "";
				СтрокаВарианты = "";
				ВыборкаСоставВариантов = ВыборкаЗуб.Выбрать();
				Пока ВыборкаСоставВариантов.Следующий() Цикл
					Если Не ЗначениеЗаполнено(ВыборкаСоставВариантов.ВариантЗуба) Тогда 
						Прервать;
					КонецЕсли;
					Если Не ПустаяСтрока(ВыборкаСоставВариантов.Обозначение) Тогда
						СтруктРасшифровкаОбозначений.Варианты.Вставить(ВыборкаСоставВариантов.ВариантЗуба, ВыборкаСоставВариантов.Обозначение);
						Если ВыборкаСоставВариантов.Основной Тогда 
							СтрокаОсновнойВариант = ВыборкаСоставВариантов.Обозначение;
						Иначе
							Если Не ПустаяСтрока(ВыборкаСоставВариантов.Обозначение) Тогда 
								ОбщегоНазначенияБИТКлиентСервер.КонкатенацияСтрок(СтрокаВарианты, ВыборкаСоставВариантов.Обозначение, "; ");
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы);
				
				Если Не ПустаяСтрока(СтрокаОсновнойВариант) Тогда
					
					СтрокаОсновнойВариант = "[" + СтрокаОсновнойВариант + "]" + ?(ПустаяСтрока(СтрокаВарианты), "", " ");
					ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, СтрокаОсновнойВариант, КолонкаТаблицы, , ПараметрыОформления.АтрибутыЯчеекОсновныхВариантов);

				КонецЕсли;
				
				СтрокаВарианты = ?(ПустаяСтрока(СтрокаВарианты) И ПустаяСтрока(СтрокаОсновнойВариант), Символы.НПП, СтрокаВарианты);
				ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, СтрокаВарианты, КолонкаТаблицы);

			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
	// Состояния зубов
	Если ВыводитьСостояния Тогда 
		Пока ВыборкаСостояния.Следующий() Цикл
			
			СтрокаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TR", , , ПараметрыОформления.АтрибутыСтрокСостоянийЗубов);
			СтрокиНаДобавление[ВыборкаСостояния.Расположение].Добавить(СтрокаТаблицы);
			
			КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы, , ПараметрыОформления.АтрибутыКолонкиПараметров);
			ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, "Состояния", КолонкаТаблицы);
			
			ВыборкаЗуб = ВыборкаСостояния.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗуб.Следующий() Цикл
				
				СтрокаСостояния = "";
				ВыборкаСоставСостояний = ВыборкаЗуб.Выбрать();
				Пока ВыборкаСоставСостояний.Следующий() Цикл
					Если Не ЗначениеЗаполнено(ВыборкаСоставСостояний.СостояниеСегмента) Тогда 
						Прервать;
					КонецЕсли;
					Если Не ПустаяСтрока(ВыборкаСоставСостояний.Обозначение) Тогда
						СтруктРасшифровкаОбозначений.Состояния.Вставить(ВыборкаСоставСостояний.СостояниеСегмента, ВыборкаСоставСостояний.Обозначение);
						ОбщегоНазначенияБИТКлиентСервер.КонкатенацияСтрок(СтрокаСостояния, ВыборкаСоставСостояний.Обозначение, "; ");
					КонецЕсли;
				КонецЦикла;
				
				СтрокаСостояния = ?(ПустаяСтрока(СтрокаСостояния), Символы.НПП, СтрокаСостояния);
				КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы);
				ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, СтрокаСостояния, КолонкаТаблицы);
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
	// Конструкции
	соотвУстановленныеКонструкции = Новый Соответствие;
	Если ВыводитьКонструкции Тогда
		
		Пока ВыборкаКонструкции.Следующий() Цикл
			
			СтрокаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TR", , , ПараметрыОформления.АтрибутыСтрокСостоянийЗубов);
			СтрокиНаДобавление[ВыборкаКонструкции.Расположение].Добавить(СтрокаТаблицы);
			
			КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы, , ПараметрыОформления.АтрибутыКолонкиПараметров);
			ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, "Конструкции", КолонкаТаблицы);
			
			ВыборкаЗуб = ВыборкаКонструкции.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗуб.Следующий() Цикл
				
				ВыборкаСоставКонструкции = ВыборкаЗуб.Выбрать();
				Если Не ВыборкаСоставКонструкции.Следующий() Или 
					Не ЗначениеЗаполнено(ВыборкаСоставКонструкции.Конструкция) 
				Тогда
					КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы);
					Продолжить;
				КонецЕсли;
				
				ЭлементКонструкции = соотвУстановленныеКонструкции.Получить(ВыборкаСоставКонструкции.Конструкция);
				Если ЭлементКонструкции = Неопределено Тогда 
					
					ОбозначениеКонструкции = ?(ПустаяСтрока(ВыборкаСоставКонструкции.Обозначение), Символы.НПП, ВыборкаСоставКонструкции.Обозначение);
					КолонкаТаблицы = РаботаСDOMКлиентСервер.СоздатьЭлементDOM(ДокументHTML, "TD", СтрокаТаблицы);
					ТекстКолонки = РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, ОбозначениеКонструкции, КолонкаТаблицы);
					
					СтруктураКонструкции = Новый Структура("Элемент, КоличествоЗубов", КолонкаТаблицы, 1);
					соотвУстановленныеКонструкции.Вставить(ВыборкаСоставКонструкции.Конструкция, СтруктураКонструкции);
					
				Иначе // Конструкцию уже добавляли, расширяем
					
					ЭлементКонструкции.КоличествоЗубов = ЭлементКонструкции.КоличествоЗубов + 1;
					РаботаСDOMКлиентСервер.УстановитьАтрибутЭлементуDOM(ЭлементКонструкции.Элемент, "colspan", Формат(ЭлементКонструкции.КоличествоЗубов, "ЧГ=0"));  
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Добавляем строки верхней челюсти в обратном порядке
	Сч = СтрокиНаДобавление.Верх.Количество() - 1;
	Пока Сч >= 0 Цикл	
		Таблица.ДобавитьДочерний(СтрокиНаДобавление.Верх[Сч]);
		Сч = Сч - 1;
	КонецЦикла;
	Для Каждого СтрокаНаДобавление Из СтрокиНаДобавление.Низ Цикл 
		Таблица.ДобавитьДочерний(СтрокаНаДобавление);
	КонецЦикла;
	
	// Выводим расшифровку обозначений состояний и вариантов
	Если ВыводитьРасшифровкуОбозначений Тогда
		Для Каждого кзВидРасшифровки Из СтруктРасшифровкаОбозначений Цикл
			
			Если кзВидРасшифровки.Значение.Количество() = 0 Тогда 
				Продолжить;
			КонецЕсли;
			
			ТекстЗаголовкаРасшифровки = Строка(кзВидРасшифровки.Ключ) + ": ";
			ТекстРасшифровки = "";
			Для Каждого кзСостояниеВариант Из кзВидРасшифровки.Значение Цикл 
				ОбщегоНазначенияБИТКлиентСервер.КонкатенацияСтрок(ТекстРасшифровки, кзСостояниеВариант.Значение + " - " + Строка(кзСостояниеВариант.Ключ), ", ");
			КонецЦикла;
			РаботаСDOMКлиентСервер.СоздатьТекстовыйЭлементDOM(ДокументHTML, ТекстЗаголовкаРасшифровки + ТекстРасшифровки, КорневойЭлемент, , ПараметрыОформления.АтрибутыТекстаРасшифровки);
			
		КонецЦикла;
	КонецЕсли;
	
	Результат = РаботаСDOMКлиентСервер.ПолучитьТекстHTMLДокументаDOM(ДокументHTML);
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаЗубнойКартыОбъявлениеHTML()
	
	Возврат "<TABLE border=1 style='border-color: inherit; border-style: solid; border-collapse: collapse;' width='100%'><TBODY></TBODY></TABLE>";
	
КонецФункции

Функция ВедетсяНесколькоЗубныхКарт() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомВидыЗубныхКарт.Ссылка
	|ИЗ
	|	Справочник.стомВидыЗубныхКарт КАК стомВидыЗубныхКарт
	|ГДЕ
	|	НЕ стомВидыЗубныхКарт.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Количество() > 1; 
	
КонецФункции

Функция ПолучитьВидВариантЗубнойКарты(Клиент) Экспорт
	
	КартаВариант = Новый Структура("ЗубнаяКарта, ВариантЗубнойКарты", 
		Справочники.стомВидыЗубныхКарт.ПустаяСсылка(), Справочники.стомВидыЗубныхКарт.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Прием.ВариантЗубнойКарты КАК ВариантЗубнойКарты,
		|	Прием.ЗубнаяКарта КАК ЗубнаяКарта
		|ИЗ
		|	Документ.Прием КАК Прием
		|ГДЕ
		|	Прием.Клиент = &Клиент 
		|	// %ОтборСтоматологическийПрием И Прием.СтоматологическийПрием = ИСТИНА
		|УПОРЯДОЧИТЬ ПО
		|	Прием.Дата УБЫВ";
	
	Если Метаданные.Документы.Прием.Реквизиты.Найти("СтоматологическийПрием") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "// %ОтборСтоматологическийПрием", "");
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ВариантЗубнойКарты) Тогда
			КартаВариант.ВариантЗубнойКарты = Выборка.ВариантЗубнойКарты;
			КартаВариант.ЗубнаяКарта = Выборка.ЗубнаяКарта;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(КартаВариант.ВариантЗубнойКарты) Тогда
		КартаВариант.ВариантЗубнойКарты = ПолучитьВариантКарты(Клиент);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КартаВариант.ЗубнаяКарта) Тогда
		КартаВариант.ЗубнаяКарта = ПолучитьЗубнуюКарту();		
	КонецЕсли;
	
	Возврат КартаВариант;
	
КонецФункции

Функция ПолучитьПараметрыЗубнойФормулыНаДату(Клиент, ЗубнаяКарта, Дата = Неопределено, Прием = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда 
		Дата = Дата(1,1,1);
	КонецЕсли;
	
	Если Прием = Неопределено Тогда 
		Прием = Документы.Прием.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомЗначенияПараметровЗубнойФормулыСрезПоследних.ЗубВКарте,
	|	стомЗначенияПараметровЗубнойФормулыСрезПоследних.СегментВЗубе,
	|	стомЗначенияПараметровЗубнойФормулыСрезПоследних.Параметр,
	|	стомЗначенияПараметровЗубнойФормулыСрезПоследних.Значение,
	|	1 КАК Приоритет,
	|	ЛОЖЬ КАК ИзмененоВТекущемПриеме
	|ПОМЕСТИТЬ ПараметрыЗубовПриемРегистр
	|ИЗ
	|	РегистрСведений.стомЗначенияПараметровЗубнойФормулы.СрезПоследних(
	|			&Дата,
	|			Клиент = &Клиент
	|				И ЗубнаяКарта = &ЗубнаяКарта) КАК стомЗначенияПараметровЗубнойФормулыСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриемстомПараметрыЗубнойФормулы.ЗубВКарте,
	|	ПриемстомПараметрыЗубнойФормулы.СегментВЗубе,
	|	ПриемстомПараметрыЗубнойФормулы.Параметр,
	|	ПриемстомПараметрыЗубнойФормулы.Значение,
	|	0,
	|	ИСТИНА
	|ИЗ
	|	Документ.Прием.стомПараметрыЗубнойФормулы КАК ПриемстомПараметрыЗубнойФормулы
	|ГДЕ
	|	ПриемстомПараметрыЗубнойФормулы.Ссылка = &Прием
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыЗубовПриемРегистр.ЗубВКарте,
	|	ПараметрыЗубовПриемРегистр.СегментВЗубе,
	|	ПараметрыЗубовПриемРегистр.Параметр,
	|	ПараметрыЗубовПриемРегистр.Значение,
	|	ПараметрыЗубовПриемРегистр.ИзмененоВТекущемПриеме
	|ИЗ
	|	ПараметрыЗубовПриемРегистр КАК ПараметрыЗубовПриемРегистр
	|ГДЕ
	|	ПараметрыЗубовПриемРегистр.Приоритет В
	|			(ВЫБРАТЬ
	|				МИНИМУМ(МинПриоритет.Приоритет)
	|			ИЗ
	|				ПараметрыЗубовПриемРегистр КАК МинПриоритет
	|			ГДЕ
	|				МинПриоритет.ЗубВКарте = ПараметрыЗубовПриемРегистр.ЗубВКарте
	|				И МинПриоритет.СегментВЗубе = ПараметрыЗубовПриемРегистр.СегментВЗубе
	|				И МинПриоритет.Параметр = ПараметрыЗубовПриемРегистр.Параметр)";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ЗубнаяКарта", ЗубнаяКарта);
	Запрос.УстановитьПараметр("Прием", Прием);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СформироватьПараметрыЗубнойФормулыHTML(Клиент, ЗубнаяКарта, Прием, Знач ТаблицаПараметровЗФ = Неопределено) Экспорт 
	
	ОбозначенияЗубов = ПолучитьОбозначенияЗубовНаДату(Клиент, ЗубнаяКарта, Прием.Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЗубнойФормулы.ЗубВКарте,
	|	ПараметрыЗубнойФормулы.СегментВЗубе,
	|	ПараметрыЗубнойФормулы.Параметр,
	|	ПараметрыЗубнойФормулы.Значение
	|ПОМЕСТИТЬ ПараметрыЗубнойФормулы
	|ИЗ
	|	&ПараметрыЗубнойФормулы КАК ПараметрыЗубнойФормулы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыЗубнойФормулы.ЗубВКарте КАК ЗубВКарте,
	|	ПараметрыЗубнойФормулы.СегментВЗубе КАК СегментВЗубе,
	|	ПараметрыЗубнойФормулы.Параметр,
	|	ПараметрыЗубнойФормулы.Значение
	|ИЗ
	|	ПараметрыЗубнойФормулы КАК ПараметрыЗубнойФормулы
	|ИТОГИ ПО
	|	ЗубВКарте,
	|	СегментВЗубе";
	Если ТаблицаПараметровЗФ = Неопределено Тогда 
		Запрос.УстановитьПараметр("ПараметрыЗубнойФормулы", Прием.стомПараметрыЗубнойФормулы.Выгрузить());
	Иначе
		Запрос.УстановитьПараметр("ПараметрыЗубнойФормулы", ТаблицаПараметровЗФ.Выгрузить(Новый Структура("ИзмененоВТекущемПриеме", Истина)));
	КонецЕсли;
	ВыборкаЗубы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаЗубы.Количество() = 0 Тогда 
		Возврат "";
	КонецЕсли;
	
	ДокументHTML = РаботаСDOMКлиентСервер.СоздатьДокументDOM("<TABLE style=""TABLE-LAYOUT: auto"" width=""100%"" border=1></TABLE>");
		
	Таблица = РаботаСHTMLКлиентСервер.ПолучитьЭлементыПоИмени(ДокументHTML, "TABLE", Истина)[0];
	
	
	Пока ВыборкаЗубы.Следующий() Цикл
		
		ОбозначениеЗуба = ОбозначенияЗубов[ВыборкаЗубы.ЗубВКарте];
		
		СтрокаТаблицы = ДокументHTML.СоздатьЭлемент("TR");
		Таблица.ДобавитьДочерний(СтрокаТаблицы);
		
		КолонкаЗуб = ДокументHTML.СоздатьЭлемент("TD");
		СтрокаТаблицы.ДобавитьДочерний(КолонкаЗуб);
		
		СодержимоеКолонки = ДокументHTML.СоздатьЭлемент("DIV");
		АтрибутРазмещение = ДокументHTML.СоздатьАтрибут("align");
		АтрибутРазмещение.Значение = "center";
		СодержимоеКолонки.Атрибуты.УстановитьИменованныйЭлемент(АтрибутРазмещение);
		КолонкаЗуб.ДобавитьДочерний(СодержимоеКолонки);
		
		ЖирныйЭлемент = ДокументHTML.СоздатьЭлемент("B");
		СодержимоеКолонки.ДобавитьДочерний(ЖирныйЭлемент);
		
		ТекстЗуб = ДокументHTML.СоздатьТекстовыйУзел(ОбозначениеЗуба);
		ЖирныйЭлемент.ДобавитьДочерний(ТекстЗуб);
		
		КолонкаСегмент = ДокументHTML.СоздатьЭлемент("TD");
		СтрокаТаблицы.ДобавитьДочерний(КолонкаСегмент);
		
		// Содержимое колонки сегмента
		СодержимоеКолонки = ДокументHTML.СоздатьЭлемент("DIV");
		КолонкаСегмент.ДобавитьДочерний(СодержимоеКолонки);
		
		СписокСегменты = ДокументHTML.СоздатьЭлемент("UL");
		СодержимоеКолонки.ДобавитьДочерний(СписокСегменты);
		
		ВыборкаСегменты = ВыборкаЗубы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСегменты.Следующий() Цикл
			
			ЭлементСписка = ДокументHTML.СоздатьЭлемент("LI");
			СписокСегменты.ДобавитьДочерний(ЭлементСписка);
			
			ЖирныйЭлемент = ДокументHTML.СоздатьЭлемент("B");
			ЭлементСписка.ДобавитьДочерний(ЖирныйЭлемент);
			
			ТекстСегмент = ДокументHTML.СоздатьТекстовыйУзел(Строка(ВыборкаСегменты.СегментВЗубе) + ": ");
			ЖирныйЭлемент.ДобавитьДочерний(ТекстСегмент);
			
			ВыборкаПараметры = ВыборкаСегменты.Выбрать();
			Пока ВыборкаПараметры.Следующий() Цикл
				ТекстПараметр = ДокументHTML.СоздатьТекстовыйУзел(
					Строка(ВыборкаПараметры.Параметр) + ": " + Строка(ВыборкаПараметры.Значение) + "; ");
				ЭлементСписка.ДобавитьДочерний(ТекстПараметр);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Результат = РаботаСDOMКлиентСервер.ПолучитьТекстHTMLДокументаDOM(ДокументHTML);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДатуПоследнихИзмененийЗубнойКарты(ЗубнаяКарта, Клиент, ПриемСсылка) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДатыСостоянийВариантов.Период КАК Период,
	|	ДатыСостоянийВариантов.Документ
	|ИЗ
	|	(ВЫБРАТЬ
	|		стомСостоянияЗубовСрезПоследних.Период КАК Период,
	|		стомСостоянияЗубовСрезПоследних.Регистратор КАК Документ
	|	ИЗ
	|		РегистрСведений.стомСостоянияЗубов.СрезПоследних(
	|				,
	|				ЗубнаяКарта = &ЗубнаяКарта
	|					И Клиент = &Клиент) КАК стомСостоянияЗубовСрезПоследних
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		стомВариантыЗубовСрезПоследних.Период,
	|		стомВариантыЗубовСрезПоследних.Регистратор
	|	ИЗ
	|		РегистрСведений.стомВариантыЗубов.СрезПоследних(
	|				,
	|				ЗубнаяКарта = &ЗубнаяКарта
	|					И Клиент = &Клиент) КАК стомВариантыЗубовСрезПоследних) КАК ДатыСостоянийВариантов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Запрос.УстановитьПараметр("ЗубнаяКарта", ЗубнаяКарта);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Новый Структура("Период, Документ", Выборка.Период, Выборка.Документ);
	Иначе  
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСписокДатДокументовДляИсторииЗубов(ЗубнаяКарта, Клиент) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	стомСостоянияЗубов.Период КАК Период
	|ИЗ
	|	РегистрСведений.стомСостоянияЗубов КАК стомСостоянияЗубов
	|ГДЕ
	|	стомСостоянияЗубов.Клиент = &Клиент
	|	И стомСостоянияЗубов.ЗубнаяКарта = &ЗубнаяКарта
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	стомВариантыЗубов.Период
	|ИЗ
	|	РегистрСведений.стомВариантыЗубов КАК стомВариантыЗубов
	|ГДЕ
	|	стомВариантыЗубов.Клиент = &Клиент
	|	И стомВариантыЗубов.ЗубнаяКарта = &ЗубнаяКарта
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Запрос.УстановитьПараметр("ЗубнаяКарта", ЗубнаяКарта);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Период");
	
КонецФункции


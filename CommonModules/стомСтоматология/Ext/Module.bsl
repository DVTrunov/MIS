#Область ПрограммныйИнтерфейс

Процедура УстановкаПараметровСеанса(УчетнаяПолитика = Неопределено) Экспорт
	
	стомЗубнаяКартаИнициализация.УстановкаПараметровСеанса();
		
КонецПроцедуры

Функция ЕстьПравоРедактированияЗубнойКарты() Экспорт 
	
	Возврат ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.стомВариантыЗубов) И 
			ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.стомСостоянияЗубов);
	
КонецФункции

Функция СформироватьЗапросАктуальныхВариантовСостояний(ЗубнаяКарта, Клиент, Дата = Неопределено, ВариантКарты = Неопределено, Документ = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда 
		Дата = ТекущаяДата();
	КонецЕсли;
	
	Если ВариантКарты = Неопределено Тогда 
		ВариантКарты = стомСтоматология.ПолучитьВариантКарты();
	КонецЕсли;
	
	Если Документ = Неопределено Тогда 
		Документ = Документы.Прием.ПустаяСсылка();
	КонецЕсли;
	
	ИмяТаблицыДокумента = Документ.Метаданные().ПолноеИмя();
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДокументстомУстановленныеВарианты.ЗубВКарте КАК ЗубВКарте,
	|	ДокументстомУстановленныеВарианты.ВариантЗуба КАК ВариантЗуба,
	|	ДокументстомУстановленныеВарианты.Область КАК Область,
	|	ДокументстомУстановленныеВарианты.ВидРедактирования КАК ВидРедактирования,
	|	0 КАК Приоритет,
	|	ДокументстомУстановленныеВарианты.Конструкция КАК Конструкция
	|ПОМЕСТИТЬ ВсеВариантыФакт
	|ИЗ
	|	Документ.Прием.стомУстановленныеВарианты КАК ДокументстомУстановленныеВарианты
	|ГДЕ
	|	ДокументстомУстановленныеВарианты.Ссылка = &Документ
	|	И ДокументстомУстановленныеВарианты.Ссылка.ЗубнаяКарта = &ЗубнаяКарта
	|	И ДокументстомУстановленныеВарианты.Ссылка.Клиент = &Клиент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	стомВариантыЗубовСрезПоследних.ЗубВКарте,
	|	стомВариантыЗубовСрезПоследних.ВариантЗуба,
	|	стомВариантыЗубовСрезПоследних.Область,
	|	стомВариантыЗубовСрезПоследних.ВидРедактирования,
	|	1,
	|	стомВариантыЗубовСрезПоследних.Конструкция
	|ИЗ
	|	РегистрСведений.стомВариантыЗубов.СрезПоследних(
	|			&Дата,
	|			Клиент = &Клиент
	|				И ЗубнаяКарта = &ЗубнаяКарта) КАК стомВариантыЗубовСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	стомВидыЗубныхКартНастройкаВариантовОбластей.ЗубВКарте,
	|	стомВидыЗубныхКартНастройкаВариантовОбластей.ВариантЗуба,
	|	ВЫБОР
	|		КОГДА стомВидыЗубныхКартНастройкаВариантовОбластей.ВариантЗуба.Основной
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.стомОбластиСегментов.ПустаяСсылка)
	|		ИНАЧЕ стомВидыЗубныхКартНастройкаВариантовОбластей.Область
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Перечисление.стомВидыРедактированияЭлементовКарты.Добавление),
	|	2,
	|	ЗНАЧЕНИЕ(Справочник.стомКонструкцииЗубовКлиентов.)
	|ИЗ
	|	Справочник.стомВидыЗубныхКарт.НастройкаВариантовОбластей КАК стомВидыЗубныхКартНастройкаВариантовОбластей
	|ГДЕ
	|	стомВидыЗубныхКартНастройкаВариантовОбластей.Ссылка = &ЗубнаяКарта
	|	И стомВидыЗубныхКартНастройкаВариантовОбластей.ВариантКарты = &ВариантКарты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументстомУстановленныеСостояния.ЗубВКарте КАК ЗубВКарте,
	|	ДокументстомУстановленныеСостояния.СегментВЗубе КАК СегментВЗубе,
	|	ДокументстомУстановленныеСостояния.СостояниеСегмента КАК СостояниеСегмента,
	|	ДокументстомУстановленныеСостояния.ВидРедактирования КАК ВидРедактирования,
	|	0 КАК Приоритет
	|ПОМЕСТИТЬ ВсеСостоянияФакт
	|ИЗ
	|	Документ.Прием.стомУстановленныеСостояния КАК ДокументстомУстановленныеСостояния
	|ГДЕ
	|	ДокументстомУстановленныеСостояния.Ссылка = &Документ
	|	И ДокументстомУстановленныеСостояния.Ссылка.ЗубнаяКарта = &ЗубнаяКарта
	|	И ДокументстомУстановленныеСостояния.Ссылка.Клиент = &Клиент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	стомСостоянияЗубовСрезПоследних.ЗубВКарте,
	|	стомСостоянияЗубовСрезПоследних.СегментВЗубе,
	|	стомСостоянияЗубовСрезПоследних.СостояниеСегмента,
	|	стомСостоянияЗубовСрезПоследних.ВидРедактирования,
	|	1
	|ИЗ
	|	РегистрСведений.стомСостоянияЗубов.СрезПоследних(
	|			&Дата,
	|			Клиент = &Клиент
	|				И ЗубнаяКарта = &ЗубнаяКарта) КАК стомСостоянияЗубовСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеВариантыФакт.ЗубВКарте КАК ЗубВКарте,
	|	ВсеВариантыФакт.ВариантЗуба КАК ВариантЗуба,
	|	ВсеВариантыФакт.Область КАК Область,
	|	ВсеВариантыФакт.Конструкция,
	|	ВсеВариантыФакт.ВариантЗуба.Основной,
	|	ВсеВариантыФакт.Область.ВидОбласти КАК ВидОбласти
	|ПОМЕСТИТЬ АктуальныеВариантыЗубов
	|ИЗ
	|	ВсеВариантыФакт КАК ВсеВариантыФакт
	|ГДЕ
	|	ВсеВариантыФакт.Приоритет В
	|			(ВЫБРАТЬ
	|				МИНИМУМ(МинВсеВарианты.Приоритет)
	|			ИЗ
	|				ВсеВариантыФакт КАК МинВсеВарианты
	|			ГДЕ
	|				МинВсеВарианты.ЗубВКарте = ВсеВариантыФакт.ЗубВКарте
	|				И МинВсеВарианты.ВариантЗуба = ВсеВариантыФакт.ВариантЗуба
	|				И МинВсеВарианты.Область = ВсеВариантыФакт.Область)
	|	И ВсеВариантыФакт.ВидРедактирования = ЗНАЧЕНИЕ(Перечисление.стомВидыРедактированияЭлементовКарты.Добавление)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АктуальныеВариантыЗубов.ЗубВКарте КАК ЗубВКарте,
	|	АктуальныеВариантыЗубов.ВариантЗуба КАК ВариантЗуба,
	|	ВЫБОР
	|		КОГДА АктуальныеВариантыЗубов.ВариантЗубаОсновной
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.стомОбластиСегментов.ПустаяСсылка)
	|		ИНАЧЕ АктуальныеВариантыЗубов.Область
	|	КОНЕЦ КАК Область
	|ИЗ
	|	АктуальныеВариантыЗубов КАК АктуальныеВариантыЗубов
	|ГДЕ
	|	(АктуальныеВариантыЗубов.ВариантЗубаОсновной
	|			ИЛИ АктуальныеВариантыЗубов.ВидОбласти = ЗНАЧЕНИЕ(Перечисление.стомВидыОбластей.ОбластьЗуба))
	|ИТОГИ ПО
	|	ЗубВКарте,
	|	ВариантЗуба,
	|	Область
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АктуальныеВариантыЗубов.ЗубВКарте,
	|	АктуальныеВариантыЗубов.ВариантЗуба КАК ВариантЗуба,
	|	ВЫБОР
	|		КОГДА АктуальныеВариантыЗубов.ВидОбласти = ЗНАЧЕНИЕ(Перечисление.стомВидыОбластей.Конструкция)
	|			ТОГДА АктуальныеВариантыЗубов.Область
	|		ИНАЧЕ АктуальныеВариантыЗубов.Область.КонструкцияРодитель
	|	КОНЕЦ КАК Область,
	|	АктуальныеВариантыЗубов.Конструкция КАК Конструкция
	|ИЗ
	|	АктуальныеВариантыЗубов КАК АктуальныеВариантыЗубов
	|ГДЕ
	|	АктуальныеВариантыЗубов.ВидОбласти В (ЗНАЧЕНИЕ(Перечисление.стомВидыОбластей.Конструкция), ЗНАЧЕНИЕ(Перечисление.стомВидыОбластей.ЭлементКонструкции))
	|ИТОГИ ПО
	|	Конструкция,
	|	ВариантЗуба,
	|	Область
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеСостоянияФакт.ЗубВКарте КАК ЗубВКарте,
	|	ВсеСостоянияФакт.СегментВЗубе КАК СегментВЗубе,
	|	ВсеСостоянияФакт.СостояниеСегмента КАК СостояниеСегмента
	|ИЗ
	|	ВсеСостоянияФакт КАК ВсеСостоянияФакт
	|ГДЕ
	|	ВсеСостоянияФакт.Приоритет В
	|			(ВЫБРАТЬ
	|				МИНИМУМ(МинВсеСостояния.Приоритет)
	|			ИЗ
	|				ВсеСостоянияФакт КАК МинВсеСостояния
	|			ГДЕ
	|				МинВсеСостояния.ЗубВКарте = ВсеСостоянияФакт.ЗубВКарте
	|				И МинВсеСостояния.СегментВЗубе = ВсеСостоянияФакт.СегментВЗубе
	|				И МинВсеСостояния.СостояниеСегмента = ВсеСостоянияФакт.СостояниеСегмента)
	|	И ВсеСостоянияФакт.ВидРедактирования = ЗНАЧЕНИЕ(Перечисление.стомВидыРедактированияЭлементовКарты.Добавление)
	|ИТОГИ ПО
	|	ЗубВКарте,
	|	СостояниеСегмента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	стомОбозначенияЗубовСрезПоследних.ЗубВКарте,
	|	стомОбозначенияЗубовСрезПоследних.ОбозначениеЗуба
	|ИЗ
	|	РегистрСведений.стомОбозначенияЗубов.СрезПоследних(
	|			&Дата,
	|			Клиент = &Клиент
	|				И ЗубнаяКарта = &ЗубнаяКарта) КАК стомОбозначенияЗубовСрезПоследних";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Прием", ИмяТаблицыДокумента);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЗубнаяКарта", ЗубнаяКарта);
	Запрос.УстановитьПараметр("ВариантКарты", ВариантКарты);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Возврат Запрос;
	
КонецФункции

Функция ПолучитьЗубнуюКарту() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомВидыЗубныхКарт.Ссылка
	|ИЗ
	|	Справочник.стомВидыЗубныхКарт КАК стомВидыЗубныхКарт
	|
	|УПОРЯДОЧИТЬ ПО
	|	стомВидыЗубныхКарт.ПометкаУдаления";
	ВыборкаЗК = Запрос.Выполнить().Выбрать();
	Если ВыборкаЗК.Следующий() Тогда
		Возврат ВыборкаЗК.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьВариантКарты(Клиент = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Клиент) И Не ВедетсяНесколькоЗубныхКарт() Тогда
		Если ОбщегоНазначенияКлиентСервер.ПолучитьПолноеЧислоЛетСДаты(Клиент.ДатаРождения, ТекущаяДата()) <= 14 Тогда
			// Создается при первом запуске базы, непредопределенный элемент справочника.
			РезультатПоиска = Справочники.стомВариантыЗубныхКарт.НайтиПоНаименованию("Детская");
			Если ЗначениеЗаполнено(РезультатПоиска) Тогда
				Возврат РезультатПоиска;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомВариантыЗубныхКарт.Ссылка
	|ИЗ
	|	Справочник.стомВариантыЗубныхКарт КАК стомВариантыЗубныхКарт
	|
	|УПОРЯДОЧИТЬ ПО
	|	стомВариантыЗубныхКарт.ПометкаУдаления";	
	ВыборкаВК = Запрос.Выполнить().Выбрать();
	Если ВыборкаВК.Следующий() Тогда
		Возврат ВыборкаВК.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКонструкцииЗубыРедактированныеВПриеме(Прием, Клиент = Неопределено, ЗубнаяКарта = Неопределено) Экспорт 
	
	Если Клиент = Неопределено Тогда 
		Клиент = Прием.Клиент;
	КонецЕсли;
	
	Если ЗубнаяКарта = Неопределено Тогда 
		ЗубнаяКарта = Прием.ЗубнаяКарта;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА стомВариантыЗубов.Конструкция = ЗНАЧЕНИЕ(Справочник.стомКонструкцииЗубовКлиентов.ПустаяСсылка)
	|			ТОГДА стомВариантыЗубов.ЗубВКарте
	|		ИНАЧЕ стомВариантыЗубов.Конструкция
	|	КОНЕЦ КАК КонструкцияЗуб,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА стомВариантыЗубов.Конструкция <> ЗНАЧЕНИЕ(Справочник.стомКонструкцииЗубовКлиентов.ПустаяСсылка)
	|				ТОГДА 0
	|			КОГДА НЕ стомВариантыЗубов.ВариантЗуба.Основной
	|				ТОГДА 1
	|			ИНАЧЕ 2
	|		КОНЕЦ) КАК Приоритет
	|ИЗ
	|	РегистрСведений.стомВариантыЗубов КАК стомВариантыЗубов
	|ГДЕ
	|	стомВариантыЗубов.Регистратор = &Прием
	|	И стомВариантыЗубов.ЗубнаяКарта = &ЗубнаяКарта
	|	И стомВариантыЗубов.Клиент = &Клиент
	|	И стомВариантыЗубов.ВидРедактирования = ЗНАЧЕНИЕ(Перечисление.стомВидыРедактированияЭлементовКарты.Добавление)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА стомВариантыЗубов.Конструкция = ЗНАЧЕНИЕ(Справочник.стомКонструкцииЗубовКлиентов.ПустаяСсылка)
	|			ТОГДА стомВариантыЗубов.ЗубВКарте
	|		ИНАЧЕ стомВариантыЗубов.Конструкция
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Прием", Прием);
	Запрос.УстановитьПараметр("ЗубнаяКарта", ЗубнаяКарта);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонструкцияЗуб");
	
КонецФункции

Функция ПолучитьОбозначенияЗубовНаДату(Клиент, ЗубнаяКарта, Дата = Неопределено) Экспорт 
	
	Если Дата = Неопределено Тогда 
		Дата = Дата(1,1,1);
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомОбозначенияЗубовСрезПоследних.ЗубВКарте,
	|	стомОбозначенияЗубовСрезПоследних.ОбозначениеЗуба
	|ИЗ
	|	РегистрСведений.стомОбозначенияЗубов.СрезПоследних(
	|			&Дата,
	|			Клиент = &Клиент
	|				И ЗубнаяКарта = &ЗубнаяКарта) КАК стомОбозначенияЗубовСрезПоследних";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ЗубнаяКарта", ЗубнаяКарта);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Результат = Запрос.Выполнить();	
	Выборка = Результат.Выбрать();
	
	ОбозначенияЗубов = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ОбозначенияЗубов[Выборка.ЗубВКарте] = Выборка.ОбозначениеЗуба;
	КонецЦикла;
	
	Возврат ОбозначенияЗубов;
	
КонецФункции

Процедура УстановитьУсловноеОформлениеЗубов(Форма, НазванияПолейОформления, ОбозначенияЗубов = Неопределено) Экспорт
	
	мсЭлементыНаУдаление = Новый Массив;
	Для Каждого ЭлементОформления Из Форма.УсловноеОформление.Элементы Цикл
		Если ЭлементОформления.ИдентификаторПользовательскойНастройки = "ОбозначенияЗубов" Тогда
			мсЭлементыНаУдаление.Добавить(ЭлементОформления);
		КонецЕсли;
	КонецЦикла;
	Для Каждого элНаУдаление Из мсЭлементыНаУдаление Цикл
		Форма.УсловноеОформление.Элементы.Удалить(элНаУдаление);
	КонецЦикла;

	Если ОбозначенияЗубов <> Неопределено Тогда 
	
		Для Каждого ИмяПоля Из НазванияПолейОформления Цикл
			Для Каждого Зуб Из ОбозначенияЗубов Цикл
				ЭлементУсловногоОформления = Форма.УсловноеОформление.Элементы.Добавить();
				ЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = "ОбозначенияЗубов";
				ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
				ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Форма.Элементы[ИмяПоля].ПутьКДанным);
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементОтбора.ПравоеЗначение = Зуб.Значение;
				ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", Зуб.Представление);	
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры


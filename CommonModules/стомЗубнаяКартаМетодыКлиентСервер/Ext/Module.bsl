#Область Инициализация

Функция ПолучитьСтруктуруДанныхЗК(ИмяЭлемента = "") Экспорт 
	
	СтруктураЗК = Новый Структура;
	
	// Основная карта
	СтруктураЗК.Вставить("ИмяЭлемента", ИмяЭлемента);
	СтруктураЗК.Вставить("Адрес", "");
	СтруктураЗК.Вставить("СтруктураЗагружена", Ложь);	
	СтруктураЗК.Вставить("ПриложениеЗагружено", Ложь);
	СтруктураЗК.Вставить("ВыделенныеЗубыСегменты", Новый Массив);
	СтруктураЗК.Вставить("СписокВыбораЗубов", Новый СписокЗначений);
	СтруктураЗК.Вставить("ДатаПоследнейАкутализации", Неопределено);
	
	// Параметры зубов
	СтруктураПЗ = Новый Структура;
	СтруктураПЗ.Вставить("Используется", Ложь);
	СтруктураПЗ.Вставить("Загружены", Ложь);
	СтруктураПЗ.Вставить("РеквизитыЗагружены", Ложь);
	СтруктураПЗ.Вставить("НеВызыватьОбработчикСворачиванияРазворачивания", Ложь);
	СтруктураЗК.Вставить("ПараметрыЗубов", СтруктураПЗ);
	
	// История зубов
	СтруктураИЗ = Новый Структура;
	СтруктураИЗ.Вставить("Используется", Ложь);
	СтруктураИЗ.Вставить("Загружена", Ложь);
	СтруктураИЗ.Вставить("ИмяЭлемента", "");
	СтруктураИЗ.Вставить("Адрес", "");
	СтруктураИЗ.Вставить("СтруктураЗагружена", Ложь);
	СтруктураИЗ.Вставить("ПриложениеЗагружено", Ложь);
	СтруктураИЗ.Вставить("ВыбраннаяДата");
	СтруктураИЗ.Вставить("ДоступныеДаты", Новый Соответствие);
	СтруктураЗК.Вставить("ИсторияЗубов", СтруктураИЗ);
	
	Возврат СтруктураЗК;
	
КонецФункции


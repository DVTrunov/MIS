#Область ОбщаяОбработкаКоманд

// В модуле DICOM выбирается какой модуль будет обрабатывать ИмяКоманды, ИмяКоманды совпадает с функцией в конкретном модуле,
// Результат работы должен быть один HTTPЗапрос, который полностью сформирован на основе ПараметрыКоманды
Функция ОбработатьКомандуПоИмени(ИмяКоманды,НастройкиDICOM, ПараметрыКоманды) Экспорт
	
	Если ИмяКоманды = "ПолучитьКоличествоФрагментовУченияDCM4CHEE" Тогда		
		Возврат ПолучитьКоличествоФрагментовУченияDCM4CHEE(НастройкиDICOM,ПараметрыКоманды);

	ИначеЕсли ИмяКоманды = "СкачатьStudy" Тогда
		Возврат СкачатьStudy(НастройкиDICOM, ПараметрыКоманды); 
		
	ИначеЕсли ИмяКоманды = "ОтправитьДанныеMWL" Тогда
		Возврат ОтправитьДанныеMWL(НастройкиDICOM,ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = "НайтиПациентаВPACS" Тогда
		Возврат НайтиПациентаВPACS(НастройкиDICOM, ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = "СоздатьПациента" Тогда		
		Возврат СоздатьПациента(НастройкиDICOM,ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = "НайтиДанныеMWL" Тогда
		Возврат НайтиДанныеMWL(НастройкиDICOM,ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = "НайтиДанныеStudy" Тогда
		Возврат НайтиДанныеStudy(НастройкиDICOM,ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = "НайтиДанныеMPPS" Тогда
		Возврат НайтиДанныеMPPS(НастройкиDICOM,ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = "ОтменитьWorklist" Тогда
		Возврат ОтменитьWorklist(НастройкиDICOM,ПараметрыКоманды);
		
	КонецЕсли;
	
    Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область КомандыФормированияЗапросов

// функция, проверяющая наличие текущего пациента в программе
//
// Параметры:
//	НастройкиСистемыDICOM - СписокЗначений - Список настроек системы  
//	ПараметрыКоманды  - Структура - Содержит: PatientUID - Уид пациента (который Study, имеющий фрагменты),
//											чьи фрагменты мы хотим скачать
// Возвращаемое значение:
//   HTTPОтвет,Неопределено   - Если пациент был найден, то возвращается HTTPОтвет, иначе Неопредеделено, ЕСЛИ БЫЛ СОЗДАН ПАЦИЕНТ - он повторно ищется
//
Функция НайтиПациентаВPACS(НастройкиСистемыDICOM, ПараметрыКоманды)
		
	АдресРесурса = СтрШаблон("aets/%1/rs/patients", НастройкиСистемыDICOM.НайтиПоЗначению("AETLМенеджера").Представление);
	
	// Параметры задаются через Адрес Ресурса	
	МассивФильтровАтрибутов = Новый Массив;
    МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2", "PatientID",ПараметрыКоманды.PatientUID));
	МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2", "IssuerOfPatientID","1C"));
	//МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2","includefield","IssuerOfPatientID"));
	
	Запрос = ПолучитьЗапросDCM4CHEE(,АдресРесурса,,МассивФильтровАтрибутов);	
	
	Возврат Запрос;

КонецФункции

// Функция, Создающая пациента в PACS-сервере dcm4chee
//
// Параметры:
//	НастройкиСистемыDICOM - СписокЗначений - Список настроек системы  
//	ПараметрыКоманды  - Структура - В данной ситуации сама структура является исходными параметрами для тела запроса
// Возвращаемое значение:
//   HTTPОтвет,Неопределено   - Если пациент был найден, то возвращается HTTPОтвет, иначе Неопредеделено, ЕСЛИ БЫЛ СОЗДАН ПАЦИЕНТ - он повторно ищется
//
Функция СоздатьПациента(НастройкиСистемыDICOM, ПараметрыКоманды)

	ТелоЗапроса = ПолучитьJSONТелоДляDCM4CHEE(ПараметрыКоманды);	
	
	// /aets/{aet}/rs/patients	
	АдресРесурса = СтрШаблон("aets/%1/rs/patients", НастройкиСистемыDICOM.НайтиПоЗначению("AETLМенеджера").Представление);	
	Запрос = ПолучитьЗапросDCM4CHEE(ТелоЗапроса,АдресРесурса);
	
	Возврат Запрос;
	
КонецФункции

// Функция, которая скачивает Study. Важно, что при скачивании получается единый файл, то он сразу будет записан, а HTTPОтвет будет без двоичных данных 
//
// Параметры:
//	НастройкиСистемыDICOM - СписокЗначений - Список настроек системы  
//	ПараметрыКоманды  - Структура - Содержит: ФорматВозвращаемых - ФорматВозвращаемых учений, приведённый для запроса accept 
//                                  StudyUID - Уид учения (который Study, имеющий фрагменты), чьи фрагменты мы хотим скачать
//                                  ЭтоРендер - Булево значение - получаем ли мы заведомо рендер или нет
//	
Функция СкачатьStudy(НастройкиСистемыDICOM,ПараметрыКоманды)

	МассивФильтровАтрибутов = Новый Массив;
	МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2", "accept",ПараметрыКоманды.ФорматВозвращаемых));

	// Без этой кодировки данные вернутся побитыми, осторожно, сложная диагностика
	МассивПредстСтруктЗаголовковЗапроса = Новый Массив;    
	МассивПредстСтруктЗаголовковЗапроса.Добавить("Accept-Encoding"); 
	МассивПредстСтруктЗаголовковЗапроса.Добавить("identity");

	АдресРесурса = СтрШаблон("aets/%1/rs/studies/%2%3",НастройкиСистемыDICOM.НайтиПоЗначению("AETLМенеджера").Представление,
								ПараметрыКоманды.StudyUID,?(ПараметрыКоманды.ЭтоРендер,"/rendered",""));
	             
	Запрос = ПолучитьЗапросDCM4CHEE(,АдресРесурса,МассивПредстСтруктЗаголовковЗапроса,МассивФильтровАтрибутов);	
	
	Возврат Запрос;
	
КонецФункции

// Получаем количество (на текущий момент) Instances из конкретного Study в DCM4CHEE
//
// Параметры:
//	НастройкиСистемыDICOM - СписокЗначений - Список настроек системы  
//	ПараметрыКоманды  - Структура - Содержит: StudyUID - УИД учения, количество фрагментов которого мы ищем 
//	
Функция ПолучитьКоличествоФрагментовУченияDCM4CHEE(НастройкиСистемыDICOM,ПараметрыКоманды)
	                                                   
	//Параметры задаются через Адрес Ресурса	
	МассивФильтровАтрибутов = Новый Массив;
	МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2","StudyInstanceUID",ПараметрыКоманды.StudyUID));
	//МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2", "includefield","all")); 
	
	АдресРесурса = СтрШаблон("aets/%1/rs/instances/count", НастройкиСистемыDICOM.НайтиПоЗначению("AETLМенеджера").Представление);
	
	Запрос = ПолучитьЗапросDCM4CHEE(,АдресРесурса,,МассивФильтровАтрибутов);	
	
	Возврат Запрос;
КонецФункции

// Получаем Данные по Ворклистам (используется в основном для проверки наличия ворклистов как таковых)
//
// Параметры:
//	НастройкиСистемыDICOM - СписокЗначений - Список настроек системы  
//	ПараметрыКоманды  - Структура - Содержит: StudyUID - УИД учения, по которому мы проверяем ворклисты 
//
Функция НайтиДанныеMWL(НастройкиСистемыDICOM,ПараметрыКоманды)

	//Стандартные заголовки вызывают ошибку 406 - не тот тип, преобразуем на той стороне массив в структуру, нечётное - заголовок, чётное - значение
	СтруктураЗаголовковЗапроса = Новый Массив;
	СтруктураЗаголовковЗапроса.Добавить("Content-Type"); 
	СтруктураЗаголовковЗапроса.Добавить("application/dicom+json");
		
	МассивФильтровАтрибутов = Новый Массив;
	
	// ----Фильтр
	// filter, {attributeID}={value}; {attributeID} = {dicomTag} | {dicomKeyword} | {dicomTag}.{attributeID} | {dicomKeyword}.{attributeID}
	МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2", "StudyInstanceUID",ПараметрыКоманды.StudyUID));
	
	// ---Лимит по количеству
	// limit={maximumResults}
	//МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2", "limit","5"));	
	//-----Порядок
	//orderby=[-]{attributeID} (proprietary extension)
	//МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2", "orderby","f"));	
	//-----Дополнительно Доступные поля
	//МассивФильтровАтрибутов.Добавить(СтрШаблон("%1=%2", "includefield","all")); 
	
	АдресРесурса = СтрШаблон("aets/%1/rs/mwlitems", НастройкиСистемыDICOM.НайтиПоЗначению("AETLЛистов").Представление); 
	
	Запрос = ПолучитьЗапросDCM4CHEE(,АдресРесурса,,МассивФильтровАтрибутов);	
	 
	Возврат Запрос;

КонецФункции

// Получаем Данные по Ворклистам (используется в основном для проверки наличия ворклистов как таковых)
//
// Параметры:
//	НастройкиСистемыDICOM - СписокЗначений - Список настроек системы  
//	ПараметрыКоманды  - Структура - Содержит: StudyUID - УИД учения, по которому мы проверяем ворклисты 

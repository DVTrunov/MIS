Функция ПроверкаНаИсключениеИзВыработки(СписокНоменклатуры, Сотрудник, Филиал) Экспорт
	
	СписокВхождений = Новый Массив;
	
	Если СписокНоменклатуры.Количество() = 0 Тогда
		Возврат СписокВхождений;
	КонецЕсли;
	
	// Уникальная номенклатура (на входе колонка ТЧ, возможны дубли)
	УникальнаяНоменклатура = Новый Массив;
	КонтрольУникальности   = Новый Соответствие;
	Для Каждого Элемент Из СписокНоменклатуры Цикл
		Если ЗначениеЗаполнено(Элемент) И КонтрольУникальности[Элемент] = Неопределено Тогда
			КонтрольУникальности.Вставить(Элемент, Истина);
			УникальнаяНоменклатура.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Если УникальнаяНоменклатура.Количество() = 0 Тогда
		Возврат СписокВхождений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Настройки.Номенклатура КАК Номенклатура,
	|	Настройки.ЭтоИскл КАК ЭтоИскл,
	|	Настройки.Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	ВЫБОР
	|		КОГДА Настройки.Сотрудник = &Сотрудник
	|				И Настройки.Должность = &Должность
	|			ТОГДА 1
	|		КОГДА Настройки.Сотрудник = &Сотрудник
	|			ТОГДА 2
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	РегистрСведений.омг_НоменклатураВыработки КАК Настройки
	|ГДЕ
	|	Настройки.Филиал = &Филиал
	|	И (Настройки.Сотрудник = &Сотрудник
	|				И Настройки.Должность = &Должность
	|			ИЛИ Настройки.Сотрудник = &Сотрудник
	|				И Настройки.Должность = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|			ИЛИ Настройки.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|				И Настройки.Должность = &Должность)";
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Должность", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Должность"));
	Запрос.УстановитьПараметр("Филиал", Филиал);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		// Настроек по сотруднику/должности/филиалу нет - учитываемой номенклатуры нет
		Возврат СписокВхождений;
	КонецЕсли;
	
	// Индексы настроек: [Приоритет 1..3] -> Соответствие(Номенклатура -> ЭтоИскл).
	// Раздельно для элементов и групп. Если по одному ключу есть и исключение,
	// и вхождение - побеждает исключение (детерминированно).
	НастройкиЭлементов = Новый Массив(4);
	НастройкиГрупп     = Новый Массив(4);
	Для Инд = 1 По 3 Цикл
		НастройкиЭлементов[Инд] = Новый Соответствие;
		НастройкиГрупп[Инд]     = Новый Соответствие;
	КонецЦикла;
	
	ВыборкаНастроек = РезультатЗапроса.Выбрать();
	Пока ВыборкаНастроек.Следующий() Цикл
		
		Если ВыборкаНастроек.ЭтоГруппа Тогда
			МассивИндексов = НастройкиГрупп;
		Иначе
			МассивИндексов = НастройкиЭлементов;
		КонецЕсли;
		
		Индекс = МассивИндексов[ВыборкаНастроек.Приоритет];
		
		ТекущееЗначение = Индекс[ВыборкаНастроек.Номенклатура];
		Если ТекущееЗначение = Неопределено Тогда
			Индекс.Вставить(ВыборкаНастроек.Номенклатура, ВыборкаНастроек.ЭтоИскл);
		ИначеЕсли ВыборкаНастроек.ЭтоИскл И Не ТекущееЗначение Тогда
			Индекс.Вставить(ВыборкаНастроек.Номенклатура, Истина); // исключение приоритетнее вхождения
		КонецЕсли;
		
	КонецЦикла;
	
	// Цепочки родителей строятся плоскими запросами по уровням (без соединений).
	СоответствиеРодителей = омг_ДополнительныеАлгоритмы.ПолучитьЦепочкиРодителейНоменклатуры(УникальнаяНоменклатура);
	
	// Правило: элемент важнее группы; ближняя группа важнее дальней;
	// внутри уровня приоритет (Сотрудник+Должность) -> (Сотрудник) -> (Должность).
	// Первое найденное правило решает: ЭтоИскл -> не учитывать, иначе -> учитывать.
	// Если правил нет - номенклатура не учитывается (регистр = белый список).
	Для Каждого ТекНоменклатура Из УникальнаяНоменклатура Цикл
		
		Решение = Неопределено; // Неопределено - правило не найдено; Истина - исключить; Ложь - включить
		
		// 1. Правила по элементу
		Для Приоритет = 1 По 3 Цикл
			Решение = НастройкиЭлементов[Приоритет][ТекНоменклатура];
			Если Решение <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// 2. Правила по группам - от ближнего родителя к дальнему
		Если Решение = Неопределено Тогда
			
			ТекущийРодитель = СоответствиеРодителей.Получить(ТекНоменклатура);
			
			Пока ЗначениеЗаполнено(ТекущийРодитель) Цикл
				
				Для Приоритет = 1 По 3 Цикл
					Решение = НастройкиГрупп[Приоритет][ТекущийРодитель];
					Если Решение <> Неопределено Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если Решение <> Неопределено Тогда
					Прервать;
				КонецЕсли;
				
				ТекущийРодитель = СоответствиеРодителей.Получить(ТекущийРодитель);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Решение = Ложь Тогда
			СписокВхождений.Добавить(ТекНоменклатура);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокВхождений;
	
КонецФункции	       

Функция омг_УчетВыработки(ДатаДокумента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ВозЗначение = Ложь;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	омг_НастройкаУчетаВыработкипоЗПСрезПоследних.УчитыватьВыработкиЗП КАК УчитыватьВыработкиЗП
		|ИЗ
		|	РегистрСведений.омг_НастройкаУчетаВыработкипоЗП.СрезПоследних(&ДатаДокумента, ) КАК омг_НастройкаУчетаВыработкипоЗПСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
	ВозЗначение = ВыборкаДетальныеЗаписи.УчитыватьВыработкиЗП;	
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат ВозЗначение
		
КонецФункции

Процедура омг_ПриПроведенииВводаЗПИСписковНоменклатурыОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Если ТипЗНЧ(Источник) = Тип("ДокументОбъект.ВводСведенийОНачисленияхРаботников") Тогда
		
		ОбновитьСписокУслуг(Источник)
		
	Иначе
		
		ЗатронутыеУслуги = Неопределено;
		
		Если Источник.ДополнительныеСвойства.Свойство("омг_ЗатронутыеУслуги", ЗатронутыеУслуги)
			И ЗатронутыеУслуги.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	омг_СписокУслугПоСотрудникамДляЗП.ВводСведенийЗП КАК ВводСведенийЗП
			|ИЗ
			|	РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП КАК омг_СписокУслугПоСотрудникамДляЗП
			|ГДЕ
			|	омг_СписокУслугПоСотрудникамДляЗП.ДокументСписок = &ДокументСписок";
			
			Запрос.УстановитьПараметр("ДокументСписок", Источник.Ссылка);
			
			МассивВводовЗП = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВводСведенийЗП");
			
			Если МассивВводовЗП.Количество() > 0 Тогда
				ПатчСпискаУслугПоУслугам(Источник.Ссылка, ЗатронутыеУслуги, МассивВводовЗП);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	  
	
    УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура ОбновитьСписокУслуг(Источник)

	УстановитьПривилегированныйРежим(Истина);
	
	Если не Источник = неопределено Тогда
		
		ВТОсновынеНачисления = Источник.ОсновныеНачисления.Выгрузить();
		ВТОсновынеНачисления.Свернуть("Сотрудник,ВидРасчета,Действие,Показатель1,Показатель2");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|    ВТОсновынеНачисления.Сотрудник КАК Сотрудник,
		|    ВТОсновынеНачисления.ВидРасчета КАК ВидРасчета,
		|    ВТОсновынеНачисления.Действие КАК Действие,
		|    ВТОсновынеНачисления.Показатель1 КАК Показатель1,
		|    ВТОсновынеНачисления.Показатель2 КАК Показатель2
		|ПОМЕСТИТЬ ВтНачисления
		|ИЗ
		|    &ВТОсновынеНачисления КАК ВТОсновынеНачисления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ВтНачисления.Сотрудник КАК Сотрудник,
		|    Начисления.Ссылка КАК Ссылка,
		|    ВтНачисления.Показатель1 КАК Показатель1,
		|    ПараметрыРасчетаЗППараметры.Значение КАК Значение,
		|    ВтНачисления.Показатель2 КАК Показатель2,
		|    омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Услуга КАК Услуга,
		|    омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Приоритет КАК Приоритет,
		|    ВтНачисления.ВидРасчета КАК ВидРасчета,
		|    омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Ссылка КАК ДокументСписок,
		|    &ВводСведенийЗП КАК ВводСведенийЗП
		|ИЗ
		|    ВтНачисления КАК ВтНачисления
		|        ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовРасчета.Начисления КАК Начисления
		|        ПО ВтНачисления.ВидРасчета = Начисления.Ссылка
		|        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПараметрыРасчетаЗП.Параметры КАК ПараметрыРасчетаЗППараметры
		|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.омг_СпискиУслугДляРасчетаЗарплаты.УслугиПодробно КАК омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно
		|            ПО ПараметрыРасчетаЗППараметры.Значение = омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Ссылка
		|        ПО ВтНачисления.Показатель2 = ПараметрыРасчетаЗППараметры.Ссылка
		|ГДЕ
		|    ВтНачисления.Действие В(&СписокДействий)
		|    И Начисления.омг_ИспользуетсяПриоритизацияУслуг
		|    И омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Услуга ЕСТЬ НЕ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|    Сотрудник,
		|    ВтНачисления.ВидРасчета";
		
		СписокДействий = Новый СписокЗначений;
		СписокДействий.Добавить(Перечисления.ВидыДействияСНачислением.Начать);
		СписокДействий.Добавить(Перечисления.ВидыДействияСНачислением.НеИзменять);
		СписокДействий.Добавить(Перечисления.ВидыДействияСНачислением.Изменить);
		
		Запрос.УстановитьПараметр("СписокДействий",       СписокДействий);
		Запрос.УстановитьПараметр("ВТОсновынеНачисления", ВТОсновынеНачисления);
		Запрос.УстановитьПараметр("ВводСведенийЗП",       Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		ТабДвижения = РезультатЗапроса.Выгрузить();
		ТабДвижения.Свернуть("Сотрудник,Ссылка,Показатель1,Значение,Показатель2,Услуга,Приоритет,ВидРасчета,ДокументСписок,ВводСведенийЗП");
		
		Если ТабДвижения.Количество() = 0 Тогда
			Возврат; 
		КонецЕсли;

		МассивСотрудников = Новый Массив;
		МассивУслуг       = Новый Массив;
		
		СотрудникиУникальные = Новый Соответствие;
		УслугиУникальные     = Новый Соответствие;
		
		Для Каждого Строка Из ТабДвижения Цикл
			Если СотрудникиУникальные[Строка.Сотрудник] = Неопределено Тогда
				СотрудникиУникальные.Вставить(Строка.Сотрудник, Истина);
				МассивСотрудников.Добавить(Строка.Сотрудник);
			КонецЕсли;
			Если УслугиУникальные[Строка.Услуга] = Неопределено Тогда
				УслугиУникальные.Вставить(Строка.Услуга, Истина);
				МассивУслуг.Добавить(Строка.Услуга);
			КонецЕсли;
		КонецЦикла;
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлБлок1 = Блокировка.Добавить("РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП");
		ЭлБлок1.УстановитьЗначение("ВводСведенийЗП", Источник.Ссылка);
		ЭлБлок1.Режим = РежимБлокировкиДанных.Исключительный; 

		ТаблицаСотрудников = Новый ТаблицаЗначений;
		ТаблицаСотрудников.Колонки.Добавить("Сотрудник");
		Для Каждого ТекСотрудник Из МассивСотрудников Цикл
			ТаблицаСотрудников.Добавить().Сотрудник = ТекСотрудник;
		КонецЦикла;
		
		ЭлБлок2 = Блокировка.Добавить("РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП");
		ЭлБлок2.ИсточникДанных = ТаблицаСотрудников;
		ЭлБлок2.ИспользоватьИзИсточникаДанных("Сотрудник", "Сотрудник");
		ЭлБлок2.Режим = РежимБлокировкиДанных.Исключительный;
				
		ТаблицаУслуг = Новый ТаблицаЗначений;
		ТаблицаУслуг.Колонки.Добавить("Услуга");
		Для Каждого ТекУслуга Из МассивУслуг Цикл
			ТаблицаУслуг.Добавить().Услуга = ТекУслуга;
		КонецЦикла;
		
		ЭлБлок3 = Блокировка.Добавить("РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП");
		ЭлБлок3.ИсточникДанных = ТаблицаУслуг;
		ЭлБлок3.ИспользоватьИзИсточникаДанных("Услуга", "Услуга");
		ЭлБлок3.Режим = РежимБлокировкиДанных.Исключительный;
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка.Заблокировать();
			
			СписокЗаписей = РегистрыСведений.омг_СписокУслугПоСотрудникамДляЗП.СоздатьНаборЗаписей();
			СписокЗаписей.Отбор.ВводСведенийЗП.Установить(Источник.Ссылка);
			СписокЗаписей.Загрузить(ТабДвижения);
			СписокЗаписей.Записать(); 
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			//ЗаписьЖурналаРегистрации(
			//"омг_СписокУслугПоСотрудникамДляЗП",
			//УровеньЖурналаРегистрации.Ошибка,
			//,
			//Источник.Ссылка,
			//ОписаниеОшибки()
			//);
			
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЕсли;        
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры	

// Точечно пересчитывает и перезаписывает записи регистра
// омг_СписокУслугПоСотрудникамДляЗП только для заданного подмножества услуг
// заданного документа-списка.
//
// Параметры:
//  ДокументСписок - ДокументСсылка.омг_СпискиУслугДляРасчетаЗарплаты
//  МассивУслуг    - Массив из СправочникСсылка.Номенклатура - какие услуги патчим
//  МассивВводовЗП - Массив ссылок ВводСведенийЗП, сужает поиск начислений.
//                   Неопределено - без сужения (тяжёлый путь).
Процедура ПатчСпискаУслугПоУслугам(ДокументСписок, МассивУслуг, МассивВводовЗП = Неопределено) Экспорт
	
	Если МассивУслуг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивВводовЗП <> Неопределено И МассивВводовЗП.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ТекстФильтраНачислений = "";
	Если МассивВводовЗП <> Неопределено Тогда
		ТекстФильтраНачислений = "И ОсновныеНачисления.Ссылка В(&МассивВводовЗП)";
		Запрос.УстановитьПараметр("МассивВводовЗП", МассивВводовЗП);
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|    ОсновныеНачисления.Ссылка      КАК ВводСведенийЗП,
	|    ОсновныеНачисления.Сотрудник   КАК Сотрудник,
	|    ОсновныеНачисления.ВидРасчета  КАК ВидРасчета,
	|    ОсновныеНачисления.Действие    КАК Действие,
	|    ОсновныеНачисления.Показатель1 КАК Показатель1,
	|    ОсновныеНачисления.Показатель2 КАК Показатель2
	|ПОМЕСТИТЬ ВтНачисления
	|ИЗ
	|    Документ.ВводСведенийОНачисленияхРаботников.ОсновныеНачисления КАК ОсновныеНачисления
	|ГДЕ
	|    ОсновныеНачисления.Действие В(&СписокДействий)
	|    " + ТекстФильтраНачислений + "
	|
	|СГРУППИРОВАТЬ ПО
	|    ОсновныеНачисления.Ссылка,
	|    ОсновныеНачисления.Сотрудник,
	|    ОсновныеНачисления.ВидРасчета,
	|    ОсновныеНачисления.Действие,
	|    ОсновныеНачисления.Показатель1,
	|    ОсновныеНачисления.Показатель2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|    ВтНачисления.Сотрудник КАК Сотрудник,
	|    Начисления.Ссылка КАК Ссылка,
	|    ВтНачисления.Показатель1 КАК Показатель1,
	|    ПараметрыРасчетаЗППараметры.Значение КАК Значение,
	|    ВтНачисления.Показатель2 КАК Показатель2,
	|    омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Услуга КАК Услуга,
	|    омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Приоритет КАК Приоритет,
	|    ВтНачисления.ВидРасчета КАК ВидРасчета,
	|    омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Ссылка КАК ДокументСписок,
	|    ВтНачисления.ВводСведенийЗП КАК ВводСведенийЗП
	|ИЗ
	|    ВтНачисления КАК ВтНачисления
	|        ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовРасчета.Начисления КАК Начисления
	|        ПО ВтНачисления.ВидРасчета = Начисления.Ссылка
	|        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПараметрыРасчетаЗП.Параметры КАК ПараметрыРасчетаЗППараметры
	|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.омг_СпискиУслугДляРасчетаЗарплаты.УслугиПодробно КАК омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно
	|            ПО ПараметрыРасчетаЗППараметры.Значение = омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Ссылка
	|                И омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Ссылка = &ДокументСписок
	|                И омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Услуга В (&МассивУслуг)
	|        ПО ВтНачисления.Показатель2 = ПараметрыРасчетаЗППараметры.Ссылка
	|ГДЕ
	|    Начисления.омг_ИспользуетсяПриоритизацияУслуг
	|    И омг_СпискиУслугДляРасчетаЗарплатыУслугиПодробно.Услуга ЕСТЬ НЕ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|    Сотрудник,
	|    ВтНачисления.ВидРасчета";
	
	СписокДействий = Новый СписокЗначений;
	СписокДействий.Добавить(Перечисления.ВидыДействияСНачислением.Начать);
	СписокДействий.Добавить(Перечисления.ВидыДействияСНачислением.НеИзменять);
	СписокДействий.Добавить(Перечисления.ВидыДействияСНачислением.Изменить);
	
	Запрос.УстановитьПараметр("СписокДействий", СписокДействий);
	Запрос.УстановитьПараметр("ДокументСписок",  ДокументСписок);
	Запрос.УстановитьПараметр("МассивУслуг",     МассивУслуг);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТабДвижения = РезультатЗапроса.Выгрузить();
	ТабДвижения.Свернуть("Сотрудник,Ссылка,Показатель1,Значение,Показатель2,Услуга,Приоритет,ВидРасчета,ДокументСписок,ВводСведенийЗП");
	ТабДвижения.Индексы.Добавить("Услуга");
	
	Блокировка = Новый БлокировкаДанных;
	
	ТаблицаУслуг = Новый ТаблицаЗначений;
	ТаблицаУслуг.Колонки.Добавить("Услуга");
	Для Каждого ТекУслуга Из МассивУслуг Цикл
		ТаблицаУслуг.Добавить().Услуга = ТекУслуга;
	КонецЦикла;
	
	ЭлБлок = Блокировка.Добавить("РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП");
	ЭлБлок.УстановитьЗначение("ДокументСписок", ДокументСписок);
	ЭлБлок.ИсточникДанных = ТаблицаУслуг;
	ЭлБлок.ИспользоватьИзИсточникаДанных("Услуга", "Услуга");
	ЭлБлок.Режим = РежимБлокировкиДанных.Исключительный;
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка.Заблокировать();
		
		Для Каждого ТекУслуга Из МассивУслуг Цикл
			
			СтрокиУслуги      = ТабДвижения.НайтиСтроки(Новый Структура("Услуга", ТекУслуга));
			ТабДвиженияУслуги = ТабДвижения.Скопировать(СтрокиУслуги);
			
			СписокЗаписей = РегистрыСведений.омг_СписокУслугПоСотрудникамДляЗП.СоздатьНаборЗаписей();
			СписокЗаписей.Отбор.ДокументСписок.Установить(ДокументСписок);
			СписокЗаписей.Отбор.Услуга.Установить(ТекУслуга);
			СписокЗаписей.Загрузить(ТабДвиженияУслуги);
			СписокЗаписей.Записать();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Функция ПроверкаНаПриоритизациюУслуг(ОбъектПроверки) Экспорт
	
	ВозНачение = Ложь;
	
	Если ТипЗнч(ОбъектПроверки) = Тип("СправочникСсылка.ПараметрыРасчетаЗП") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыРасчетаЗП.омг_ИспользуетсяПриоритизацияУслуг КАК омг_ИспользуетсяПриоритизацияУслуг
		|ИЗ
		|	Справочник.ПараметрыРасчетаЗП КАК ПараметрыРасчетаЗП
		|ГДЕ
		|	ПараметрыРасчетаЗП.Ссылка = &ОбъектПроверки";
		
		Запрос.УстановитьПараметр("ОбъектПроверки", ОбъектПроверки);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ВозНачение = ВыборкаДетальныеЗаписи.омг_ИспользуетсяПриоритизацияУслуг
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат ВозНачение;
	
КонецФункции

Функция ВернутьАктуальнуюШкалу(Шкала,Дата) Экспорт	
	
	ТабВозв = Новый ТаблицаЗначений;
	ТабВозв.Колонки.Добавить("ЗначениеС",Новый ОписаниеТипов("Число"));	
	ТабВозв.Колонки.Добавить("ЗначениеПо",Новый ОписаниеТипов("Число"));	
	ТабВозв.Колонки.Добавить("Размер",Новый ОписаниеТипов("Число"));	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШкалыРасчетаСоставШкалы.ЗначениеС КАК ЗначениеС,
	|	ШкалыРасчетаСоставШкалы.ЗначениеПо КАК ЗначениеПо,
	|	ШкалыРасчетаСоставШкалы.Размер КАК Размер,
	|	ШкалыРасчетаСоставШкалы.омг_Период КАК омг_Период
	|ИЗ
	|	Справочник.ШкалыРасчета.СоставШкалы КАК ШкалыРасчетаСоставШкалы
	|ГДЕ
	|	ШкалыРасчетаСоставШкалы.Ссылка = &Шкала
	|	И ШкалыРасчетаСоставШкалы.омг_Период <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ШкалыРасчетаСоставШкалы.омг_Период УБЫВ,
	|	ШкалыРасчетаСоставШкалы.ЗначениеС";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Шкала", Шкала);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Сч = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если Сч = 0 Тогда 
			ЗаполнитьЗначенияСвойств(ТабВозв.Добавить(),ВыборкаДетальныеЗаписи); 
			Сч = 1;
			ДатаСтроки = ВыборкаДетальныеЗаписи.омг_Период;
			Продолжить;
		КонецЕсли; 
		
		Если ДатаСтроки = ВыборкаДетальныеЗаписи.омг_Период Тогда 
			ЗаполнитьЗначенияСвойств(ТабВозв.Добавить(),ВыборкаДетальныеЗаписи);
		иначе
			Возврат ТабВозв
		КонецЕсли;  
		
	КонецЦикла;
	
	Возврат ТабВозв;
	
КонецФункции

Функция ВернутьФилиалыПоОрганизации(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Филиалы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Филиалы КАК Филиалы
		|ГДЕ
		|	Филиалы.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	Филиалы.Ссылка";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции	
    
// Два прохода. Первый - расхождение из-за смены номенклатуры (дифф текущего
// УслугиПодробно и свежего пересчёта). Второй - "осиротевшие" пары
// (ДокументСписок, Услуга), которые есть в документе, но ни разу не попали в
// регистр (закрывает дыру, не зависящую от диффа). Не зависит от константы -
// подписка на запись номенклатуры убрана, гоняется безусловно по расписанию.
Процедура АктуализацияПараметровРасчетаЗП() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	омг_СпискиУслугДляРасчетаЗарплаты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.омг_СпискиУслугДляРасчетаЗарплаты КАК омг_СпискиУслугДляРасчетаЗарплаты
	|ГДЕ
	|	омг_СпискиУслугДляРасчетаЗарплаты.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.Ссылка КАК Ссылка,
	|	Услуги.Услуга КАК Услуга
	|ИЗ
	|	Документ.омг_СпискиУслугДляРасчетаЗарплаты.Услуги КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УслугиПодробно.Ссылка               КАК Ссылка,
	|	УслугиПодробно.Услуга               КАК Услуга,
	|	УслугиПодробно.Приоритет            КАК Приоритет,
	|	УслугиПодробно.ИсходнаяУслугаГруппа КАК ИсходнаяУслугаГруппа
	|ИЗ
	|	Документ.омг_СпискиУслугДляРасчетаЗарплаты.УслугиПодробно КАК УслугиПодробно
	|ГДЕ
	|	УслугиПодробно.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УслугиПодробно.Ссылка КАК ДокументСписок,
	|	УслугиПодробно.Услуга КАК Услуга
	|ИЗ
	|	Документ.омг_СпискиУслугДляРасчетаЗарплаты.УслугиПодробно КАК УслугиПодробно
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				омг_СписокУслугПоСотрудникамДляЗП.ДокументСписок КАК ДокументСписок,
	|				омг_СписокУслугПоСотрудникамДляЗП.Услуга КАК Услуга
	|			ИЗ
	|				РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП КАК омг_СписокУслугПоСотрудникамДляЗП
	|		) КАК СуществующиеПары
	|		ПО УслугиПодробно.Ссылка = СуществующиеПары.ДокументСписок
	|			И УслугиПодробно.Услуга = СуществующиеПары.Услуга
	|ГДЕ
	|	УслугиПодробно.Ссылка.Проведен
	|	И СуществующиеПары.ДокументСписок ЕСТЬ NULL";
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	
	СпДокументов        = РезультатПакета[0].Выгрузить().ВыгрузитьКолонку("Ссылка");
	ТабУслуги           = РезультатПакета[1].Выгрузить();
	ТабУслугиПодробно   = РезультатПакета[2].Выгрузить();
	ТабОсиротевшихПар   = РезультатПакета[3].Выгрузить();
	
	ТабУслуги.Индексы.Добавить("Ссылка");
	ТабУслугиПодробно.Индексы.Добавить("Ссылка");
	ТабОсиротевшихПар.Индексы.Добавить("ДокументСписок");
	
	МассивНоменклатуры = ТабУслуги.ВыгрузитьКолонку("Услуга");
	СоответствиеЭтоГруппа = Новый Соответствие;
	Если МассивНоменклатуры.Количество() > 0 Тогда
		СоответствиеЭтоГруппа = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивНоменклатуры, "ЭтоГруппа");
	КонецЕсли;
	
	ОбработаноПар = Новый Соответствие;
	
	Для Каждого ТекДокумент Из СпДокументов Цикл
		
		СтрокиУслуг = ТабУслуги.НайтиСтроки(Новый Структура("Ссылка", ТекДокумент));
		
		МассивГрупп        = Новый Массив;
		МассивПрямыеУслуги = Новый Массив;
		
		Для Каждого СтрокаУслуги Из СтрокиУслуг Цикл
			Если СоответствиеЭтоГруппа.Получить(СтрокаУслуги.Услуга).ЭтоГруппа Тогда
				МассивГрупп.Добавить(СтрокаУслуги.Услуга);
			Иначе
				МассивПрямыеУслуги.Добавить(СтрокаУслуги.Услуга);
			КонецЕсли;
		КонецЦикла;
		
		СвежаяТаблица = Новый ТаблицаЗначений;
		СвежаяТаблица.Колонки.Добавить("Услуга",               Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		СвежаяТаблица.Колонки.Добавить("Приоритет",            Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
		СвежаяТаблица.Колонки.Добавить("ИсходнаяУслугаГруппа", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		
		Для Каждого ТекУслуга Из МассивПрямыеУслуги Цикл
			НоваяСтрока = СвежаяТаблица.Добавить();
			НоваяСтрока.Услуга    = ТекУслуга;
			НоваяСтрока.Приоритет = 1;
		КонецЦикла;
		
		Если МассивГрупп.Количество() > 0 Тогда
			ИзГрупп = омг_ДополнительныеАлгоритмы.ВернутьСписокУслугСприоритетом(МассивГрупп);
			Для Каждого Строка Из ИзГрупп Цикл
				НоваяСтрока = СвежаяТаблица.Добавить();
				НоваяСтрока.Услуга               = Строка.Услуга;
				НоваяСтрока.Приоритет            = Строка.Приоритет;
				НоваяСтрока.ИсходнаяУслугаГруппа = Строка.ИсходнаяУслугаГруппа;
			КонецЦикла;
		КонецЕсли;
		
		СтрокиТекущие  = ТабУслугиПодробно.НайтиСтроки(Новый Структура("Ссылка", ТекДокумент));
		ТекущаяТаблица = ТабУслугиПодробно.Скопировать(СтрокиТекущие, "Услуга,Приоритет,ИсходнаяУслугаГруппа");
		
		Дифф = омг_ДополнительныеАлгоритмы.ВычислитьДиффУслуг(ТекущаяТаблица, СвежаяТаблица);
		
		ЗатронутыеУслуги = Новый Массив;
		Для Каждого Элемент Из Дифф.Удаленные Цикл
			ЗатронутыеУслуги.Добавить(Элемент);
		КонецЦикла;
		Для Каждого Элемент Из Дифф.Добавленные Цикл
			ЗатронутыеУслуги.Добавить(Элемент);
		КонецЦикла;
		Для Каждого Элемент Из Дифф.Измененные Цикл
			ЗатронутыеУслуги.Добавить(Элемент);
		КонецЦикла;
		
		Если ЗатронутыеУслуги.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			ЗапросКандидатов = Новый Запрос;
			ЗапросКандидатов.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	омг_СписокУслугПоСотрудникамДляЗП.ВводСведенийЗП КАК ВводСведенийЗП
			|ИЗ
			|	РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП КАК омг_СписокУслугПоСотрудникамДляЗП
			|ГДЕ
			|	омг_СписокУслугПоСотрудникамДляЗП.ДокументСписок = &ДокументСписок";
			
			ЗапросКандидатов.УстановитьПараметр("ДокументСписок", ТекДокумент);
			
			МассивВводовЗП = ЗапросКандидатов.Выполнить().Выгрузить().ВыгрузитьКолонку("ВводСведенийЗП");
			
			Если МассивВводовЗП.Количество() > 0 Тогда
				ПатчСпискаУслугПоУслугам(ТекДокумент, ЗатронутыеУслуги, МассивВводовЗП);
			Иначе
				ПатчСпискаУслугПоУслугам(ТекДокумент, ЗатронутыеУслуги, Неопределено);
			КонецЕсли;
			
			Для Каждого ТекУслуга Из ЗатронутыеУслуги Цикл
				ОбработаноПар.Вставить(XMLСтрока(ТекДокумент) + "|" + XMLСтрока(ТекУслуга), Истина);
			КонецЦикла;
			
			ДокОбъект = ТекДокумент.ПолучитьОбъект();
			ДокОбъект.Записать();
			
		Исключение
			
			ЗаписьЖурналаРегистрации(
			"Актуализация параметров расчета ЗП",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ТекДокумент,
			ОписаниеОшибки()
			);
			
		КонецПопытки;
		
	КонецЦикла;
	
	СпДокументовСОсиротевшими = ТабОсиротевшихПар.ВыгрузитьКолонку("ДокументСписок");
	УникальныеДокументы = Новый Соответствие;
	Для Каждого Док Из СпДокументовСОсиротевшими Цикл
		УникальныеДокументы.Вставить(Док, Истина);
	КонецЦикла;
	
	Для Каждого КлючЗначение Из УникальныеДокументы Цикл
		
		ТекДокумент = КлючЗначение.Ключ;
		
		СтрокиПар = ТабОсиротевшихПар.НайтиСтроки(Новый Структура("ДокументСписок", ТекДокумент));
		
		МассивОсиротевшихУслуг = Новый Массив;
		Для Каждого СтрокаПары Из СтрокиПар Цикл
			Ключ = XMLСтрока(ТекДокумент) + "|" + XMLСтрока(СтрокаПары.Услуга);
			Если ОбработаноПар.Получить(Ключ) = Неопределено Тогда
				МассивОсиротевшихУслуг.Добавить(СтрокаПары.Услуга);
			КонецЕсли;
		КонецЦикла;
		
		Если МассивОсиротевшихУслуг.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			ПатчСпискаУслугПоУслугам(ТекДокумент, МассивОсиротевшихУслуг, Неопределено);
			
		Исключение
			
			ЗаписьЖурналаРегистрации(
			"Актуализация параметров расчета ЗП (осиротевшие пары)",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ТекДокумент,
			ОписаниеОшибки()
			);
			
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ПроверкаНаИсключениеИзВыработкиПоСотрудникам(СписокНоменклатуры, МассивСотрудников, Филиал) Экспорт
	
	Результат = Новый Соответствие;
	
	// Уникальные сотрудники; ключи результата - сразу для всех
	УникальныеСотрудники = Новый Массив;
	КонтрольСотрудников  = Новый Соответствие;
	Для Каждого ТекСотрудник Из МассивСотрудников Цикл
		Если Результат[ТекСотрудник] = Неопределено Тогда
			Результат.Вставить(ТекСотрудник, Новый Массив);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекСотрудник) И КонтрольСотрудников[ТекСотрудник] = Неопределено Тогда
			КонтрольСотрудников.Вставить(ТекСотрудник, Истина);
			УникальныеСотрудники.Добавить(ТекСотрудник);
		КонецЕсли;
	КонецЦикла;
	
	// Уникальная номенклатура
	УникальнаяНоменклатура = Новый Массив;
	КонтрольНоменклатуры   = Новый Соответствие;
	Для Каждого Элемент Из СписокНоменклатуры Цикл
		Если ЗначениеЗаполнено(Элемент) И КонтрольНоменклатуры[Элемент] = Неопределено Тогда
			КонтрольНоменклатуры.Вставить(Элемент, Истина);
			УникальнаяНоменклатура.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Если УникальныеСотрудники.Количество() = 0 Или УникальнаяНоменклатура.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.Должность КАК Должность
	|ПОМЕСТИТЬ ВТСотрудники
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&МассивСотрудников)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТСотрудники.Сотрудник КАК Сотрудник,
	|	Настройки.Номенклатура КАК Номенклатура,
	|	Настройки.ЭтоИскл КАК ЭтоИскл,
	|	Настройки.Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	ВЫБОР
	|		КОГДА Настройки.Сотрудник = ВТСотрудники.Сотрудник
	|				И Настройки.Должность = ВТСотрудники.Должность
	|			ТОГДА 1
	|		КОГДА Настройки.Сотрудник = ВТСотрудники.Сотрудник
	|			ТОГДА 2
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	ВТСотрудники КАК ВТСотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.омг_НоменклатураВыработки КАК Настройки
	|		ПО (Настройки.Филиал = &Филиал)
	|			И (Настройки.Сотрудник = ВТСотрудники.Сотрудник
	|					И Настройки.Должность = ВТСотрудники.Должность
	|				ИЛИ Настройки.Сотрудник = ВТСотрудники.Сотрудник
	|					И Настройки.Должность = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|				ИЛИ Настройки.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|					И Настройки.Должность = ВТСотрудники.Должность)";
	
	Запрос.УстановитьПараметр("МассивСотрудников", УникальныеСотрудники);
	Запрос.УстановитьПараметр("Филиал", Филиал);
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	
	Если РезультатПакета[1].Пустой() Тогда
		// Настроек нет ни по одному сотруднику - учитываемой номенклатуры нет
		Возврат Результат;
	КонецЕсли;
	
	// Индексы настроек по сотрудникам:
	// Сотрудник -> Структура(Элементы, Группы), где каждое - Массив(4) из Соответствий
	// [Приоритет 1..3] -> (Номенклатура -> ЭтоИскл)
	ИндексыПоСотрудникам = Новый Соответствие;
	
	ВыборкаНастроек = РезультатПакета[1].Выбрать();
	Пока ВыборкаНастроек.Следующий() Цикл
		
		ИндексыСотрудника = ИндексыПоСотрудникам[ВыборкаНастроек.Сотрудник];
		Если ИндексыСотрудника = Неопределено Тогда
			НастройкиЭлементов = Новый Массив(4);
			НастройкиГрупп     = Новый Массив(4);
			Для Инд = 1 По 3 Цикл
				НастройкиЭлементов[Инд] = Новый Соответствие;
				НастройкиГрупп[Инд]     = Новый Соответствие;
			КонецЦикла;
			ИндексыСотрудника = Новый Структура("Элементы, Группы", НастройкиЭлементов, НастройкиГрупп);
			ИндексыПоСотрудникам.Вставить(ВыборкаНастроек.Сотрудник, ИндексыСотрудника);
		КонецЕсли;
		
		Если ВыборкаНастроек.ЭтоГруппа Тогда
			МассивИндексов = ИндексыСотрудника.Группы;
		Иначе
			МассивИндексов = ИндексыСотрудника.Элементы;
		КонецЕсли;
		
		Индекс = МассивИндексов[ВыборкаНастроек.Приоритет];
		
		ТекущееЗначение = Индекс[ВыборкаНастроек.Номенклатура];
		Если ТекущееЗначение = Неопределено Тогда
			Индекс.Вставить(ВыборкаНастроек.Номенклатура, ВыборкаНастроек.ЭтоИскл);
		ИначеЕсли ВыборкаНастроек.ЭтоИскл И Не ТекущееЗначение Тогда
			Индекс.Вставить(ВыборкаНастроек.Номенклатура, Истина); // исключение приоритетнее вхождения
		КонецЕсли;
		
	КонецЦикла;
	
	// Цепочки родителей строятся один раз для всей номенклатуры и переиспользуются
	// для всех сотрудников - плоские запросы по уровням, без соединений.
	СоответствиеРодителей = омг_ДополнительныеАлгоритмы.ПолучитьЦепочкиРодителейНоменклатуры(УникальнаяНоменклатура);
	
	// Правило (как в одиночной версии): элемент важнее группы; ближняя группа
	// важнее дальней; внутри уровня приоритет 1 -> 2 -> 3. Первое найденное
	// правило решает: ЭтоИскл -> не учитывать, иначе -> учитывать.
	// Нет правил - не учитывать (регистр = белый список).
	Для Каждого ТекСотрудник Из УникальныеСотрудники Цикл
		
		ИндексыСотрудника = ИндексыПоСотрудникам[ТекСотрудник];
		Если ИндексыСотрудника = Неопределено Тогда
			Продолжить; // настроек нет - массив остается пустым
		КонецЕсли;
		
		НастройкиЭлементов = ИндексыСотрудника.Элементы;
		НастройкиГрупп     = ИндексыСотрудника.Группы;
		СписокВхождений    = Результат[ТекСотрудник];
		
		Для Каждого ТекНоменклатура Из УникальнаяНоменклатура Цикл
			
			Решение = Неопределено;
			
			// 1. Правила по элементу
			Для Приоритет = 1 По 3 Цикл
				Решение = НастройкиЭлементов[Приоритет][ТекНоменклатура];
				Если Решение <> Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// 2. Правила по группам - от ближнего родителя к дальнему
			Если Решение = Неопределено Тогда
				
				ТекущийРодитель = СоответствиеРодителей.Получить(ТекНоменклатура);
				
				Пока ЗначениеЗаполнено(ТекущийРодитель) Цикл
					
					Для Приоритет = 1 По 3 Цикл
						Решение = НастройкиГрупп[Приоритет][ТекущийРодитель];
						Если Решение <> Неопределено Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если Решение <> Неопределено Тогда
						Прервать;
					КонецЕсли;
					
					ТекущийРодитель = СоответствиеРодителей.Получить(ТекущийРодитель);
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если Решение = Ложь Тогда
				СписокВхождений.Добавить(ТекНоменклатура);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Точечно актуализирует параметры расчёта ЗП для ОДНОГО документа "Список услуг" -
// та же логика (дифф + патч регистра + осиротевшие пары), что ночная
// АктуализацияПараметровРасчетаЗП, но без перебора всех документов. Для
// немедленной актуализации по конкретному списку, не дожидаясь ночи.
//
// Параметры:
//  ДокументСписок - ДокументСсылка.омг_СпискиУслугДляРасчетаЗарплаты
//
// Возвращаемое значение:
//  Структура(Успех, Сообщение, КоличествоЗатронутыхУслуг)
Функция АктуализироватьПараметрыРасчетаЗПДляДокумента(ДокументСписок) Экспорт
	
	Результат = Новый Структура("Успех, Сообщение, КоличествоЗатронутыхУслуг", Ложь, "", 0);
	
	Если Не ЗначениеЗаполнено(ДокументСписок) Тогда
		Результат.Сообщение = "Не указан документ";
		Возврат Результат;
	КонецЕсли;
	
	Если Не ДокументСписок.Проведен Тогда
		Результат.Успех    = Истина;
		Результат.Сообщение = "Документ не проведён - актуализация не требуется";
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Услуги.Услуга КАК Услуга
		|ИЗ
		|	Документ.омг_СпискиУслугДляРасчетаЗарплаты.Услуги КАК Услуги
		|ГДЕ
		|	Услуги.Ссылка = &ДокументСписок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УслугиПодробно.Услуга               КАК Услуга,
		|	УслугиПодробно.Приоритет            КАК Приоритет,
		|	УслугиПодробно.ИсходнаяУслугаГруппа КАК ИсходнаяУслугаГруппа
		|ИЗ
		|	Документ.омг_СпискиУслугДляРасчетаЗарплаты.УслугиПодробно КАК УслугиПодробно
		|ГДЕ
		|	УслугиПодробно.Ссылка = &ДокументСписок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УслугиПодробно.Услуга КАК Услуга
		|ИЗ
		|	Документ.омг_СпискиУслугДляРасчетаЗарплаты.УслугиПодробно КАК УслугиПодробно
		|		ЛЕВОЕ СОЕДИНЕНИЕ (
		|			ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				омг_СписокУслугПоСотрудникамДляЗП.Услуга КАК Услуга
		|			ИЗ
		|				РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП КАК омг_СписокУслугПоСотрудникамДляЗП
		|			ГДЕ
		|				омг_СписокУслугПоСотрудникамДляЗП.ДокументСписок = &ДокументСписок
		|		) КАК СуществующиеПары
		|		ПО УслугиПодробно.Услуга = СуществующиеПары.Услуга
		|ГДЕ
		|	УслугиПодробно.Ссылка = &ДокументСписок
		|	И СуществующиеПары.Услуга ЕСТЬ NULL";
		
		Запрос.УстановитьПараметр("ДокументСписок", ДокументСписок);
		
		РезультатПакета = Запрос.ВыполнитьПакет();
		
		ТабУслуги         = РезультатПакета[0].Выгрузить();
		ТабУслугиПодробно = РезультатПакета[1].Выгрузить();
		ТабОсиротевшихПар = РезультатПакета[2].Выгрузить();
		
		МассивНоменклатуры = ТабУслуги.ВыгрузитьКолонку("Услуга");
		СоответствиеЭтоГруппа = Новый Соответствие;
		Если МассивНоменклатуры.Количество() > 0 Тогда
			СоответствиеЭтоГруппа = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивНоменклатуры, "ЭтоГруппа");
		КонецЕсли;
		
		МассивГрупп        = Новый Массив;
		МассивПрямыеУслуги = Новый Массив;
		
		Для Каждого СтрокаУслуги Из ТабУслуги Цикл
			Если СоответствиеЭтоГруппа.Получить(СтрокаУслуги.Услуга).ЭтоГруппа Тогда
				МассивГрупп.Добавить(СтрокаУслуги.Услуга);
			Иначе
				МассивПрямыеУслуги.Добавить(СтрокаУслуги.Услуга);
			КонецЕсли;
		КонецЦикла;
		
		СвежаяТаблица = Новый ТаблицаЗначений;
		СвежаяТаблица.Колонки.Добавить("Услуга",               Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		СвежаяТаблица.Колонки.Добавить("Приоритет",            Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
		СвежаяТаблица.Колонки.Добавить("ИсходнаяУслугаГруппа", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		
		Для Каждого ТекУслуга Из МассивПрямыеУслуги Цикл
			НоваяСтрока = СвежаяТаблица.Добавить();
			НоваяСтрока.Услуга    = ТекУслуга;
			НоваяСтрока.Приоритет = 1;
		КонецЦикла;
		
		Если МассивГрупп.Количество() > 0 Тогда
			ИзГрупп = омг_ДополнительныеАлгоритмы.ВернутьСписокУслугСприоритетом(МассивГрупп);
			Для Каждого Строка Из ИзГрупп Цикл
				НоваяСтрока = СвежаяТаблица.Добавить();
				НоваяСтрока.Услуга               = Строка.Услуга;
				НоваяСтрока.Приоритет            = Строка.Приоритет;
				НоваяСтрока.ИсходнаяУслугаГруппа = Строка.ИсходнаяУслугаГруппа;
			КонецЦикла;
		КонецЕсли;
		
		Дифф = омг_ДополнительныеАлгоритмы.ВычислитьДиффУслуг(ТабУслугиПодробно, СвежаяТаблица);
		
		ЗатронутыеУслуги = Новый Массив;
		Обработано        = Новый Соответствие;
		Для Каждого Элемент Из Дифф.Удаленные Цикл
			ЗатронутыеУслуги.Добавить(Элемент);
		КонецЦикла;
		Для Каждого Элемент Из Дифф.Добавленные Цикл
			ЗатронутыеУслуги.Добавить(Элемент);
		КонецЦикла;
		Для Каждого Элемент Из Дифф.Измененные Цикл
			ЗатронутыеУслуги.Добавить(Элемент);
		КонецЦикла;
		
		Если ЗатронутыеУслуги.Количество() > 0 Тогда
    
    ЗапросКандидатов = Новый Запрос;
    ЗапросКандидатов.Текст = 
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |	омг_СписокУслугПоСотрудникамДляЗП.ВводСведенийЗП КАК ВводСведенийЗП
    |ИЗ
    |	РегистрСведений.омг_СписокУслугПоСотрудникамДляЗП КАК омг_СписокУслугПоСотрудникамДляЗП
    |ГДЕ
    |	омг_СписокУслугПоСотрудникамДляЗП.ДокументСписок = &ДокументСписок";
    
    ЗапросКандидатов.УстановитьПараметр("ДокументСписок", ДокументСписок);
    
    МассивВводовЗП = ЗапросКандидатов.Выполнить().Выгрузить().ВыгрузитьКолонку("ВводСведенийЗП");
    
    // Сначала пересохранить документ (см. комментарий в АктуализацияПараметровРасчетаЗП) -
    // патч читает УслугиПодробно из БД запросом, должен идти после записи.
    ДокОбъект = ДокументСписок.ПолучитьОбъект();
    ДокОбъект.Записать();
    
    Если МассивВводовЗП.Количество() > 0 Тогда
        ПатчСпискаУслугПоУслугам(ДокументСписок, ЗатронутыеУслуги, МассивВводовЗП);
    Иначе
        ПатчСпискаУслугПоУслугам(ДокументСписок, ЗатронутыеУслуги, Неопределено);
    КонецЕсли;
    
    Для Каждого ТекУслуга Из ЗатронутыеУслуги Цикл
        Обработано.Вставить(ТекУслуга, Истина);
    КонецЦикла;
    
КонецЕсли;

		МассивОсиротевшихУслуг = Новый Массив;
		Для Каждого СтрокаПары Из ТабОсиротевшихПар Цикл
			Если Обработано.Получить(СтрокаПары.Услуга) = Неопределено Тогда
				МассивОсиротевшихУслуг.Добавить(СтрокаПары.Услуга);
			КонецЕсли;
		КонецЦикла;
		
		Если МассивОсиротевшихУслуг.Количество() > 0 Тогда
			ПатчСпискаУслугПоУслугам(ДокументСписок, МассивОсиротевшихУслуг, Неопределено);
		КонецЕсли;
		
		Результат.Успех                     = Истина;
		Результат.КоличествоЗатронутыхУслуг = ЗатронутыеУслуги.Количество() + МассивОсиротевшихУслуг.Количество();
		
		Если Результат.КоличествоЗатронутыхУслуг = 0 Тогда
			Результат.Сообщение = "Расхождений не найдено, регистр актуален";
		Иначе
			Результат.Сообщение = "Обновлено услуг: " + Результат.КоличествоЗатронутыхУслуг;
		КонецЕсли;
		
	Исключение
		
		Результат.Успех    = Ложь;
		Результат.Сообщение = ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации(
		"Актуализация параметров расчета ЗП (точечная)",
		УровеньЖурналаРегистрации.Ошибка,
		,
		ДокументСписок,
		ОписаниеОшибки()
		);
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции


Функция УбратьСимволыИзТелефона(НомерТелефона) Экспорт
	
	Цифры = "1234567890";
	
	НовоеЗначение = "";
	
	Для НСимвола = 1 По СтрДлина(НомерТелефона) Цикл
		Если СтрНайти(Цифры, Сред(НомерТелефона, НСимвола, 1)) > 0 Тогда
			НовоеЗначение = НовоеЗначение + Сред(НомерТелефона, НСимвола, 1);
		КонецЕсли;
	КонецЦикла;

	Возврат НовоеЗначение;
	
КонецФункции


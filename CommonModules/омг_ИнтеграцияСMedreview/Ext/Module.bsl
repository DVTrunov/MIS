	РезультатЗапросаДокументы = ПакетЗапросов[1];
	РезультатЗапросаСправочники = ПакетЗапросов[2];
	
	
	РезультатЗапросаИзвестныеПоказатели = ПакетЗапросов[4]; 
	РезультатЗапросаСвободныеЗАявки = ПакетЗапросов[5];
    
	
	ВыборкаСправочникиПоДанным = РезультатЗапросаСправочники.Выбрать();
	ВыборкаСправочникиПоДанным.Следующий();
	
	ВыборкаИзвестныеПоказатели = РезультатЗапросаИзвестныеПоказатели.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если Не РезультатЗапросаДокументы.Пустой() Тогда
		
		Выборка = РезультатЗапросаДокументы.Выбрать();
		Выборка.Следующий();
		
		ДокументРезультатИсследования = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		ДокументРезультатИсследования = Документы.омг_РезультатИсследованияMedreview.СоздатьДокумент();
		ДокументРезультатИсследования.ВнешнийИдентификатор = СтруктураДанных.id;
	КонецЕсли;
	
	Год = Сред(СтруктураДанных.conclusion_date_time, 1, 4);
	Месяц = Сред(СтруктураДанных.conclusion_date_time, 6, 2);
	День = Сред(СтруктураДанных.conclusion_date_time, 9, 2);
	Час = Сред(СтруктураДанных.conclusion_date_time, 12, 2);
	Минута = Сред(СтруктураДанных.conclusion_date_time, 15, 2);
	Секунда = Сред(СтруктураДанных.conclusion_date_time, 18, 2);
	ДатаДокумента = Дата(Год, Месяц, День, Час, Минута, Секунда);
	
	ДокументРезультатИсследования.Дата = ДатаДокумента;
	
	СтруктураДанных.Свойство("patient_iin", ДокументРезультатИсследования.ИИНПациента);
	СтруктураДанных.Свойство("conclusion_doctor_iin", ДокументРезультатИсследования.ИИНВрача);
	СтруктураДанных.Свойство("conclusion_doctor_fullname", ДокументРезультатИсследования.ФИОВрача);
	СтруктураДанных.Свойство("conclusion_text", ДокументРезультатИсследования.ТекстЗаключения);
	
	ДанныеДокументаBasee64 = "";
	
	СтруктураДанных.Свойство("file_results", ДанныеДокументаBasee64);
	
	Если ДанныеДокументаBasee64.Количество() > 0 Тогда
		ДанныеДокументаBasee64 = ДанныеДокументаBasee64[0].file_content;
	КонецЕсли;
	
	Попытка
		
		ДокументРезультатИсследования.ФайлРезультата = Новый ХранилищеЗначения(Base64Значение(ДанныеДокументаBasee64));
		
	Исключение
		
		Возврат ОтветПоРезультатуОшибка();
		
	КонецПопытки;
	
	СтруктураДанных.Свойство("service_code", ДокументРезультатИсследования.КодУслуги);
	
	ДокументРезультатИсследования.Услуга = ВыборкаСправочникиПоДанным.Услуга;
	
	//// не создаем номенклатуру
	//Если ДокументРезультатИсследования.Услуга.Пустая() Тогда 
	//	НоваяУслуга = Справочники.НоменклатураМедицинскихУслуг.СоздатьЭлемент();
	//	НоваяУслуга.Код = ДокументРезультатИсследования.КодУслуги;
	//	МакетКлассификаторУслуг = Справочники.НоменклатураМедицинскихУслуг.ПолучитьМакет("омг_КлассификаторМедицинскихУслуг");
	//	ОбластьКодУслуги = МакетКлассификаторУслуг.НайтиТекст(НоваяУслуга.Код,,,,,, Истина);
	//	ОбластьНаименование = МакетКлассификаторУслуг.ПолучитьОбласть(ОбластьКодУслуги.Верх, ОбластьКодУслуги.Лево + 1);
	//		
	//	НоваяУслуга.Наименование = ОбластьНаименование.ТекущаяОбласть.Текст;
	//	НоваяУслуга.Записать();
	//	
	//	ДокументРезультатИсследования.Услуга = НоваяУслуга.Ссылка;
	//КонецЕсли;
	
	ДокументРезультатИсследования.Пациент = ВыборкаСправочникиПоДанным.Пациент;
	
	Показатели = ДокументРезультатИсследования.Показатели;
	
	Показатели.Очистить();
	
	СозданныеЗначенияПоказателей = Новый ТаблицаЗначений;
	СозданныеЗначенияПоказателей.Колонки.Добавить("Справочник");
	СозданныеЗначенияПоказателей.Колонки.Добавить("Показатель");
	СозданныеЗначенияПоказателей.Колонки.Добавить("Значение");
	
	Для Каждого ПолеДанных Из СтруктураДанных Цикл
		
		Если СтрНайти(ПоляНеПоказатели, ПолеДанных.Ключ) > 0 Тогда
			Продолжить;
		КонецЕсли;		
		
		Если ТипЗнч(ПолеДанных.Значение) = Тип("Структура") Тогда
			
			ВыборкаИзвестныеПоказатели.Сбросить();
			Для Каждого СвойствоПоляДаннных Из ПолеДанных.Значение Цикл
				
				ОбработатьДанныеДляПоказателя(ВыборкаИзвестныеПоказатели, Показатели, СвойствоПоляДаннных, ПолеДанных.Ключ, СозданныеЗначенияПоказателей);
				
			КонецЦикла;
			
		Иначе
			
			ОбработатьДанныеДляПоказателя(ВыборкаИзвестныеПоказатели, Показатели, ПолеДанных,,СозданныеЗначенияПоказателей);

		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураДанных.Свойство("desc", ДокументРезультатИсследования.Описание);
	
	МассивРекомендаций = Неопределено;
	СтруктураДанных.Свойство("recs", МассивРекомендаций);
	Если Не МассивРекомендаций = Неопределено Тогда
		СтрокаРекомендации = "";
		
		Если ТипЗнч(МассивРекомендаций) = Тип("Массив") Тогда
			Для Каждого Рекомендация Из МассивРекомендаций Цикл
				СтрокаРекомендации = СтрокаРекомендации + Рекомендация + "; ";
			КонецЦикла;
		Иначе
			СтрокаРекомендации  = МассивРекомендаций;
		КонецЕсли;
		
		ДокументРезультатИсследования.РекомендацииВрача = СтрокаРекомендации
		
	КонецЕсли;
	СтруктураДанных.Свойство("note", ДокументРезультатИсследования.ПримечаниеКЗаключению);
	СтруктураДанных.Свойство("details_url", ДокументРезультатИсследования.СсылкаНаДеталиИсследования);
	
	ДокументРезультатИсследования.Филиал = ВыборкаСправочникиПоДанным.Филиал;
	ДокументРезультатИсследования.Врач = ВыборкаСправочникиПоДанным.Врач;
	
	Если не значениеЗаполнено(ДокументРезультатИсследования.Заявка) Тогда
		ВыборкаРезультатЗапросаСвободныеЗАявки = РезультатЗапросаСвободныеЗАявки.Выбрать();
		Если ВыборкаРезультатЗапросаСвободныеЗАявки.Количество() > 0 Тогда  
			ВыборкаРезультатЗапросаСвободныеЗАявки.Следующий();
			ДокументРезультатИсследования.Заявка = ВыборкаРезультатЗапросаСвободныеЗАявки.СвободнаяЗаявка;	
			ДокументРезультатИсследования.омг_МедПерсонал.Очистить();
			ДокументРезультатИсследования.омг_МедПерсонал.Загрузить(ДокументРезультатИсследования.Заявка.омг_МедПерсонал.Выгрузить());
		КонецЕсли;	
	КонецЕсли;

	ДокументРезультатИсследования.Записать();
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	СтруктураОтвета = Новый Структура("Delivered_status", "SUCCESS");
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	ТелоОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	
	Возврат Ответ;
	
КонецФункции
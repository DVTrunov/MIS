	                             |	ЗаявкаРаботы.Ссылка.Дата";
	Запрос.УстановитьПараметр("ВнешнийИдентификатор", СтруктураДанных.id);
	Запрос.УстановитьПараметр("ИИНПациента", СтруктураДанных.patient_iin);
	Запрос.УстановитьПараметр("НаименованиеФилиала", СтруктураДанных.organization_name);
	Запрос.УстановитьПараметр("ИКЛ", СтруктураДанных.conclusion_doctor_iin);
	
	ПоляНеПоказатели = "id, patient_iin, conclusion_date_time, 
						|conclusion_doctor_iin, conclusion_doctor_fullname, conclusion_text, 
						|file_results, service_code, desc, recs, note, details_url, chek_list,

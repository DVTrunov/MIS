
Функция ОтветПоРезультатуОшибка(КодСостояния = 400)
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	
	СтруктураОтвета = Новый Структура("Delivered_status", "ERROR");
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	ТелоОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучениеJWT(Запрос) Экспорт
	
	Настройки = омг_ИнтеграцияСMedreviewПовтИсп.ПолучитьНастройки();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	
	Попытка
		
		ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		СтруктураЗапроса = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(400);
		Возврат Ответ;
		
	КонецПопытки;       
	
	Логин = "";
	Пароль = "";
	
	Если Не СтруктураЗапроса.Свойство("systemUsername", Логин)
		Или Не СтруктураЗапроса.Свойство("systemPassword", Пароль) Тогда
		
		Ответ = Новый HTTPСервисОтвет(400);
		Возврат Ответ;
		
	КонецЕсли;
	
	Если Не Логин = Настройки.ЛогинВнешнегоДоступа
		Или Не Пароль = Настройки.ПарольВнешнегоДоступа Тогда
		
		Ответ = Новый HTTPСервисОтвет(401);
		Возврат Ответ;
		
	КонецЕсли;
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	ТокенДоступа = Новый ТокенДоступа;
	ТокенДоступа.Заголовки.Вставить("alg", "HS256");
	
	ТокенДоступа.Эмитент = "ssl";
	ТокенДоступа.Получатели = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Medreview");
	ТокенДоступа.КлючСопоставленияПользователя = Настройки.ИмяПользователя;
	ТокенДоступа.ВремяСоздания = ТекущаяУниверсальнаяДата() - Дата(1970,1,1,0,0,0);
	ТокенДоступа.ВремяЖизни = ?(Настройки.ВремяЖизниТокена = 0, 1, Настройки.ВремяЖизниТокена) * 60 * 60;
	ТокенДоступа.Идентификатор = Новый УникальныйИдентификатор;
	
	ТокенДоступа.Подписать(АлгоритмПодписиТокенаДоступа.HS256, "EgH23sF8nL3xEGT2kEmAgxWyaKWvcf3p");
	
	Ответ.УстановитьТелоИзСтроки(Строка(ТокенДоступа));
	
	Возврат Ответ;
	
КонецФункции

Функция ОбязательныеПоляСуществуютИЗаполнены(СтруктураДанных)
	
	ОбязательныеПоля = "id,patient_iin,conclusion_date_time,conclusion_doctor_iin,file_results,organization_name";
	
	МассивПолей = СтрРазделить(ОбязательныеПоля, ",");
	
	Для Каждого Поле Из МассивПолей Цикл
		Значение = Неопределено;
		Если Не (СтруктураДанных.Свойство(Поле) И ЗначениеЗаполнено(СтруктураДанных[Поле])) Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	                                                                                                                                     	
КонецФункции

Процедура ДобавитьПоказатель(СтруктураДанных, Показатели, ПутьПоказателя)
	
	ПоляПоказателя = СтрРазделить(ПутьПоказателя, ".");
	
	Значение = СтруктураДанных;
	
	Показатель = "";
	
	Для Каждого Поле Из ПоляПоказателя Цикл
		Если Значение = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Значение.Свойство(Поле, Значение);
		Показатель = Поле;
	КонецЦикла;
	
	СтрокаПоказателя = Показатели.Добавить();
	СтрокаПоказателя.Показатель = ПутьПоказателя;
	СтрокаПоказателя.Значение = Значение;
	
КонецПроцедуры

Функция СоздатьНовыйПоказатель(ПолеПоказателя, Значение)
	
	НовыйПоказатель = ПланыВидовХарактеристик.омг_ПоказателиИсследования.СоздатьЭлемент();
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ТипЗнч(Значение));
	НовыйПоказатель.ТипЗначения = Новый ОписаниеТипов(МассивТипов);
	НовыйПоказатель.Наименование = ПолеПоказателя;
	НовыйПоказатель.ПолеПоказателя = ПолеПоказателя;
	НовыйПоказатель.Записать();
	
	Возврат НовыйПоказатель;
	
КонецФункции

Функция ОбработатьЗначениеДанныхПоказателя(СтрокаПоказателей, ВыборкаИзвестныеПоказатели, 
	СвойствоПоляДаннных, ТипыПоказателя, СозданныеЗначенияПоказателей)
	
	ВыборкаЗначенияИзвестныхПоказателей = ВыборкаИзвестныеПоказатели.Выбрать();
	
	ЕстьЗначение = Ложь;
	
	Пока ВыборкаЗначенияИзвестныхПоказателей.НайтиСледующий(Строка(СвойствоПоляДаннных.Значение), "Кодификатор") Цикл
		
		Если ТипыПоказателя.СодержитТип(ТипЗнч(ВыборкаЗначенияИзвестныхПоказателей.Значение)) Тогда
			Значение = ВыборкаЗначенияИзвестныхПоказателей.Значение;
			
			ЕстьЗначение = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьЗначение Тогда
		Значение = СвойствоПоляДаннных.Значение;
		
		Для Каждого ТипПоказателя Из ТипыПоказателя.Типы() Цикл
			Если Не Справочники.ТипВсеСсылки().СодержитТип(ТипПоказателя) Тогда
				Продолжить;
			КонецЕсли;     
			
			Если ТипПоказателя = Тип("СправочникСсылка.омг_ЗначенияПоказателейИсследования") Тогда
				НовоеЗначениеПоказателя = Справочники.омг_ЗначенияПоказателейИсследования.СоздатьЭлемент();
				НовоеЗначениеПоказателя.Владелец = СтрокаПоказателей.Показатель;
				НовоеЗначениеПоказателя.Кодификатор = СвойствоПоляДаннных.Значение;
				НовоеЗначениеПоказателя.Наименование = НовоеЗначениеПоказателя.Кодификатор;
				НовоеЗначениеПоказателя.Записать();
				
				Значение = НовоеЗначениеПоказателя.Ссылка;
				
			Иначе
				Справочник = Метаданные.НайтиПоТипу(ТипПоказателя).Имя;
				СтруктураПоиска = Новый Структура("Справочник, Показатель, Значение", 
					Справочник, СтрокаПоказателей.Показатель, Значение);
					
				НайденныеЗначения = СозданныеЗначенияПоказателей.НайтиСтроки(СтруктураПоиска);
				Если НайденныеЗначения.Количество() = 0 Тогда
					НовоеЗначениеПоказателя = Справочники[Справочник].СоздатьЭлемент();
					НовоеЗначениеПоказателя.Код = СвойствоПоляДаннных.Значение;
					НовоеЗначениеПоказателя.Наименование = НовоеЗначениеПоказателя.Код;
					НовоеЗначениеПоказателя.Записать();
					
					СозданноеЗначение = СозданныеЗначенияПоказателей.Добавить();
					СозданноеЗначение.Показатель = СтрокаПоказателей.Показатель;
					СозданноеЗначение.Значение = СвойствоПоляДаннных.Значение;
					СозданноеЗначение.Справочник = Справочник;
					
					Значение = НовоеЗначениеПоказателя.Ссылка;

				Иначе
					Значение = НайденныеЗначения[0].Значение;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Процедура ОбработатьДанныеДляПоказателя(ВыборкаИзвестныеПоказатели, Показатели, СвойствоПоляДаннных, Родитель = "", СозданныеЗначенияПоказателей)
	
	СтрокаПоказателей = Показатели.Добавить();
	
	ПолеПоказателя = ?(Родитель = "", "", Родитель + ".") + СвойствоПоляДаннных.Ключ;
	
	ВыборкаИзвестныеПоказатели.Сбросить();
	ТипыПоказателя = Неопределено;
	Если ВыборкаИзвестныеПоказатели.НайтиСледующий(ПолеПоказателя, "ПолеПоказателя") Тогда
		
		ТипыПоказателя = ВыборкаИзвестныеПоказатели.ТипЗначения;
		
		СтрокаПоказателей.Показатель = ВыборкаИзвестныеПоказатели.Показатель;
		
		СтрокаПоказателей.Значение = ОбработатьЗначениеДанныхПоказателя(СтрокаПоказателей, 
			ВыборкаИзвестныеПоказатели, СвойствоПоляДаннных, ТипыПоказателя, СозданныеЗначенияПоказателей);
		
	Иначе 
		
		НовыЙПоказатель = СоздатьНовыйПоказатель(ПолеПоказателя, СвойствоПоляДаннных.Значение);
		СтрокаПоказателей.Показатель = НовыЙПоказатель.Ссылка;
		
		ТипыПоказателя = НовыЙПоказатель.ТипЗначения;
		Если Родитель = "" Тогда
			СтрокаПоказателей.Значение = СвойствоПоляДаннных.Значение;
		Иначе
			СтрокаПоказателей.Значение = ОбработатьЗначениеДанныхПоказателя(СтрокаПоказателей, 
				ВыборкаИзвестныеПоказатели, СвойствоПоляДаннных, ТипыПоказателя, СозданныеЗначенияПоказателей)	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВсеПоляПоказателейИЗначения(СтруктураДанных, ПоляНеПоказатели)
	
	МассивПолей = Новый Массив;
	МассивЗначений = Новый Массив;
	
	Для Каждого ПолеДанных Из СтруктураДанных Цикл
		
		Если СтрНайти(ПоляНеПоказатели, ПолеДанных.Ключ) > 0 Тогда
			Продолжить;
		КонецЕсли;		
		
		Если ТипЗнч(ПолеДанных.Значение) = Тип("Структура") Тогда
			
			Для Каждого СвойствоПоляДаннных Из ПолеДанных.Значение Цикл
				
				ПолеПоказателя = ?(ПолеДанных.Ключ = "", "", ПолеДанных.Ключ + ".") + СвойствоПоляДаннных.Ключ;
				
				МассивПолей.Добавить(ПолеПоказателя);
				Если МассивЗначений.Найти(Строка(СвойствоПоляДаннных.Значение)) = Неопределено Тогда
					МассивЗначений.Добавить(Строка(СвойствоПоляДаннных.Значение));
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			МассивПолей.Добавить(ПолеДанных.Ключ);
			Если МассивЗначений.Найти(Строка(ПолеДанных.Значение)) = Неопределено Тогда
				МассивЗначений.Добавить(Строка(ПолеДанных.Значение));
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;    
	
	Возврат Новый Структура("МассивПолей, МассивЗначений",МассивПолей, МассивЗначений);

КонецФункции

Функция ЗаписатьРезультатыИсследования(Запрос) Экспорт 
	
	
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
	
	Попытка
		
		СтруктураДанных = ПрочитатьJSON(ЧтениеJSON, Ложь);
		
	Исключение
		
		Возврат ОтветПоРезультатуОшибка();
		
	КонецПопытки;
	
	ЧтениеJSON.Закрыть();
	
	Если Не ОбязательныеПоляСуществуютИЗаполнены(СтруктураДанных) Тогда
		Возврат ОтветПоРезультатуОшибка();
	КонецЕсли;
	
	Запрос = Новый Запрос;

	ПервыйЗапрос = Истина;
	Для Каждого ТипПлана Из Метаданные.ПланыВидовХарактеристик.омг_ПоказателиИсследования.Тип.Типы() Цикл

		Если Не Справочники.ТипВсеСсылки().СодержитТип(ТипПлана) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипПлана = Тип("СправочникСсылка.омг_ЗначенияПоказателейИсследования") Тогда
			Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ 
			|	Владелец, Кодификатор, 
			|	Ссылка
			|ИЗ 
			|	Справочник." + Метаданные.НайтиПоТипу(ТипПлана).Имя + "
			|ГДЕ
			|	Кодификатор В (&ЗначенияПоказателей)
			|
			|ОБЪЕДИНИТЬ ВСЕ ";
		Иначе
			Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ 
			|	Неопределено КАК Владалец, Код КАК Кодификатор, 
			|	Ссылка
			|ИЗ 
			|	Справочник." + Метаданные.НайтиПоТипу(ТипПлана).Имя + "
			|ГДЕ
			|	Код В (&ЗначенияПоказателей)
			|
			|ОБЪЕДИНИТЬ ВСЕ ";
		КонецЕсли;
		
		Если ПервыйЗапрос Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Ссылка", "
			|	Ссылка
			|ПОМЕСТИТЬ ВТ_ЗначенияПоказателей");
		КонецЕсли;
		
		ПервыйЗапрос = Ложь
		
	КонецЦикла;
	
	Запрос.Текст = Лев(Запрос.Текст, СтрДлина(Запрос.Текст) - 15) + "; ";
	
	Запрос.Текст = Запрос.Текст +"ВЫБРАТЬ
	                             |	омг_РезультатИсследованияMedreview.Ссылка КАК Ссылка
	                             |ИЗ
	                             |	Документ.омг_РезультатИсследованияMedreview КАК омг_РезультатИсследованияMedreview
	                             |ГДЕ
	                             |	омг_РезультатИсследованияMedreview.ВнешнийИдентификатор = &ВнешнийИдентификатор
	                             |;
	                             |
	                             |////////////////////////////////////////////////////////////////////////////////
	                             |ВЫБРАТЬ
	                             |	ВложенныйЗапрос.Поле1 КАК Поле1,
	                             |	ЕСТЬNULL(Клиенты.Ссылка, НЕОПРЕДЕЛЕНО) КАК Пациент,
	                             |	ЕСТЬNULL(омг_СоответствиеМедЦентровПАКС.Клиника, НЕОПРЕДЕЛЕНО) КАК Филиал,
	                             |	ЕСТЬNULL(Сотрудники.Ссылка, НЕОПРЕДЕЛЕНО) КАК Врач,
	                             |	ЕСТЬNULL(Номенклатура.Ссылка, НЕОПРЕДЕЛЕНО) КАК Услуга
	                             |ИЗ
	                             |	(ВЫБРАТЬ
	                             |		1 КАК Поле1) КАК ВложенныйЗапрос
	                             |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Клиенты КАК Клиенты
	                             |		ПО (Клиенты.ИНН = &ИИНПациента)
	                             |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	                             |		ПО (Сотрудники.омг_ИдентификационныйКодЛичности = &ИКЛ)
	                             |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	                             |		ПО (Номенклатура.Артикул = &КодУслуги),
	                             |	РегистрСведений.омг_СоответствиеМедЦентровПАКС КАК омг_СоответствиеМедЦентровПАКС
	                             |;
	                             |
	                             |////////////////////////////////////////////////////////////////////////////////
	                             |ВЫБРАТЬ
	                             |	омг_ПоказателиИсследования.Ссылка КАК Ссылка,
	                             |	омг_ПоказателиИсследования.ТипЗначения КАК ТипЗначения,
	                             |	омг_ПоказателиИсследования.ПолеПоказателя КАК ПолеПоказателя
	                             |ПОМЕСТИТЬ ВТ_Показатели
	                             |ИЗ
	                             |	ПланВидовХарактеристик.омг_ПоказателиИсследования КАК омг_ПоказателиИсследования
	                             |ГДЕ
	                             |	омг_ПоказателиИсследования.ПолеПоказателя В(&ПоляПоказателей)
	                             |;
	                             |
	                             |////////////////////////////////////////////////////////////////////////////////
	                             |ВЫБРАТЬ
	                             |	омг_ПоказателиИсследования.Ссылка КАК Показатель,
	                             |	омг_ЗначенияПоказателейИсследования.Ссылка КАК Значение,
	                             |	омг_ЗначенияПоказателейИсследования.Кодификатор КАК Кодификатор,
	                             |	омг_ПоказателиИсследования.Ссылка.ПолеПоказателя КАК ПолеПоказателя,
	                             |	омг_ПоказателиИсследования.Ссылка.ТипЗначения КАК ТипЗначения
	                             |ИЗ
	                             |	ВТ_Показатели КАК омг_ПоказателиИсследования
	                             |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗначенияПоказателей КАК омг_ЗначенияПоказателейИсследования
	                             |		ПО (ВЫБОР
	                             |				КОГДА ТИПЗНАЧЕНИЯ(омг_ЗначенияПоказателейИсследования.Ссылка) = ТИП(Справочник.омг_ЗначенияПоказателейИсследования)
	                             |					ТОГДА омг_ПоказателиИсследования.Ссылка = омг_ЗначенияПоказателейИсследования.Владелец
	                             |				ИНАЧЕ ИСТИНА
	                             |			КОНЕЦ)
	                             |ИТОГИ ПО
	                             |	Показатель
	                             |;
	                             |
	                             |////////////////////////////////////////////////////////////////////////////////
	                             |ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	                             |	ЗаявкаРаботы.Ссылка КАК СвободнаяЗаявка
	                             |ИЗ
	                             |	РегистрСведений.омг_СоответствиеМедЦентровПАКС КАК омг_СоответствиеМедЦентровПАКС
	                             |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.Работы КАК ЗаявкаРаботы
	                             |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Прием КАК Прием
	                             |			ПО ЗаявкаРаботы.Ссылка = Прием.ДокументОснование
	                             |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.омг_РезультатИсследованияMedreview КАК омг_РезультатИсследованияMedreview
	                             |			ПО ЗаявкаРаботы.Ссылка = омг_РезультатИсследованияMedreview.Заявка
	                             |		ПО (ЗаявкаРаботы.Ссылка.Филиал = омг_СоответствиеМедЦентровПАКС.Клиника)
	                             |ГДЕ
	                             |	ЗаявкаРаботы.Ссылка.Клиент.ИНН = &ИИНПациента
	                             |	И омг_СоответствиеМедЦентровПАКС.НаименованиеПАКС = &НаименованиеФилиала
	                             |	И ЗаявкаРаботы.Ссылка.Сотрудник.омг_ИдентификационныйКодЛичности = &ИКЛ
	                             |	И ЗаявкаРаботы.Номенклатура.Артикул = &КодУслуги
	                             |	И омг_РезультатИсследованияMedreview.Ссылка ЕСТЬ NULL
	                             |	И Прием.Ссылка ЕСТЬ NULL
	                             |

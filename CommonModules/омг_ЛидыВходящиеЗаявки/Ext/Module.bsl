// Приём заявок из внешних источников (HTTP-сервис омг_Лиды) и создание документов омг_Лид.
//
// Tilda: в настройках формы — «Вебхук», адрес из справочника «Источники трафика».
// Tilda шлёт поля формы как application/x-www-form-urlencoded (или JSON), при подключении —
// тестовый запрос test=test. Метки UTM приходят полями utm_* или в cookie TILDAUTM.

#Область ПрограммныйИнтерфейс

// Обработчик методов HTTP-сервиса омг_Лиды.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция ОбработатьЗапрос(Запрос) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТипВАдресе = НРег(СокрЛП(Запрос.ПараметрыURL.Получить("type")));
	КлючВАдресе = СокрЛП(Запрос.ПараметрыURL.Получить("key"));
	Источник = НайтиИсточник(ТипВАдресе, КлючВАдресе);
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат ТекстовыйОтвет(404, "unknown source");
	КонецЕсли;
	Если ТипВАдресе = "meta" Тогда
		Возврат ОтветНаУведомлениеMeta(Запрос, Источник, КлючВАдресе);
	КонецЕсли;
	
	Попытка
		Тело = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		Если Тело = Неопределено Тогда
			Тело = "";
		КонецЕсли;
		Поля = ПоляЗапроса(Запрос, Тело);
		Если Поля.Количество() = 0 Или ЭтоТестовыйЗапрос(Поля) Тогда
			Возврат ТекстовыйОтвет(200, "ok");
		КонецЕсли;
		ЗарегистрироватьЗаявку(Источник, Поля, ИсходныеДанныеЗапроса(Запрос, Тело));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.омг_ИсточникиТрафика, Источник, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ТекстовыйОтвет(500, "error");
	КонецПопытки;
	
	Возврат ТекстовыйОтвет(200, "ok");
	
КонецФункции

// Адрес вебхука для настройки на стороне сервиса.
//
// Параметры:
//  ТипИсточника - ПеречислениеСсылка.омг_ТипыИсточниковЛидов
//  Ключ - Строка
//
// Возвращаемое значение:
//  Строка - пустая, если не заполнена константа омг_ЛидыАдресHTTPСервисов.
//
Функция АдресВебхука(ТипИсточника, Ключ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	База = СокрЛП(Константы.омг_ЛидыАдресHTTPСервисов.Получить());
	Если Не ЗначениеЗаполнено(База) Или Не ЗначениеЗаполнено(ТипИсточника) Или Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат "";
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(База, "/") Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;
	Возврат База + "/leads/" + КодТипа(ТипИсточника) + "/" + Ключ;
	
КонецФункции

// Создаёт лид по полям заявки или дописывает повторную заявку в активный лид.
//
// Параметры:
//  Источник - СправочникСсылка.омг_ИсточникиТрафика
//  Поля - Массив из Структура - Имя, Значение (строки), в порядке поступления.
//  ИсходныеДанные - Строка - сохраняется в лиде как есть.
//
// Возвращаемое значение:
//  ДокументСсылка.омг_Лид - созданный или дополненный лид, Неопределено — заявка уже была принята.
//
Функция ЗарегистрироватьЗаявку(Источник, Поля, ИсходныеДанные = "") Экспорт
	
	НастройкиИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник,
		"Наименование, ТипИсточника, НаправлениеТрафика, ИсточникИнформации, ТипРекламы, РекламнаяКомпания,
		|НаправлениеЛида, Филиал, СоответствиеПолей, ПовторЧасов");
	Данные = РазобратьПоля(Поля, НастройкиИсточника.СоответствиеПолей);
	
	// Повторная доставка той же заявки.
	Если ЗначениеЗаполнено(Данные.ВнешнийИдентификатор)
		И ЗначениеЗаполнено(НайтиЛидПоВнешнемуИдентификатору(Источник, Данные.ВнешнийИдентификатор)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаправлениеЛида = НайтиНаправление(Данные.Направление);
	Если Не ЗначениеЗаполнено(НаправлениеЛида) Тогда
		НаправлениеЛида = НастройкиИсточника.НаправлениеЛида;
		Если ЗначениеЗаполнено(Данные.Направление) Тогда
			Данные.Дополнительно.Вставить(0, СтрШаблон(НСтр("ru = 'Направление: %1'"), Данные.Направление));
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.Форма) Тогда
		Данные.Дополнительно.Добавить(СтрШаблон(НСтр("ru = 'Форма: %1'"), Данные.Форма));
	КонецЕсли;
	
	ТекстКомментария = СокрЛП(Данные.Комментарий);
	Если Данные.Дополнительно.Количество() > 0 Тогда
		ТекстКомментария = СокрЛП(ТекстКомментария + Символы.ПС + СтрСоединить(Данные.Дополнительно, Символы.ПС));
	КонецЕсли;
	
	// Повторная заявка по тому же телефону — в активный лид.
	Если НастройкиИсточника.ПовторЧасов > 0 Тогда
		ДействующийЛид = НайтиАктивныйЛидПоТелефону(Данные.Телефон, НастройкиИсточника.ПовторЧасов);
		Если ЗначениеЗаполнено(ДействующийЛид) Тогда
			ДописатьПовторнуюЗаявку(ДействующийЛид, НастройкиИсточника.Наименование, Данные, ТекстКомментария);
			Возврат ДействующийЛид;
		КонецЕсли;
	КонецЕсли;
	
	Лид = Документы.омг_Лид.СоздатьДокумент();
	Лид.Дата = ТекущаяДатаСеанса();
	Лид.Статус = Перечисления.омг_СтатусыЛидов.Новый;
	Лид.ИсточникТрафика = Источник;
	Лид.Канал = Строка(НастройкиИсточника.ТипИсточника);
	Лид.НаправлениеТрафика = НастройкиИсточника.НаправлениеТрафика;
	// Метки UTM сопоставляются с «Именем UTM» справочников; без совпадения — значения из источника.
	Лид.ИсточникИнформации = ЗначениеПоИмениUTM("ИсточникиИнформации", Данные.UtmSource, НастройкиИсточника.ИсточникИнформации);
	Лид.ТипРекламы = ЗначениеПоИмениUTM("ТипыРекламы", Данные.UtmMedium, НастройкиИсточника.ТипРекламы);
	Лид.РекламнаяКомпания = ЗначениеПоИмениUTM("РекламныеКомпании", Данные.UtmCampaign, НастройкиИсточника.РекламнаяКомпания);
	Лид.Филиал = НастройкиИсточника.Филиал;
	Лид.НаправлениеЛида = НаправлениеЛида;
	Лид.Имя = Лев(Данные.Имя, 150);
	Лид.Телефон = Данные.Телефон;
	Лид.Город = Лев(Данные.Город, 100);
	Лид.СогласиеНаОбработкуПДн = Данные.Согласие;
	Лид.ВнешнийИдентификатор = Лев(Данные.ВнешнийИдентификатор, 100);
	Лид.UtmSource = Лев(Данные.UtmSource, 250);
	Лид.UtmMedium = Лев(Данные.UtmMedium, 250);
	Лид.UtmCampaign = Лев(Данные.UtmCampaign, 250);
	Лид.UtmContent = Лев(Данные.UtmContent, 250);
	Лид.UtmTerm = Лев(Данные.UtmTerm, 250);
	Лид.ПосадочнаяСтраница = Данные.Страница;
	Лид.Комментарий = ТекстКомментария;
	Лид.ИсходныеДанные = ИсходныеДанные;
	Лид.ДополнительныеСвойства.Вставить("КомментарийИстории",
		СтрШаблон(НСтр("ru = 'Заявка из источника «%1»'"), НастройкиИсточника.Наименование));
	Лид.Записать();
	
	омг_ЛидыСервер.ЗаполнитьИсточникИнформацииКлиента(Лид.Клиент, Лид.ИсточникИнформации);
	
	Возврат Лид.Ссылка;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяСобытияЖурнала()
	
	Возврат НСтр("ru = 'Лиды.Входящая заявка'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

// Вебхук Meta (подписка приложения на событие leadgen страницы).
// GET — подтверждение подписки: hub.verify_token должен совпадать с ключом источника, в ответ — hub.challenge.
// POST — уведомление с ID лидов; сам лид забирается из Graph API токеном источника.
// Отвечаем 200 и при ошибке: пропущенный лид догрузит регламентное задание омг_ЗагрузкаЛидовMeta.
//
Функция ОтветНаУведомлениеMeta(Запрос, Источник, Ключ)
	
	Если Запрос.HTTPМетод = "GET" Тогда
		Вызов = Запрос.ПараметрыЗапроса.Получить("hub.challenge");
		Если Не ЗначениеЗаполнено(Вызов) Тогда
			Возврат ТекстовыйОтвет(200, "ok");
		ИначеЕсли Запрос.ПараметрыЗапроса.Получить("hub.mode") = "subscribe"
			И Запрос.ПараметрыЗапроса.Получить("hub.verify_token") = Ключ Тогда
			Возврат ТекстовыйОтвет(200, Вызов);
		КонецЕсли;
		Возврат ТекстовыйОтвет(403, "forbidden");
	КонецЕсли;
	
	Попытка
		Тело = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		Для Каждого Идентификатор Из омг_ЛидыMeta.ИдентификаторыЛидовИзУведомления(Тело) Цикл
			омг_ЛидыMeta.ЗагрузитьЛид(Источник, Идентификатор);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.омг_ИсточникиТрафика, Источник, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат ТекстовыйОтвет(200, "ok");
	
КонецФункции

Функция ТекстовыйОтвет(КодСостояния, Текст)
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Текст, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
КонецФункции

Функция КодТипа(ТипИсточника)
	
	Если ТипИсточника = Перечисления.омг_ТипыИсточниковЛидов.Tilda Тогда
		Возврат "tilda";
	ИначеЕсли ТипИсточника = Перечисления.омг_ТипыИсточниковЛидов.Meta Тогда
		Возврат "meta";
	ИначеЕсли ТипИсточника = Перечисления.омг_ТипыИсточниковЛидов.TikTok Тогда
		Возврат "tiktok";
	КонецЕсли;
	Возврат "webhook";
	
КонецФункции

Функция НайтиИсточник(ТипВАдресе, КлючВАдресе)
	
	Если Не ЗначениеЗаполнено(КлючВАдресе) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Источники.Ссылка КАК Ссылка,
	|	Источники.ТипИсточника КАК ТипИсточника
	|ИЗ
	|	Справочник.омг_ИсточникиТрафика КАК Источники
	|ГДЕ
	|	Источники.Ключ = &Ключ
	|	И Источники.Используется
	|	И НЕ Источники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ключ", КлючВАдресе);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И КодТипа(Выборка.ТипИсточника) = ТипВАдресе Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

// Поля из параметров адреса и тела (JSON или application/x-www-form-urlencoded).
//
Функция ПоляЗапроса(Запрос, Тело)
	
	Поля = Новый Массив;
	Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
		ДобавитьПоле(Поля, Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	ТелоЗапроса = СокрЛП(Тело);
	Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Возврат Поля;
	КонецЕсли;
	
	Если СтрНачинаетсяС(ТелоЗапроса, "{") Или СтрНачинаетсяС(ТелоЗапроса, "[") Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоЗапроса);
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		ДобавитьПоляJSON(Поля, "", Значение);
	Иначе
		Для Каждого Пара Из СтрРазделить(ТелоЗапроса, "&", Ложь) Цикл
			Позиция = СтрНайти(Пара, "=");
			Если Позиция = 0 Тогда
				ДобавитьПоле(Поля, РаскодироватьURL(Пара), "");
			Иначе
				ДобавитьПоле(Поля, РаскодироватьURL(Лев(Пара, Позиция - 1)), РаскодироватьURL(Сред(Пара, Позиция + 1)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Поля;
	
КонецФункции

Процедура ДобавитьПоляJSON(Поля, Имя, Значение)
	
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Значение Цикл
			ДобавитьПоляJSON(Поля, Строка(Элемент.Ключ), Элемент.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Простые = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент) = Тип("Соответствие") Или ТипЗнч(Элемент) = Тип("Массив") Тогда
				ДобавитьПоляJSON(Поля, Имя, Элемент);
			ИначеЕсли Элемент <> Неопределено Тогда
				Простые.Добавить(Строка(Элемент));
			КонецЕсли;
		КонецЦикла;
		Если Простые.Количество() > 0 Тогда
			ДобавитьПоле(Поля, Имя, СтрСоединить(Простые, ", "));
		КонецЕсли;
	ИначеЕсли Значение <> Неопределено Тогда
		ДобавитьПоле(Поля, Имя, Строка(Значение));
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоле(Поля, Имя, Значение)
	
	Поля.Добавить(Новый Структура("Имя, Значение", СокрЛП(Имя), СокрЛП(Значение)));
	
КонецПроцедуры

Функция РаскодироватьURL(Знач Текст)
	
	Возврат РаскодироватьСтроку(СтрЗаменить(Текст, "+", " "), СпособКодированияСтроки.КодировкаURL);
	
КонецФункции

Функция ЭтоТестовыйЗапрос(Поля)
	
	Возврат Поля.Количество() = 1 И НРег(Поля[0].Имя) = "test";
	
КонецФункции

Функция ИсходныеДанныеЗапроса(Запрос, Тело)
	
	Строки = Новый Массив;
	Если ЗначениеЗаполнено(Запрос.ОтносительныйURL) Тогда
		Строки.Добавить(Запрос.HTTPМетод + " " + Запрос.ОтносительныйURL);
	КонецЕсли;
	Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
		Строки.Добавить(Параметр.Ключ + "=" + Параметр.Значение);
	КонецЦикла;
	Если ЗначениеЗаполнено(Тело) Тогда
		Строки.Добавить(Тело);
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Имя поля без регистра, пробелов, подчёркиваний и дефисов: "Your_Name" -> "yourname".
//
Функция КлючПоля(Имя)
	
	Ключ = НРег(СокрЛП(Имя));
	Для Каждого Символ Из СтрРазделить(" ,_,-,.", ",") Цикл
		Ключ = СтрЗаменить(Ключ, Символ, "");
	КонецЦикла;
	Возврат Ключ;
	
КонецФункции

// Стандартные имена полей форм -> реквизит заявки.
//
Функция СтандартныеИменаПолей()
	
	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("name,имя,fio,фио,yourname,firstname,fullname,полноеимя,вашеимя,client,клиент", ",") Цикл
		Имена.Вставить(Имя, "Имя");
	КонецЦикла;
	Имена.Вставить("lastname", "Имя");
	Имена.Вставить("фамилия", "Имя");
	Для Каждого Имя Из СтрРазделить("phone,телефон,tel,phonenumber,mobile,номер,номертелефона,whatsapp", ",") Цикл
		Имена.Вставить(Имя, "Телефон");
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("city,город", ",") Цикл
		Имена.Вставить(Имя, "Город");
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("direction,направление,service,услуга,specialty,специализация,doctor,врач", ",") Цикл
		Имена.Вставить(Имя, "Направление");
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("comment,комментарий,message,сообщение,textarea,question,вопрос", ",") Цикл
		Имена.Вставить(Имя, "Комментарий");
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("checkbox,agreement,согласие,consent,personaldata", ",") Цикл
		Имена.Вставить(Имя, "Согласие");
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("tranid,leadid", ",") Цикл
		Имена.Вставить(Имя, "ВнешнийИдентификатор");
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("utmsource,utmmedium,utmcampaign,utmcontent,utmterm", ",") Цикл
		Имена.Вставить(Имя, Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("page,pageurl,url,referer,referrer,landing", ",") Цикл
		Имена.Вставить(Имя, "Страница");
	КонецЦикла;
	Имена.Вставить("cookies", "Cookies");
	Имена.Вставить("formid", "Форма");
	Имена.Вставить("formname", "Форма");
	Имена.Вставить("test", "Пропустить");
	Возврат Имена;
	
КонецФункции

// Поле с нестандартным именем, но понятным по смыслу: «Ваш город», «Выберите услугу», «Ваш телефон».
//
Функция РеквизитПоЧастиИмени(Ключ)
	
	// Порядок важен: проверяется сверху вниз.
	Части = Новый Массив;
	Части.Добавить(Новый Структура("Реквизит, Части", "Телефон", "телефон,phone,whatsapp"));
	Части.Добавить(Новый Структура("Реквизит, Части", "Город", "город,city"));
	Части.Добавить(Новый Структура("Реквизит, Части", "Комментарий", "коммент,comment,вопрос,question,message,сообщен"));
	Части.Добавить(Новый Структура("Реквизит, Части", "Направление", "услуг,направлен,service,специализ,specialt,doctor,врач"));
	Части.Добавить(Новый Структура("Реквизит, Части", "Имя", "имя,фио"));
	Для Каждого Элемент Из Части Цикл
		Для Каждого Часть Из СтрРазделить(Элемент.Части, ",") Цикл
			Если СтрНайти(Ключ, Часть) > 0 Тогда
				Возврат Элемент.Реквизит;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

// Соответствие полей из настройки источника: строки "поле=Реквизит".
//
Функция НастроенныеИменаПолей(Текст)
	
	Допустимые = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("Имя,Телефон,Город,Направление,Комментарий,Согласие,ВнешнийИдентификатор,Пропустить", ",") Цикл
		Допустимые.Вставить(НРег(Имя), Имя);
	КонецЦикла;
	
	Имена = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Позиция = СтрНайти(Строка, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Реквизит = Допустимые.Получить(НРег(СокрЛП(Сред(Строка, Позиция + 1))));
		Если Реквизит <> Неопределено Тогда
			Имена.Вставить(КлючПоля(Лев(Строка, Позиция - 1)), Реквизит);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

Функция РазобратьПоля(Поля, СоответствиеПолей)
	
	Данные = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Имя,Телефон,Город,Направление,Комментарий,ВнешнийИдентификатор,Страница,UtmSource,UtmMedium,UtmCampaign,UtmContent,UtmTerm", ",") Цикл
		Данные.Вставить(Имя, "");
	КонецЦикла;
	Данные.Вставить("Согласие", Ложь);
	Данные.Вставить("Дополнительно", Новый Массив);
	Данные.Вставить("Форма", "");
	
	ПоляUtm = Новый Структура("utmsource, utmmedium, utmcampaign, utmcontent, utmterm",
		"UtmSource", "UtmMedium", "UtmCampaign", "UtmContent", "UtmTerm");
	Стандартные = СтандартныеИменаПолей();
	Настроенные = НастроенныеИменаПолей(СоответствиеПолей);
	
	Для Каждого Поле Из Поля Цикл
		Ключ = КлючПоля(Поле.Имя);
		Значение = Поле.Значение;
		Реквизит = Настроенные.Получить(Ключ);
		Если Реквизит = Неопределено Тогда
			Реквизит = Стандартные.Получить(Ключ);
		КонецЕсли;
		Если Реквизит = Неопределено Тогда
			Реквизит = РеквизитПоЧастиИмени(Ключ);
		КонецЕсли;
		
		Если Реквизит = "Пропустить" Тогда
			Продолжить;
		ИначеЕсли Реквизит = "Форма" Тогда
			// Название формы (formname) важнее её ID (formid).
			Если ЗначениеЗаполнено(Значение) И (Ключ = "formname" Или Не ЗначениеЗаполнено(Данные.Форма)) Тогда
				Данные.Форма = Значение;
			КонецЕсли;
		ИначеЕсли Реквизит = "Cookies" Тогда
			РазобратьTildaUtm(Значение, Данные);
		ИначеЕсли Реквизит <> Неопределено И ПоляUtm.Свойство(Реквизит) Тогда
			Данные[ПоляUtm[Реквизит]] = Значение;
		ИначеЕсли Реквизит = "Согласие" Тогда
			Данные.Согласие = ЗначениеЗаполнено(Значение)
				И СтрНайти(",no,нет,0,false,off,", "," + НРег(Значение) + ",") = 0;
		ИначеЕсли Реквизит = "Комментарий" Тогда
			Если ЗначениеЗаполнено(Значение) Тогда
				Данные.Комментарий = СокрЛП(Данные.Комментарий + Символы.ПС + Значение);
			КонецЕсли;
		ИначеЕсли Реквизит <> Неопределено Тогда
			Если ЗначениеЗаполнено(Значение) Тогда
				Данные[Реквизит] = СокрЛП(Данные[Реквизит] + " " + Значение);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
			// Неизвестное поле формы (email, вопросы квиза и т.п.) — в комментарий для оператора.
			Данные.Дополнительно.Добавить(Поле.Имя + ": " + Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

// Cookie Tilda: TILDAUTM=utm_source%3Dgoogle%7C%7C%7Cutm_medium%3Dcpc...
// Метки из cookie не перезаписывают пришедшие отдельными полями.
//
Процедура РазобратьTildaUtm(Cookies, Данные)
	
	Позиция = СтрНайти(Cookies, "TILDAUTM=");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	Значение = Сред(Cookies, Позиция + СтрДлина("TILDAUTM="));
	Конец = СтрНайти(Значение, ";");
	Если Конец > 0 Тогда
		Значение = Лев(Значение, Конец - 1);
	КонецЕсли;
	Значение = РаскодироватьURL(Значение);
	
	ПоляUtm = Новый Структура("utmsource, utmmedium, utmcampaign, utmcontent, utmterm",
		"UtmSource", "UtmMedium", "UtmCampaign", "UtmContent", "UtmTerm");
	Для Каждого Пара Из СтрРазделить(Значение, "|", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючПоля(Лев(Пара, Позиция - 1));
		Если ПоляUtm.Свойство(Ключ) И Не ЗначениеЗаполнено(Данные[ПоляUtm[Ключ]]) Тогда
			Данные[ПоляUtm[Ключ]] = СокрЛП(Сред(Пара, Позиция + 1));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Направление лида по тексту из формы: точное совпадение с наименованием или синонимом,
// затем вхождение наименования (синонима) в текст.
//
// Элемент справочника с реквизитом ИмяUTM, равным метке (без учёта регистра).
//
// Параметры:
//  ИмяСправочника - Строка - ИсточникиИнформации, ТипыРекламы, РекламныеКомпании.
//  Метка - Строка - значение utm_source / utm_medium / utm_campaign.
//  ПоУмолчанию - СправочникСсылка - если метка пуста или не найдена.
//
Функция ЗначениеПоИмениUTM(ИмяСправочника, Метка, ПоУмолчанию)
	
	ИскомоеИмя = НРег(СокрЛП(Метка));
	Если Не ЗначениеЗаполнено(ИскомоеИмя) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ
	|	Элементы.Ссылка КАК Ссылка,
	|	Элементы.ИмяUTM КАК ИмяUTM
	|ИЗ
	|	Справочник.ИмяСправочника КАК Элементы
	|ГДЕ
	|	НЕ Элементы.ПометкаУдаления
	|	И Элементы.ИмяUTM <> """"", "ИмяСправочника", ИмяСправочника);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НРег(СокрЛП(Выборка.ИмяUTM)) = ИскомоеИмя Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат ПоУмолчанию;
	
КонецФункции

Функция НайтиНаправление(Текст)
	
	ТекстПоиска = НРег(СокрЛП(Текст));
	Если Не ЗначениеЗаполнено(ТекстПоиска) Тогда
		Возврат Справочники.омг_НаправленияЛидов.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Направления.Ссылка КАК Ссылка,
	|	Направления.Наименование КАК Наименование,
	|	Направления.Синонимы КАК Синонимы
	|ИЗ
	|	Справочник.омг_НаправленияЛидов КАК Направления
	|ГДЕ
	|	НЕ Направления.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПоВхождению = Справочники.омг_НаправленияЛидов.ПустаяСсылка();
	Пока Выборка.Следующий() Цикл
		Варианты = СтрРазделить(Выборка.Синонимы, Символы.ПС, Ложь);
		Варианты.Добавить(Выборка.Наименование);
		Для Каждого Вариант Из Варианты Цикл
			Вариант = НРег(СокрЛП(Вариант));
			Если Не ЗначениеЗаполнено(Вариант) Тогда
				Продолжить;
			КонецЕсли;
			Если Вариант = ТекстПоиска Тогда
				Возврат Выборка.Ссылка;
			ИначеЕсли Не ЗначениеЗаполнено(ПоВхождению) И СтрДлина(Вариант) >= 4 И СтрНайти(ТекстПоиска, Вариант) > 0 Тогда
				ПоВхождению = Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат ПоВхождению;
	
КонецФункции

Функция НайтиЛидПоВнешнемуИдентификатору(Источник, Идентификатор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лид.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.омг_Лид КАК Лид
	|ГДЕ
	|	Лид.ВнешнийИдентификатор = &Идентификатор
	|	И Лид.ИсточникТрафика = &Источник";
	Запрос.УстановитьПараметр("Идентификатор", Лев(Идентификатор, 100));
	Запрос.УстановитьПараметр("Источник", Источник);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции

Функция НайтиАктивныйЛидПоТелефону(Телефон, Часов)
	
	Цифры = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(Телефон);
	Если СтрДлина(Цифры) < 10 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лид.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.омг_Лид КАК Лид
	|ГДЕ
	|	Лид.Телефон ПОДОБНО &Маска
	|	И Лид.Статус В (&Статусы)
	|	И Лид.Дата >= &Начало
	|	И НЕ Лид.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лид.Дата УБЫВ";
	Запрос.УстановитьПараметр("Маска", "%" + Прав(Цифры, 10));
	Запрос.УстановитьПараметр("Статусы", омг_ЛидыСервер.АктивныеСтатусы());
	Запрос.УстановитьПараметр("Начало", ТекущаяДатаСеанса() - Часов * 3600);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции

Процедура ДописатьПовторнуюЗаявку(Лид, ИмяИсточника, Данные, ТекстКомментария)
	
	Комментарий = СтрШаблон(НСтр("ru = 'Повторная заявка из источника «%1».'"), ИмяИсточника);
	Если ЗначениеЗаполнено(Данные.Имя) Тогда
		Комментарий = Комментарий + " " + СтрШаблон(НСтр("ru = 'Имя: %1.'"), Данные.Имя);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстКомментария) Тогда
		Комментарий = Комментарий + Символы.ПС + ТекстКомментария;
	КонецЕсли;
	
	ЛидОбъект = Лид.ПолучитьОбъект();
	ЛидОбъект.Заблокировать();
	ЛидОбъект.Комментарий = СокрЛП(ЛидОбъект.Комментарий + Символы.ПС
		+ Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM HH:mm'") + " " + Комментарий);
	ЛидОбъект.Записать();
	омг_ЛидыСервер.ЗаписатьИсториюСтатуса(Лид, ЛидОбъект.Статус, , Комментарий);
	
КонецПроцедуры

#КонецОбласти

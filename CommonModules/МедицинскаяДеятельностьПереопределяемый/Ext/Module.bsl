Функция РольДоступнаТекущемуПользователю(МедицинскийДокумент, Роль) Экспорт
	
	ИмяТипаДокумента = ДопСерверныеФункции.ИмяСсылочногоТипа(МедицинскийДокумент);
	
	Если ИмяТипаДокумента = "Справочник.МедицинскиеКарты" Тогда
		Если МедицинскийДокумент.ВидКарты.Макет = "МедицинскаяКарта003у_530н" Тогда
			Возврат Стационар.РольДоступнаТекущемуПользователю(МедицинскийДокумент, Роль);
		КонецЕсли;
	ИначеЕсли ИмяТипаДокумента = "Документ.Форма066" Тогда
		Возврат Стационар.РольДоступнаТекущемуПользователю(МедицинскийДокумент.МедицинскаяКарта, Роль);
	ИначеЕсли ИмяТипаДокумента = "Документ.ВрачебнаяКомиссия" Тогда
		Возврат Документы.ВрачебнаяКомиссия.РольДоступнаТекущемуПользователю(МедицинскийДокумент, Роль);
	КонецЕсли;

	Возврат Неопределено;
	
КонецФункции

Процедура ДополнитьМакетыСРучнымРедактированием(МакетыСРучнымРедактированием) Экспорт
	
	МакетыСРучнымРедактированием.Добавить("МедицинскаяКарта003у_530н");
	
КонецПроцедуры

Функция ПолучитьРолиДляПодписанияПоВидуМедкарты(ВидКарты) Экспорт
	
	Роли = Новый Массив;
	Если ВидКарты.Макет = "МедицинскаяКарта003у_530н" Тогда
		Роли.Добавить(ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(18, "РолиПриПодписиМедДокументов"));
		Роли.Добавить(ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(5, "РолиПриПодписиМедДокументов"));
		Возврат Роли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


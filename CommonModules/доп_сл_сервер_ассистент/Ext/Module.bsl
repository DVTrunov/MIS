		РасписаниеРЗ = Новый РасписаниеРегламентногоЗадания;
		РасписаниеРЗ.ПериодНедель = 1;
		РасписаниеРЗ.ПериодПовтораДней = 1;
		РасписаниеРЗ.ПериодПовтораВТечениеДня = 30;
		РасписаниеРЗ.Месяцы = Месяцы;
		РасписаниеРЗ.ДниНедели = Дни;
		РЗ.ИнтервалПовтораПриАварийномЗавершении = 0;
		РЗ.КоличествоПовторовПриАварийномЗавершении = 0;
		РЗ.Расписание = РасписаниеРЗ;
		РЗ.Использование = Истина;
		РЗ.Записать();
	КонецЕсли;
КонецПроцедуры
Функция Преобразование_ДатаВремяВUnixTimeStamp(Знач ДатаВремя, ПривестиКUTC = Истина) Экспорт
	Если ДатаВремя = Дата("00010101") Тогда
		Возврат 0;
	КонецЕсли;
	Если ПривестиКUTC Тогда
		ДатаВремя = УниверсальноеВремя(ДатаВремя);
	КонецЕсли;
	Если ДатаВремя < Дата("19700101") Тогда
		Возврат 0;
	Иначе
		Возврат Формат(Число(ДатаВремя - Дата("19700101")), "ЧН=0; ЧГ=0");
	КонецЕсли;
КонецФункции
Функция Преобразование_UnixTimeStampВДатаВремя(Знач UnixTimeStamp, ПривестиКЛокальномуВремени = Истина) Экспорт
	ДатаВремя = Дата("19700101") + UnixTimeStamp;
	Если ДатаВремя = Дата("19700101") Тогда
		Возврат Дата("00010101");
	КонецЕсли;
	Если ПривестиКЛокальномуВремени Тогда
		ДатаВремя = МестноеВремя(ДатаВремя);
	КонецЕсли;
	Возврат ДатаВремя;
КонецФункции
Функция lsaAPI_Execute(MethodName, ExpectedJSONObjectName, ИсходящиеПараметрыМассив = Неопределено, sid = "")
	НачалоИсполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НачалоИсполненияHttp = - 1;
	ЗавершениеИсполненияHttp = - 1;
	ИсходящаяСтрока = "";
	ВходящаяСтрока = "";
	Результат = ИнициализироватьРезультат(0);
	lsaAPI_Settings = ПолучитьНастройкиСоединения();
	Если ИсходящиеПараметрыМассив <> Неопределено И ИсходящиеПараметрыМассив.Количество() > 0 Тогда
		Попытка
			JSON_Объект = Новый Структура;
			JSON_Объект.Вставить("_parameters", ИсходящиеПараметрыМассив);
			ИсходящаяСтрока = JSON_Записать(JSON_Объект);
		Исключение
			Результат = ИнициализироватьРезультат(5, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Если НетОшибок(Результат) Тогда
		SSL = Новый ЗащищенноеСоединениеOpenSSL;
		Если lsaAPI_Settings.ProxyИспользуется Тогда
			Если lsaAPI_Settings.ProxyНастройкиИзСистемы Тогда
				Прокси = Новый ИнтернетПрокси(Истина);
			Иначе
				Прокси = Новый ИнтернетПрокси(Ложь);
				Прокси.Установить("https", lsaAPI_Settings.ProxyСервер, lsaAPI_Settings.ProxyПорт, lsaAPI_Settings.ProxyЛогин, lsaAPI_Settings.ProxyПароль, lsaAPI_Settings.ProxyИспользоватьАутентификациюОС);
				Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Не lsaAPI_Settings.ProxyИспользоватьДляЛокальныхАдресов;
			КонецЕсли;
		Иначе
			Прокси = Новый ИнтернетПрокси(Ложь);
			Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
		КонецЕсли;
		Соединение = Новый HTTPСоединение(lsaAPI_Settings.Сервер, lsaAPI_Settings.Порт, lsaAPI_Settings.Логин, lsaAPI_Settings.Пароль, Прокси, 5, SSL);
		SessionID = ?(sid = "", "", "?sid=" + sid);
		Запрос = Новый HTTPЗапрос("/lsaAPI/rest/TNode1/""" + MethodName + """/" + SessionID);
		Если ИсходящаяСтрока <> "" Тогда
			Запрос.УстановитьТелоИзСтроки(ИсходящаяСтрока, "UTF-8");
		КонецЕсли;
		НачалоИсполненияHttp = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			HTTPОтвет = Соединение.Записать(Запрос);
		Исключение
			Результат = ИнициализироватьРезультат(1, ОписаниеОшибки());
		КонецПопытки;
		ЗавершениеИсполненияHttp = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если НетОшибок(Результат) Тогда
			ВходящаяСтрока = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
			Если HTTPОтвет.КодСостояния <> 201 Тогда
				Результат = ИнициализироватьРезультат(3, "Получен код: " + HTTPОтвет.КодСостояния + ", ожидался: 201.");
			КонецЕсли;
			Если НетОшибок(Результат) Тогда
				Попытка
					JSON_ОбъектРезультат = JSON_Прочитать(ВходящаяСтрока);
					Если Не JSON_ОбъектРезультат.Свойство("result") Или ТипЗнч(JSON_ОбъектРезультат.result) <> Тип("Массив") Или ТипЗнч(JSON_ОбъектРезультат.result[0]) <> Тип("Структура") Или Не JSON_ОбъектРезультат.result[0].Свойство("type") Тогда
						Результат = ИнициализироватьРезультат(7);
					КонецЕсли;
					Если НетОшибок(Результат) Тогда
						Если ВРег(ExpectedJSONObjectName) <> ВРег(JSON_ОбъектРезультат.result[0].type) Тогда
							Результат = ИнициализироватьРезультат(8, "Входящий объект:" + JSON_ОбъектРезультат.result[0].type);
						КонецЕсли;
					КонецЕсли;
				Исключение
					Результат = ИнициализироватьРезультат(2, ОписаниеОшибки());
				КонецПопытки;
				Если НетОшибок(Результат) Тогда
					Результат = JSON_ОбъектРезультат.result[0];
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗавершениеИсполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Результат.fields.ExecutionTimeFrom1c = ЗавершениеИсполнения - НачалоИсполнения;
	Если НачалоИсполненияHttp <> - 1 И ЗавершениеИсполненияHttp <> - 1 Тогда
		Результат.fields.ExecutionTimeFrom1cHttpOnly = ЗавершениеИсполненияHttp - НачалоИсполненияHttp;
	КонецЕсли;
	Возврат Результат;
КонецФункции

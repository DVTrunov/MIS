Функция ПолучитьЯзыкПользователя()
	ТекЯзык = ТекущийЯзык();
	Если ТипЗнч(ТекЯзык) = Тип("ОбъектМетаданных") Тогда
		ТекЯзык = ТекЯзык.КодЯзыка;
	КонецЕсли;
	Если ТипЗнч(ТекЯзык) <> Тип("Строка") Или ТекЯзык = "" Тогда
		ТекЯзык = "ru";
	КонецЕсли;
	Возврат ТекЯзык;
КонецФункции
Функция ПолучитьЯзыкКлиентаЛицензирования() Экспорт
	Возврат ЗагрузитьПараметрИзХранилищаПользователя("ПараметрыКлиентаЛицензирования.ЯзыкКлиентаЛицензирования");
КонецФункции
Процедура СборщикМусораПользовательскогоСеансовогоХранилища()
	ТекущийПользователь = "";
	СеансыИБ = ПолучитьСеансыИнформационнойБазы();
	НомераАктивныхСоединений = Новый Массив;
	Для каждого ЭлементЗн Из СеансыИБ Цикл
		НомераАктивныхСоединений.Добавить(Формат(ЭлементЗн.НомерСеанса, "ЧН=0; ЧГ=0"));
	КонецЦикла;
	Попытка
		СозданныеХранилища = ХранилищеОбщихНастроек.Загрузить("доп_СистемаЛицензирования_1_6_Ассистент", "НомераСтруктурСеансовыхПараметров", , ТекущийПользователь);
	Исключение
		СозданныеХранилища = Неопределено;
	КонецПопытки;
	ТекущиеХранилища = Новый Массив;
	Если ЗначениеОпределено(СозданныеХранилища) Тогда
		Для каждого НомерСеанса Из СозданныеХранилища Цикл
			Если Не ЗначениеОпределено(НомераАктивныхСоединений.Найти(НомерСеанса)) Тогда
				Попытка
					ХранилищеОбщихНастроек.Удалить("доп_СистемаЛицензирования_1_6_Ассистент", "СеансовыеПараметры_" + НомерСеанса, ТекущийПользователь);
				Исключение
				КонецПопытки;
			Иначе
				ТекущиеХранилища.Добавить(НомерСеанса);
			КонецЕсли;
		КонецЦикла;
		ХранилищеОбщихНастроек.Сохранить("доп_СистемаЛицензирования_1_6_Ассистент", "НомераСтруктурСеансовыхПараметров", ТекущиеХранилища, , ТекущийПользователь);
	КонецЕсли;
КонецПроцедуры
Функция ПользовательскоеСеансовоеХранилищеИнициализировано()
	Результат = Ложь;
	ТекущийПользователь = "";
	НСИБ = ПараметрыСеанса.доп_сл_БуферЛицензирования;
	Если ПараметрыСеанса.доп_сл_БуферЛицензирования = "" Тогда
		НСИБ = Формат(НомерСеансаИнформационнойБазы(), "ЧН=0; ЧГ=0");
	КонецЕсли;
	СеансовоеХранилище = ХранилищеОбщихНастроек.Загрузить("доп_СистемаЛицензирования_1_6_Ассистент", "СеансовыеПараметры_" + НСИБ, , ТекущийПользователь);
	Если ЗначениеЗаполнено(СеансовоеХранилище) И ТипЗнч(СеансовоеХранилище) = Тип("Структура") И СеансовоеХранилище.Свойство("ИдНастроек") Тогда
		Результат = ПараметрыСеанса.доп_сл_ИдНастроек = СеансовоеХранилище.ИдНастроек;
	КонецЕсли;
	Возврат Результат;
КонецФункции
Функция ИнициализироватьПользовательскоеСеансовоеХранилище(Пересоздать = Ложь)
	ТекущийПользователь = "";
	Если ПараметрыСеанса.доп_сл_БуферЛицензирования = "" Тогда
		ПараметрыСеанса.доп_сл_БуферЛицензирования = Формат(НомерСеансаИнформационнойБазы(), "ЧН=0; ЧГ=0");
	КонецЕсли;
	НСИБ = ПараметрыСеанса.доп_сл_БуферЛицензирования;
	Попытка
		СеансовоеХранилище = ХранилищеОбщихНастроек.Загрузить("доп_СистемаЛицензирования_1_6_Ассистент", "СеансовыеПараметры_" + НСИБ, , ТекущийПользователь);
	Исключение
		СеансовоеХранилище = Неопределено;
	КонецПопытки;
	Если Не ЗначениеОпределено(СеансовоеХранилище) Или Пересоздать Тогда
		СборщикМусораПользовательскогоСеансовогоХранилища();
		Если ЗначениеОпределено(СеансовоеХранилище) Тогда
			ХранилищеОбщихНастроек.Удалить("доп_СистемаЛицензирования_1_6_Ассистент", "СеансовыеПараметры_" + НСИБ, ТекущийПользователь);
		КонецЕсли;
		СтруктураПараметрыКлиентаЛицензирования = Новый Структура;
		СтруктураПараметрыКлиентаЛицензирования.Вставить("ИдентификаторОсновногоПродукта", Неопределено);
		СтруктураПараметрыКлиентаЛицензирования.Вставить("ПоддерживаетсяВыборВерсий", Ложь);
		СтруктураПараметрыКлиентаЛицензирования.Вставить("ЯзыкКлиентаЛицензирования", ПолучитьЯзыкПользователя());
		СеансовоеХранилище = Новый Структура;
		СеансовоеХранилище.Вставить("ИдНастроек", ПараметрыСеанса.доп_сл_ИдНастроек);
		СеансовоеХранилище.Вставить("ПараметрыКлиентаЛицензирования", СтруктураПараметрыКлиентаЛицензирования);
		СеансовоеХранилище.Вставить("ВыполнятьПоддержкуКлиента", Ложь);
		СеансовоеХранилище.Вставить("ПоддержкаКлиентаПоследняяОшибка", Неопределено);
		СеансовоеХранилище.Вставить("ЧислоОшибокПоддержкиРаботыКлиента", 0);
		СеансовоеХранилище.Вставить("ТребуетсяПереполучитьЛицензию", Ложь);
		СеансовоеХранилище.Вставить("SessionID", "");
		СеансовоеХранилище.Вставить("КлючФЗИнтервальногоОбращения", Строка(Новый УникальныйИдентификатор));
		ХранилищеОбщихНастроек.Сохранить("доп_СистемаЛицензирования_1_6_Ассистент", "СеансовыеПараметры_" + НСИБ, СеансовоеХранилище, , ТекущийПользователь);
		Попытка
			СозданныеХранилища = ХранилищеОбщихНастроек.Загрузить("доп_СистемаЛицензирования_1_6_Ассистент", "НомераСтруктурСеансовыхПараметров", , ТекущийПользователь);
		Исключение
			СозданныеХранилища = Неопределено;
		КонецПопытки;
		Если ЗначениеОпределено(СозданныеХранилища) Тогда
			Если Не ЗначениеОпределено(СозданныеХранилища.Найти(НСИБ)) Тогда
				СозданныеХранилища.Добавить(НСИБ);
			КонецЕсли;
		Иначе
			СозданныеХранилища = Новый Массив;
			СозданныеХранилища.Добавить(НСИБ);
		КонецЕсли;
		ХранилищеОбщихНастроек.Сохранить("доп_СистемаЛицензирования_1_6_Ассистент", "НомераСтруктурСеансовыхПараметров", СозданныеХранилища, , ТекущийПользователь);
	КонецЕсли;
КонецФункции
Функция ИнициализироватьПользовательскоеПостоянноеХранилище()
	ТекущийПользователь = "";
	Попытка
		ПостоянноеХранилище = ХранилищеОбщихНастроек.Загрузить("доп_СистемаЛицензирования_1_6_Ассистент", "ПостоянныеПараметры", , ТекущийПользователь);
	Исключение
		ПостоянноеХранилище = Неопределено;
	КонецПопытки;
	Если Не ЗначениеОпределено(ПостоянноеХранилище) Тогда
		ПостоянныеПараметры = Новый Структура;
		ПостоянныеПараметры.Вставить("ВерсияХранилища", 1);
		ХранилищеОбщихНастроек.Сохранить("доп_СистемаЛицензирования_1_6_Ассистент", "ПостоянныеПараметры", ПостоянныеПараметры, , ТекущийПользователь);
	КонецЕсли;
КонецФункции
Процедура ЗаписатьПараметрВХранилищеПользователя(Ключ, Значение, ВПостоянное = Ложь) Экспорт
	Инициализировать();
	ТекущийПользователь = "";
	Если ВПостоянное Тогда
		КлючНастроек = "ПостоянныеПараметры";
	Иначе
		Если ПараметрыСеанса.доп_сл_БуферЛицензирования = "" Тогда
			ПараметрыСеанса.доп_сл_БуферЛицензирования = Формат(НомерСеансаИнформационнойБазы(), "ЧН=0; ЧГ=0");
		КонецЕсли;
		КлючНастроек = "СеансовыеПараметры_" + ПараметрыСеанса.доп_сл_БуферЛицензирования;
	КонецЕсли;
	Попытка
		ХранилищеПараметров = ХранилищеОбщихНастроек.Загрузить("доп_СистемаЛицензирования_1_6_Ассистент", КлючНастроек, , ТекущийПользователь);
		Возврат;
	Исключение
		ХранилищеПараметров = Неопределено;
	КонецПопытки;
	ХранилищеОбщихНастроек.Сохранить("доп_СистемаЛицензирования_1_6_Ассистент", КлючНастроек, ХранилищеПараметров, , ТекущийПользователь);
КонецПроцедуры
Функция ЗагрузитьПараметрИзХранилищаПользователя(Ключ, ИзПостоянного = Ложь) Экспорт
	Инициализировать();
	Результат = Неопределено;
	ТекущийПользователь = "";
	Если ИзПостоянного Тогда
		КлючНастроек = "ПостоянныеПараметры";
	Иначе
		Если ПараметрыСеанса.доп_сл_БуферЛицензирования = "" Тогда
			ПараметрыСеанса.доп_сл_БуферЛицензирования = Формат(НомерСеансаИнформационнойБазы(), "ЧН=0; ЧГ=0");
		КонецЕсли;
		КлючНастроек = "СеансовыеПараметры_" + ПараметрыСеанса.доп_сл_БуферЛицензирования;
	КонецЕсли;
	Попытка
		ХранилищеПараметров = ХранилищеОбщихНастроек.Загрузить("доп_СистемаЛицензирования_1_6_Ассистент", КлючНастроек, , ТекущийПользователь);
		Выполнить("Результат = ХранилищеПараметров" + ?(Ключ = "", Ключ, "." + Ключ) + ";");
	Исключение
		ХранилищеПараметров = Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции
Процедура ВключитьТестирование() Экспорт
	доп_сл_сервер.УстановитьБуфер("{66C413ED-C236-483C-BE47-8ECD7D3B2FC2}", Истина);
КонецПроцедуры
Процедура ЗарегистрироватьСеансВРегистре(ИдентификаторСеанса, АдресСервераЛицензий, ПортСервераЛицензий, ПортАссистента, ИспользоватьProxy) Экспорт

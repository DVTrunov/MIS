	Запись.ИдентификаторСеанса = ИдентификаторСеанса;
	Запись.АдресСервераЛицензий = АдресСервераЛицензий;
	Запись.ПортСервераЛицензий = ПортСервераЛицензий;
	Запись.ПортАссистента = ПортАссистента;
	Запись.ИспользоватьProxy = ИспользоватьProxy;
	Запись.МоментРегистрацииВРегистре = ТекущаяДата();
	Запись.Записать();
КонецПроцедуры
Процедура УдалитьРегистрациюСеансаИзРегистра(ИдентификаторСеанса) Экспорт
	Запись = РегистрыСведений.доп_сл_СерверныеСеансы.СоздатьМенеджерЗаписи();

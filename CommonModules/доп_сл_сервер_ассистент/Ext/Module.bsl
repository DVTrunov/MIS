Функция ИнициализироватьРезультат(КодРезультата = 0, Комментарий = "")
	МассивДополнительныхПараметров = Новый Массив;
	Результат = Новый Структура;
	СтруктураПоля = Новый Структура;
	КодСтрока = "ОписаниеКодаРезультатаАссистента_" + Формат(КодРезультата, "ЧГ=0;ЧН=0");
	Если КодРезультата < 10 Тогда
		Описание = доп_сл_общий.ПолучитьСтрокуСообщения(КодСтрока);
	Иначе
		Описание = доп_сл_общий.ПолучитьСтрокуСообщения("ОписаниеКодаРезультатаАссистентаНеЗаполнено");
	КонецЕсли;
	Результат.Вставить("type", "lsaAPI-1C.TError");
	Результат.Вставить("id", 1);
	СтруктураПоля.Вставить("Code", КодРезультата);
	СтруктураПоля.Вставить("Comment", Комментарий);
	СтруктураПоля.Вставить("Description", Описание);
	СтруктураПоля.Вставить("MethodResult", "");
	СтруктураПоля.Вставить("ExecutionTimeFrom1c", - 1);
	СтруктураПоля.Вставить("ExecutionTimeFrom1cHttpOnly", - 1);
	Результат.Вставить("fields", СтруктураПоля);
	Возврат Результат;

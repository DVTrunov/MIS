	Запись.Прочитать();
	Запись.Удалить();
КонецПроцедуры
Процедура ВыполнитьПоддержкуРаботыКлиента(СнятьАктивныеЗадачи = Ложь) Экспорт
	ВыполнятьПоддержкуКлиента = ЗагрузитьПараметрИзХранилищаПользователя("ВыполнятьПоддержкуКлиента");
	НомерСоединенияИнформационнойБазы = ПараметрыСеанса.доп_сл_БуферЛицензирования;
	ИдНастроек = ПараметрыСеанса.доп_сл_ИдНастроек;
	SessionID = ЗагрузитьПараметрИзХранилищаПользователя("SessionID");
	Если доп_сл_сервер.ЭтоСервернаяБаза() Или доп_сл_сервер.ПоддержкаКода(8, 3, 3) Тогда
		КлючФЗИнтервальногоОбращения = ЗагрузитьПараметрИзХранилищаПользователя("КлючФЗИнтервальногоОбращения");
		ЗапуститьФЗ = ВыполнятьПоддержкуКлиента И Не СнятьАктивныеЗадачи;
		Если СнятьАктивныеЗадачи Или ВыполнятьПоддержкуКлиента Тогда
			Отбор = Новый Структура;
			Отбор.Вставить("Ключ", КлючФЗИнтервальногоОбращения);
			Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
			НайденныеФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
			Если НайденныеФоновыеЗадания.Количество() > 0 Тогда
				ФЗ = НайденныеФоновыеЗадания[0];
				ФЗ.Отменить();
				ЗапуститьФЗ = Ложь;
				ЧислоОшибокПоддержкиРаботыКлиента = ЗагрузитьПараметрИзХранилищаПользователя("ЧислоОшибокПоддержкиРаботыКлиента");
				ЗаписатьПараметрВХранилищеПользователя("ЧислоОшибокПоддержкиРаботыКлиента", ЧислоОшибокПоддержкиРаботыКлиента + 1);
				Если ЧислоОшибокПоддержкиРаботыКлиента = 5 Тогда
					ЗаписатьПараметрВХранилищеПользователя("ВыполнятьПоддержкуКлиента", Ложь);
					ЗаписатьПараметрВХранилищеПользователя("ТребуетсяПереполучитьЛицензию", Истина);
					ЗаписатьПараметрВХранилищеПользователя("ПоддержкаКлиентаПоследняяОшибка", ИнициализироватьРезультат(9));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЗапуститьФЗ Тогда
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("НомерРодительскогоСеансаИБ", НомерСоединенияИнформационнойБазы);
			СтруктураПараметров.Вставить("ИдНастроек", ИдНастроек);
			СтруктураПараметров.Вставить("SessionID", SessionID);
			Параметры = Новый Массив;
			Параметры.Добавить(СтруктураПараметров);
			Если ЗначениеЗаполнено(SessionID) Тогда
				ФЗ = ФоновыеЗадания.Выполнить("доп_сл_сервер_ассистент.ОбработкаФЗИнтервальнойПоддержкиКлиента", Параметры, КлючФЗИнтервальногоОбращения);
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(SessionID) И ВыполнятьПоддержкуКлиента Тогда
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("НомерРодительскогоСеансаИБ", НомерСоединенияИнформационнойБазы);
			СтруктураПараметров.Вставить("ИдНастроек", ИдНастроек);
			СтруктураПараметров.Вставить("SessionID", SessionID);
			ОбработкаФЗИнтервальнойПоддержкиКлиента(СтруктураПараметров);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ОбработкаФЗИнтервальнойПоддержкиКлиента(Параметры) Экспорт
	ПараметрыСеанса.доп_сл_БуферЛицензирования = Параметры.НомерРодительскогоСеансаИБ;
	ПараметрыСеанса.доп_сл_ИдНастроек = Параметры.ИдНастроек;
	SessionID = Параметры.SessionID;
	Результат = lsaAPI_SlExtendAssistantSessionLifeTime(SessionID);
	Если Не НетОшибок(Результат) Тогда
		ЧислоОшибокПоддержкиРаботыКлиента = ЗагрузитьПараметрИзХранилищаПользователя("ЧислоОшибокПоддержкиРаботыКлиента");
		ЧислоОшибокПоддержкиРаботыКлиента = ЧислоОшибокПоддержкиРаботыКлиента + 1;
		ЗаписатьПараметрВХранилищеПользователя("ЧислоОшибокПоддержкиРаботыКлиента", ЧислоОшибокПоддержкиРаботыКлиента);
		Если ЧислоОшибокПоддержкиРаботыКлиента = 1 Тогда
			ЗаписатьПараметрВХранилищеПользователя("ВыполнятьПоддержкуКлиента", Ложь);
			ЗаписатьПараметрВХранилищеПользователя("ТребуетсяПереполучитьЛицензию", Истина);
			ЗаписатьПараметрВХранилищеПользователя("ПоддержкаКлиентаПоследняяОшибка", Результат);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ОбработкаРЗМенеджерСеансов() Экспорт
	Если доп_сл_сервер.ЭтоСервернаяБаза() Тогда
		СеансыИБ = ПолучитьСеансыИнформационнойБазы();
		НомераАктивныхСоединений = Новый Массив;
		Для каждого ЭлементЗн Из СеансыИБ Цикл
			Если ЭлементЗн.ИмяПриложения <> "SrvrConsole" И ЭлементЗн.ИмяПриложения <> "COMConsole" И ЭлементЗн.ИмяПриложения <> "JobScheduler" И ЭлементЗн.ИмяПриложения <> "BackgroundJob" И ЭлементЗн.ИмяПриложения <> "SystemBackgroundJob" И ЭлементЗн.ИмяПриложения <> "Designer" Тогда
				НомераАктивныхСоединений.Добавить(Формат(70000 + ЭлементЗн.НомерСеанса, "ЧН=0; ЧГ=0"));
			КонецЕсли;
		КонецЦикла;
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ		|	доп_сл_СерверныеСеансы.ИдентификаторСеанса,		|	доп_сл_СерверныеСеансы.АдресСервераЛицензий,		|	доп_сл_СерверныеСеансы.ПортСервераЛицензий,		|	доп_сл_СерверныеСеансы.ПортАссистента,		|   доп_сл_СерверныеСеансы.ИспользоватьProxy,		|	ВЫБОР		|		КОГДА доп_сл_СерверныеСеансы.ИдентификаторСеанса В (&НомераАктивныхСоединений)		|			ТОГДА ИСТИНА		|		ИНАЧЕ ЛОЖЬ		|	КОНЕЦ КАК СоединениеАктивно		|ИЗ		|	РегистрСведений.доп_сл_СерверныеСеансы КАК доп_сл_СерверныеСеансы";
		Запрос.УстановитьПараметр("НомераАктивныхСоединений", НомераАктивныхСоединений);
		РезультатЗапроса = Запрос.Выполнить();
		РезультатЗапросаВыборка = РезультатЗапроса.Выбрать();
		Пока РезультатЗапросаВыборка.Следующий() Цикл
			Если Не РезультатЗапросаВыборка.СоединениеАктивно Тогда
				ПараметрыСоединения = доп_сл_сервер.ПолучитьСтруктуруНастроекСоединения(РезультатЗапросаВыборка.АдресСервераЛицензий, РезультатЗапросаВыборка.ПортСервераЛицензий, РезультатЗапросаВыборка.ПортАссистента, РезультатЗапросаВыборка.ИспользоватьProxy);
				доп_сл_сервер.ОтключитьсяОтСервера(РезультатЗапросаВыборка.ИдентификаторСеанса, ПараметрыСоединения);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

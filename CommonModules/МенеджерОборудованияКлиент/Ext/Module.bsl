			НСтр("ru='Весы с печатью этикеток не подключены.'"),
			НСтр("ru='Весы с печатью этикеток не выбраны.'"), 
			Истина);
	Иначе
		НачатьОчисткуТоваровВВесахСПечатьюЭтикеток_ВыбратьУстройствоЗавершение(ИдентификаторУстройства, Контекст);

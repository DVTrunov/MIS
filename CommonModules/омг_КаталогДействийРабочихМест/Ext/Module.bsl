	   Д.ПроверяемыйОбъект = "Обработка.доп_Битфон";
	   	   Д.ИмяКартинки = "омг_Телефон";

	   
	   Д = НовоеДействие(Действия, "WhatsApp", "Коммуникации", 810);
	   Д.Наименование      = "WhatsApp";

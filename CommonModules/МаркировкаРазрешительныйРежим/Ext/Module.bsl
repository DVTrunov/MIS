	КешНастроекРазбораКодаМаркировки.Вставить("ПустоеПримечаниеКРезультатуРазбора",              ПримечаниеКРезультатуРазбора);
	
	Возврат КешНастроекРазбораКодаМаркировки;
	
КонецФункции


		|	И СТРНАЙТИ(ОказаниеУслугРаботы.Номенклатура.Наименование, ""забор"") = 0
		|	И ОказаниеУслугРаботы.Ссылка.омг_СтраховаяПрограмма = ЗНАЧЕНИЕ(Справочник.СоглашенияСтрахования.ПустаяСсылка)
		|	И ОказаниеУслугРаботы.Ссылка.Проведен
		|	И ОказаниеУслугРаботы.Ссылка.НомерЧекаККМ > 0
		|	И ОказаниеУслугРаботы.Ссылка.Дата >= &ДатаПрошлыйГод
		|	И ОказаниеУслугРаботы.Ссылка.Клиент = &Клиент
		|	И ОказаниеУслугРаботы.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ВозвратКлиенту)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОказаниеУслугРаботы.Ссылка,
		|	ОказаниеУслугРаботы.Ссылка.Дата,
		|	ОказаниеУслугРаботы.Ссылка.Клиент,
		|	ОказаниеУслугРаботы.Ссылка.НомерЧекаККМ,
		|	ОказаниеУслугРаботы.Ссылка.ВидОперации,
		|	ОказаниеУслугРаботы.Ссылка.омг_СтраховаяПрограмма,
		|	ОказаниеУслугРаботы.Ссылка.ДокументОснование,
		|	ОказаниеУслугРаботы.Ссылка.СуммаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОказаниеУслуг.ДокументОснование.Дата КАК ДокументОснованиеДата,
		|	ЕСТЬNULL(ОказаниеУслуг.ДокументОснование.Дата, НЕОПРЕДЕЛЕНО) КАК Поле1
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Клиенты.омг_ПостоянныйКлиент КАК ПостоянныйКлиент
		|ИЗ
		|	Справочник.Клиенты КАК Клиенты
		|ГДЕ
		|	Клиенты.Ссылка = &Клиент";
		

		Запрос.УстановитьПараметр("ДатаПрошлыйГод", НачалоДня(ДобавитьМесяц(Источник.Дата,-12)));
		Запрос.УстановитьПараметр("Клиент", Источник.Клиент);
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);

		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ВыборкаПоБудущимДокументам = РезультатЗапроса[0].Выбрать();
		ВыборкаПоБудущимВозвратам = РезультатЗапроса[1].Выбрать();
		ДокументОснованиеДата = РезультатЗапроса[2].Выбрать(); 
		ПостоянныйКлиентВыборка = РезультатЗапроса[3].Выбрать();
		ПостоянныйКлиентВыборка.Следующий();
		ДокументОснованиеДата.Следующий();
		ДокументОснованиеДата = ДокументОснованиеДата.ДокументОснованиеДата;
		МасВремени = Новый Массив;
		Пока ВыборкаПоБудущимДокументам.Следующий() Цикл
			ПостоянныйКлиент = Истина;
			ВыборкаПоБудущимВозвратам.Сбросить();
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("ДокументОснование",ВыборкаПоБудущимДокументам.Ссылка);
			Если ВыборкаПоБудущимВозвратам.НайтиСледующий(СтрПоиска) Тогда
				Если ВыборкаПоБудущимВозвратам.СуммаДокумента >= ВыборкаПоБудущимДокументам.СуммаДокумента Тогда
					ПостоянныйКлиент = Ложь;	 
				КонецЕсли; 
				Если РежимПроведения = Неопределено и ВыборкаПоБудущимДокументам.Ссылка = Источник.ДокументОснование Тогда
					ПостоянныйКлиент = Истина;
				КонецЕсли;
			КонецЕсли; 
			Если ПостоянныйКлиент Тогда  
				Если РежимПроведения = Неопределено и ВыборкаПоБудущимДокументам.Ссылка = Источник.Ссылка Тогда 
				иначе
					МасВремени.Добавить(ВыборкаПоБудущимДокументам.Ссылка.МоментВремени());
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;  
		
		КолВремен = МасВремени.Количество();
		
		Если КолВремен > 0 Тогда   
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	омг_ПостоянныеКлиенты.Период КАК Период,
			|	омг_ПостоянныеКлиенты.Клиент КАК Клиент,
			|	омг_ПостоянныеКлиенты.ОказаниеУслуг КАК ОказаниеУслуг,
			|	омг_ПостоянныеКлиенты.Постоянный КАК Постоянный,
			|	омг_ПостоянныеКлиенты.ДоДаты КАК ДоДаты
			|ИЗ
			|	РегистрСведений.омг_ПостоянныеКлиенты КАК омг_ПостоянныеКлиенты
			|ГДЕ
			|	омг_ПостоянныеКлиенты.Клиент = &Клиент
			|	И омг_ПостоянныеКлиенты.Период >= &ДатаНачала";
			
			Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Источник.Дата));
			Запрос.УстановитьПараметр("Клиент", Источник.Клиент);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
				
				НоваяЗапись = РегистрыСведений.омг_ПостоянныеКлиенты.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаДетальныеЗаписи);
				НоваяЗапись.Удалить();
				
			КонецЦикла;
			
			сч = 1;   
			ВремяДата1 = Источник.Дата;  
		
			ДатаМин = ?(Источник.ВидОперации = Перечисления.ВидыОперацийОказанияУслуг.ВозвратКлиенту,ДокументОснованиеДата,Источник.Дата);
			
			Для каждого СтрМасВремени из МасВремени Цикл
				
				Если сч = 2 и СтрМасВремени.Дата >= ДатаМин Тогда
					
					Если СтрМасВремени.Дата <= ДобавитьМесяц(ВремяДата1,12) Тогда
						НоваяЗапись = РегистрыСведений.омг_ПостоянныеКлиенты.СоздатьМенеджерЗаписи();
						НоваяЗапись.Период = НачалоДня(СтрМасВремени.Дата);
						НоваяЗапись.ДоДаты = КонецДня(ДобавитьМесяц(СтрМасВремени.Дата,12));
						НоваяЗапись.Клиент = Источник.Клиент;
						НоваяЗапись.ОказаниеУслуг = СтрМасВремени.Ссылка; 
						НоваяЗапись.Постоянный = Истина; 
						НоваяЗапись.Записать(Истина);					
					КонецЕсли;
					
				иначе
					сч = 2;
				КонецЕсли;
				
				ВремяДата1 = СтрМасВремени.Дата;
				
			КонецЦикла;	
		КонецЕсли; 
		
		ПостоянныйКлиент = Ложь;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_ПостоянныеКлиентыСрезПоследних.Клиент КАК Клиент,
		|	омг_ПостоянныеКлиентыСрезПоследних.ДоДаты КАК ДоДаты,
		|	омг_ПостоянныеКлиентыСрезПоследних.Клиент.омг_ПостоянныйКлиент КАК ПостоянныйКлиент
		|ИЗ
		|	РегистрСведений.омг_ПостоянныеКлиенты.СрезПоследних(, Клиент = &Клиент) КАК омг_ПостоянныеКлиентыСрезПоследних";
		
		Запрос.УстановитьПараметр("Клиент", Источник.Клиент);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда  
			
			Если ВыборкаДетальныеЗаписи.ДоДаты >= ТекущаяДата() Тогда
				ПостоянныйКлиент = Истина
			КонецЕсли;	
			
		КонецЕсли;
		
		Если не ПостоянныйКлиент = ПостоянныйКлиентВыборка.ПостоянныйКлиент  Тогда
			КлиентОбъект =  Источник.Клиент.ПолучитьОбъект();
			КлиентОбъект.омг_ПостоянныйКлиент = ПостоянныйКлиент; 
			КлиентОбъект.ОбменДанными.Загрузка = Истина;
			КлиентОбъект.Записать();
		КонецЕсли;	
			
		Если не ЕстьПривелегии Тогда
			УстановитьПривилегированныйРежим(Ложь)
		КонецЕсли;

	КонецЕсли;	  
	
КонецПроцедуры	

Функция омг_ПроверкаПометкиНаУдаление(ДокСсылка) Экспорт
	
	Возврат ДокСсылка.ПометкаУдаления;
	

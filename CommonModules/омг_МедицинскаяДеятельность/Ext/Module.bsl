Функция ДополнитьСтрокамиИзЧекапов(ТабДокументоРаботы,СписокОбъектов,ДатаНачала,ДатаОкончания,Филиал = Неопределено)Экспорт
	
	СписокДокументов = ТабДокументоРаботы.ВыгрузитьКолонку("ДокументСсылка");
	Запрос = Новый Запрос;
	ТекстФилиал = "";
	Если не Филиал = Неопределено Тогда
		
		   ТекстФилиал = Символы.ПС +  " И ЗаявкаРаботы.Ссылка.Филиал = &Филиал";
		   Запрос.УстановитьПараметр("Филиал", Филиал);
		   
	КонецЕсли;	
		
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаРаботы.Ссылка КАК Ссылка,
		|	ЗаявкаРаботы.ДатаНачала КАК Дата,
		|	ЗаявкаРаботы.ДатаНачала КАК ДокументДатаНачала,
		|	ЗаявкаРаботы.ДатаОкончания КАК ДокументДатаОкончания,
		|	ЗаявкаРаботы.ДатаНачала КАК ДатаНачала,
		|	ЗаявкаРаботы.ДатаОкончания КАК ДатаОкончания,
		|	ЗаявкаРаботы.Ссылка КАК ДокументСсылка,
		|	ЗаявкаРаботы.Ссылка.Клиент КАК КлиентСсылка,
		|	ЗаявкаРаботы.Ссылка.Состояние.Цвет КАК СостояниеЦвет,
		|	ЗаявкаРаботы.Сотрудник КАК ОБЪЕКТ,
		|	ЗаявкаРаботы.Номенклатура КАК Работа,
		|	ЗаявкаРаботы.Сотрудник.Подразделение КАК СотрудникПодразделение,
		|	ЗаявкаРаботы.Сотрудник.Подразделение.Код КАК СотрудникПодразделениеКод
		|ИЗ
		|	Документ.Заявка.Работы КАК ЗаявкаРаботы
		|ГДЕ
		|	ЗаявкаРаботы.Сотрудник В(&СписокСотрудников)
		|	И НЕ ЗаявкаРаботы.Ссылка.Ссылка В (&СписокДокументов)
		|	И ЗаявкаРаботы.ДатаНачала >= &ДатаНачала
		|	И ЗаявкаРаботы.ДатаОкончания <= &ДатаОкончания
		|	И ЗаявкаРаботы.Ссылка.Состояние.ТипСостояния <> ЗНАЧЕНИЕ(Перечисление.ТипыСостоянийЗаявок.Отменена)
		|	И ЗаявкаРаботы.Ссылка.ПометкаУдаления = ЛОЖЬ" + ТекстФилиал;
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	Запрос.УстановитьПараметр("СписокСотрудников", СписокОбъектов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Стр = ТабДокументоРаботы.Добавить();
		ЗаполнитьЗначенияСвойств(Стр,ВыборкаДетальныеЗаписи.Ссылка);
		ЗаполнитьЗначенияСвойств(Стр,ВыборкаДетальныеЗаписи)
	КонецЦикла;
	
	Возврат ТабДокументоРаботы;
	
КонецФункции	

Функция ПроверкаНаИсключениеИзВыработки(Знач СсылкаНаЭлемент) Экспорт
	
	РодителиЭлемента = Новый Массив;
	
	РодителиЭлемента.Вставить(0, СсылкаНаЭлемент);
	
	Пока ЗначениеЗаполнено(СсылкаНаЭлемент.Родитель) Цикл
			РодителиЭлемента.Вставить(0, СсылкаНаЭлемент.Родитель);
			СсылкаНаЭлемент = СсылкаНаЭлемент.Родитель;
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_ИсключенияДляВыработкиСотрудников.ГруппаНоменклатуры КАК ГруппаНоменклатуры
		|ИЗ
		|	РегистрСведений.омг_ИсключенияДляВыработкиСотрудников КАК омг_ИсключенияДляВыработкиСотрудников
		|ГДЕ
		|	омг_ИсключенияДляВыработкиСотрудников.ГруппаНоменклатуры В (&МассГрупп)";
	
	Запрос.УстановитьПараметр("МассГрупп", РодителиЭлемента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Возврат  Истина
		
	КонецЕсли;   
	
		Возврат  Ложь
					
КонецФункции

Процедура омг_ПриЗаписиИнтеграцияСЕИПОтправкаНачисленийНаКартуПриЗаписи(Источник, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не Источник.СостояниеЧековККМ = Перечисления.СостоянияЧековККМ.ЧекиПробиты Или Отказ Или Не Источник.омг_СтраховаяПрограмма.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КартыСкидок.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.КартыСкидок КАК КартыСкидок
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.омг_СоответствиеСкидокВидамКарт КАК омг_СоответствиеСкидокВидамКарт
	               |		ПО КартыСкидок.ВидКарты = омг_СоответствиеСкидокВидамКарт.ВидКарты,
	               |	(ВЫБРАТЬ
	               |		ОказаниеУслугРаботы.Ссылка КАК Ссылка
	               |	ИЗ
	               |		Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
	               |	ГДЕ
	               |		НЕ ОказаниеУслугРаботы.Номенклатура В ИЕРАРХИИ
	               |					(ВЫБРАТЬ
	               |						омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |					ИЗ
	               |						РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС)
	               |		И ОказаниеУслугРаботы.Ссылка = &Документ) КАК ВложенныйЗапрос
	               |ГДЕ
	               |	НЕ омг_СоответствиеСкидокВидамКарт.ВидСкидки.КодЕИП = """"
	               |	И КартыСкидок.Ссылка = &Ссылка
	               |	И НЕ ВложенныйЗапрос.Ссылка ЕСТЬ NULL";
	Запрос.УстановитьПараметр("Ссылка", Источник.КартаКлиента);
	Запрос.УстановитьПараметр("Документ", Источник.Ссылка);
	ПропуститьДокумент = Запрос.Выполнить().Пустой();
	
	Если ПропуститьДокумент Тогда
		Возврат;
	КонецЕсли;
	
	Запись = РегистрыСведений.омг_ДокументыНачисленийНаКартыЕИП.СоздатьМенеджерЗаписи();
	Запись.Документ = Источник.Ссылка;
	Запись.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


Процедура КонтрольПоНоменклатуре(ДокументОбъект, ЭтоУдаление = Ложь) Экспорт

	Возврат;
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаявкаСсылка = Неопределено;
		
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.Заявка") Тогда
		ЗаявкаСсылка = ДокументОбъект.Ссылка 
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(ЗаявкаСсылка) Тогда 
		
		Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда
			Если ТипЗнч(ДокументОбъект.ДокументОснование.Ссылка) = Тип("ДокументСсылка.Заявка") Тогда
				ЗаявкаСсылка = ДокументОбъект.ДокументОснование.Ссылка	
			КонецЕсли;				
		КонецЕсли;
		
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(ЗаявкаСсылка) Тогда  
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;	 	 

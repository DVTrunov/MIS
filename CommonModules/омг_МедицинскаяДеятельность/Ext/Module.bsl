Функция ПроверитьПериодДействияНабора(ПроверочнаяДата,Набор) Экспорт
	
	ВозрЗначение = Ложь;
	
	ПустаяДата = Дата("00010101");
    омг_ДатаНачалДействияНабора = ПустаяДата;
	омг_ДатаОкончанияДействияНабора = ПустаяДата;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.омг_ДатаНачалДействияНабора КАК омг_ДатаНачалДействияНабора,
		|	Номенклатура.омг_ДатаОкончанияДействияНабора КАК омг_ДатаОкончанияДействияНабора
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Набор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		омг_ДатаНачалДействияНабора  =  ВыборкаДетальныеЗаписи.омг_ДатаНачалДействияНабора;
		омг_ДатаОкончанияДействияНабора = ВыборкаДетальныеЗаписи.омг_ДатаОкончанияДействияНабора;
	КонецЕсли;
	
	Если омг_ДатаНачалДействияНабора = ПустаяДата и омг_ДатаОкончанияДействияНабора = ПустаяДата Тогда
		 ВозрЗначение = Истина
	ИначеЕсли НачалоДня(омг_ДатаНачалДействияНабора) <= ПроверочнаяДата и ПроверочнаяДата <= КонецДня(омг_ДатаОкончанияДействияНабора) Тогда
		 ВозрЗначение = Истина
	КонецЕсли;	 
	
	Возврат ВозрЗначение;
	
КонецФункции	


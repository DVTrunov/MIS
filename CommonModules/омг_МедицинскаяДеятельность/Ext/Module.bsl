Процедура ОбновитьСтатусЗаявки(Прием, Отказ) Экспорт  
		
	Если ЗначениеЗаполнено(Прием.ДокументОснование) и ТипЗнч(Прием.ДокументОснование) = Тип("ДокументСсылка.Заявка") Тогда  
		УстановитьПривилегированныйРежим(Истина);
		Заявка = Прием.ДокументОснование.ПолучитьОбъект();
		Если не Отказ и Прием.Проведен Тогда
			
			Заявка.Омг_СостояниеПоПриемам = Справочники.ВидыСостоянийЗаявок.Прием; 
			Попытка  
			Заявка.ОбменДанными.Загрузка = Истина;
			Заявка.Записать();    
			Исключение
			КонецПопытки;
		иначе 
			
			Заявка.Омг_СостояниеПоПриемам = Справочники.ВидыСостоянийЗаявок.ПустаяСсылка();
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВЫБОР
			|		КОГДА Прием.Проведен
			|			ТОГДА 1
			|		ИНАЧЕ ВЫБОР
			|				КОГДА НЕ Прием.ПометкаУдаления
			|					ТОГДА 2
			|			КОНЕЦ
			|	КОНЕЦ КАК Статус
			|ИЗ
			|	Документ.Прием КАК Прием
			|ГДЕ
			|	Прием.ДокументОснование = &Заявка";
			
			Запрос.УстановитьПараметр("Заявка", Заявка.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("Статус", 2);  
			Если ВыборкаДетальныеЗаписи.НайтиСледующий(СтрПоиска) Тогда
				Заявка.Омг_СостояниеПоПриемам = Справочники.ВидыСостоянийЗаявок.СозданаНаСайте;		
			КонецЕсли;  
			ВыборкаДетальныеЗаписи.Сбросить(); 
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("Статус", 1);
			Если ВыборкаДетальныеЗаписи.НайтиСледующий(СтрПоиска) Тогда
				Заявка.Омг_СостояниеПоПриемам = Справочники.ВидыСостоянийЗаявок.Прием;		
			КонецЕсли;
			Попытка
			Заявка.Записать();
			Исключение
			КонецПопытки;		
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь); 
		
	КонецЕсли; 
	
КонецПроцедуры	


Функция ВернутьМедПерсоналПоВрачу(Врач,Роль) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_СвязиМедПерсонала.Врач КАК Врач,
	               |	омг_СвязиМедПерсонала.Медсестра КАК Медсестра,
	               |	омг_СвязиМедПерсонала.омг_РольПерсонала КАК Роль,
	               |	омг_СвязиМедПерсонала.Период КАК Период,
	               |	омг_СвязиМедПерсонала.Медсестра.Должность КАК Должность
	               |ИЗ
	               |	РегистрСведений.омг_СвязиМедПерсонала КАК омг_СвязиМедПерсонала
	               |ГДЕ
	               |	омг_СвязиМедПерсонала.Врач = &Врач
	               |	И омг_СвязиМедПерсонала.омг_РольПерсонала = &Роль
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Врач", Врач);
	Запрос.УстановитьПараметр("Роль", Роль);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();   
	
	Если РезультатЗапроса.Следующий() Тогда  

		РезультатВозврата = РезультатЗапроса.Медсестра;
	
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь); 
	
	Возврат РезультатВозврата;
	
КонецФункции


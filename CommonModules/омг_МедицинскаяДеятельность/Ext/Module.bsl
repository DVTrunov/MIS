				НоваяЗапись.ДатаОказания = строка.ДатаОказания; 
				НоваяЗапись.УникНомерСтрокиОказание = строка.УникНомерСтрокиОказание; 
				// дополняем из приемов 
				КоличествоПрием = 0;
				СтрПоиска2 = Новый Структура();
				СтрПоиска2.Вставить("Исп",Ложь); 
				СтрПоиска2.Вставить("РегистраторДокументОснование",строка.РегистраторДокументОснование); 
				СтрПоиска2.Вставить("Номенклатура",строка.Номенклатура);
				СтрПоиска2.Вставить("Клиент",строка.Клиент);
				СтрПоиска2.Вставить("Врач",строка.Врач);
				СтрПоиска2.Вставить("Филиал",строка.Филиал);
				СтрПоиска2.Вставить("омг_СтраховаяПрограмма",строка.омг_СтраховаяПрограмма);	
				НайдСтрокиПриема = ТабПриемы.НайтиСтроки(СтрПоиска2); 
				Если НайдСтрокиПриема.Количество() > 0 Тогда
					Для каждого строкаПрием из НайдСтрокиПриема Цикл
						Если строкаПрием.КоличествоВПриеме > 0 Тогда 
							КоличествоПрием = КоличествоПрием + строкаПрием.КоличествоВПриеме;
							строкаПрием.КоличествоВПриеме = 0;
							строкаПрием.Исп = Истина;
						КонецЕсли;
					НоваяЗапись.ДокПриема = строкаПрием.ДокПриема;
					НоваяЗапись.ДатаПриема = строкаПрием.ДатаПриема; 
					НоваяЗапись.УникНомерСтрокиПрием = строкаПрием.УникНомерСтрокиПрием;
					КонецЦикла;	
				КонецЕсли;
				НоваяЗапись.КоличествоВПриеме = КоличествоПрием;
				НаборЗаписейомг_НоменклатураКонтроль.Записать();
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	// Ищем по Не использованные строки Приема 
	НайдСтрокиПриема = ТабПриемы.НайтиСтроки(СтрПоиска); 
	Если НайдСтрокиПриема.Количество() > 0 Тогда
		Для каждого строка из НайдСтрокиПриема Цикл
			Если строка.КоличествоВПриеме > 0 Тогда  
				НаборЗаписейомг_НоменклатураКонтроль = РегистрыСведений.омг_НоменклатураКонтроль.СоздатьНаборЗаписей(); 
				НаборЗаписейомг_НоменклатураКонтроль.Отбор.ДокОказания.Установить(Неопределено); 
				НаборЗаписейомг_НоменклатураКонтроль.Отбор.ДокЗаявки.Установить(Неопределено);
                НаборЗаписейомг_НоменклатураКонтроль.Отбор.ДокПриема.Установить(строка.ДокПриема);
				НаборЗаписейомг_НоменклатураКонтроль.Отбор.Номенклатура.Установить(строка.Номенклатура);
				НоваяЗапись = НаборЗаписейомг_НоменклатураКонтроль.Добавить();  
				ЗаполнитьЗначенияСвойств(НоваяЗапись,строка);
				НоваяЗапись.ДокЗаявки = Неопределено; 
				НоваяЗапись.ДатаЗаявки = Дата(1,1,1);  
				НоваяЗапись.ДокОказания = Неопределено; 
				НоваяЗапись.ДатаОказания = Дата(1,1,1);
				НоваяЗапись.КоличествоВОказании = 0;
				НоваяЗапись.КоличествоВЗаявке = 0;
				НоваяЗапись.КоличествоВПриеме = строка.КоличествоВПриеме; 
				НоваяЗапись.ДокПриема = строка.ДокПриема;
				НоваяЗапись.ДатаПриема = строка.ДатаПриема;
				НоваяЗапись.УникНомерСтрокиПрием = строка.УникНомерСтрокиПрием;
				НаборЗаписейомг_НоменклатураКонтроль.Записать();
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	
	НаборЗаписейомг_НоменклатураКонтроль.Записать();
	УстановитьПривилегированныйРежим(Ложь);  
	
КонецПроцедуры	


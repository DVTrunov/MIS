Процедура ПроверкаПриемов(Источник, Отказ, РежимПроведения)
	
	ЕстьПривелегии = ПривилегированныйРежим();
	
	Если не ЕстьПривелегии Тогда
		УстановитьПривилегированныйРежим(Истина)
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Приемомг_Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Прием.омг_Заявки КАК Приемомг_Заявки
	|ГДЕ
	|	Приемомг_Заявки.Ссылка.Проведен
	|	И Приемомг_Заявки.Заявка В (&Заявки)
	|
	|СГРУППИРОВАТЬ ПО
	|	Приемомг_Заявки.Ссылка";
	
	Если Источник.ВидОперации = Перечисления.ВидыОперацийОказанияУслуг.ВозвратКлиенту Тогда
		
		  Источник = Источник.ДокументОснование.ПолучитьОбъект();
		
	КонецЕсли;
	
		
	Запрос.УстановитьПараметр("Заявки", Источник.Заявки.Выгрузить().ВыгрузитьКолонку("Заявка"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		ПриемОбъект =  ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ДатаКонтроля = ?(значениеЗаполнено(ПриемОбъект.ДокументОснование),ПриемОбъект.ДокументОснование.Дата,ПриемОбъект.Дата);
		
		омг_КонтрольУслугПоЗаявкам = омг_МедицинскаяДеятельность.омг_КонтрольУслугПоЗаявкам(ДатаКонтроля,ПриемОбъект.Врач);
		
		Если омг_КонтрольУслугПоЗаявкам Тогда
			ЭтотОбъект = ПриемОбъект;	
			НаборЗаписей = РегистрыНакопления.омг_НоменклатураЗаявокДляПриемов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
			
			МассивЗаявок = ЭтотОбъект.омг_Заявки.ВыгрузитьКолонку("Заявка");	
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПриемРаботы.Номенклатура КАК Номенклатура,
			|	СУММА(ЕСТЬNULL(ПриемРаботы.Количество, 0)) КАК Количество,
			|	омг_НоменклатураЗаявокДляПриемовОстатки.Заявка КАК Заявка,
			|	СУММА(ЕСТЬNULL(омг_НоменклатураЗаявокДляПриемовОстатки.КоличествоОстаток, 0)) КАК КоличествоОстатокРегистр,
			|	&Период КАК Период,
			|	ПриемРаботы.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Прием.Работы КАК ПриемРаботы
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.омг_НоменклатураЗаявокДляПриемов.Остатки(, Заявка В (&МассивЗаявок)) КАК омг_НоменклатураЗаявокДляПриемовОстатки
			|		ПО ПриемРаботы.Номенклатура = омг_НоменклатураЗаявокДляПриемовОстатки.Номенклатура
			|ГДЕ
			|	ПриемРаботы.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	омг_НоменклатураЗаявокДляПриемовОстатки.Заявка,
			|	ПриемРаботы.Номенклатура,
			|	ПриемРаботы.Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура,
			|	КоличествоОстатокРегистр УБЫВ";
			
			Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
			Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
			Запрос.УстановитьПараметр("МассивЗаявок", МассивЗаявок);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписиПоДокументу = РезультатЗапроса.Выбрать();    			
			Сч = Истина;                                            
			ОсталосьСписать = 0; 
			ТекстОшибки = "";
			Пока ВыборкаДетальныеЗаписиПоДокументу.Следующий() Цикл
				
				Если Сч Тогда
					Номенклатура = ВыборкаДетальныеЗаписиПоДокументу.Номенклатура; 	
					ОсталосьСписать = ВыборкаДетальныеЗаписиПоДокументу.Количество;
					Сч = Ложь;
				КонецЕсли;   
				
				Если не Номенклатура = ВыборкаДетальныеЗаписиПоДокументу.Номенклатура Тогда  
					
					Если не ОсталосьСписать = 0 Тогда
						ТекстОшибки = ТекстОшибки + "В заявках указано меньше услуги " +Номенклатура+ " на " +ОсталосьСписать+ " единиц. Проведение невозможно!" + Символы.ПС;
					КонецЕсли;
					Номенклатура = ВыборкаДетальныеЗаписиПоДокументу.Номенклатура; 	
					ОсталосьСписать = ВыборкаДетальныеЗаписиПоДокументу.Количество;	
					
				КонецЕсли; 
				
				Если ОсталосьСписать > 0 Тогда  
					Если ВыборкаДетальныеЗаписиПоДокументу.КоличествоОстатокРегистр >= ОсталосьСписать Тогда  
						ОсталосьСписать = 0;
					иначе
						ОсталосьСписать = ОсталосьСписать - ВыборкаДетальныеЗаписиПоДокументу.КоличествоОстатокРегистр;
					КонецЕсли; 	
				КонецЕсли;   
				
			КонецЦикла;  
			
			Если не ОсталосьСписать = 0 Тогда
				ТекстОшибки = ТекстОшибки +ВыборкаДетальныеЗаписиПоДокументу.Номенклатура+ " на " +ОсталосьСписать+ " услуги/у." + Символы.ПС;
			КонецЕсли;     
			
			ТекстОшибкиОтсуствуетНоменклатураЗаказ = "";
			
			Для каждого строкаРаботы из ЭтотОбъект.Работы Цикл
				СтрПоиска = Новый Структура("Номенклатура",строкаРаботы.Номенклатура);
				ВыборкаДетальныеЗаписиПоДокументу.Сбросить();
				Если не ВыборкаДетальныеЗаписиПоДокументу.НайтиСледующий(СтрПоиска) Тогда
					ТекстОшибки = ТекстОшибки + строкаРаботы.Номенклатура+ " на "+строкаРаботы.Количество+" услуги/у." + Символы.ПС;
				КонецЕсли;	
			КонецЦикла;	
			
			Если не ТекстОшибки = "" Тогда
				ТекстОшибкиЗаголовок = "В документе приема указано больше услуг чем в документах " + Символы.ПС;  
				Для каждого стрМассивЗаявок из МассивЗаявок Цикл
					ТекстОшибкиЗаголовок = ТекстОшибкиЗаголовок + стрМассивЗаявок + Символы.ПС;		
				КонецЦикла;	
				ТекстОшибкиЗаголовок = ТекстОшибкиЗаголовок + "или Прием по данным услугам уже введен ранее:"+ Символы.ПС;
				ТекстОшибки = ТекстОшибкиЗаголовок + ТекстОшибки + Символы.ПС + "Проведение невозможно!";
				Сообщить(ТекстОшибки,СтатусСообщения.Важное);
			иначе
				Попытка 
					ПриемОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Продолжить
				КонецПопытки;
			КонецЕсли; 
		КонецЕсли;	
		
	КонецЦикла;
	
	Если не ЕстьПривелегии Тогда
		УстановитьПривилегированныйРежим(Ложь)
	КонецЕсли;
	
КонецПроцедуры	

Процедура омг_ПриУдаленииПроведенииОказанияУслугОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	ЕстьПривелегии = ПривилегированныйРежим();
	
	Если не ЕстьПривелегии Тогда
		УстановитьПривилегированныйРежим(Истина)
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Приемомг_Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Прием.омг_Заявки КАК Приемомг_Заявки
	|ГДЕ
	|	Приемомг_Заявки.Ссылка.Проведен
	|	И Приемомг_Заявки.Заявка В (&Заявки)
	|
	|СГРУППИРОВАТЬ ПО
	|	Приемомг_Заявки.Ссылка";
	
	Запрос.УстановитьПараметр("Заявки", Источник.Заявки.Выгрузить().ВыгрузитьКолонку("Заявка"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПриемОбъект =  ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();  
		Попытка
			ПриемОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Продолжить
		КонецПопытки;
		
	КонецЦикла;
	
	Если не ЕстьПривелегии Тогда
		УстановитьПривилегированныйРежим(Ложь)
	КонецЕсли;

КонецПроцедуры

 Функция омг_КонтрольУслугПоЗаявкам(ДатаПроверки,Врач) Экспорт
	 
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_ВрачБезКонтроля.Значение КАК Значение
		|ИЗ
		|	Константа.омг_ВрачБезКонтроля КАК омг_ВрачБезКонтроля
		|ГДЕ
		|	омг_ВрачБезКонтроля.Значение = &Врач";
	
	Запрос.УстановитьПараметр("Врач", Врач);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Ложь
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_ДатаКонтроляУслугПоЗаявкам.Значение КАК Значение
		|ИЗ
		|	Константа.омг_ДатаКонтроляУслугПоЗаявкам КАК омг_ДатаКонтроляУслугПоЗаявкам
		|ГДЕ
		|	омг_ДатаКонтроляУслугПоЗаявкам.Значение > &ПустаяДата
		|	И НАЧАЛОПЕРИОДА(омг_ДатаКонтроляУслугПоЗаявкам.Значение, ДЕНЬ) < &Дата";
	
	Запрос.УстановитьПараметр("ПустаяДата",Дата(1,1,1));
	Запрос.УстановитьПараметр("Дата",ДатаПроверки);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
        УстановитьПривилегированныйРежим(Ложь);
		Возврат Истина
		
	Иначе
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Ложь
		
	КонецЕсли;	
	
КонецФункции

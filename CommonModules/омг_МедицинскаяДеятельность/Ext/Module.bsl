Процедура омг_БлокировкаНаборовСИстекшимПериодом() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	НЕ Номенклатура.Архив
	               |	И НЕ Номенклатура.омг_ДатаОкончанияДействияНабора = ДАТАВРЕМЯ(1, 1, 1)
	               |	И Номенклатура.омг_ДатаОкончанияДействияНабора <= &ТекущаяДата
	               |	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ВидНоменклатуры", Перечисления.ВидыНоменклатуры.Набор);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ЗаписьЖурналаРегистрации("ОМГ: Начало блокировки наборов", УровеньЖурналаРегистрации.Информация,,, "К блокировки подготовлено: " + Выборка.Количество() + " позиций.");
	
	Счетчик = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			НоменклатураОбъект = Выборка.Ссылка.ПолучитьОбъект();
			НоменклатураОбъект.Архив = Истина;
			НоменклатураОбъект.омг_ПричинаАрхивирования = "Автоматическая блокировка номенклатуры в связи с истекшим периодом действия цены.";
			НоменклатураОбъект.Записать();
			Счетчик = Счетчик + 1;
		Исключение
			
		КонецПопытки;
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("ОМГ: Окончание блокировки наборов", УровеньЖурналаРегистрации.Информация,,, "Заблокировано : " + Счетчик + " позиций.");
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПроверкаСостоянияЧеков(Источник, Отказ, РежимПроведения)
	
	ЕстьПривелегии = ПривилегированныйРежим();
	
	Если не ЕстьПривелегии Тогда
		УстановитьПривилегированныйРежим(Истина)
	КонецЕсли; 
	
	Набор = РегистрыСведений.омг_ОказанияУслугБезЧеков.СоздатьНаборЗаписей();
	Набор.Отбор.ОказаниеУслуг.Установить(Источник.Ссылка);
		
	Если не РежимПроведения = Неопределено Тогда		
		Если не Источник.СостояниеЧековККМ = Перечисления.СостоянияЧековККМ.ЧекиПробиты и
			Источник.СуммаДокумента > 0 Тогда
			НоваяЗапись = Набор.Добавить();
			НоваяЗапись.ОказаниеУслуг = Источник.Ссылка; 
			НоваяЗапись.Период = Источник.Дата;	
			НоваяЗапись.Дата = Источник.Дата;
			НоваяЗапись.Ответственный = Источник.Ответственный; 
		КонецЕсли;		
	КонецЕсли;	
	
	Набор.Записать();

	Если не ЕстьПривелегии Тогда
		УстановитьПривилегированныйРежим(Ложь)
	КонецЕсли;
			
КонецПроцедуры	


Функция омг_ОповещениеОказанияБезЧека(Ответственный,ПериодПроверки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозЗначение = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	омг_ОказанияУслугБезЧековСрезПоследних.ОказаниеУслуг КАК ОказаниеУслуг
	|ИЗ
	|	РегистрСведений.омг_ОказанияУслугБезЧеков.СрезПоследних КАК омг_ОказанияУслугБезЧековСрезПоследних
	|ГДЕ
	|	омг_ОказанияУслугБезЧековСрезПоследних.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И омг_ОказанияУслугБезЧековСрезПоследних.Ответственный = &Ответственный";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДата() - (60*60*24*ПериодПроверки)));   
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Ответственный", Ответственный);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ВозЗначение = Истина
	КонецЕсли;    
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ВозЗначение;
	
КонецФункции


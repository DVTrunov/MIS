КонецФункции

Функция омг_ПроверкаВозвратов(Основание,Сотрудник,Клиент,Касса,ЭквайринговыйТерминалНаФорме,Работы) Экспорт
	
	ВозвЗначение = Истина;
	ТекстОшибки = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОказаниеУслуг.Сотрудник КАК Сотрудник,
		|	ОказаниеУслуг.Клиент КАК Клиент,
		|	ОказаниеУслуг.Касса КАК Касса
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ОказаниеУслуг.Клиент,
		|	ОказаниеУслуг.Касса,
		|	ОказаниеУслуг.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОказаниеУслугРаботы.Номенклатура КАК Номенклатура,
		|	СУММА(ОказаниеУслугРаботы.Количество) КАК Количество
		|ИЗ
		|	Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
		|ГДЕ
		|	ОказаниеУслугРаботы.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ОказаниеУслугРаботы.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОказаниеУслугОплата.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал
		|ИЗ
		|	Документ.ОказаниеУслуг.Оплата КАК ОказаниеУслугОплата
		|ГДЕ
		|	ОказаниеУслугОплата.Ссылка = &Ссылка
		|	И ОказаниеУслугОплата.ЭквайринговыйТерминал = &ЭквайринговыйТерминал
		|
		|СГРУППИРОВАТЬ ПО
		|	ОказаниеУслугОплата.ЭквайринговыйТерминал";
	
	Запрос.УстановитьПараметр("Ссылка", Основание);
	Запрос.УстановитьПараметр("ЭквайринговыйТерминал", ЭквайринговыйТерминалНаФорме);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаРеквизиты = РезультатЗапроса[0].Выбрать(); 
	ВыборкаНоменклатура = РезультатЗапроса[1].Выбрать();
    ВыборкаОплаты = РезультатЗапроса[2].Выбрать();
	
	Если ВыборкаРеквизиты.Следующий() Тогда
		
		Если не ВыборкаРеквизиты.Сотрудник = Сотрудник Тогда
			
			ТекстОшибки = ТекстОшибки + " Врач ";
			
		КонецЕсли;	
		
		Если не ВыборкаРеквизиты.Клиент = Клиент Тогда
			
			ТекстОшибки = ТекстОшибки + " Клиент ";
			
		КонецЕсли; 
		
		Если не ВыборкаРеквизиты.Касса = Касса Тогда
			
			ТекстОшибки = ТекстОшибки + " Касса ";
			
		КонецЕсли;
		
	иначе
		
		Возврат Ложь;

	КонецЕсли;  
	
	ТекстОшибкиНоменклатура = "";
	
	Для каждого строкаВозврата из Работы Цикл
		
		СтрПоиска = Новый Структура("Номенклатура",строкаВозврата.Номенклатура);
		ВыборкаНоменклатура.Сбросить();
		Если ВыборкаНоменклатура.НайтиСледующий(СтрПоиска) Тогда
			Если строкаВозврата.Количество > ВыборкаНоменклатура.Количество Тогда 
				ТекстОшибкиНоменклатура = ТекстОшибкиНоменклатура + " "+строкаВозврата.Номенклатура + "";
			КонецЕсли;		
		Иначе
			 ТекстОшибкиНоменклатура = ТекстОшибкиНоменклатура + " "+строкаВозврата.Номенклатура + "";
		КонецЕсли;	
			
	КонецЦикла;	
	
	ТекстОшибкиТерминал = "";

	Если ЗначениеЗаполнено(ЭквайринговыйТерминалНаФорме) и не ВыборкаОплаты.Следующий() Тогда
		
		ТекстОшибкиТерминал = "Отличается терминал в документе основания и в возврате!";
		
	КонецЕсли;
	
	Если не ТекстОшибки = "" или не ТекстОшибкиНоменклатура = "" или не ТекстОшибкиТерминал = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		ТекстИтог = "";
		Если не ТекстОшибки = "" Тогда
			    ТекстИтог = "Отличаются значения " + ТекстОшибки + " в документе основания и в возврате!" + Символы.ПС;	
		КонецЕсли;
	    Если не ТекстОшибкиНоменклатура = "" Тогда
			    ТекстИтог = ТекстИтог + "Превышает количество и/или различаются следующие работы "+ ТекстОшибкиНоменклатура+ " в документе основания и в возврате!" + Символы.ПС;	
		КонецЕсли;
		
		Если не ТекстОшибкиТерминал = "" Тогда
			    ТекстИтог = ТекстИтог + ТекстОшибкиТерминал;	
		КонецЕсли;
        Сообщение.Текст = ТекстИтог;
		Сообщение.Сообщить(); 
		Возврат Ложь;
	КонецЕсли; 
	
	    Возврат Истина;
	
КонецФункции

Функция ПроверитьПервичныйПрием(ОбъектПрием) Экспорт
	
	ВозЗначение = Неопределено;
	КолДней = 0;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОМГ_НастройкиПовторныхПриемов.Клиника КАК Клиника,
	|	ОМГ_НастройкиПовторныхПриемов.Специализация КАК Специализация,
	|	ОМГ_НастройкиПовторныхПриемов.Врач КАК Врач,
	|	ОМГ_НастройкиПовторныхПриемов.КоличествоДней КАК КоличествоДней
	|ИЗ
	|	РегистрСведений.ОМГ_НастройкиПовторныхПриемов КАК ОМГ_НастройкиПовторныхПриемов
	|
	|СГРУППИРОВАТЬ ПО
	|	ОМГ_НастройкиПовторныхПриемов.Специализация,
	|	ОМГ_НастройкиПовторныхПриемов.Врач,
	|	ОМГ_НастройкиПовторныхПриемов.Клиника,
	|	ОМГ_НастройкиПовторныхПриемов.КоличествоДней
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СотрудникиСпециализации.Специализация КАК Специализация
	|ИЗ
	|	Справочник.Сотрудники.Специализации КАК СотрудникиСпециализации
	|ГДЕ
	|	СотрудникиСпециализации.Ссылка = &Сотрудник";   
	
	Запрос.УстановитьПараметр("Сотрудник",ОбъектПрием.Врач);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаНастройки = РезультатЗапроса[0].Выбрать();  
	ВыборкаСпециализации = РезультатЗапроса[1].Выбрать();
	ИтоговаяСтруктура = Неопределено;
	// ищем по врачу 	 
	
	// Врач, специализаци, клиника 
	СтрПоиска = Новый Структура;
	Пока ВыборкаСпециализации.Следующий() Цикл 	
		СтрПоиска.Вставить("Врач",ОбъектПрием.Врач);
		СтрПоиска.Вставить("Клиника",ОбъектПрием.Филиал); 	
		СтрПоиска.Вставить("Специализация",ВыборкаСпециализации.Специализация);  
		ВыборкаНастройки.Сбросить();
		Если ВыборкаНастройки.НайтиСледующий(СтрПоиска) Тогда			
			КолДней = ВыборкаНастройки.КоличествоДней;
			ИтоговаяСтруктура = СтрПоиска;
			Прервать;   		
		КонецЕсли;   
	КонецЦикла;    
	
	Если КолДней = 0 Тогда	
		// Врач, специализаци 
		СтрПоиска.Вставить("Клиника",Справочники.Филиалы.ПустаяСсылка());
		Пока ВыборкаСпециализации.Следующий() Цикл 		
			СтрПоиска.Вставить("Врач",ОбъектПрием.Врач);		
			СтрПоиска.Вставить("Специализация",ВыборкаСпециализации.Специализация);  
			ВыборкаНастройки.Сбросить();
			Если ВыборкаНастройки.НайтиСледующий(СтрПоиска) Тогда	
				КолДней = ВыборкаНастройки.КоличествоДней; 
				ИтоговаяСтруктура = СтрПоиска;
				Прервать;   	
			КонецЕсли;   
		КонецЦикла;  
	КонецЕсли; 
	
	Если КолДней = 0 Тогда
		// Врач		
		СтрПоиска.Вставить("Врач",ОбъектПрием.Врач);

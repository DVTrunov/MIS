
Процедура ЗаполнитьВторичныйПрием(Прием, Заявка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОсновнойШаблонВрача = МедицинскаяДеятельность.ПолучитьОсновнойШаблонОсмотраСотрудника(Прием.Врач, Ложь);
	
	ВерсияШаблона = ВерсионированиеШаблонов.ПолучитьВерсиюШаблона(ОсновнойШаблонВрача, Прием.Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	омг_СвязанныеШаблоны.ПервичныйШаблон КАК ПервичныйШаблон,
	|	омг_СвязанныеШаблоны.ВторичныйШаблон КАК ВторичныйШаблон,
	|	ПриемШаблоныПриема.Ссылка КАК ПервичныйПрием,
	|	ЕСТЬNULL(ПриемШаблоныПриема.Ссылка.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК Дата
	|ИЗ
	|	РегистрСведений.омг_СвязанныеШаблоны КАК омг_СвязанныеШаблоны
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Прием.ШаблоныПриема КАК ПриемШаблоныПриема
	|		ПО (ПриемШаблоныПриема.ШаблонПриема = омг_СвязанныеШаблоны.ПервичныйШаблон)
	|			И (ПриемШаблоныПриема.Ссылка.МедицинскаяКарта = &МедицинскаяКарта)
	|ГДЕ
	|	омг_СвязанныеШаблоны.ПервичныйШаблон = &ПервичныйШаблон
	|	И ЛОЖЬ В
	|			(ВЫБРАТЬ
	|				Заявка.омг_ЭтоПервичныйПрием КАК омг_ЭтоПервичныйПрием
	|			ИЗ
	|				Документ.Заявка КАК Заявка
	|			ГДЕ
	|				Заявка.Ссылка = &Заявка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("ПервичныйШаблон", ОсновнойШаблонВрача);
	Запрос.УстановитьПараметр("МедицинскаяКарта", Прием.МедицинскаяКарта);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Прием.ПервичныйПрием = Выборка.ПервичныйПрием;
		Прием.ШаблоныПриема.Добавить().ШаблонПриема = Выборка.ВторичныйШаблон;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаполнитьМедПерсонал(Объект,Заявка = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина); 
	Если не Заявка = Неопределено Тогда
		Если Заявка.омг_МедПерсонал.Количество() > 0 Тогда 	
			Объект.омг_МедПерсонал.Загрузить(Заявка.омг_МедПерсонал.Выгрузить()); 			
		КонецЕсли;	
	КонецЕсли;
	
	Если Объект.омг_МедПерсонал.Количество() = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	омг_СвязиМедПерсонала.Врач КАК Врач,
		|	омг_СвязиМедПерсонала.Медсестра КАК Медсестра,
		|	омг_СвязиМедПерсонала.омг_РольПерсонала КАК Роль,
		|	омг_СвязиМедПерсонала.Период КАК Период,
		|	омг_СвязиМедПерсонала.Медсестра.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.омг_СвязиМедПерсонала КАК омг_СвязиМедПерсонала
		|ГДЕ
		|	омг_СвязиМедПерсонала.Врач = &Врач
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		Запрос.УстановитьПараметр("Врач", Объект.Врач);
		РезультатЗапроса = Запрос.Выполнить().Выбрать(); 
		
		СтрПоиска = Новый Структура;
		СтрПоиска.Вставить("Роль",Перечисления.омг_РолиПерсонала.Медсестра);
		Если РезультатЗапроса.НайтиСледующий(СтрПоиска) Тогда
			СтрокаМедПерсонала = Объект.омг_МедПерсонал.Добавить();
			СтрокаМедПерсонала.Сотрудник = РезультатЗапроса.Медсестра;
			СтрокаМедПерсонала.Должность = РезультатЗапроса.Должность;
			СтрокаМедПерсонала.Роль = РезультатЗапроса.Роль;	
		КонецЕсли;	
		РезультатЗапроса.Сбросить();
		СтрПоиска = Новый Структура;
		СтрПоиска.Вставить("Роль",Перечисления.омг_РолиПерсонала.Лаборант);
		Если РезультатЗапроса.НайтиСледующий(СтрПоиска) Тогда
			СтрокаМедПерсонала = Объект.омг_МедПерсонал.Добавить();
			СтрокаМедПерсонала.Сотрудник = РезультатЗапроса.Медсестра;
			СтрокаМедПерсонала.Должность = РезультатЗапроса.Должность;
			СтрокаМедПерсонала.Роль = РезультатЗапроса.Роль;	
		КонецЕсли;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры     


Функция ВернутьМедПерсоналПоИсточникам(Заявка,СтрМедПерсонала) Экспорт
	
 
	ТабМедПерсонала = Заявка.омг_МедПерсонал.Выгрузить();
	
	Если Заявка.омг_МедПерсонал.Количество() = 0 Тогда
		ТабМедПерсонала.Очистить();
		Для каждого строкаСтр из СтрМедПерсонала Цикл
			Если ЗначениеЗаполнено(строкаСтр.Значение) Тогда
				Если строкаСтр.Ключ = "омг_МедСестра" Тогда
					Роль = Перечисления.омг_РолиПерсонала.Медсестра; 
				ИначеЕсли строкаСтр.Ключ = "омг_Лаборант" Тогда
					Роль = Перечисления.омг_РолиПерсонала.Лаборант;
				иначе продолжить
				КонецЕсли;
				СтрТабМедПерсонала = ТабМедПерсонала.Добавить();
				СтрТабМедПерсонала.Сотрудник = строкаСтр.Значение;
				СтрТабМедПерсонала.Должность = строкаСтр.Значение.Должность;
				СтрТабМедПерсонала.Роль = Роль;	
			КонецЕсли;
		КонецЦикла;	 	
	КонецЕсли;      
	
	Возврат ТабМедПерсонала;
	
КонецФункции


Функция ПолучитьТекущуюМедсестру(Врач) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_СвязиМедПерсоналаСрезПоследних.Период КАК Период,
	               |	омг_СвязиМедПерсоналаСрезПоследних.Врач КАК Врач,
	               |	омг_СвязиМедПерсоналаСрезПоследних.Медсестра КАК Медсестра
	               |ИЗ
	               |	РегистрСведений.омг_СвязиМедПерсонала.СрезПоследних КАК омг_СвязиМедПерсоналаСрезПоследних
	               |ГДЕ
	               |	омг_СвязиМедПерсоналаСрезПоследних.Врач = &Врач
	               |	И омг_СвязиМедПерсоналаСрезПоследних.омг_РольПерсонала = &Медсестра";
	Запрос.УстановитьПараметр("Врач", Врач); 
	Запрос.УстановитьПараметр("Медсестра", Перечисления.омг_РолиПерсонала.Медсестра);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.Сотрудники.БезМедсестры;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Выборка.Медсестра;
	
КонецФункции    

Функция ПолучитьТекущийМедПерсоналПоВрачу(Врач) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_СвязиМедПерсоналаСрезПоследних.Период КАК Период,
	               |	омг_СвязиМедПерсоналаСрезПоследних.Врач КАК Врач,
	               |	омг_СвязиМедПерсоналаСрезПоследних.Медсестра КАК Медсестра,
	               |	омг_СвязиМедПерсоналаСрезПоследних.омг_РольПерсонала КАК омг_РольПерсонала
	               |ИЗ
	               |	РегистрСведений.омг_СвязиМедПерсонала.СрезПоследних КАК омг_СвязиМедПерсоналаСрезПоследних
	               |ГДЕ
	               |	омг_СвязиМедПерсоналаСрезПоследних.Врач = &Врач";
	Запрос.УстановитьПараметр("Врач", Врач);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено; 
	иначе
		Выборка = РезультатЗапроса.Выбрать();
		Возврат Выборка;
	КонецЕсли;
	
	
КонецФункции


Процедура УстановитьТекущуюМедсестру(Врач, Медсестра, Дата = Неопределено) Экспорт
	
	ТекущаяМедсестра = ПолучитьТекущуюМедсестру(Врач);
	
	Если ТекущаяМедсестра = Медсестра Тогда
		Возврат;
	КонецЕсли;
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Врач = Пользователи.ТекущийПользователь() Тогда
		ПараметрыСеанса.омг_ТекущаяМедсестра = Медсестра;
	КонецЕсли;
	
	Запись = РегистрыСведений.омг_СвязиМедПерсонала.СоздатьМенеджерЗаписи();
	Запись.Врач = Врач;
	Запись.Период = Дата;
	Запись.Медсестра = Медсестра;
	Запись.омг_РольПерсонала = Перечисления.омг_РолиПерсонала.Медсестра;
	Запись.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


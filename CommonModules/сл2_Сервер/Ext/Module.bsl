Функция СведенияСервераЛицензий(СтрокаПодключения = "") Экспорт
	СеансовыеДанные = ПолучитьСеансовыеДанные();
	ПриоритетнаяСтрокаСоединения = Неопределено;
	НастройкиСоединения = Неопределено;
	Если СтрокаПодключения <> "" Тогда
		НастройкиКлиентаЛицензирования = ПолучитьНастройки();
		НастройкиКлиентаЛицензирования.АдресСервераЛицензий = СтрокаПодключения;
		НастройкиСоединения = TClientConnectionSettings(НастройкиКлиентаЛицензирования);
		Результат = lsAPI_Info(НастройкиСоединения, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
	Иначе
		ПриоритетнаяСтрокаСоединения = СеансовыеДанные.ПриоритетнаяСтрокаСоединения;
		Результат = lsAPI_Info(НастройкиСоединения, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
		Если СеансовыеДанные.ПриоритетнаяСтрокаСоединения <> ПриоритетнаяСтрокаСоединения Тогда
			СеансовыеДанные.ПриоритетнаяСтрокаСоединения = ПриоритетнаяСтрокаСоединения;
			УстановитьСеансовыеДанные(СеансовыеДанные);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

	КонецЦикла;
	СеансовыеДанныеСписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("сл2", "");
	Для каждого ИмяНастроек Из СеансовыеДанныеСписокЗначений Цикл
		Если Лев(ИмяНастроек.Значение, 3) = "sd-" Тогда
			Если Не ЗначениеОпределено(МассивАктуальныхСеансовыхДанных.Найти(ИмяНастроек.Значение)) Тогда
				Попытка
					Попытка 	Если сл2_СерверКэшируемый.ЭтоСервернаяБаза() Тогда
							СеансовыеДанные = ПолучитьСеансовыеДанные(ИмяНастроек.Значение);
							Для каждого СостояниеЛицензированияПродукта Из СеансовыеДанные.СостоянияЛицензированияПродуктов Цикл
								ОсвободитьЛицензиюНаСеанс(СостояниеЛицензированияПродукта.productInfo, СостояниеЛицензированияПродукта.lockedSession.poolCId, СостояниеЛицензированияПродукта.lockedSession.sessionId, Ложь, Неопределено, СостояниеЛицензированияПродукта.connectionSettingsSnapshot, СеансовыеДанные.ДанныеАвтономногоРежима);
							КонецЦикла;
						КонецЕсли;
					Исключение
					КонецПопытки;
					ХранилищеОбщихНастроек.Удалить("сл2", ИмяНастроек.Значение, "");
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ОбновитьСтруктуруНастроек(Настройки)
	Если ЗначениеОпределено(Настройки) Тогда
		НастройкиБылиОбновлены = Ложь;
		Если ЗначениеОпределено(Настройки) Тогда
			Если Настройки.structureVersion = 1 Тогда
				СкрытыеУведомления = Новый Структура("СрокДействияПодпискиИстекает, СрокДействияПодпискиИстек", Неопределено, Неопределено);
				Настройки.Вставить("СкрытыеУведомления", СкрытыеУведомления);
				Настройки.structureVersion = 1.01;
				НастройкиБылиОбновлены = Истина;
			КонецЕсли;
			Если Настройки.structureVersion = 1.01 Тогда
				Настройки.Вставить("ПереопределениеИзПараметраЗапуска", Неопределено);
				Настройки.structureVersion = 1.02;
				НастройкиБылиОбновлены = Истина;
			КонецЕсли;
			Если Настройки.structureVersion = 1.02 Тогда
				Если Настройки.Свойство("ПереопределениеИзПараметраЗапуска") Тогда
					Настройки.Удалить("ПереопределениеИзПараметраЗапуска");
				КонецЕсли;
				Настройки.Вставить("НастройкамиУправляетОблачныйХостер", Ложь);
				Настройки.structureVersion = 1.03;
				НастройкиБылиОбновлены = Истина;
			КонецЕсли;
		КонецЕсли;
		Если НастройкиБылиОбновлены Тогда
			Если Настройки.ДляВсехПользователей Тогда
				УстановитьОбщиеНастройки(Настройки);
			Иначе
				УстановитьПерсональныеНастройки(Настройки);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

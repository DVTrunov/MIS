Процедура ПочиститьУстаревшиеСеансовыеДанные()
	СеансыИнформационнойБазы = ПолучитьСеансыИнформационнойБазы();
	НомерТекущегоСеансаИБ = НомерСеансаИнформационнойБазы();
	МассивАктуальныхСеансовыхДанных = Новый Массив;
	Для каждого ЭлементЗн Из СеансыИнформационнойБазы Цикл
		Если ЭлементЗн.ИмяПриложения = "1CV8" Или ЭлементЗн.ИмяПриложения = "1CV8C" Или ЭлементЗн.ИмяПриложения = "WebClient" Тогда
			КлючНастроек = ПолучитьКлючНастроекСеансовыхДанных(ЭлементЗн.НомерСеанса);
			МассивАктуальныхСеансовыхДанных.Добавить(КлючНастроек);

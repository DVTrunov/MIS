Процедура ФоновоеЗаданиеМенеджерСеансов(КлючНастроек) Экспорт
	СохранитьИзменения = Ложь;
	СеансовыеДанные = ПолучитьСеансовыеДанные(КлючНастроек);
	ПриоритетнаяСтрокаСоединения = СеансовыеДанные.ПриоритетнаяСтрокаСоединения;
	Для каждого СостояниеЛицензированияПродукта Из СеансовыеДанные.СостоянияЛицензированияПродуктов Цикл
		Если ЗначениеОпределено(СостояниеЛицензированияПродукта.lockedSession) Тогда
			МассивСеансов = Новый Массив;
			МассивСеансов.Добавить(СостояниеЛицензированияПродукта.lockedSession.sessionId);
			СоответствиеПулМассивСеансов = Новый Соответствие;
			СоответствиеПулМассивСеансов.Вставить(СостояниеЛицензированияПродукта.lockedSession.poolCId, МассивСеансов);
			РезультатВызова = lsAPI_TouchLicenseSessions(СостояниеЛицензированияПродукта.productInfo.productId, СостояниеЛицензированияПродукта.productInfo.productVersion, СостояниеЛицензированияПродукта.productInfo.productKey, СостояниеЛицензированияПродукта.productInfo.productKeyAddon, СоответствиеПулМассивСеансов, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
			Если НетОшибок(РезультатВызова) Тогда
				Если РезультатВызова.data.responseData.invalidSessionIds.Количество() = 1 Тогда
					РезультатВызова = lsAPI_LockLicenseSession(СостояниеЛицензированияПродукта.productInfo.productId, СостояниеЛицензированияПродукта.productInfo.productVersion, СостояниеЛицензированияПродукта.productInfo.productKey, СостояниеЛицензированияПродукта.productInfo.productKeyAddon, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
					Если НетОшибок(РезультатВызова) Тогда
						СостояниеЛицензированияПродукта.error = Неопределено;
						СостояниеЛицензированияПродукта.lockedSession = РезультатВызова.data.responseData;
					Иначе
						СостояниеЛицензированияПродукта.error = РезультатВызова;
						СостояниеЛицензированияПродукта.lockedSession = Неопределено;
						ТребуетсяОткрытьФормуКлиентаЛицензирования = Истина;
					КонецЕсли;
					СохранитьИзменения = Истина;
				КонецЕсли;
			Иначе
				СостояниеЛицензированияПродукта.error = РезультатВызова;
				СостояниеЛицензированияПродукта.lockedSession = Неопределено;
				СохранитьИзменения = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если СеансовыеДанные.ПриоритетнаяСтрокаСоединения <> ПриоритетнаяСтрокаСоединения Тогда
		СеансовыеДанные.ПриоритетнаяСтрокаСоединения = ПриоритетнаяСтрокаСоединения;
		СохранитьИзменения = Истина;
	КонецЕсли;
	Если СохранитьИзменения Тогда
		УстановитьСеансовыеДанные(СеансовыеДанные, КлючНастроек);
	КонецЕсли;
КонецПроцедуры
Процедура ОбработчикОжиданияФайловойБазы() Экспорт

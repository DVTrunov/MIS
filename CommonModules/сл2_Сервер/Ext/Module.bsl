	Попытка
		ИдентификаторФЗ = ХранилищеОбщихНастроек.Загрузить("сл2", "ИдентификаторФЗ");
	Исключение
	КонецПопытки;
	Если ЗначениеОпределено(ИдентификаторФЗ) Тогда
		ФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторФЗ);
		Если ЗначениеОпределено(ФЗ) И ФЗ.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			ФЗ.Отменить();

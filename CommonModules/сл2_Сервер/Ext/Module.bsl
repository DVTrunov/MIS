Функция lsAPI_Выполнить(НастройкиСоединения, ИспользованнаяСтрокаСоединения = Неопределено, ТелоЗапросаДвоичныеДанные = Неопределено, ЗаголовкиЗапроса, КлючШифрования = Неопределено, КлючШифрованияДополнение = "", Ресурс = "/api/v1/gate")
	ОбщийЗамер = НачатьЗамерВремени();
	Результат = СоздатьРезультат();
	НачалоИсполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	OpenSSL = Новый ЗащищенноеСоединениеOpenSSL;
	Если НастройкиСоединения.ProxyИспользуется Тогда
		Если НастройкиСоединения.ProxyНастройкиИзСистемы Тогда
			Прокси = Новый ИнтернетПрокси(Истина);
		Иначе
			Прокси = Новый ИнтернетПрокси(Ложь);
			Прокси.Установить(?(НастройкиСоединения.SSL, "https", "http"), НастройкиСоединения.ProxyСервер, НастройкиСоединения.ProxyПорт, НастройкиСоединения.ProxyЛогин, НастройкиСоединения.ProxyПароль, НастройкиСоединения.ProxyИспользоватьАутентификациюОС);
			Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Не НастройкиСоединения.ProxyИспользоватьДляЛокальныхАдресов;
		КонецЕсли;
	Иначе
		Прокси = Новый ИнтернетПрокси(Ложь);
		Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
	КонецЕсли;
	ИсходящиеЗаголовки = ?(ЗаголовкиЗапроса = Неопределено, Новый Соответствие, ЗаголовкиЗапроса);
	Если ЗначениеОпределено(КлючШифрования) Тогда
		ИсходящиеЗаголовки.Вставить("Content-Encoding-LS", "ls2.v1");
		ИсходящиеЗаголовки.Вставить("Content-Location", КлючШифрованияДополнение);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Ресурс, ИсходящиеЗаголовки);
	Если ЗначениеОпределено(ТелоЗапросаДвоичныеДанные) Тогда
		Если ЗначениеОпределено(КлючШифрования) Тогда
			Попытка
				ТелоЗапросаДвоичныеДанные = napi_Зашифровать(ТелоЗапросаДвоичныеДанные, , КлючШифрования);
			Исключение
				Результат = СоздатьРезультат(1011);
			КонецПопытки;
		КонецЕсли;
		Если НетОшибок(Результат) Тогда
			Запрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапросаДвоичныеДанные);
		КонецЕсли;
	КонецЕсли;
	Если НетОшибок(Результат) Тогда
		Для каждого СтрокаСоединения Из НастройкиСоединения.СтрокиСоединенияСерверовЛицензий Цикл
			Результат = СоздатьРезультат();
			АдресСервера = РазобратьСтрокуСоединения(СтрокаСоединения);
			Соединение = Новый HTTPСоединение(АдресСервера.Сервер, АдресСервера.Порт, НастройкиСоединения.Логин, НастройкиСоединения.Пароль, Прокси, 4, ?(НастройкиСоединения.SSL, OpenSSL, Неопределено), Ложь);
			НачалоИсполненияHttp = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Попытка
				HTTPОтвет = Соединение.ОтправитьДляОбработки(Запрос);
			Исключение
				Результат = СоздатьРезультат(1001, ОписаниеОшибки());
			КонецПопытки;
			Результат.executionTimeHttp = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоИсполненияHttp;
			Если Результат.code <> 1001 Тогда
				ИспользованнаяСтрокаСоединения = СтрокаСоединения;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если НетОшибок(Результат) Тогда
		ЗаголовкиОтвета = Новый Соответствие;
		Для каждого КлючИЗначение Из HTTPОтвет.Заголовки Цикл
			ЗаголовкиОтвета.Вставить(НРег(КлючИЗначение.Ключ), НРег(КлючИЗначение.Значение));
		КонецЦикла;
		ТипКонтентаОтвета = ЗаголовкиОтвета.Получить("content-type");
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Если ЗначениеОпределено(ТипКонтентаОтвета) И Лев(ТипКонтентаОтвета, 16) = "application/json" Тогда
				ТелоОтветаДвоичныеДанные = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
				Если ЗаголовкиОтвета.Получить("content-encoding-ls") = "ls2.v1" Тогда
					Попытка
						ТелоОтветаДвоичныеДанные = napi_Расшифровать(ТелоОтветаДвоичныеДанные, , КлючШифрования);
					Исключение
						Результат = СоздатьРезультат(1012);
					КонецПопытки;
				КонецЕсли;
				Если НетОшибок(Результат) Тогда
					ТелоОтветаКакСтрока = ПолучитьСтрокуИзДвоичныхДанных(ТелоОтветаДвоичныеДанные, КодировкаТекста.UTF8);
					Попытка
						Результат.data = ДесериализоватьДанные(ТелоОтветаКакСтрока);
					Исключение
						Результат = СоздатьРезультат(1002, ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Результат = СоздатьРезультат(1003, "HTTP " + Формат(HTTPОтвет.КодСостояния, "ЧН=0; ЧГ=0"), , Ресурс, , Результат.executionTimeHttp);
			Если ЗначениеОпределено(ТипКонтентаОтвета) И Лев(ТипКонтентаОтвета, 16) = "application/json" Тогда
				Попытка
					ТелоОтветаДвоичныеДанные = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
					Если ЗаголовкиОтвета.Получить("content-encoding-ls") = "ls2.v1" Тогда
						ТелоОтветаДвоичныеДанные = napi_Расшифровать(ТелоОтветаДвоичныеДанные, , КлючШифрования);
					КонецЕсли;
					ТелоОтветаКакСтрока = ПолучитьСтрокуИзДвоичныхДанных(ТелоОтветаДвоичныеДанные, КодировкаТекста.UTF8);
					ОписаниеОшибкиJSON = ДесериализоватьДанные(ТелоОтветаКакСтрока);
					Если ОписаниеОшибкиJSON.Свойство("code") Тогда
						Результат.code = ОписаниеОшибкиJSON.code;
						Результат.description = ПолучитьОписаниеПоКодуРезультата(Результат.code);
					КонецЕсли;
					Если ОписаниеОшибкиJSON.Свойство("description") Тогда
						Результат.description = ОписаниеОшибкиJSON.description;
					КонецЕсли;
					Если ОписаниеОшибкиJSON.Свойство("comment") Тогда
						Результат.comment = ОписаниеОшибкиJSON.comment;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗавершениеИсполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Результат.executionTime = ЗавершениеИсполнения - НачалоИсполнения;
	Возврат Результат;
КонецФункции

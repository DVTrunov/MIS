КонецФункции
Функция Преобразование_Данные_ДвоичныеДанные(Данные) Экспорт
	Результат = Неопределено;
	Если ТипЗнч(Данные) = Тип("Строка") Тогда
		Результат = ПолучитьДвоичныеДанныеИзСтроки(Данные, КодировкаТекста.UTF8, Ложь);
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") Тогда
		СериализованнаяСтруктура = СериализоватьДанные(Данные);
		Результат = ПолучитьДвоичныеДанныеИзСтроки(СериализованнаяСтруктура, КодировкаТекста.UTF8, Ложь);
	ИначеЕсли ТипЗнч(Данные) = Тип("БуферДвоичныхДанных") Тогда
		Результат = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Возврат Данные;
	Иначе
		ВызватьИсключение "Неподдерживаемый тип данных";
	КонецЕсли;
	Возврат Результат;
КонецФункции
Функция TApiResult(КодРезультата, Описание, Комментарий = "", Данные = Неопределено, Ресурс = "", ДлительностьИсполнения = -1, ДлительностьИсполненияВызова = -1) Экспорт

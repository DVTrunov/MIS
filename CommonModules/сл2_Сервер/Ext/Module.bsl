Функция ПолучитьНастройки(ПринудительноПолучитьПерсональные = Ложь, ИмяПользователя = Неопределено) Экспорт
	Если ПринудительноПолучитьПерсональные Тогда
		Результат = ПолучитьПерсональныеНастройки(ИмяПользователя);
	Иначе
		Попытка
			ПерсональныеНастройкиСтруктура = ХранилищеОбщихНастроек.Загрузить("сл2", "ПерсональныеНастройки", , ИмяПользователя);
			ОбщиеНастройкиСтруктура = ХранилищеОбщихНастроек.Загрузить("сл2", "ОбщиеНастройки", , "");
			Если Не ЗначениеОпределено(ПерсональныеНастройкиСтруктура) И Не ЗначениеОпределено(ОбщиеНастройкиСтруктура) Тогда
				ОбщиеНастройкиСтруктура = TClientSettings(Истина);
				УстановитьОбщиеНастройки(ОбщиеНастройкиСтруктура);
				ПерсональныеНастройкиСтруктура = TClientSettings(Ложь);
				УстановитьПерсональныеНастройки(ПерсональныеНастройкиСтруктура);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Результат = ПолучитьОбщиеНастройки();
		Если Не ЗначениеОпределено(Результат) Тогда
			Результат = ПолучитьПерсональныеНастройки(ИмяПользователя);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции
Процедура УстановитьОбщиеНастройки(Знач ОбщиеНастройкиСтруктура) Экспорт
	ХранилищеОбщихНастроек.Сохранить("сл2", "ОбщиеНастройки", ОбщиеНастройкиСтруктура, , "");
КонецПроцедуры
Процедура УстановитьПерсональныеНастройки(Знач ПерсональныеНастройкиСтруктура, ИмяПользователя = Неопределено) Экспорт
	ХранилищеОбщихНастроек.Сохранить("сл2", "ПерсональныеНастройки", ПерсональныеНастройкиСтруктура, , ИмяПользователя);
КонецПроцедуры
Функция ПродлитьВремяЖизниСеансов(МетаданныеПродукта, СоответствиеПулМассивСеансов, ПриоритетнаяСтрокаСоединения = Неопределено, АвтономныеДанные = Неопределено) Экспорт
	Если Не ЗначениеОпределено(ПриоритетнаяСтрокаСоединения) Тогда
		СеансовыеДанные = ПолучитьСеансовыеДанные();
		ПриоритетнаяСтрокаСоединения = СеансовыеДанные.ПриоритетнаяСтрокаСоединения;
	КонецЕсли;
	РезультатВызова = lsAPI_TouchLicenseSessions(МетаданныеПродукта.productId, МетаданныеПродукта.productVersion, МетаданныеПродукта.productKey, МетаданныеПродукта.productKeyAddon, СоответствиеПулМассивСеансов, ПриоритетнаяСтрокаСоединения, АвтономныеДанные);
	Если НетОшибок(РезультатВызова) Тогда
		РезультатВызова.data = РезультатВызова.data.responseData;
	КонецЕсли;
	Возврат РезультатВызова;
КонецФункции
Функция ОсвободитьЛицензиюНаСеанс(МетаданныеПродукта, ИдентификаторПулаЛицензий, ИдентификаторСеанса, ЗавершитьЛицензирование = Ложь, ВходящиеСеансовыеДанные = Неопределено, СнимокНастроекСоединения = Неопределено, АвтономныеДанные = Неопределено) Экспорт
	РезультатВызова = lsAPI_ReleaseLicenseSession(МетаданныеПродукта.productId, МетаданныеПродукта.productVersion, МетаданныеПродукта.productKey, МетаданныеПродукта.productKeyAddon, ИдентификаторПулаЛицензий, ИдентификаторСеанса, СнимокНастроекСоединения, АвтономныеДанные);
	Если ЗавершитьЛицензирование Тогда
		СеансовыеДанные = ВходящиеСеансовыеДанные;
		Если Не ЗначениеОпределено(СеансовыеДанные) Тогда
			СеансовыеДанные = ПолучитьСеансовыеДанные();
			ИндексУдаляемойЗаписи = Неопределено;
			Для итератор = 0 По СеансовыеДанные.СостоянияЛицензированияПродуктов.Количество() - 1 Цикл
				СостояниеЛицензирования = СеансовыеДанные.СостоянияЛицензированияПродуктов[итератор];
				Если СостояниеЛицензирования.productInfo.productId = МетаданныеПродукта.productId И ЗначениеОпределено(СостояниеЛицензирования.lockedSession) И СостояниеЛицензирования.lockedSession.poolCId = ИдентификаторПулаЛицензий И СостояниеЛицензирования.lockedSession.sessionId = ИдентификаторСеанса Тогда
					ИндексУдаляемойЗаписи = итератор;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЗначениеОпределено(ИндексУдаляемойЗаписи) Тогда
				СеансовыеДанные.СостоянияЛицензированияПродуктов.Удалить(ИндексУдаляемойЗаписи);
				Если Не ЗначениеОпределено(ВходящиеСеансовыеДанные) Тогда
					УстановитьСеансовыеДанные(СеансовыеДанные);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если НетОшибок(РезультатВызова) Тогда
		РезультатВызова.data = РезультатВызова.data.responseData;
	КонецЕсли;
	Возврат РезультатВызова;
КонецФункции
Функция ПроверитьДоступностьСервераЛицензий(СтрокаПодключения) Экспорт
	Результат = Неопределено;
	Если СтрокаПодключения = "" Тогда
		Возврат Результат;
	КонецЕсли;
	РезультатПроверкиДоступности = СведенияСервераЛицензий(СтрокаПодключения);
	Если НетОшибок(РезультатПроверкиДоступности) И РезультатПроверкиДоступности.data.Свойство("type") И РезультатПроверкиДоступности.data.type = "TLicenseServerUIInfo" Тогда
		Результат = Новый Структура("Версия,Пинг", РезультатПроверкиДоступности.data.version, РезультатПроверкиДоступности.executionTimeHttp);
	КонецЕсли;
	Возврат Результат;
КонецФункции

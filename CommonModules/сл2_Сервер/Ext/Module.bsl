Функция ПроверитьВерсиюСервераЛицензий(ВерсияСервераЛицензий) Экспорт
	Результат = Истина;
	МинимальнаяВерсияСервераЛицензий = МинимальнаяВерсияСервераЛицензий();
	МассивКомпонентовВерсииСервера = СтрРазделить(ВерсияСервераЛицензий, ".", Истина);
	ПредыдущийРазрядБольше = Ложь;
	Для итератор = 0 По 3 Цикл
		Минимально = МинимальнаяВерсияСервераЛицензий[итератор];
		Получено = Число(МассивКомпонентовВерсииСервера[итератор]);
		Если Минимально > Получено Тогда
			Результат = Ложь;
			Прервать;
		ИначеЕсли Минимально < Получено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
Функция РазобратьСтрокуСоединения(СтрокаПодключения)
	Сервер = "127.0.0.1";
	Порт = 10700;
	ЧастиСтрокиПодключенияМассив = СтрРазделить(СтрокаПодключения, ":", Ложь);
	Если ЧастиСтрокиПодключенияМассив.Количество() > 0 Тогда
		Сервер = СокрЛП(ЧастиСтрокиПодключенияМассив[0]);
	КонецЕсли;
	Если ЧастиСтрокиПодключенияМассив.Количество() > 1 Тогда
		Попытка
			Порт = Число(СокрЛП(ЧастиСтрокиПодключенияМассив[1]));
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("Сервер,Порт", Сервер, Порт);
КонецФункции
Функция ПлатформаНеНиже(В1, В2 = Неопределено, В3 = Неопределено, В4 = Неопределено, ТекущаяВерсияПлатформыМассив = Неопределено)
	Если ЗначениеОпределено(ТекущаяВерсияПлатформыМассив) Тогда
		ТекущаяВерсияПлатформы = ТекущаяВерсияПлатформыМассив;
	Иначе
		ТекущаяВерсияПлатформы = сл2_СерверКэшируемый.ПолучитьВерсиюПлатформы();
	КонецЕсли;
	Если ТекущаяВерсияПлатформы[0] < В1 Тогда
		Возврат Ложь;
	ИначеЕсли ТекущаяВерсияПлатформы[0] > В1 Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЗначениеОпределено(В2) Тогда
		Если ТекущаяВерсияПлатформы[1] < В2 Тогда
			Возврат Ложь;
		ИначеЕсли ТекущаяВерсияПлатформы[1] > В2 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеОпределено(В3) Тогда
		Если ТекущаяВерсияПлатформы[2] < В3 Тогда
			Возврат Ложь;
		ИначеЕсли ТекущаяВерсияПлатформы[2] > В3 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеОпределено(В4) Тогда
		Если ТекущаяВерсияПлатформы[3] < В4 Тогда
			Возврат Ложь;
		ИначеЕсли ТекущаяВерсияПлатформы[3] > В4 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции
Функция ПолучитьОбъектКомпоненты(МестоположениеКомпоненты, Класс = "AddIn.LSCL.CryptoExtension")
	ОписаниеОшибки = "";
	Попытка
		Если ПлатформаНеНиже(8, 3, 21) Тогда
			СтрокаПодключенияБиблиотеки = "ПодключитьВнешнююКомпоненту(""" + МестоположениеКомпоненты + """, ""LSCL"", ТипВнешнейКомпоненты.Native, ТипПодключенияВнешнейКомпоненты.NotIsolated)";
			Результат = Вычислить(СтрокаПодключенияБиблиотеки);
		Иначе
			Результат = ПодключитьВнешнююКомпоненту(МестоположениеКомпоненты, "LSCL", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		Если Результат Тогда
			Возврат Новый(Класс, Неопределено);
		КонецЕсли;
	Исключение
		Результат = Ложь;
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	Если Не Результат Тогда
		ЗарегистрироватьОшибкуВЖурналРегистрации(?(ЗначениеЗаполнено(ОписаниеОшибки), ОписаниеОшибки, "Ошибка подключения библиотеки"), "lscl-native-lib");
	КонецЕсли;
КонецФункции
Функция napi_Зашифровать(Данные, МестоположениеКомпоненты = "ОбщийМакет.сл2", Ключ = Неопределено)
	КлючШифрованияДвоичныеДанные = Неопределено;
	ДобавитьПодпись = Истина;
	Если сл2_СерверКэшируемый.ПлатформаWindowsИлиLinux() Тогда
		Если ЗначениеЗаполнено(Ключ) Тогда
			КлючШифрованияДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Ключ, КодировкаТекста.ANSI, Ложь);
		КонецЕсли;
		ДвоичныеДанные = Преобразование_Данные_ДвоичныеДанные(Данные);
		Шифрование = ПолучитьОбъектКомпоненты(МестоположениеКомпоненты);
		Результат = Шифрование.ЗашифроватьAES128CBC(ДвоичныеДанные, КлючШифрованияДвоичныеДанные, ДобавитьПодпись);
		Возврат Результат;
	Иначе
		ВызватьИсключение "На данный момент не поддерживается файловая база, запущенная через тонкий клиент на операционной системе MacOS.";
	КонецЕсли;
КонецФункции
Функция napi_Расшифровать(Данные, МестоположениеКомпоненты = "ОбщийМакет.сл2", Ключ = Неопределено, ПривестиКСтроке = Ложь)
	КлючШифрованияДвоичныеДанные = Неопределено;
	ПроверятьПодпись = Истина;
	Если сл2_СерверКэшируемый.ПлатформаWindowsИлиLinux() Тогда
		Если ЗначениеЗаполнено(Ключ) Тогда
			КлючШифрованияДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Ключ, КодировкаТекста.ANSI, Ложь);
		КонецЕсли;
		ДвоичныеДанные = Преобразование_Данные_ДвоичныеДанные(Данные);
		Шифрование = ПолучитьОбъектКомпоненты(МестоположениеКомпоненты);
		Результат = Шифрование.РасшифроватьAES128CBC(ДвоичныеДанные, КлючШифрованияДвоичныеДанные, ПроверятьПодпись);
		Если ПривестиКСтроке Тогда
			Результат = ПолучитьСтрокуИзДвоичныхДанных(Результат);
		КонецЕсли;
		Возврат Результат;
	Иначе
		ВызватьИсключение "На данный момент не поддерживается файловая база, запущенная через тонкий клиент на операционной системе MacOS.";
	КонецЕсли;

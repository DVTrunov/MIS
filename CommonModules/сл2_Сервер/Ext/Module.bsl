Функция TClientConnectionSettings(НастройкиКлиентаЛицензирования = Неопределено, ПриоритетнаяСтрокаСоединения = Неопределено)
	Если Не ЗначениеОпределено(НастройкиКлиентаЛицензирования) Тогда
		НастройкиКлиентаЛицензирования = ПолучитьНастройки();
	КонецЕсли;
	ИспользоватьПроксиСервер = НастройкиКлиентаЛицензирования.ИспользоватьПроксиСервер;
	МассивСтрокСоединения = СтрРазделить(НастройкиКлиентаЛицензирования.АдресСервераЛицензий, ";", Ложь);
	СтрокиСоединенияСерверовЛицензий = Новый Массив;
	Если ЗначениеОпределено(ПриоритетнаяСтрокаСоединения) Тогда
		СтрокиСоединенияСерверовЛицензий.Добавить(ПриоритетнаяСтрокаСоединения);
	ИначеЕсли МассивСтрокСоединения.Количество() = 0 Тогда
		СтрокиСоединенияСерверовЛицензий.Добавить("127.0.0.1:10700");
	КонецЕсли;
	Для каждого СтрокаСоединения Из МассивСтрокСоединения Цикл
		СтрокаСоединенияСокрЛП = СокрЛП(СтрокаСоединения);
		Если СтрокаСоединенияСокрЛП <> ПриоритетнаяСтрокаСоединения Тогда
			СтрокиСоединенияСерверовЛицензий.Добавить(СтрокаСоединенияСокрЛП);
		КонецЕсли;
	КонецЦикла;
	Пулы = Новый Массив;
	Если НастройкиКлиентаЛицензирования.ОпределенныйПулЛицензий Тогда
		Пулы = СтрРазделить(НастройкиКлиентаЛицензирования.ПулыЛицензий, ";", Ложь);
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("type", "TClientConnectionSettings");
	Результат.Вставить("structureVersion", 1.01);
	Результат.Вставить("СтрокиСоединенияСерверовЛицензий", СтрокиСоединенияСерверовЛицензий);
	Результат.Вставить("SSL", Ложь);
	Результат.Вставить("Логин", "");
	Результат.Вставить("Пароль", "");
	Результат.Вставить("ПулыЛицензий", Пулы);
	Результат.Вставить("ProxyИспользуется", НастройкиКлиентаЛицензирования.ИспользоватьПроксиСервер);
	Результат.Вставить("ProxyНастройкиИзСистемы", Истина);
	Результат.Вставить("ProxyИспользоватьАутентификациюОС", Ложь);
	Результат.Вставить("ProxyСервер", "");
	Результат.Вставить("ProxyПорт", Неопределено);
	Результат.Вставить("ProxyЛогин", "");
	Результат.Вставить("ProxyПароль", "");
	Результат.Вставить("ProxyИспользоватьДляЛокальныхАдресов", Ложь);
	Возврат Результат;
КонецФункции

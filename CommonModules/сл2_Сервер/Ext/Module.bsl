Функция ОпределитьДоступностьСборкиПоДатеВыпускаИСрокуДействияПодписки(РежимПроверкиПодписки, ДатаСборкиПродуктаISO8601, ДанныеПодписки, ДатаСервераЛицензийISO8601)
	ДатаСборкиПродукта = Преобразование_ISO8601_ДатаВремя(ДатаСборкиПродуктаISO8601);
	ДатаСервераЛицензий = Преобразование_ISO8601_ДатаВремя(ДатаСервераЛицензийISO8601);
	Если ЗначениеОпределено(ДанныеПодписки) Тогда
		ДатаИстеченияПодписки = Неопределено;
		Если ЗначениеОпределено(ДанныеПодписки.expirationDate) Тогда
			ДатаИстеченияПодписки = Преобразование_ISO8601_ДатаВремя(ДанныеПодписки.expirationDate);
		КонецЕсли;
		Если РежимПроверкиПодписки = 1 Тогда
			Возврат Не ЗначениеЗаполнено(ДатаИстеченияПодписки) Или ДатаСборкиПродукта < ДатаИстеченияПодписки;
		ИначеЕсли РежимПроверкиПодписки = 2 Тогда
			Возврат Не ЗначениеЗаполнено(ДатаИстеченияПодписки) Или ДатаСборкиПродукта < ДатаИстеченияПодписки + 2592000;
		Иначе
			Возврат Истина;
		КонецЕсли;
	Иначе
		Если РежимПроверкиПодписки = 1 Или РежимПроверкиПодписки = 2 Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
КонецФункции
Функция ПреобразоватьБуфер(Буфер, ВернутьДвоичныеДанные = Ложь)
	Результат = Неопределено;
	Если ТипЗнч(Буфер) = Тип("ДвоичныеДанные") Тогда
		ЦелевойБуфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Буфер);
	Иначе
		ЦелевойБуфер = Буфер;
	КонецЕсли;
	БуферМаски = Новый БуферДвоичныхДанных(ЦелевойБуфер.Размер);
	Н = 100;
	Для итератор = 0 По ЦелевойБуфер.Размер - 1 Цикл
		БуферМаски.Установить(итератор, Н);
		Н = Н + 1;
		Если Н = 256 Тогда
			Н = 10;
		КонецЕсли;
	КонецЦикла;
	ЦелевойБуфер.ЗаписатьПобитовоеИсключительноеИли(0, БуферМаски, БуферМаски.Размер);
	Если ВернутьДвоичныеДанные Тогда
		Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ЦелевойБуфер);
	КонецЕсли;
КонецФункции

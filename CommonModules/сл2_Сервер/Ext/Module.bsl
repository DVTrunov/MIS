Процедура ПреИнициализация() Экспорт
	КлючНастроек = ПолучитьКлючНастроекСеансовыхДанных();
	ХранилищеОбщихНастроек.Удалить("сл2", КлючНастроек, "");
	ХранилищеОбщихНастроек.Удалить("сл2", "ар", "");
	ПочиститьУстаревшиеСеансовыеДанные();
	КэшАвтономногоРежима = ПроверитьКэшАвтономногоРежима();
	Если КэшАвтономногоРежима.АвтономныйРежимАктивен Тогда
		ХранилищеОбщихНастроек.Сохранить("сл2", "ар", Истина, , "");
		СеансовыеДанные = TClientSessionData();
		СеансовыеДанные.ДанныеАвтономногоРежима = Новый Структура("Продукты, Подписки", КэшАвтономногоРежима.Продукты, КэшАвтономногоРежима.Подписки);
		УстановитьСеансовыеДанные(СеансовыеДанные);
	КонецЕсли;
КонецПроцедуры
Функция Инициализация(ПараметрыИнициализации) Экспорт
	РезультатИнициализации = Истина;
	НастроитьРегламентноеЗадание();
	РегламентноеЗаданиеВПорядке = Не сл2_СерверКэшируемый.ЭтоСервернаяБаза() Или Не РегламентноеЗаданиеОтключено();
	СеансовыеДанные = ПолучитьСеансовыеДанные();
	СеансовыеДанные.ДоступенВыборВерсииПродукта = ПараметрыИнициализации.ДоступенВыборВерсииПродукта;
	Настройки = ПолучитьНастройки();
	Если Настройки.ПолучатьЛицензиюПриЗапуске Тогда
		РезультатИнициализации = ИнициализироватьСостояниеЛицензирования(СеансовыеДанные);
	КонецЕсли;
	УстановитьСеансовыеДанные(СеансовыеДанные);
	Возврат РегламентноеЗаданиеВПорядке И РезультатИнициализации;
КонецФункции
Функция ИнициализироватьСостояниеЛицензирования(СеансовыеДанные)
	Результат = Истина;
	ПриоритетнаяСтрокаСоединения = СеансовыеДанные.ПриоритетнаяСтрокаСоединения;
	РезультатВызова = lsAPI_Info(Неопределено, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
	Если НетОшибок(РезультатВызова) Тогда
		СеансовыеДанные.СерверЛицензийДоступен = Истина;
		МетаданныеСервераЛицензий = TLicenseServerInfo(РезультатВызова.data, СеансовыеДанные.ДанныеАвтономногоРежима);
		ПерсональныеНастройки = ПолучитьПерсональныеНастройки();
		ПерсональныеНастройки.МетаданныеСервераЛицензий = МетаданныеСервераЛицензий;
		УстановитьПерсональныеНастройки(ПерсональныеНастройки);
		ТребуетсяОбязательнаяСинхронизация = МетаданныеСервераЛицензий.info.syncRequired;
		Если ТребуетсяОбязательнаяСинхронизация Или МетаданныеСервераЛицензий.СерверЛицензийДавноНеСинхронизировался Тогда
			Результат = Ложь;
		КонецЕсли;
	Иначе
		СеансовыеДанные.СерверЛицензийДоступен = Ложь;
	КонецЕсли;
	Для каждого СостояниеЛицензированияПродукта Из СеансовыеДанные.СостоянияЛицензированияПродуктов Цикл
		СостояниеЛицензированияПродукта.lockedSession = Неопределено;
		ПодпискаПозволяетПолучитьЛицензию = Истина;
		Если НетОшибок(РезультатВызова) Тогда
			Если ЗначениеЗаполнено(СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionId) Тогда
				РезультатПолученияПодписки = lsAPI_GetSubscriptionDetails(СостояниеЛицензированияПродукта.productInfo.productId, СостояниеЛицензированияПродукта.productInfo.productVersion, СостояниеЛицензированияПродукта.productInfo.productKey, СостояниеЛицензированияПродукта.productInfo.productKeyAddon, СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionId, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
				СостояниеЛицензированияПродукта.subscriptionCheckNotAvailable = Ложь;
				Если НетОшибок(РезультатПолученияПодписки) Тогда
					РезультатПолученияПодписки.data = РезультатПолученияПодписки.data.responseData;
					СостояниеЛицензированияПродукта.subscriptionStatus = РезультатПолученияПодписки.data;
				Иначе
					СостояниеЛицензированияПродукта.subscriptionStatus = Неопределено;
					Если РезультатПолученияПодписки.code = 4513 Тогда
						СостояниеЛицензированияПродукта.subscriptionCheckNotAvailable = Истина;
					КонецЕсли;
				КонецЕсли;
				Если СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionCheckMode <= 2 Или СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionCheckMode = 4 Тогда
					Если ЗначениеОпределено(СостояниеЛицензированияПродукта.subscriptionStatus) Тогда
						НастройкиСкрытияУведомлений = ПолучитьПерсональныеНастройки().СкрытыеУведомления;
						Если Не СостояниеЛицензированияПродукта.subscriptionStatus.active И (Не ЗначениеОпределено(НастройкиСкрытияУведомлений.СрокДействияПодпискиИстек) Или ТекущаяДата() > НастройкиСкрытияУведомлений.СрокДействияПодпискиИстек) Тогда
							Результат = Ложь;
						КонецЕсли;
						Если ЗначениеОпределено(СостояниеЛицензированияПродукта.subscriptionStatus.daysLeft) И СостояниеЛицензированияПродукта.subscriptionStatus.daysLeft <= 7 И (Не ЗначениеОпределено(НастройкиСкрытияУведомлений.СрокДействияПодпискиИстекает) Или ТекущаяДата() > НастройкиСкрытияУведомлений.СрокДействияПодпискиИстекает) Тогда
							Результат = Ложь;
						КонецЕсли;
					Иначе
						Результат = Ложь;
					КонецЕсли;
				КонецЕсли;
				ПодпискаПозволяетПолучитьЛицензию = ОпределитьДоступностьСборкиПоДатеВыпускаИСрокуДействияПодписки(СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionCheckMode, СостояниеЛицензированияПродукта.productInfo.productReleaseDate, СостояниеЛицензированияПродукта.subscriptionStatus, ?(ЗначениеОпределено(СеансовыеДанные.ДанныеАвтономногоРежима), Преобразование_ДатаВремя_ISO8601(ТекущаяДата()), МетаданныеСервераЛицензий.info.serverTime));
			КонецЕсли;
		КонецЕсли;
		Если НетОшибок(РезультатВызова) Тогда
			Если Не ПодпискаПозволяетПолучитьЛицензию Тогда
				РезультатВызова = СоздатьРезультат(1010);
			КонецЕсли;
			Если НетОшибок(РезультатВызова) Тогда
				РезультатВызова = lsAPI_LockLicenseSession(СостояниеЛицензированияПродукта.productInfo.productId, СостояниеЛицензированияПродукта.productInfo.productVersion, СостояниеЛицензированияПродукта.productInfo.productKey, СостояниеЛицензированияПродукта.productInfo.productKeyAddon, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
			КонецЕсли;
		КонецЕсли;
		Если НетОшибок(РезультатВызова) Тогда
			СостояниеЛицензированияПродукта.error = Неопределено;
			СостояниеЛицензированияПродукта.lockedSession = РезультатВызова.data.responseData;
		Иначе
			СостояниеЛицензированияПродукта.error = РезультатВызова;
			СостояниеЛицензированияПродукта.lockedSession = Неопределено;
			Результат = Ложь;
		КонецЕсли;
		СостояниеЛицензированияПродукта.connectionSettingsSnapshot = TClientConnectionSettings(Неопределено, ПриоритетнаяСтрокаСоединения);
		Если РезультатВызова.code <> 1001 Тогда
			РезультатВызова = СоздатьРезультат();
		КонецЕсли;
	КонецЦикла;
	Если СеансовыеДанные.ПриоритетнаяСтрокаСоединения <> ПриоритетнаяСтрокаСоединения Тогда
		СеансовыеДанные.ПриоритетнаяСтрокаСоединения = ПриоритетнаяСтрокаСоединения;
	КонецЕсли;
	Возврат Результат;
КонецФункции
Функция ПолучитьСостояниеЛицензирования() Экспорт
	СеансовыеДанные = ПолучитьСеансовыеДанные();
	ПерсональныеНастройки = ПолучитьПерсональныеНастройки();
	Результат = Новый Структура;
	Результат.Вставить("ДоступенВыборВерсииПродукта", СеансовыеДанные.ДоступенВыборВерсииПродукта);
	Результат.Вставить("МетаданныеСервераЛицензий", ПерсональныеНастройки.МетаданныеСервераЛицензий);
	Результат.Вставить("ПоказыватьСведенияСервераЛицензий", Не ЗначениеОпределено(СеансовыеДанные.ДанныеАвтономногоРежима));
	Результат.Вставить("ЛицензируемыеПродукты", Новый Массив);
	Результат.Вставить("СистемнаяИнформация", "");
	Для каждого СостояниеЛицензированияПродукта Из СеансовыеДанные.СостоянияЛицензированияПродуктов Цикл
		РежимПроверкиПодписки = СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionCheckMode;
		ПродуктИмеетПодписку = ЗначениеЗаполнено(СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionId) И Не СостояниеЛицензированияПродукта.subscriptionCheckNotAvailable И РежимПроверкиПодписки <> 3;
		СводныеДанные = Новый Структура;
		СводныеДанные.Вставить("НаименованиеПродукта", СостояниеЛицензированияПродукта.productInfo.productName);
		СводныеДанные.Вставить("ДатаСборкиПродукта", Преобразование_ISO8601_ДатаВремя(СостояниеЛицензированияПродукта.productInfo.productReleaseDate));
		СводныеДанные.Вставить("Ошибка", СостояниеЛицензированияПродукта.error);
		СводныеДанные.Вставить("ПулЛицензий", Неопределено);
		СводныеДанные.Вставить("ЛицензияПолучена", Ложь);
		СводныеДанные.Вставить("ПродуктИмеетПодписку", ПродуктИмеетПодписку);
		СводныеДанные.Вставить("СвойстваПодписки", Неопределено);
		Если ЗначениеОпределено(СостояниеЛицензированияПродукта.lockedSession) Тогда
			СводныеДанные.ПулЛицензий = СостояниеЛицензированияПродукта.lockedSession.poolCId;
			СводныеДанные.ЛицензияПолучена = Истина;
		КонецЕсли;
		Если ПродуктИмеетПодписку И РежимПроверкиПодписки <> 3 И СеансовыеДанные.СерверЛицензийДоступен Тогда
			СвойстваПодписки = Новый Структура("Отсутствует, СрокДействияИстек, Бессрочная, ОсталосьДней, СкороИстекает, ДатаОкончания", Ложь, Ложь, Ложь, "", Ложь, "");
			СвойстваПодписки.Отсутствует = Не ЗначениеОпределено(СостояниеЛицензированияПродукта.subscriptionStatus);
			Если Не СвойстваПодписки.Отсутствует Тогда
				СвойстваПодписки.СрокДействияИстек = Не СостояниеЛицензированияПродукта.subscriptionStatus.active;
				СвойстваПодписки.Бессрочная = СостояниеЛицензированияПродукта.subscriptionStatus.daysLeft = Неопределено;
				Если Не СвойстваПодписки.Бессрочная Тогда
					СвойстваПодписки.ОсталосьДней = СостояниеЛицензированияПродукта.subscriptionStatus.daysLeft;
					СвойстваПодписки.СкороИстекает = Не СвойстваПодписки.СрокДействияИстек И СостояниеЛицензированияПродукта.subscriptionStatus.daysLeft <= 7;
					Если ЗначениеОпределено(СостояниеЛицензированияПродукта.subscriptionStatus.expirationDate) Тогда
						СвойстваПодписки.ДатаОкончания = Преобразование_ISO8601_ДатаВремя(СостояниеЛицензированияПродукта.subscriptionStatus.expirationDate);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			СводныеДанные.СвойстваПодписки = СвойстваПодписки;
		КонецЕсли;
		Результат.ЛицензируемыеПродукты.Добавить(СводныеДанные);
	КонецЦикла;
	СистемнаяИнформация = Новый Структура;
	СистемнаяИнформация.Вставить("РежимЗапуска", "Режим запуска: " + ?(сл2_СерверКэшируемый.ЭтоСервернаяБаза(), "Клиент-серверный", "Файловый"));
	СистемнаяИнформация.Вставить("ТипПлатформыСервер", ?(сл2_СерверКэшируемый.ЭтоСервернаяБаза(), "Тип платформы (сервер): " + ТипПлатформыНаСервере(), Неопределено));
	СистемнаяИнформация.Вставить("КлиентЛицензирования", "Клиент лицензирования: " + ВерсияКлиентаЛицензирования());
	СистемнаяИнформация.Вставить("СерверЛицензий", Неопределено);
	Если ЗначениеОпределено(Результат.МетаданныеСервераЛицензий) И Результат.МетаданныеСервераЛицензий.Свойство("info") Тогда
		info = Результат.МетаданныеСервераЛицензий.info;
		Если Результат.ПоказыватьСведенияСервераЛицензий Тогда
			Если Не info.Свойство("offlineData") Или Не info.offlineData Тогда
				СистемнаяИнформация.СерверЛицензий = "Сервер лицензий: " + info.version + " " + info.architecture + " " + ?(info.Свойство("debug") И info.debug, "debug ", " ") + "(" + info.platform + ")";
			КонецЕсли;
		Иначе
			СистемнаяИнформация.СерверЛицензий = "Автономный режим";
		КонецЕсли;
	КонецЕсли;
	Результат.СистемнаяИнформация = СистемнаяИнформация;
	Возврат Результат;
КонецФункции
Функция ЕстьПравоИзмененияОбщихНастроек() Экспорт
	Возврат ЗначениеОпределено(Метаданные.Роли.Найти("сл2_Администратор")) И РольДоступна("сл2_Администратор") Или ЗначениеОпределено(Метаданные.Роли.Найти("ПолныеПрава")) И РольДоступна("ПолныеПрава") Или ЗначениеОпределено(Метаданные.Роли.Найти("доп_ПолныеПрава")) И РольДоступна("доп_ПолныеПрава") Или ПользователиИнформационнойБазы.ТекущийПользователь().Имя = "";
КонецФункции
Процедура ОбновитьСостояниеЛицензирования() Экспорт
	СеансовыеДанные = ПолучитьСеансовыеДанные();
	СеансовыеДанные.ПриоритетнаяСтрокаСоединения = Неопределено;
	Для каждого СостояниеЛицензированияПродукта Из СеансовыеДанные.СостоянияЛицензированияПродуктов Цикл
		Если ЗначениеОпределено(СостояниеЛицензированияПродукта.lockedSession) Тогда
			ОсвободитьЛицензиюНаСеанс(СостояниеЛицензированияПродукта.productInfo, СостояниеЛицензированияПродукта.lockedSession.poolCId, СостояниеЛицензированияПродукта.lockedSession.sessionId, Ложь, Неопределено, СостояниеЛицензированияПродукта.connectionSettingsSnapshot, СеансовыеДанные.ДанныеАвтономногоРежима);
		КонецЕсли;
		СостояниеЛицензированияПродукта.error = Неопределено;
		СостояниеЛицензированияПродукта.lockedSession = Неопределено;
		СостояниеЛицензированияПродукта.connectionSettingsSnapshot = Неопределено;
	КонецЦикла;
	ИнициализироватьСостояниеЛицензирования(СеансовыеДанные);
	УстановитьСеансовыеДанные(СеансовыеДанные);
КонецПроцедуры
Функция УстановитьДанныеАвтономногоРежима(Знач ДвоичныеДанныеОтвета) Экспорт
	Попытка
		Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанныеОтвета);
		ПреобразоватьБуфер(Буфер);
		СериализованныйОтвет = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер);
		ДесериализованныйОтвет = ДесериализоватьДанные(СериализованныйОтвет);
	Исключение
		Сообщить("Некорректный файл.");
		Возврат Ложь;
	КонецПопытки;
	Если ДесериализованныйОтвет.type <> "TLicenseClientOfflineDataResponse" Тогда
		Сообщить("Некорректный тип структуры.");
		Возврат Ложь;
	КонецЕсли;
	ХешПривязки = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешПривязки.Добавить(ПолучитьИмяКомпьютера());
	ХешПривязки.Добавить(ПолучитьИмяЦелевойИБ());
	ХешПривязки.Добавить("approved");
	ХешПривязкиСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(ХешПривязки.ХешСумма);
	Если ДесериализованныйОтвет.bindHash <> ХешПривязкиСтрока Тогда
		Сообщить("Файл не подошел для текущего экземпляра информационной базы или компьютера");
		Возврат Ложь;
	КонецЕсли;
	Константы.сл2_Кэш.Установить(Новый ХранилищеЗначения(ДвоичныеДанныеОтвета));
	Возврат Истина;
КонецФункции
Функция ПроверитьКэшАвтономногоРежима(КэшАвтономногоРежимаДвоичныеДанные = Неопределено) Экспорт
	Результат = Новый Структура("АвтономныеДанныеУстановлены,АвтономныйРежимАктивен,Продукты,Подписки", Ложь, Ложь);
	КэшАвтономногоЛицензированияДвоичныеДанные = ?(ЗначениеЗаполнено(КэшАвтономногоРежимаДвоичныеДанные), КэшАвтономногоРежимаДвоичныеДанные, Константы.сл2_Кэш.Получить().Получить());
	Если ЗначениеОпределено(КэшАвтономногоЛицензированияДвоичныеДанные) Тогда
		Результат.АвтономныеДанныеУстановлены = Истина;
		Попытка
			Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(КэшАвтономногоЛицензированияДвоичныеДанные);
			ПреобразоватьБуфер(Буфер);
			СериализованныйОтвет = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер);
			ДесериализованныйОтвет = ДесериализоватьДанные(СериализованныйОтвет);
		Исключение
		КонецПопытки;
		Результат.АвтономныйРежимАктивен = ДесериализованныйОтвет.pcName = ПолучитьИмяКомпьютера() И ДесериализованныйОтвет.dbPath = ПолучитьИмяЦелевойИБ();
		Результат.Продукты = ДесериализованныйОтвет.products;
		Результат.Подписки = ДесериализованныйОтвет.subscriptions;
	КонецЕсли;
	Возврат Результат;
КонецФункции
Функция НетОшибок(СтруктураРезультата) Экспорт
	Возврат СтруктураРезультата.code = 0;
КонецФункции
Функция АвтономноеЛицензирование() Экспорт
	СеансовыеДанные = ПолучитьСеансовыеДанные();
	Возврат ЗначениеОпределено(СеансовыеДанные.ДанныеАвтономногоРежима);
КонецФункции
Функция ОписаниеРезультата(СтруктураРезультата) Экспорт
	Перем ОтчетПоРезультату;
	ОтчетПоРезультату = "Код: " + Формат(СтруктураРезультата.code, "ЧН=0; ЧГ=0") + Символы.ПС + "Описание: " + СтруктураРезультата.description + ?(СтруктураРезультата.comment <> "", Символы.ПС + "Комментарий: " + СтруктураРезультата.comment, "");
	Возврат ОтчетПоРезультату;
КонецФункции
Процедура ЛицензироватьПродукт(Знач МетаданныеПродукта) Экспорт
	СеансовыеДанные = ПолучитьСеансовыеДанные();
	Для каждого СостояниеЛицензированияПродукта Из СеансовыеДанные.СостоянияЛицензированияПродуктов Цикл
		Если СостояниеЛицензированияПродукта.productInfo.productId = МетаданныеПродукта.productId Тогда
			ПродуктУжеЗарегистрирован = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеОпределено(СеансовыеДанные.ДанныеАвтономногоРежима) Тогда
		МетаданныеПродукта.productKey = "";
		МетаданныеПродукта.productKeyAddon = "";
	КонецЕсли;
	СеансовыеДанные.СостоянияЛицензированияПродуктов.Добавить(TClientProductLicenseStatus(МетаданныеПродукта));
	УстановитьСеансовыеДанные(СеансовыеДанные);
КонецПроцедуры
Процедура ПереключитьВерсиюПродукта(МетаданныеТекущегоПродуктаИлиВерсии, Знач МетаданныеНовогоПродуктаИлиВерсии) Экспорт
	Если МетаданныеТекущегоПродуктаИлиВерсии.productId = МетаданныеНовогоПродуктаИлиВерсии.productId Тогда
		Возврат;
	КонецЕсли;
	ИндексСеансовыхДанных = Неопределено;
	ПродуктУжеЗарегистрирован = Ложь;
	СеансовыеДанные = ПолучитьСеансовыеДанные();
	Для итератор = 0 По СеансовыеДанные.СостоянияЛицензированияПродуктов.Количество() - 1 Цикл
		СостояниеЛицензированияПродукта = СеансовыеДанные.СостоянияЛицензированияПродуктов[итератор];
		Если СостояниеЛицензированияПродукта.productInfo.productId = МетаданныеТекущегоПродуктаИлиВерсии.productId Тогда
			ИндексСеансовыхДанных = итератор;
			Если ЗначениеОпределено(СостояниеЛицензированияПродукта.lockedSession) Тогда
				ОсвободитьЛицензиюНаСеанс(СостояниеЛицензированияПродукта.productInfo, СостояниеЛицензированияПродукта.lockedSession.poolCId, СостояниеЛицензированияПродукта.lockedSession.sessionId, Ложь, Неопределено, СостояниеЛицензированияПродукта.connectionSettingsSnapshot, СеансовыеДанные.ДанныеАвтономногоРежима);
			КонецЕсли;
		КонецЕсли;
		Если СостояниеЛицензированияПродукта.productInfo.productId = МетаданныеНовогоПродуктаИлиВерсии.productId Тогда
			ПродуктУжеЗарегистрирован = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ПродуктУжеЗарегистрирован Тогда
		СтатусЛицензированияПродукта = TClientProductLicenseStatus(МетаданныеНовогоПродуктаИлиВерсии);
		Если ЗначениеОпределено(ИндексСеансовыхДанных) Тогда
			СеансовыеДанные.СостоянияЛицензированияПродуктов[ИндексСеансовыхДанных] = СтатусЛицензированияПродукта;
		Иначе
			СеансовыеДанные.СостоянияЛицензированияПродуктов.Добавить(СтатусЛицензированияПродукта);
		КонецЕсли;
	Иначе
		СеансовыеДанные.СостоянияЛицензированияПродуктов.Удалить(ИндексСеансовыхДанных);
	КонецЕсли;
	УстановитьСеансовыеДанные(СеансовыеДанные);
КонецПроцедуры
Функция ПолучитьЛицензиюНаСеанс(МетаданныеПродукта, ВходящиеСеансовыеДанные = Неопределено, ПерсональныеНастройки = Неопределено) Экспорт
	СеансовыеДанные = Неопределено;
	СостояниеЛицензированияПродукта = Неопределено;
	ПодпискаПозволяетПолучитьЛицензию = Истина;
	РезультатВызова = СоздатьРезультат();
	СуществующийСеансАктуален = Ложь;
	МетаданныеСервераЛицензийАктуальны = Ложь;
	Если Не ЗначениеОпределено(ПерсональныеНастройки) Тогда
		ПерсональныеНастройки = ПолучитьПерсональныеНастройки();
	Иначе
		МетаданныеСервераЛицензийАктуальны = Истина;
	КонецЕсли;
	Если ЗначениеОпределено(ВходящиеСеансовыеДанные) Тогда
		СеансовыеДанные = ВходящиеСеансовыеДанные;
	Иначе
		СеансовыеДанные = ПолучитьСеансовыеДанные();
	КонецЕсли;
	ПриоритетнаяСтрокаСоединения = СеансовыеДанные.ПриоритетнаяСтрокаСоединения;
	Для каждого ЛицензируемыйПродукт Из СеансовыеДанные.СостоянияЛицензированияПродуктов Цикл
		Если ЛицензируемыйПродукт.productInfo.productId = МетаданныеПродукта.productId Тогда
			СостояниеЛицензированияПродукта = ЛицензируемыйПродукт;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеОпределено(СостояниеЛицензированияПродукта) Тогда
		Если Не ЗначениеОпределено(СостояниеЛицензированияПродукта) Тогда
			СостояниеЛицензированияПродукта = TClientProductLicenseStatus(МетаданныеПродукта);
			СеансовыеДанные.СостоянияЛицензированияПродуктов.Добавить(СостояниеЛицензированияПродукта);
		КонецЕсли;
	КонецЕсли;
	Если НетОшибок(РезультатВызова) И ЗначениеЗаполнено(СостояниеЛицензированияПродукта.lockedSession) Тогда
		Если ЗначениеОпределено(СостояниеЛицензированияПродукта.lockSessionCacheExpireDateISO8601) И Преобразование_ISO8601_ДатаВремя(СостояниеЛицензированияПродукта.lockSessionCacheExpireDateISO8601) >= ТекущаяДата() Тогда
			Результат = СоздатьРезультат(, , СостояниеЛицензированияПродукта.lockedSession);
			Возврат Результат;
		КонецЕсли;
		СоответствиеПулСеансы = Новый Соответствие;
		ИдентификаторыСеансов = Новый Массив;
		ИдентификаторыСеансов.Добавить(СостояниеЛицензированияПродукта.lockedSession.sessionId);
		СоответствиеПулСеансы.Вставить(СостояниеЛицензированияПродукта.lockedSession.poolCId, ИдентификаторыСеансов);
		РезультатВызова = ПродлитьВремяЖизниСеансов(МетаданныеПродукта, СоответствиеПулСеансы, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
		Если НетОшибок(РезультатВызова) Тогда
			СуществующийСеансАктуален = РезультатВызова.data.invalidSessionIds.Найти(СостояниеЛицензированияПродукта.lockedSession.sessionId) = Неопределено;
			Если СуществующийСеансАктуален Тогда
				СостояниеЛицензированияПродукта.lockSessionCacheExpireDateISO8601 = Преобразование_ДатаВремя_ISO8601(ТекущаяДата() + 8);
				Если Не ЗначениеОпределено(ВходящиеСеансовыеДанные) Тогда
					УстановитьСеансовыеДанные(СеансовыеДанные);
				КонецЕсли;
				Результат = СоздатьРезультат(, , СостояниеЛицензированияПродукта.lockedSession);
				Результат.executionTimeHttp = РезультатВызова.executionTimeHttp;
				Результат.executionTime = РезультатВызова.executionTime;
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеОпределено(ПерсональныеНастройки.МетаданныеСервераЛицензий) Или Не СеансовыеДанные.СерверЛицензийДоступен Тогда
		РезультатВызова = lsAPI_Info(Неопределено, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
		Если НетОшибок(РезультатВызова) Тогда
			СеансовыеДанные.СерверЛицензийДоступен = Истина;
			ПерсональныеНастройки.МетаданныеСервераЛицензий = TLicenseServerInfo(РезультатВызова.data, СеансовыеДанные.ДанныеАвтономногоРежима);
			УстановитьПерсональныеНастройки(ПерсональныеНастройки);
			МетаданныеСервераЛицензийАктуальны = Истина;
		КонецЕсли;
	КонецЕсли;
	Если НетОшибок(РезультатВызова) Тогда
		Если ЗначениеОпределено(СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionId) И (СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionCheckMode = 1 Или СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionCheckMode = 2 Или СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionCheckMode = 4) Тогда
			Если Не ЗначениеОпределено(СостояниеЛицензированияПродукта.subscriptionStatus) Тогда
				РезультатПолученияПодписки = lsAPI_GetSubscriptionDetails(СостояниеЛицензированияПродукта.productInfo.productId, СостояниеЛицензированияПродукта.productInfo.productVersion, СостояниеЛицензированияПродукта.productInfo.productKey, СостояниеЛицензированияПродукта.productInfo.productKeyAddon, СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionId, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
				СостояниеЛицензированияПродукта.subscriptionCheckNotAvailable = Ложь;
				Если НетОшибок(РезультатПолученияПодписки) Тогда
					РезультатПолученияПодписки.data = РезультатПолученияПодписки.data.responseData;
					СостояниеЛицензированияПродукта.subscriptionStatus = РезультатПолученияПодписки.data;
				Иначе
					СостояниеЛицензированияПродукта.subscriptionStatus = Неопределено;
					Если РезультатПолученияПодписки.code = 4513 Тогда
						СостояниеЛицензированияПродукта.subscriptionCheckNotAvailable = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ПодпискаПозволяетПолучитьЛицензию = ОпределитьДоступностьСборкиПоДатеВыпускаИСрокуДействияПодписки(СостояниеЛицензированияПродукта.productInfo.maintenanceSubscriptionCheckMode, СостояниеЛицензированияПродукта.productInfo.productReleaseDate, СостояниеЛицензированияПродукта.subscriptionStatus, ?(ЗначениеОпределено(СеансовыеДанные.ДанныеАвтономногоРежима), Преобразование_ДатаВремя_ISO8601(ТекущаяДата()), ПерсональныеНастройки.МетаданныеСервераЛицензий.info.serverTime));
		КонецЕсли;
	КонецЕсли;
	Если НетОшибок(РезультатВызова) Тогда
		Если Не ПодпискаПозволяетПолучитьЛицензию Тогда
			РезультатВызова = СоздатьРезультат(1010);
		КонецЕсли;
		Если НетОшибок(РезультатВызова) Тогда
			РезультатВызова = lsAPI_LockLicenseSession(МетаданныеПродукта.productId, МетаданныеПродукта.productVersion, МетаданныеПродукта.productKey, МетаданныеПродукта.productKeyAddon, ПриоритетнаяСтрокаСоединения, СеансовыеДанные.ДанныеАвтономногоРежима);
		КонецЕсли;
		Если НетОшибок(РезультатВызова) Тогда
			РезультатВызова.data = РезультатВызова.data.responseData;
		КонецЕсли;
	КонецЕсли;
	Если НетОшибок(РезультатВызова) Тогда
		СостояниеЛицензированияПродукта.error = Неопределено;
		СостояниеЛицензированияПродукта.lockedSession = РезультатВызова.data;
		СостояниеЛицензированияПродукта.lockSessionCacheExpireDateISO8601 = Преобразование_ДатаВремя_ISO8601(ТекущаяДата() + 8);
	Иначе
		СостояниеЛицензированияПродукта.error = РезультатВызова;
		СостояниеЛицензированияПродукта.lockedSession = Неопределено;
		СостояниеЛицензированияПродукта.lockSessionCacheExpireDateISO8601 = Неопределено;
	КонецЕсли;
	СостояниеЛицензированияПродукта.connectionSettingsSnapshot = TClientConnectionSettings(Неопределено, ПриоритетнаяСтрокаСоединения);
	Если СеансовыеДанные.ПриоритетнаяСтрокаСоединения <> ПриоритетнаяСтрокаСоединения Тогда
		СеансовыеДанные.ПриоритетнаяСтрокаСоединения = ПриоритетнаяСтрокаСоединения;
	КонецЕсли;
	Если Не ЗначениеОпределено(ВходящиеСеансовыеДанные) Тогда
		УстановитьСеансовыеДанные(СеансовыеДанные);
	КонецЕсли;
	Возврат РезультатВызова;
КонецФункции

		Возврат offline_Info(АвтономныеДанные);
	КонецЕсли;
	Результат = lsAPI_Выполнить(НастройкиСоединения, ПриоритетнаяСтрокаСоединения, , , , , "/api");
	Возврат Результат;
КонецФункции
Функция offline_LockLicenseSession(АвтономныеДанные, ИдентификаторПродукта, ВерсияПродукта)
	Результат = СоздатьРезультат();
	НайденныйПродукт = Неопределено;
	Для каждого Продукт Из АвтономныеДанные.Продукты Цикл
		Если Продукт.productId = ИдентификаторПродукта Тогда
			НайденныйПродукт = Продукт;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеОпределено(НайденныйПродукт) Тогда
		Результат = СоздатьРезультат(1013);
	КонецЕсли;
	ПараметрСрокДействия = Неопределено;
	ПараметрЧислоСеансов = Неопределено;
	Если НетОшибок(Результат) Тогда
		Для каждого Параметр Из НайденныйПродукт.parameters Цикл
			Если Параметр.parameterId = "eab43d61-10c7-49cd-9aa3-d6150b2b8a24" Тогда
				ПараметрСрокДействия = Параметр;
			ИначеЕсли Параметр.parameterId = "8cf910ef-2d24-4999-8879-0a8f9d204e0b" Тогда
				ПараметрЧислоСеансов = Параметр;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если НетОшибок(Результат) Тогда
		Если ЗначениеОпределено(ПараметрСрокДействия) И ЗначениеОпределено(ПараметрСрокДействия.data.value) Тогда
			СрокДействияАвтономнойЛицензии = Преобразование_ISO8601_ДатаВремя(ПараметрСрокДействия.data.value);
			Если ТекущаяДата() > СрокДействияАвтономнойЛицензии Тогда
				Результат = СоздатьРезультат(1014);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если НетОшибок(Результат) Тогда
		Если ЗначениеОпределено(ПараметрЧислоСеансов) И ЗначениеОпределено(ПараметрЧислоСеансов.data.value) Тогда
			СеансыИб = ПолучитьСеансыИнформационнойБазы();
			ЧислоТекущихСеансов = 0;
			Для каждого Сеанс Из СеансыИб Цикл
				Если Сеанс.ИмяПриложения = "1CV8" Или Сеанс.ИмяПриложения = "1CV8C" Или Сеанс.ИмяПриложения = "WebClient" Тогда
					ЧислоТекущихСеансов = ЧислоТекущихСеансов + 1;
				КонецЕсли;
			КонецЦикла;
			Если ЧислоТекущихСеансов > ПараметрЧислоСеансов.data.value Тогда
				Результат = СоздатьРезультат(1015);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если НетОшибок(Результат) Тогда
		АвтономныеДанныеМетода = Новый Структура("type, structureVersion", "TGateResponse", 1);
		АвтономныеДанныеМетода.Вставить("requestInfo", Новый Структура("methodName, requestId", "lock-license-session", UUID()));
		АвтономныеДанныеМетода.Вставить("responseData", Новый Структура("type, structureVersion, poolCId, sessionId", "TGateRequestLockLicenseSessionResult", 1, "00000", UUID()));
		Результат.data = АвтономныеДанныеМетода;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПолучитьОписаниеПоКодуРезультата(КодРезультата) Экспорт
	Описание = НСтр("ru = 'Описание не найдено';");
	Если КодРезультата = 0 Тогда
		Описание = НСтр("ru = 'Нет ошибок.';");
	ИначеЕсли КодРезультата = 1000 Тогда
		Описание = НСтр("ru = '';");
	ИначеЕсли КодРезультата = 1001 Тогда
		Описание = НСтр("ru = 'Не удалось установить соединение с сервером лицензий.';");
	ИначеЕсли КодРезультата = 1002 Тогда
		Описание = НСтр("ru = 'При разборе JSON строки возникла ошибка.';");
	ИначеЕсли КодРезультата = 1003 Тогда
		Описание = НСтр("ru = 'При обращении к серверу получен неожиданный HTTP код результата.';");
	ИначеЕсли КодРезультата = 1005 Тогда
		Описание = НСтр("ru = 'Возникла ошибка при формировании JSON объекта.';");
	ИначеЕсли КодРезультата = 1006 Тогда
		Описание = НСтр("ru = 'Передан не поддерживаемый вид HTTP запроса.';");
	ИначеЕсли КодРезультата = 1008 Тогда
		Описание = НСтр("ru = 'Ожидался другой JSON объект.';");
	ИначеЕсли КодРезультата = 1009 Тогда
		Описание = НСтр("ru = 'Не удалось подготовить пакет для отправки.';");
	ИначеЕсли КодРезультата = 1010 Тогда
		Описание = НСтр("ru = 'Получение лицензии на текущую версию продукта требует наличия подписки на технологическое сопровождение.';");
	ИначеЕсли КодРезультата = 1011 Тогда
		Описание = НСтр("ru = 'Не удалось подготовить данные для отправки в сервер лицензий';");
	ИначеЕсли КодРезультата = 1012 Тогда
		Описание = НСтр("ru = 'Не удалось обработать данные, полученные от сервера лицензий.';");
	ИначеЕсли КодРезультата = 1013 Тогда
		Описание = НСтр("ru = 'Данные лицензии по запрошенному продукту отсутствуют в данных автономной лицензии.';");
	ИначеЕсли КодРезультата = 1014 Тогда
		Описание = НСтр("ru = 'Срок действия автономной лицензии истек.';");
	ИначеЕсли КодРезультата = 1015 Тогда
		Описание = НСтр("ru = 'Достигнут предел по числу сеансов, доступных в автономной лицензии.';");
	ИначеЕсли КодРезультата = 1016 Тогда
		Описание = НСтр("ru = 'Запрошенный параметр отсутствует в автономной лицензии.';");
	ИначеЕсли КодРезультата = 1017 Тогда
		Описание = НСтр("ru = 'Запрошенная подписка отсутствует в автономной лицензии.';");
	ИначеЕсли КодРезультата = 1018 Тогда
		Описание = НСтр("ru = 'Используемая версия firstBit.Сервера лицензий не поддерживается, необходимо обновить сервер лицензий.';");
	КонецЕсли;
	Возврат Описание;

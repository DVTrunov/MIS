Функция ДополнитьЗаявками(ДокОснование)	Экспорт
    ТекстВозврата = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.НомерЗаявки КАК НомерЗаявки,
		|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.ПарольЗаявки КАК ПарольЗаявки
		|ИЗ
		|	Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС
		|ГДЕ
		|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
		
	ТекстВозврата = ТекстВозврата + "Номер заявки: " +ВыборкаДетальныеЗаписи.НомерЗаявки + Символы.ПС;	
	ТекстВозврата = ТекстВозврата + "Пароль: " +ВыборкаДетальныеЗаписи.ПарольЗаявки.Получить() + Символы.ПС;	
	КонецЦикла;	
	
	Возврат ТекстВозврата;

	
	

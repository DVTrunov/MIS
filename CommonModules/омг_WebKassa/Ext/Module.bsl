Функция ВернутьДанныеПервичногоЧека(Ссылка, ТолькоПроверка = Ложь) Экспорт

	УстановитьПривилегированныйРежим(Истина);	
	                
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ФискальныеОперацииРК.ДатаВремяЧека КАК ДатаВремяЧека,
		|	ФискальныеОперацииРК.НомерЧека КАК НомерЧека,
		|	ФискальныеОперацииРК.ОбщаяСуммаЧека КАК ОбщаяСуммаЧека,
		|	ФискальныеОперацииРК.АвтономныйРежимРаботыКассы КАК АвтономныйРежимРаботыКассы,
		|	ФискальныеОперацииРК.РегистрационныйНомерКассы КАК РегистрационныйНомерКассы
		|ИЗ
		|	РегистрСведений.ФискальныеОперацииРК КАК ФискальныеОперацииРК
		|ГДЕ
		|	ФискальныеОперацииРК.ДокументОснование = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		УстановитьПривилегированныйРежим(Ложь);
		Если ТолькоПроверка Тогда
        Возврат Истина
		иначе
		Возврат ВыборкаДетальныеЗаписи;
		КонецЕсли;
	иначе 
		
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Неопределено;
		
	КонецЕсли;
	

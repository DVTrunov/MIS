 Функция ДанныеФизЛицаТекущегоПользователя(Организация, ДатаСреза = Неопределено, ФИОКратко = Истина) Экспорт
	 ФизическоеЛицо      = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователи.ТекущийПользователь(), "ФизическоеЛицо");
	 ДатаПолученияДанных = ?(ЗначениеЗаполнено(ДатаСреза), ДатаСреза, ОбщегоНазначения.ТекущаяДатаПользователя());
	 
	 СтруктураВозврата  = Новый Структура("Представление, Должность");
	 
	 Если ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		 УстановитьПривилегированныйРежим(Истина);
		 ДанныеФизЛица = ДанныеФизЛица(Организация, ФизическоеЛицо, ДатаПолученияДанных);
		 УстановитьПривилегированныйРежим(Ложь);
		 
		 ЗаполнитьЗначенияСвойств(СтруктураВозврата, ДанныеФизЛица);
	 КонецЕсли;
	 
	 Возврат СтруктураВозврата;
 КонецФункции
 
 
 
 Функция ПолучитьВерсиюФФД(Знач ВерсияФН, Знач ВерсияККТ) Экспорт
	 ВерсияККТ = ДополнитьНомерВерсииФФД(ВерсияККТ);
	 ВерсияФН  = ДополнитьНомерВерсииФФД(ВерсияФН);
	 
	 // Определеляем максимальную версию ФФД поддерживаемую ФН
	 ВерсияФН = ?(СравнитьВерсии(ВерсияФН, "1.0.5.0") > 0, ВерсияФН, "1.0.5.0");
	 
	 // Итоговая версия определяется минимальной из версий поддерживаемых ФН и ККТ
	 ВерсияФормата = ?(СравнитьВерсии(ВерсияФН, ВерсияККТ) > 0, ВерсияККТ, ВерсияФН);
	 
	 Возврат ВерсияФормата;
 КонецФункции
 
 
 Функция СравнитьВерсии(Знач СтрокаВерсии1, Знач СтрокаВерсии2) Экспорт
	 
	 Строка1 = ?(ПустаяСтрока(СтрокаВерсии1), "0.0.0.0", СтрокаВерсии1);
	 Строка2 = ?(ПустаяСтрока(СтрокаВерсии2), "0.0.0.0", СтрокаВерсии2);
	 Версия1 = СтрРазделить(Строка1, ".");
	 Если Версия1.Количество() <> 4 Тогда
		 ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		 НСтр("ru = 'Неправильный формат параметра %1: %2'"), "СтрокаВерсии1", СтрокаВерсии1);
	 КонецЕсли;
	 Версия2 = СтрРазделить(Строка2, ".");
	 Если Версия2.Количество() <> 4 Тогда
		 ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		 НСтр("ru = 'Неправильный формат параметра %1: %2'"), "СтрокаВерсии2", СтрокаВерсии2);
	 КонецЕсли;
	 
	 Результат = 0;
	 Для Разряд = 0 По 3 Цикл
		 Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		 Если Результат <> 0 Тогда
			 Возврат Результат;
		 КонецЕсли;
	 КонецЦикла;
	 Возврат Результат;
	 
 КонецФункции     
 
 Функция ДополнитьНомерВерсииФФД(НомерВерсии) Экспорт
	 Если НЕ ЗначениеЗаполнено(НомерВерсии) Тогда
		 Возврат "1.0.0.0";
	 КонецЕсли;
	 
	 НомерВерсииВМассив = СтрРазделить(НомерВерсии, ".");
	 
	 Для НомерРазряда = НомерВерсииВМассив.Количество() По 3 Цикл
		 НомерВерсииВМассив.Добавить("0");
	 КонецЦикла;
	 
	 Возврат СтрСоединить(НомерВерсииВМассив, ".");
 КонецФункции    
 
 Процедура ДополнитьСведенияЧека(ДокументОснование,СтрВозврата) Экспорт	
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ЕСТЬNULL(ОказаниеУслуг.Филиал, """") КАК Филиал,
	 |	ЕСТЬNULL(ОказаниеУслуг.Клиент, """") КАК Клиент,
	 |	ЕСТЬNULL(ОказаниеУслуг.Клиент.ИНН, """") КАК КлиентИНН,
	 |	ЕСТЬNULL(ОказаниеУслуг.Клиент.ДатаРождения, """") КАК КлиентДатаРождения,
	 |	ЕСТЬNULL(ОказаниеУслуг.омг_ИспользуемыйТерминал, """") КАК омг_ИспользуемыйТерминал,
	 |	ОказаниеУслуг.ВидОперации КАК ВидОперации
	 |ИЗ
	 |	Документ.ОказаниеУслуг КАК ОказаниеУслуг
	 |ГДЕ
	 |	ОказаниеУслуг.Ссылка = &Ссылка
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	КонтактнаяИнформация.Представление КАК Представление
	 |ИЗ
	 |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	 |ГДЕ
	 |	КонтактнаяИнформация.Вид.Наименование = &ФактическийАдрес
	 |	И КонтактнаяИнформация.Объект = &Филиал
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	КонтактнаяИнформация.Представление КАК Представление
	 |ИЗ
	 |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	 |ГДЕ
	 |	КонтактнаяИнформация.Вид.Наименование = &РабочийТелефон
	 |	И КонтактнаяИнформация.Объект = &Филиал
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	КонтактнаяИнформация.Представление КАК Представление
	 |ИЗ
	 |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	 |ГДЕ
	 |	КонтактнаяИнформация.Вид.Наименование = &Инстаграм
	 |	И КонтактнаяИнформация.Объект = &Организация
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ЛицензииМедицинскойДеятельностиСрезПоследних.Период КАК ДатаВыдачиЛицензии,
	 |	ЛицензииМедицинскойДеятельностиСрезПоследних.НомерЛицензии КАК НомерЛицензии
	 |ИЗ
	 |	РегистрСведений.ЛицензииМедицинскойДеятельности.СрезПоследних(&Период, Филиал.Ссылка = &Организация) КАК ЛицензииМедицинскойДеятельностиСрезПоследних";
	 
	 Запрос.УстановитьПараметр("РабочийТелефон", "Рабочий телефон");
	 Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	 Запрос.УстановитьПараметр("ФактическийАдрес", "Фактический адрес");
	 Запрос.УстановитьПараметр("Филиал", ДокументОснование.Филиал);
	 Запрос.УстановитьПараметр("Инстаграм", "Инстаграм");
	 Запрос.УстановитьПараметр("Организация", ДокументОснование.Организация);
	 Запрос.УстановитьПараметр("Период", ДокументОснование.Дата);
	 
	 
	 РезультатЗапроса = Запрос.ВыполнитьПакет();
	 
	 ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать(); 
	 ВыборкаАдрес = РезультатЗапроса[1].Выбрать();
	 ВыборкаТелефон = РезультатЗапроса[2].Выбрать();
	 ВыборкаИнстаграм = РезультатЗапроса[3].Выбрать(); 
	 ВыборкаЛицензии = РезультатЗапроса[4].Выбрать();
	 
	 Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		 СтрВозврата.Вставить("Филиал",ВыборкаДетальныеЗаписи.Филиал);
		 СтрВозврата.Вставить("Клиент",ВыборкаДетальныеЗаписи.Клиент);
		 СтрВозврата.Вставить("КлиентИНН",ВыборкаДетальныеЗаписи.КлиентИНН);
		 СтрВозврата.Вставить("КлиентДатаРождения",ВыборкаДетальныеЗаписи.КлиентДатаРождения); 
		 СтрВозврата.Вставить("омг_ИспользуемыйТерминал",ВыборкаДетальныеЗаписи.омг_ИспользуемыйТерминал);
		 СтрВозврата.Вставить("ВидОперации",ВыборкаДетальныеЗаписи.ВидОперации);
		 
	 Иначе
		 СтрВозврата.Вставить("Филиал","");
		 СтрВозврата.Вставить("Клиент","");
		 СтрВозврата.Вставить("КлиентИНН","");
		 СтрВозврата.Вставить("КлиентДатаРождения","");
		 СтрВозврата.Вставить("омг_ИспользуемыйТерминал","");
		 СтрВозврата.Вставить("ВидОперации","");
		 
	 КонецЕсли;
	 
	 Если ВыборкаАдрес.Следующий() Тогда
		 СтрВозврата.Вставить("ФактическийАдрес",ВыборкаАдрес.Представление);	
	 Иначе
		 СтрВозврата.Вставить("ФактическийАдрес","")
	 КонецЕсли;    
	 
	 Если ВыборкаТелефон.Следующий() Тогда
		 СтрВозврата.Вставить("РабочийТелефон",ВыборкаТелефон.Представление);	
	 Иначе
		 СтрВозврата.Вставить("РабочийТелефон","")
	 КонецЕсли;  
	 
	 Если ВыборкаИнстаграм.Следующий() Тогда
		 СтрВозврата.Вставить("Инстаграм",ВыборкаИнстаграм.Представление);	
	 Иначе
		 СтрВозврата.Вставить("Инстаграм","")
	 КонецЕсли;
	 
	 Если ВыборкаЛицензии.Следующий() Тогда
		 
		 СтрВозврата.Вставить("ДатаВыдачиЛицензии",ВыборкаЛицензии.ДатаВыдачиЛицензии);
		 СтрВозврата.Вставить("НомерЛицензии",ВыборкаЛицензии.НомерЛицензии);
	 иначе
		 СтрВозврата.Вставить("ДатаВыдачиЛицензии","");
		 СтрВозврата.Вставить("НомерЛицензии","");
		 		 
	 КонецЕсли;
	 СтрВозврата.Вставить("НомерДокумента",ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументОснование.Номер)); 
	 
 КонецПроцедуры	     
 
  Функция ДополнитьСведенияВовзврата(ДокументОснование) Экспорт	
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ФискальныеОперацииРК.НомерЧека КАК ФП,
	 |	ФискальныеОперацииРК.ДатаВремяЧека КАК ДатамВремя,
	 |	ФискальныеОперацииРК.ОбщаяСуммаЧека КАК ОбщаяСумма,
	 |	ФискальныеОперацииРК.РегистрационныйНомерКассы КАК РНК,
	 |	ФискальныеОперацииРК.АвтономныйРежимРаботыКассы КАК ПризнакАвтономности
	 |ИЗ
	 |	РегистрСведений.ФискальныеОперацииРК КАК ФискальныеОперацииРК
	 |ГДЕ
	 |	ФискальныеОперацииРК.ДокументОснование = &ДокументОснование";
	 
	 Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование.ДокументОснование);
	 
	 РезультатЗапроса = Запрос.Выполнить();
	 
	 ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 
	 
	 СтрВозврата = Новый Структура; 
	 
	 Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		 
		 СтрВозврата.Вставить("ФП",ВыборкаДетальныеЗаписи.ФП);
		 СтрВозврата.Вставить("ДатамВремя",ВыборкаДетальныеЗаписи.ДатамВремя);
		 СтрВозврата.Вставить("ОбщаяСумма",ВыборкаДетальныеЗаписи.ОбщаяСумма);
		 СтрВозврата.Вставить("РНК",ВыборкаДетальныеЗаписи.РНК); 
		 СтрВозврата.Вставить("ПризнакАвтономности",ВыборкаДетальныеЗаписи.ПризнакАвтономности);
		 
	 КонецЕсли;
	 
	 Возврат СтрВозврата;
	 
 КонецФункции	


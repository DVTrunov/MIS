Функция ПолучитьТекстЗапросаПлатежногоДокумента(Ссылка)
	Текст = "";
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОказаниеУслуг") Тогда
		
	Текст = 
		"ВЫБРАТЬ
		|	ОказаниеУслуг.СуммаДокумента КАК СуммаДокумента,
		|	ОказаниеУслуг.ПолученоНаличными КАК ПолученоНаличными
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.Ссылка = &Ссылка";	
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") Тогда
		
	Текст = 
		"ВЫБРАТЬ
		|	ОплатаПлатежнойКартой.СуммаДокумента КАК СуммаДокумента,
		|	0 КАК ПолученоНаличными
		|ИЗ
		|	Документ.ОплатаПлатежнойКартой КАК ОплатаПлатежнойКартой
		|ГДЕ
		|	ОплатаПлатежнойКартой.Ссылка = &Ссылка";	

	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ВозвратПоПлатежнойКарте") Тогда
		
	Текст = 
		"ВЫБРАТЬ
		|	ВозвратПоПлатежнойКарте.СуммаДокумента КАК СуммаДокумента,
		|	0 КАК ПолученоНаличными
		|ИЗ
		|	Документ.ВозвратПоПлатежнойКарте КАК ВозвратПоПлатежнойКарте
		|ГДЕ
		|	ВозвратПоПлатежнойКарте.Ссылка = &Ссылка";
	
	
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		
	Текст = 
		"ВЫБРАТЬ
		|	ПриходныйКассовыйОрдер.СуммаДокумента КАК СуммаДокумента,
		|	ПриходныйКассовыйОрдер.СуммаДокумента КАК ПолученоНаличными
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
		|ГДЕ
		|	ПриходныйКассовыйОрдер.Ссылка = &Ссылка";
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		
	Текст = 
		"ВЫБРАТЬ
		|	РасходныйКассовыйОрдер.СуммаДокумента КАК СуммаДокумента,
		|	РасходныйКассовыйОрдер.СуммаДокумента КАК ПолученоНаличными
		|ИЗ
		|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
		|ГДЕ
		|	РасходныйКассовыйОрдер.Ссылка = &Ссылка";

	
	КонецЕсли;	
	
 	Возврат Текст;	
	
	
КонецФункции	

Процедура ДополнитьСведенияЧекаОПК(ДокументОснование,СтрВозврата) Экспорт
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ЕСТЬNULL(ОплатаПлатежнойКартой.Филиал, """") КАК Филиал,
	 |	ЕСТЬNULL(ОплатаПлатежнойКартой.Клиент, """") КАК Клиент,
	 |	ЕСТЬNULL(ОплатаПлатежнойКартой.Клиент.ИНН, """") КАК КлиентИНН,
	 |	ЕСТЬNULL(ОплатаПлатежнойКартой.Клиент.ДатаРождения, """") КАК КлиентДатаРождения,
	 |	ЕСТЬNULL(ОплатаПлатежнойКартой.омг_ИспользуемыйТерминал, """") КАК омг_ИспользуемыйТерминал,
	 |	""Продажа"" КАК ВидОперации
	 |ИЗ
	 |	Документ.ОплатаПлатежнойКартой КАК ОплатаПлатежнойКартой
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	КонтактнаяИнформация.Представление КАК Представление
	 |ИЗ
	 |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	 |ГДЕ
	 |	КонтактнаяИнформация.Вид.Наименование = &ФактическийАдрес
	 |	И КонтактнаяИнформация.Объект = &Филиал
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	КонтактнаяИнформация.Представление КАК Представление
	 |ИЗ
	 |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	 |ГДЕ
	 |	КонтактнаяИнформация.Вид.Наименование = &РабочийТелефон
	 |	И КонтактнаяИнформация.Объект = &Филиал
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	КонтактнаяИнформация.Представление КАК Представление
	 |ИЗ
	 |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	 |ГДЕ
	 |	КонтактнаяИнформация.Вид.Наименование = &Инстаграм
	 |	И КонтактнаяИнформация.Объект = &Организация";
	 
	 Запрос.УстановитьПараметр("РабочийТелефон", "Рабочий телефон");
	 Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	 Запрос.УстановитьПараметр("ФактическийАдрес", "Фактический адрес");
	 Запрос.УстановитьПараметр("Филиал", ДокументОснование.Филиал);
	 Запрос.УстановитьПараметр("Инстаграм", "Инстаграм");
	 Запрос.УстановитьПараметр("Организация", ДокументОснование.Организация);
	 
	 
	 РезультатЗапроса = Запрос.ВыполнитьПакет();
	 
	 ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать(); 
	 ВыборкаАдрес = РезультатЗапроса[1].Выбрать();
	 ВыборкаТелефон = РезультатЗапроса[2].Выбрать();
	 ВыборкаИнстаграм = РезультатЗапроса[3].Выбрать();
	 
	 Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		 СтрВозврата.Вставить("Филиал",ВыборкаДетальныеЗаписи.Филиал);
		 СтрВозврата.Вставить("Клиент",ВыборкаДетальныеЗаписи.Клиент);
		 СтрВозврата.Вставить("КлиентИНН",ВыборкаДетальныеЗаписи.КлиентИНН);
		 СтрВозврата.Вставить("КлиентДатаРождения",ВыборкаДетальныеЗаписи.КлиентДатаРождения); 
		 СтрВозврата.Вставить("омг_ИспользуемыйТерминал",ВыборкаДетальныеЗаписи.омг_ИспользуемыйТерминал);
		 СтрВозврата.Вставить("ВидОперации",ВыборкаДетальныеЗаписи.ВидОперации);
		 
	 Иначе
		 СтрВозврата.Вставить("Филиал","");
		 СтрВозврата.Вставить("Клиент","");
		 СтрВозврата.Вставить("КлиентИНН","");
		 СтрВозврата.Вставить("КлиентДатаРождения","");
		 СтрВозврата.Вставить("омг_ИспользуемыйТерминал","");
		 СтрВозврата.Вставить("ВидОперации","");
		 
	 КонецЕсли;
	 
	 Если ВыборкаАдрес.Следующий() Тогда
		 СтрВозврата.Вставить("ФактическийАдрес",ВыборкаАдрес.Представление);	
	 Иначе
		 СтрВозврата.Вставить("ФактическийАдрес","")
	 КонецЕсли;    
	 
	 Если ВыборкаТелефон.Следующий() Тогда
		 СтрВозврата.Вставить("РабочийТелефон",ВыборкаТелефон.Представление);	
	 Иначе
		 СтрВозврата.Вставить("РабочийТелефон","")
	 КонецЕсли;  
	 
	 Если ВыборкаИнстаграм.Следующий() Тогда
		 СтрВозврата.Вставить("Инстаграм",ВыборкаИнстаграм.Представление);	
	 Иначе
		 СтрВозврата.Вставить("Инстаграм","")
	 КонецЕсли;
	 
	 СтрВозврата.Вставить("НомерДокумента",ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументОснование.Номер)); 
	 
 КонецПроцедуры	
 

 Функция ПолучитьПарольИзТекПользователя() Экспорт
	 УстановитьПривилегированныйРежим(Истина);
	 РезультатВозврата = Неопределено;
	 ПользовательТек = ПараметрыСеанса.ТекущийПользователь ;
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	Пользователи.Омг_ВебКассаПользователь КАК Пользователь,
	 |	Пользователи.Омг_ВебКассаПароль КАК ПарольПользователя
	 |ИЗ
	 |	Справочник.Пользователи КАК Пользователи
	 |ГДЕ
	 |	Пользователи.Ссылка = &Пользователь";
	 
	 Запрос.УстановитьПараметр("Пользователь", ПользовательТек);
	 
	 РезультатЗапроса = Запрос.Выполнить();
	 
	 ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	 
	 Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		 Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Пользователь) и 
			 ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПарольПользователя) Тогда 	
			 
			 РезультатВозврата = Новый Структура;	
			 РезультатВозврата.Вставить("Пользователь",       ВыборкаДетальныеЗаписи.Пользователь);
			 РезультатВозврата.Вставить("ПарольПользователя", ВыборкаДетальныеЗаписи.ПарольПользователя);		
			 РезультатВозврата.Вставить("ЗапомнитьПароль", Ложь);
		 КонецЕсли;
	 КонецЕсли;
	 УстановитьПривилегированныйРежим(Ложь);
	 Возврат РезультатВозврата;
	 
 КонецФункции
 
 Функция НайтиДокументПоЧеку(НомерЧека) Экспорт         
	 
	 	ДокументРеализации = Неопределено;  
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОказаниеУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.НомерЧекаККМ = &НомерЧекаККМ";
		
		Запрос.УстановитьПараметр("НомерЧекаККМ", НомерЧека);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ДокументРеализации = ВыборкаДетальныеЗаписи.Ссылка			
		КонецЕсли;	
		
		Возврат ДокументРеализации;
		
КонецФункции

Процедура ЗаписатьДанныеОперацииПоЧеку(ДокументОснование,Данные,ПодключаемоеОборудование,СообщениеОтОборудования, ТекстЧека = "") Экспорт
		
	УстановитьПривилегированныйРежим(Истина);
	
	ДатаВремяПечати = ТекущаяДата();
	УИДОперации = Новый УникальныйИдентификатор();
	
	ЗаписьЧека = РегистрыСведений.ИсторияПечатиОнлайнЧеков.СоздатьМенеджерЗаписи();	
	ЗаписьЧека.Документ = ДокументОснование;
	ЗаписьЧека.УИД		= УИДОперации;
	ЗаписьЧека.Прочитать();
	
	Если НЕ ЗаписьЧека.Выбран() Тогда
		ЗаписьЧека.Документ 				= ДокументОснование;
		ЗаписьЧека.УИД						= УИДОперации;
		ЗаписьЧека.СообщениеОтОборудования	= СообщениеОтОборудования;
		ЗаписьЧека.Дата						= ДатаВремяПечати;
		Если не ТекстЧека = "" Тогда  
			ЗаписьЧека.ДанныеXML				= ТекстЧека;	
		иначе
			ЗаписьЧека.ДанныеXML				= Данные;
		КонецЕсли;
		ЗаписьЧека.ПодключаемоеОборудование	= ПодключаемоеОборудование;
		ЗаписьЧека.Пользователь				= ПараметрыСеанса.ТекущийПользователь;
		СторноОперация = Ложь;
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") Тогда
		СторноОперация = Ложь;
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВозвратПоПлатежнойКарте") Тогда 
		СторноОперация = Истина; 
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда 
		СторноОперация = Ложь; 
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда 
		СторноОперация = Истина; 
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОказаниеУслуг") Тогда
		СторноОперация 			= ДокументОснование.ВидОперации = Перечисления.ВидыОперацийОказанияУслуг.ВозвратКлиенту;
		КонецЕсли;
		ЗаписьЧека.СторноОперация           = СторноОперация;
		ЗаписьЧека.Результат				= Истина;		
		ЗаписьЧека.Записать(Истина);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Функция ПолучитьНомерЧекаККМОказанияУслуг(ДокСсылка) Экспорт    
	
	НомерЧека = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОказаниеУслуг.НомерЧекаККМ КАК НомерЧекаККМ
		|ИЗ
		|	Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|ГДЕ
		|	ОказаниеУслуг.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	

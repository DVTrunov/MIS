Функция омг_ПолучитьIPАдресТерминала(ЭТ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭквайринговыеТерминалы.омг_АдресТерминала КАК АдресТерминала,
	               |	ЭквайринговыеТерминалы.омг_ПортТерминала КАК ПортТерминала,
	               |	ЭквайринговыеТерминалы.омг_ИспользуемыйТерминал КАК ИспользуемыйТерминал,
	               |	ЭквайринговыеТерминалы.омг_ИнтеграцияОплатаНаТерминал КАК ИнтеграцияОплатаНаТерминал,
	               |	ЭквайринговыеТерминалыОборудование.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	               |ИЗ
	               |	Справочник.ЭквайринговыеТерминалы КАК ЭквайринговыеТерминалы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭквайринговыеТерминалы.Оборудование КАК ЭквайринговыеТерминалыОборудование
	               |		ПО (ЭквайринговыеТерминалыОборудование.Ссылка = ЭквайринговыеТерминалы.Ссылка)
	               |			И (ЭквайринговыеТерминалыОборудование.ПодключаемоеОборудование.ТипОборудования = &ТипОборудования
	               |				И ЭквайринговыеТерминалыОборудование.ПодключаемоеОборудование.УстройствоИспользуется)
	               |ГДЕ
	               |	ЭквайринговыеТерминалы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЭТ);
	Запрос.УстановитьПараметр("ТипОборудования", Перечисления.ТипыПодключаемогоОборудования.ЭквайринговыйТерминал);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	СтруктураТерминала = Новый Структура("АдресТерминала, ПортТерминала, 
							|ИспользуемыйТерминал, ИнтеграцияОплатаНаТерминал, ПодключаемоеОборудование");
	ЗаполнитьЗначенияСвойств(СтруктураТерминала, Выборка);
	
	Возврат СтруктураТерминала;
	

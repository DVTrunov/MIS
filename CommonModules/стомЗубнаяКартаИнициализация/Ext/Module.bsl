
#Область ИнициализацияПриЗапускеПрограммы

Процедура УстановкаПараметровСеанса() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	КешЗК = Новый Структура;
	КешЗК.Вставить("Состояния", ИнициализироватьКешСостоянийОбластей());
	КешЗК.Вставить("Варианты", ИнициализироватьКешВариантовЗубов());
	КешЗК.Вставить("Диагнозы", ИнициализироватьКешДиагнозов());
	КешЗК.Вставить("ПриложениеHTML", ПолучитьHTMLПриложенияJS());
	
	ПараметрыСеанса.стомКешированныеДанныеЗК = Новый ФиксированнаяСтруктура(КешЗК);
	
	ШаблоныЗубныхКарт = Новый Соответствие;
	
	Если УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("КэшироватьДанныеЗубныхКартВПриёмах") Тогда
		Выб = Справочники.стомВидыЗубныхКарт.Выбрать();
		Пока Выб.Следующий() Цикл
			Если Не Выб.ПометкаУдаления Тогда
				ШаблоныЗубныхКарт.Вставить(Выб.Ссылка, ПоместитьВоВременноеХранилище(СформироватьШаблонЗубнойКарты(Выб.Ссылка, Ложь), Новый УникальныйИдентификатор));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	КешЗК.Вставить("ШаблоныЗубныхКарт", Новый ФиксированноеСоответствие(ШаблоныЗубныхКарт));
	
	ПараметрыСеанса.стомКешированныеДанныеЗК = Новый ФиксированнаяСтруктура(КешЗК);
	
КонецПроцедуры

Функция ИнициализироватьКешСостоянийОбластей() 
	
	СтруктураКеша = Новый Структура("Состояния, СостоянияПоИд, МаскиОбластей",
		Новый Массив, Новый Соответствие, Новый Соответствие);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомОбластиСегментовСписокСостояний.Ссылка КАК Область,
	|	стомОбластиСегментовСписокСостояний.Состояние КАК Состояние
	|ИЗ
	|	Справочник.стомОбластиСегментов.СписокСостояний КАК стомОбластиСегментовСписокСостояний
	|ГДЕ
	|	стомОбластиСегментовСписокСостояний.Состояние <> ЗНАЧЕНИЕ(Справочник.стомСостоянияЗубов.ПустаяСсылка)
	|	И НЕ стомОбластиСегментовСписокСостояний.Состояние.ПометкаУдаления
	|	И НЕ стомОбластиСегментовСписокСостояний.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	стомОбластиСегментовСписокСостояний.Состояние.Предопределенный УБЫВ
	|ИТОГИ ПО
	|	Состояние";
	Результат = Запрос.Выполнить();
	
	ВыборкаСостояния = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КоличествоСостояний = ВыборкаСостояния.Количество();
	
	Маски = Новый Соответствие;
	
	СчСост = 0;
	Пока ВыборкаСостояния.Следующий() Цикл
		
		ИдСостояния = ВыборкаСостояния.Состояние.УникальныйИдентификатор();
		СтруктураСостояние = СоздатьСостояниеМаски(ВыборкаСостояния.Состояние, СчСост);
		СтруктураКеша.Состояния.Добавить(СтруктураСостояние);
		СтруктураКеша.СостоянияПоИд.Вставить(ИдСостояния, СтруктураСостояние);
		
		ВыборкаОбласти = ВыборкаСостояния.Выбрать();
		
		Пока ВыборкаОбласти.Следующий() Цикл
			
			МаскаОбласти = Маски.Получить(ВыборкаОбласти.Область);
			Если МаскаОбласти = Неопределено Тогда
				МаскаОбласти = ПобитовыеОперацииКлиентСервер.СоздатьИнициализироватьМассив(КоличествоСостояний, Ложь);
				Маски.Вставить(ВыборкаОбласти.Область, МаскаОбласти);
			КонецЕсли;
			
			МаскаОбласти[СчСост] = Истина;
			
		КонецЦикла;
		
		СчСост = СчСост + 1;
		
	КонецЦикла;
	
	Для Каждого кзМаска Из Маски Цикл
		СтруктураКеша.МаскиОбластей.Вставить(кзМаска.Ключ, Новый ФиксированныйМассив(кзМаска.Значение));
	КонецЦикла;
	
	СтруктураКеша.Вставить("Состояния", Новый ФиксированныйМассив(СтруктураКеша.Состояния));
	СтруктураКеша.Вставить("СостоянияПоИд", Новый ФиксированноеСоответствие(СтруктураКеша.СостоянияПоИд));
	СтруктураКеша.Вставить("МаскиОбластей", Новый ФиксированноеСоответствие(СтруктураКеша.МаскиОбластей));
	
	Возврат Новый ФиксированнаяСтруктура(СтруктураКеша);
	
КонецФункции

Функция ИнициализироватьКешВариантовЗубов()
	
	СтруктураКеша = Новый Структура("Варианты, ВариантыПоИд, МаскиВариантов",
		Новый Массив, Новый Соответствие, Новый Соответствие);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомЗубыКарты.Ссылка КАК ЗубВКарте,
	|	стомВидыЗубовСписокВариантов.ВариантЗуба КАК ВариантЗуба
	|ИЗ
	|	Справочник.стомЗубыКарты КАК стомЗубыКарты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.стомВидыЗубов.СписокВариантов КАК стомВидыЗубовСписокВариантов
	|		ПО стомЗубыКарты.Зуб = стомВидыЗубовСписокВариантов.Ссылка
	|ГДЕ
	|	стомВидыЗубовСписокВариантов.ВариантЗуба <> ЗНАЧЕНИЕ(Справочник.стомВариантыЗубов.ПустаяСсылка)
	|	И НЕ стомЗубыКарты.ПометкаУдаления
	|	И НЕ стомВидыЗубовСписокВариантов.ВариантЗуба.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	стомВидыЗубовСписокВариантов.ВариантЗуба.Основной УБЫВ,
	|	стомВидыЗубовСписокВариантов.ВариантЗуба.Конструкция УБЫВ
	|ИТОГИ ПО
	|	ВариантЗуба";
	Результат = Запрос.Выполнить();
	
	ВыборкаВарианты = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КоличествоВариантов = ВыборкаВарианты.Количество();
	
	Маски = Новый Соответствие;
	
	СчВар = 0;
	Пока ВыборкаВарианты.Следующий() Цикл
		
		ИдВарианта = ВыборкаВарианты.ВариантЗуба.УникальныйИдентификатор();
		СтруктураВариант = СоздатьВариантМаски(ВыборкаВарианты.ВариантЗуба, СчВар);
		СтруктураКеша.Варианты.Добавить(СтруктураВариант);
		СтруктураКеша.ВариантыПоИд.Вставить(ИдВарианта, СтруктураВариант);
		
		ВыборкаЗубы = ВыборкаВарианты.Выбрать();
		
		Пока ВыборкаЗубы.Следующий() Цикл
			
			МаскаЗуба = Маски.Получить(ВыборкаЗубы.ЗубВКарте);
			Если МаскаЗуба = Неопределено Тогда
				МаскаЗуба = ПобитовыеОперацииКлиентСервер.СоздатьИнициализироватьМассив(КоличествоВариантов, Ложь);
				Маски.Вставить(ВыборкаЗубы.ЗубВКарте, МаскаЗуба);
			КонецЕсли;
			
			МаскаЗуба[СчВар] = Истина;
			
		КонецЦикла;
		
		СчВар = СчВар + 1;
		
	КонецЦикла;
	
	Для Каждого кзМаска Из Маски Цикл
		СтруктураКеша.МаскиВариантов.Вставить(кзМаска.Ключ, Новый ФиксированныйМассив(кзМаска.Значение));
	КонецЦикла;
	
	СтруктураКеша.Вставить("Варианты", Новый ФиксированныйМассив(СтруктураКеша.Варианты));
	СтруктураКеша.Вставить("ВариантыПоИд", Новый ФиксированноеСоответствие(СтруктураКеша.ВариантыПоИд));
	СтруктураКеша.Вставить("МаскиВариантов", Новый ФиксированноеСоответствие(СтруктураКеша.МаскиВариантов));
	
	Возврат Новый ФиксированнаяСтруктура(СтруктураКеша);
	
КонецФункции

Функция ИнициализироватьКешДиагнозов()
	
	СтруктураКеша = Новый Структура("Диагнозы, ДиагнозыПоИд, МаскиСостояний",
		Новый Массив, Новый Соответствие, Новый Соответствие);
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("стомГруппаДиагнозов", УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("СтоматологическиеДиагнозы"));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Диагнозы.Ссылка КАК Диагноз
	//|	Диагнозы.КодДиагноза КАК КодДиагноза
	|ПОМЕСТИТЬ стомДиагнозы
	|ИЗ
	|	Справочник.Диагнозы КАК Диагнозы
	|ГДЕ
	|	НЕ Диагнозы.ЭтоГруппа
	|	И НЕ Диагнозы.ПометкаУдаления
	|	И &стомГруппаДиагнозов <> ЗНАЧЕНИЕ(Справочник.Диагнозы.ПустаяСсылка)
	|	И Диагнозы.Ссылка В ИЕРАРХИИ(&стомГруппаДиагнозов)
	|	И НЕ Диагнозы.Архив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стомДиагнозы.Диагноз КАК Диагноз,
	//|	стомДиагнозы.КодДиагноза КАК КодДиагноза,
	|	стомСвязьСостоянийИДиагнозов.СостояниеЗуба КАК СостояниеЗуба,
	|	НЕ стомСвязьСостоянийИДиагнозов.СостояниеЗуба ЕСТЬ NULL КАК ЕстьСостояния
	|ИЗ
	|	стомДиагнозы КАК стомДиагнозы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стомСвязьСостоянийИДиагнозов КАК стомСвязьСостоянийИДиагнозов
	|		ПО стомДиагнозы.Диагноз = стомСвязьСостоянийИДиагнозов.Диагноз
	|ИТОГИ
	|	МАКСИМУМ(ЕстьСостояния)
	|ПО
	|	Диагноз";
	Результат = Запрос.Выполнить();
	
	ВыборкаДиагнозы = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КоличествоДиагнозов = ВыборкаДиагнозы.Количество();
	
	Маски = Новый Соответствие;
	
	СчДиагнозов = 0;
	Пока ВыборкаДиагнозы.Следующий() Цикл
		
		ИдДиагноза = ВыборкаДиагнозы.Диагноз.УникальныйИдентификатор();
		СтруктураДиагноз = СоздатьДиагнозМаски(ВыборкаДиагнозы.Диагноз, СчДиагнозов);
		СтруктураКеша.Диагнозы.Добавить(СтруктураДиагноз);
		СтруктураКеша.ДиагнозыПоИд.Вставить(ИдДиагноза, СтруктураДиагноз);
		
		ВыборкаСостояния = ВыборкаДиагнозы.Выбрать();
		
		Если ВыборкаДиагнозы.ЕстьСостояния Тогда 
			
			Пока ВыборкаСостояния.Следующий() Цикл
				
				МаскаСостояния = Маски.Получить(ВыборкаСостояния.СостояниеЗуба);
				Если МаскаСостояния = Неопределено Тогда
					МаскаСостояния = ПобитовыеОперацииКлиентСервер.СоздатьИнициализироватьМассив(КоличествоДиагнозов, Ложь);
					Маски.Вставить(ВыборкаСостояния.СостояниеЗуба, МаскаСостояния);
				КонецЕсли;
				
				МаскаСостояния[СчДиагнозов] = Истина;
				
			КонецЦикла;
			
		КонецЕсли;
		
		СчДиагнозов = СчДиагнозов + 1;
		
	КонецЦикла;
	
	Для Каждого кзМаска Из Маски Цикл
		СтруктураКеша.МаскиСостояний.Вставить(кзМаска.Ключ, Новый ФиксированныйМассив(кзМаска.Значение));
	КонецЦикла;
	
	СтруктураКеша.Вставить("Диагнозы", Новый ФиксированныйМассив(СтруктураКеша.Диагнозы));
	СтруктураКеша.Вставить("ДиагнозыПоИд", Новый ФиксированноеСоответствие(СтруктураКеша.ДиагнозыПоИд));
	СтруктураКеша.Вставить("МаскиСостояний", Новый ФиксированноеСоответствие(СтруктураКеша.МаскиСостояний));
	
	Возврат Новый ФиксированнаяСтруктура(СтруктураКеша);
	
КонецФункции

Функция ПолучитьHTMLПриложенияJS() Экспорт
	
	СтраницаHTML = Справочники.стомВидыЗубныхКарт.ПолучитьМакет("ЗубнаяКартаJS");
	KonvaJS = Справочники.стомВидыЗубныхКарт.ПолучитьМакет("KonvaJS");
	
	Возврат СтрЗаменить(СтраницаHTML.ПолучитьТекст(), "<<ИмяФайлаKonvaJS>>", ОбщегоНазначенияКлиентСерверПереопределяемый.ПрочитатьТекстДвоичныхДанных(KonvaJS));
	
КонецФункции

#КонецОбласти

#Область ИнициализацияПриЗагрузкеЗК

Функция ИнициализироватьЗубнуюКарту(ЗубнаяКарта, Клиент, УникальныйИдентификатор,
	Дата = Неопределено, ВариантКарты = Неопределено, Документ = Неопределено, ДанныеЗКИстории = Неопределено) Экспорт
	
	Если ДанныеЗКИстории <> Неопределено Тогда
		Если ДанныеЗКИстории.АдресЗК <> Неопределено Тогда
			СтруктураЗК = стомЗубнаяКартаМетоды.ПолучитьСтруктуруЗК(ДанныеЗКИстории.АдресЗК);
			ОчиститьСостоянияВариантыЗубов(СтруктураЗК);
		Иначе
			ШаблонЗК = СформироватьШаблонЗубнойКарты(ЗубнаяКарта, Ложь);
			ДанныеЗКИстории.АдресЗК = ПоместитьВоВременноеХранилище(ШаблонЗК, УникальныйИдентификатор);
		КонецЕсли;
		ЗаполнитьШаблонЗубнойКарты(ДанныеЗКИстории.АдресЗК, Клиент, Дата, ВариантКарты, Документ, ДанныеЗКИстории.АдресСостояний, УникальныйИдентификатор);
		Возврат ДанныеЗКИстории.АдресЗК;
	КонецЕсли;
	
	ШаблонЗК = СформироватьШаблонЗубнойКарты(ЗубнаяКарта);
	АдресЗК = ПоместитьВоВременноеХранилище(ШаблонЗК, УникальныйИдентификатор);
	ЗаполнитьШаблонЗубнойКарты(АдресЗК, Клиент, Дата, ВариантКарты, Документ);
	
	Возврат АдресЗК;
	
КонецФункции

Функция СформироватьШаблонЗубнойКарты(ЗубнаяКарта, ИспользоватьКешШаблонов = Истина)
	
	Если ИспользоватьКешШаблонов Тогда
		ШаблонИзКеша = ПараметрыСеанса.стомКешированныеДанныеЗК.ШаблоныЗубныхКарт.Получить(ЗубнаяКарта);
		Если ШаблонИзКеша <> Неопределено Тогда
			СтруктураЗК = ПолучитьИзВременногоХранилища(ШаблонИзКеша);
			ОчиститьСостоянияВариантыЗубов(СтруктураЗК);
			Возврат СтруктураЗК;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураЗК = СоздатьЗубнуюКарту(ЗубнаяКарта, , , , , , УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ИспользоватьCtrlДляЕдиничногоВыбораЗуба"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомЗубыКарты.Владелец КАК ЗубнаяКарта,
	|	стомЗубыКарты.Ссылка КАК ЗубВКарте,
	|	стомЗубыКарты.Зуб КАК Зуб
	|ПОМЕСТИТЬ ЗубыКарты
	|ИЗ
	|	Справочник.стомЗубыКарты КАК стомЗубыКарты
	|ГДЕ
	|	стомЗубыКарты.Владелец = &ЗубнаяКарта
	|	И НЕ стомЗубыКарты.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗубыКарты.ЗубнаяКарта КАК ЗубнаяКарта,
	|	ЗубыКарты.ЗубВКарте КАК ЗубВКарте,
	|	ЗубыКарты.Зуб КАК Зуб,
	|	стомВидыЗубовСписокВариантов.ВариантЗуба КАК ВариантЗуба,
	|	стомВариантыЗубовСписокОбластей.Область КАК Область,
	|	ВЫБОР
	|		КОГДА стомВидыЗубовСписокВариантов.Обозначение = """"
	|			ТОГДА ЗубыКарты.ЗубВКарте.Наименование
	|		ИНАЧЕ стомВидыЗубовСписокВариантов.Обозначение
	|	КОНЕЦ КАК Нумерация
	|ПОМЕСТИТЬ ЗубыВариантыОбласти
	|ИЗ
	|	ЗубыКарты КАК ЗубыКарты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.стомВидыЗубов.СписокВариантов КАК стомВидыЗубовСписокВариантов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.стомВариантыЗубов.СписокОбластей КАК стомВариантыЗубовСписокОбластей
	|			ПО стомВидыЗубовСписокВариантов.ВариантЗуба = стомВариантыЗубовСписокОбластей.Ссылка
	|		ПО ЗубыКарты.Зуб = стомВидыЗубовСписокВариантов.Ссылка

	|	ВариантыОбластиКонструкции.ЗубВКарте,
	|	ВариантыОбластиКонструкции.Зуб,
	|	ВариантыОбластиКонструкции.ВариантЗуба,
	|	ВариантыОбластиКонструкции.Область,
	|	ВариантыОбластиКонструкции.СерединаКонструкции,
	|	""Середина"",
	|	стомСегментыЗубов.Ссылка,
	|	стомСегментыЗубов.Сегмент
	|ИЗ
	|	ВариантыОбластиКонструкции КАК ВариантыОбластиКонструкции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.стомСегментыЗубов КАК стомСегментыЗубов
	|		ПО ВариантыОбластиКонструкции.СерединаКонструкции = стомСегментыЗубов.Сегмент.Область
	|			И (ВариантыОбластиКонструкции.ЗубнаяКарта = стомСегментыЗубов.Владелец
	|				ИЛИ ВариантыОбластиКонструкции.Зуб = стомСегментыЗубов.Владелец)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВариантыОбластиКонструкции.ЗубнаяКарта,
	|	ВариантыОбластиКонструкции.ЗубВКарте,
	|	ВариантыОбластиКонструкции.Зуб,
	|	ВариантыОбластиКонструкции.ВариантЗуба,
	|	ВариантыОбластиКонструкции.Область,
	|	ВариантыОбластиКонструкции.КонецКонструкции,
	|	""Конец"",
	|	стомСегментыЗубов.Ссылка,
	|	стомСегментыЗубов.Сегмент
	|ИЗ
	|	ВариантыОбластиКонструкции КАК ВариантыОбластиКонструкции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.стомСегментыЗубов КАК стомСегментыЗубов
	|		ПО ВариантыОбластиКонструкции.КонецКонструкции = стомСегментыЗубов.Сегмент.Область
	|			И (ВариантыОбластиКонструкции.ЗубнаяКарта = стомСегментыЗубов.Владелец
	|				ИЛИ ВариантыОбластиКонструкции.Зуб = стомСегментыЗубов.Владелец)
	|ИТОГИ ПО
	|	ЗубВКарте,
	|	ВариантЗуба,
	|	Область,
	|	РасположениеЧасти,
	|	ЧастьКонструкции";
	Запрос.УстановитьПараметр("ЗубнаяКарта", ЗубнаяКарта);
	Результат = Запрос.ВыполнитьПакет();
	
	соотвСозданныеСегменты = Новый Соответствие;
	
	// Обычные варианты зубов
	ВыборкаЗубы = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЗубы.Следующий() Цикл
		
		СтруктураЗуб = СоздатьЗуб(СтруктураЗК, ВыборкаЗубы.ЗубВКарте);
		
		ВыборкаВарианты = ВыборкаЗубы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВарианты.Следующий() Цикл 
			
			СтруктураВариант = СоздатьВариант(СтруктураЗуб, ВыборкаВарианты.ВариантЗуба, ВыборкаВарианты.Нумерация);
			
			ВыборкаОбласти = ВыборкаВарианты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаОбласти.Следующий() Цикл
				
				СтруктураОбласть = СоздатьОбласть(СтруктураВариант, ВыборкаОбласти.Область);
				
				ВыборкаСегменты = ВыборкаОбласти.Выбрать();
				Пока ВыборкаСегменты.Следующий() Цикл 
					
					СтруктураСегмент = СоздатьСегмент(СтруктураОбласть, ВыборкаСегменты.СегментВЗубе, соотвСозданныеСегменты);
					
				КонецЦикла; // Сегменты
				
			КонецЦикла; // Области
			
		КонецЦикла; // Варианты
		
	КонецЦикла; // Зубы
	
	// Конструкции
	ВыборкаЗубы = Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЗубы.Следующий() Цикл
		
		СтруктураЗуб = стомЗубнаяКартаМетоды.НайтиЗубВКарте(СтруктураЗК, ВыборкаЗубы.ЗубВКарте);
		
		Если СтруктураЗуб = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ВыборкаВарианты = ВыборкаЗубы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВарианты.Следующий() Цикл 
			
			СтруктураВариант = СоздатьВариант(СтруктураЗуб, ВыборкаВарианты.ВариантЗуба);
			
			ВыборкаОбласти = ВыборкаВарианты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаОбласти.Следующий() Цикл
				
				СтруктураКонструкция = СоздатьОбласть(СтруктураВариант, ВыборкаОбласти.Область);
				
				ВыборкаРасположение = ВыборкаОбласти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаРасположение.Следующий() Цикл
					ВыборкаЧасти = ВыборкаРасположение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаЧасти.Следующий() Цикл
						
						СтруктураЧастьКонструкции = СоздатьОбласть(СтруктураВариант, ВыборкаЧасти.ЧастьКонструкции);
						СтруктураКонструкция.Вставить(ВыборкаРасположение.РасположениеЧасти, СтруктураЧастьКонструкции);
						
						ВыборкаСегменты = ВыборкаЧасти.Выбрать();
						Пока ВыборкаСегменты.Следующий() Цикл 
							
							СтруктураСегмент = СоздатьСегмент(СтруктураЧастьКонструкции, ВыборкаСегменты.СегментВЗубе, соотвСозданныеСегменты);
							
						КонецЦикла; // Сегменты
						
					КонецЦикла; // Расположение и части
					
				КонецЦикла; // Расположение и части
				
			КонецЦикла; // Конструкция
			
		КонецЦикла; // Варианты
		
	КонецЦикла; // Зубы
	
	СтруктураЗК.ВыделенныеЗубыСегменты = Новый Массив;
	
	Возврат СтруктураЗК;
	
КонецФункции

Процедура ОчиститьСостоянияВариантыЗубов(СтруктураЗК)
	
	СтруктураЗК.Конструкции.Очистить();
	
	Для Каждого кзЗуб Из СтруктураЗК.Зубы Цикл
		кзЗуб.Значение.ТекущиеСегменты = Новый Соответствие;
		кзЗуб.Значение.ТекущиеСостояния = Новый Соответствие;
		кзЗуб.Значение.ОбозначениеВарианты = "";
		кзЗуб.Значение.ОбозначениеОсновнойВариант = "";
		Для Каждого кзВариант Из кзЗуб.Значение.Варианты Цикл
			кзВариант.Значение.Выбран = Ложь;
			Для Каждого кзОбласть Из кзВариант.Значение.Области Цикл
				кзОбласть.Значение.Выбран = Ложь;
			КонецЦикла;
		КонецЦикла;
		
		СтруктураЗК.ЗубыПоИд.Вставить(кзЗуб.Ключ.УникальныйИдентификатор(), кзЗуб.Значение);
		СтруктураЗК.ЗубыПоНомеру.Вставить(СокрЛП(Строка(кзЗуб.Ключ)), кзЗуб.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьШаблонЗубнойКарты(СтруктураАдресЗК, Клиент, Дата = Неопределено, ВариантКарты = Неопределено, Документ = Неопределено, АдресСостояний = Неопределено, УникальныйИдентификатор = Неопределено) Экспорт
	
	СтруктураЗК = стомЗубнаяКартаМетоды.ПолучитьСтруктуруЗК(СтруктураАдресЗК);
	
	Если УникальныйИдентификатор <> Неопределено Тогда
		Если УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("КэшироватьДанныеЗубныхКартВПриёмах")
			И ЭтоАдресВременногоХранилища(АдресСостояний)
		Тогда
			Результат = ПолучитьИзВременногоХранилища(АдресСостояний);
		Иначе
			Запрос = стомСтоматология.СформироватьЗапросАктуальныхВариантовСостояний(СтруктураЗК.ЗубнаяКарта, Клиент, Дата, ВариантКарты, Документ);
			Результат = Запрос.ВыполнитьПакет();
			АдресСостояний = ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
		КонецЕсли;
	Иначе
		Запрос = стомСтоматология.СформироватьЗапросАктуальныхВариантовСостояний(СтруктураЗК.ЗубнаяКарта, Клиент, Дата, ВариантКарты, Документ);
		Результат = Запрос.ВыполнитьПакет();
	КонецЕсли;
	
	СтруктураЗК.Клиент = Клиент;
	СтруктураЗК.Дата = Дата;
	СтруктураЗК.ВариантКарты = ВариантКарты;
	СтруктураЗК.Документ = Документ;
	
	// Установка вариантов
	ВыборкаВарианты = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВариантЗуба");
	Пока ВыборкаВарианты.Следующий() Цикл
		
		ВыборкаОбласти = ВыборкаВарианты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Область");
		Пока ВыборкаОбласти.Следующий() Цикл 
			
			МассивЗубов = Новый Массив;
			
			ВыборкаЗубы = ВыборкаОбласти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗубы.Следующий() Цикл 
				МассивЗубов.Добавить(ВыборкаЗубы.ЗубВКарте);
			КонецЦикла;
			
			Область = ?(ВыборкаВарианты.ВариантЗуба.Основной, Неопределено, ВыборкаОбласти.Область);
			стомЗубнаяКартаМетоды.УстановитьВариант(СтруктураЗК, МассивЗубов, ВыборкаВарианты.ВариантЗуба, Область);
			
		КонецЦикла; // Области
		
	КонецЦикла; // Варианты
	
	// Установка конструкций
	
	ВыборкаКонструкции = Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКонструкции.Следующий() Цикл
		
		ИдКонструкции = Строка(ВыборкаКонструкции.Конструкция.УникальныйИдентификатор());
		
		ВыборкаВарианты = ВыборкаКонструкции.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если ВыборкаВарианты.Следующий() Тогда 
			
			ВыборкаОбласти = ВыборкаВарианты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Если ВыборкаОбласти.Следующий() Тогда 
				
				МассивЗубов = Новый Массив;
				ВыборкаЗубы = ВыборкаОбласти.Выбрать();
				Пока ВыборкаЗубы.Следующий() Цикл 
					МассивЗубов.Добавить(ВыборкаЗубы.ЗубВКарте);
				КонецЦикла;
				
				стомЗубнаяКартаМетоды.УстановитьКонструкцию(
					СтруктураЗК, МассивЗубов, ВыборкаВарианты.ВариантЗуба, ВыборкаОбласти.Область, ВыборкаКонструкции.Конструкция);
				
			КонецЕсли; // Области
				
		КонецЕсли; // Варианты
		
	КонецЦикла; // Конструкции
	
	// Установка состояний
	ВыборкаЗубы = Результат[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЗубы.Следующий() Цикл
		
		ИдЗуба = ВыборкаЗубы.ЗубВКарте.УникальныйИдентификатор();
		СтруктураЗуб = СтруктураЗК.ЗубыПоИд.Получить(ИдЗуба);
		Если СтруктураЗуб = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		ВыборкаСостояния = ВыборкаЗубы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСостояния.Следующий() Цикл
			
			МассивСегментов = Новый Массив;
			
			ВыборкаСегменты = ВыборкаСостояния.Выбрать();
			Пока ВыборкаСегменты.Следующий() Цикл
				МассивСегментов.Добавить(ВыборкаСегменты.СегментВЗубе.УникальныйИдентификатор());
			КонецЦикла;
			
			стомЗубнаяКартаМетоды.УстановитьСостояние(СтруктураЗК, ИдЗуба, МассивСегментов, ВыборкаСостояния.СостояниеСегмента); 
			
		КонецЦикла; // Варианты
		
	КонецЦикла; // Зубы
	
	СтруктураЗК.ВыделенныеЗубыСегменты = Новый Массив;
	
КонецПроцедуры

#КонецОбласти

#Область КонструкторыОбъектов

Функция СоздатьЗубнуюКарту(ЗубнаяКарта, Клиент = Неопределено, Дата = Неопределено, ВариантКарты = Неопределено, Документ = Неопределено, Адрес = Неопределено, СбросВыделенияПоCtrl = Истина)
	
	СтруктураЗК = Новый Структура("ЗубнаяКарта, ВариантКарты, Клиент, Дата, Документ, Адрес, СбросВыделенияПоCtrl",
		ЗубнаяКарта, ВариантКарты, Клиент, Дата, Документ, "", СбросВыделенияПоCtrl);
	
	СтруктураЗК.Вставить("ДанныеСостояний", ПараметрыСеанса.стомКешированныеДанныеЗК.Состояния);
	СтруктураЗК.Вставить("ДанныеВариантов", ПараметрыСеанса.стомКешированныеДанныеЗК.Варианты);
	СтруктураЗК.Вставить("ДанныеДиагнозов", ПараметрыСеанса.стомКешированныеДанныеЗК.Диагнозы);
	СтруктураЗК.Вставить("Зубы", Новый Соответствие);
	СтруктураЗК.Вставить("ЗубыПоИд", Новый Соответствие);
	СтруктураЗК.Вставить("ЗубыПоНомеру", Новый Соответствие);
	СтруктураЗК.Вставить("Конструкции", Новый Соответствие);
	СтруктураЗК.Вставить("ВыделенныеЗубыСегменты", Новый Массив);
	СтруктураЗК.Вставить("ШиринаКанвы", ЗубнаяКарта.ШиринаКанвы);
	СтруктураЗК.Вставить("ВысотаКанвы", ЗубнаяКарта.ВысотаКанвы);
	СтруктураЗК.Вставить("РасположениеЗубов", стомЗубнаяКартаМетоды.ПолучитьРасположениеЗубов());
	СтруктураЗК.Вставить("ДиапазонЗубов", стомЗубнаяКартаМетоды.ПолучитьДиапазонЗубов());
	
	Возврат СтруктураЗК;
	
КонецФункции

Функция СоздатьЗуб(СтруктураЗК, ЗубВКарте)
	
	ИдЗуба = ЗубВКарте.УникальныйИдентификатор();
	НомерЗуба = СокрЛП(Строка(ЗубВКарте));
	
	СтруктураЗуб = Новый Структура("ЗубнаяКарта, ЗубВКарте, Зуб", СтруктураЗК.ЗубнаяКарта, ЗубВКарте, ЗубВКарте.Зуб);
	СтруктураЗуб.Вставить("Идентификатор", ИдЗуба);
	СтруктураЗуб.Вставить("Варианты", Новый Соответствие);
	СтруктураЗуб.Вставить("ШиринаКанвы", ЗубВКарте.Зуб.ШиринаКанвы);
	СтруктураЗуб.Вставить("ВысотаКанвы", ЗубВКарте.Зуб.ВысотаКанвы);
	СтруктураЗуб.Вставить("ПараметрыРасположения", СоздатьПараметрыРасположенияЭлемента(ЗубВКарте));
	СтруктураЗуб.Вставить("ТекущиеСегменты", Новый Соответствие);
	СтруктураЗуб.Вставить("ТекущиеСостояния", Новый Соответствие);
	СтруктураЗуб.Вставить("Расположение", СтруктураЗК.РасположениеЗубов.Получить(НомерЗуба));
	СтруктураЗуб.Вставить("Обозначение", Строка(ЗубВКарте));
	СтруктураЗуб.Вставить("ОбозначениеОсновнойВариант", "");
	СтруктураЗуб.Вставить("ОбозначениеВарианты", "");
	СтруктураЗуб.Вставить("ОбозначениеСостояния", "");
	
	СтруктураЗК.Зубы.Вставить(ЗубВКарте, СтруктураЗуб);
	СтруктураЗК.ЗубыПоИд.Вставить(ЗубВКарте.УникальныйИдентификатор(), СтруктураЗуб);
	СтруктураЗК.ЗубыПоНомеру.Вставить(НомерЗуба, СтруктураЗуб);
	
	Возврат СтруктураЗуб;
	
КонецФункции

Функция СоздатьВариант(СтруктураЗуб, ВариантЗуба, Нумерация = Неопределено)
	
	СтруктураВариант = Новый Структура("ЗубВКарте, ВариантЗуба, Выбран",
		СтруктураЗуб.ЗубВКарте, ВариантЗуба, Ложь);
	СтруктураВариант.Вставить("Основной", ВариантЗуба.Основной);
	СтруктураВариант.Вставить("Обозначение", ВариантЗуба.Обозначение);
	СтруктураВариант.Вставить("Конструкция", ВариантЗуба.Конструкция);
	СтруктураВариант.Вставить("Области", Новый Соответствие);
	
	Если СтруктураВариант.Основной Тогда 
		СтруктураВариант.Вставить("Нумерация", ?(Нумерация = Неопределено, Строка(СтруктураЗуб.ЗубВКарте), Нумерация));
	КонецЕсли;
	
	СтруктураЗуб.Варианты.Вставить(ВариантЗуба, СтруктураВариант);
	
	Возврат СтруктураВариант;
	
КонецФункции

Функция СоздатьОбласть(СтруктураВариант, Область)
	
	СтруктураОбласть = Новый Структура("ЗубВКарте, ВариантЗуба, Область, Выбран", 
		СтруктураВариант.ЗубВКарте, СтруктураВариант.ВариантЗуба, Область, Ложь);
	СтруктураОбласть.Вставить("Декоративная", Область.Декоративная);
	СтруктураОбласть.Вставить("ВидОбласти", Область.ВидОбласти);
	СтруктураОбласть.Вставить("Конструкция", 
		Область.ВидОбласти = Перечисления.стомВидыОбластей.Конструкция Или 
		Область.ВидОбласти = Перечисления.стомВидыОбластей.ЭлементКонструкции);
	
	Если Область.ВидОбласти = Перечисления.стомВидыОбластей.ОбластьЗуба Тогда  
		СтруктураОбласть.Вставить("Сегменты", Новый Соответствие);
		СтруктураОбласть.Вставить("СегментыПоИд", Новый Соответствие);
		СтруктураВариант.Области.Вставить(Область, СтруктураОбласть);
	ИначеЕсли Область.ВидОбласти = Перечисления.стомВидыОбластей.Конструкция Тогда 
		СтруктураОбласть.Вставить("Начало");
		СтруктураОбласть.Вставить("Середина");
		СтруктураОбласть.Вставить("Конец");
		СтруктураОбласть.Вставить("ВыбраннаяЧастьКонструкции");
		СтруктураВариант.Области.Вставить(Область, СтруктураОбласть);
	ИначеЕсли Область.ВидОбласти = Перечисления.стомВидыОбластей.ЭлементКонструкции Тогда
		СтруктураОбласть.Вставить("Сегменты", Новый Соответствие);
		СтруктураОбласть.Вставить("СегментыПоИд", Новый Соответствие);
		СтруктураОбласть.Вставить("КонструкцияРодитель", Область.КонструкцияРодитель);
	КонецЕсли;
	
	Возврат СтруктураОбласть;
	
КонецФункции

Функция СоздатьСегмент(СтруктураОбласть, СегментВЗубе, СозданныеСегменты)
	
	ИдСегмента = СегментВЗубе.УникальныйИдентификатор();
	СтруктураСегмент = СозданныеСегменты.Получить(ИдСегмента);
	
	Если СтруктураСегмент = Неопределено Тогда 
		
		СтруктураСегмент = Новый Структура("ЗубВКарте, ВариантЗуба, Область, СегментВЗубе, Декоративный", 
			СтруктураОбласть.ЗубВКарте, СтруктураОбласть.ВариантЗуба, СтруктураОбласть.Область, СегментВЗубе, СтруктураОбласть.Декоративная);
		СтруктураСегмент.Вставить("Идентификатор", ИдСегмента);
		СтруктураСегмент.Вставить("ПараметрыРасположения", СоздатьПараметрыРасположенияЭлемента(СегментВЗубе));
		СтруктураСегмент.Вставить("ЦветПоУмолчанию", "#" + НРег(Прав(СегментВЗубе.Сегмент.ЦветHex, 6)));
		СтруктураСегмент.Вставить("Фигура", СегментВЗубе.Сегмент.Фигура);
		СтруктураСегмент.Вставить("Конструкция", СтруктураОбласть.Конструкция);
			
		СозданныеСегменты.Вставить(ИдСегмента, СтруктураСегмент);
		
	КонецЕсли;
	
	СтруктураОбласть.Сегменты.Вставить(СегментВЗубе, СтруктураСегмент);
	СтруктураОбласть.СегментыПоИд.Вставить(СегментВЗубе.УникальныйИдентификатор(), СтруктураСегмент);
	
	Возврат СтруктураСегмент;
	
КонецФункции

Функция СоздатьСостояниеМаски(СостояниеЗуба, ПозицияВМаске)
	
	СтруктураСостояние = Новый Структура("Состояние", СостояниеЗуба);
	СтруктураСостояние.Вставить("ПозицияВМаске", ПозицияВМаске);
	СтруктураСостояние.Вставить("ЦветHex", "#" + НРег(Прав(СостояниеЗуба.ЦветHex, 6)));
	СтруктураСостояние.Вставить("Цвет", ПоместитьВоВременноеХранилище(СостояниеЗуба.Цвет.Получить(), Новый УникальныйИдентификатор));
	СтруктураСостояние.Вставить("ДанныеПриложения", СостояниеЗуба.СтроковоеПредставление);
	СтруктураСостояние.Вставить("Обозначение", СостояниеЗуба.КраткоеОбозначение);
	
	Возврат Новый ФиксированнаяСтруктура(СтруктураСостояние);
	
КонецФункции

Функция СоздатьВариантМаски(ВариантЗуба, ПозицияВМаске)
	
	СтруктураВариант = Новый Структура("Вариант", ВариантЗуба);
	СтруктураВариант.Вставить("ПозицияВМаске", ПозицияВМаске);
	СтруктураВариант.Вставить("Основной", ВариантЗуба.Основной);
	СтруктураВариант.Вставить("Конструкция", ВариантЗуба.Конструкция);
	СтруктураВариант.Вставить("Области", Новый Массив);
	
	Для Каждого СтрокаОбласть Из ВариантЗуба.СписокОбластей Цикл
		СтруктураВариант.Области.Добавить(СтрокаОбласть.Область);
	КонецЦикла;
	
	СтруктураВариант.Вставить("Области", Новый ФиксированныйМассив(СтруктураВариант.Области));
	
	Возврат Новый ФиксированнаяСтруктура(СтруктураВариант);
	
КонецФункции

Функция СоздатьДиагнозМаски(Диагноз, ПозицияВМаске)
	
	СтруктураДиагноз = Новый Структура("Диагноз", Диагноз);
	СтруктураДиагноз.Вставить("ПозицияВМаске", ПозицияВМаске);
	
	Возврат Новый ФиксированнаяСтруктура(СтруктураДиагноз);
	
КонецФункции

Функция СоздатьПараметрыРасположенияЭлемента(ЗубВКартеСегментВЗубе)
	
	СтруктПараметры = Новый Структура("x, y, sX, sY, r, z",
		ЗубВКартеСегментВЗубе.TranslateX, 
		ЗубВКартеСегментВЗубе.TranslateY,
		ЗубВКартеСегментВЗубе.ScaleX,
		ЗубВКартеСегментВЗубе.ScaleY,
		ЗубВКартеСегментВЗубе.Rotation,
		ЗубВКартеСегментВЗубе.ZIndex);
	
	Возврат СтруктПараметры;
	
КонецФункции

#Область ЭкспортныеОбъектыСоздаваемыеВХодеРаботы 

Функция СоздатьКонструкцию(СтруктураАдресЗК, Вариант, Область, Конструкция = Неопределено) Экспорт
	
	СтруктураЗК = стомЗубнаяКартаМетоды.ПолучитьСтруктуруЗК(СтруктураАдресЗК);
	
	КонструкцияСсылка = Конструкция;
	Если Конструкция = Неопределено Тогда
		КонструкцияОбъект = Справочники.стомКонструкцииЗубовКлиентов.СоздатьЭлемент();
		КонструкцияОбъект.Владелец = СтруктураЗК.Клиент;
		КонструкцияОбъект.Предварительная = Истина;
		КонструкцияОбъект.Записать();
		КонструкцияСсылка = КонструкцияОбъект.Ссылка;
	КонецЕсли;
	
	ИдКонструкции = КонструкцияСсылка.УникальныйИдентификатор();
	
	СтруктураКонструкция = Новый Структура("ЗубнаяКарта, Вариант, Область, Идентификатор, Удалена",
		СтруктураЗК.ЗубнаяКарта, Вариант, Область, ИдКонструкции, Ложь);
	СтруктураКонструкция.Вставить("Конструкция", КонструкцияСсылка);
	СтруктураКонструкция.Вставить("СоставЗубов", Новый Массив);
	СтруктураКонструкция.Вставить("СоставЗубовСтрокой", "");
	СтруктураКонструкция.Вставить("Обозначение", Строка(КонструкцияСсылка));
	СтруктураКонструкция.Вставить("Комментарий", КонструкцияСсылка.Комментарий);
	СтруктураКонструкция.Вставить("НеСоздана", Конструкция = Неопределено);
	
	СтруктураЗК.Конструкции.Вставить(ИдКонструкции, СтруктураКонструкция);
	
	Возврат СтруктураКонструкция;
	
КонецФункции

Функция СоздатьТекущийСегмент(СтруктураЗуб, СтруктураСегмент) Экспорт
	
	СтруктураТекСегмент = Новый Структура("СтруктураСегмент, Идентификатор, СегментВЗубе",
		СтруктураСегмент, СтруктураСегмент.Идентификатор, СтруктураСегмент.СегментВЗубе);
		
	// Список установленных вариантов, в которых сегмент участвует (один и тот же сегмент может быть в нескольких)
	// Если сегмент не содержится ни в одном варианте, он должен быть исключен из зуба
	СтруктураТекСегмент.Вставить("Варианты", Новый Соответствие);
	СтруктураТекСегмент.Вставить("Состояния", Новый Соответствие); // Состояния, установленные на сегмент
	СтруктураТекСегмент.Вставить("Обозначение", Строка(СтруктураСегмент.СегментВЗубе));
	СтруктураТекСегмент.Вставить("ОбозначениеСостояний", "");
	
	СтруктураЗуб.ТекущиеСегменты.Вставить(СтруктураСегмент.Идентификатор, СтруктураТекСегмент);
	
	Возврат СтруктураТекСегмент;
	
КонецФункции

Функция СформироватьТекстПоляУпрощеннойЗубнойКарты(СтруктураАдресЗК) Экспорт
	
	СтруктураЗК = стомЗубнаяКартаМетоды.ПолучитьСтруктуруЗК(СтруктураАдресЗК);
	
	ДокументHTML = Справочники.стомВидыЗубныхКарт.ПолучитьМакет("ЗубнаяКартаУпрощеннаяHTML").ПолучитьДокументHTML();
	
	Для Каждого кзЗуб Из СтруктураЗК.Зубы Цикл
		
		СтруктураЗуб = кзЗуб.Значение;
		Если СтруктураЗуб.Расположение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементЗуб = ДокументHTML.ПолучитьЭлементПоИдентификатору(СтруктураЗуб.Расположение.Номер);
		Если ЭлементЗуб = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементЗуб.ТекстовоеСодержимое = СтруктураЗуб.Обозначение;
		ЭлементЗуб.Идентификатор = Строка(СтруктураЗуб.Идентификатор);
		
		Для Каждого ВыделенныйЗуб Из СтруктураЗК.ВыделенныеЗубыСегменты Цикл
			Если ВыделенныйЗуб.ЗубВКарте = СтруктураЗуб.ЗубВКарте Тогда
				ЭлементЗуб.parentNode.className = "focus";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат РаботаСDOMКлиентСервер.ПолучитьТекстHTMLДокументаDOM(ДокументHTML);
	
КонецФункции

#КонецОбласти

#КонецОбласти
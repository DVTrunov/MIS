// Процедура сворачивает таблицу значений по всем колонкам.
//
// Параметры:
//  Таблица				 - ТаблицаЗначений - сворачиваемая таблица.
//  СуммируемыеКолонки	 - Строка - перечень суммируемых колонок таблицы, например "Сумма, Количество".
//
Процедура СвернутьТаблицуЗначений(Таблица, СуммируемыеКолонки = "", СтрокаИзмерений = Неопределено)  экспорт
	
	КолонкиСуммы = СтрРазделить(СтрЗаменить(СуммируемыеКолонки," ",""), ",", Ложь);
	
	Если ТипЗнч(СтрокаИзмерений) <> Тип("Строка") Тогда
		ИзмеренияСтрокой = "";
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если КолонкиСуммы.Найти(Колонка.Имя) = Неопределено Тогда
				ОбщегоНазначенияБИТКлиентСервер.КонкатенацияСтрок(ИзмеренияСтрокой, Колонка.Имя);
			КонецЕсли;
		КонецЦикла;
	Иначе
		КолонкиИзмерений = СтрРазделить(СтрЗаменить(СтрокаИзмерений," ",""), ",", Ложь);
		Для Каждого КолонкаСуммы Из КолонкиСуммы Цикл
			Инд = КолонкиИзмерений.Найти(КолонкаСуммы);
			Если Инд <> Неопределено Тогда
				КолонкиИзмерений.Удалить(Инд);
			КонецЕсли;
		КонецЦикла;
		ИзмеренияСтрокой = СтрСоединить(КолонкиИзмерений, ",");
	КонецЕсли;
	
	Таблица.Свернуть(ИзмеренияСтрокой, СуммируемыеКолонки);
	
КонецПроцедуры

// Помещает таблицу значений во временную таблицу запроса. 
// Не сохраняет текст запроса.
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - помещаемая таблица значений
//  ИмяВременнойТаблицы - Строка - имя временной таблицы
//  Запрос          - Запрос - запрос, в котором будет помещена временная таблица
//  СписокПолей     - Строка - Список колонок для помещения во временную таблицу, По умолчанию "".
//
Процедура ПоместитьТаблицуЗначенийВоВременнуюТаблицу(ТаблицаЗначений, ИмяВременнойТаблицы, Запрос, СписокПолей = "") Экспорт
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		УничтожитьВременнуюТаблицуЗапроса(Запрос, ИмяВременнойТаблицы);
	КонецЕсли;		
	
	Если ПустаяСтрока(СписокПолей) Тогда
		
		Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
			СписокПолей = СписокПолей + ?(ПустаяСтрока(СписокПолей),"",", ") + Колонка.Имя;
		КонецЦикла;
		ТекстГруппировка = "";
		Запрос.Текст = "ВЫБРАТЬ "+СписокПолей+" ПОМЕСТИТЬ "+ИмяВременнойТаблицы+" ИЗ &Таб КАК Таблица"+ТекстГруппировка;
		
	Иначе
		УникальныйСуффикс = "_УникальныйСуффикс";
		ТекстГруппировка = Символы.ПС + "СГРУППИРОВАТЬ ПО " + СписокПолей;
		
		Запрос.Текст = 	"ВЫБРАТЬ "+СписокПолей+" 
						|ПОМЕСТИТЬ " + ИмяВременнойТаблицы + УникальныйСуффикс + " 
						|ИЗ &Таб КАК Таблица
						|;
						|
						|ВЫБРАТЬ "+СписокПолей+" 
						|ПОМЕСТИТЬ " + ИмяВременнойТаблицы + " 
						|ИЗ " + ИмяВременнойТаблицы + УникальныйСуффикс + "
						|" + ТекстГруппировка + "
						|;
						|
						|УНИЧТОЖИТЬ "  + ИмяВременнойТаблицы + УникальныйСуффикс;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Таб",ТаблицаЗначений);
	Запрос.Выполнить();
	
КонецПроцедуры

// Удаляет временную таблицу запроса, если она в нём есть.
//
// Параметры:
//  Запрос          - Запрос - запрос, в котором будет удалена временная таблица
//  ИмяВременнойТаблицы - Строка - имя временной таблицы.
//
Процедура УничтожитьВременнуюТаблицуЗапроса(Запрос, ИмяВременнойТаблицы) Экспорт
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы) <> Неопределено Тогда
		// Удаление старой, если уже есть в менеджере таблиц
		Запрос.Текст = "УНИЧТОЖИТЬ " + ИмяВременнойТаблицы;
		Запрос.Выполнить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

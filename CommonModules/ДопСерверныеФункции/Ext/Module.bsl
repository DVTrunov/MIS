// 
// Возвращаемое значение:
//   Булево.
//
Функция ЭтоСправочник(Справочник) Экспорт
	
	Если ТипЗнч(Справочник) = Тип("Строка") Тогда
		Если Метаданные.Справочники.Найти(Справочник) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;	
	ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Справочник)) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции


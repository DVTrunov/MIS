#Область РаботаВФорме

Функция ПолучитьКореньВетвиДерева(Ветвь) Экспорт
	
	Родитель = Ветвь.ПолучитьРодителя();
	Пока Родитель <> Неопределено Цикл
		Ветвь = Родитель;
		Родитель = Ветвь.ПолучитьРодителя();
	КонецЦикла;
	
	Возврат Ветвь;
	
КонецФункции

Функция НайтиСтрокиВДеревеФормы(ДеревоФормы, Отбор, ВозвращатьПервую = Истина) Экспорт
	
	Если Отбор.Количество() = 0 Тогда
		Если ВозвращатьПервую Тогда 
			Возврат Неопределено;
		Иначе
			Возврат Новый Массив;
		КонецЕсли;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	НайтиСтрокиВДеревеФормыРекурсивно(ДеревоФормы, Отбор, ВозвращатьПервую, МассивСтрок);
	
	Если ВозвращатьПервую Тогда 
		Возврат ?(МассивСтрок.Количество() > 0, МассивСтрок[0], Неопределено);
	КонецЕсли;
	
	Возврат МассивСтрок;
	
КонецФункции

Процедура НайтиСтрокиВДеревеФормыРекурсивно(УзелДерева, Отбор, ВозвращатьПервую, МассивСтрок) 
	
	Для Каждого СтрокаУзла Из УзелДерева.ПолучитьЭлементы() Цикл
		
		СтрокаНайдена = Истина;
		Для Каждого кзЭлементОтбора Из Отбор Цикл
			Если СтрокаУзла[кзЭлементОтбора.Ключ] <> кзЭлементОтбора.Значение Тогда
				СтрокаНайдена = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаНайдена Тогда 
			МассивСтрок.Добавить(СтрокаУзла);
			Если ВозвращатьПервую Тогда 
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		НайтиСтрокиВДеревеФормыРекурсивно(СтрокаУзла, Отбор, ВозвращатьПервую, МассивСтрок);
		
		Если ВозвращатьПервую И МассивСтрок.Количество() > 0 Тогда 
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПересчитатьФлажкиВДереве(СтрокаДерева, ИмяПоляФлажка = "Установлено", ИмяПоляУстановленныхДочерних = "УстановленоДетей") Экспорт
	
	ПересчитатьФлажкиВДеревеРекурсивноВниз(СтрокаДерева, ИмяПоляФлажка, ИмяПоляУстановленныхДочерних);
	ПересчитатьФлажкиВДеревеРекурсивноВверх(СтрокаДерева.ПолучитьРодителя(), ИмяПоляФлажка, ИмяПоляУстановленныхДочерних);
	
КонецПроцедуры

Процедура ПересчитатьФлажкиВДеревеРекурсивноВниз(УзелДерева, ИмяПоляФлажка = "Установлено", ИмяПоляУстановленныхДочерних = "УстановленоДетей") Экспорт 
	
	УзелДерева[ИмяПоляУстановленныхДочерних] = 0;
	ЭлементыУзла = УзелДерева.ПолучитьЭлементы();
	Для Каждого Элемент Из ЭлементыУзла Цикл
		Элемент[ИмяПоляФлажка] = УзелДерева[ИмяПоляФлажка];
		УзелДерева[ИмяПоляУстановленныхДочерних] = УзелДерева[ИмяПоляУстановленныхДочерних] + Элемент[ИмяПоляФлажка];
		ПересчитатьФлажкиВДеревеРекурсивноВниз(Элемент, ИмяПоляФлажка, ИмяПоляУстановленныхДочерних);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПересчитатьФлажкиВДеревеРекурсивноВверх(РодительУзла, ИмяПоляФлажка = "Установлено", ИмяПоляУстановленныхДочерних = "УстановленоДетей") Экспорт 
	
	Если РодительУзла = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	РодительУзла[ИмяПоляФлажка] = 0;
	РодительУзла[ИмяПоляУстановленныхДочерних] = 0;
	ЭлементыРодителя = РодительУзла.ПолучитьЭлементы();
	Для Каждого Элемент Из ЭлементыРодителя Цикл
		Если Элемент[ИмяПоляФлажка] = 1 Тогда
			РодительУзла[ИмяПоляУстановленныхДочерних] = РодительУзла[ИмяПоляУстановленныхДочерних] + 1;
		ИначеЕсли Элемент[ИмяПоляФлажка] = 2 Тогда 
			РодительУзла[ИмяПоляУстановленныхДочерних] = РодительУзла[ИмяПоляУстановленныхДочерних] + 0.5;	
		КонецЕсли;
	КонецЦикла;
	
	Если РодительУзла[ИмяПоляУстановленныхДочерних] = ЭлементыРодителя.Количество() Тогда 
		РодительУзла[ИмяПоляФлажка] = 1;
	ИначеЕсли РодительУзла[ИмяПоляУстановленныхДочерних] > 0 Тогда 
		РодительУзла[ИмяПоляФлажка] = 2;
	КонецЕсли;
	
	ПересчитатьФлажкиВДеревеРекурсивноВверх(РодительУзла.ПолучитьРодителя(), ИмяПоляФлажка, ИмяПоляУстановленныхДочерних);
	
КонецПроцедуры

Функция НайтиТаблицуПоляФормы(Элемент) Экспорт 
	
	Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
		Возврат Элемент;
	ИначеЕсли Элемент.Родитель = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат НайтиТаблицуПоляФормы(Элемент.Родитель);
	КонецЕсли;
	
КонецФункции


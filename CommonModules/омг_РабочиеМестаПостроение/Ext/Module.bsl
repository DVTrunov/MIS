// Строит рабочее место на форме по данным варианта.
//
// Параметры:
//  Форма   - УправляемаяФорма - форма-приёмник. Должна содержать группы
//            Колонка1, Колонка2, Колонка3 и реквизит ПараметрыДействий.
//  Вариант - СправочникСсылка.омг_ВариантыРабочихМест
//  Данные  - Структура, Неопределено - готовые данные (Панели, Плитки).
//            Если не задано, читаются из базы по варианту.
//
Процедура Построить(Форма, Вариант, Данные = Неопределено, Предпросмотр = Ложь) Экспорт

    Очистить(Форма);

    Если Данные = Неопределено Тогда
        Если НЕ ЗначениеЗаполнено(Вариант) Тогда
            Возврат;
        КонецЕсли;
        Данные = ПрочитатьВариант(Вариант);
    КонецЕсли;

    Контекст = Новый Структура;
    Контекст.Вставить("Форма", Форма);
    Контекст.Вставить("Предпросмотр", Предпросмотр);
    Контекст.Вставить("Дети", ИндексДетей(Данные));
    Контекст.Вставить("Счетчик", 0);

    Корневые = Контекст.Дети.Получить("");
    Если Корневые = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Корень = Форма.Элементы.ГруппаКорень;
    Типы = Перечисления.омг_ТипыЭлементовРабочегоМеста;
    РядКолонок = Неопределено;

    Для Каждого Элемент Из Корневые Цикл
        Если Элемент.ТипЭлемента = Типы.КоманднаяПанель Тогда
            Панель = Форма.Элементы.Найти("омг_ПанельДействий");
            Если Панель = Неопределено Тогда
                Панель = Форма.Элементы.Найти("ФормаКоманднаяПанель");
            КонецЕсли;
            Если Панель <> Неопределено Тогда
                Дети = Контекст.Дети.Получить(СокрЛП(Элемент.КодЭлемента));
                Если Дети <> Неопределено Тогда
                    ПостроитьДетей(Контекст, Дети, Панель, 1, Ложь);
                КонецЕсли;
            КонецЕсли;
		ИначеЕсли Элемент.ТипЭлемента = Типы.Колонка Тогда
			Если РядКолонок = Неопределено Тогда
                РядКолонок = НоваяГруппа(Контекст, Корень,
                    ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда);
            КонецЕсли;
            ПостроитьЭлемент(Контекст, Элемент, РядКолонок);
        Иначе
            ПостроитьЭлемент(Контекст, Элемент, Корень);
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Процедура Очистить(Форма) Экспорт

    Форма.ПараметрыДействий.Очистить();

    ОчиститьГруппу(Форма, "ГруппаКорень");
ОчиститьГруппу(Форма, "омг_ПанельДействий");
    ОчиститьГруппу(Форма, "ФормаКоманднаяПанель");
	Удаляемые = Новый Массив;
    Для Каждого Команда Из Форма.Команды Цикл
        Если СтрНачинаетсяС(Команда.Имя, "омг_Плитка") Тогда
            Удаляемые.Добавить(Команда.Имя);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Имя Из Удаляемые Цикл
        Форма.Команды.Удалить(Форма.Команды[Имя]);
    КонецЦикла;

КонецПроцедуры

Процедура ОчиститьГруппу(Форма, ИмяГруппы)

    Группа = Форма.Элементы.Найти(ИмяГруппы);
    Если Группа = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Удаляемые = Новый Массив;
    Для Каждого Подчиненный Из Группа.ПодчиненныеЭлементы Цикл
        Если СтрНачинаетсяС(Подчиненный.Имя, "омг_Гр")
         ИЛИ СтрНачинаетсяС(Подчиненный.Имя, "омг_Плитка")
         ИЛИ СтрНачинаетсяС(Подчиненный.Имя, "омг_Загл")
         ИЛИ СтрНачинаетсяС(Подчиненный.Имя, "омг_Разд") Тогда
            Удаляемые.Добавить(Подчиненный);
        КонецЕсли;
    КонецЦикла;

    Для Каждого Элемент Из Удаляемые Цикл
        Попытка
            Форма.Элементы.Удалить(Элемент);
        Исключение

	КонецПопытки;
    КонецЦикла;

КонецПроцедуры
// Соответствие: код родителя -> массив строк-детей в порядке НомерСтроки.
Функция ИндексДетей(Данные)
    Результат = Новый Соответствие;
    Для Каждого Стр Из Данные Цикл
        Ключ = СокрЛП(Стр.КодРодителя);
        Дети = Результат.Получить(Ключ);
        Если Дети = Неопределено Тогда
            Дети = Новый Массив;
            Результат.Вставить(Ключ, Дети);
        КонецЕсли;
        Дети.Добавить(Стр);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция НоваяГруппа(Контекст, Родитель, Группировка)
    Контекст.Счетчик = Контекст.Счетчик + 1;
    Группа = Контекст.Форма.Элементы.Добавить(
        "омг_Гр" + Формат(Контекст.Счетчик, "ЧГ=0"), Тип("ГруппаФормы"), Родитель);
    Группа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
    Группа.Отображение         = ОтображениеОбычнойГруппы.Нет;
    Группа.ОтображатьЗаголовок = Ложь;
    Группа.Группировка         = Группировка;
    Возврат Группа;
КонецФункции

// Возвращает Истина, если элемент был создан.
Функция ПостроитьЭлемент(Контекст, Элемент, Родитель)

    Типы = Перечисления.омг_ТипыЭлементовРабочегоМеста;

    Если Элемент.ТипЭлемента = Типы.Плитка Тогда
        Возврат ДобавитьПлитку(Контекст, Элемент, Родитель);
    ИначеЕсли Элемент.ТипЭлемента = Типы.Разделитель Тогда
        Возврат ДобавитьРазделитель(Контекст, Элемент, Родитель);
    Иначе
        Возврат ДобавитьКонтейнер(Контекст, Элемент, Родитель);
    КонецЕсли;

КонецФункции

Функция ДобавитьКонтейнер(Контекст, Элемент, Родитель)

     Типы        = Перечисления.омг_ТипыЭлементовРабочегоМеста;
    Поведения   = Перечисления.омг_ПоведенияГрупп;
    Всплывающая = (Элемент.ТипЭлемента = Типы.Группа И Элемент.Поведение = Поведения.Всплывающая);

    Если Элемент.ТипЭлемента = Типы.Шапка Тогда
        Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
    Иначе
        Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
    КонецЕсли;

    Группа = НоваяГруппа(Контекст, Родитель, Группировка);

    Если Элемент.ТипЭлемента = Типы.Шапка Тогда
        Группа.РастягиватьПоГоризонтали = Истина;
    КонецЕсли;

   Если Элемент.Размер = Перечисления.омг_РазмерыПлиток.Карточка Тогда
        Группа.ОтображатьКакКарточку = Истина;
    КонецЕсли;

    Если Элемент.ТипЭлемента = Типы.Группа Тогда
        НастроитьПоведениеГруппы(Группа, Элемент);
    КонецЕсли;

    Если Элемент.Ширина > 0 Тогда
        Группа.Ширина = Элемент.Ширина;
    КонецЕсли;
    УстановитьПоложение(Группа, Элемент.Положение);

    Если Элемент.ПоказыватьЗаголовок И НЕ ПустаяСтрока(Элемент.Заголовок) И НЕ Всплывающая Тогда
        Контекст.Счетчик = Контекст.Счетчик + 1;
        Надпись = Контекст.Форма.Элементы.Добавить(
            "омг_Загл" + Формат(Контекст.Счетчик, "ЧГ=0"), Тип("ДекорацияФормы"), Группа);
        Надпись.Вид        = ВидДекорацииФормы.Надпись;
        Надпись.Заголовок  = Элемент.Заголовок;
        Надпись.Шрифт      = ШрифтыСтиля.омг_ШрифтЗаголовкаПанели;
        Надпись.ЦветТекста = ЦветаСтиля.омг_ЦветЗаголовкаПанели;
        Надпись.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
    КонецЕсли;

    ВСтроке = Элемент.ЭлементовВСтроке;
    Если ВСтроке <= 0 Тогда
        ВСтроке = ?(Элемент.ТипЭлемента = Типы.Колонка, 1, 999);
    КонецЕсли;

    Дети = Контекст.Дети.Получить(СокрЛП(Элемент.КодЭлемента));
    ГоризонтальныйКонтейнер = (Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда);
    Создано = ?(Дети = Неопределено, 0,
        ПостроитьДетей(Контекст, Дети, Группа, ВСтроке, НЕ ГоризонтальныйКонтейнер));

    Результат = Контекст.Предпросмотр ИЛИ (Создано > 0);
    Группа.Видимость = Результат;
    Возврат Результат;

КонецФункции

Функция ПостроитьДетей(Контекст, Дети, Контейнер, ВСтроке, РазрешеныРяды = Истина)

     Создано = 0;
    ВРяду   = 0;
    Ряд     = Неопределено;
    Рядами  = РазрешеныРяды И (ВСтроке > 1);

    Для Каждого Ребенок Из Дети Цикл

        Если Рядами Тогда
            Если Ряд = Неопределено ИЛИ ВРяду >= ВСтроке ИЛИ (Ребенок.СНовойСтроки И ВРяду > 0) Тогда
                Ряд = НоваяГруппа(Контекст, Контейнер,
                    ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда);
                ВРяду = 0;
            КонецЕсли;
            Цель = Ряд;
        Иначе
            Цель = Контейнер;
        КонецЕсли;

        Если ПостроитьЭлемент(Контекст, Ребенок, Цель) Тогда
            Создано = Создано + 1;
            ВРяду   = ВРяду + 1;
        КонецЕсли;

    КонецЦикла;

    Возврат Создано;

КонецФункции

Процедура НастроитьПоведениеГруппы(Группа, Элемент)

    Поведения = Перечисления.омг_ПоведенияГрупп;

	Если Элемент.Поведение = Поведения.Всплывающая Тогда
        Группа.Поведение             = ПоведениеОбычнойГруппы.Всплывающая;
        Группа.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Кнопка;
        Группа.Отображение           = ОтображениеОбычнойГруппы.ОбычноеВыделение;
        Группа.ОтображатьЗаголовок   = Истина;
        Группа.Заголовок             = Элемент.Заголовок;
    
    ИначеЕсли Элемент.Поведение = Поведения.Свернутая Тогда
        Группа.Отображение         = ОтображениеОбычнойГруппы.СлабоеВыделение;
        Группа.ОтображатьЗаголовок = Истина;
        Группа.Заголовок           = Элемент.Заголовок;
        Группа.Свернута            = Истина;
    КонецЕсли;

КонецПроцедуры

Процедура УстановитьПоложение(ЭлементФормы, Положение)
    Положения = Перечисления.омг_ПоложенияЭлементов;
    Если Положение = Положения.Слева Тогда
        ЭлементФормы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
    ИначеЕсли Положение = Положения.Центр Тогда
        ЭлементФормы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
    ИначеЕсли Положение = Положения.Справа Тогда
        ЭлементФормы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
    КонецЕсли;
КонецПроцедуры

Функция ДобавитьРазделитель(Контекст, Элемент, Родитель)
    Контекст.Счетчик = Контекст.Счетчик + 1;
    Декорация = Контекст.Форма.Элементы.Добавить(
        "омг_Разд" + Формат(Контекст.Счетчик, "ЧГ=0"), Тип("ДекорацияФормы"), Родитель);
    Декорация.Вид       = ВидДекорацииФормы.Надпись;
    Декорация.Заголовок = "";
    Возврат Истина;
КонецФункции

Функция ДобавитьПлитку(Контекст, Элемент, Родитель)

  Форма = Контекст.Форма;

    Если НЕ ЗначениеЗаполнено(Элемент.Действие) ИЛИ Элемент.ДействиеНеИспользуется Тогда
        Возврат Ложь;
    КонецЕсли;

    Если НЕ Контекст.Предпросмотр И НЕ ПлиткаДоступна(Элемент) Тогда
        Возврат Ложь;
    КонецЕсли;

    ВКоманднойПанели = (Родитель.Вид = ВидГруппыФормы.КоманднаяПанель);
	                                

    Контекст.Счетчик = Контекст.Счетчик + 1;
    ИмяЭлемента = "омг_Плитка" + Формат(Контекст.Счетчик, "ЧГ=0");

    Команда = Форма.Команды.Добавить(ИмяЭлемента);
    Команда.Действие  = "Подключаемый_НажатиеПлитки";
    Команда.Заголовок = Элемент.Заголовок;
    Команда.Подсказка = Элемент.Описание;

    Кнопка = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), Родитель);
    Кнопка.ИмяКоманды  = Команда.Имя;
    Кнопка.Вид         = ?(ВКоманднойПанели,
        ВидКнопкиФормы.КнопкаКоманднойПанели, ВидКнопкиФормы.ОбычнаяКнопка);
    Кнопка.Отображение = ОтображениеКнопки.КартинкаИТекст; 
//Если ВКоманднойПанели Тогда
//		//Положения = Перечисления.омг_ПоложенияЭлементов;
//		//Если Элемент.Положение = Положения.Справа Тогда
//		//    Кнопка.ПоложениеВКоманднойПанели = ПоложениеЭлементаВКоманднойПанели.Право;
//		//ИначеЕсли Элемент.Положение = Положения.Слева Тогда
//		//    Кнопка.ПоложениеВКоманднойПанели = ПоложениеЭлементаВКоманднойПанели.Лево;
//		//КонецЕсли;
//		Кнопка.ПоложениеВКоманднойПанели =  ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
//    КонецЕсли;
    
    Картинка = КартинкаПлитки(Элемент.ИмяКартинки);
    Если Картинка <> Неопределено Тогда
        Кнопка.Картинка = Картинка;
    КонецЕсли;

    Если НЕ ВКоманднойПанели Тогда

        Кнопка.ЦветФона = ЦветПоСхеме(Элемент.Цвет);

        Если Элемент.Размер = Перечисления.омг_РазмерыПлиток.Карточка Тогда
            Кнопка.ОтображатьКакКарточку = Истина;
            Кнопка.ВыравниваниеКартинкиИЗаголовкаКарточки =
                ВариантВыравниванияКартинкиИЗаголовкаКарточки.ГоризонтальноЦентрВертикальноЦентр;
            Кнопка.Ширина                 = ?(Элемент.Ширина > 0, Элемент.Ширина, 18);
            Кнопка.ВысотаКартинки         = 0;
            Кнопка.АвтоМаксимальнаяШирина = Ложь;
        Иначе
            Кнопка.ОтображатьКакКарточку = Ложь;
            Если Элемент.Ширина > 0 Тогда
                Кнопка.Ширина = Элемент.Ширина;
                Кнопка.АвтоМаксимальнаяШирина = Ложь;
            ИначеЕсли ЗначениеЗаполнено(Элемент.Положение)
                  И Элемент.Положение <> Перечисления.омг_ПоложенияЭлементов.Авто Тогда
                Кнопка.АвтоМаксимальнаяШирина = Ложь;
            Иначе
                Кнопка.АвтоМаксимальнаяШирина = Истина;
            КонецЕсли;
        КонецЕсли;

        УстановитьПоложение(Кнопка, Элемент.Положение);

    КонецЕсли;

    Стр = Форма.ПараметрыДействий.Добавить();
    Стр.ИмяКоманды     = Команда.Имя;
    Стр.ТипДействия    = Элемент.ТипДействия;
    Стр.Параметр       = Элемент.Параметр;
    Стр.ПараметрыФормы = Элемент.ПараметрыФормы;
    Стр.РежимОткрытия  = Элемент.РежимОткрытия;
    Стр.НомерСтроки    = Элемент.НомерСтроки;

    Возврат Истина;

КонецФункции

Функция ПрочитатьВариант(Вариант) Экспорт

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Вариант", Вариант);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Э.КодЭлемента КАК КодЭлемента,
    |    Э.КодРодителя КАК КодРодителя,
    |    Э.ТипЭлемента КАК ТипЭлемента,
    |    Э.ПоказыватьЗаголовок КАК ПоказыватьЗаголовок,
    |    Э.ЭлементовВСтроке КАК ЭлементовВСтроке,
    |    Э.Поведение КАК Поведение,
    |    Э.Положение КАК Положение,
    |    Э.Ширина КАК Ширина,
    |    Э.СНовойСтроки КАК СНовойСтроки,
    |    Э.Размер КАК Размер,
    |    Э.Действие КАК Действие,
    |    Э.НомерСтроки КАК НомерСтроки,
    |    ВЫБОР КОГДА Э.Заголовок <> """" ТОГДА Э.Заголовок
    |         ИНАЧЕ Э.Действие.Наименование КОНЕЦ КАК Заголовок,
    |    ВЫБОР КОГДА Э.ИмяКартинки <> """" ТОГДА Э.ИмяКартинки
    |         ИНАЧЕ Э.Действие.ИмяКартинки КОНЕЦ КАК ИмяКартинки,
    |    ВЫБОР КОГДА Э.ЦветПереопределение = ЗНАЧЕНИЕ(Перечисление.омг_ЦветовыеСхемыПлиток.ПустаяСсылка)
    |         ТОГДА Э.Действие.ЦветоваяСхемаПоУмолчанию
    |         ИНАЧЕ Э.ЦветПереопределение КОНЕЦ КАК Цвет,
    |    Э.Действие.Идентификатор       КАК Идентификатор,
    |    Э.Действие.ТипДействия         КАК ТипДействия,
    |    Э.Действие.ПараметрДействия    КАК Параметр,
    |    Э.Действие.ПроверяемыйОбъект   КАК ПроверяемыйОбъект,
    |    Э.Действие.ФункциональнаяОпция КАК ФункциональнаяОпция,
    |    Э.Действие.Описание            КАК Описание,
    |    Э.Действие.ПараметрыФормы      КАК ПараметрыФормы,
    |    Э.Действие.РежимОткрытия       КАК РежимОткрытия,
    |    Э.Действие.НеИспользуется      КАК ДействиеНеИспользуется
    |ИЗ Справочник.омг_ВариантыРабочихМест.Элементы КАК Э
    |ГДЕ Э.Ссылка = &Вариант
    |УПОРЯДОЧИТЬ ПО НомерСтроки";

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПлиткаДоступна(Плитка)

    Если НЕ ПустаяСтрока(Плитка.ФункциональнаяОпция) Тогда
        Попытка
            Если НЕ ПолучитьФункциональнуюОпцию(Плитка.ФункциональнаяОпция) Тогда
                Возврат Ложь;
            КонецЕсли;
        Исключение
            Возврат Ложь;
        КонецПопытки;
    КонецЕсли;

    Если НЕ ПустаяСтрока(Плитка.ПроверяемыйОбъект) Тогда
        Объект = Метаданные.НайтиПоПолномуИмени(Плитка.ПроверяемыйОбъект);
        Если Объект = Неопределено Тогда
            Возврат Ложь;
        КонецЕсли;
        Если НЕ ПравоДоступа("Просмотр", Объект) Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;

    Возврат Истина;

КонецФункции  

Функция КартинкаПлитки(ИмяКартинки)
     Если ПустаяСтрока(ИмяКартинки) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Метаданные.ОбщиеКартинки.Найти(ИмяКартинки) = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат БиблиотекаКартинок[ИмяКартинки];
КонецФункции

Функция ЦветПоСхеме(Схема)
    Схемы = Перечисления.омг_ЦветовыеСхемыПлиток;
    Если      Схема = Схемы.Успех      Тогда Возврат ЦветаСтиля.омг_ЦветПлиткиУспех;
    ИначеЕсли Схема = Схемы.Опасность  Тогда Возврат ЦветаСтиля.омг_ЦветПлиткиОпасность;
    ИначеЕсли Схема = Схемы.Внимание   Тогда Возврат ЦветаСтиля.омг_ЦветПлиткиВнимание;
    ИначеЕсли Схема = Схемы.Акцент     Тогда Возврат ЦветаСтиля.омг_ЦветПлиткиАкцент;
    ИначеЕсли Схема = Схемы.Информация Тогда Возврат ЦветаСтиля.омг_ЦветПлиткиИнформация;
    Иначе Возврат ЦветаСтиля.омг_ЦветПлиткиНейтральная;
    КонецЕсли;
КонецФункции


// Собирает данные для построения из несохранённого объекта.
Функция ДанныеВарианта(ОбъектВарианта) Экспорт

    Таблица = ОбъектВарианта.Элементы.Выгрузить();

    ДобавитьКолонки(Таблица, "НомерСтроки, Цвет, Идентификатор, ТипДействия, Параметр,
        |ПроверяемыйОбъект, ФункциональнаяОпция, Описание, ДействиеНеИспользуется,
        |ПараметрыФормы, РежимОткрытия");

    Сч = 0;
    Для Каждого Стр Из Таблица Цикл
        Сч = Сч + 1;
        Стр.НомерСтроки = Сч;
    КонецЦикла;

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Действия", Таблица.ВыгрузитьКолонку("Действие"));
    Запрос.Текст =
    "ВЫБРАТЬ Ссылка, Наименование, Идентификатор, ТипДействия, ПараметрДействия,
    |    ИмяКартинки, ЦветоваяСхемаПоУмолчанию, ПроверяемыйОбъект,
    |    ФункциональнаяОпция, Описание, НеИспользуется,
    |    ПараметрыФормы, РежимОткрытия
    |ИЗ Справочник.омг_ДействияРабочихМест
    |ГДЕ Ссылка В (&Действия)";

    Действия = Новый Соответствие;
    Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
        Данные = Новый Структура("Наименование, Идентификатор, ТипДействия, ПараметрДействия,
            |ИмяКартинки, ЦветоваяСхемаПоУмолчанию, ПроверяемыйОбъект,
            |ФункциональнаяОпция, Описание, НеИспользуется,
            |ПараметрыФормы, РежимОткрытия");
        ЗаполнитьЗначенияСвойств(Данные, Стр);
        Действия.Вставить(Стр.Ссылка, Данные);
    КонецЦикла;

    Для Каждого Стр Из Таблица Цикл
        Д = Действия.Получить(Стр.Действие);
        Если Д = Неопределено Тогда
            Стр.Цвет = Стр.ЦветПереопределение;
            Стр.ДействиеНеИспользуется = ЗначениеЗаполнено(Стр.Действие);
            Продолжить;
        КонецЕсли;
        Если ПустаяСтрока(Стр.Заголовок)   Тогда Стр.Заголовок   = Д.Наименование; КонецЕсли;
        Если ПустаяСтрока(Стр.ИмяКартинки) Тогда Стр.ИмяКартинки = Д.ИмяКартинки;  КонецЕсли;
        Стр.Цвет = ?(ЗначениеЗаполнено(Стр.ЦветПереопределение),
            Стр.ЦветПереопределение, Д.ЦветоваяСхемаПоУмолчанию);
        Стр.Идентификатор          = Д.Идентификатор;
        Стр.ТипДействия            = Д.ТипДействия;
        Стр.Параметр               = Д.ПараметрДействия;
        Стр.ПроверяемыйОбъект      = Д.ПроверяемыйОбъект;
        Стр.ФункциональнаяОпция    = Д.ФункциональнаяОпция;
        Стр.Описание               = Д.Описание;
        Стр.ПараметрыФормы = Д.ПараметрыФормы;
        Стр.РежимОткрытия  = Д.РежимОткрытия;
        Стр.ДействиеНеИспользуется = Д.НеИспользуется;
    КонецЦикла;

    Возврат Таблица;

КонецФункции

Процедура ДобавитьКолонки(Таблица, Имена)
    Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
        Имя = СокрЛП(СтрЗаменить(Имя, Символы.ПС, ""));
        Если НЕ ПустаяСтрока(Имя) И Таблица.Колонки.Найти(Имя) = Неопределено Тогда
            Таблица.Колонки.Добавить(Имя);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры



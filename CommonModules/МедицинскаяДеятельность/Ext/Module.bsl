	|ИЗ
	|	ВыполнениеПланаЛечения КАК ВыполнениеПланаЛечения";
	Запрос.УстановитьПараметр("Документ", ПервичныйПрием);
		
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаГруппыПлана = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	ВыборкаВыполнениеПлана = РезультатЗапроса[3].Выбрать();
	
	ГруппыПлана = СписокНазначений.ПолучитьЭлементы();
	ГруппыПлана.Очистить();
	
	ОтборВыполнения = Новый Структура("ИдентификаторЭлемента");
	Пока ВыборкаГруппыПлана.Следующий() Цикл 
		
		СтрокаГруппа = ГруппыПлана.Добавить();
		СтрокаГруппа.ЗубВКарте = ВыборкаГруппыПлана.ГруппаНазначений;
		СтрокаГруппа.Назначение = ВыборкаГруппыПлана.ГруппаНазначений;
		СтрокаГруппа.ИдентификаторНазначения = ВыборкаГруппыПлана.ГруппаНазначений.УникальныйИдентификатор();
		СтрокаГруппа.Сумма = ВыборкаГруппыПлана.Сумма;
		
		НазначенияГруппы = СтрокаГруппа.ПолучитьЭлементы();
		
		ВыборкаНазначения = ВыборкаГруппыПлана.Выбрать();
		Пока ВыборкаНазначения.Следующий() Цикл 
			
			СтрокаНазначение = НазначенияГруппы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНазначение, ВыборкаНазначения);
			Если Не ЗначениеЗаполнено(СтрокаНазначение.ЗубВКарте)
				И ЗначениеЗаполнено(ВыборкаНазначения.Конструкция)
			Тогда
				СтрокаНазначение.ЗубВКарте = ВыборкаНазначения.Конструкция;
			КонецЕсли;
			
			СтрокаНазначение.Цена = ?(СтрокаНазначение.Количество = 0, 0, СтрокаНазначение.Сумма / СтрокаНазначение.Количество);
			СтрокаНазначение.ДатаНачалаБезВремени = НачалоДня(СтрокаНазначение.Дата);
			
			ОтборВыполнения.ИдентификаторЭлемента = ВыборкаНазначения.ИдентификаторНазначения;
			ВыборкаВыполнениеПлана.Сбросить();
			Пока ВыборкаВыполнениеПлана.НайтиСледующий(ОтборВыполнения) Цикл
				СтрокаНазначение.ДокументВыполнения.Добавить(ВыборкаВыполнениеПлана.Регистратор);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры


// Формирование структуры сложных параметров (значения которых является строкой, которую заполняет пользователь)
// В ситуации, когда в тексте может быть вписанное пользователем значение, среди СтрокаВариантов могут быть "лишние" слова,
// Которые всегда вписываются вместе с получаемым произвольным значением (для того, чтобы их убрать при получении произвольного значения)
Функция ПолучитьСтруктуруСложныхПараметровФормыОртодонта()

	Результат = Новый Структура;
	
	// анамнез и жалобы
	Результат.Вставить("ВреднаяПривычкаИлиЗависимость",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Ложь,
						"предметов;пальцев;языка;верхней губы;нижней губы;да;нет"));
    Результат.Вставить("СтомВрожденныеАномалииЧЛОбласти",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Ложь,
						"родителей;других родственников;сестер;братьев;нет"));
	Результат.Вставить("СтомРанееОртодонтическоеЛечение",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,
						"Нет;несъемная;съемная;Вид аппаратуры:;лет;Длительность лечения"));

	// осмотр полоси рта
	// Конкретно у этого параметра (Стом форма зубных рядов) в свободном тексте находится ДВА параметра. В медкарте эти два значения
	// Есть отдельно в двух параметрах, заполняемых вручную (+ 1 параметр свободного текста)
	Результат.Вставить("СтомФормаЗубныхРядов",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,"в норме"));
	Результат.Вставить("СтомКонтактСоседнихЗубов",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Ложь,
						"верхний зубной ряд;нижний зубной ряд; левый верх; левый низ; центр низ;центр верх; правый низ; правый верх;в норме"));
	Результат.Вставить("СтомНарушениеПоследовательностиЗубов",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,"нет"));
    Результат.Вставить("СтомСимметричностьРасположенияЩубов",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,"сохранена;нарушена"));
	Результат.Вставить("СтомСагиттальнаяОкклюзияПередний",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,
						"в норме;обратная резцовая дизокклюзия;обратная резцовая окклюзия;сагиттальная резцовая дизокклюзия"));
	
	Результат.Вставить("СтомВертикальнаяОкклюзияПередний",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,
						("в норме;вертикальная резцовая дизокклюзия:;глубокая резцовая дизокклюзия; травмирующая окклюзия;прямая резцовая окклюзия"
						+"глубокая резцовая окклюзия;величина перекрытия: > 1/2;величина перекрытия: > 1/3;вертикальная щель (мм):")));
						
	Результат.Вставить("СтомТрансверсальнаяОкклюзияПередний",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,
						("в норме;смещение верхнего косметического центра влево;смещение верхнего косметического центра вправо;(мм):"
						+";смещение нижнего косметического центра вправо;смещение нижнего косметического центра влево")));
						
	Результат.Вставить("СтомТрансверсальнаяОкклюзияБоковой",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Ложь,
						("Вестибулокклюзия справа сверху;Вестибулокклюзия справа снизу;Вестибулокклюзия слева сверху;Вестибулокклюзия слева снизу"
						+";Лингвокклюзия справа;Лингвокклюзия слева;Палатокклюзия слева;Палатокклюзия справа;в норме")));

		
	// рентгенологическое исследование
	Результат.Вставить("СтомАссиметрияРазвитияЧелюстей",Новый Структура("ЕстьСвободныйТекст, СтрокаВариантов",Ложь,
						"височно-нижнечелюстных суставов (верхний);височно-нижнечелюстных суставов (нижний);тел челюстей (верхний);тел челюстей (нижний);нет"));
	Результат.Вставить("СтомВрожденаяРасщелина",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов", Ложь,"альвеолярного отростка;неба;нет"));
	Результат.Вставить("СтомДеструкцияКостнойТкани",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,"нет"));
    Результат.Вставить("СтомАтрофияКостныхПерегородок",Новый Структура("ЕстьСвободныйТекст,СтрокаВариантов",Истина,"нет"));

	Возврат Результат; 		
					     
КонецФункции


Функция ПечатьАмбулаторнойКарты0431у(Медкарта, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты, ИмяМакета = Неопределено)
	
	ТабДокумент = Новый ТабличныйДокумент;	
	Макет = Справочники.ВидыМедицинскихКарт.ПолучитьМакет(?(ИмяМакета = Неопределено, Медкарта.ВидКарты.Макет, ИмяМакета));
	Клиент = Медкарта.Клиент;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ЗаполнитьОбластьМедкартыПараметрами(ОбластьМакета, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты);
	
	ОбщегоНазначения.ЗаполнитьПараметрПосимвольно(ОбластьМакета, "ОГРН", ЗначенияПараметровМедкарты.ОГРН);
	ОбщегоНазначения.ЗаполнитьПараметрПосимвольно(ОбластьМакета, "СНИЛС", ЗначенияПараметровМедкарты.СНИЛС);
	
	// Диагноз
	Диагноз = Неопределено;
	ЗначенияВычисляемыхПараметровМедкарты.Свойство("Диагноз", Диагноз);
	Если ЗначениеЗаполнено(Диагноз) Тогда
		ОбластьМакета.Параметры.ДиагнозОсновной = Диагноз;
		Если ТипЗнч(Диагноз) = Тип("СправочникСсылка.Диагнозы") Тогда
			ОбластьМакета.Параметры.ДиагнозМКБ = Диагноз.КодДиагноза;
		КонецЕсли;
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	Возврат ТабДокумент;
	
КонецФункции


Функция ПечатьМедиционскойКартыСтационара003у(Медкарта, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты, ИмяМакета = Неопределено)
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = Справочники.ВидыМедицинскихКарт.ПолучитьМакет(?(ИмяМакета = Неопределено, Медкарта.ВидКарты.Макет, ИмяМакета));
	Клиент = Медкарта.Клиент;
	
	Для Каждого СтруктураПараметра Из ЗначенияВычисляемыхПараметровМедкарты Цикл
		Если ТипЗнч(СтруктураПараметра.Значение) = Тип("СправочникСсылка.Диагнозы") Тогда
			ПредставлениеДиагноза = СокрЛП(СтруктураПараметра.Значение.КодДиагноза + " " + СтруктураПараметра.Значение.НаименованиеПолное);
			ЗначенияВычисляемыхПараметровМедкарты.Вставить(СтруктураПараметра.Ключ, ПредставлениеДиагноза);
		КонецЕсли;
	КонецЦикла;
	
	ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");
	ЗаполнитьОбластьМедкартыПараметрами(ОбластьМакетаШапка, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты);
	
	// Штрихкод
	ДанныеШтрихкода = ПолучитьКартинкуШтрихкода(МедКарта);
	Если ДанныеШтрихкода <> Неопределено Тогда 
		Штрихкод = Новый Картинка(ДанныеШтрихкода);
		Рис = ОбластьМакетаШапка.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
		Индекс = ОбластьМакетаШапка.Рисунки.Индекс(Рис);
		ОбластьМакетаШапка.Рисунки[Индекс].Картинка = Штрихкод;
		ОбластьМакетаШапка.Рисунки[Индекс].РазмерКартинки = РазмерКартинки.Пропорционально;
		ОбластьМакетаШапка.Рисунки[Индекс].Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
		ОбластьМакетаШапка.Рисунки[Индекс].Расположить(ОбластьМакетаШапка.Область("Штрихкод"));
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьМакетаШапка);
	
	// Поиск документа Форма066
	ПараметрыОтбора = Новый Структура();
	ПараметрыОтбора.Вставить("МедицинскаяКарта",Медкарта);
	ПараметрыОтбора.Вставить("ПометкаУдаления",Ложь);
	ВыборкаФорма066 = Документы.Форма066.ПолучитьДанныеВыбора(Новый Структура("Отбор",ПараметрыОтбора));
	Если ВыборкаФорма066.Количество() > 0 Тогда
		ДокФорма066 = ВыборкаФорма066[ВыборкаФорма066.Количество() - 1].Значение;	
	КонецЕсли; 
	
	ДиагнозыОкончательныеМедкарты = ПолучитьДиагнозыПоМедкарте(Медкарта, Дата(1,1,1), Дата(2999,1,1));
	Если ДиагнозыОкончательныеМедкарты.Количество() > 0 Тогда
		Для Каждого СтрокаДиагноз Из ДиагнозыОкончательныеМедкарты Цикл
			ОбластьСтрокаКлиническийДиагноз = Макет.ПолучитьОбласть("СтрокаДиагнозКлинический");
			ОбластьСтрокаКлиническийДиагноз.Параметры.ДиагнозКлинический = Справочники.Диагнозы.ПредставлениеДиагнозаСКодом(СтрокаДиагноз.Диагноз);
			ОбластьСтрокаКлиническийДиагноз.Параметры.ДиагнозКлиническийДата = Формат(СтрокаДиагноз.ДатаУстановкиДиагноза,"ДФ='dd.MM.yyyy'");
			ТабДокумент.Вывести(ОбластьСтрокаКлиническийДиагноз);	
		КонецЦикла;
	Иначе
		ОбластьСтрокаКлиническийДиагноз = Макет.ПолучитьОбласть("СтрокаДиагнозКлинический");
		ОбластьСтрокаКлиническийДиагноз.Параметры.Заполнить(ЗначенияВычисляемыхПараметровМедкарты);
		ТабДокумент.Вывести(ОбластьСтрокаКлиническийДиагноз);
		ОбластьСтрокаКлиническийДиагноз = Макет.ПолучитьОбласть("СтрокаДиагнозКлинический");
		ТабДокумент.Вывести(ОбластьСтрокаКлиническийДиагноз);
		ТабДокумент.Вывести(ОбластьСтрокаКлиническийДиагноз);	
	КонецЕсли; 
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ОбластьМакетаЛист2_1 = Макет.ПолучитьОбласть("Лист2_1");
	ЗаполнитьОбластьМедкартыПараметрами(ОбластьМакетаЛист2_1, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты);
	
	// Заполнение заключительных диагнозов из формы 66, если она есть для медкарты.
	// Приоритет источников данных:
	//	1). Если есть документ Форма 66, то берутся данные из его табличной части
	//	2). Если заполнен параметр медкарты - берутся значения оттуда, без таблицы.
	//	3). Иначе пустые строки.
	Если ДокФорма066 <> Неопределено Тогда
		ОбластьМакетаЛист2_1.Параметры.ДиагнозЗаключительныйКлиническийОсновной		 = Справочники.Диагнозы.ПредставлениеДиагнозаСКодом(ДокФорма066.ДиагнозКлиническийЗаключительный);
		ОбластьМакетаЛист2_1.Параметры.ДиагнозЗаключительныйКлиническийОсложнения	 = Справочники.Диагнозы.ПредставлениеДиагнозаСКодом(ДокФорма066.Осложнение);
		ОбластьМакетаЛист2_1.Параметры.ДиагнозЗаключительныйКлиническийСопутствующий = Справочники.Диагнозы.ПредставлениеДиагнозаСКодом(ДокФорма066.СопутствующееЗаболевание);
	КонецЕсли; 	
	ТабДокумент.Вывести(ОбластьМакетаЛист2_1);
	
	// Заполнение хирургических операций
	Если ДокФорма066 <> Неопределено И ДокФорма066.ХирургическиеОперации.Количество() > 0 Тогда
		ОбластьХирургическиеОперацииШапка = Макет.ПолучитьОбласть("ХирургическиеОперацииШапка");
		ТабДокумент.Вывести(ОбластьХирургическиеОперацииШапка);
		
		НПП = 1;
		ОбластьХирургическиеОперации = Макет.ПолучитьОбласть("ХирургическиеОперацииСтрока");
		Для Каждого СтрокаХирургическаяОперация Из ДокФорма066.ХирургическиеОперации Цикл
			
			ОбластьХирургическиеОперации.Параметры.ХирургическаяОперацияДата = Формат(СтрокаХирургическаяОперация.ДатаОперации,"ДФ='dd.MM.yyyy HH:mm'");
			ОбластьХирургическиеОперации.Параметры.ХирургическаяОперацияНазвание = Строка(НПП) + ". " + Строка(СтрокаХирургическаяОперация.Операция);
			Если СтрокаХирургическаяОперация.Анестезия = "1" Тогда
				Анестезия = "Общая анестезия";
			ИначеЕсли СтрокаХирургическаяОперация.Анестезия = "2" Тогда 
				Анестезия = "Местная анестезия";
			Иначе
				Анестезия = "Нет";	
			КонецЕсли;
			
			ОбластьХирургическиеОперации.Параметры.ХирургическаяОперацияМетод = Анестезия;
			ОбластьХирургическиеОперации.Параметры.ХирургическаяОперацияОсложнения = СтрокаХирургическаяОперация.Осложнение;
			ТабДокумент.Вывести(ОбластьХирургическиеОперации);
			
			НПП = НПП + 1;
		КонецЦикла;
		
		ОбластьХирургическиеОперацииОперировал = Макет.ПолучитьОбласть("ХирургическиеОперацииОперировал");
		ТабДокумент.Вывести(ОбластьХирургическиеОперацииОперировал);
		
	ИначеЕсли ЗначенияВычисляемыхПараметровМедкарты.Свойство("ХирургическиеОперации")
			И ЗначениеЗаполнено(ЗначенияВычисляемыхПараметровМедкарты.ХирургическиеОперации)
	Тогда
		ОбластьХирургическиеОперации = Макет.ПолучитьОбласть("ХирургическиеОперацииПараметр");
		ОбластьХирургическиеОперации.Параметры.ХирургическаяОперация = ЗначенияВычисляемыхПараметровМедкарты.ХирургическиеОперации;
		ТабДокумент.Вывести(ОбластьХирургическиеОперации);
	Иначе
		ОбластьХирургическиеОперацииШапка = Макет.ПолучитьОбласть("ХирургическиеОперацииШапка");
		ТабДокумент.Вывести(ОбластьХирургическиеОперацииШапка);
		
		ОбластьХирургическиеОперации = Макет.ПолучитьОбласть("ХирургическиеОперацииСтрока");
		ТабДокумент.Вывести(ОбластьХирургическиеОперации);
		ТабДокумент.Вывести(ОбластьХирургическиеОперации);
		ТабДокумент.Вывести(ОбластьХирургическиеОперации);
		
		ОбластьХирургическиеОперацииОперировал = Макет.ПолучитьОбласть("ХирургическиеОперацииОперировал");
		ТабДокумент.Вывести(ОбластьХирургическиеОперацииОперировал);
	КонецЕсли; 
	
	ОбластьМакетаЛист2_2 = Макет.ПолучитьОбласть("Лист2_2");
	ЗаполнитьОбластьМедкартыПараметрами(ОбластьМакетаЛист2_2, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты);
	ТабДокумент.Вывести(ОбластьМакетаЛист2_2);

	// Выбор документов ЛистокНетрудоспособности
	ПараметрыОтбора = Новый Структура();
	ПараметрыОтбора.Вставить("МедицинскаяКарта",Медкарта);
	ПараметрыОтбора.Вставить("ПометкаУдаления",Ложь);
	ВыборкаЛН = Документы.ЛистокНетрудоспособности.ПолучитьДанныеВыбора(Новый Структура("Отбор",ПараметрыОтбора));
	// Заполнение листов нетрудоспособности
	СчЛН = 0;
	Для каждого СтрокаЛН Из ВыборкаЛН Цикл
		СчЛН = СчЛН + 1;
		ДокЛН = СтрокаЛН.Значение;
		Если СчЛН%2 = 1 Тогда
			ОбластьСтрокаЛН = Макет.ПолучитьОбласть("СтрокаЛистНетрудоспособности");
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособности1Номер = ДокЛН.Номер;
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособности1С = Формат(ДокЛН.Запись1ДатаНачала,"ДЛФ=D");
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособности1по = Формат(ДокЛН.ДатаЗакрытия,"ДЛФ=D");
		Иначе
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособности2Номер = ДокЛН.Номер;
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособности2С = Формат(ДокЛН.Запись1ДатаНачала,"ДЛФ=D");
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособности2по = Формат(ДокЛН.ДатаЗакрытия,"ДЛФ=D");	
			ТабДокумент.Вывести(ОбластьСтрокаЛН);
		КонецЕсли;
	КонецЦикла; 
	Если СчЛН%2 = 1 Тогда
		ТабДокумент.Вывести(ОбластьСтрокаЛН);
	КонецЕсли;
	
	Если СчЛН = 0 Тогда	
		Если ДокФорма066 <> Неопределено Тогда
			ОбластьСтрокаЛН = Макет.ПолучитьОбласть("СтрокаЛистНетрудоспособности");
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособности1С = Формат(ДокФорма066.ДатаОткрытияЛисткаНетрудоспособности,"ДЛФ=D");
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособности1по = Формат(ДокФорма066.ДатаЗакрытияЛисткаНетрудоспособности,"ДЛФ=D");
			ТабДокумент.Вывести(ОбластьСтрокаЛН);    
		ИначеЕсли ЗначенияВычисляемыхПараметровМедкарты.Свойство(ЗначенияВычисляемыхПараметровМедкарты, "ЛисткиНетрудоспособности")
				И ЗначениеЗаполнено(ЗначенияВычисляемыхПараметровМедкарты.ЛисткиНетрудоспособности)
		Тогда
			ОбластьСтрокаЛН = Макет.ПолучитьОбласть("ЛистНетрудоспособностиПараметр");
			ОбластьСтрокаЛН.Параметры.ЛистНетрудоспособностиПараметр = ЗначенияВычисляемыхПараметровМедкарты.ЛисткиНетрудоспособности;
			ТабДокумент.Вывести(ОбластьСтрокаЛН);	
		Иначе
			ОбластьСтрокаЛН = Макет.ПолучитьОбласть("СтрокаЛистНетрудоспособности");
			ТабДокумент.Вывести(ОбластьСтрокаЛН);
			ТабДокумент.Вывести(ОбластьСтрокаЛН);
		КонецЕсли; 	
	КонецЕсли;  	
	
	ОбластьМакетаЛист2_3 = Макет.ПолучитьОбласть("Лист2_3");
	ЗаполнитьОбластьМедкартыПараметрами(ОбластьМакетаЛист2_3, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты);
	ТабДокумент.Вывести(ОбластьМакетаЛист2_3);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьИндивидуальнойКартыБеременной111у(Медкарта, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты, ИмяМакета = Неопределено)
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = Справочники.ВидыМедицинскихКарт.ПолучитьМакет(?(ИмяМакета = Неопределено, Медкарта.ВидКарты.Макет, ИмяМакета));
	Клиент = Медкарта.Клиент;
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтраницаШапка");
	ЗаполнитьОбластьМедкартыПараметрами(ОбластьМакета, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты);
	ТабДокумент.Вывести(ОбластьМакета);
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Страница2Шапка");
	ЗаполнитьОбластьМедкартыПараметрами(ОбластьМакета, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты);
	ТабДокумент.Вывести(ОбластьМакета);
	
	//ОбластьМакета = Макет.ПолучитьОбласть("ПредыдущаяБеременность");
	//ДанныеТаблицШаблоновПриема = Печать111у_ПолучитьДанныеТаблицШаблоновПриема(Медкарта);
	//Печать111у_ЗаполнитьИсходыПредыдущихБеременностей(ОбластьМакета, ТабДокумент, ДанныеТаблицШаблоновПриема);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Страница2Подвал");
	ЗаполнитьОбластьМедкартыПараметрами(ОбластьМакета, ЗначенияПараметровМедкарты, ЗначенияВычисляемыхПараметровМедкарты);
	ТабДокумент.Вывести(ОбластьМакета);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция Печать111у_ПолучитьДанныеТаблицШаблоновПриема(Медкарта)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыМедицинскихКартЗаполняемыеПараметры.Ссылка КАК ВидМедкарты,
	|	ВидыМедицинскихКартЗаполняемыеПараметры.ИмяПараметра КАК Параметр,
	|	ВидыМедицинскихКартЗаполняемыеПараметры.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	ВидыМедицинскихКартЗаполняемыеПараметры.ИмяПараметра.ПараметрШаблонаОсмотра КАК ПараметрШаблонаОсмотра,
	|	ВидыМедицинскихКартЗаполняемыеПараметры.ИмяПараметра.ИспользуетсяПервоеЗначениеПараметраШаблона КАК ИспользуетсяПервоеЗначениеПараметраШаблона
	|ПОМЕСТИТЬ ПараметрыВидаМедкарты
	|ИЗ
	|	Справочник.ВидыМедицинскихКарт.ЗаполняемыеПараметры КАК ВидыМедицинскихКартЗаполняемыеПараметры
	|ГДЕ
	|	ВидыМедицинскихКартЗаполняемыеПараметры.Ссылка = &ВидМедкарты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыВидаМедкарты.ВидМедкарты КАК ВидМедкарты,
	|	ПараметрыВидаМедкарты.Параметр КАК Параметр,
	|	ПараметрыВидаМедкарты.ПараметрШаблонаОсмотра КАК ПараметрШаблонаОсмотра,
	|	ПараметрыВидаМедкарты.ИспользуетсяПервоеЗначениеПараметраШаблона КАК ИспользуетсяПервоеЗначениеПараметраШаблона
	|ПОМЕСТИТЬ ПараметрыПолучаемыеИзПриемов
	|ИЗ
	|	ПараметрыВидаМедкарты КАК ПараметрыВидаМедкарты
	|ГДЕ
	|	ПараметрыВидаМедкарты.ПараметрШаблонаОсмотра <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыHTML.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеТаблицШаблоновПриема.Параметр КАК Параметр,
	|	ДанныеТаблицШаблоновПриема.Значение КАК Значение,
	|	ДанныеТаблицШаблоновПриема.Документ.Дата КАК Дата,
	|	ДанныеТаблицШаблоновПриема.НомерСтрокиТаблицы КАК НомерСтрокиТаблицы
	|ПОМЕСТИТЬ ПараметрыТаблицШаблоновПриемов
	|ИЗ
	|	РегистрСведений.ДанныеТаблицШаблоновПриема КАК ДанныеТаблицШаблоновПриема
	|ГДЕ
	|	ДанныеТаблицШаблоновПриема.Документ.МедицинскаяКарта = &МедицинскаяКарта
	|	И ДанныеТаблицШаблоновПриема.Документ.Проведен
	|	И ДанныеТаблицШаблоновПриема.Параметр В
	|			(ВЫБРАТЬ
	|				ПараметрыПолучаемыеИзПриемов.ПараметрШаблонаОсмотра
	|			ИЗ
	|				ПараметрыПолучаемыеИзПриемов КАК ПараметрыПолучаемыеИзПриемов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыТаблицШаблоновПриемов.Параметр КАК Параметр,
	|	ПараметрыТаблицШаблоновПриемов.Значение КАК Значение,
	|	ПараметрыТаблицШаблоновПриемов.НомерСтрокиТаблицы КАК НомерСтрокиТаблицы,
	|	ЛОЖЬ КАК ПервоеЗначение
	|ПОМЕСТИТЬ ЗначенияПараметровТаблицШаблоновПриемов
	|ИЗ
	|	ПараметрыТаблицШаблоновПриемов КАК ПараметрыТаблицШаблоновПриемов
	|ГДЕ
	|	ПараметрыТаблицШаблоновПриемов.Дата В
	|			(ВЫБРАТЬ
	|				МАКСИМУМ(ПараметрыТаблицШаблоновПриемовМаксимум.Дата) КАК Дата
	|			ИЗ
	|				ПараметрыТаблицШаблоновПриемов КАК ПараметрыТаблицШаблоновПриемовМаксимум
	|			ГДЕ
	|				ПараметрыТаблицШаблоновПриемовМаксимум.Параметр = ПараметрыТаблицШаблоновПриемов.Параметр)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПараметрыТаблицШаблоновПриемов.Параметр,
	|	ПараметрыТаблицШаблоновПриемов.Значение,
	|	ПараметрыТаблицШаблоновПриемов.НомерСтрокиТаблицы,
	|	ИСТИНА
	|ИЗ
	|	ПараметрыТаблицШаблоновПриемов КАК ПараметрыТаблицШаблоновПриемов
	|ГДЕ
	|	ПараметрыТаблицШаблоновПриемов.Дата В
	|			(ВЫБРАТЬ
	|				МИНИМУМ(ПараметрыТаблицШаблоновПриемовМинимум.Дата) КАК Дата
	|			ИЗ
	|				ПараметрыТаблицШаблоновПриемов КАК ПараметрыТаблицШаблоновПриемовМинимум
	|			ГДЕ
	|				ПараметрыТаблицШаблоновПриемовМинимум.Параметр = ПараметрыТаблицШаблоновПриемов.Параметр)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияПараметровТаблицШаблоновПриемов.НомерСтрокиТаблицы КАК НомерСтрокиТаблицы,
	|	ПараметрыВидаМедкарты.Параметр КАК Параметр,
	|	ЗначенияПараметровТаблицШаблоновПриемов.Значение КАК ЗначениеИзПриема,
	|	ПараметрыВидаМедкарты.ПараметрШаблонаОсмотра КАК ПараметрШаблонаОсмотра
	|ИЗ
	|	ПараметрыВидаМедкарты КАК ПараметрыВидаМедкарты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗначенияПараметровТаблицШаблоновПриемов КАК ЗначенияПараметровТаблицШаблоновПриемов
	|		ПО ПараметрыВидаМедкарты.ПараметрШаблонаОсмотра = ЗначенияПараметровТаблицШаблоновПриемов.Параметр
	|			И ПараметрыВидаМедкарты.ИспользуетсяПервоеЗначениеПараметраШаблона = ЗначенияПараметровТаблицШаблоновПриемов.ПервоеЗначение
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтрокиТаблицы";
	
	Запрос.Параметры.Вставить("МедицинскаяКарта", Медкарта);
	Запрос.Параметры.Вставить("ВидМедкарты", Медкарта.ВидКарты);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	НомерСтроки = Неопределено;
	СтруктураПараметровСтроки = Новый Структура;
	ПараметрыСтрок = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Если НомерСтроки <> Выборка.НомерСтрокиТаблицы Тогда
			Если ЗначениеЗаполнено(СтруктураПараметровСтроки) Тогда
				СтруктураПараметровСтроки.Вставить("ПредБеременностьНомер", НомерСтроки);
				ПараметрыСтрок.Добавить(СтруктураПараметровСтроки);
			КонецЕсли;
			НомерСтроки = Выборка.НомерСтрокиТаблицы;
			СтруктураПараметровСтроки = Новый Структура;
		КонецЕсли;
		Значение = Выборка.ЗначениеИзПриема;
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Значение = Формат(Значение, "БЛ=; БИ=✓");
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			Значение = Формат(Значение, "ДФ=yyyy");
		КонецЕсли;
		СтруктураПараметровСтроки.Вставить(Выборка.Параметр.Наименование, Значение);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтруктураПараметровСтроки) Тогда
		СтруктураПараметровСтроки.Вставить("ПредБеременностьНомер", НомерСтроки);
		ПараметрыСтрок.Добавить(СтруктураПараметровСтроки);
	КонецЕсли;
	
	Результат2 = Запрос.Выполнить().Выгрузить();
	ПараметрыСтрок2 = Новый Массив;
	НомераСтрокТаблицы = Результат2.Скопировать();
	НомераСтрокТаблицы.Свернуть("НомерСтрокиТаблицы");
	НомераСтрок = НомераСтрокТаблицы.ВыгрузитьКолонку("НомерСтрокиТаблицы");
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(НомераСтрок);
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	НомераСтрок = Список.ВыгрузитьЗначения();
	
	Для Каждого НомерСтроки2 Из НомераСтрок Цикл
		ПараметрыСтроки = Результат2.НайтиСтроки(Новый Структура("НомерСтрокиТаблицы", НомерСтроки2));
		СтруктураПараметровСтроки2 = Новый Структура;
		Для Каждого ПараметрСтроки Из ПараметрыСтроки Цикл
			Значение2 = ПараметрСтроки.ЗначениеИзПриема;
			Если ТипЗнч(Значение2) = Тип("Булево") Тогда
				Значение2 = Формат(Значение2, "БЛ=; БИ=✓");
			ИначеЕсли ТипЗнч(Значение2) = Тип("Дата") Тогда
				Значение2 = Формат(Значение2, "ДФ=yyyy");
			КонецЕсли;
			СтруктураПараметровСтроки2.Вставить(ПараметрСтроки.Параметр.Наименование, Значение2);
		КонецЦикла;
		Если ЗначениеЗаполнено(СтруктураПараметровСтроки2) Тогда
			СтруктураПараметровСтроки2.Вставить("ПредБеременностьНомер", НомерСтроки2);
			ПараметрыСтрок2.Добавить(СтруктураПараметровСтроки2);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПараметрыСтрок;
	
КонецФункции

Процедура Печать111у_ЗаполнитьИсходыПредыдущихБеременностей(ОбластьМакета, ТабДокумент, ДанныеТаблицШаблоновПриема)
	
	Если ДанныеТаблицШаблоновПриема.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицы Из ДанныеТаблицШаблоновПриема Цикл
			ОбластьМакета.Параметры.Заполнить(СтрокаТаблицы);
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЦикла;
	Иначе
		Для Сч = 1 По 4 Цикл
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

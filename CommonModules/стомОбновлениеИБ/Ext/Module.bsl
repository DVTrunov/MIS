Процедура Стоматология_ОбновитьСегментыЗубныхКарт_29_1() Экспорт
	
	// Загрузка новой зубной карты
	ОбщегоНазначенияСервер.ВыполнитьЗагрузкуУниверсальнымОбменомXML(Справочники.стомВидыЗубныхКарт.ПолучитьМакет("СтандартныеЗубныеКарты"), Истина);
	
	// Обновление сегментов в документах
	
	// 1. Кеши данных для подмены
	
	// Кеш зубы карты
	ЗубыВКарте = Новый Соответствие;
	Выб = Справочники.стомЗубыКарты.Выбрать();
	Пока Выб.Следующий() Цикл
		Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Выб.Наименование) Тогда
			Попытка
				НомерЗубаЧисло = (Число(Выб.Наименование))% 10;
			Исключение
				НомерЗубаЧисло = Неопределено;
			КонецПопытки;
			
			Попытка
				ЧастьЧелюсти = Цел(Число(Выб.Наименование)/10);
			Исключение КонецПопытки;
			
			Если НомерЗубаЧисло <> Неопределено Тогда
				ЗубыВКарте.Вставить(Выб.Ссылка, Новый Структура("Наименование, Зуб, НомерЗуба, ЧастьЧелюсти", Выб.Наименование, Выб.Зуб, НомерЗубаЧисло, ЧастьЧелюсти));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Кеш Сегменты зубов
	НаименованияЗаменяемыхОбщихСегментов = ОбщегоНазначенияКлиентСервер.НовыйМассив("Вестибулярная поверхность", "Окклюзионная поверхность", "Оральная поверхность");
	ЗаменяемыеСегменты	  = Новый Массив;
	НаименованияСегментов = Новый Соответствие;
	Выб = Справочники.стомСегментыЗубов.Выбрать();
	Пока Выб.Следующий() Цикл
		НаименованияСегментов.Вставить(Выб.Ссылка, Выб.Наименование);
		
		Если ТипЗнч(Выб.Владелец) = Тип("СправочникСсылка.стомВидыЗубныхКарт")
			И НаименованияЗаменяемыхОбщихСегментов.Найти(Выб.Наименование) <> Неопределено
		Тогда
			ЗаменяемыеСегменты.Добавить(Выб.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	// Получить все новые поверхности по зубам, на которые заменяем старые
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	стомСегментыЗубов.Владелец КАК Владелец,
	|	стомСегментыЗубов.Наименование КАК Наименование,
	|	стомСегментыЗубов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.стомСегментыЗубов КАК стомСегментыЗубов
	|ГДЕ
	|	(стомСегментыЗубов.Сегмент.Наименование = ""ПоверхностьКрай""
	|			ИЛИ стомСегментыЗубов.Сегмент.Наименование = ""ПоверхностьЦентр"")
	|	И НЕ стомСегментыЗубов.ПометкаУдаления
	|	И стомСегментыЗубов.Владелец ССЫЛКА Справочник.стомВидыЗубов";
	
	// Сохраняем поверхности в таблице для дальнейшего поиска по ней
	ТаблицаНовыхПоверхностейПоЗубам = Запрос.Выполнить().Выгрузить();
	
	// Таблица правил замены сегментов
	ТаблицаСоответствийЗамены = Новый ТаблицаЗначений;
	ТаблицаСоответствийЗамены.Колонки.Добавить("ЗубВКарте");
	ТаблицаСоответствийЗамены.Колонки.Добавить("ЗаменяемыйСегмент");
	ТаблицаСоответствийЗамены.Колонки.Добавить("НовыйСегмент");
	Для Каждого кзЗубВКарте Из ЗубыВКарте Цикл
		Для Каждого ЗаменяемыйСегмент Из ЗаменяемыеСегменты Цикл
			
			Зуб = кзЗубВКарте.Значение.Зуб;
			НомерЗубаТекСтроки	 = кзЗубВКарте.Значение.НомерЗуба;
			ЧастьЧелюсти		 = кзЗубВКарте.Значение.ЧастьЧелюсти;
			НаименованиеВстроенногоНовогоСегмента = "";
			
			// Если это старый сегмент под замену, то проверяем на каком он зубе и получаем ссылку на нужную замену
			//(обработка работает один раз, поэтому Вестибулярная поверхность всегда будет старой).
			ИмяСегментаЗубаТекСтроки = НаименованияСегментов.Получить(ЗаменяемыйСегмент);
			
			Если ИмяСегментаЗубаТекСтроки = "Вестибулярная поверхность" Тогда
				
				// Это вестибулярная поверхность
				// вестибулярная поверхность - 11-13, 21-23, 31-33, 41-43; щечная поверхность 14-18, 24-28, 34-38, 44-48.
				Если НомерЗубаТекСтроки < 4 Тогда
					НаименованиеВстроенногоНовогоСегмента = "Вестибулярная поверхность";
				Иначе
					НаименованиеВстроенногоНовогоСегмента = "Щечная поверхность";
				КонецЕсли;
				
			ИначеЕсли ИмяСегментаЗубаТекСтроки = "Окклюзионная поверхность" Тогда
				
				// Это Окклюзионная поверхность - центр
				// Режущи край - 11-13, 21-23, 31-33, 41-43; Жевательная поверхность 14-18, 24-28, 34-38, 44-48
				Если НомерЗубаТекСтроки < 4 Тогда
					НаименованиеВстроенногоНовогоСегмента = "Режущий край";
				Иначе
					НаименованиеВстроенногоНовогоСегмента = "Жевательная поверхность";
				КонецЕсли;
				
			ИначеЕсли ИмяСегментаЗубаТекСтроки = "Оральная поверхность" Тогда
				
				// Это Оральная поверхность
				// небная поверхность - 11-18, 21-28; язычная поверхность 31-38, 41-48
				Если ЧастьЧелюсти < 3 Тогда
					НаименованиеВстроенногоНовогоСегмента = "Небная поверхность";
				Иначе
					НаименованиеВстроенногоНовогоСегмента = "Язычная поверхность";
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ПустаяСтрока(НаименованиеВстроенногоНовогоСегмента) Тогда
				СтрокаЗамены = ТаблицаСоответствийЗамены.Добавить();
				СтрокаЗамены.ЗубВКарте			 = кзЗубВКарте.Ключ;
				СтрокаЗамены.ЗаменяемыйСегмент	 = ЗаменяемыйСегмент;
				СтрокаЗамены.НовыйСегмент		 = ТаблицаНовыхПоверхностейПоЗубам.НайтиСтроки(Новый Структура("Владелец, Наименование", Зуб, НаименованиеВстроенногоНовогоСегмента))[0].Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ОтборПравилаЗамены = Новый Структура("ЗубВКарте, ЗаменяемыйСегмент");
	
 	// 2. Регистр состояний зубов и его приемы
	
	// Собственно выбор данных и подмена.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаменяемыеСегменты", ЗаменяемыеСегменты);
	
	// Перебор большого регистра состояний зубов
	Для СчИтераций = 1 По 25000 Цикл
		
		НачатьТранзакцию();
		
		// Запрос по 
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
			|	стомСостоянияЗубов.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ Регистраторы
			|ИЗ
			|	РегистрСведений.стомСостоянияЗубов КАК стомСостоянияЗубов
			|ГДЕ
			|	стомСостоянияЗубов.СегментВЗубе В(&ЗаменяемыеСегменты)
			|	И ТИПЗНАЧЕНИЯ(стомСостоянияЗубов.Регистратор) = ТИП(Документ.Прием)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	стомСостоянияЗубов.Период КАК Период,
			|	стомСостоянияЗубов.Регистратор КАК Регистратор,
			|	стомСостоянияЗубов.НомерСтроки КАК НомерСтроки,
			|	стомСостоянияЗубов.Активность КАК Активность,
			|	стомСостоянияЗубов.Клиент КАК Клиент,
			|	стомСостоянияЗубов.ЗубнаяКарта КАК ЗубнаяКарта,
			|	стомСостоянияЗубов.ЗубВКарте КАК ЗубВКарте,
			|	стомСостоянияЗубов.СегментВЗубе КАК СегментВЗубе,
			|	стомСостоянияЗубов.СостояниеСегмента КАК СостояниеСегмента,
			|	стомСостоянияЗубов.ЗубИдентификатор КАК ЗубИдентификатор,
			|	стомСостоянияЗубов.СегментИдентификатор КАК СегментИдентификатор,
			|	стомСостоянияЗубов.ВидРедактирования КАК ВидРедактирования
			|ИЗ
			|	РегистрСведений.стомСостоянияЗубов КАК стомСостоянияЗубов
			|ГДЕ
			|	стомСостоянияЗубов.Регистратор В
			|			(ВЫБРАТЬ
			|				Регистраторы.Регистратор
			|			ИЗ
			|				Регистраторы)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Регистраторы.Регистратор КАК Регистратор
			|ИЗ
			|	Регистраторы КАК Регистраторы";
			
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		// Если нечего перезаписывать - прекращаем работу
		Если РезультатыЗапроса[1].Пустой() Тогда
			Прервать;
		КонецЕсли;	
		
		ТаблицаРегистраСостоянийСегментовЗубов = РезультатыЗапроса[1].Выгрузить();
		ТаблицаРегистраСостоянийСегментовЗубов.Индексы.Добавить("Регистратор");
		
		ДокументыРегистраторы = РезультатыЗапроса[2].Выгрузить().ВыгрузитьКолонку("Регистратор");
		
		// Проходимся по всей таблице регистра состояний зубов
		// Заменяем нужные строки и замещаем все записи в регистре
		Для Каждого Регистратор Из ДокументыРегистраторы Цикл
			
			ДвиженияРегистратора = ТаблицаРегистраСостоянийСегментовЗубов.НайтиСтроки(Новый Структура("Регистратор", Регистратор));
			
			НаборЗамещающихЗаписей = РегистрыСведений.стомСостоянияЗубов.СоздатьНаборЗаписей();
			НаборЗамещающихЗаписей.Отбор.Регистратор.Установить(Регистратор);
			
			Для Каждого СтрокаВыгрузки Из ДвиженияРегистратора Цикл
				
				Если ЗубыВКарте.Получить(СтрокаВыгрузки.ЗубВКарте) <> Неопределено
					И ЗначениеЗаполнено(СтрокаВыгрузки.СегментВЗубе)
				Тогда
					
					ОтборПравилаЗамены.ЗубВКарте = СтрокаВыгрузки.ЗубВКарте;
					ОтборПравилаЗамены.ЗаменяемыйСегмент = СтрокаВыгрузки.СегментВЗубе;
					
					ПравилаЗамены = ТаблицаСоответствийЗамены.НайтиСтроки(ОтборПравилаЗамены);
					Если ПравилаЗамены.Количество() <> 0 Тогда
						НовыйСегмент = ПравилаЗамены[0].НовыйСегмент;
						СтрокаВыгрузки.СегментВЗубе = НовыйСегмент;
						СтрокаВыгрузки.СегментИдентификатор = НовыйСегмент.УникальныйИдентификатор(); 
					КонецЕсли;
				КонецЕсли;
				
				НоваяЗамещающаяЗапись = НаборЗамещающихЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗамещающаяЗапись, СтрокаВыгрузки,,"СегментИдентификатор");
				
			КонецЦикла;	// Цикл по строке движения.
			
			НаборЗамещающихЗаписей.Записать();
			
			// Замена в таб.части документа
			ПриемОбъект = Регистратор.ПолучитьОбъект();
			Если Ложь Тогда ПриемОбъект = Документы.Прием.СоздатьДокумент() КонецЕсли;
			
			// Исправление таблицы состояний в приёме
			Для Каждого СтрокаТЧ Из ПриемОбъект.стомУстановленныеСостояния Цикл
				Если ЗаменяемыеСегменты.Найти(СтрокаТЧ.СегментВЗубе) <> Неопределено Тогда
					ОтборПравилаЗамены.ЗубВКарте = СтрокаТЧ.ЗубВКарте;
					ОтборПравилаЗамены.ЗаменяемыйСегмент = СтрокаТЧ.СегментВЗубе;
					ПравилаЗамены = ТаблицаСоответствийЗамены.НайтиСтроки(ОтборПравилаЗамены);
					Если ПравилаЗамены.Количество() <> 0 Тогда
						НовыйСегмент = ПравилаЗамены[0].НовыйСегмент;
					КонецЕсли;
					
					СтрокаТЧ.СегментВЗубе = НовыйСегмент;
				КонецЕсли;
			КонецЦикла;
						
			// Исправление таблицы Работ (оказанные услуги) в приёме
			Для каждого СтрокаТЧ Из ПриемОбъект.Работы Цикл
				Если ЗаменяемыеСегменты.Найти(СтрокаТЧ.СегментВЗубе) <> Неопределено Тогда
					ОтборПравилаЗамены.ЗубВКарте = СтрокаТЧ.ЗубВКарте;
					ОтборПравилаЗамены.ЗаменяемыйСегмент = СтрокаТЧ.СегментВЗубе;
					ПравилаЗамены = ТаблицаСоответствийЗамены.НайтиСтроки(ОтборПравилаЗамены);
					Если ПравилаЗамены.Количество() <> 0 Тогда
						НовыйСегмент = ПравилаЗамены[0].НовыйСегмент;
					КонецЕсли;
					
					СтрокаТЧ.СегментВЗубе = НовыйСегмент;
				КонецЕсли;	
			КонецЦикла;
			
			// Исправление таблицы Диагнозы в приёме
			Для каждого СтрокаТЧ Из ПриемОбъект.Диагнозы Цикл
				Если ЗаменяемыеСегменты.Найти(СтрокаТЧ.СегментВЗубе) <> Неопределено Тогда
					ОтборПравилаЗамены.ЗубВКарте = СтрокаТЧ.ЗубВКарте;
					ОтборПравилаЗамены.ЗаменяемыйСегмент = СтрокаТЧ.СегментВЗубе;
					ПравилаЗамены = ТаблицаСоответствийЗамены.НайтиСтроки(ОтборПравилаЗамены);
					Если ПравилаЗамены.Количество() <> 0 Тогда
						НовыйСегмент = ПравилаЗамены[0].НовыйСегмент;
					КонецЕсли;
					
					СтрокаТЧ.СегментВЗубе = НовыйСегмент;
				КонецЕсли;
			КонецЦикла;
			
			ПриемОбъект.ОбменДанными.Загрузка = Истина;
			ПриемОбъект.ДополнительныеСвойства.Вставить("НеДелатьПроверокПриЗаписи");
			ПриемОбъект.Записать();
			
		КонецЦикла; // Цикл по регистратору.
		
		ЗафиксироватьТранзакцию();
	КонецЦикла; // Цикл транзакций.
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	// 3. Оставшиеся приемы
	
	// Обход документов, которые были пропущены при обходе регистра состояний зубов
	// Стоит сразу после для того, чтоб выкинуть из запроса приемы из ДокументыРегистраторы (заполнен по регистру состояний зубов)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Прием.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Прием КАК Прием
	|ГДЕ
	|	Прием.Работы.СегментВЗубе В (&ЗаменяемыеСегменты)
	|			ИЛИ Прием.Диагнозы.СегментВЗубе В (&ЗаменяемыеСегменты)
	|			ИЛИ Прием.стомУстановленныеСостояния.СегментВЗубе В (&ЗаменяемыеСегменты)"
	;
	Запрос.УстановитьПараметр("ЗаменяемыеСегменты",ЗаменяемыеСегменты);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Данные для отслеживания транзакций
	сч = 0;
	ОперацийВТранзакции = 500;
	
	//Обходим выборку оставшихся приёмов
	НачатьТранзакцию();
	Пока Выборка.Следующий() Цикл
		
		ПриемОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Ложь Тогда ПриемОбъект = Документы.Прием.СоздатьДокумент() КонецЕсли;
		
		// Исправление таблицы состояний в приёме
		Для Каждого СтрокаТЧ Из ПриемОбъект.стомУстановленныеСостояния Цикл
			Если ЗаменяемыеСегменты.Найти(СтрокаТЧ.СегментВЗубе) <> Неопределено Тогда
				ОтборПравилаЗамены.ЗубВКарте = СтрокаТЧ.ЗубВКарте;
				ОтборПравилаЗамены.ЗаменяемыйСегмент = СтрокаТЧ.СегментВЗубе;
				ПравилаЗамены = ТаблицаСоответствийЗамены.НайтиСтроки(ОтборПравилаЗамены);
				Если ПравилаЗамены.Количество() <> 0 Тогда
					НовыйСегмент = ПравилаЗамены[0].НовыйСегмент;
				КонецЕсли;
				
				СтрокаТЧ.СегментВЗубе = НовыйСегмент;
			КонецЕсли;
		КонецЦикла;
		
		// Исправление таблицы Работ (оказанные услуги) в приёме
		Для каждого СтрокаТЧ Из ПриемОбъект.Работы Цикл
			Если ЗаменяемыеСегменты.Найти(СтрокаТЧ.СегментВЗубе) <> Неопределено Тогда
				ОтборПравилаЗамены.ЗубВКарте = СтрокаТЧ.ЗубВКарте;
				ОтборПравилаЗамены.ЗаменяемыйСегмент = СтрокаТЧ.СегментВЗубе;
				ПравилаЗамены = ТаблицаСоответствийЗамены.НайтиСтроки(ОтборПравилаЗамены);
				Если ПравилаЗамены.Количество() <> 0 Тогда
					НовыйСегмент = ПравилаЗамены[0].НовыйСегмент;
				КонецЕсли;
				
				СтрокаТЧ.СегментВЗубе = НовыйСегмент;
			КонецЕсли;	
		КонецЦикла;
		
		// Исправление таблицы Диагнозы в приёме
		Для каждого СтрокаТЧ Из ПриемОбъект.Диагнозы Цикл
			Если ЗаменяемыеСегменты.Найти(СтрокаТЧ.СегментВЗубе) <> Неопределено Тогда
				ОтборПравилаЗамены.ЗубВКарте = СтрокаТЧ.ЗубВКарте;
				ОтборПравилаЗамены.ЗаменяемыйСегмент = СтрокаТЧ.СегментВЗубе;
				ПравилаЗамены = ТаблицаСоответствийЗамены.НайтиСтроки(ОтборПравилаЗамены);
				Если ПравилаЗамены.Количество() <> 0 Тогда
					НовыйСегмент = ПравилаЗамены[0].НовыйСегмент;
				КонецЕсли;
				
				СтрокаТЧ.СегментВЗубе = НовыйСегмент;
			КонецЕсли;
		КонецЦикла;
		
		ПриемОбъект.ОбменДанными.Загрузка = Истина;
		ПриемОбъект.ДополнительныеСвойства.Вставить("НеДелатьПроверокПриЗаписи");
		ПриемОбъект.Записать();
		
		Если сч = ОперацийВТранзакции Тогда
			сч = 0;
			ЗафиксироватьТранзакцию();
			НачатьТранзакцию();
		Иначе
			сч = сч + 1;
		КонецЕсли;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	// 4. Планы лечения
	
	// Перебор регистра плана лечения. Поскольку на самом объекте документа не хранится план лечения
	// (он заполняется при создании на сервере) - то замене подвергается только регистр.
	Для СчИтераций = 1 По 25000 Цикл
		
		НачатьТранзакцию();
		
		// Запрос по 
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
			|	ПланыЛечения.ДокументРегистратор КАК Регистратор
			|ПОМЕСТИТЬ Регистраторы
			|ИЗ
			|	РегистрСведений.ПланыЛечения КАК ПланыЛечения
			|ГДЕ
			|	ПланыЛечения.СегментВЗубе В(&ЗаменяемыеСегменты)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПланыЛечения.ПервичныйПрием КАК ПервичныйПрием,
			|	ПланыЛечения.ИдентификаторЭлемента КАК ИдентификаторЭлемента,
			|	ПланыЛечения.ВидЭлемента КАК ВидЭлемента,
			|	ПланыЛечения.Номенклатура КАК Номенклатура,
			|	ПланыЛечения.ПорядокЭлемента КАК ПорядокЭлемента,
			|	ПланыЛечения.ДокументРегистратор КАК ДокументРегистратор,
			|	ПланыЛечения.Дата КАК Дата,
			|	ПланыЛечения.Сотрудник КАК Сотрудник,
			|	ПланыЛечения.Количество КАК Количество,
			|	ПланыЛечения.удалитьДокументРегистратор КАК удалитьДокументРегистратор,
			|	ПланыЛечения.ЗубВКарте КАК ЗубВКарте,
			|	ПланыЛечения.СегментВЗубе КАК СегментВЗубе,
			|	ПланыЛечения.Конструкция КАК Конструкция,
			|	ПланыЛечения.Сумма КАК Сумма,
			|	ПланыЛечения.ПриемовВДень КАК ПриемовВДень,
			|	ПланыЛечения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ПланыЛечения.ДатаОкончания КАК ДатаОкончания,
			|	ПланыЛечения.Дозировка КАК Дозировка,
			|	ПланыЛечения.Комментарий КАК Комментарий
			|ИЗ
			|	РегистрСведений.ПланыЛечения КАК ПланыЛечения
			|ГДЕ
			|	ПланыЛечения.ДокументРегистратор В
			|			(ВЫБРАТЬ
			|				Регистраторы.Регистратор
			|			ИЗ
			|				Регистраторы)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Регистраторы.Регистратор КАК ДокументРегистратор
			|ИЗ
			|	Регистраторы КАК Регистраторы";
			
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		// Если нечего перезаписывать - прекращаем работу
		Если РезультатыЗапроса[1].Пустой() Тогда
			Прервать;
		КонецЕсли;	
		
		ТаблицаРегистраПлановЛечения = РезультатыЗапроса[1].Выгрузить();
		ТаблицаРегистраПлановЛечения.Индексы.Добавить("ДокументРегистратор");
		
		ДокументыРегистраторы = РезультатыЗапроса[2].Выгрузить().ВыгрузитьКолонку("ДокументРегистратор");
		
		// Заменяем нужные строки и замещаем все записи в регистре
		Для Каждого Регистратор Из ДокументыРегистраторы Цикл
			
			ДвиженияРегистратора = ТаблицаРегистраПлановЛечения.НайтиСтроки(Новый Структура("ДокументРегистратор", Регистратор));
			
			НаборЗамещающихЗаписей = РегистрыСведений.ПланыЛечения.СоздатьНаборЗаписей();
			НаборЗамещающихЗаписей.Отбор.ДокументРегистратор.Установить(Регистратор);
			
			Для Каждого СтрокаВыгрузки Из ДвиженияРегистратора Цикл
				
				Если ЗубыВКарте.Получить(СтрокаВыгрузки.ЗубВКарте) <> Неопределено
					И ЗначениеЗаполнено(СтрокаВыгрузки.СегментВЗубе)
				Тогда
					
					ОтборПравилаЗамены.ЗубВКарте = СтрокаВыгрузки.ЗубВКарте;
					ОтборПравилаЗамены.ЗаменяемыйСегмент = СтрокаВыгрузки.СегментВЗубе;
					
					ПравилаЗамены = ТаблицаСоответствийЗамены.НайтиСтроки(ОтборПравилаЗамены);
					Если ПравилаЗамены.Количество() <> 0 Тогда
						НовыйСегмент = ПравилаЗамены[0].НовыйСегмент;
						СтрокаВыгрузки.СегментВЗубе = НовыйСегмент;
					КонецЕсли;
				КонецЕсли;
				
				НоваяЗамещающаяЗапись = НаборЗамещающихЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗамещающаяЗапись, СтрокаВыгрузки);
				
			КонецЦикла;	// Цикл по строке движения.
			
			НаборЗамещающихЗаписей.Записать();
						
		КонецЦикла; // Цикл по регистратору.
		
		ЗафиксироватьТранзакцию();
	КонецЦикла; // Цикл транзакций.
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти
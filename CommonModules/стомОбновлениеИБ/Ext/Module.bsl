#Область СлужебныйПрограммныйИнтерфейс

Процедура ПеренестиИзменяемыеНоменклатуройСостоянияВИзмерения() Экспорт
	
	ИзмСостНЗ = РегистрыСведений.стомИзменяемыеНоменклатуройСостояния.СоздатьНаборЗаписей();
	ИзмСостНЗ.Прочитать();
	Для Каждого Запись Из ИзмСостНЗ Цикл
		Запись.ДобавляемоеСостояние = 
			?(ЗначениеЗаполнено(Запись.удалитьДобавляемоеСостояние), Запись.удалитьДобавляемоеСостояние, Запись.ДобавляемоеСостояние);
		Запись.УдаляемоеСостояние = 
			?(ЗначениеЗаполнено(Запись.удалитьУдаляемоеСостояние), Запись.удалитьУдаляемоеСостояние, Запись.УдаляемоеСостояние);	
	КонецЦикла;
	ИзмСостНЗ.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьСтандартныеЗубныеКарты() Экспорт
	
	ДанныеКарты = Справочники.стомВидыЗубныхКарт.ПолучитьМакет("СтандартныеЗубныеКарты");
	ОбщегоНазначенияСервер.ВыполнитьЗагрузкуУниверсальнымОбменомXML(ДанныеКарты, Истина);
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выполнено заполнение стандартных видов зубных карт");
	
КонецПроцедуры

Процедура ЗаполнитьВычисляемыеБлокиЗубнойКарты() Экспорт
	
	МакетыБлоков = Справочники.стомВидыЗубныхКарт.ПолучитьСписокВычисляемыхБлоков();
	Для Каждого элМакет Из МакетыБлоков Цикл
		ОбщегоНазначенияСервер.ВыполнитьЗагрузкуУниверсальнымОбменомXML(элМакет.Данные);
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выполнено заполенние вычисляемых блоков зубной карты");
	
КонецПроцедуры

Процедура ЗаполнитьСостоянияПараметрыЗубов() Экспорт
	
	ДанныеСостояний = Справочники.стомВидыЗубныхКарт.ПолучитьМакет("СостоянияПараметрыЗубовПервоначальнаяЗагрузка");
	ОбщегоНазначенияСервер.ВыполнитьЗагрузкуУниверсальнымОбменомXML(ДанныеСостояний, Истина);
		
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выполнена загрузка параметров и состояний зубов");
	
КонецПроцедуры

Процедура УдалитьЛишниеСостояния() Экспорт
	
	Состояние = Справочники.стомСостоянияЗубов.НайтиПоНаименованию("Ржавый", Ложь);
	Если Не Состояние.Пустая() Тогда
		мсСсылки = Новый Массив;
		мсСсылки.Добавить(Состояние);
		Если НайтиПоСсылкам(мсСсылки) = Неопределено Тогда 
			Состояние.ПолучитьОбъект().Удалить();
		Иначе
			Состояние.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура РеструктуризацияВариантовЗубныхКарт() Экспорт
	
	//удаление областей, которых не может быть в составе вариантов при новых настройках
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	стомВариантыЗубовСписокОбластей.Ссылка КАК ВариантЗуба,
	|	стомВариантыЗубовСписокОбластей.Область КАК Область
	|ПОМЕСТИТЬ ОбластиВариантов
	|ИЗ
	|	Справочник.стомВариантыЗубов.СписокОбластей КАК стомВариантыЗубовСписокОбластей
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВариантЗуба,
	|	Область
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриемстомУстановленныеВарианты.Ссылка КАК Прием,
	|	ПриемстомУстановленныеВарианты.НомерСтроки
	|ИЗ
	|	Документ.Прием.стомУстановленныеВарианты КАК ПриемстомУстановленныеВарианты
	|ГДЕ
	|	ПриемстомУстановленныеВарианты.Область <> ЗНАЧЕНИЕ(Справочник.стомОбластиСегментов.)
	|			И НЕ (ПриемстомУстановленныеВарианты.ВариантЗуба, ПриемстомУстановленныеВарианты.Область) В
	|					(ВЫБРАТЬ
	|						ОбластиВариантов.ВариантЗуба,
	|						ОбластиВариантов.Область
	|					ИЗ
	|						ОбластиВариантов КАК ОбластиВариантов)
	|ИТОГИ ПО
	|	Прием";
	Результат = Запрос.Выполнить();
	ВыборкаПрием = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПрием.Следующий() Цикл
		
		ПриемОбъект = ВыборкаПрием.Прием.ПолучитьОбъект();
		ВыборкаСтроки = ВыборкаПрием.Выбрать();
		мсСтрокиКУдалению = Новый Массив;
		Пока ВыборкаСтроки.Следующий() Цикл
			мсСтрокиКУдалению.Добавить(ПриемОбъект.стомУстановленныеВарианты[ВыборкаСтроки.НомерСтроки - 1]);
		КонецЦикла;
		
		Для Каждого элСтрока Из мсСтрокиКУдалению Цикл 
			ПриемОбъект.стомУстановленныеВарианты.Удалить(элСтрока);
		КонецЦикла;
		
		РежимЗаписи = ?(ПриемОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
		ПриемОбъект.стомУстановленныеВарианты.Свернуть("ЗубВКарте, ВариантЗуба, Область, ТипУстановки, ВидРедактирования");
		ПриемОбъект.Записать(РежимЗаписи);
		
	КонецЦикла;
	
	//конвертирование вариантов "Абатмент" и "Штифт" на имплантацию
	ВариантАбатмент = Справочники.стомВариантыЗубов.НайтиПоНаименованию("Абатмент");
	ВариантШтифт = Справочники.стомВариантыЗубов.НайтиПоНаименованию("Штифт");
	ВариантИмплант = Справочники.стомВариантыЗубов.НайтиПоНаименованию("Имплантация");
	ВариантОтсутствует = Справочники.стомВариантыЗубов.НайтиПоНаименованию("Отсутствует");
	
	мсИскомыеВарианты = Новый Массив;
	мсИскомыеВарианты.Добавить(ВариантАбатмент);
	мсИскомыеВарианты.Добавить(ВариантШтифт);
	мсИскомыеВарианты.Добавить(ВариантИмплант);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПриемстомУстановленныеВарианты.Ссылка КАК Прием
	|ИЗ
	|	Документ.Прием.стомУстановленныеВарианты КАК ПриемстомУстановленныеВарианты
	|ГДЕ
	|	ПриемстомУстановленныеВарианты.ВариантЗуба В(&СписокВариантов)";
	Запрос.УстановитьПараметр("СписокВариантов", мсИскомыеВарианты);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ПриемОбъект = Выборка.Прием.ПолучитьОбъект();
		//ПриемОбъект = Документы.Прием.СоздатьДокумент(); 
		Для Каждого СтрокаВариант Из ПриемОбъект.стомУстановленныеВарианты.НайтиСтроки(Новый Структура("ВариантЗуба", ВариантАбатмент)) Цикл
			СтрокаВариант.ВариантЗуба = ВариантИмплант;
		КонецЦикла;
		Для Каждого СтрокаВариант Из ПриемОбъект.стомУстановленныеВарианты.НайтиСтроки(Новый Структура("ВариантЗуба", ВариантШтифт)) Цикл
			СтрокаВариант.ВариантЗуба = ВариантИмплант;
		КонецЦикла;
		Для Каждого СтрокаВариант Из ПриемОбъект.стомУстановленныеВарианты.НайтиСтроки(Новый Структура("ВариантЗуба", ВариантИмплант)) Цикл
			СтрокаВариант.ВариантЗуба = ВариантИмплант;
		КонецЦикла;
		Для Каждого СтрокаВариант Из ПриемОбъект.стомУстановленныеВарианты.НайтиСтроки(Новый Структура("ВариантЗуба", ВариантОтсутствует)) Цикл
			СтрокаВариант.Область = Неопределено;
		КонецЦикла;
		
		Для Каждого СтрокаВариант Из ПриемОбъект.стомУстановленныеВарианты.НайтиСтроки(Новый Структура("ВариантЗуба", ВариантИмплант)) Цикл
			НоваяСтрока = ПриемОбъект.стомУстановленныеВарианты.Добавить();
			НоваяСтрока.ЗубВКарте = СтрокаВариант.ЗубВКарте;
			НоваяСтрока.ВариантЗуба = ВариантОтсутствует;
			НоваяСтрока.ТипУстановки = СтрокаВариант.ТипУстановки;
			НоваяСтрока.ВидРедактирования = Перечисления.стомВидыРедактированияЭлементовКарты.Добавление;
		КонецЦикла;
		
		РежимЗаписи = ?(ПриемОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
		ПриемОбъект.Записать(РежимЗаписи);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СконвертироватьЗаказыКлиентовВКомплексныеРасчеты() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КомплексныйРасчетКлиента.Ссылка КАК КомплексныйРасчет
	|ИЗ
	|	Документ.КомплексныйРасчетКлиента КАК КомплексныйРасчетКлиента
	|ГДЕ
	|	НЕ КомплексныйРасчетКлиента.ПометкаУдаления";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	
	// Создание вида расчета
	ВидРасчета = Неопределено;
	ВыбВидыРасчетов = Справочники.ВидыКомплексныхРасчетовКлиентов.Выбрать();
	Пока ВыбВидыРасчетов.Следующий() Цикл
		Если Не ВыбВидыРасчетов.ЭтоГруппа
			И ВыбВидыРасчетов.Тип = Перечисления.ТипыКомплексныхРасчетовКлиентов.ПроизводственныйРасчет
		Тогда
			ВидРасчета = ВыбВидыРасчетов.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ВидРасчета) Тогда
		ВидРасчетаОбъект = Справочники.ВидыКомплексныхРасчетовКлиентов.СоздатьЭлемент();
		ВидРасчетаОбъект.Наименование = "Зуботехнический заказ-наряд";
		ВидРасчетаОбъект.Тип = Перечисления.ТипыКомплексныхРасчетовКлиентов.ПроизводственныйРасчет;
		ВидРасчетаОбъект.ЭтоЗуботехническийЗаказНаряд = Истина;
		ВидРасчетаОбъект.РазрешитьПродажуНеПоЦенеРасчета = Истина;
		ВидРасчетаОбъект.Прейскурант = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ОсновнойПрейскурант");
		ВидРасчетаОбъект.Записать();
		ВидРасчета = ВидРасчетаОбъект.Ссылка;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		РасчетКлиента = Выборка.КомплексныйРасчет.ПолучитьОбъект();
		РасчетКлиента.Вид = ВидРасчета;
		РасчетКлиента.Прейскурант = ВидРасчета.Прейскурант;
		
		Если ЗначениеЗаполнено(РасчетКлиента.удалитьНоменклатура) Тогда
			НоваяСтрока = РасчетКлиента.Состав.Добавить();
			НоваяСтрока.Номенклатура = РасчетКлиента.удалитьНоменклатура;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.Цена = РасчетКлиента.удалитьСуммаДокумента;
			НоваяСтрока.Сумма = РасчетКлиента.удалитьСуммаДокумента;
			
			РасчетКлиента.удалитьНоменклатура = Неопределено;
		КонецЕсли;
		
		Попытка
			РасчетКлиента.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			РасчетКлиента.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура РеструктуризоватьКонструкцииЗубовКлиентов() Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПриемстомУстановленныеВарианты.Ссылка КАК ДокПрием
	|ПОМЕСТИТЬ ПриемыСКонструкциями
	|ИЗ
	|	Документ.Прием.стомУстановленныеВарианты КАК ПриемстомУстановленныеВарианты
	|ГДЕ
	|	ПриемстомУстановленныеВарианты.Конструкция <> ЗНАЧЕНИЕ(Справочник.стомКонструкцииЗубовКлиентов.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокПрием
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПриемыСКонструкциями.ДокПрием КАК ДокПрием,
	|	ПриемстомУстановленныеВарианты.ЗубВКарте,
	|	ПриемстомУстановленныеВарианты.ВариантЗуба,
	|	ВЫБОР
	|		КОГДА ПриемстомУстановленныеВарианты.Область.ВидОбласти = ЗНАЧЕНИЕ(Перечисление.стомВидыОбластей.ЭлементКонструкции)
	|			ТОГДА ПриемстомУстановленныеВарианты.Область.КонструкцияРодитель
	|		ИНАЧЕ ПриемстомУстановленныеВарианты.Область
	|	КОНЕЦ КАК Область,
	|	ПриемстомУстановленныеВарианты.Конструкция,
	|	ПриемстомУстановленныеВарианты.ТипУстановки,
	|	ПриемстомУстановленныеВарианты.ВидРедактирования
	|ИЗ
	|	ПриемыСКонструкциями КАК ПриемыСКонструкциями
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Прием.стомУстановленныеВарианты КАК ПриемстомУстановленныеВарианты
	|		ПО ПриемыСКонструкциями.ДокПрием = ПриемстомУстановленныеВарианты.Ссылка
	|ГДЕ
	|	ПриемыСКонструкциями.ДокПрием.ЗубнаяКарта <> ЗНАЧЕНИЕ(Справочник.стомВидыЗубныхКарт.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриемыСКонструкциями.ДокПрием.МоментВремени
	|ИТОГИ ПО
	|	ДокПрием";
	
	Результат = Запрос.Выполнить();
	ВыборкаПриемы = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПриемы.Следующий() Цикл
		
		ДокОбъект = ВыборкаПриемы.ДокПрием.ПолучитьОбъект();
		Если Ложь Тогда ДокОбъект = Документы.Прием.СоздатьДокумент(); КонецЕсли;
		
		АдресЗК = стомЗубнаяКартаИнициализация.ИнициализироватьЗубнуюКарту(
		ДокОбъект.ЗубнаяКарта, ДокОбъект.Клиент, , ДокОбъект.Дата, ДокОбъект.ВариантЗубнойКарты, ДокОбъект.Ссылка);
		
		
		ГраницаПрием = Новый Граница(ДокОбъект.МоментВремени(), ВидГраницы.Исключая);		
		ИзмененныеВариантыСостоянияОбозначения = стомЗубнаяКартаДокументы.ПолучитьИзмененныеВариантыСостоянияОбозначения(АдресЗК, ГраницаПрием);
		ДокОбъект.стомУстановленныеВарианты.Загрузить(ИзмененныеВариантыСостоянияОбозначения.Варианты);
		ДокОбъект.стомУстановленныеСостояния.Загрузить(ИзмененныеВариантыСостоянияОбозначения.Состояния);
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если ДокОбъект.Проведен Тогда 
			ВариантыЗубовНЗ = РегистрыСведений.стомВариантыЗубов.СоздатьНаборЗаписей();
			ВариантыЗубовНЗ.Отбор.Регистратор.Установить(ДокОбъект.Ссылка);
			Для Каждого СтрокаВариант Из ДокОбъект.стомУстановленныеВарианты Цикл
				
				ДобавлятьСтроку = Истина;
				
				ВариантыЗубовНЗ.Прочитать();
				Для Каждого Строка Из ВариантыЗубовНЗ Цикл
					Если Строка.Клиент = ДокОбъект.Клиент
						И Строка.ЗубнаяКарта = ДокОбъект.ЗубнаяКарта
						И Строка.ЗубВКарте = СтрокаВариант.ЗубВКарте
						И Строка.ВариантЗуба = СтрокаВариант.ВариантЗуба
						И Строка.Область = СтрокаВариант.Область
					Тогда
						Строка.ВидРедактирования = СтрокаВариант.ВидРедактирования;
						Строка.Конструкция = СтрокаВариант.Конструкция;
						Строка.удалитьИдентификаторКонструкции = СтрокаВариант.удалитьИдентификаторКонструкции;
						
						ДобавлятьСтроку = Ложь
					КонецЕсли;	
				КонецЦикла;
				
				Если ДобавлятьСтроку Тогда
					ВариантыЗубовЗапись = ВариантыЗубовНЗ.Добавить();
					ЗаполнитьЗначенияСвойств(ВариантыЗубовЗапись, СтрокаВариант);
					ВариантыЗубовЗапись.Регистратор = ДокОбъект.Ссылка;
					ВариантыЗубовЗапись.Период = ДокОбъект.Дата;
					ВариантыЗубовЗапись.Клиент = ДокОбъект.Клиент;
					ВариантыЗубовЗапись.ЗубнаяКарта = ДокОбъект.ЗубнаяКарта;
				КонецЕсли;
			КонецЦикла;
			ВариантыЗубовНЗ.Записать();
			
			СостоянияЗубовНЗ = РегистрыСведений.стомСостоянияЗубов.СоздатьНаборЗаписей();
			СостоянияЗубовНЗ.Отбор.Регистратор.Установить(ДокОбъект.Ссылка);
			Для Каждого СтрокаСостояние Из ДокОбъект.стомУстановленныеСостояния Цикл
				СостоянияЗубовЗапись = СостоянияЗубовНЗ.Добавить();
				ЗаполнитьЗначенияСвойств(СостоянияЗубовЗапись, СтрокаСостояние);
				СостоянияЗубовЗапись.Регистратор = ДокОбъект.Ссылка;
				СостоянияЗубовЗапись.Период = ДокОбъект.Дата;
				СостоянияЗубовЗапись.Клиент = ДокОбъект.Клиент;
				СостоянияЗубовЗапись.ЗубнаяКарта = ДокОбъект.ЗубнаяКарта;
			КонецЦикла;
			СостоянияЗубовНЗ.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаменитьНеиспользуемыеМакетыМедкарт() Экспорт 
	
	СоответствиеНазваний = Новый Соответствие;
	СоответствиеНазваний.Вставить("АмбулаторнаяКарта043у_А5_приказ834н",	"стомАмбулаторнаяКарта043У");
	СоответствиеНазваний.Вставить("АмбулаторнаяКарта043У",					"стомАмбулаторнаяКарта043У");
	СоответствиеНазваний.Вставить("АмбулаторнаяКартаОртопедия043У_А4_приказ834н",	"стомМедицинскаяКартаОртодонтия043_1У");
	СоответствиеНазваний.Вставить("МедицинскаяКартаОртодонтия043_1У", 				"стомМедицинскаяКартаОртодонтия043_1У");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыМедицинскихКарт.Ссылка КАК ВидМедкарты,
	|	ВидыМедицинскихКарт.Макет
	|ИЗ
	|	Справочник.ВидыМедицинскихКарт КАК ВидыМедицинскихКарт
	|ГДЕ
	|	НЕ ВидыМедицинскихКарт.ИспользуетсяВнешняяПФ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ТипЗнч(Выборка.Макет) = Тип("Строка") И ЗначениеЗаполнено(Выборка.Макет) Тогда 
			НовыйМакет = СоответствиеНазваний.Получить(Выборка.Макет);
			Если НовыйМакет <> Неопределено Тогда
				ВидМедкартыОбъект = Выборка.ВидМедкарты.ПолучитьОбъект();
				ВидМедкартыОбъект.Макет = НовыйМакет;
				ВидМедкартыОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПеренестиОбозначенияЗубовВСписокВариантов() Экспорт 
	
	ВыборкаЗубы = Справочники.стомВидыЗубов.Выбрать();
	Пока ВыборкаЗубы.Следующий() Цикл
		
		ЗубОбъект = ВыборкаЗубы.ПолучитьОбъект();
		ЗубОбъект.ОбменДанными.Загрузка = Истина;
		Для Каждого СтрокаОбозначение Из ЗубОбъект.удалитьОбозначенияЗуба Цикл
			Если Не ЗначениеЗаполнено(СтрокаОбозначение.Обозначение) Тогда 
				Продолжить;
			КонецЕсли;
			СтрокаВариант = ЗубОбъект.СписокВариантов.Найти(СтрокаОбозначение.ОсновнойВариант, "ВариантЗуба");
			Если СтрокаВариант = Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			СтрокаВариант.Обозначение = СтрокаОбозначение.Обозначение;
		КонецЦикла;
		ЗубОбъект.удалитьОбозначенияЗуба.Очистить();
		ЗубОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПеренестиНастройкиУчетнойПолитики() Экспорт 
	
	УчетнаяПолитика = УправлениеНастройками.ПолучитьУчетнуюПолитику(Ложь);

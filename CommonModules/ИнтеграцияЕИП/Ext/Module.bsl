Функция ДесериализоватьОтветЧерезФабрику(МакетXSD, ЧтениеXML)
	
	//заранее сделаем xsd схему из готового xml на сайте
	//https://www.freeformatter.com/xsd-generator.html#before-output
	//потом пихаем в макет xsd 
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ПолучитьОбщийМакет(МакетXSD).ПолучитьТекст());
	
	//++ создаем фабрику из xsd 
	ПостроительDOM = Новый ПостроительDOM;
	Документ = ПостроительDOM.Прочитать(Чтение);
	ПостроительСхем = Новый ПостроительСхемXML;
	Схема = ПостроительСхем.СоздатьСхемуXML(Документ.ЭлементДокумента);	
	НаборСхем = Новый НаборСхемXML;
	НаборСхем.Добавить(Схема);
	Фабрика = Новый ФабрикаXDTO(НаборСхем);
	//-- конец создания фабрики
	
	Возврат Фабрика.ПрочитатьXML(ЧтениеXML);
	
КонецФункции


 
#Область ОсновныеФункции
 
Функция ПоискКартыПоИИН(ИИН = "") Экспорт
	
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("ОтветПустой", Истина);
	СтруктураОтвета.Вставить("Фамилия",);
	СтруктураОтвета.Вставить("Имя",);
	СтруктураОтвета.Вставить("Отчество",);
	СтруктураОтвета.Вставить("ИИН",);
	СтруктураОтвета.Вставить("id",);
	СтруктураОтвета.Вставить("Адрес",);
	СтруктураОтвета.Вставить("ДатаРождения",);
	СтруктураОтвета.Вставить("КодСкидкиЕИП",);
	СтруктураОтвета.Вставить("ЗначениеСкидкиЕИП",);
	СтруктураОтвета.Вставить("Сумма",);
	СтруктураОтвета.Вставить("ВидСкидки",);
	СтруктураОтвета.Вставить("Телефон",);    
	СтруктураОтвета.Вставить("НомерКарты",);
	
	Если НЕ (ЗначениеЗаполнено(ИИН) И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ИИН)) Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
			
	Ответ = ВызватьСерверЕИП(ПолучитьТекстЗапросаПоискаПоИИН(ИИН, КодЛаборатории()), 5);
	
	Если Ответ = Неопределено Тогда
		СтруктураОтвета.Вставить("Ошибка");
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если НЕ Ответ.КодСостояния = 200 Тогда
		СтруктураОтвета.Вставить("Ошибка");
		Возврат СтруктураОтвета;
	КонецЕсли; 
	
	ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	
	//читаем xml в переменную
	ОтветXML = Новый ЧтениеXML();
	ОтветXML.УстановитьСтроку(ОтветСтрокой);
	
	//десериализуем текст в объект с помощью фабрики
	Объектxdto = ДесериализоватьОтветЧерезФабрику("ИнтеграцияЕИП_ОтветПоискКартыПоИИН",ОтветXML);
	
	Свойства = Объектxdto.MethodResponse.Свойства();
	
	Если НЕ Свойства.Получить("Error") = Неопределено Тогда
		ЗаписьЖурналаРегистрации("Получение данных с ЕИП по ИИН", УровеньЖурналаРегистрации.Ошибка,,,Объектxdto.MethodResponse.Error.Message,РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если НЕ Свойства.Получить("Result") = Неопределено  
		И НЕ Объектxdto.MethodResponse.Result.Свойства().Получить("iin") = Неопределено
		И НЕ Объектxdto.MethodResponse.Result.iin.Свойства().Получить("lastName") = Неопределено Тогда
		//данные есть, заполняем 
		
		СвойстваИИН = Объектxdto.MethodResponse.Result.iin.Свойства();
		
		СтруктураОтвета.Фамилия = Объектxdto.MethodResponse.Result.iin.LastName;
		СтруктураОтвета.ОтветПустой = Ложь;
		СтруктураОтвета.Имя = Объектxdto.MethodResponse.Result.iin.FirstName;
		Если Не СвойстваИИН.Получить("MiddleName") = Неопределено Тогда
			СтруктураОтвета.Отчество = Объектxdto.MethodResponse.Result.iin.MiddleName;
		КонецЕсли;
		СтруктураОтвета.ИИН = Объектxdto.MethodResponse.Result.iin.Iin;
		Если НЕ СвойстваИИН.Получить("Id") = Неопределено Тогда
			СтруктураОтвета.Id = Объектxdto.MethodResponse.Result.iin.Id;
		КонецЕсли;
		
		Если НЕ Объектxdto.MethodResponse.Result.Свойства().Получить("card") = Неопределено
			И НЕ Объектxdto.MethodResponse.Result.card.Свойства().Получить("DiscountCode") = Неопределено Тогда
			
			Если Не Объектxdto.MethodResponse.Result.card.Свойства().Получить("Address") = Неопределено Тогда
				СтруктураОтвета.Адрес = Объектxdto.MethodResponse.Result.card.Address;
			Иначе 
				СтруктураОтвета.Адрес = "";
			КонецЕсли;
			СтруктураОтвета.НомерКарты = Объектxdto.MethodResponse.Result.Card.Nr;
			СтруктураОтвета.ДатаРождения = Объектxdto.MethodResponse.Result.card.BirthDate;
			СтруктураОтвета.КодСкидкиЕИП = Объектxdto.MethodResponse.Result.card.DiscountCode;    
			Попытка
				СтруктураОтвета.Сумма = Число(Объектxdto.MethodResponse.Result.card.TotalMoney) / 100;
			Исключение
			КонецПопытки;
			СтруктураОтвета.ЗначениеСкидкиЕИП = Объектxdto.MethodResponse.Result.card.DiscountValue;
			СтруктураОтвета.ВидСкидки = Справочники.ВидыСкидок.НайтиПоРеквизиту("КодЕИП", Объектxdto.MethodResponse.Result.card.DiscountCode);
			Если Не Объектxdto.MethodResponse.Result.card.Свойства().Получить("MobilePhone") = Неопределено Тогда 
				СтруктураОтвета.Телефон = Объектxdto.MethodResponse.Result.card.MobilePhone; 
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции

Процедура ЗагрузитьВрачейИзЕИП() Экспорт
	
	TimeStamp = Константы.ПоследнийTimeStampЕИП.Получить();
	Если НЕ ЗначениеЗаполнено(TimeStamp) Тогда
		TimeStamp = "0";
	КонецЕсли;
	
	Ответ = ВызватьСерверЕИП(ПолучитьТекстЗапросаДляЗагрузкиВрачей(TimeStamp));
	Если Ответ = Неопределено Тогда
		Возврат ;
	КонецЕсли;
	
	Если НЕ Ответ.КодСостояния = 200 Тогда
		Возврат ;
	КонецЕсли; 
	
	ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку("UTF-8"); //windows-1251
	
	//читаем xml в переменную
	ОтветXML = Новый ЧтениеXML();
	ОтветXML.УстановитьСтроку(ОтветСтрокой);
	
	//десериализуем текст в объект с помощью фабрики
	Объектxdto = ДесериализоватьОтветЧерезФабрику("ИнтеграцияЕИП_ОтветЗагрузкаВрачей",ОтветXML);	

	//<Result> 
	//  <Item  
	//    MiddleName="ХАУЕЗХАНОВНА"  
	//    FirstName="ГАЛИЯ"  
	//    BirthDate="02.01.1980 00:00:00"  
	//    LastName="СЫЗДЫКОВА"  
	//    Gender="2"  
	//    Comment=""  
	//    Code="300135"  
	//    MobilePhone="777 1111111"  
	//    Removed="false"  
	//    LabCode="4"  
	//    Email=""  
	//    Timestamp="51290"  
	//    HomePhone=""/> 
	// </Result> 
	//</MethodResponse>  
	
	ЗагруженоВрачей = 0;
	
	Если НЕ Объектxdto.MethodResponse.Свойства().Получить("Result") = Неопределено  
		И НЕ Объектxdto.MethodResponse.Result.Свойства().Получить("Item") = Неопределено Тогда
		
		Родитель = Справочники.Контрагенты.НайтиПоКоду("000000002"); //внешние агенты
		ПоследнийTimeStamp = TimeStamp;	
		Для Каждого ЭлементМассивВрач Из Объектxdto.MethodResponse.Result.item Цикл
			
			Если Число(ПоследнийTimeStamp) < Число(ЭлементМассивВрач.Timestamp) Тогда
				ПоследнийTimeStamp = ЭлементМассивВрач.Timestamp;
			КонецЕсли;
			
			Свойства = ЭлементМассивВрач.Свойства();
			
			//сначала ищем врача
			Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодАгента", ЭлементМассивВрач.Code);
			//нашли, ничего пока не делаем
			Если ЗначениеЗаполнено(Контрагент) Тогда
				Продолжить;
			КонецЕсли;
			
			////надо ли записывать удаленных?
			//Если ЭлементМассивВрач.Removed = "true" Тогда
			//	Продолжить;
			//КонецЕсли;
			
			//не нашли, создадим новый
			Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
			Контрагент.Родитель = Родитель;
			Если НЕ Свойства.Получить("LastName") = Неопределено Тогда
				Контрагент.Наименование = ЭлементМассивВрач.LastName;
			КонецЕсли;
			Если НЕ Свойства.Получить("FirstName") = Неопределено Тогда
				Контрагент.Наименование = Контрагент.Наименование + " " + ЭлементМассивВрач.FirstName;
			КонецЕсли;
			Если НЕ Свойства.Получить("MiddleName") = Неопределено Тогда
				Контрагент.Наименование = Контрагент.Наименование + " " + ЭлементМассивВрач.MiddleName;
			КонецЕсли;
			//Контрагент.Код = ЭлементМассивВрач.Code;
			Контрагент.НаименованиеПолное = Контрагент.Наименование;
			Контрагент.КодАгента = ЭлементМассивВрач.Code;
			Контрагент.омг_ВнешнийАгент = Истина;
			Если НЕ Свойства.Получить("Iin") = Неопределено Тогда		
				Контрагент.ИНН = ЭлементМассивВрач.Iin; 
			КонецЕсли;
			Если ЭлементМассивВрач.Removed = "true" Тогда
				Контрагент.ПометкаУдаления = Истина;
			КонецЕсли;
			Контрагент.Записать(); 
			
			ЗагруженоВрачей = ЗагруженоВрачей + 1;
			 
			Если НЕ Свойства.Получить("MobilePhone") = Неопределено И ЗначениеЗаполнено(ЭлементМассивВрач.MobilePhone) Тогда
				ЗаписьКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
				ЗаписьКИ.Объект = Контрагент.Ссылка;
				ЗаписьКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				ЗаписьКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
				ЗаписьКИ.Значение = ЭлементМассивВрач.MobilePhone;
				ЗаписьКИ.Представление = ЭлементМассивВрач.MobilePhone;
				ЗаписьКИ.Записать();
			КонецЕсли;
			
			Если НЕ Свойства.Получить("HomePhone") = Неопределено И ЗначениеЗаполнено(ЭлементМассивВрач.HomePhone) Тогда
				ЗаписьКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
				ЗаписьКИ.Объект = Контрагент.Ссылка;
				ЗаписьКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				ЗаписьКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонДомашний;
				ЗаписьКИ.Значение = ЭлементМассивВрач.HomePhone;
				ЗаписьКИ.Представление = ЭлементМассивВрач.HomePhone;
				ЗаписьКИ.Записать();
			КонецЕсли;
			              
			Если НЕ Свойства.Получить("Email") = Неопределено И ЗначениеЗаполнено(ЭлементМассивВрач.Email) Тогда
				ЗаписьКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
				ЗаписьКИ.Объект = Контрагент.Ссылка;
				ЗаписьКИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				ЗаписьКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий;
				ЗаписьКИ.Значение = ЭлементМассивВрач.Email;
				ЗаписьКИ.Представление = ЭлементМассивВрач.Email;
				ЗаписьКИ.Записать();
			КонецЕсли;
			
			Если НЕ Свойства.Получить("Comment") = Неопределено И ЗначениеЗаполнено(ЭлементМассивВрач.Comment) Тогда
				ЗаписьКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
				ЗаписьКИ.Объект = Контрагент.Ссылка;
				ЗаписьКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
				ЗаписьКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресФактический;
				ЗаписьКИ.Значение = ЭлементМассивВрач.Comment;
				ЗаписьКИ.Представление = ЭлементМассивВрач.Comment;
				ЗаписьКИ.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		Константы.ПоследнийTimeStampЕИП.Установить(ПоследнийTimeStamp);
		
	КонецЕсли;
			
КонецПроцедуры

Процедура ОтправитьДокументОказаниеУслугВЕИП(Документ, Работы, Врач, ТаблицаПроцентов) Экспорт
	
	#Если СЕРВЕР И НЕ СЕРВЕР Тогда
		Документ = Документы.ОказаниеУслуг.ПустаяСсылка();	
	#КонецЕсли
	
	Услуги = Новый ТаблицаЗначений;
	Услуги.Колонки.Добавить("Name",);
	Услуги.Колонки.Добавить("Code",);
	Услуги.Колонки.Добавить("Count",);
	Услуги.Колонки.Добавить("Price",);
	Услуги.Колонки.Добавить("DoctorMoney",);
	
	//услуги уже должны быть отфильтрованы
	Для Каждого Стр Из Работы Цикл
		ПроцентВрача = ТаблицаПроцентов.Найти(Стр.Номенклатура).Процент; //надо получить процент
		НовСтр = Услуги.Добавить();
		НовСтр.Name = Стр.Номенклатура.НаименованиеПолное;
		НовСтр.Code = Стр.Номенклатура.Артикул;
		НовСтр.Count = Стр.Количество;
		НовСтр.Price = СтрЗаменить(Формат(Стр.Сумма / Стр.Количество,"ЧДЦ=2; ЧРД=.; ЧГ=0"), ".", "");
		НовСтр.DoctorMoney = СтрЗаменить(Формат(Стр.Сумма * ПроцентВрача / 100,"ЧДЦ=2; ЧРД=.; ЧГ=0"), ".", "");
	КонецЦикла;
	
	Параметры = Новый Структура();
	Параметры.Вставить("LastName", Документ.Клиент.Фамилия);
	Параметры.Вставить("FirstName", Документ.Клиент.Имя);
	Параметры.Вставить("MiddleName", Документ.Клиент.Отчество);
	Параметры.Вставить("BirthDate", Документ.Клиент.ДатаРождения);
	Параметры.Вставить("Gender", ?(Документ.Клиент.Пол = Перечисления.ПолФизическихЛиц.Мужской, "1", "2"));
	Параметры.Вставить("PriorityHigh", "true");
	Параметры.Вставить("Comment", "");
	Параметры.Вставить("CreateDate", Документ.Дата);
	Параметры.Вставить("RequestNr", Документ.Номер);    //Номер запроса
	Параметры.Вставить("MisRequestId", XMLСтрока(Документ));  //ID запроса в системе
	Параметры.Вставить("CabinetCode", Документ.Филиал.КодКабинета);     //Код кабинета
	Параметры.Вставить("LabCode", Документ.Филиал.КодЛаборатории);
	Параметры.Вставить("DoctorCode", Врач.КодАгента);
	Параметры.Вставить("Услуги", Услуги);
	
	//Т = ПолучитьТекстЗапросаДляОтправкиНачисленийПоВрачам(Параметры);
	
	// Для отладки
	Возврат;
	
	Ответ = ВызватьСерверЕИП(ПолучитьТекстЗапросаДляОтправкиНачисленийПоВрачам(Параметры));
	Если Ответ = Неопределено Тогда
		Возврат ;
	КонецЕсли;
	
	Если НЕ Ответ.КодСостояния = 200 Тогда
		Возврат ;
	КонецЕсли; 
	
	ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	
	//читаем xml в переменную
	ОтветXML = Новый ЧтениеXML();
	ОтветXML.УстановитьСтроку(ОтветСтрокой);
	
	//десериализуем текст в объект с помощью фабрики
	Объектxdto = ДесериализоватьОтветЧерезФабрику("ИнтеграцияЕИП_ОтветОтправкаНачислений",ОтветXML);
	
	Если НЕ Объектxdto.MethodResponse.Свойства().Получить("Result") = Неопределено  
		И НЕ Объектxdto.MethodResponse.Result.Свойства().Получить("id") = Неопределено Тогда
		
		//запишем id документа в еип
		об = Документ.ПолучитьОбъект();
		Об.ИдентификаторВЕИП = Объектxdto.MethodResponse.Result.id;
		Об.ОбменДанными.Загрузка = Истина;
		Об.Записать(РежимЗаписиДокумента.Запись);
		
	//ошибки	
	ИначеЕсли НЕ Объектxdto.MethodResponse.Свойства().Получить("Result") = Неопределено
		И НЕ Объектxdto.MethodResponse.Result.Свойства().Получить("Errors") = Неопределено Тогда
		
		//Сообщить(Объектxdto.MethodResponse.Result.Errors.Item.Message);
		ЗаписьЖурналаРегистрации("Отправка начислений по врачам в ЕИП", УровеньЖурналаРегистрации.Ошибка,,Документ,Объектxdto.MethodResponse.Result.Errors.Item.Message,РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
		ТекстыОшибокОбновленияСтатусов = омг_ИнтеграцияСЛИС.ПолучитьСписокПропускаемыхОшибок();
		омг_ИнтеграцияСЛИС.ЗафиксироватьОшибочныйДокумент(Документ, Объектxdto.MethodResponse.Result.Errors.Item.Message, ТекстыОшибокОбновленияСтатусов);

	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДокументыОказанияУслугДляОтправкиВЕИП() Экспорт
	
	//запомним проценты
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроцентыВознагражденийАгентам_ЕИПСрезПоследних.Номенклатура КАК Номенклатура,
		|	ПроцентыВознагражденийАгентам_ЕИПСрезПоследних.Процент КАК Процент
		|ИЗ
		|	РегистрСведений.ПроцентыВознагражденийАгентам_ЕИП.СрезПоследних(&Дата, ) КАК ПроцентыВознагражденийАгентам_ЕИПСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	ТаблицаПроцентов = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_РезультатыОбменаССервисами.Документ КАК Документ
		|ПОМЕСТИТЬ ВТ_Ошибки
		|ИЗ
		|	РегистрСведений.омг_РезультатыОбменаССервисами КАК омг_РезультатыОбменаССервисами
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОказаниеУслугРаботы.Ссылка КАК Ссылка,
		|	ОказаниеУслугРаботы.омг_НаправившийВрач КАК омг_НаправившийВрач
		|ИЗ
		|	Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Ошибки КАК ВТ_Ошибки
		|		ПО ОказаниеУслугРаботы.Ссылка = ВТ_Ошибки.Документ
		|ГДЕ
		|	ОказаниеУслугРаботы.Ссылка.Дата >= &Дата
		|	И ОказаниеУслугРаботы.Номенклатура В(&Номенклатура)
		|	И ОказаниеУслугРаботы.омг_НаправившийВрач ССЫЛКА Справочник.Контрагенты
		|	И НЕ ОказаниеУслугРаботы.омг_НаправившийВрач.КодАгента ЕСТЬ NULL
		|	И НЕ ОказаниеУслугРаботы.омг_НаправившийВрач.КодАгента = """"
		|	И ОказаниеУслугРаботы.Ссылка.ИдентификаторВЕИП = """"
		|	И ВТ_Ошибки.Документ ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ОказаниеУслугРаботы.Ссылка,
		|	ОказаниеУслугРаботы.омг_НаправившийВрач";
	
	Запрос.УстановитьПараметр("Номенклатура", ТаблицаПроцентов.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Дата", Дата(2025, 4, 1));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МассивДляУдаления = Новый Массив;
		
		Услуги = ВыборкаДетальныеЗаписи.Ссылка.Работы.Выгрузить(Новый Структура("омг_НаправившийВрач", ВыборкаДетальныеЗаписи.омг_НаправившийВрач), );
		
		Для Каждого Стр Из Услуги Цикл
			Если ТаблицаПроцентов.Найти(Стр.Номенклатура, "Номенклатура") = Неопределено Тогда
				МассивДляУдаления.Добавить(Стр);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Стр Из МассивДляУдаления Цикл
			Услуги.Удалить(Стр);
		КонецЦикла;
		
		ОтправитьДокументОказаниеУслугВЕИП(ВыборкаДетальныеЗаписи.Ссылка, Услуги, ВыборкаДетальныеЗаписи.омг_НаправившийВрач ,ТаблицаПроцентов);
		
	КонецЦикла;
	
КонецФункции

Процедура ВыполнитьОтправкуНачисленийПоОказаннымУслугамВЕИП() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроцентыВознагражденийАгентам_ЕИПСрезПоследних.Номенклатура КАК Номенклатура,
		|	ПроцентыВознагражденийАгентам_ЕИПСрезПоследних.Процент КАК Процент
		|ПОМЕСТИТЬ ВТ_ПозицииВознагражденияАгентам
		|ИЗ
		|	РегистрСведений.ПроцентыВознагражденийАгентам_ЕИП.СрезПоследних(&ТекущаяДата, ) КАК ПроцентыВознагражденийАгентам_ЕИПСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	омг_РезультатыОбменаССервисами.Документ КАК Документ
		|ПОМЕСТИТЬ ВТ_Ошибки
		|ИЗ
		|	РегистрСведений.омг_РезультатыОбменаССервисами КАК омг_РезультатыОбменаССервисами
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОказаниеУслугРаботы.Ссылка КАК Ссылка,
		|	ОказаниеУслугРаботы.омг_НаправившийВрач КАК омг_НаправившийВрач,
		|	ОказаниеУслугРаботы.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
		|	ОказаниеУслугРаботы.Номенклатура.Артикул КАК НоменклатураАртикул,
		|	ОказаниеУслугРаботы.Количество КАК Количество,
		|	ОказаниеУслугРаботы.Сумма КАК Сумма,
		|	ОказаниеУслугРаботы.Сумма * ВТ_ПозицииВознагражденияАгентам.Процент / 100 КАК СуммаВознаграждения,
		|	ОказаниеУслугРаботы.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_Позиции
		|ИЗ
		|	Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Ошибки КАК ВТ_Ошибки
		|		ПО ОказаниеУслугРаботы.Ссылка = ВТ_Ошибки.Документ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПозицииВознагражденияАгентам КАК ВТ_ПозицииВознагражденияАгентам
		|		ПО ОказаниеУслугРаботы.Номенклатура = ВТ_ПозицииВознагражденияАгентам.Номенклатура
		|ГДЕ
		|	ОказаниеУслугРаботы.Ссылка.Дата >= &ДатаНачалаОтправки
		|	И ОказаниеУслугРаботы.омг_НаправившийВрач ССЫЛКА Справочник.Контрагенты
		|	И НЕ ОказаниеУслугРаботы.омг_НаправившийВрач.КодАгента ЕСТЬ NULL
		|	И НЕ ОказаниеУслугРаботы.омг_НаправившийВрач.КодАгента = """"
		|	И ОказаниеУслугРаботы.Ссылка.ИдентификаторВЕИП = """"
		|	И ВТ_Ошибки.Документ ЕСТЬ NULL
		|	И ОказаниеУслугРаботы.Ссылка.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОказаниеУслуг.Ссылка КАК Ссылка,
		|	ОказаниеУслуг.Номер КАК Номер,
		|	ОказаниеУслуг.Дата КАК Дата,
		|	ОказаниеУслуг.Клиент.Фамилия КАК КлиентФамилия,
		|	ОказаниеУслуг.Клиент.Имя КАК КлиентИмя,
		|	ОказаниеУслуг.Клиент.Отчество КАК КлиентОтчество,
		|	ОказаниеУслуг.Клиент.Пол КАК КлиентПол,
		|	ОказаниеУслуг.Клиент.ДатаРождения КАК КлиентДатаРождения,
		|	ОказаниеУслуг.Филиал.КодКабинета КАК ФилиалКодКабинета,
		|	ОказаниеУслуг.Филиал.КодЛаборатории КАК ФилиалКодЛаборатории,
		|	ОказаниеУслуг.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ПродажаКлиенту) КАК ЭтоПродажа
		|ПОМЕСТИТЬ ВТ_Документы
		|ИЗ
		|	ВТ_Позиции КАК ВТ_Позиции
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг КАК ОказаниеУслуг
		|		ПО ВТ_Позиции.Ссылка = ОказаниеУслуг.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Документы.Ссылка КАК Ссылка,
		|	ВТ_Документы.Номер КАК Номер,
		|	ВТ_Документы.Дата КАК Дата,
		|	ВТ_Документы.КлиентФамилия КАК КлиентФамилия,
		|	ВТ_Документы.КлиентИмя КАК КлиентИмя,
		|	ВТ_Документы.КлиентОтчество КАК КлиентОтчество,
		|	ВТ_Документы.КлиентПол КАК КлиентПол,
		|	ВТ_Документы.КлиентДатаРождения КАК КлиентДатаРождения,
		|	ВТ_Документы.ФилиалКодКабинета КАК ФилиалКодКабинета,
		|	ВТ_Документы.ФилиалКодЛаборатории КАК ФилиалКодЛаборатории,
		|	ВТ_Документы.ЭтоПродажа КАК ЭтоПродажа
		|ИЗ
		|	ВТ_Документы КАК ВТ_Документы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Позиции.Ссылка КАК Ссылка,
		|	ВТ_Позиции.омг_НаправившийВрач КАК омг_НаправившийВрач,
		|	ВЫРАЗИТЬ(ВТ_Позиции.НоменклатураНаименованиеПолное КАК СТРОКА(1000)) КАК НаименованиеПолное,
		|	ВТ_Позиции.НоменклатураАртикул КАК Артикул,
		|	ВТ_Позиции.Сумма / ВТ_Позиции.Количество КАК Цена,
		|	ВТ_Позиции.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА ВТ_Документы.ЭтоПродажа
		|			ТОГДА ВТ_Позиции.СуммаВознаграждения
		|		ИНАЧЕ -ВТ_Позиции.СуммаВознаграждения
		|	КОНЕЦ КАК СуммаВознаграждения,
		|	ВТ_Позиции.Количество КАК Количество,
		|	ВТ_Позиции.омг_НаправившийВрач.КодАгента КАК КодАгента
		|ИЗ
		|	ВТ_Позиции КАК ВТ_Позиции
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы
		|		ПО ВТ_Позиции.Ссылка = ВТ_Документы.Ссылка
		|ИТОГИ ПО
		|	Ссылка,
		|	омг_НаправившийВрач";
	
	Запрос.УстановитьПараметр("ДатаНачалаОтправки", Дата(2025, 4, 1));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();

	Если ПакетРезультатов.Получить(4).Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДокументов = ПакетРезультатов.Получить(4).Выбрать();
	
	ВыборкаПозицийПоДокументам = ПакетРезультатов.Получить(5).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		ВыборкаПозицийПоДокументам.Сбросить();
		ВыборкаПозицийПоДокументам.НайтиСледующий(ВыборкаДокументов.Ссылка, "Ссылка");
		
		ВыборкаПозицийПоВрачам = ВыборкаПозицийПоДокументам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПозицийПоВрачам.Следующий() Цикл
			
			ВыборкаПозицийДетали = ВыборкаПозицийПоВрачам.Выбрать();
			
			Услуги = Новый ТаблицаЗначений;
			Услуги.Колонки.Добавить("Name",);
			Услуги.Колонки.Добавить("Code",);
			Услуги.Колонки.Добавить("Count",);
			Услуги.Колонки.Добавить("Price",);
			Услуги.Колонки.Добавить("DoctorMoney",);
			
			//услуги уже должны быть отфильтрованы
			Пока ВыборкаПозицийДетали.Следующий() Цикл
				НовСтр = Услуги.Добавить();
				НовСтр.Name = ВыборкаПозицийДетали.НаименованиеПолное;
				НовСтр.Code = ВыборкаПозицийДетали.Артикул;
				НовСтр.Count = ВыборкаПозицийДетали.Количество;
				НовСтр.Price = СтрЗаменить(Формат(ВыборкаПозицийДетали.Цена,"ЧДЦ=2; ЧРД=.; ЧГ=0"), ".", "");
				НовСтр.DoctorMoney = СтрЗаменить(Формат(ВыборкаПозицийДетали.СуммаВознаграждения,"ЧДЦ=2; ЧРД=.; ЧГ=0"), ".", "");
			КонецЦикла;
			
			Параметры = Новый Структура();
			Параметры.Вставить("LastName", ВыборкаДокументов.КлиентФамилия);
			Параметры.Вставить("FirstName", ВыборкаДокументов.КлиентИмя);
			Параметры.Вставить("MiddleName", ВыборкаДокументов.КлиентОтчество);
			Параметры.Вставить("BirthDate", ВыборкаДокументов.КлиентДатаРождения);
			Параметры.Вставить("Gender", ?(ВыборкаДокументов.КлиентПол = Перечисления.ПолФизическихЛиц.Мужской, "1", "2"));
			Параметры.Вставить("PriorityHigh", "true");
			Параметры.Вставить("Comment", "");
			Параметры.Вставить("CreateDate", ВыборкаДокументов.Дата);
			Параметры.Вставить("RequestNr", ВыборкаДокументов.Номер);    //Номер запроса
			Параметры.Вставить("MisRequestId", XMLСтрока(ВыборкаДокументов.Ссылка));  //ID запроса в системе
			Параметры.Вставить("CabinetCode", ВыборкаДокументов.ФилиалКодКабинета);     //Код кабинета
			Параметры.Вставить("LabCode", ВыборкаДокументов.ФилиалКодЛаборатории);
			Параметры.Вставить("DoctorCode", ВыборкаПозицийПоВрачам.КодАгента);
			Параметры.Вставить("Услуги", Услуги);
			
			//Т = ПолучитьТекстЗапросаДляОтправкиНачисленийПоВрачам(Параметры);
			
			// Для откладки
			//Прервать;
			
			Ответ = ВызватьСерверЕИП(ПолучитьТекстЗапросаДляОтправкиНачисленийПоВрачам(Параметры));
			Если Ответ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ Ответ.КодСостояния = 200 Тогда
				Продолжить;
			КонецЕсли; 
			
			ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			
			//читаем xml в переменную
			ОтветXML = Новый ЧтениеXML();
			ОтветXML.УстановитьСтроку(ОтветСтрокой);
			
			//десериализуем текст в объект с помощью фабрики
			Объектxdto = ДесериализоватьОтветЧерезФабрику("ИнтеграцияЕИП_ОтветОтправкаНачислений",ОтветXML);
			
			Если НЕ Объектxdto.MethodResponse.Свойства().Получить("Result") = Неопределено  
				И НЕ Объектxdto.MethodResponse.Result.Свойства().Получить("id") = Неопределено Тогда
				
				//запишем id документа в еип
				об = ВыборкаДокументов.Ссылка.ПолучитьОбъект();
				Об.ИдентификаторВЕИП = Объектxdto.MethodResponse.Result.id;
				Об.ОбменДанными.Загрузка = Истина;
				Об.Записать(РежимЗаписиДокумента.Запись);
				
				//ошибки	
			ИначеЕсли НЕ Объектxdto.MethodResponse.Свойства().Получить("Result") = Неопределено
				И НЕ Объектxdto.MethodResponse.Result.Свойства().Получить("Errors") = Неопределено Тогда
				
				//Сообщить(Объектxdto.MethodResponse.Result.Errors.Item.Message);
				ЗаписьЖурналаРегистрации("Отправка начислений по врачам в ЕИП", УровеньЖурналаРегистрации.Ошибка,,ВыборкаДокументов.Ссылка,Объектxdto.MethodResponse.Result.Errors.Item.Message,РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
				ТекстыОшибокОбновленияСтатусов = омг_ИнтеграцияСЛИС.ПолучитьСписокПропускаемыхОшибок();
				омг_ИнтеграцияСЛИС.ЗафиксироватьОшибочныйДокумент(ВыборкаДокументов.Ссылка, Объектxdto.MethodResponse.Result.Errors.Item.Message, ТекстыОшибокОбновленияСтатусов);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНакопленияИзРегистра(Клиент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсторияНакопленийПоКартеЕИПСрезПоследних.КартаСкидки.Наименование КАК Карта,
	               |	ИсторияНакопленийПоКартеЕИПСрезПоследних.Сумма КАК Сумма
	               |ИЗ
	               |	РегистрСведений.ИсторияНакопленийПоКартеЕИП.СрезПоследних(, Клиент = &Клиент) КАК ИсторияНакопленийПоКартеЕИПСрезПоследних";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		СуммаНачислений = 0;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		СуммаНачислений = Выборка.Сумма;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СуммаНачислений;
	
КонецФункции

#КонецОбласти

#Область БизнесЛогика

Процедура СделатьЗаписьПоИсторииСкидок(Клиент, ВидСкидки, КартаСкидок, Сумма, Дата) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запись = РегистрыСведений.ИсторияНакопленийПоКартеЕИП.СоздатьМенеджерЗаписи();
	Запись.Период = Дата;
	Запись.Клиент = Клиент;
	Запись.ВидСкидки = ВидСкидки;
	Запись.КартаСкидки = КартаСкидок;
	Запись.Сумма = Сумма;
	Запись.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбновитьДанныеПоКлиентуИзЕИП(Клиент) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Клиент) И НЕ ЗначениеЗаполнено(Клиент.ИНН) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураНовогоКлиента = ПоискКартыПоИИН(Клиент.ИНН);
	//данные нашлись
	Если СтруктураНовогоКлиента.Свойство("Ошибка") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось соединиться с сервером ЕИП.";
		Сообщение.Сообщить();
	КонецЕсли;
	Если СтруктураНовогоКлиента.ОтветПустой = Ложь И Не СтруктураНовогоКлиента.ЗначениеСкидкиЕИП = Неопределено Тогда
		//ФИО = СтруктураНовогоКлиента.Фамилия + " " + СтруктураНовогоКлиента.Имя + " " + СтруктураНовогоКлиента.Отчество;
		//ИНН = СтруктураНовогоКлиента.ИИН;
		//Телефон = СтруктураНовогоКлиента.Телефон;
		//ВидТелефона = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонСотовый");
		//Адрес = СтруктураНовогоКлиента.Адрес;
		//ДатаРождения = СтруктураНовогоКлиента.ДатаРождения;
		//Пол = ОбщегоНазначения.ОпределитьПол(СтруктураНовогоКлиента.Имя, СтруктураНовогоКлиента.Фамилия, СтруктураНовогоКлиента.Отчество);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КартыСкидок.Ссылка КАК Ссылка,
		               |	Клиентыомг_КартыСкидок.Ссылка ЕСТЬ NULL КАК ДобавитьКарту,
		               |	КартыСкидок.ВидКарты КАК ВидКарты
		               |ИЗ
		               |	Справочник.КартыСкидок КАК КартыСкидок
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Клиенты.омг_КартыСкидок КАК Клиентыомг_КартыСкидок
		               |		ПО (Клиентыомг_КартыСкидок.Карта = КартыСкидок.Ссылка)
		               |ГДЕ
		               |	КартыСкидок.Наименование = &НомерКарты
		               |	И КартыСкидок.ВладелецКарты = &ВладелецКарты
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	омг_СоответствиеСкидокВидамКарт.ВидСкидки КАК ВидСкидки,
		               |	омг_СоответствиеСкидокВидамКарт.ВидКарты КАК ВидКарты
		               |ИЗ
		               |	РегистрСведений.омг_СоответствиеСкидокВидамКарт КАК омг_СоответствиеСкидокВидамКарт
		               |ГДЕ
		               |	омг_СоответствиеСкидокВидамКарт.ВидСкидки = &ВидСкидки";
		Запрос.УстановитьПараметр("ВладелецКарты", Клиент);
		Запрос.УстановитьПараметр("ВидСкидки", СтруктураНовогоКлиента.ВидСкидки);
		Запрос.УстановитьПараметр("НомерКарты", СтруктураНовогоКлиента.НомерКарты);
		Запрос.УстановитьПараметр("Скидка", Число(СтруктураНовогоКлиента.ЗначениеСкидкиЕИП) / 100);
		
		ПакетРезультатов = Запрос.ВыполнитьПакет();
		
		КартыРезультатЗапроса = ПакетРезультатов.Получить(0);
		ВидыКартРезультатЗапроса = ПакетРезультатов.Получить(1);
		
		ДобавитьКарту = Истина;
		Если Не КартыРезультатЗапроса.Пустой() Тогда
			ВыборкаКарт = КартыРезультатЗапроса.Выбрать();
			ВыборкаКарт.Следующий();
			КартаСкидок = ВыборкаКарт.Ссылка;
			
			ВыборкаВидыКарт = ВидыКартРезультатЗапроса.Выбрать();
			Если ВыборкаВидыКарт.Следующий() Тогда
				Если Не ВыборкаКарт.ВидКарты = ВыборкаВидыКарт.ВидКарты Тогда
					КартаСкидокОбъект = КартаСкидок.ПолучитьОбъект();
					КартаСкидокОбъект.ВидКарты = ВыборкаВидыКарт.ВидКарты;
					КартаСкидокОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
			
			ДобавитьКарту = ВыборкаКарт.ДобавитьКарту;
		Иначе 
			КартаСкидок = Справочники.КартыСкидок.СоздатьЭлемент();
			КартаСкидок.Наименование = СтруктураНовогоКлиента.НомерКарты;
			КартаСкидок.ВладелецКарты = Клиент;
			ВыборкаВидыКарт = ВидыКартРезультатЗапроса.Выбрать();
			Если ВыборкаВидыКарт.Следующий() Тогда
				КартаСкидок.ВидКарты = ВыборкаВидыКарт.ВидКарты;
			КонецЕсли;
			КартаСкидок.Записать();
			
			КартаСкидок = КартаСкидок.Ссылка;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(СтруктураНовогоКлиента.ВидСкидки) И Клиент.ВидСкидки <> СтруктураНовогоКлиента.ВидСкидки Или ДобавитьКарту Тогда
			Об = Клиент.ПолучитьОбъект();
			Об.ВидСкидки = СтруктураНовогоКлиента.ВидСкидки;
			//КартаСкидок = ПолучитьКартуСкидкиПоВидуСкидки(Об.ВидСкидки);
			Если ЗначениеЗаполнено(КартаСкидок) Тогда
				Об.омг_КартыСкидок.очистить();
				НоВСтр = Об.омг_КартыСкидок.Добавить();
				НоВСтр.Карта = КартаСкидок;
				НоВСтр.НомерКарты = СтруктураНовогоКлиента.НомерКарты;
			КонецЕсли;
			Об.Записать();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураНовогоКлиента.Сумма) Тогда
			// Старый вариант заполнения
			//СделатьЗаписьПоИсторииСкидок(Клиент, СтруктураНовогоКлиента.ВидСкидки, ПолучитьКартуСкидкиПоВидуСкидки(СтруктураНовогоКлиента.ВидСкидки), СтруктураНовогоКлиента.Сумма, ТекущаяДата()); 
			СделатьЗаписьПоИсторииСкидок(Клиент, СтруктураНовогоКлиента.ВидСкидки, КартаСкидок, СтруктураНовогоКлиента.Сумма, ТекущаяДата()); 
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПолучитьКартуСкидкиПоВидуСкидки(ВидСкидки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВидСкидки) Тогда
		Возврат Справочники.КартыСкидок.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДействиеСкидок.Получатель КАК Получатель
		|ИЗ
		|	РегистрСведений.ДействиеСкидок КАК ДействиеСкидок
		|ГДЕ
		|	ДействиеСкидок.ВидСкидки = &ВидСкидки
		|	И ДействиеСкидок.Получатель ССЫЛКА Справочник.КартыСкидок";
	
	Запрос.УстановитьПараметр("ВидСкидки", ВидСкидки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Получатель;
	КонецЦикла;
	
	Возврат Справочники.КартыСкидок.ПустаяСсылка();
КонецФункции


		МассивДокументов = Новый Массив;
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_ДокументыНачисленийНаКартыЕИП.Документ КАК Документ
	               |ПОМЕСТИТЬ ВТ_ДокументыНачисленийНаКартыЕИП
	               |ИЗ
	               |	РегистрСведений.омг_ДокументыНачисленийНаКартыЕИП КАК омг_ДокументыНачисленийНаКартыЕИП
	               |ГДЕ
	               |	НЕ омг_ДокументыНачисленийНаКартыЕИП.Документ.КартаКлиента = ЗНАЧЕНИЕ(Справочник.КартыСкидок.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОказаниеУслуг.Ссылка КАК Документ,
	               |	ОказаниеУслуг.СостояниеЧековККМ КАК ЧекПробит,
	               |	ОказаниеУслуг.Филиал.КодКабинета КАК КодКабинета,
	               |	ОказаниеУслуг.Филиал.КодЛаборатории КАК КодЛаборатории,
	               |	ОказаниеУслуг.Филиал.НазваниеОрганизации КАК НазваниеОрганизации,
	               |	ОказаниеУслуг.Номер КАК Номер,
	               |	ОказаниеУслуг.Клиент КАК Клиент,
	               |	ОказаниеУслуг.Клиент.Фамилия КАК КлиентФамилия,
	               |	ОказаниеУслуг.Клиент.Имя КАК КлиентИмя,
	               |	ОказаниеУслуг.Клиент.Отчество КАК КлиентОтчество,
	               |	ОказаниеУслуг.Дата КАК Дата,
	               |	ОказаниеУслуг.Комментарий КАК Комментарий,
	               |	ВЫБОР
	               |		КОГДА ОказаниеУслуг.ВидОперации = &ВидОперацииПродажа
	               |			ТОГДА СуммаПоДокументу.Сумма
	               |		ИНАЧЕ -СуммаПоДокументу.Сумма
	               |	КОНЕЦ КАК СуммаДокумента,
	               |	ВложенныйЗапрос.ВидСкидкиКодЕИП КАК КодЕИП,
	               |	ОказаниеУслуг.КартаКлиента КАК КартаКлиента,
	               |	ОказаниеУслуг.Представление КАК ДокументПредставление,
	               |	ОказаниеУслуг.Клиент.Представление КАК КлиентПредставление,
	               |	ОказаниеУслуг.Проведен КАК Проведен,
	               |	ОказаниеУслуг.Клиент.ИНН КАК КлиентИНН
	               |ПОМЕСТИТЬ ВТ_ДокументыКОтправке
	               |ИЗ
	               |	Документ.ОказаниеУслуг КАК ОказаниеУслуг
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ДействиеСкидок.ВидСкидки КАК ВидСкидки,
	               |			ДействиеСкидок.Получатель КАК КартаСкидки,
	               |			ДействиеСкидок.ВидСкидки.КодЕИП КАК ВидСкидкиКодЕИП
	               |		ИЗ
	               |			РегистрСведений.ДействиеСкидок КАК ДействиеСкидок) КАК ВложенныйЗапрос
	               |		ПО ОказаниеУслуг.КартаКлиента.ВидКарты = ВложенныйЗапрос.КартаСкидки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВТ_ДокументыНачисленийНаКартыЕИП.Документ КАК Документ,
	               |			СУММА(ОказаниеУслугРаботы.Сумма) КАК Сумма
	               |		ИЗ
	               |			ВТ_ДокументыНачисленийНаКартыЕИП КАК ВТ_ДокументыНачисленийНаКартыЕИП
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
	               |				ПО ВТ_ДокументыНачисленийНаКартыЕИП.Документ = ОказаниеУслугРаботы.Ссылка
	               |		ГДЕ
	               |			НЕ ОказаниеУслугРаботы.Номенклатура В ИЕРАРХИИ
	               |						(ВЫБРАТЬ
	               |							омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |						ИЗ
	               |							РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТ_ДокументыНачисленийНаКартыЕИП.Документ) КАК СуммаПоДокументу
	               |		ПО ОказаниеУслуг.Ссылка = СуммаПоДокументу.Документ
	               |ГДЕ
	               |	(ОказаниеУслуг.Ссылка В (&МассивДокументов)
	               |			ИЛИ ОказаниеУслуг.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ВТ_ДокументыНачисленийНаКартыЕИП.Документ КАК Документ
	               |				ИЗ
	               |					ВТ_ДокументыНачисленийНаКартыЕИП КАК ВТ_ДокументыНачисленийНаКартыЕИП))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.Клиент КАК Клиент,
	               |	ЕСТЬNULL(Клиентыомг_КартыСкидок.НомерКарты, """") КАК НомерКарты,
	               |	Клиентыомг_КартыСкидок.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ ВТ_КартыСкидок
	               |ИЗ
	               |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		ВТ_ДокументыКОтправке.Клиент КАК Клиент,
	               |		ВТ_ДокументыКОтправке.КартаКлиента КАК КартаКлиента
	               |	ИЗ
	               |		ВТ_ДокументыКОтправке КАК ВТ_ДокументыКОтправке) КАК ВложенныйЗапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Клиенты.омг_КартыСкидок КАК Клиентыомг_КартыСкидок
	               |		ПО ВложенныйЗапрос.Клиент = Клиентыомг_КартыСкидок.Ссылка
	               |			И ВложенныйЗапрос.КартаКлиента = Клиентыомг_КартыСкидок.Карта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДокументыКОтправке.Документ КАК Документ,
	               |	ВТ_ДокументыКОтправке.ЧекПробит КАК ЧекПробит,
	               |	ВТ_ДокументыКОтправке.КодКабинета КАК КодКабинета,
	               |	ВТ_ДокументыКОтправке.КодЛаборатории КАК КодЛаборатории,
	               |	ВТ_ДокументыКОтправке.НазваниеОрганизации КАК НазваниеОрганизации,
	               |	ВТ_ДокументыКОтправке.Номер КАК Номер,
	               |	ВТ_ДокументыКОтправке.Клиент КАК Клиент,
	               |	ВТ_ДокументыКОтправке.КлиентФамилия КАК КлиентФамилия,
	               |	ВТ_ДокументыКОтправке.КлиентИмя КАК КлиентИмя,
	               |	ВТ_ДокументыКОтправке.КлиентОтчество КАК КлиентОтчество,
	               |	ВТ_ДокументыКОтправке.Дата КАК Дата,
	               |	ВТ_ДокументыКОтправке.Комментарий КАК Комментарий,
	               |	ВЫБОР
	               |		КОГДА ВТ_ДокументыКОтправке.Проведен
	               |			ТОГДА ВТ_ДокументыКОтправке.СуммаДокумента
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СуммаДокумента,
	               |	ВТ_ДокументыКОтправке.КодЕИП КАК КодЕИП,
	               |	ВТ_ДокументыКОтправке.КартаКлиента КАК КартаКлиента,
	               |	ЕСТЬNULL(ВТ_ДокументыКОтправке.КартаКлиента.Наименование, """") КАК НомерКарты,
	               |	ВТ_ДокументыКОтправке.ДокументПредставление КАК ДокументПредставление,
	               |	ВТ_ДокументыКОтправке.КлиентПредставление КАК КлиентПредставление,
	               |	ВТ_ДокументыКОтправке.КлиентИНН КАК КлиентИНН
	               |ИЗ
	               |	ВТ_ДокументыКОтправке КАК ВТ_ДокументыКОтправке
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВТ_КартыСкидок.Клиент КАК Клиент,
	               |			МАКСИМУМ(ВТ_КартыСкидок.НомерСтроки) КАК НомерСтроки
	               |		ИЗ
	               |			ВТ_КартыСкидок КАК ВТ_КартыСкидок
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТ_КартыСкидок.Клиент) КАК ВложенныйЗапрос
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КартыСкидок КАК ВТ_КартыСкидок
	               |			ПО ВложенныйЗапрос.Клиент = ВТ_КартыСкидок.Клиент
	               |				И ВложенныйЗапрос.НомерСтроки = ВТ_КартыСкидок.НомерСтроки
	               |		ПО ВТ_ДокументыКОтправке.Клиент = ВложенныйЗапрос.Клиент";
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("ВидОперацииПродажа", Перечисления.ВидыОперацийОказанияУслуг.ПродажаКлиенту);
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивРезультатов = Новый Массив;
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат МассивРезультатов;
	КонецЕсли;
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	
	Запись = Новый ЗаписьXML;
	
	Пока ВыборкаДанных.Следующий() Цикл
		
		Запись.УстановитьСтроку("UTF-8");
		Запись.ЗаписатьТекст("");
		
		Запись.ЗаписатьОбъявлениеXML();
		Запись.ЗаписатьНачалоЭлемента("Envelope");
		Запись.ЗаписатьАтрибут("Date", Строка(ТекущаяДата()));
		Запись.ЗаписатьАтрибут("SessionId", "0");
		
		Запись.ЗаписатьНачалоЭлемента("MethodCall");
		Запись.ЗаписатьАтрибут("Name","external-save-card-request");
		
		Запись.ЗаписатьНачалоЭлемента("Params");
		Запись.ЗаписатьАтрибут("LabCode", ВыборкаДанных.КодЛаборатории);
		Запись.ЗаписатьАтрибут("CabinetCode", ВыборкаДанных.КодКабинета);
		Запись.ЗаписатьАтрибут("HospitalName", ВыборкаДанных.НазваниеОрганизации);
		Запись.ЗаписатьАтрибут("RequestNr", ВыборкаДанных.Номер);
		Запись.ЗаписатьАтрибут("ExternalRequestId", Строка(ВыборкаДанных.Документ.УникальныйИдентификатор()));
		Запись.ЗаписатьАтрибут("LastName", ВыборкаДанных.КлиентФамилия);
		Запись.ЗаписатьАтрибут("FirstName", ВыборкаДанных.КлиентИмя);
		Запись.ЗаписатьАтрибут("MiddleName", ВыборкаДанных.КлиентОтчество);
		Запись.ЗаписатьАтрибут("VisitDate", Формат(ВыборкаДанных.Дата, ""));
		Запись.ЗаписатьАтрибут("Comment", ВыборкаДанных.Комментарий);
		Запись.ЗаписатьАтрибут("TotalMoney", Формат(ВыборкаДанных.СуммаДокумента * 100, "ЧГ="));
		Если ЗначениеЗаполнено(ВыборкаДанных.НомерКарты) Тогда
			Запись.ЗаписатьАтрибут("DiscountCode", Формат(ВыборкаДанных.КодЕИП, "ЧГ="));
			Запись.ЗаписатьАтрибут("CardBarcode", ВыборкаДанных.НомерКарты);
		Иначе
			СведенияОКарте = ПоискКартыПоИИН(ВыборкаДанных.КлиентИНН);
			Запись.ЗаписатьАтрибут("CardBarcode", СведенияОКарте.НомерКарты);
			Запись.ЗаписатьАтрибут("DiscountCode", Формат(СведенияОКарте.КодСкидкиЕИП, "ЧГ="));
			КлиентОбъект = ВыборкаДанных.Клиент.ПолучитьОбъект();
			Если Не КлиентОбъект.омг_КартыСкидок.Количество() = 0 Тогда
				КлиентОбъект.омг_КартыСкидок[0].НомерКарты = СведенияОКарте.НомерКарты;
				КлиентОбъект.ОбменДанными.Загрузка = Истина;
				КлиентОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		
		Запись.ЗаписатьКонецЭлемента(); //Params 
		
		Запись.ЗаписатьКонецЭлемента(); //MethodCall
		
		Запись.ЗаписатьКонецЭлемента(); //Envelope
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Документ", ВыборкаДанных.Документ);
		СтруктураДанных.Вставить("ДокументПредставление", ВыборкаДанных.ДокументПредставление);
		СтруктураДанных.Вставить("КлиентПредставление", ВыборкаДанных.КлиентПредставление);
		СтруктураДанных.Вставить("ТекстЗапроса", Запись.Закрыть());
		
		МассивРезультатов.Добавить(СтруктураДанных);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат МассивРезультатов;
	
КонецФункции

Процедура ИнтеграцияЕИП_ОтправкаНачисленийНаКартыКлиентов() Экспорт

	МассивТекстовЗапросов = ПолучитьДанныеДляЗапросовНачисленийНаКарту();
	
	ЗаписьЖурналаРегистрации("Интеграция с ЕИП: Подготовка начислений на карту", 
		УровеньЖурналаРегистрации.Информация,, , 
		"Всего подготовлено: " + МассивТекстовЗапросов.Количество(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
		
	УспешноОтправлено = 0;	
	
	Для Каждого ДанныеОтправки Из МассивТекстовЗапросов Цикл
		
		Ответ = ВызватьСерверЕИП(ДанныеОтправки.ТекстЗапроса);
		
		Если Ответ = Неопределено Или НЕ Ответ.КодСостояния = 200 Тогда
			Продолжить;
		КонецЕсли;
		
		ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		
		//читаем xml в переменную
		ОтветXML = Новый ЧтениеXML();
		ОтветXML.УстановитьСтроку(ОтветСтрокой);
		
		//десериализуем текст в объект с помощью фабрики
		Объектxdto = ДесериализоватьОтветЧерезФабрику("ИнтеграцияЕИП_ОтветОтправкаНачисленийКлиенту",ОтветXML);
		
		ТекстОшибки = "";
		
		Если Не Объектxdto.Свойства().Получить("error") = Неопределено Тогда
			ТекстОшибки = "Документ """ + ДанныеОтправки.ДокументПредставление + """, ошибка: " + Объектxdto.Error.description;
			ЗаписьЖурналаРегистрации("Интеграция с ЕИП: Отправка начислений на карту", 
				УровеньЖурналаРегистрации.Ошибка,, "Ошибка получения данных", ТекстОшибки, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
		КонецЕсли;
		
		Свойства = Объектxdto.MethodResponse.Свойства();
		
		Если Не Объектxdto.MethodResponse.Result.Errors.Свойства().Получить("item") = Неопределено Тогда
			ТекстОшибки = "Документ """ + ДанныеОтправки.ДокументПредставление + """, ошибка: " + Объектxdto.MethodResponse.Result.Errors.item.Message;
			ЗаписьЖурналаРегистрации("Интеграция с ЕИП: Отправка начислений на карту", 
				УровеньЖурналаРегистрации.Ошибка,, "Ошибка получения даннных", ТекстОшибки, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
		КонецЕсли;
			
		Если Не ТекстОшибки = "" Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации("Интеграция с ЕИП: Отправка начислений на карту", 
			УровеньЖурналаРегистрации.Информация,, "Успешеная отправка начислений на карту клиента", 
			"Документ """ + ДанныеОтправки.ДокументПредставление + """, клиент """ + ДанныеОтправки.КлиентПредставление, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
		
		Запись = РегистрыСведений.омг_ДокументыНачисленийНаКартыЕИП.СоздатьМенеджерЗаписи();
		Запись.Документ = ДанныеОтправки.Документ;
		Запись.Удалить();
		
		УспешноОтправлено = УспешноОтправлено + 1;
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("Интеграция с ЕИП: Завершение отправки начислений на карты", 
		УровеньЖурналаРегистрации.Информация,, "", 
		"Всего отправлено успешно: " + УспешноОтправлено + " из " + МассивТекстовЗапросов.Количество(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
		
КонецПроцедуры

#КонецОбласти

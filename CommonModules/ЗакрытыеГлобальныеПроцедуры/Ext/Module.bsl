Функция КлючПродуктаБИТСЛК(ИмяПродукта = Неопределено)
	Если ИмяПродукта = Неопределено Тогда
		Возврат доп_Защита_Конфигурации.КлючПродухтаБИТСЛК(ИмяПродукта);
	КонецЕсли;
КонецФункции
Процедура дкОбработкаПроведенияДокументовОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Попытка
		ПроверкаЗащитыКонфигурации(Отказ);
	Исключение
		Отказ = Истина;
	КонецПопытки;
КонецПроцедуры
Функция ВалидацияПротекцииОперации(Отказ = Ложь, ИмяМодуля = "") Экспорт
	Валидатор = Новый ГенераторСлучайныхЧисел;
	Ошибка = Не Булево(Валидатор.RandomNumber(1, 100));
	Если ЗначениеЗаполнено(ИмяМодуля) Тогда
		Если ИмяМодуля = "2" И доп_Защита_Конфигурации.ИспользуемаяВерсияСистемыЛицензирования() = "2.0" Тогда
			Если ЭтоУМЦ() Тогда
				ПроверкаЗащитыКонфигурации(Ошибка, Истина, , Ложь);
			Иначе
				Ошибка = Истина;
			КонецЕсли;
		ИначеЕсли МодулиТребующиеПТС().Найти(ИмяМодуля) <> Неопределено Тогда
			Ошибка = Ошибка Или Не МодульПоПТСДоступен(ИмяМодуля);
		Иначе
			ИменаМодулей = ЛицензииСодержащиеМодуль(ИмяМодуля);
			Ошибка = Ошибка Или Не ЕстьЛиЖизньНаМарсе(ИменаМодулей);
		КонецЕсли;
	Иначе
		ПроверкаЗащитыКонфигурации(Ошибка);
	КонецЕсли;
	Отказ = Отказ Или Ошибка;
	Возврат Не Ошибка;
КонецФункции
Функция ЭтоУМЦ()
	Если доп_Защита_Конфигурации.МетаданныеЛицензируемогоПродукта().productId = доп_Защита_Конфигурации.СтруктураМетаданных_УМЦ20().ИдентификаторПродукта Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции
Функция ЕстьВДеревнеКолбаса(Отказ = Ложь) Экспорт
	Возврат ВалидацияПротекцииОперации(Отказ);
КонецФункции

	КонецПопытки;
	
КонецПроцедуры

Процедура ДобавитьВМассив(Массив,Ключ,Значение)
	Массив.Добавить(Новый Структура("Ключ,Значение",Ключ,Значение));
КонецПроцедуры

Процедура ЗаполнитьОбъектXDTO(Объект, ДанныеЗаполнения, Фабрика_XDTO = Неопределено) Экспорт
	Для Каждого КлючЗначение Из ДанныеЗаполнения Цикл
		Ключи = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КлючЗначение.Ключ, ".");
		ТекущийОбъект = Объект;
		ПредыдущийОбъект = Неопределено;
		Для Каждого Ключ Из Ключи Цикл
			ПредыдущийОбъект = ТекущийОбъект;
			Если Не ЭтоАтрибут(Ключ) Тогда
				Если ОбъектСуществует(ТекущийОбъект,Ключ) Тогда
					ТекущийОбъект = ПолучитьОбъектПоля(ТекущийОбъект,Ключ);
				Иначе
					ТекущийОбъект = СоздатьОбъектПоля(ТекущийОбъект, Ключ, Фабрика_XDTO);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ТекущийОбъект <> Неопределено Тогда
			Если КлючЗначение.Значение <> Неопределено И КлючЗначение.Значение <> "" Тогда
				Если ЭтоАтрибут(Ключ) Тогда
					ТекущийОбъект[ИмяКлюча(Ключ)] = КлючЗначение.Значение;
				Иначе
					ТекущийОбъект.Последовательность().Добавить(КлючЗначение.Значение, Неопределено);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ПредыдущийОбъект[ИмяКлюча(Ключ)] = КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

Функция СериализоватьОбъектXDTO(ОбъектXDTO, Кодировка = "", Фабрика_XDTO = Неопределено) Экспорт
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(?(ПустаяСтрока(Кодировка), "UTF-8", Кодировка));
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	Если Фабрика_XDTO = Неопределено Тогда
		ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO);
	Иначе
		Фабрика_XDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO);
	КонецЕсли;
	Возврат ЗаписьXML.Закрыть();
КонецФункции

Функция СоздатьОбъект_RCMR_IN000002UV02(ТекстДокумента, Фабрика_XDTO = Неопределено) Экспорт
	ДанныеЗаполнения = Новый Массив;
	ДобавитьВМассив(ДанныеЗаполнения,"id.@root",Строка(Новый УникальныйИдентификатор()));
	ДобавитьВМассив(ДанныеЗаполнения,"creationTime.@value",Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"));
	ДобавитьВМассив(ДанныеЗаполнения,"@ITSVersion","XML_1.0");
	ДобавитьВМассив(ДанныеЗаполнения,"interactionId.@extension","RCMR_IN000002UV02");
	ДобавитьВМассив(ДанныеЗаполнения,"interactionId.@root","2.16.840.1.113883.1.18");
	ДобавитьВМассив(ДанныеЗаполнения,"processingCode.@code","P");
	ДобавитьВМассив(ДанныеЗаполнения,"processingModeCode.@code","T");
	ДобавитьВМассив(ДанныеЗаполнения,"acceptAckCode.@code","AL");
	ДобавитьВМассив(ДанныеЗаполнения,"receiver.@typeCode","RCV");
	ДобавитьВМассив(ДанныеЗаполнения,"receiver.device.@classCode","DEV");
	ДобавитьВМассив(ДанныеЗаполнения,"receiver.device.@determinerCode","INSTANCE");
	ДобавитьВМассив(ДанныеЗаполнения,"receiver.device.id.@nullFlavor","NI");
	ДобавитьВМассив(ДанныеЗаполнения,"sender.@typeCode","SND");
	ДобавитьВМассив(ДанныеЗаполнения,"sender.device.@classCode","DEV");
	ДобавитьВМассив(ДанныеЗаполнения,"sender.device.@determinerCode","INSTANCE");
	ДобавитьВМассив(ДанныеЗаполнения,"sender.device.id.@nullFlavor","NI");
	ДобавитьВМассив(ДанныеЗаполнения,"controlActProcess.@classCode","CACT");
	ДобавитьВМассив(ДанныеЗаполнения,"controlActProcess.@moodCode","EVN");
	ДобавитьВМассив(ДанныеЗаполнения,"controlActProcess.text.@mediaType","multipart/related");
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ВремФайл = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	ВремФайл.Записать(ТекстДокумента);
	ВремФайл.Закрыть();
	
	ТелоСообщения = "
	|MIME-Version: 1.0
	|Content-Type: multipart/related; boundary=""HL7-CDA-boundary"";
	|type=""text/xml"";
	|Content-Transfer-Encoding: BASE64
	|
	|--HL7-CDA-boundary
	|Content-Type: text/xml; charset=UTF-8
	|
	|"
	+ Base64Строка(Новый ДвоичныеДанные(ИмяФайла))
	+ "
	|
	|    --HL7-CDA-boundary--
	|";
	
	ДобавитьВМассив(ДанныеЗаполнения,"controlActProcess.text",ТелоСообщения);
	
	Тип_RCMR_IN000002UV02 = ФабрикаXDTO.Тип("urn:hl7-org:v3","RCMR_IN000002UV02");
	СообщениеОбъект = ФабрикаXDTO.Создать(Тип_RCMR_IN000002UV02);
	
	ЗаполнитьОбъектXDTO(СообщениеОбъект, ДанныеЗаполнения, Фабрика_XDTO);
	
	Возврат СообщениеОбъект;
	
КонецФункции

Функция ПолучитьКодПола(ПолСсылка) Экспорт
	Если ПолСсылка = Перечисления.ПолФизическихЛиц.Женский Тогда
		Возврат "F";
	ИначеЕсли ПолСсылка = Перечисления.ПолФизическихЛиц.Мужской Тогда
		Возврат "M";
	ИначеЕсли ПолСсылка = Перечисления.ПолФизическихЛиц.НеУказан Тогда
		Возврат "UN";
	КонецЕсли;
	
	Возврат "";
КонецФункции

Функция ПолучитьОбъектПоля(Объект, Ключ)
	Если ТипЗнч(Объект[ИмяКлюча(Ключ)]) = Тип("СписокXDTO") Тогда
		Если ЭтоСписок(Ключ) Тогда
			Индекс = ПолучитьИндекс(Ключ);
			Возврат Объект[ИмяКлюча(Ключ)].Получить(Индекс);
		Иначе
			Возврат Объект[ИмяКлюча(Ключ)].Получить(0);
		КонецЕсли;
	Иначе
		Возврат Объект[ИмяКлюча(Ключ)];
	КонецЕсли;
	
КонецФункции

Функция ЭтоАтрибут(Ключ)
	Если Лев(Ключ,1) = "@" Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Функция ИмяКлюча(Ключ)
	Если ЭтоАтрибут(Ключ) Тогда
		Возврат ИмяКлюча(Прав(Ключ,СтрДлина(Ключ) - 1));
	ИначеЕсли ЭтоСписок(Ключ) Тогда
		ЧастиКлюча = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Ключ, "[");
		Возврат ИмяКлюча(ЧастиКлюча[0]);
	ИначеЕсли КлючСодержитТип(Ключ) Тогда
		ЧастиКлюча = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Ключ, "{");
		Возврат ЧастиКлюча[0];
	Иначе
		Возврат Ключ;
	КонецЕсли;
КонецФункции

Функция ОбъектСуществует(Объект, Ключ)
	Если ТипЗнч(Объект[ИмяКлюча(Ключ)]) = Тип("СписокXDTO") Тогда
		Список = Объект[ИмяКлюча(Ключ)];
		
		Если ЭтоСписок(Ключ) Тогда
			Индекс = ПолучитьИндекс(Ключ);
			Возврат Список.Количество() > Индекс;
		Иначе
			Возврат Список.Количество() <> 0;
		КонецЕсли;
	Иначе
		Возврат Объект[ИмяКлюча(Ключ)] <> Неопределено;
	КонецЕсли;
КонецФункции

Функция СоздатьОбъектПоля(Объект, Ключ, Фабрика_XDTO = Неопределено)
	
	Если КлючСодержитТип(Ключ) Тогда
		ОписаниеТипаXDTO = ПолучитьИмяТипа(Ключ);
		ТипXDTO = ПолучитьТипXDTO(ОписаниеТипаXDTO.ИмяТипа, ОписаниеТипаXDTO.ПространствоИмен, Фабрика_XDTO);
	Иначе
		ТипXDTO = Объект.Тип().Свойства.Получить(ИмяКлюча(Ключ)).Тип;
	КонецЕсли;
	Результат = СоздатьОбъектXDTO(ТипXDTO, Фабрика_XDTO);
	
	Если Результат <> Неопределено Тогда
		Если ТипЗнч(Объект[ИмяКлюча(Ключ)]) = Тип("СписокXDTO") Тогда
			Объект[ИмяКлюча(Ключ)].Добавить(Результат);
		Иначе
			Объект[ИмяКлюча(Ключ)] = Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция КлючСодержитТип(Ключ)
	Возврат Найти(Ключ,"{") <> 0;
КонецФункции

Функция ЭтоСписок(Ключ)
	Если Прав(Ключ,1) = "]" Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Функция ПолучитьИндекс(Ключ)
	ЧастиКлюча = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Ключ, "[");
	Возврат Число(Лев(ЧастиКлюча[1],СтрДлина(ЧастиКлюча[1])-1));
КонецФункции

Функция ПолучитьИмяТипа(Ключ)
	Лево = Найти(Ключ,"{");
	Право = Найти(Ключ,"}");
	Зпт = Найти(Ключ,",");
	Содержимое = Сред(Ключ,Лево + 1,Право - Лево - 1);
	ПространствоИмен = ВосстановитьПространствоИмен(Лев(Содержимое,Зпт - Лево - 1));
	ИмяТипа = Прав(Содержимое,Право - Зпт - 1);
	Возврат Новый Структура("ПространствоИмен, ИмяТипа", ПространствоИмен, ИмяТипа);
КонецФункции

Функция СоздатьОбъектXDTO(ТипОбъекта, Фабрика_XDTO = Неопределено)
	
	Если Фабрика_XDTO = Неопределено Тогда
		Возврат ФабрикаXDTO.Создать(ТипОбъекта);
	Иначе
		Возврат Фабрика_XDTO.Создать(ТипОбъекта);
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТипXDTO(ИмяТипа, ПространствоИмен, Фабрика_XDTO = Неопределено)
	
	Если Фабрика_XDTO = Неопределено Тогда
		Возврат ФабрикаXDTO.Тип(ПространствоИмен, ИмяТипа);
	Иначе
		Возврат Фабрика_XDTO.Тип(ПространствоИмен, ИмяТипа);
	КонецЕсли;
	
КонецФункции

Функция ВосстановитьПространствоИмен(ПИ)
	Возврат СтрЗаменить(ПИ,"#<dot>#",".");
КонецФункции

Функция ПолучитьПриемПоЗаказу(Знач Заказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Прием.Ссылка,
	|	ВЫБОР
	|		КОГДА Прием.Проведен
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Документ.Прием КАК Прием
	|ГДЕ
	|	Прием.Основание = &Заказ
	|	И НЕ Прием.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Прием.Дата УБЫВ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		Возврат Неопределено;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ПолучениеРезультатаАнализа // Получение результатов из 1С:Клиническая лаборатория

Функция ОбработатьТекстСообщенияОтЛаборатории(Message) Экспорт
	
	Попытка
		
		ТекстСообщения = ПолучитьТекстВложенногоДокумента(Message);
		
		ЧтениеXML = Новый ЧтениеXML; 
		ЧтениеXML.УстановитьСтроку(ТекстСообщения);
		
		ДокументXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML,
		ФабрикаXDTO.Пакеты.Получить("urn:hl7-org:v3").Получить("POCD_MT000040.ClinicalDocument"));
		ГУИДДокумента = Новый УникальныйИдентификатор(ДокументXDTO.Id.Root);
		Документ = Документы.ЗаказНаИсследованиеВнутренний.ПолучитьСсылку(ГУИДДокумента).ПолучитьОбъект();
		
		НомерОт = Найти(ТекстСообщения,"<text>") + 6;
		НомерДо = Найти(ТекстСообщения,"</text>") - 1;
		
		РезультатИсследования = Прав(Лев(ТекстСообщения,НомерДо), СтрДлина(Лев(ТекстСообщения,НомерДо)) - НомерОт);
		
		НомерОт = Найти(ТекстСообщения,"<title>") + 6;
		НомерДо = Найти(ТекстСообщения,"</title>") - 1;
		
		Title = Прав(Лев(ТекстСообщения,НомерДо), СтрДлина(Лев(ТекстСообщения,НомерДо)) - НомерОт);
		
		Если Строка(Message.Тип()) = "{urn:hl7-org:v3}POLB_IN224100UV01" Тогда
			Документ.Статус = Перечисления.СтатусыОтправкиЗаказовНаИсследовние.ПолученЧастичныйРезультат;		
		Иначе
			Документ.Статус = Перечисления.СтатусыОтправкиЗаказовНаИсследовние.ПолученРезультат;
		КонецЕсли;
		
		Документ.Врач = Документ.ВебСервис.Сотрудник;
		
		Попытка
			УидАнализаСтрока = ДокументXDTO.inFulfillmentOf[0].order.Id[0].Root;
			УидАнализа = Новый УникальныйИдентификатор(УидАнализаСтрока);
		Исключение
			УидАнализа = Неопределено;
		КонецПопытки;
		
		СтрокаИсследования = Неопределено;
		Для Каждого СтрокаИсследованияТек Из Документ.Исследования Цикл
			Если СтрокаИсследованияТек.Ид = УидАнализа
				Или СтрокаИсследованияТек.Номенклатура.УникальныйИдентификатор() = УидАнализа
				Тогда
				СтрокаИсследования = СтрокаИсследованияТек;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		РезультатИсследования = "<p>"+Title+"</p>"+РезультатИсследования;
		ДокументDOM = СоздатьДокументDOMИзHTML(РезультатИсследования);
		РезультатИсследованияHTML = ПолучитьТекстHTMLИзДокументаDOM(ДокументDOM);
		
		СтрокаПеренос = РаботаСШаблонамиHTMLКлиентСервер.ПолучитьТекстHTMLРазрывСтраницы(Ложь);
		
		Если СтрокаИсследования = Неопределено Тогда
			Если ЗначениеЗаполнено(УидАнализа) Тогда
				СтрокаИсследования = Документ.Исследования.Добавить();
				СтрокаИсследования.ИД = УидАнализа;
				СтрокаИсследования.РезультатИсследования = РезультатИсследованияHTML;
			Иначе
				ДокументРезультат = Документ.Результат.Получить();
				Если ЗначениеЗаполнено(ДокументРезультат) Тогда
					ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ДокументРезультат, РезультатИсследованияHTML, СтрокаПеренос, Истина);
				Иначе
					ДокументРезультат = РезультатИсследованияHTML;
				КонецЕсли;
				Документ.Результат = Новый ХранилищеЗначения(ДокументРезультат);
			КонецЕсли;
		Иначе
			СтрокаИсследования.РезультатИсследования = РезультатИсследованияHTML;
		КонецЕсли;
		
		Документ.Записать();
		
		// Создание приема.
		Если Документ.Статус = Перечисления.СтатусыОтправкиЗаказовНаИсследовние.ПолученРезультат Тогда
			
			ПриемСсылка = ВзаимодействиеСЛИС.ПолучитьПриемПоЗаказу(Документ.Ссылка);
			
			Если ПриемСсылка <> Неопределено Тогда 
				ПриемОбъект = ПриемСсылка.ПолучитьОбъект();
			Иначе
				ПриемОбъект = Документы.Прием.СоздатьДокумент();
			КонецЕсли;
			
			ПриемОбъект.Дата = ТекущаяДата();
			ПриемОбъект.ДополнительныеСвойства.Вставить("НеДелатьПроверокПриЗаписи", Истина);
			
			Если ЗначениеЗаполнено(УидАнализа) Тогда
				ПредставлениеВсехИсследований = "";
			Иначе
				ПредставлениеВсехИсследований = Документ.Результат.Получить();
				ПредставлениеВсехИсследований = ?(ЗначениеЗаполнено(ПредставлениеВсехИсследований),ПредставлениеВсехИсследований,"");
			КонецЕсли;
			
			Для Каждого СтрокаИсследования Из Документ.Исследования Цикл
				ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ПредставлениеВсехИсследований, СтрокаИсследования.РезультатИсследования, СтрокаПеренос, Истина);
			КонецЦикла;
			
			Если ПриемОбъект.Проведен Тогда
				ПриемОбъект.Осмотр = ПредставлениеВсехИсследований;
				ПриемОбъект.Записать();
				Документ.Статус = Перечисления.СтатусыОтправкиЗаказовНаИсследовние.Обработан;
			Иначе
				ПриемОбъект.Заполнить(Документ.Ссылка);
				ПриемОбъект.Осмотр = ПредставлениеВсехИсследований;
				Попытка
					ПриемОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Документ.Статус = Перечисления.СтатусыОтправкиЗаказовНаИсследовние.Обработан;
				Исключение	КонецПопытки;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПриемОбъект.Ссылка) Тогда
				УстановитьОтметкиДляДействийПМО(ПриемОбъект.Ссылка, Документ.Ссылка);
			КонецЕсли;
			
		КонецЕсли;
		
		Документ.Записать();
		
		Результат = ОтправитьОтвет(ДокументXDTO);
		
	Исключение
		Ошибка = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Сообщение от ЛИС",УровеньЖурналаРегистрации.Ошибка,,,Ошибка);
		Результат = ОтправитьОтвет(ДокументXDTO, Ошибка);
	КонецПопытки;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, Результат);
	
	Возврат Результат;
	
КонецФункции 

Процедура УстановитьОтметкиДляДействийПМО(Прием, ЗаказНаИсследование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказВоВнешнююЛабораториюИсследования.Ссылка КАК Ссылка,
		|	ЗаказВоВнешнююЛабораториюИсследования.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ДанныеЗаказовНеобходимыхОбработать
		|ИЗ
		|	Документ.ЗаказНаИсследованиеВнутренний.Исследования КАК ЗаказВоВнешнююЛабораториюИсследования
		|ГДЕ
		|	ЗаказВоВнешнююЛабораториюИсследования.Ссылка = &ЗаказНаИсследование
		|	И ЗаказВоВнешнююЛабораториюИсследования.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрохождениеМедосмотраДействияМедосмотра.Действие КАК Действие,
		|	ПрохождениеМедосмотраДействияМедосмотра.Ссылка КАК СсылкаПМО,
		|	&Прием КАК Прием
		|ИЗ
		|	ДанныеЗаказовНеобходимыхОбработать КАК ДанныеЗаказовНеобходимыхОбработать
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрохождениеМедосмотра.ДействияМедосмотра КАК ПрохождениеМедосмотраДействияМедосмотра
		|		ПО ДанныеЗаказовНеобходимыхОбработать.Ссылка.Клиент = ПрохождениеМедосмотраДействияМедосмотра.Ссылка.Клиент
		|			И ДанныеЗаказовНеобходимыхОбработать.Номенклатура = ПрохождениеМедосмотраДействияМедосмотра.Действие.Номенклатура
		|			И (ПрохождениеМедосмотраДействияМедосмотра.Ссылка.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПрохождениеМедосмотраДействияМедосмотра.Ссылка.Дата";
	
	Запрос.УстановитьПараметр("ЗаказНаИсследование", ЗаказНаИсследование);
	Запрос.УстановитьПараметр("Прием", Прием);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МедосмотрыСервер.УстановитьОтметкиДляДействийПМОПоВыборке(Выборка);
	
КонецПроцедуры

Функция ПолучитьТекстВложенногоДокумента(Сообщение) Экспорт
	
	Содержимое = Сообщение.controlActProcess.text;
	Если Содержимое = Неопределено Тогда
		ВызватьИсключение "Атрибут controlActProcess.text пустой";
	КонецЕсли;
	
	Текст = Содержимое.Последовательность().ПолучитьТекст(0);
	Пакет = ПолучитьСодержимоеMIMEПакета(Текст);
	
	Если Пакет.Секции.Количество() = 0 Тогда
		ВызватьИсключение "Вложенное сообщение не найдено";
	КонецЕсли;
	
	ДвоичныеДанные = Base64Значение(Пакет.Секции[0].Тело);
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ДвоичныеДанные.Записать(ИмяФайла);
	
	
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ИмяФайла, "UTF-8");
	Документ = Текст.ПолучитьТекст();

	УдалитьФайлКаталог(ИмяФайла);
	
	Возврат Документ;
	
КонецФункции

Функция ОтправитьОтвет(Документ ,Ошибка = "")
	
	Если Ошибка = "" Тогда 
		Возврат СоздатьОтвет_MCCI_IN000002UV01(Документ, Ложь);
	Иначе
		ДетальОшибки = Новый Структура("ТекстОшибки, location", Ошибка, "");
		ДеталиОшибки = Новый Массив;
		ДеталиОшибки.Добавить(ДетальОшибки);
		Возврат СоздатьОтвет_MCCI_IN000002UV01(Документ, Истина, ДеталиОшибки);
	КонецЕсли;
	
КонецФункции

Функция СоздатьОтвет_MCCI_IN000002UV01(Документ, Ошибка = Ложь, ДеталиОшибки = Неопределено)

	Если Ошибка Тогда
		ТекстОбъектаXDTO = СериализоватьОбъектXDTO(Документ);
		ЗаписьЖурналаРегистрации(
			"Обмены данными с МИС. Получения сообщения от МИС. Сервис HL7v3Exchange ProcessHL7v3Message",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка в HL7v3Exchange.ProcessHL7v3Message."
			+ Символы.ПС + ТекстОбъектаXDTO
		);
	КонецЕсли;

	Попытка
		Если Документ.acceptAckCode.code = "NE" Тогда
			Возврат Неопределено;
		ИначеЕсли Ошибка = Ложь И Документ.acceptAckCode.code = "ER" Тогда
			Возврат Неопределено;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	СообщенияЗагрузки = "";
	
	Данные = Новый Структура("targetMessageid, AcknowledgementTypeCode, Сообщение, AcknowledgementDetailTypeCode, ДеталиОшибки");
	
	Попытка
		Данные.targetMessageid = Документ.id.root;
	Исключение
	КонецПопытки;
	
	Данные.Сообщение = СообщенияЗагрузки;
	
	Если Ошибка И ДеталиОшибки = Неопределено Тогда
		Данные.AcknowledgementTypeCode = "AE";
		Данные.AcknowledgementDetailTypeCode = "E";
	Иначе
		Данные.AcknowledgementTypeCode = "AA";
		Данные.AcknowledgementDetailTypeCode = "W";
	КонецЕсли;
	
	Данные.Сообщение = СообщенияЗагрузки;
	Данные.ДеталиОшибки = ДеталиОшибки;
	
	Возврат СоздатьОбъект_MCCI_IN000002UV01(Данные);
КонецФункции

Функция ПолучитьСодержимоеMIMEПакета(ТекстСообщения)
	
	Сообщение = Новый ТекстовыйДокумент;
	Сообщение.УстановитьТекст(СокрЛП(ТекстСообщения));
	
	НомерСтроки = 0;
	
	ПропуститьПустыеСтроки(Сообщение, НомерСтроки);
	
	Заголовок = "MIME-Version:"; // 1.0
	ПерваяСтрока = СокрЛП(Сообщение.ПолучитьСтроку(НомерСтроки));
	Если Не ВРег(Лев(ПерваяСтрока, СтрДлина(Заголовок))) = ВРег(Заголовок) Тогда
		ВызватьИсключение "Неправильный заголовок MIME-пакета";
	КонецЕсли;
	
	Пакет = Новый Структура;
	
	// Параметры пакета
	НомерСтроки = НомерСтроки + 1;
	ПараметрыЗаголовка = ПолучитьПараметрыMIMEПакета(Сообщение, НомерСтроки);
	Пакет.Вставить("Параметры", ПараметрыЗаголовка);
	Пакет.Вставить("Секции", Новый Массив);
	
	ТипСодержимого = ПараметрыЗаголовка.Получить("Content-Type");
	Если Не ТипСодержимого = Неопределено Тогда
		Если Не ТипСодержимого.Получить("multipart") = Неопределено Тогда
			РазделительСекций = ТипСодержимого.Получить("boundary");
			Если Не РазделительСекций = Неопределено Тогда
				Секция = ПолучитьСледующуюСекциюMIMEПакета(Сообщение, НомерСтроки, РазделительСекций);
				Пока Не Секция = Неопределено Цикл
					Пакет.Секции.Добавить(Секция);
					Секция = ПолучитьСледующуюСекциюMIMEПакета(Сообщение, НомерСтроки, РазделительСекций);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Пакет;
	
КонецФункции

Процедура УдалитьФайлКаталог(ИмяФайлаКаталога) Экспорт
	
	УдаляемыйОбъект = Новый Файл(ИмяФайлаКаталога);
	
	Если УдаляемыйОбъект.Существует() Тогда
		УдалитьФайлы(ИмяФайлаКаталога);
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьОбъект_MCCI_IN000002UV01(Данные)
	
	ТипMCCI_IN000002UV01 = ТипHL7("MCCI_IN000002UV01");
	ТипИД = ТипHL7("II");
	ТипДата = ТипHL7("TS");
	ТипКод = ТипHL7("CS");
	
	СообщениеОбъектXDTO = СоздатьОбъектXDTO(ТипMCCI_IN000002UV01);
	
	СообщениеОбъектXDTO.id = СоздатьОбъектXDTO(ТипИД);
	СообщениеОбъектXDTO.id.root = Строка(Новый УникальныйИдентификатор);
	
	СообщениеОбъектXDTO.interactionId = СоздатьОбъектXDTO(ТипИД);
	СообщениеОбъектXDTO.interactionId.root = "2.16.840.1.113883.1.18";
	СообщениеОбъектXDTO.interactionId.extension = "MCCI_IN000002UV01";
		
	СообщениеОбъектXDTO.creationTime = СоздатьОбъектXDTO(ТипДата);
	СообщениеОбъектXDTO.creationTime.value = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
	
	СообщениеОбъектXDTO.processingCode = СоздатьОбъектXDTO(ТипКод);
	СообщениеОбъектXDTO.processingCode.code = "P";
	
	СообщениеОбъектXDTO.processingModeCode = СоздатьОбъектXDTO(ТипКод);
	СообщениеОбъектXDTO.processingModeCode.code = "T";
	
	СообщениеОбъектXDTO.acceptAckCode = СоздатьОбъектXDTO(ТипКод);
	СообщениеОбъектXDTO.acceptAckCode.code = "NE";
	
	ТипПолучателя = ТипMCCI_IN000002UV01.Свойства.Получить("receiver").Тип;
	ТипУстройства = ТипПолучателя.Свойства.Получить("device").Тип;
	Получатель = СоздатьОбъектXDTO(ТипПолучателя);
	Получатель.typeCode = "RCV";
	Получатель.device = СоздатьОбъектXDTO(ТипУстройства);
	Получатель.device.classCode = "DEV";
	Получатель.device.determinerCode = "INSTANCE";
	Получатель.device.id.Добавить(СоздатьОбъектXDTO(ТипИД));
	Получатель.device.id[0].nullflavor = "NI";
	
	СообщениеОбъектXDTO.receiver.Добавить(Получатель);
	
	ТипОтправителя = ТипMCCI_IN000002UV01.Свойства.Получить("sender").Тип;
	ТипУстройства = ТипОтправителя.Свойства.Получить("device").Тип;
	Отправитель = СоздатьОбъектXDTO(ТипОтправителя);
	Отправитель.typeCode = "SND";
	Отправитель.device = СоздатьОбъектXDTO(ТипУстройства);
	Отправитель.device.classCode = "DEV";
	Отправитель.device.determinerCode = "INSTANCE";
	Отправитель.device.id.Добавить(СоздатьОбъектXDTO(ТипИД));
	Отправитель.device.id[0].nullflavor = "NI";
	
	СообщениеОбъектXDTO.sender = Отправитель;
	
	ТипТелоСообщенияЗагрузки = ТипMCCI_IN000002UV01.Свойства.Получить("acknowledgement").Тип;
	ТипИсходноеСообщение = ТипТелоСообщенияЗагрузки.Свойства.Получить("targetMessage").Тип;
	
	ТелоСообщенияЗагрузки = СоздатьОбъектXDTO(ТипТелоСообщенияЗагрузки);
	СообщениеОбъектXDTO.acknowledgement.Добавить(ТелоСообщенияЗагрузки);
	
	ТелоСообщенияЗагрузки.typeCode = Данные.AcknowledgementTypeCode;
	ТелоСообщенияЗагрузки.targetMessage = СоздатьОбъектXDTO(ТипИсходноеСообщение);
	ТелоСообщенияЗагрузки.targetMessage.id = СоздатьОбъектXDTO(ТипИД);
	ТелоСообщенияЗагрузки.targetMessage.id.root = Строка(Данные.targetMessageid);
	
	Если Данные.Свойство("Сообщение") И ЗначениеЗаполнено(Данные.Сообщение) Тогда
		
		ТипДетали = ТипТелоСообщенияЗагрузки.Свойства.Получить("acknowledgementDetail").Тип;
		Детали = СоздатьОбъектXDTO(ТипДетали);
		ТелоСообщенияЗагрузки.acknowledgementDetail.Добавить(Детали);
		Детали.typeCode = Данные.AcknowledgementDetailTypeCode;
		Детали.text = СоздатьОбъектXDTO(ТипHL7("ED"));
		Детали.text.Последовательность().Добавить(Данные.Сообщение, Неопределено);
		
	КонецЕсли;
	
	Если Данные.Свойство("ДеталиОшибки") И Данные.ДеталиОшибки <> Неопределено Тогда
		ТипДетали = ТипТелоСообщенияЗагрузки.Свойства.Получить("acknowledgementDetail").Тип;
		Для Каждого ДанныеОшибки Из Данные.ДеталиОшибки Цикл
			Детали = СоздатьОбъектXDTO(ТипДетали);
			ТелоСообщенияЗагрузки.acknowledgementDetail.Добавить(Детали);
			Детали.typeCode = "E";
			Детали.text = СоздатьОбъектXDTO(ТипHL7("ED"));
			Детали.text.Последовательность().Добавить(ДанныеОшибки.ТекстОшибки, Неопределено);
			
			ШаблонИдентификатора = СоздатьОбъектXDTO(ТипHL7("II"));
			ШаблонИдентификатора.extension = "LabResultStatus";
			Детали.templateId.Добавить(ШаблонИдентификатора);

			Location = СоздатьОбъектXDTO(ТипHL7("ST"));
			Детали.location.Добавить(Location);
			Детали.location[0].Последовательность().Добавить(ДанныеОшибки.location, Неопределено);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СообщениеОбъектXDTO;
	
КонецФункции

Процедура ПропуститьПустыеСтроки(Сообщение, НомерСтроки)
	
	КоличествоСтрок = Сообщение.КоличествоСтрок();
	Пока НомерСтроки <= КоличествоСтрок И ПустаяСтрока(Сообщение.ПолучитьСтроку(НомерСтроки)) Цикл
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПараметрыMIMEПакета(Сообщение, НомерСтроки)
	
	ИмяПараметра = "";
	ПараметрыЗаголовка = Новый Соответствие;
	КоличествоСтрок = Сообщение.КоличествоСтрок();
	Пока НомерСтроки <= КоличествоСтрок И Не ПустаяСтрока(Сообщение.ПолучитьСтроку(НомерСтроки)) Цикл
		
		СтрокаПараметра = СокрЛП(Сообщение.ПолучитьСтроку(НомерСтроки));
		Если СледующийПараметр(СтрокаПараметра) Тогда
			ИмяПараметра = ИмяMIMEПараметра(СтрокаПараметра);
			ПараметрыЗаголовка.Вставить(ИмяПараметра, Новый Соответствие);
			СтрокаПараметра = СокрЛП(Сред(СтрокаПараметра, СтрДлина(ИмяПараметра) + 2));
		КонецЕсли;
		
		Если ПустаяСтрока(ИмяПараметра) Тогда
			ВызватьИсключение "Ошибочный формат параметров";
		КонецЕсли;
		
		ЗначенияПараметра = ПараметрыЗаголовка.Получить(ИмяПараметра);
		ЗначенияПараметраСтрокой = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаПараметра, ";");
		Для Каждого ЗначениеПараметра Из ЗначенияПараметраСтрокой Цикл
			Если ПустаяСтрока(ЗначениеПараметра) Тогда
				Продолжить;
			КонецЕсли;
			Значение = СокрЛП(ЗначениеПараметра);
			ПозицияРазделителя = Найти(Значение, "=");
			Если ПозицияРазделителя = 0 Тогда
				ПозицияРазделителя = Найти(Значение, "/");
			КонецЕсли;
			Если ПозицияРазделителя Тогда
				ЗначенияПараметра.Вставить(
					СокрЛП(Лев(Значение, ПозицияРазделителя - 1)),
					УдалитьКавычки(СокрЛП(Сред(Значение, ПозицияРазделителя + 1))));
			Иначе
				ЗначенияПараметра.Вставить(Значение, "");
			КонецЕсли;
		КонецЦикла;		
		
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат ПараметрыЗаголовка;
	
КонецФункции

Функция ПолучитьСледующуюСекциюMIMEПакета(Сообщение, НомерСтроки, РазделительСекций)
	
	ПропуститьПустыеСтроки(Сообщение, НомерСтроки);
	
	Если НомерСтроки > Сообщение.КоличествоСтрок() Тогда
		ВызватьИсключение "Неожиданный конец сообщения";
	КонецЕсли;
	
	НачалоСекции = "--" + РазделительСекций;
	КонецСекций =  "--" + РазделительСекций + "--";
	
	ПерваяСтрока = СокрЛП(Сообщение.ПолучитьСтроку(НомерСтроки));
	Если Не ВРег(Лев(ПерваяСтрока, СтрДлина(НачалоСекции))) = ВРег(НачалоСекции) Тогда
		ВызватьИсключение "Неправильный разделитель MIME-пакета";
	КонецЕсли;
	
	Если ВРег(Лев(ПерваяСтрока, СтрДлина(КонецСекций))) = ВРег(КонецСекций) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НомерСтроки = НомерСтроки + 1;
	ПараметрыСекции = ПолучитьПараметрыMIMEПакета(Сообщение, НомерСтроки);
	
	ТелоСообщения = "";
	НомерСтроки = НомерСтроки + 1;
	КоличествоСтрок = Сообщение.КоличествоСтрок();
	Пока НомерСтроки < КоличествоСтрок И Не ПустаяСтрока(Сообщение.ПолучитьСтроку(НомерСтроки)) Цикл
		СтрокаСообщения = Сообщение.ПолучитьСтроку(НомерСтроки);
		ТелоСообщения = ?(ПустаяСтрока(ТелоСообщения), "", ТелоСообщения + Символы.ПС) + СокрЛП(СтрокаСообщения);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Секция = Новый Структура;
	Секция.Вставить("Параметры", ПараметрыСекции);
	Секция.Вставить("Тело", ТелоСообщения);
	
	Возврат Секция;
	
КонецФункции

Функция СледующийПараметр(СтрокаПараметра)
	Возврат Найти(СтрокаПараметра, ":") > 0;
КонецФункции

Функция ИмяMIMEПараметра(СтрокаПараметра)
	Возврат СокрЛП(Лев(СтрокаПараметра, Найти(СтрокаПараметра, ":") - 1));
КонецФункции

Функция УдалитьКавычки(Знач ЗначениеРеквизита)
	
	Если Лев(ЗначениеРеквизита, 1) = """" И Прав(ЗначениеРеквизита, 1) = """" Тогда
		ЗначениеРеквизита = Сред(ЗначениеРеквизита, 2, СтрДлина(ЗначениеРеквизита) - 2);
	КонецЕсли;
	
	Возврат ЗначениеРеквизита;
	
КонецФункции

Функция ТипHL7(ИмяТипа, Фабрика_XDTO = Неопределено)
	
	ПространствоИмен = "urn:hl7-org:v3";
	
	Возврат ПолучитьТипXDTO(ИмяТипа, ПространствоИмен, Фабрика_XDTO);

КонецФункции

#Область Работа_С_DOM // Работа с HTML через DOM модель.

Функция СоздатьДокументDOMИзHTML(ТекстHTML) Экспорт
  
  ДокШаблон = Новый ЧтениеHTML;
  ДокШаблон.УстановитьСтроку(ТекстHTML);
  ПостроительDOM = Новый ПостроительDOM;
  HTMLДокумент = ПостроительDOM.Прочитать(ДокШаблон);
  
  Возврат HTMLДокумент;
  
КонецФункции

Функция ПолучитьТекстHTMLИзДокументаDOM(ДокументDOM) Экспорт
  
  ЗаписьDOM = Новый ЗаписьDOM;
  ЗаписьHTML = Новый ЗаписьHTML;
  ЗаписьHTML.УстановитьСтроку();
  ЗаписьDOM.Записать(ДокументDOM, ЗаписьHTML);
  ТекстHTML = ЗаписьHTML.Закрыть();
  
  Возврат ТекстHTML;
  
КонецФункции

#КонецОбласти

#КонецОбласти

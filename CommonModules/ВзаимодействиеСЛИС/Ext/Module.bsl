#Область ОтправкаЗаказаНаИсследования // Отправка заказа в 1С:Клиническая лаборатория.

Процедура СформироватьЗаказыНаИсследованиеВнутренний() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаИсследованиеВнутреннийИсследования.Номенклатура КАК Номенклатура,
		|	ЗаказНаИсследованиеВнутреннийИсследования.Ссылка.ДокументОснование КАК ДокументОснование,
		|	ЗаказНаИсследованиеВнутреннийИсследования.Ссылка.Клиент КАК Клиент
		|ПОМЕСТИТЬ СозданныеЗаказыВЛИС
		|ИЗ
		|	Документ.ЗаказНаИсследованиеВнутренний.Исследования КАК ЗаказНаИсследованиеВнутреннийИсследования
		|ГДЕ
		|	ЗаказНаИсследованиеВнутреннийИсследования.Ссылка.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДействияНадАнализамиИсследования.Ссылка КАК ДнА,
		|	ДействияНадАнализамиИсследования.Номенклатура КАК Номенклатура,
		|	ДействияНадАнализамиИсследования.Клиент КАК Клиент,
		|	ДействияНадАнализамиИсследования.ИД КАК ИД
		|ПОМЕСТИТЬ СозданныеЗаборы
		|ИЗ
		|	Документ.ДействияНадАнализами.Исследования КАК ДействияНадАнализамиИсследования
		|ГДЕ
		|	ДействияНадАнализамиИсследования.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийАнализов.Забор)
		|	И ДействияНадАнализамиИсследования.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И (ДействияНадАнализамиИсследования.Лаборатория = ЗНАЧЕНИЕ(Справочник.Лаборатории.ПустаяСсылка)
		|			ИЛИ ДействияНадАнализамиИсследования.Лаборатория.ВнешняяЛаборатория = ЗНАЧЕНИЕ(Перечисление.ВнешниеЛаборатории.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СозданныеЗаборы.Номенклатура КАК Номенклатура,
		|	СозданныеЗаборы.ДнА КАК ДнА,
		|	ЕСТЬNULL(СозданныеЗаказыВЛИС.ДокументОснование, ИСТИНА) КАК Новая,
		|	СозданныеЗаборы.Клиент КАК Клиент,
		|	СозданныеЗаборы.ИД КАК ИД
		|ПОМЕСТИТЬ Новые
		|ИЗ
		|	СозданныеЗаборы КАК СозданныеЗаборы
		|		ЛЕВОЕ СОЕДИНЕНИЕ СозданныеЗаказыВЛИС КАК СозданныеЗаказыВЛИС
		|		ПО СозданныеЗаборы.ДнА = СозданныеЗаказыВЛИС.ДокументОснование
		|			И СозданныеЗаборы.Номенклатура = СозданныеЗаказыВЛИС.Номенклатура
		|			И СозданныеЗаборы.Клиент = СозданныеЗаказыВЛИС.Клиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Новые.Номенклатура КАК Номенклатура,
		|	Новые.ДнА КАК ДнА,
		|	Новые.ДнА.Филиал КАК ДнА_Филиал,
		|	Новые.Клиент КАК Клиент,
		|	Новые.ИД КАК ИД
		|ИЗ
		|	Новые КАК Новые
		|ГДЕ
		|	Новые.Новая = ИСТИНА
		|ИТОГИ ПО
		|	Клиент, ДнА";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКлиенты = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); // Не удалять выборку по клиентам. (ДнА может имет 2 клиентов).
	Пока ВыборкаКлиенты.Следующий() Цикл
	
		ВыборкаДнА = ВыборкаКлиенты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДнА.Следующий() Цикл
			
			ВыборкаАнализы = ВыборкаДнА.Выбрать();
			ВыборкаАнализы.Следующий();
			
			Заказ = Документы.ЗаказНаИсследованиеВнутренний.СоздатьДокумент();
			Заказ.Дата = ТекущаяДата();
			Заказ.ДокументОснование = ВыборкаАнализы.ДнА;
			Заказ.Клиент	 = ВыборкаАнализы.Клиент;
			Заказ.Филиал	 = ВыборкаАнализы.ДнА_Филиал;
			Заказ.Статус	 = Перечисления.СтатусыОтправкиЗаказовНаИсследовние.Создан;
			Заказ.ВебСервис	 = ПолучитьВебСервис();
			
			ВыборкаАнализы.Сбросить();
			Пока ВыборкаАнализы.Следующий() Цикл
				Стр = Заказ.Исследования.Добавить();
				Стр.Номенклатура = ВыборкаАнализы.Номенклатура;
				Стр.Состояние	 = Перечисления.СостоянияЗаказовЛаборатории.Создан;
				Стр.ИД			 = ВыборкаАнализы.ИД;
			КонецЦикла;
			
			Заказ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтправитьЗаказыНаИсследованиеВнутренний() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаИсследованиеВнутренний.Ссылка
		|ИЗ
		|	Документ.ЗаказНаИсследованиеВнутренний КАК ЗаказНаИсследованиеВнутренний
		|ГДЕ
		|	ЗаказНаИсследованиеВнутренний.ПометкаУдаления = ЛОЖЬ
		|	И ЗаказНаИсследованиеВнутренний.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправкиЗаказовНаИсследовние.Создан)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		Результат = ВзаимодействиеСЛИС.ОтправитьЗаказНаСервере(ВыборкаДетальныеЗаписи.Ссылка);
		Если Лев(НРег(Результат),5) = "<soap" Тогда
			Объект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			Для каждого Стр Из Объект.Исследования Цикл
				Стр.Состояние = Перечисления.СостоянияЗаказовЛаборатории.Отправлен;
			КонецЦикла; 		
			Объект.Статус = Перечисления.СтатусыОтправкиЗаказовНаИсследовние.Отправлен;
			Объект.Записать();
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВебСервис()
	Пользователь = Пользователи.ТекущийПользователь();
	Филиал = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь,"ОсновнойФилиал");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВебСервисы.Ссылка
		|ИЗ
		|	Справочник.ВебСервисы КАК ВебСервисы
		|ГДЕ
		|	ВебСервисы.Филиал = &Филиал";
	
	Запрос.УстановитьПараметр("Филиал", Филиал);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОтправитьЗаказНаСервере(Объект) Экспорт
	
	Если Объект.ВебСервис = Справочники.ВебСервисы.ПустаяСсылка() Тогда
		Возврат "Не установлен веб-сервис";	
	КонецЕсли;
	
	Документ = Объект;
	УслугиТЗ = Новый ТаблицаЗначений;
	УслугиТЗ.Колонки.Добавить("УникальныйИдентификаторУслуги", Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	
	Тип_ClinicalDocument = ФабрикаXDTO.Тип("urn:hl7-org:v3","POCD_MT000040.ClinicalDocument");
	ОбъектXDTO = ФабрикаXDTO.Создать(Тип_ClinicalDocument);
	
	ДанныеЗаполнения = Новый Массив;
	
	// Заполнение шапки
	
	СоздатьШапку(Документ, ДанныеЗаполнения, Неопределено);
	
	ДобавитьВМассив(ДанныеЗаполнения,"componentOf.encompassingEncounter.effectiveTime.@nullFlavor","NI");
	
	// Добавляем табличную часть услуги
	
	ДобавитьВМассив(ДанныеЗаполнения,"component.structuredBody.component.section.text.table.@border",1);
	ДобавитьВМассив(ДанныеЗаполнения,"component.structuredBody.component.section.text.table.thead.tr.th[0]","Код услуги");
	ДобавитьВМассив(ДанныеЗаполнения,"component.structuredBody.component.section.text.table.thead.tr.th[1]","Название услуги");
	ДобавитьВМассив(ДанныеЗаполнения,"component.structuredBody.component.section.text.table.thead.tr.th[2]","Дата взятия материала");
	ДобавитьВМассив(ДанныеЗаполнения,"component.structuredBody.component.section.text.table.thead.tr.th[3]","Комментарий");
	
	Сч = 1;	
	Для Каждого СтрокаНом Из Объект.Исследования Цикл 
		СоздатьПакетЗаказаЛабИсследования_ТЧ(ДанныеЗаполнения, Документ, СтрокаНом , Сч);
		НоваяСтрокаТЗ = УслугиТЗ.Добавить();
		НоваяСтрокаТЗ.УникальныйИдентификаторУслуги = СтрокаНом.Номенклатура.УникальныйИдентификатор();
		Сч = Сч + 1;
	КонецЦикла;
	
	
	ЗаполнитьОбъектXDTO(ОбъектXDTO, ДанныеЗаполнения);
	ПакетСериализованный = СтрЗаменить(СериализоватьОбъектXDTO(ОбъектXDTO),
	"POCD_MT000040.ClinicalDocument",
	"ClinicalDocument"
	);
	
	Пакет = СоздатьОбъект_RCMR_IN000002UV02(ПакетСериализованный);
	
	ПакетСериализованный = СериализоватьОбъектXDTO(Пакет);
	ЗаписьXML  = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, Пакет);
	СтрокаXML = ЗаписьXML.Закрыть();
	
	КоличествоОтправленныхПакетов = 0;
	
	Результат = ПодготовитьПакет(Пакет, КоличествоОтправленныхПакетов,Объект.ВебСервис);
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьПакет(СтрокаXML, КоличествоОтправленныхПакетов, ВебСервис)
	
	Строка = СериализоватьОбъектXDTO(СтрокаXML);
	ПреобразованныйXML = ПреобразоватьXMLДляОтправки(Строка, СтрокаXML.Тип().Имя);
	БазовыйДокумент = 
	"<?xml version=""1.0"" encoding=""UTF-8""?>
	|<soap:Envelope xmlns:soap=""http://schemas.xmlsoap.org/soap/envelope/"">
	|	<soap:Header/>
	|	<soap:Body> 
	|	<m:ProcessHL7v3Message xmlns:m=""urn:hl7-org:v3"">" + 
	ПреобразованныйXML + "
	|	</m:ProcessHL7v3Message>
	|	</soap:Body>
	|</soap:Envelope>"
	;
	Если Лев(БазовыйДокумент, 1) = Символы.ПС Тогда 
		БазовыйДокумент = сред(БазовыйДокумент, 2);
	КонецЕсли;
	ИмяФайла = ПоместитьТекстВФайл(БазовыйДокумент, Неопределено, "UTF-8");
	
	Результат = ОтправитьФайлНаСервер(ИмяФайла, КоличествоОтправленныхПакетов, "Отправка сообщений в ЛИС",ВебСервис);
	Возврат Результат;
КонецФункции

Функция ПреобразоватьXMLДляОтправки(СтрокаXML, ИмяМетода)
	
	Префикс = "m:";
	
	СтрРез = СтрЗаменить(СтрокаXML, "<", "<" + Префикс);
	СтрРез = СтрЗаменить(СтрРез, "<" + Префикс + "/", "</" + Префикс);
	СтрРез = СтрЗаменить(СтрРез, "<" + Префикс + ИмяМетода, "<" + Префикс +"Message " +" xsi:type=""m:" + ИмяМетода + """");
	СтрРез = СтрЗаменить(СтрРез, "</" + Префикс + ИмяМетода, "</" + Префикс +"Message");
	
	СтрРез = СтрЗаменить(СтрРез, "<m:?xml version=""1.0"" encoding=""UTF-8""?>", "");
	Если Лев(СтрРез, 1) = Символы.ПС Тогда 
		СтрРез = сред(СтрРез, 2);
	КонецЕсли;
	
	Возврат СтрРез;
	
КонецФункции

Функция ПоместитьТекстВФайл(Данные, ИмяФайла = Неопределено, ТипФайла = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайла = ПолучитьИмяВременногоФайла();
	Иначе
		ИмяФайла = ИмяФайла;
	КонецЕсли;
	
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Данные);
	Документ.Записать(ИмяФайла, ТипФайла, Символы.ПС);
	
	Если ТипФайла = Неопределено Или ТипФайла = КодировкаТекста.UTF8 Тогда
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
		Строка64 = Base64Строка(ДвоичныеДанные);
		Строка64 = Прав(Строка64,СтрДлина(Строка64)-4);
		ДанныеНаЗапись = Base64Значение(Строка64);
		ДанныеНаЗапись.Записать(ИмяФайла);
	КонецЕсли;
	
	Возврат ИмяФайла;
КонецФункции

Функция ОтправитьФайлНаСервер(ИмяФайла, КоличествоОтправленныхПакетов, ЗаголовокЖурнала, ВебСервис) Экспорт
	
	Кодировка = "UTF-8";
	ФайлНазначение = ПолучитьИмяВременногоФайла();
	Соединение = Новый HTTPСоединение(ВебСервис.Адрес,ВебСервис.Порт,ВебСервис.Логин,ВебСервис.Пароль,,ВебСервис.Таймаут);
	Попытка
		ЗаголовокHTTP = Новый Соответствие();
		ЗаголовокHTTP.Вставить("Content-Type", "text/xml; charset=UTF-8");
		Запрос = Новый HTTPЗапрос(ВебСервис.ПутьКВебСервису,ЗаголовокHTTP);
		Запрос.УстановитьИмяФайлаТела(ИмяФайла);
		Рез = Соединение.ОтправитьДляОбработки(Запрос,ФайлНазначение);
		
		Если Рез.КодСостояния = 200 Тогда
			Сообщить("Заказ успешно отправлен");			
		КонецЕсли;
		
		КоличествоОтправленныхПакетов = КоличествоОтправленныхПакетов + 1;
	Исключение
		Инф = ИнформацияОбОшибке();
		СообщениеОбОшибке = НСтр("ru='Не удалось отправить заказ по причине: %1'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(СообщениеОбОшибке, Инф.Причина.Описание));
	КонецПопытки;
	
	ТекстДокумент = Новый ТекстовыйДокумент;
	ТекстДокумент.Прочитать(ФайлНазначение, Кодировка);
	УдалитьФайлы(ФайлНазначение);
	
	Попытка
		УдалитьФайлы(ИмяФайла); 
	Исключение
	КонецПопытки;
	
	Результат = ТекстДокумент.ПолучитьТекст();
	
	Возврат Результат;
	
КонецФункции

Процедура СоздатьШапку(Документ, ДанныеЗаполнения, НазначившийВрач)
	
	ДобавитьВМассив(ДанныеЗаполнения,"typeId.@extension","POCD_HD000040");
	ДобавитьВМассив(ДанныеЗаполнения,"typeId.@root","2.16.840.1.113883.1.3");
	ДобавитьВМассив(ДанныеЗаполнения,"id.@root",Строка(Документ.Ссылка.УникальныйИдентификатор()));
	//	ДобавитьВМассив(ДанныеЗаполнения,"code",Неопределено);
	ДобавитьВМассив(ДанныеЗаполнения,"code.@code", "18610-6");
	ДобавитьВМассив(ДанныеЗаполнения,"code.@codeSystem", "2.16.840.1.113883.6.1");
	ДобавитьВМассив(ДанныеЗаполнения,"code.@codeSystemName", "LOINC");
	ДобавитьВМассив(ДанныеЗаполнения,"effectiveTime.@value", Формат(Документ.Дата, "ДФ=yyyyMMddHHmmss"));
	ДобавитьВМассив(ДанныеЗаполнения,"confidentialityCode.@code", "N");
	ДобавитьВМассив(ДанныеЗаполнения,"confidentialityCode.@codeSystem", "2.16.840.1.113883.5.25");
	ДобавитьВМассив(ДанныеЗаполнения,"confidentialityCode.@displayName", "Normal");
	ДобавитьВМассив(ДанныеЗаполнения,"recordTarget.patientRole.id.@root", Строка(Документ.Клиент.УникальныйИдентификатор()));
	ДобавитьВМассив(ДанныеЗаполнения,"recordTarget.patientRole.patient.name[0].family", Документ.Клиент.Фамилия);
	ДобавитьВМассив(ДанныеЗаполнения,"recordTarget.patientRole.patient.name[1].given[0]", Документ.Клиент.Имя);
	ДобавитьВМассив(ДанныеЗаполнения,"recordTarget.patientRole.patient.name[1].given[1]", Документ.Клиент.Отчество);
	ДобавитьВМассив(ДанныеЗаполнения,"recordTarget.patientRole.patient.name[1].family", Документ.Клиент.Фамилия);
	ДобавитьВМассив(ДанныеЗаполнения,"recordTarget.patientRole.patient.administrativeGenderCode.@code", ПолучитьКодПола(Документ.Клиент.Пол));
	ДобавитьВМассив(ДанныеЗаполнения,"recordTarget.patientRole.patient.administrativeGenderCode.@codeSystem","2.16.840.1.113883.5.1");
	ДобавитьВМассив(ДанныеЗаполнения,"recordTarget.patientRole.patient.birthTime.@value", Формат(Документ.Клиент.ДатаРождения, "ДФ=yyyyMMdd"));
	
	// Паспорт 
	ДанныеПаспорт = РегистрыСведений.ПаспортныеДанные.ПолучитьПоследнее(Документ.Дата, Новый Структура("ФизЛицо",Документ.Клиент));
	ИндексДУЛ = 1;
	Если ЗначениеЗаполнено(ДанныеПаспорт) 
		И ЗначениеЗаполнено(ДанныеПаспорт.ДокументСерия)
		И ЗначениеЗаполнено(ДанныеПаспорт.ДокументНомер) 
	Тогда
		СерияНомерДокумента = ИнтеграцияЕГИСЗСлужебныйСервер.УдалитьСимволыКроме(ДанныеПаспорт.ДокументСерия,"0123456789") + " " + ИнтеграцияЕГИСЗСлужебныйСервер.УдалитьСимволыКроме(ДанныеПаспорт.ДокументНомер,"0123456789"); 
		
		ДобавитьВМассив(ДанныеЗаполнения, "recordTarget.patientRole.id[" + Строка(ИндексДУЛ) + "].@root", "1.2.643.5.1.13.13.99.2.48.1");
		ДобавитьВМассив(ДанныеЗаполнения, "recordTarget.patientRole.id[" + Строка(ИндексДУЛ) + "].@extension", СерияНомерДокумента);
		
		КемВыдан = ДанныеПаспорт.ДокументКемВыдан + " " + "код подразделения:" + ДанныеПаспорт.ДокументКодПодразделения + " " + "дата выдачи:" + Формат(ДанныеПаспорт.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy");
		ДобавитьВМассив(ДанныеЗаполнения, "recordTarget.patientRole.id[" + Строка(ИндексДУЛ) + "].assigningAuthorityName", КемВыдан);
		
		ИндексДУЛ = ИндексДУЛ + 1;
	КонецЕсли;
	
	// СНИЛС
	Если ЗначениеЗаполнено(Документ.Клиент.СНИЛС) Тогда
		ДобавитьВМассив(ДанныеЗаполнения, "recordTarget.patientRole.id[" + Строка(ИндексДУЛ) + "].@root", "1.2.643.100.3");
		ДобавитьВМассив(ДанныеЗаполнения, "recordTarget.patientRole.id[" + Строка(ИндексДУЛ) + "].@extension", ИнтеграцияЕГИСЗСлужебныйСервер.УдалитьСимволыКроме(Документ.Клиент.СНИЛС,"0123456789"));
	КонецЕсли; 
	
	// Добавление контактной информации
	ДобавитьДынныеКИВШапку(Документ.Клиент,ДанныеЗаполнения);
	
	ДобавитьВМассив(ДанныеЗаполнения,"author.time.@value",Формат(Документ.Дата, "ДФ=yyyyMMddHHmmss"));
	Если ЗначениеЗаполнено(Документ.Врач) Тогда  
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.id.@root", Строка(Документ.Врач.УникальныйИдентификатор()));
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.assignedPerson.name.prefix", Строка(""));
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.assignedPerson.name.family", Документ.Врач.Фамилия);
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.assignedPerson.name.given[0]",Документ.Врач.Имя);
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.assignedPerson.name.given[1]", Документ.Врач.Отчество);	
	Иначе
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.id.@root", Строка(Справочники.Сотрудники.ПустаяСсылка()));
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.assignedPerson.name.prefix", Строка(""));
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.assignedPerson.name.family", "");
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.assignedPerson.name.given[0]","");
		ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.assignedPerson.name.given[1]", "");
	КонецЕсли;
	ДобавитьВМассив(ДанныеЗаполнения,"custodian.assignedCustodian.representedCustodianOrganization.name",Строка(Документ.Филиал.Наименование));
	ДобавитьВМассив(ДанныеЗаполнения,"custodian.assignedCustodian.representedCustodianOrganization.id.@root",
	Строка(Документ.Филиал.УникальныйИдентификатор()));
	ДобавитьВМассив(ДанныеЗаполнения,"author.assignedAuthor.representedOrganization.id.@root",
	Строка(Документ.Филиал.УникальныйИдентификатор()));
	
КонецПроцедуры

Процедура ДобавитьДынныеКИВШапку(Клиент, ДанныеЗаполнения)
	Префикс = "recordTarget.patientRole.telecom";
	Счетчик = 0;
	
	// Домашний телефон
	ТипКИ = Перечисления.ТипыКонтактнойИнформации.Телефон;
	ВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонДомашний;
	ДанныеКИ = КонтактнаяИнформацияСервер.ПолучитьКИОбъекта(Клиент,ТипКИ,ВидКИ);
	Если ЗначениеЗаполнено(ДанныеКИ) Тогда
		ПрефиксЗаписи = Префикс + "[" + Счетчик + "].";
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@value","ph:" + ДанныеКИ);
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@use","HP");
		Счетчик = Счетчик + 1;
	КонецЕсли;
	
	// Мобильный телефон
	ВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
	ДанныеКИ = КонтактнаяИнформацияСервер.ПолучитьКИОбъекта(Клиент,ТипКИ,ВидКИ);
	Если ЗначениеЗаполнено(ДанныеКИ) Тогда

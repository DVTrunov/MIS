		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@value","ph:" + ДанныеКИ);
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@use","MC");
		Счетчик = Счетчик + 1;
	КонецЕсли;
	
	// Рабочий телефон
	ВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонРабочий;
	ДанныеКИ = КонтактнаяИнформацияСервер.ПолучитьКИОбъекта(Клиент,ТипКИ,ВидКИ);
	Если ЗначениеЗаполнено(ДанныеКИ) Тогда
		ПрефиксЗаписи = Префикс + "[" + Счетчик + "].";
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@value","ph:" + ДанныеКИ);
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@use","WP");
		Счетчик = Счетчик + 1;
	КонецЕсли;
	
	// Электронная почта домашная
	ТипКИ = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	ВидКИ = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний;
	ДанныеКИ = КонтактнаяИнформацияСервер.ПолучитьКИОбъекта(Клиент,ТипКИ,ВидКИ);
	Если ЗначениеЗаполнено(ДанныеКИ) Тогда
		ПрефиксЗаписи = Префикс + "[" + Счетчик + "].";
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@value","email:" + ДанныеКИ);
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@use","HP");
		Счетчик = Счетчик + 1;
	КонецЕсли;
	
	// Электронная почта рабочая
	ВидКИ = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий;
	ДанныеКИ = КонтактнаяИнформацияСервер.ПолучитьКИОбъекта(Клиент,ТипКИ,ВидКИ);
	Если ЗначениеЗаполнено(ДанныеКИ) Тогда
		ПрефиксЗаписи = Префикс + "[" + Счетчик + "].";
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@value","email:" + ДанныеКИ);
		ДобавитьВМассив(ДанныеЗаполнения,ПрефиксЗаписи + "@use","WP");
		Счетчик = Счетчик + 1;
	КонецЕсли;
	
КонецПроцедуры
 
Процедура СоздатьПакетЗаказаЛабИсследования_ТЧ( ДанныеЗаполнения, Знач Документ, Знач строкаТЗ, Знач Номер )
	
	Услуга = строкаТЗ.Номенклатура;
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.text.table.tbody.tr[" + Строка(Номер-1) + "].@ID","tr-" + Номер);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВнешниеКодыУслугКЛ.Код
	|ИЗ
	|	РегистрСведений.ВнешниеКодыУслугКЛ КАК ВнешниеКодыУслугКЛ
	|ГДЕ
	|	ВнешниеКодыУслугКЛ.Услуга = &Услуга";
	
	Запрос.УстановитьПараметр("Услуга", Услуга);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	КодЛИС = "";
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		КодЛИС = ВыборкаДетальныеЗаписи.Код;
		ДобавитьВМассив(ДанныеЗаполнения,
		"component.structuredBody.component.section.text.table.tbody.tr[" + Строка(Номер-1) + "].td[0]",
		СокрЛП(Строка(ВыборкаДетальныеЗаписи.Код)));
	КонецЕсли;
	
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.text.table.tbody.tr[" + Строка(Номер-1) + "].td[1]",
	Строка(Услуга.Наименование));
	
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.text.table.tbody.tr[" + Строка(Номер-1) + "].td[2]",
	Строка(Документ.Дата));  	
	
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.text.table.tbody.tr[" + Строка(Номер-1) + "].td[3]",
	"");
	
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.@classCode","OBS");
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.@moodCode","RQO");
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.@negationInd",
	"false");
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.id.@root",Строка(Услуга.УникальныйИдентификатор()));
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.id.@extension",Строка(Номер));
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.id[1].@extension",Строка("ПЛТ"));
	
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.code.@code",СокрЛП(Строка(КодЛИС)));
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.code.@displayName",Строка(Услуга.Наименование));
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.text.reference.@value","#tr-" + Номер);
	
	ДобавитьВМассив(ДанныеЗаполнения,
	"component.structuredBody.component.section.entry[" + Строка(Номер-1) + "].observation.effectiveTime.@value",Формат(Документ.Дата, "ДФ=yyyyMMddHHmmss"));
	
	// Код пробы может быть не заполнен

// Лиды входящего трафика: статусы, взятие в работу, результат звонка,
// связь с заявкой и оказанием услуг.

#Область ПрограммныйИнтерфейс

// Приводит номер к виду 7XXXXXXXXXX (Казахстан/Россия), прочие номера оставляет цифрами.
//
// Параметры:
//  НомерТелефона - Строка - номер в произвольном формате.
//
// Возвращаемое значение:
//  Строка - только цифры номера.
//
Функция НормализоватьТелефон(Знач НомерТелефона) Экспорт
	
	Цифры = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(НомерТелефона);
	Если СтрДлина(Цифры) = 11 И Лев(Цифры, 1) = "8" Тогда
		Цифры = "7" + Сред(Цифры, 2);
	ИначеЕсли СтрДлина(Цифры) = 10 Тогда
		Цифры = "7" + Цифры;
	КонецЕсли;
	Возврат Цифры;
	
КонецФункции

// Ищет клиента по последним 10 цифрам телефона в контактной информации.
//
// Параметры:
//  НомерТелефона - Строка - номер телефона.
//
// Возвращаемое значение:
//  СправочникСсылка.Клиенты - найденный клиент или пустая ссылка.
//
Функция НайтиКлиентаПоТелефону(НомерТелефона) Экспорт
	
	Цифры = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(НомерТелефона);
	Если СтрДлина(Цифры) < 10 Тогда
		Возврат Справочники.Клиенты.ПустаяСсылка();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Объект КАК Клиент
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип = &ТипТелефон
	|	И КонтактнаяИнформация.Объект ССЫЛКА Справочник.Клиенты
	|	И КонтактнаяИнформация.Поле12 ПОДОБНО &Маска
	|	И НЕ КонтактнаяИнформация.Объект.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТипТелефон", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Маска", "%" + Прав(Цифры, 10));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Клиент;
	КонецЕсли;
	Возврат Справочники.Клиенты.ПустаяСсылка();
	
КонецФункции

// Статусы, после которых лид больше не отрабатывается.
//
// Параметры:
//  Статус - ПеречислениеСсылка.омг_СтатусыЛидов
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоЗавершающийСтатус(Статус) Экспорт
	
	Возврат Статус = Перечисления.омг_СтатусыЛидов.Записан
		Или Статус = Перечисления.омг_СтатусыЛидов.Визит
		Или Статус = Перечисления.омг_СтатусыЛидов.Упущен
		Или Статус = Перечисления.омг_СтатусыЛидов.Нецелевой;
	
КонецФункции

// Статусы, в которых лид ждёт отработки.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.омг_СтатусыЛидов
//
Функция АктивныеСтатусы() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.омг_СтатусыЛидов.Новый);
	Результат.Добавить(Перечисления.омг_СтатусыЛидов.Пропущен);
	Результат.Добавить(Перечисления.омг_СтатусыЛидов.ВРаботе);
	Результат.Добавить(Перечисления.омг_СтатусыЛидов.Недозвон);
	Возврат Результат;
	
КонецФункции

// Записывает строку истории статусов лида.
//
// Параметры:
//  Лид - ДокументСсылка.омг_Лид
//  Статус - ПеречислениеСсылка.омг_СтатусыЛидов
//  ПричинаОтказа - СправочникСсылка.омг_ПричиныОтказаЛидов
//  Комментарий - Строка
//
Процедура ЗаписатьИсториюСтатуса(Лид, Статус, ПричинаОтказа = Неопределено, Комментарий = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.омг_ИсторияСтатусовЛидов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.Лид = Лид;
	МенеджерЗаписи.Статус = Статус;
	МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
	Если ЗначениеЗаполнено(ПричинаОтказа) Тогда
		МенеджерЗаписи.ПричинаОтказа = ПричинаОтказа;
	КонецЕсли;
	МенеджерЗаписи.Комментарий = Комментарий;
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры

// Берёт лид в работу текущим пользователем.
//
// Параметры:
//  Лид - ДокументСсылка.омг_Лид
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка, если лид взят.
//
Функция ВзятьВРаботу(Лид) Экспорт
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.омг_Лид");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Лид);
		Блокировка.Заблокировать();
		
		ЛидОбъект = Лид.ПолучитьОбъект();
		Если ЭтоЗавершающийСтатус(ЛидОбъект.Статус) Тогда
			ОтменитьТранзакцию();
			Возврат СтрШаблон(НСтр("ru = 'Лид уже закрыт: %1.'"), ЛидОбъект.Статус);
		КонецЕсли;
		Если ЗначениеЗаполнено(ЛидОбъект.Ответственный) И ЛидОбъект.Ответственный <> ТекущийПользователь Тогда
			ОтменитьТранзакцию();
			Возврат СтрШаблон(НСтр("ru = 'Лид уже в работе у пользователя %1.'"), ЛидОбъект.Ответственный);
		КонецЕсли;
		
		ЛидОбъект.Ответственный = ТекущийПользователь;
		Если Не ЗначениеЗаполнено(ЛидОбъект.ДатаВзятияВРаботу) Тогда
			ЛидОбъект.ДатаВзятияВРаботу = ТекущаяДатаСеанса();
		КонецЕсли;
		Если ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Новый
			Или ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Пропущен Тогда
			ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.ВРаботе;
		КонецЕсли;
		ЛидОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

// Сохраняет результат звонка по лиду.
//
// Параметры:
//  Лид - ДокументСсылка.омг_Лид
//  Результат - Строка - "Недозвон", "Перезвонить", "Отказ", "Нецелевой", "Записать".
//  ПерезвонитьВ - Дата - когда перезвонить (для "Перезвонить").
//  ПричинаОтказа - СправочникСсылка.омг_ПричиныОтказаЛидов - для "Отказ" и "Нецелевой".
//  Комментарий - Строка
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка, если результат записан.
//
Функция ЗаписатьРезультатЗвонка(Лид, Результат, ПерезвонитьВ, ПричинаОтказа, Знач Комментарий) Экспорт
	
	Если (Результат = "Отказ" Или Результат = "Нецелевой") И Не ЗначениеЗаполнено(ПричинаОтказа) Тогда
		Возврат НСтр("ru = 'Укажите причину.'");
	КонецЕсли;
	Если Результат = "Перезвонить" И Не ЗначениеЗаполнено(ПерезвонитьВ) Тогда
		Возврат НСтр("ru = 'Укажите, когда перезвонить.'");
	КонецЕсли;
	
	ЛидОбъект = Лид.ПолучитьОбъект();
	Если ЭтоЗавершающийСтатус(ЛидОбъект.Статус) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Лид уже закрыт: %1.'"), ЛидОбъект.Статус);
	КонецЕсли;
	
	Сейчас = ТекущаяДатаСеанса();
	Если Не ЗначениеЗаполнено(ЛидОбъект.Ответственный) Тогда
		ЛидОбъект.Ответственный = Пользователи.ТекущийПользователь();
		ЛидОбъект.ДатаВзятияВРаботу = Сейчас;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЛидОбъект.ДатаПервогоЗвонка) Тогда
		ЛидОбъект.ДатаПервогоЗвонка = Сейчас;
	КонецЕсли;
	// Звонки через Битфон считаются автоматически (подписка на историю звонков).
	// Вручную попытка добавляется только при недозвоне без такого звонка, например с мобильного.
	Если Результат = "Недозвон" И Не ЕстьНедавнийИсходящийЗвонок(ЛидОбъект.Телефон, 30) Тогда
		ЛидОбъект.КоличествоПопыток = ЛидОбъект.КоличествоПопыток + 1;
	КонецЕсли;
	ЛидОбъект.ПерезвонитьВ = '00010101';
	
	Если Результат = "Недозвон" Тогда
		УстановитьСтатусНедозвона(ЛидОбъект, Комментарий);
	ИначеЕсли Результат = "Перезвонить" Тогда
		ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.ВРаботе;
		ЛидОбъект.ПерезвонитьВ = ПерезвонитьВ;
	ИначеЕсли Результат = "Отказ" Тогда
		ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Упущен;
		ЛидОбъект.ПричинаОтказа = ПричинаОтказа;
	ИначеЕсли Результат = "Нецелевой" Тогда
		ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Нецелевой;
		ЛидОбъект.ПричинаОтказа = ПричинаОтказа;
	ИначеЕсли Результат = "Записать" Тогда
		ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.ВРаботе;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Комментарий) Тогда
		ЛидОбъект.Комментарий = СокрЛП(ЛидОбъект.Комментарий + Символы.ПС
			+ Формат(Сейчас, "ДФ='dd.MM HH:mm'") + " " + Комментарий);
	КонецЕсли;
	
	СтатусДоЗаписи = Лид.Статус;
	ЛидОбъект.ДополнительныеСвойства.Вставить("КомментарийИстории", Комментарий);
	ЛидОбъект.Записать();
	
	// История пишется в ПриЗаписи при смене статуса; при повторном недозвоне
	// или переносе звонка статус не меняется — фиксируем попытку отдельно.
	Если СтатусДоЗаписи = ЛидОбъект.Статус Тогда
		ЗаписатьИсториюСтатуса(Лид, ЛидОбъект.Статус, ЛидОбъект.ПричинаОтказа, Комментарий);
	КонецЕсли;
	
	ПривязатьПоследнийЗвонок(ЛидОбъект);
	
	Возврат "";
	
КонецФункции

// Находит клиента лида по телефону и привязывает его к лиду.
// Карточку автоматически не создаём: у клиента обязателен ИИН — оператор находит или создаёт
// клиента в стандартной форме поиска по ИИН.
//
// Параметры:
//  Лид - ДокументСсылка.омг_Лид
//
// Возвращаемое значение:
//  СправочникСсылка.Клиенты - клиент; пустая ссылка, если не найден.
//
Функция ОбеспечитьКлиента(Лид) Экспорт
	
	Если ЗначениеЗаполнено(Лид.Клиент) Тогда
		Возврат Лид.Клиент;
	КонецЕсли;
	
	Клиент = НайтиКлиентаПоТелефону(Лид.Телефон);
	Если ЗначениеЗаполнено(Клиент) Тогда
		ПривязатьКлиента(Лид, Клиент);
	КонецЕсли;
	Возврат Клиент;
	
КонецФункции

// Привязывает клиента к лиду; телефон лида добавляется клиенту, если его там нет.
//
// Параметры:
//  Лид - ДокументСсылка.омг_Лид
//  Клиент - СправочникСсылка.Клиенты
//
Процедура ПривязатьКлиента(Лид, Клиент) Экспорт
	
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Лид.Телефон) И НайтиКлиентаПоТелефону(Лид.Телефон) <> Клиент Тогда
		Попытка
			СтруктураКИ = Новый Структура("Телефон, Email, Адрес", Лид.Телефон, Неопределено, Неопределено);
			ВебИнтеграция.ОбработатьКИКлиента(СтруктураКИ, Клиент);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Лиды.Телефон клиента'"), УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.омг_Лид, Лид, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	Если Лид.Клиент <> Клиент Тогда
		ЛидОбъект = Лид.ПолучитьОбъект();
		ЛидОбъект.Клиент = Клиент;
		ЛидОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

// Параметры для оповещения календаря «НамерениеЗаписиПоДокументу».
//
// Параметры:
//  Лид - ДокументСсылка.омг_Лид
//
// Возвращаемое значение:
//  Структура - ДокументЗаписи, Клиент, Работы (при наличии услуги).
//
Функция ПараметрыЗаписиПоЛиду(Лид) Экспорт
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("ДокументЗаписи", Лид);
	ПараметрыЗаписи.Вставить("Клиент", Лид.Клиент);
	Если ЗначениеЗаполнено(Лид.Номенклатура) Тогда
		Работы = Новый Массив;
		Работы.Добавить(Лид.Номенклатура);
		ПараметрыЗаписи.Вставить("Работы", Работы);
	КонецЕсли;
	Возврат ПараметрыЗаписи;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиПодписок

// Подписка омг_ЛидПриЗаписиЗаявки: заявка по лиду переводит лид в «Записан».
//
Процедура ЗаявкаПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Источник.Основание) <> Тип("ДокументСсылка.омг_Лид") Или Не ЗначениеЗаполнено(Источник.Основание) Тогда
		Возврат;
	КонецЕсли;
	Если Источник.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Лид = Источник.Основание;
	Если Лид.Статус = Перечисления.омг_СтатусыЛидов.Визит
		Или (Лид.Статус = Перечисления.омг_СтатусыЛидов.Записан И Лид.Заявка = Источник.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ЛидОбъект = Лид.ПолучитьОбъект();
	ЛидОбъект.Заявка = Источник.Ссылка;
	ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Записан;
	ЛидОбъект.ПерезвонитьВ = '00010101';
	Если Не ЗначениеЗаполнено(ЛидОбъект.Клиент) И ЗначениеЗаполнено(Источник.Клиент) Тогда
		ЛидОбъект.Клиент = Источник.Клиент;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЛидОбъект.Ответственный) Тогда
		ЛидОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	ЛидОбъект.Записать();
	
КонецПроцедуры

// Подписка омг_ЛидПриЗаписиОказанияУслуг: оказание услуг по заявке лида — «Визит»,
// когда документ проведён и по нему пробит чек (полностью или частично).
// Приём по ГОБМП (заполнена страховая программа) чека не имеет — засчитывается по проведению.
//
Процедура ОказаниеУслугПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Или Не Источник.Проведен Тогда
		Возврат;
	КонецЕсли;
	ЧекПробит = Источник.СостояниеЧековККМ = Перечисления.СостоянияЧековККМ.ЧекиПробиты
		Или Источник.СостояниеЧековККМ = Перечисления.СостоянияЧековККМ.ЧекиЧастичноПробиты;
	Если Не ЧекПробит И Не ЗначениеЗаполнено(Источник.омг_СтраховаяПрограмма) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Источник.ДокументОснование) <> Тип("ДокументСсылка.Заявка") Или Не ЗначениеЗаполнено(Источник.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Лид = Источник.ДокументОснование.Основание;
	Если ТипЗнч(Лид) <> Тип("ДокументСсылка.омг_Лид") Или Не ЗначениеЗаполнено(Лид) Тогда
		Возврат;
	КонецЕсли;
	Если Лид.Статус = Перечисления.омг_СтатусыЛидов.Визит Тогда
		Возврат;
	КонецЕсли;
	
	ЛидОбъект = Лид.ПолучитьОбъект();
	ЛидОбъект.ОказаниеУслуг = Источник.Ссылка;
	Если Не ЗначениеЗаполнено(ЛидОбъект.Заявка) Тогда
		ЛидОбъект.Заявка = Источник.ДокументОснование;
	КонецЕсли;
	ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Визит;
	ЛидОбъект.Записать();
	
КонецПроцедуры

// Подписка омг_ЛидПриЗаписиИсторииЗвонков: Битфон пишет каждый звонок в доп_ИсторияЗвонков
// (даже если клиент по номеру не найден и «Событие» не создаётся). По номеру активного лида:
// первый звонок, попытка, «Недозвон» при неотвеченном исходящем, «В работе» при разговоре.
//
Процедура ИсторияЗвонковПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого ЗаписьЗвонка Из Источник Цикл
		Попытка
			ОбработатьЗвонокПоЛиду(ЗаписьЗвонка);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Лиды.Звонок по лиду'"), УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.омг_Лид, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РегламентныеЗадания

// Регламентное задание омг_ПроверкаПропущенныхЛидов: новые лиды, которые никто
// не взял в работу за омг_ЛидыМинутДоПропуска минут, получают статус «Пропущен».
//
Процедура ПроверитьПропущенныеЛиды() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	Минут = Константы.омг_ЛидыМинутДоПропуска.Получить();
	Если Минут <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лид.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.омг_Лид КАК Лид
	|ГДЕ
	|	Лид.Статус = ЗНАЧЕНИЕ(Перечисление.омг_СтатусыЛидов.Новый)
	|	И Лид.Ответственный = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	И Лид.Дата <= &Граница
	|	И НЕ Лид.ПометкаУдаления";
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - Минут * 60);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ЛидОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ЛидОбъект.Заблокировать();
			ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Пропущен;
			ЛидОбъект.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Лиды.Проверка пропущенных'"), УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.омг_Лид, Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьЗвонокПоЛиду(ЗаписьЗвонка)
	
	Цифры = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(ЗаписьЗвонка.Номер);
	Если СтрДлина(Цифры) < 10 Тогда
		Цифры = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(ЗаписьЗвонка.НабранныйНомер);
	КонецЕсли;
	Если СтрДлина(Цифры) < 10 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лид.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.омг_Лид КАК Лид
	|ГДЕ
	|	Лид.Телефон ПОДОБНО &Маска
	|	И Лид.Статус В (&Статусы)
	|	И НЕ Лид.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лид.Дата УБЫВ";
	Запрос.УстановитьПараметр("Маска", "%" + Прав(Цифры, 10));
	Запрос.УстановитьПараметр("Статусы", АктивныеСтатусы());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Исходящий = (ЗаписьЗвонка.ТипЗвонка = Перечисления.доп_ТипЗвонка.Исходящий);
	Разговор = ЗаписьЗвонка.Успешность И ЗаписьЗвонка.ДлительностьЗвонка > 0;
	ДатаЗвонка = ?(ЗначениеЗаполнено(ЗаписьЗвонка.Дата), ЗаписьЗвонка.Дата, ТекущаяДатаСеанса());
	
	ЛидОбъект = Выборка.Ссылка.ПолучитьОбъект();
	ЛидОбъект.Заблокировать();
	СтатусДоЗаписи = ЛидОбъект.Статус;
	
	Если Не ЗначениеЗаполнено(ЛидОбъект.ДатаПервогоЗвонка) Тогда
		ЛидОбъект.ДатаПервогоЗвонка = ДатаЗвонка;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЛидОбъект.Ответственный) И ЗначениеЗаполнено(ЗаписьЗвонка.Пользователь) Тогда
		ЛидОбъект.Ответственный = ЗаписьЗвонка.Пользователь;
		ЛидОбъект.ДатаВзятияВРаботу = ДатаЗвонка;
	КонецЕсли;
	
	Если Исходящий Тогда
		ЛидОбъект.КоличествоПопыток = ЛидОбъект.КоличествоПопыток + 1;
	КонецЕсли;
	
	Если Разговор Тогда
		Комментарий = СтрШаблон(НСтр("ru = '%1 звонок, разговор %2 сек.'"),
			?(Исходящий, НСтр("ru = 'Исходящий'"), НСтр("ru = 'Входящий'")), Формат(ЗаписьЗвонка.ДлительностьЗвонка, "ЧГ=0"));
		Если ЛидОбъект.Статус <> Перечисления.омг_СтатусыЛидов.ВРаботе Тогда
			ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.ВРаботе;
		КонецЕсли;
	ИначеЕсли Исходящий Тогда
		Комментарий = НСтр("ru = 'Исходящий звонок без ответа.'");
		УстановитьСтатусНедозвона(ЛидОбъект, Комментарий);
	Иначе
		Комментарий = НСтр("ru = 'Пропущенный входящий звонок.'");
		ЛидОбъект.ПерезвонитьВ = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ЛидОбъект.Комментарий = СокрЛП(ЛидОбъект.Комментарий + Символы.ПС
		+ Формат(ДатаЗвонка, "ДФ='dd.MM HH:mm'") + " " + Комментарий);
	ЛидОбъект.ДополнительныеСвойства.Вставить("КомментарийИстории", Комментарий);
	ЛидОбъект.Записать();
	
	Если СтатусДоЗаписи = ЛидОбъект.Статус Тогда
		ЗаписатьИсториюСтатуса(ЛидОбъект.Ссылка, ЛидОбъект.Статус, , Комментарий);
	КонецЕсли;
	
КонецПроцедуры

// «Недозвон» или «Упущен», если исчерпан лимит попыток омг_ЛидыПопытокДоУпущен.
//
Процедура УстановитьСтатусНедозвона(ЛидОбъект, Комментарий)
	
	ПопытокДоУпущен = Константы.омг_ЛидыПопытокДоУпущен.Получить();
	Если ПопытокДоУпущен > 0 И ЛидОбъект.КоличествоПопыток >= ПопытокДоУпущен Тогда
		ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Упущен;
		Комментарий = СокрЛП(Комментарий + Символы.ПС
			+ СтрШаблон(НСтр("ru = 'Закрыт автоматически после %1 недозвонов.'"), ЛидОбъект.КоличествоПопыток));
	Иначе
		ЛидОбъект.Статус = Перечисления.омг_СтатусыЛидов.Недозвон;
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьНедавнийИсходящийЗвонок(Телефон, Минут)
	
	Цифры = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(Телефон);
	Если СтрДлина(Цифры) < 10 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсторияЗвонков.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.доп_ИсторияЗвонков КАК ИсторияЗвонков
	|ГДЕ
	|	ИсторияЗвонков.ТипЗвонка = ЗНАЧЕНИЕ(Перечисление.доп_ТипЗвонка.Исходящий)
	|	И ИсторияЗвонков.Дата >= &Начало
	|	И ИсторияЗвонков.Номер ПОДОБНО &Маска";
	Запрос.УстановитьПараметр("Начало", ТекущаяДатаСеанса() - Минут * 60);
	Запрос.УстановитьПараметр("Маска", "%" + Прав(Цифры, 10));
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Последний звонок по номеру лида за 2 часа без основания получает основание «Лид»,
// чтобы звонки были видны в истории лида.
//
Процедура ПривязатьПоследнийЗвонок(ЛидОбъект)
	
	Цифры = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(ЛидОбъект.Телефон);
	Если СтрДлина(Цифры) < 10 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	Событие.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.Дата >= &Начало
	|	И Событие.НомерТелефона ПОДОБНО &Маска
	|	И НЕ Событие.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Событие.Дата УБЫВ";
	Запрос.УстановитьПараметр("Начало", ТекущаяДатаСеанса() - 2 * 3600);
	Запрос.УстановитьПараметр("Маска", "%" + Прав(Цифры, 10) + "%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			СобытиеОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ЗначениеЗаполнено(СобытиеОбъект.Основание) Тогда
				Продолжить;
			КонецЕсли;
			СобытиеОбъект.Заблокировать();
			СобытиеОбъект.Основание = ЛидОбъект.Ссылка;
			Если Не ЗначениеЗаполнено(СобытиеОбъект.Клиент) И ЗначениеЗаполнено(ЛидОбъект.Клиент) Тогда
				СобытиеОбъект.Клиент = ЛидОбъект.Клиент;
			КонецЕсли;
			СобытиеОбъект.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Лиды.Привязка звонка'"), УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.омг_Лид, ЛидОбъект.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Прервать;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

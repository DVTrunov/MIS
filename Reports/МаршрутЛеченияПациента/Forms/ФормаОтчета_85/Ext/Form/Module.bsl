&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборДатаПо = НачалоДня(ТекущаяДатаСеанса());
	ОтборДатаС = ДобавитьМесяц(ОтборДатаПо, -3);
	ТолькоНезавершенные = Истина;
	
	Если Параметры.Свойство("ОтборПациент") И ЗначениеЗаполнено(Параметры.ОтборПациент) Тогда
		ОтборПациент = Параметры.ОтборПациент;
	КонецЕсли;
	Если Параметры.Свойство("ОтборВрач") И ЗначениеЗаполнено(Параметры.ОтборВрач) Тогда
		ОтборВрач = Параметры.ОтборВрач;
	КонецЕсли;
	
	ЗаполнитьМаршрутыНаСервере();
	
	// Прямой вход в конкретный маршрут (из карты пациента двойным кликом — приходит позже).
	Если Параметры.Свойство("ПервичныйПрием") И ЗначениеЗаполнено(Параметры.ПервичныйПрием)
			И Параметры.Свойство("СтандартЛечения") И ЗначениеЗаполнено(Параметры.СтандартЛечения) Тогда
		ПервичныйПрием = Параметры.ПервичныйПрием;
		СтандартТекущегоМаршрута = Параметры.СтандартЛечения;
		ПостроитьМаршрутНаСервере();
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаМаршрут;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбзор;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьМаршрутыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМаршрутыНаСервере()
	
	Отбор = Новый Структура;
	Отбор.Вставить("Пациент", ОтборПациент);
	Отбор.Вставить("СтандартЛечения", ОтборСтандарт);
	Отбор.Вставить("Филиал", ОтборФилиал);
	Отбор.Вставить("Организация", ОтборОрганизация);
	Отбор.Вставить("Врач", ОтборВрач);
	Отбор.Вставить("ДатаС", ОтборДатаС);
	Отбор.Вставить("ДатаПо", ?(ЗначениеЗаполнено(ОтборДатаПо), КонецДня(ОтборДатаПо), Неопределено));
	Отбор.Вставить("ТолькоНезавершенные", ТолькоНезавершенные);
	
	Маршруты.Загрузить(МаршрутыПациентовСервер.СписокМаршрутов(Отбор));
	
КонецПроцедуры

&НаКлиенте
Процедура МаршрутыВыбор(Элемент, Строка, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Маршруты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПервичныйПрием = ТекущиеДанные.ПервичныйПрием;
	СтандартТекущегоМаршрута = ТекущиеДанные.СтандартЛечения;
	ПостроитьМаршрутНаСервере();
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаМаршрут;
	
КонецПроцедуры

&НаКлиенте
Процедура НазадКОбзору(Команда)
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбзор;
КонецПроцедуры

&НаСервере
Процедура ПостроитьМаршрутНаСервере()
	
	АвтоСтатусыСервер.ПересчитатьАвтоСтатусыМаршрута(ПервичныйПрием, СтандартТекущегоМаршрута);
	Данные = МаршрутыПациентовСервер.ДанныеМаршрута(ПервичныйПрием, СтандартТекущегоМаршрута);
	ОтчетHTML = Отчеты.МаршрутЛеченияПациента.ПостроитьHTML(Данные);
	
КонецПроцедуры

&НаКлиенте
Процедура ВестиМаршрут(Команда)
	Если Не ЗначениеЗаполнено(ПервичныйПрием)
		ИЛИ Не ЗначениеЗаполнено(СтандартТекущегоМаршрута) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ПервичныйПрием", ПервичныйПрием);
	ЗначенияЗаполнения.Вставить("СтандартЛечения", СтандартТекущегоМаршрута);
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ОткрытьФорму("Документ.омг_ВедениеМаршрутаЛечения.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОтчет(Команда)
	Закрыть();
КонецПроцедуры

Функция ПостроитьHTML(Данные) Экспорт
	
	Если Не Данные.Корректно Тогда
		Возврат "<html><body style='font-family:Segoe UI,sans-serif;padding:24px;color:#777;'>"
			+ Данные.ТекстОшибки + "</body></html>";
	КонецЕсли;
	
	ЦветаСтатусов = Новый Соответствие;
	ЦветаСтатусов.Вставить("выполнено",     "#1D9E75");
	ЦветаСтатусов.Вставить("в работе",      "#EF9F27");
	ЦветаСтатусов.Вставить("запланировано", "#B4B2A9");
	ЦветаСтатусов.Вставить("просрочено",    "#E24B4A");
	ЦветаСтатусов.Вставить("веха",          "#534AB7");
	ЦветаСтатусов.Вставить("отказ",    "#8E1B1B");
	ЦветаСтатусов.Вставить("отменено", "#C9C7BE");
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	
	// --- Диапазон оси по реальным датам маршрута ---
	МинД = Данные.ДатаПриема;
	МаксД = Данные.ДатаПриема;
	Для Каждого Этап Из Данные.Этапы Цикл
		Для Каждого Услуга Из Этап.Услуги Цикл
			КандидатыДат = Новый Массив;
			КандидатыДат.Добавить(Услуга.ДатаНачала);
			КандидатыДат.Добавить(Услуга.ДатаОкончания);
			КандидатыДат.Добавить(Услуга.ДатаФакта);
			Для Каждого Д Из КандидатыДат Цикл
				Если ЗначениеЗаполнено(Д) Тогда
					Если Д < МинД Тогда МинД = Д; КонецЕсли;
					Если Д > МаксД Тогда МаксД = Д; КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Если Сегодня < МинД Тогда МинД = Сегодня; КонецЕсли;
	Если Сегодня > МаксД Тогда МаксД = Сегодня; КонецЕсли;
	
	ОсьНачало = НачалоНедели(МинД);
	ОсьКонец  = МаксД + 3 * 86400;
	Если ОсьКонец <= ОсьНачало Тогда
		ОсьКонец = ОсьНачало + 7 * 86400;
	КонецЕсли;
	Диапазон = ОсьКонец - ОсьНачало;
	
	ВсегоДней = Диапазон / 86400;
	ШагНедель = 1;
	Если ВсегоДней > 84 Тогда
		ШагНедель = 2;
	КонецЕсли;
	Если ВсегоДней > 180 Тогда
		ШагНедель = 4;
	КонецЕсли;
	
	ЛевоСегодня = ПроцентДаты(Сегодня, ОсьНачало, Диапазон);
	
	// --- Стили ---
	HTML = "<html><head><meta charset='utf-8'><style>"
		+ "body{font-family:'Segoe UI',Arial,sans-serif;margin:0;padding:16px;color:#2B2B2B;}"
		+ ".card{border:1px solid #E5E3DC;border-radius:10px;padding:14px 18px;margin-bottom:12px;}"
		+ ".hdr{font-size:16px;font-weight:600;}"
		+ ".sub{font-size:12px;color:#777;margin-top:2px;}"
		+ ".done-badge{display:inline-block;background:#1D9E75;color:#fff;border-radius:6px;"
		+ "padding:4px 10px;font-size:12px;margin-top:8px;}"
		+ ".axis{display:flex;height:24px;margin-bottom:2px;}"
		+ ".axis-spacer{width:230px;flex-shrink:0;}"
		+ ".axis-track{position:relative;flex:1;border-bottom:1px solid #E5E3DC;}"
		+ ".tick{position:absolute;top:0;}"
		+ ".tick-lbl{font-size:10px;color:#999;transform:translateX(-50%);white-space:nowrap;}"
		+ ".stage{font-size:13px;font-weight:600;margin:14px 0 4px;}"
		+ ".row{display:flex;align-items:center;height:28px;}"
		+ ".lbl{width:230px;font-size:12px;color:#555;overflow:hidden;"
		+ "white-space:nowrap;text-overflow:ellipsis;flex-shrink:0;padding-right:8px;}"
		+ ".track{position:relative;flex:1;height:28px;background:#F4F3EF;border-radius:4px;}"
		+ ".today{position:absolute;top:0;bottom:0;width:2px;margin-left:-1px;background:#534AB7;opacity:.5;}"
		+ ".bar{position:absolute;top:6px;height:16px;border-radius:4px;}"
		+ ".dot{position:absolute;top:7px;width:14px;height:14px;margin-left:-7px;"
		+ "border-radius:50%;border:2px solid #fff;}"
		+ ".veha{position:absolute;top:6px;width:16px;height:16px;margin-left:-8px;"
		+ "border-radius:50%;background:#534AB7;border:2px solid #fff;}"
		+ ".legend{margin-top:14px;font-size:12px;color:#777;}"
		+ ".legend span{margin-right:14px;}"
		+ ".ldot{display:inline-block;width:11px;height:11px;border-radius:3px;"
		+ "vertical-align:-1px;margin-right:5px;}"
		+ "</style></head><body>";
	
	// --- Шапка ---
	HTML = HTML + "<div class='card'><div class='hdr'>"
		+ ПодготовитьТекст(Данные.НаименованиеМаршрута) + "</div>";
	HTML = HTML + "<div class='sub'>Пациент: " + ПодготовитьТекст(Строка(Данные.Пациент))
		+ "  •  первичный приём: " + ПодготовитьТекст(Строка(Данные.ПервичныйПрием)) + "</div>";
		Если Данные.ИтогЗафиксирован Тогда
		HTML = HTML + "<div class='done-badge'>Маршрут завершён: "
			+ ПодготовитьТекст(Строка(Данные.Итог)) + ", "
			+ Формат(Данные.ДатаЗакрытия, "ДЛФ=D") + "</div>";
	КонецЕсли;
	HTML = HTML + "</div>";
	
	// --- Карточка с таймлайном ---
	HTML = HTML + "<div class='card'>";
	
	// Ось дат.
	HTML = HTML + "<div class='axis'><div class='axis-spacer'></div><div class='axis-track'>";
	Метка = ОсьНачало;
	Пока Метка <= ОсьКонец Цикл
		Лево = ПроцентДаты(Метка, ОсьНачало, Диапазон);
		HTML = HTML + "<div class='tick' style='left:" + ЧислоВСтроку(Лево) + "%;'>"
			+ "<div class='tick-lbl'>" + Формат(Метка, "ДФ=dd.MM") + "</div></div>";
		Метка = Метка + ШагНедель * 7 * 86400;
	КонецЦикла;
	HTML = HTML + "</div></div>";
	
	// Дорожки этапов.
	Для Каждого Этап Из Данные.Этапы Цикл
		
		Если Этап.Услуги.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		HTML = HTML + "<div class='stage'>" + ПодготовитьТекст(Этап.Представление) + "</div>";
		
		Для Каждого Услуга Из Этап.Услуги Цикл
			
			Цвет = ЦветаСтатусов.Получить(Услуга.Статус);
			Если Цвет = Неопределено Тогда
				Цвет = "#B4B2A9";
			КонецЕсли;
			
			// Текст подсказки.
			Если Услуга.ЭтоВеха Тогда
				Подсказка = "Первичный приём, " + Формат(Услуга.ДатаНачала, "ДЛФ=D");
			Иначе
				Подсказка = Услуга.Представление + " — " + Услуга.Статус
					+ "; план: " + Формат(Услуга.ДатаНачала, "ДЛФ=D");
				Если Услуга.ЭтоПериод Тогда
					Подсказка = Подсказка + " — " + Формат(Услуга.ДатаОкончания, "ДЛФ=D");
				КонецЕсли;
				Если ЗначениеЗаполнено(Услуга.ДатаФакта) Тогда
					Подсказка = Подсказка + "; факт: " + Формат(Услуга.ДатаФакта, "ДЛФ=D");
				КонецЕсли;
				Если ЗначениеЗаполнено(Услуга.Дозировка) Тогда
					Подсказка = Подсказка + "; доза: " + Формат(Услуга.Дозировка, "ЧДЦ=3; ЧН=")
						+ ?(ЗначениеЗаполнено(Услуга.ЕдиницаИзмерения), " " + Строка(Услуга.ЕдиницаИзмерения), "")
						+ ?(ЗначениеЗаполнено(Услуга.ПриемовВДень),
							", " + Формат(Услуга.ПриемовВДень, "ЧН=") + " р/день", "");
				КонецЕсли;
			КонецЕсли;
			Подсказка = ПодготовитьТекст(Подсказка);
			
			HTML = HTML + "<div class='row'><div class='lbl' title='" + Подсказка + "'>"
				+ ПодготовитьТекст(Услуга.Представление) + "</div>";
			HTML = HTML + "<div class='track'>";
			HTML = HTML + "<div class='today' style='left:" + ЧислоВСтроку(ЛевоСегодня) + "%;'></div>";
			
			Если Услуга.ЭтоВеха Тогда
				Л = ПроцентДаты(Услуга.ДатаНачала, ОсьНачало, Диапазон);
				HTML = HTML + "<div class='veha' style='left:" + ЧислоВСтроку(Л)
					+ "%;' title='" + Подсказка + "'></div>";
			ИначеЕсли Услуга.ЭтоПериод Тогда
				Л = ПроцентДаты(Услуга.ДатаНачала, ОсьНачало, Диапазон);
				Ш = ПроцентДаты(Услуга.ДатаОкончания, ОсьНачало, Диапазон) - Л;
				Если Ш < 1 Тогда
					Ш = 1;
				КонецЕсли;
				HTML = HTML + "<div class='bar' style='left:" + ЧислоВСтроку(Л)
					+ "%;width:" + ЧислоВСтроку(Ш) + "%;background:" + Цвет
					+ ";' title='" + Подсказка + "'></div>";
			Иначе
				Л = ПроцентДаты(Услуга.ДатаНачала, ОсьНачало, Диапазон);
				HTML = HTML + "<div class='dot' style='left:" + ЧислоВСтроку(Л)
					+ "%;background:" + Цвет + ";' title='" + Подсказка + "'></div>";
			КонецЕсли;
			
			HTML = HTML + "</div></div>";
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Легенда.
	HTML = HTML + "<div class='legend'>"
		+ "<span><span class='ldot' style='background:#1D9E75;'></span>Выполнено</span>"
		+ "<span><span class='ldot' style='background:#EF9F27;'></span>В работе</span>"
		+ "<span><span class='ldot' style='background:#B4B2A9;'></span>Запланировано</span>"
		+ "<span><span class='ldot' style='background:#E24B4A;'></span>Просрочено</span>"
		+ "<span><span class='ldot' style='background:#534AB7;'></span>Первичный приём</span>"
		+ "<span><span class='ldot' style='background:#8E1B1B;'></span>Отказ / не выполняет</span>"
		+ "</div>";
	
	HTML = HTML + "</div></body></html>";
	Возврат HTML;
	
КонецФункции

Функция ПроцентДаты(Дата, ОсьНачало, Диапазон)
	
	Если Диапазон <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Значение = (Дата - ОсьНачало) / Диапазон * 100;
	Если Значение < 0 Тогда
		Значение = 0;
	ИначеЕсли Значение > 100 Тогда
		Значение = 100;
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

Функция ПодготовитьТекст(Текст)
	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;
КонецФункции

Функция ЧислоВСтроку(Число)
	Возврат СтрЗаменить(Формат(Число, "ЧДЦ=2; ЧРД=.; ЧГ=0"), ",", ".");
КонецФункции
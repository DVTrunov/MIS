		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОказаниеУслугРаботы.Ссылка КАК Документ,
	ОказаниеУслугРаботы.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА ОказаниеУслугРаботы.Ссылка.ВидОперации = &amp;ВидОперацииВозврат
			ТОГДА -ОказаниеУслугРаботы.Сумма
		ИНАЧЕ ОказаниеУслугРаботы.Сумма
	КОНЕЦ КАК Сумма,
	ОказаниеУслугРаботы.омг_НаправившийВрач КАК НаправившийВрач,
	ОказаниеУслугРаботы.Ссылка.Филиал КАК Филиал,
	ОказаниеУслугРаботы.Ссылка.Клиент КАК Клиент,
	ВЫБОР
		КОГДА ОказаниеУслугРаботы.Ссылка.ВидОперации = &amp;ВидОперацииВозврат
			ТОГДА 0 - (ОказаниеУслугРаботы.Сумма - ОказаниеУслугРаботы.Омг_СуммаНДС)
		ИНАЧЕ ОказаниеУслугРаботы.Сумма - ОказаниеУслугРаботы.Омг_СуммаНДС
	КОНЕЦ КАК СуммаБЕЗНДС,
	ВЫБОР
		КОГДА ОказаниеУслугРаботы.Ссылка.ВидОперации = &amp;ВидОперацииВозврат
			ТОГДА 0 - ОказаниеУслугРаботы.Омг_СуммаНДС
		ИНАЧЕ ОказаниеУслугРаботы.Омг_СуммаНДС
	КОНЕЦ КАК НДС
ИЗ
	Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
ГДЕ
	ОказаниеУслугРаботы.Ссылка.Проведен
	И ОказаниеУслугРаботы.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>

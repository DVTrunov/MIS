#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода  = КонецМесяца(ТекущаяДатаСеанса());
	ЗначениеПериода = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодОтчета"));
	Если ЗначениеПериода <> Неопределено
		И ЗначениеПериода.Использование
		И ТипЗнч(ЗначениеПериода.Значение) = Тип("СтандартныйПериод")
		И ЗначениеЗаполнено(ЗначениеПериода.Значение.ДатаОкончания) Тогда
		НачалоПериода = ЗначениеПериода.Значение.ДатаНачала;
		КонецПериода  = ЗначениеПериода.Значение.ДатаОкончания;
	КонецЕсли;

	Данные = ДанныеОтчета(НачалоПериода, КонецПериода);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, Новый Структура("Данные", Данные), ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выработка из оказаний услуг за период с процентом по документам "Установка расчета зарплаты".
// Данные читаются в привилегированном режиме, доступ ограничивается ролями отчета:
// - "Полные права" и "Расчетчик зарплаты" видят все;
// - "своя клиника" видит всех сотрудников основной клиники из настроек пользователя;
// - "только свой сотрудник" видит только сотрудника из карточки пользователя.
Функция ДанныеОтчета(НачалоПериода, КонецПериода)

	ВесьДоступ = РольДоступна("ПолныеПрава") Или РольДоступна("РасчетчикЗарплаты");
	ТолькоСвояКлиника = Не ВесьДоступ И РольДоступна("омг_РасчетЗарплатыУпрощенныйСвояКлиника");
	ТолькоСвойСотрудник = Не ВесьДоступ И Не ТолькоСвояКлиника;

	// Роли проверены выше: дальше данные читаются без ограничений прав пользователя.
	УстановитьПривилегированныйРежим(Истина);

	ТекущийПользователь = Пользователи.ТекущийПользователь();

	СвояКлиника = Справочники.Филиалы.ПустаяСсылка();
	Если ТолькоСвояКлиника Тогда
		СвояКлиника = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекущийПользователь, "ОсновнойФилиал");
		Если Не ЗначениеЗаполнено(СвояКлиника) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"В настройках пользователя не указана основная клиника, поэтому отчет пуст. Обратитесь к администратору.");
		КонецЕсли;
	КонецЕсли;

	СвойСотрудник = Справочники.Сотрудники.ПустаяСсылка();
	Если ТолькоСвойСотрудник Тогда
		СвойСотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийПользователь, "Сотрудник");
		Если Не ЗначениеЗаполнено(СвойСотрудник) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"В карточке пользователя не указан сотрудник, поэтому отчет пуст. Обратитесь к администратору.");
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Выработка.Период КАК Дата,
	|	Выработка.Регистратор КАК Документ,
	|	ВЫРАЗИТЬ(Выработка.Регистратор КАК Документ.ОказаниеУслуг).Организация КАК Организация,
	|	Выработка.Филиал КАК Клиника,
	|	Выработка.Сотрудник КАК Сотрудник,
	|	Выработка.Сотрудник.Должность КАК Должность,
	|	Выработка.Номенклатура КАК Номенклатура,
	|	Выработка.омг_Ассистирование КАК Ассистирование,
	|	Выработка.омг_РольПерсонала КАК Роль,
	|	Выработка.Количество КАК Количество,
	|	Выработка.Сумма КАК Сумма,
	|	Выработка.омг_СуммаБезНДС КАК СуммаБезНДС
	|ИЗ
	|	РегистрНакопления.ВыработкаСотрудников КАК Выработка
	|ГДЕ
	|	Выработка.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Выработка.Активность
	|	И Выработка.Регистратор ССЫЛКА Документ.ОказаниеУслуг
	|	И Выработка.ТипВыработки В (&ТипыВыработки)
	|	И (НЕ &ТолькоСвояКлиника
	|			ИЛИ Выработка.Филиал = &СвояКлиника
	|				И &СвояКлиника <> ЗНАЧЕНИЕ(Справочник.Филиалы.ПустаяСсылка))
	|	И (НЕ &ТолькоСвойСотрудник
	|			ИЛИ Выработка.Сотрудник = &СвойСотрудник
	|				И &СвойСотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Проценты.Период КАК Период,
	|	Проценты.Организация КАК Организация,
	|	Проценты.Филиал КАК Филиал,
	|	Проценты.Должность КАК Должность,
	|	Проценты.Сотрудник КАК Сотрудник,
	|	Проценты.Номенклатура КАК Номенклатура,
	|	Проценты.Ассистирование КАК Ассистирование,
	|	Проценты.Процент КАК Процент
	|ИЗ
	|	РегистрСведений.омг_ПроцентыРасчетаЗарплаты КАК Проценты
	|ГДЕ
	|	Проценты.Период <= &КонецПериода
	|	И Проценты.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";

	ТипыВыработки = Новый Массив;
	ТипыВыработки.Добавить(Перечисления.ТипыВыработки.Услуги);
	ТипыВыработки.Добавить(Перечисления.ТипыВыработки.УслугиПоАбонементу);

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ТипыВыработки", ТипыВыработки);
	Запрос.УстановитьПараметр("ТолькоСвойСотрудник", ТолькоСвойСотрудник);
	Запрос.УстановитьПараметр("СвойСотрудник", СвойСотрудник);
	Запрос.УстановитьПараметр("ТолькоСвояКлиника", ТолькоСвояКлиника);
	Запрос.УстановитьПараметр("СвояКлиника", СвояКлиника);

	Результаты = Запрос.ВыполнитьПакет();
	Данные = Результаты[0].Выгрузить();
	ИндексПроцентов = ИндексПроцентов(Результаты[1].Выбрать());

	Данные.Колонки.Добавить("Процент", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 2)));
	Данные.Колонки.Добавить("Итого", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Данные.Колонки.Добавить("ИсточникПроцента", Новый ОписаниеТипов("Строка"));

	КэшНоменклатуры = Новый Соответствие;
	ПустойСотрудник = Справочники.Сотрудники.ПустаяСсылка();

	Для Каждого СтрокаДанных Из Данные Цикл

		Найден = Ложь;
		Для Каждого Кандидат Из КандидатыНоменклатуры(СтрокаДанных.Номенклатура, КэшНоменклатуры) Цикл
			// Индивидуальная строка (должность + сотрудник) важнее строки по должности.
			Для Каждого СотрудникКлюча Из СотрудникиДляПоиска(СтрокаДанных.Сотрудник, ПустойСотрудник) Цикл
				Ключ = КлючПроцента(СтрокаДанных.Организация, СтрокаДанных.Клиника, СтрокаДанных.Должность,
					СотрудникКлюча, Кандидат.Значение, СтрокаДанных.Ассистирование);
				Процент = ПроцентНаДату(ИндексПроцентов, Ключ, СтрокаДанных.Дата);
				Если Процент <> Неопределено Тогда
					СтрокаДанных.Процент = Процент;
					СтрокаДанных.ИсточникПроцента = Кандидат.Представление
						+ ?(ЗначениеЗаполнено(СотрудникКлюча), " (индивидуально)", "");
					Найден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Найден Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Не Найден Тогда
			СтрокаДанных.ИсточникПроцента = "Процент не установлен";
		КонецЕсли;
		СтрокаДанных.Итого = Окр(СтрокаДанных.СуммаБезНДС * СтрокаДанных.Процент / 100, 2);

	КонецЦикла;

	Возврат Данные;

КонецФункции

// Записи регистра процентов, сгруппированные по ключу. Внутри ключа записи идут от новых к старым.
Функция ИндексПроцентов(Выборка)

	Индекс = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Ключ = КлючПроцента(Выборка.Организация, Выборка.Филиал, Выборка.Должность,
			Выборка.Сотрудник, Выборка.Номенклатура, Выборка.Ассистирование);
		Записи = Индекс.Получить(Ключ);
		Если Записи = Неопределено Тогда
			Записи = Новый Массив;
			Индекс.Вставить(Ключ, Записи);
		КонецЕсли;
		Записи.Добавить(Новый Структура("Период, Процент", Выборка.Период, Выборка.Процент));
	КонецЦикла;

	Возврат Индекс;

КонецФункции

Функция КлючПроцента(Организация, Филиал, Должность, Сотрудник, Номенклатура, Ассистирование)

	Возврат СтрШаблон("%1|%2|%3|%4|%5|%6",
		ИдентификаторСсылки(Организация), ИдентификаторСсылки(Филиал), ИдентификаторСсылки(Должность),
		ИдентификаторСсылки(Сотрудник), ИдентификаторСсылки(Номенклатура), Формат(Ассистирование, "БЛ=0; БИ=1"));

КонецФункции

Функция ИдентификаторСсылки(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

// Процент из последней записи, действующей на дату услуги.
Функция ПроцентНаДату(Индекс, Ключ, Дата)

	Записи = Индекс.Получить(Ключ);
	Если Записи = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Период <= Дата Тогда
			Возврат Запись.Процент;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция СотрудникиДляПоиска(Сотрудник, ПустойСотрудник)

	Результат = Новый Массив;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Результат.Добавить(Сотрудник);
	КонецЕсли;
	Результат.Добавить(ПустойСотрудник);
	Возврат Результат;

КонецФункции

// Значения номенклатуры для поиска процента в порядке приоритета:
// услуга, ее группы от ближайшей к верхней, тип услуги.
Функция КандидатыНоменклатуры(Номенклатура, Кэш)

	Кандидаты = Кэш.Получить(Номенклатура);
	Если Кандидаты <> Неопределено Тогда
		Возврат Кандидаты;
	КонецЕсли;

	Кандидаты = Новый СписокЗначений;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Кандидаты.Добавить(Номенклатура, "Услуга");
		Родитель = Номенклатура.Родитель;
		Пока ЗначениеЗаполнено(Родитель) Цикл
			Кандидаты.Добавить(Родитель, "Группа """ + Строка(Родитель) + """");
			Родитель = Родитель.Родитель;
		КонецЦикла;
		ТипУслуги = Номенклатура.омг_ТипУслуги;
		Если ЗначениеЗаполнено(ТипУслуги) Тогда
			Кандидаты.Добавить(ТипУслуги, "Тип услуги """ + Строка(ТипУслуги) + """");
		КонецЕсли;
	КонецЕсли;

	Кэш.Вставить(Номенклатура, Кандидаты);
	Возврат Кандидаты;

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

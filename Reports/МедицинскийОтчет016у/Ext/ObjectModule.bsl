	Возврат "Форма 016/у. Сводная ведомость  учета движения пациентов и коечного фонда медицинской организации";	
	
КонецФункции

#Область АлгоритмЗаполнения

// Заполнить отчет.
//
// Параметры:
//  ВыбраннаяФорма			 - ФормаКлиентскогоПриложения	 - форма
//  ПараметрыОтчета			 - Структура					 - параметры отчета
//  ЭтаФорма				 - ФормаКлиентскогоПриложения	 - форма
//  СтруктураРеквизитовФормы - Структура					 - структура реквизитов формы.
//
Процедура ЗаполнитьОтчет(ВыбраннаяФорма, ПараметрыОтчета, ЭтаФорма, СтруктураРеквизитовФормы) Экспорт 
	
	Подразделение = ЭтаФорма.ПолеТабличногоДокументаФормаОтчета.Область("Подразделение").Значение;
	
	Контейнер = Новый Структура();
	 
	Контейнер.Вставить("МногострочныеДанные");
	Контейнер.Вставить("Дата");
	Контейнер.Вставить("НаименованиеАдресЛПУ");	
	Контейнер.Вставить("ОтчетныйПериод");
	
	РазницаПоМесяцам = Месяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета) - Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета);
	Если РазницаПоМесяцам = 0 Тогда
		ОтчетныйПериод = "Месяц";
		Дата = Формат(ПараметрыОтчета.мДатаКонцаПериодаОтчета, "ДФ='ММММ гггг ''г. '''");
	ИначеЕсли РазницаПоМесяцам = 11 Тогда
		ОтчетныйПериод = "Год";
		Дата = Формат(ПараметрыОтчета.мДатаКонцаПериодаОтчета, "ДФ='гггг ''г. '''");
	Иначе
		ОтчетныйПериод = "Полугодие";
		Дата = ?(НачалоГода(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = ПараметрыОтчета.мДатаНачалаПериодаОтчета, "I полугодие", "II полугодие");
		Дата = Дата + Формат(ПараметрыОтчета.мДатаКонцаПериодаОтчета, "ДФ=' гггг ''г. '''");
	КонецЕсли;
	
	Контейнер.МногострочныеДанные = ПолучитьТаблицуМногострочныеДанные(ПараметрыОтчета.мДатаНачалаПериодаОтчета,ПараметрыОтчета.мДатаКонцаПериодаОтчета,Подразделение,ОтчетныйПериод);
	Контейнер.НаименованиеАдресЛПУ = ПараметрыОтчета.Филиал.НазваниеОрганизации + " " + КонтактнаяИнформацияСерверПереопределяемый.НайтиКонтактнуюИнформацию(ПараметрыОтчета.Филиал, Перечисления.ТипыКонтактнойИнформации.Адрес);	
	Контейнер.Дата = Дата;
	Контейнер.ОтчетныйПериод = ОтчетныйПериод;
	
	ВнестиМногоСтрочнуюДинамичнуюТаблицу(ЭтаФорма, "Титульный", Контейнер.МногострочныеДанные, "СтрокаТаблицы",,Истина);
	ЭтаФорма["СтруктураДанныхСтраниц"]["Титульный"].Вставить("НаименованиеАдресЛПУ",Контейнер.НаименованиеАдресЛПУ);
	ЭтаФорма["СтруктураДанныхСтраниц"]["Титульный"].Вставить("ОтчетныйПериод",Контейнер.ОтчетныйПериод);
	ЭтаФорма["СтруктураДанныхСтраниц"]["Титульный"].Вставить("Дата",Контейнер.Дата);
	
КонецПроцедуры

Функция ПолучитьТаблицуМногострочныеДанные(НачалоПериода, КонецПериода, Подразделение, ОтчетныйПериод)
	
	ТаблицаДанных = Новый ТаблицаЗначений();
	
	ТаблицаДанных.Колонки.Добавить("Колонка1");
	
	Для Счетчик = 2 По 24 Цикл
		ТаблицаДанных.Колонки.Добавить("Колонка" + Строка(Счетчик), Новый ОписаниеТипов("Число"));
	КонецЦикла;
		
	НачалоПериода = НачалоМесяца(НачалоПериода);
	КонецПериода = КонецМесяца(КонецПериода);
	
	ДокументыЗаПериод = ПолучитьДокументы007(Подразделение, НачалоПериода, КонецПериода);
	ЗаполнитьКолонки(ТаблицаДанных,ДокументыЗаПериод, Подразделение, НачалоПериода, КонецПериода);
	
	Даты = Неопределено;
	Если Не ЕстьДокументыНаКаждуюДатуПериода(Даты, Подразделение, НачалоПериода, КонецПериода) Тогда
		МассивДат = ПолучитьОтсутствующиеДаты(Даты, НачалоПериода, КонецПериода);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОтстутствующихДанных(МассивДат));
	КонецЕсли;
			
	Возврат ТаблицаДанных;
	
КонецФункции

Процедура ВнестиМногоСтрочнуюДинамичнуюТаблицу(ЭтаФорма, ИмяРаздела, Таблица, ИмяОбластиСтрок, ВыводитьПустыеСтроки = Ложь, ОчищатьТаблицу = Ложь)
	
	СтруктураДанных = ЭтаФорма["СтруктураДанныхСтраниц"][ИмяРаздела];
	МаксКол = Таблица.Колонки.Количество();	
	
	Если ОчищатьТаблицу Тогда
		Для Каждого КлючИЗначение Из СтруктураДанных Цикл
			Если СтрНайти(КлючИЗначение.Ключ, ИмяОбластиСтрок + "__") Тогда
				СтруктураДанных.Удалить(КлючИЗначение.Ключ);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Стр = 1;
	Для каждого СтрокаТаблицы Из Таблица Цикл
		Для Сч = 0 По МаксКол - 1 Цикл
			ИмяЯчейки = ИмяОбластиСтрок + "__" + Формат(Сч + 1, "ЧЦ=3; ЧВН=") + "_" + Строка(Стр);	
			Значение = СтрокаТаблицы[Сч]; 
			Если ЗначениеЗаполнено(Значение) Или ВыводитьПустыеСтроки Тогда
				СтруктураДанных.Вставить(ИмяЯчейки,Значение);
			ИначеЕсли СтруктураДанных.Свойство(ИмяЯчейки) Тогда 
				СтруктураДанных.Удалить(ИмяЯчейки);	
			КонецЕсли;
		КонецЦикла;
		Стр = Стр + 1;
	КонецЦикла;
	
КонецПроцедуры
 
#КонецОбласти


Функция ЕстьДокументыНаКаждуюДатуПериода(Даты, Подразделение, НачалоПериода, КонецПериода)
	
	ВсегоДней = (НачалоДня(КонецПериода) - НачалоДня(НачалоПериода)) / (60 * 60 * 24) + 1;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ДанныеМедицинскихОтчетов007у.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ДанныеМедицинскихОтчетов007у КАК ДанныеМедицинскихОтчетов007у
	               |ГДЕ
	               |	ДанныеМедицинскихОтчетов007у.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ДанныеМедицинскихОтчетов007у.Подразделение = &Подразделение
				   |	И ДанныеМедицинскихОтчетов007у.Активность";
	
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Даты = Запрос.Выполнить().Выбрать();
	
	Возврат ВсегоДней = Даты.Количество();
	
КонецФункции

Функция ПолучитьОтсутствующиеДаты(Даты, НачалоПериода, КонецПериода)
	
	Период = НачалоПериода;
	
	Массив = Новый Массив;
	Пока Период < КонецПериода Цикл
		Массив.Добавить(Период);
		Период = Период + 86400;
	КонецЦикла;
	
	Пока Даты.Следующий() Цикл
		Период = Массив.Найти(Даты.Период);
		Если Период <> Неопределено Тогда
			Массив.Удалить(Период);		
		КонецЕсли;
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция СообщениеОбОтстутствующихДанных(Даты)
	
	Сообщение = "Отсутствуют данные для заполнения на следующие даты:";
	
	ВсегоДат = Даты.Количество();
	Ограничение = ОграничениеНаВыводДат();
	
	МаксСч = ?(ВсегоДат <= Ограничение, ВсегоДат - 1, Ограничение);
	
	Сообщение = Сообщение + " " + Формат(Даты[0],"ДФ=dd.MM.yyyy");
	
	Для Сч = 1 По МаксСч Цикл
		Сообщение = Сообщение + ", " + Формат(Даты[Сч],"ДФ=dd.MM.yyyy");		
	КонецЦикла;
	
	Сообщение = Сообщение + ".";
	
	Если МаксСч = Ограничение Тогда
		Сообщение = Сообщение + ".." + Символы.ПС + "Ещё " + Строка(ВсегоДат - Ограничение) + ".";		
	КонецЕсли;
	
	Возврат Сообщение;
	

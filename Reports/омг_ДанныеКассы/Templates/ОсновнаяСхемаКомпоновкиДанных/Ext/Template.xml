////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	"Продажа" КАК ВидДвижения,
	1 КАК Порядок
ПОМЕСТИТЬ ВТ_ВидыДвижения

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Возврат",
	2

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Итого продаж",
	3

ОБЪЕДИНИТЬ ВСЕ


	"Прочий приход",
	6

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Остаток на начало",
	-1

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Остаток на конец",
	7
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДенежныеСредстваОстатки.Касса.Филиал КАК Филиал,
	ДенежныеСредстваОстатки.Касса КАК Касса,
	ДенежныеСредстваОстатки.СуммаОстаток КАК ОстатокПоКассеНаНачало,
	0 КАК ОстатокПоКассеНаКонец
ПОМЕСТИТЬ ВТ_ОстаткиПоКассе
ИЗ
	РегистрНакопления.ДенежныеСредства.Остатки(&amp;ДатаНачала {(&amp;ДатаНачала)}, ) КАК ДенежныеСредстваОстатки

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ДенежныеСредстваОстатки.Касса.Филиал,
	ДенежныеСредстваОстатки.Касса,
	0,
	ДенежныеСредстваОстатки.СуммаОстаток
ИЗ
	РегистрНакопления.ДенежныеСредства.Остатки(&amp;ДатаОкончания {(&amp;ДатаОкончания)}, ) КАК ДенежныеСредстваОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДвиженияДенежныхСредствОбороты.Филиал КАК Филиал,
	ВЫБОР
		КОГДА ДвиженияДенежныхСредствОбороты.Касса ССЫЛКА Справочник.Кассы
			ТОГДА &amp;ВидОплатыНаличные
		ИНАЧЕ &amp;ВидОплатыБезналичные
	КОНЕЦ КАК ВидОплаты,
	ЕСТЬNULL(ДвиженияДенежныхСредствОбороты.Касса.омг_ИспользуемыйТерминал, НЕОПРЕДЕЛЕНО) КАК Терминал,
	ВЫБОР
		КОГДА ДвиженияДенежныхСредствОбороты.Регистратор ССЫЛКА Документ.ОказаниеУслуг
			ТОГДА ВЫБОР
					КОГДА ДвиженияДенежныхСредствОбороты.Регистратор.ВидОперации = &amp;ВидОперацииПродажа
						ТОГДА "Продажа"
					ИНАЧЕ "Возврат"
				КОНЕЦ
		КОГДА ДвиженияДенежныхСредствОбороты.Регистратор ССЫЛКА Документ.РасходныйКассовыйОрдер
			ТОГДА ВЫБОР
					КОГДА ДвиженияДенежныхСредствОбороты.Регистратор.ВидОперации = &amp;ВидОперацииИнкассация
						ТОГДА "Инкассация"
					ИНАЧЕ "Прочи расход"
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ДвиженияДенежныхСредствОбороты.ПриходРасход = &amp;ДДСПриход
					ТОГДА "Прочий приход"
				ИНАЧЕ "Прочий расход"
			КОНЕЦ
	КОНЕЦ КАК ВидДвижения,
	ДвиженияДенежныхСредствОбороты.Регистратор КАК ДокументДвижения,
	ВЫБОР
		КОГДА ДвиженияДенежныхСредствОбороты.Регистратор ССЫЛКА Документ.ОказаниеУслуг
			ТОГДА "Итого продаж"
		ИНАЧЕ ""
	КОНЕЦ КАК ВидДвиженияИтоги,
	ВЫБОР
		КОГДА ДвиженияДенежныхСредствОбороты.ПриходРасход = &amp;ДДСПриход
			ТОГДА ДвиженияДенежныхСредствОбороты.СуммаОборот
		ИНАЧЕ -ДвиженияДенежныхСредствОбороты.СуммаОборот
	КОНЕЦ КАК Сумма
ПОМЕСТИТЬ ВТ_ОборотыДС
ИЗ
	РегистрНакопления.ДвиженияДенежныхСредств.Обороты(&amp;ДатаНачала {(&amp;ДатаНачала)}, &amp;ДатаОкончания {(&amp;ДатаОкончания)}, Регистратор, ) КАК ДвиженияДенежныхСредствОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ФилиалыДС.Филиал.Организация КАК Организация,
	ФилиалыДС.Филиал КАК Филиал,
	ВТ_ВидыДвижения.ВидДвижения КАК ВидДвижения,
	ВЫБОР
		КОГДА ВТ_ОборотыДС.ВидДвижения ЕСТЬ NULL
				ИЛИ ВТ_ОборотыДС.ВидДвижения = "Итого продаж"
			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОплаты.ПустаяСсылка)
		ИНАЧЕ ВТ_ОборотыДС.ВидОплаты
	КОНЕЦ КАК ВидОплаты,
	ВЫБОР
		КОГДА ВТ_ОборотыДС.ВидДвижения ЕСТЬ NULL
				ИЛИ ВТ_ОборотыДС.ВидДвижения = "Итого продаж"
			ТОГДА НЕОПРЕДЕЛЕНО
		ИНАЧЕ ВТ_ОборотыДС.Терминал
	КОНЕЦ КАК Терминал,
	ВЫБОР
		КОГДА ВТ_ОборотыДС.ВидДвижения ЕСТЬ NULL
				ИЛИ ВТ_ОборотыДС.ВидДвижения = "Итого продаж"
			ТОГДА НЕОПРЕДЕЛЕНО
		ИНАЧЕ ВТ_ОборотыДС.ДокументДвижения
	КОНЕЦ КАК ДокументДвижения,
	ЕСТЬNULL(ВТ_ОборотыДС.Сумма, 0) КАК Сумма,
	ВТ_ВидыДвижения.Порядок КАК Порядок
ИЗ
	ВТ_Филиалы КАК ФилиалыДС
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВидыДвижения КАК ВТ_ВидыДвижения
		ПО (ВТ_ВидыДвижения.Порядок &gt; 0)
			И (ВТ_ВидыДвижения.Порядок &lt; 7)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОборотыДС КАК ВТ_ОборотыДС
		ПО ФилиалыДС.Филиал = ВТ_ОборотыДС.Филиал
			И (ВТ_ВидыДвижения.ВидДвижения = ВТ_ОборотыДС.ВидДвижения
				ИЛИ ВТ_ВидыДвижения.ВидДвижения = ВТ_ОборотыДС.ВидДвиженияИтоги)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	NULL,
	ВТ_Филиалы.Филиал,
	ВТ_ВидыДвижения.ВидДвижения,
	ЗНАЧЕНИЕ(Перечисление.ВидыОплаты.ПустаяСсылка),
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	ЕСТЬNULL(ВТ_ОстаткиПоКассе.ОстатокПоКассеНаНачало, 0),
	ВТ_ВидыДвижения.Порядок
ИЗ
	ВТ_Филиалы КАК ВТ_Филиалы
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВидыДвижения КАК ВТ_ВидыДвижения
		ПО (ИСТИНА)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиПоКассе КАК ВТ_ОстаткиПоКассе
		ПО ВТ_Филиалы.Филиал = ВТ_ОстаткиПоКассе.Филиал
			И (ЕСТЬNULL(ВТ_ОстаткиПоКассе.ОстатокПоКассеНаНачало, 0) &gt; 0)
ГДЕ
	ВТ_ВидыДвижения.Порядок = -1

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	NULL,
	ВТ_Филиалы.Филиал,
	ВТ_ВидыДвижения.ВидДвижения,
	ЗНАЧЕНИЕ(Перечисление.ВидыОплаты.ПустаяСсылка),
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	ЕСТЬNULL(ВТ_ОстаткиПоКассе.ОстатокПоКассеНаКонец, 0),
	ВТ_ВидыДвижения.Порядок
ИЗ
	ВТ_Филиалы КАК ВТ_Филиалы
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВидыДвижения КАК ВТ_ВидыДвижения
		ПО (ИСТИНА)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиПоКассе КАК ВТ_ОстаткиПоКассе
		ПО ВТ_Филиалы.Филиал = ВТ_ОстаткиПоКассе.Филиал
			И (ЕСТЬNULL(ВТ_ОстаткиПоКассе.ОстатокПоКассеНаКонец, 0) &gt; 0)
ГДЕ
	ВТ_ВидыДвижения.Порядок = 7</query>
	</dataSet>

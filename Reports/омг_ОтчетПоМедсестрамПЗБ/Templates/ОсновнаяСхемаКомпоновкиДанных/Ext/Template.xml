		<query>ВЫБРАТЬ
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Ссылка КАК Ссылка,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Статус КАК Статус,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Дата КАК Дата,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Пациент КАК Пациент,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Медсестра КАК Медсестра,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Филиал КАК Филиал,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.СуммаДокумента КАК СуммаДокумента,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.ДокументОснование КАК ДокументОснование,
	РАЗНОСТЬДАТ(омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Пациент.ДатаРождения, &amp;ТекущаяДата, ГОД) КАК Лет
ПОМЕСТИТЬ ВТ_Заявки
ИЗ
	Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС
ГДЕ
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Ссылка КАК Заявка,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Статус КАК Статус,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Пациент КАК Пациент,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Медсестра КАК Медсестра,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Филиал КАК Филиал,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.СуммаДокумента КАК СуммаДокумента,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.ДокументОснование КАК ДокументОснование,
	ОказаниеУслугРаботы.Номенклатура КАК Номенклатура,
	ОказаниеУслугРаботы.Сумма КАК Сумма,
	ВЫБОР
		КОГДА омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Лет &gt;= 3
			ТОГДА "Старше 3-х лет"
		ИНАЧЕ "Младше 3-х лет"
	КОНЕЦ КАК Возвраст,
	ОказаниеУслугРаботы.СуммаСкидки КАК СуммаСкидки,
	ОказаниеУслугРаботы.СуммаБезСкидки КАК СуммаБезСкидки,
	ОказаниеУслугРаботы.СуммаНДС КАК СуммаНДС,
	ОказаниеУслугРаботы.СуммаБезНДС КАК СуммаБезНДС,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Филиал.Организация КАК Организация,
	ИСТИНА КАК ЭтоУслугиЛИС
ИЗ
	ВТ_Заявки КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Ссылка КАК Ссылка,
			омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Номенклатура КАК Номенклатура,
			ВЫБОР
				КОГДА омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Набор = омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Номенклатура
					ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПУстаяСсылка)
				ИНАЧЕ омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Набор
			КОНЕЦ КАК Набор
		ИЗ
			ВТ_Заявки КАК ВТ_Заявки
				ЛЕВОЕ СОЕДИНЕНИЕ Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.АнализыПоКонтейнерам КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам
				ПО ВТ_Заявки.Ссылка = омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Ссылка
		
		СГРУППИРОВАТЬ ПО
			омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Номенклатура,
			омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Ссылка,
			ВЫБОР
				КОГДА омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Набор = омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Номенклатура
					ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПУстаяСсылка)
				ИНАЧЕ омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Набор
			КОНЕЦ) КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				ОказаниеУслугРаботы.Номенклатура КАК Номенклатура,
				СУММА(ОказаниеУслугРаботы.Сумма) КАК Сумма,
				ВТ_Заявки.Ссылка КАК Заявка,
				СУММА(ОказаниеУслугРаботы.СуммаСкидки) КАК СуммаСкидки,
				СУММА(ОказаниеУслугРаботы.Сумма + ОказаниеУслугРаботы.СуммаСкидки) КАК СуммаБезСкидки,
				СУММА(ОказаниеУслугРаботы.Омг_СуммаНДС) КАК СуммаНДС,
				СУММА(ОказаниеУслугРаботы.Сумма - ОказаниеУслугРаботы.Омг_СуммаНДС) КАК СуммаБезНДС,
				ОказаниеУслугРаботы.омг_НаборЛИС КАК омг_НаборЛИС
			ИЗ
				ВТ_Заявки КАК ВТ_Заявки
					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
					ПО ВТ_Заявки.ДокументОснование = ОказаниеУслугРаботы.Ссылка
			
			СГРУППИРОВАТЬ ПО
				ОказаниеУслугРаботы.Номенклатура,
				ВТ_Заявки.Ссылка,
				ОказаниеУслугРаботы.омг_НаборЛИС) КАК ОказаниеУслугРаботы
			ПО омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Номенклатура = ОказаниеУслугРаботы.Номенклатура
				И (ОказаниеУслугРаботы.Заявка = омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Ссылка)
				И омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Набор = ОказаниеУслугРаботы.омг_НаборЛИС
		ПО омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Ссылка = омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Ссылка
ГДЕ
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Ссылка,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Статус,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Пациент,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Медсестра,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Филиал,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.СуммаДокумента,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.ДокументОснование,
	ОказаниеУслугРаботы.Номенклатура,
	ОказаниеУслугРаботы.Сумма,
	ВЫБОР
		КОГДА омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Лет &gt;= 3
			ТОГДА "Старше 3-х лет"
		ИНАЧЕ "Младше 3-х лет"
	КОНЕЦ,
	ОказаниеУслугРаботы.СуммаСкидки,
	ОказаниеУслугРаботы.СуммаБезСкидки,
	ОказаниеУслугРаботы.СуммаНДС,
	ОказаниеУслугРаботы.СуммаБезНДС,
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Филиал.Организация,
	ЛОЖЬ
ИЗ
	ВТ_Заявки КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ОказаниеУслугРаботы.Номенклатура КАК Номенклатура,
			СУММА(ОказаниеУслугРаботы.Сумма) КАК Сумма,
			ВТ_Заявки.Ссылка КАК Заявка,
			СУММА(ОказаниеУслугРаботы.Сумма + ОказаниеУслугРаботы.СуммаСкидки) КАК СуммаБезСкидки,
			СУММА(ОказаниеУслугРаботы.Омг_СуммаНДС) КАК СуммаНДС,
			СУММА(ОказаниеУслугРаботы.СуммаСкидки) КАК СуммаСкидки,
			СУММА(ОказаниеУслугРаботы.Сумма - ОказаниеУслугРаботы.Омг_СуммаНДС) КАК СуммаБезНДС
		ИЗ
			ВТ_Заявки КАК ВТ_Заявки
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
				ПО ВТ_Заявки.ДокументОснование = ОказаниеУслугРаботы.Ссылка
		
		СГРУППИРОВАТЬ ПО
			ОказаниеУслугРаботы.Номенклатура,
			ВТ_Заявки.Ссылка) КАК ОказаниеУслугРаботы
		ПО омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Ссылка = ОказаниеУслугРаботы.Заявка
			И (НЕ ОказаниеУслугРаботы.Номенклатура В ИЕРАРХИИ
					(ВЫБРАТЬ
						омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
					ИЗ
						РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС))
ГДЕ
	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
	</dataSet>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаБезСкидки</dataPath>
		<expression>Сумма(СуммаБезСкидки)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаДокумента</dataPath>
		<expression>Сумма(СуммаДокумента)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаНДС</dataPath>
		<expression>Сумма(СуммаНДС)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаСкидки</dataPath>
		<expression>Сумма(СуммаСкидки)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаБезНДС</dataPath>
		<expression>Сумма(СуммаБезНДС)</expression>
	</totalField>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">2100-12-31T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;СтандартныйПериод.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">1900-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;СтандартныйПериод.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>СтандартныйПериод</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>

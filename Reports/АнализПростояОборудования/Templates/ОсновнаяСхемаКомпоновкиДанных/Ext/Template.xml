			<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Заявка.Ссылка КАК Ссылка,
	Заявка.Филиал КАК Филиал,
	Заявка.НесколькоСотрудников КАК НесколькоСотрудников,
	Заявка.Кабинет КАК Кабинет
ПОМЕСТИТЬ Заявки
ИЗ
	Документ.Заявка КАК Заявка
ГДЕ
	Заявка.ДатаНачала &gt;= &amp;ДатаНачала
	И Заявка.ДатаОкончания &lt;= &amp;ДатаОкончания
	И НЕ Заявка.ПометкаУдаления
	И Заявка.Состояние.ТипСостояния &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ТипыСостоянийЗаявок.Отменена)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СправочникНоменклатура.Ссылка КАК Ссылка
ПОМЕСТИТЬ НоменклатураБезОборудования
ИЗ
	Справочник.Номенклатура КАК СправочникНоменклатура
ГДЕ
	СправочникНоменклатура.ПланируетсяБезОборудования
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаявкаРаботы.Оборудование1 КАК Оборудование1,
	ЗаявкаРаботы.Оборудование2 КАК Оборудование2,
	ЗаявкаРаботы.Оборудование3 КАК Оборудование3,
	ЗаявкаРаботы.Номенклатура КАК Номенклатура,
	РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1), ЗаявкаРаботы.Продолжительность, МИНУТА) КАК ПродолжительностьФакт,
	Заявки.Ссылка КАК Документ,
	Заявки.Филиал КАК Филиал,
	Заявки.НесколькоСотрудников КАК НесколькоСотрудников,
	Заявки.Кабинет КАК Кабинет
ПОМЕСТИТЬ ЗаявкаРаботы
ИЗ
	Документ.Заявка.Работы КАК ЗаявкаРаботы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Заявки КАК Заявки
		ПО ЗаявкаРаботы.Ссылка = Заявки.Ссылка
ГДЕ
	НЕ ЗаявкаРаботы.Номенклатура В
				(ВЫБРАТЬ
					НоменклатураБезОборудования.Ссылка
				ИЗ
					НоменклатураБезОборудования КАК НоменклатураБезОборудования)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КабинетыОднаКолонка.Документ КАК Документ,
	КабинетыОднаКолонка.Филиал КАК Филиал,
	СУММА(КабинетыОднаКолонка.ПродолжительностьФакт) КАК ПродолжительностьФакт,
	КабинетыОднаКолонка.Кабинет КАК Кабинет
ПОМЕСТИТЬ КабинетыОднаКолонка
ИЗ
	(ВЫБРАТЬ
		ЗаявкаРаботы.Документ КАК Документ,
		ЗаявкаРаботы.Филиал КАК Филиал,
		ЗаявкаРаботы.ПродолжительностьФакт КАК ПродолжительностьФакт,
		ЗаявкаРаботы.Кабинет КАК Кабинет
	ИЗ
		ЗаявкаРаботы КАК ЗаявкаРаботы
	ГДЕ
		НЕ ЗаявкаРаботы.НесколькоСотрудников
		И НЕ ЗаявкаРаботы.Кабинет = ЗНАЧЕНИЕ(Справочник.Оборудование.ПустаяСсылка)
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ЗаявкаРаботы.Документ,
		ЗаявкаРаботы.Филиал,
		ЗаявкаРаботы.ПродолжительностьФакт,
		ВЫБОР
			КОГДА ЗаявкаРаботы.НесколькоСотрудников
					И ЗаявкаРаботы.Оборудование1 = ЗНАЧЕНИЕ(Справочник.Оборудование.ПустаяСсылка)
				ТОГДА ЗаявкаРаботы.Кабинет
			ИНАЧЕ ЗаявкаРаботы.Оборудование1
		КОНЕЦ
	ИЗ
		ЗаявкаРаботы КАК ЗаявкаРаботы
	ГДЕ
		(ЗаявкаРаботы.НесколькоСотрудников
				ИЛИ НЕ ЗаявкаРаботы.Оборудование1 = ЗНАЧЕНИЕ(Справочник.Оборудование.ПустаяСсылка))
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ЗаявкаРаботы.Документ,
		ЗаявкаРаботы.Филиал,
		ЗаявкаРаботы.ПродолжительностьФакт,
		ЗаявкаРаботы.Оборудование2
	ИЗ
		ЗаявкаРаботы КАК ЗаявкаРаботы
	ГДЕ
		НЕ ЗаявкаРаботы.Оборудование2 = ЗНАЧЕНИЕ(Справочник.Оборудование.ПустаяСсылка)
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ЗаявкаРаботы.Документ,
		ЗаявкаРаботы.Филиал,
		ЗаявкаРаботы.ПродолжительностьФакт,
		ЗаявкаРаботы.Оборудование3
	ИЗ
		ЗаявкаРаботы КАК ЗаявкаРаботы
	ГДЕ
		НЕ ЗаявкаРаботы.Оборудование3 = ЗНАЧЕНИЕ(Справочник.Оборудование.ПустаяСсылка)) КАК КабинетыОднаКолонка
ГДЕ
	НЕ КабинетыОднаКолонка.Кабинет = ЗНАЧЕНИЕ(Справочник.Оборудование.ПустаяСсылка)

СГРУППИРОВАТЬ ПО
	КабинетыОднаКолонка.Документ,
	КабинетыОднаКолонка.Филиал,
	КабинетыОднаКолонка.Кабинет
;

////////////////////////////////////////////////////////////////////////////////
УНИЧТОЖИТЬ Заявки
;

////////////////////////////////////////////////////////////////////////////////
УНИЧТОЖИТЬ НоменклатураБезОборудования
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВЫРАЗИТЬ(НоменклатураОборудования.Оборудование КАК Справочник.Оборудование) КАК Кабинет,
	НоменклатураОборудования.Ссылка КАК Номенклатура
ПОМЕСТИТЬ НоменклатураОборудования
ИЗ
	Справочник.Номенклатура.Оборудования КАК НоменклатураОборудования
ГДЕ
	НоменклатураОборудования.Оборудование ССЫЛКА Справочник.Оборудование
	И НЕ НоменклатураОборудования.Оборудование = ЗНАЧЕНИЕ(Справочник.Оборудование.ПустаяСсылка)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Факт.Документ КАК Документ,
	Факт.Филиал КАК Филиал,
	СУММА(Факт.ПродолжительностьФакт) КАК ПродолжительностьФакт,
	Факт.Кабинет КАК Кабинет
{ВЫБРАТЬ
	Документ.*,
	Филиал.*,
	ПродолжительностьФакт,
	Кабинет.*}
ИЗ
	(ВЫБРАТЬ
		ЗаявкаРаботы.Документ КАК Документ,
		ЗаявкаРаботы.Филиал КАК Филиал,
		СУММА(ЗаявкаРаботы.ПродолжительностьФакт) КАК ПродолжительностьФакт,
		НоменклатураОборудования.Кабинет КАК Кабинет
	ИЗ
		ЗаявкаРаботы КАК ЗаявкаРаботы
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураОборудования КАК НоменклатураОборудования
			ПО ЗаявкаРаботы.Номенклатура = НоменклатураОборудования.Номенклатура
	
	СГРУППИРОВАТЬ ПО
		ЗаявкаРаботы.Документ,
		ЗаявкаРаботы.Филиал,
		НоменклатураОборудования.Кабинет
	
	ОБЪЕДИНИТЬ
	
	ВЫБРАТЬ
		КабинетыОднаКолонка.Документ,
		КабинетыОднаКолонка.Филиал,
		КабинетыОднаКолонка.ПродолжительностьФакт,
		КабинетыОднаКолонка.Кабинет
	ИЗ
		КабинетыОднаКолонка КАК КабинетыОднаКолонка) КАК Факт
{ГДЕ
	Факт.Кабинет.*,
	Факт.Документ.*,
	Факт.Филиал.*,
	Факт.ПродолжительностьФакт}

СГРУППИРОВАТЬ ПО
	Факт.Документ,
	Факт.Филиал,
	Факт.Кабинет</query>

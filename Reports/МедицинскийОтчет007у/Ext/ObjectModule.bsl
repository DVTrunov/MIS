#Область РазделОписанияПеременных
Перем мВерсияОтчета Экспорт;// Строка, версия отчета
#КонецОбласти

#Область ПрограммныйИнтерфейс

// Таблица форм отчета
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица форм отчета.
//
Функция ТаблицаФормОтчета() Экспорт
	
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0));
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Дата"));
	ОписаниеТиповДата = Новый ОписаниеТипов(МассивТипов, , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	
	ТаблицаФормОтчета = Новый ТаблицаЗначений;
	ТаблицаФормОтчета.Колонки.Добавить("ФормаОтчета",        ОписаниеТиповСтрока);
	ТаблицаФормОтчета.Колонки.Добавить("ОписаниеОтчета",     ОписаниеТиповСтрока, "Утверждена",  20);
	ТаблицаФормОтчета.Колонки.Добавить("ДатаНачалоДействия", ОписаниеТиповДата,   "Действует с", 5);
	ТаблицаФормОтчета.Колонки.Добавить("ДатаКонецДействия",  ОписаниеТиповДата,   "         по", 5);
	ТаблицаФормОтчета.Колонки.Добавить("РедакцияФормы",      ОписаниеТиповСтрока, "Редакция формы", 20);
	
	НоваяФорма = ТаблицаФормОтчета.Добавить();
	НоваяФорма.ФормаОтчета        = "ФормаОтчета";
	НоваяФорма.ОписаниеОтчета     = "";
	НоваяФорма.РедакцияФормы      = "";
	НоваяФорма.ДатаНачалоДействия = '20010101';
	НоваяФорма.ДатаКонецДействия  = МедицинскаяОтчетностьКлиентСервер.ПустоеЗначениеТипа(Тип("Дата"));
			
	Возврат ТаблицаФормОтчета;
	
КонецФункции

// Периодичность отчета.
//
// Параметры:
//  ПараметрыОтчета	 - Неопределено - не используется.
// 
// Возвращаемое значение:
//  Строка - периодичность Год, Полугодие, Квартал, Месяц, День.
//
Функция ПериодичностьОтчета(ПараметрыОтчета = Неопределено) Экспорт
	
	Возврат "День"; // "Год,Полугодие,Квартал,Месяц,День".
	
КонецФункции

// Структура страниц отчета.
//
// Параметры:
//  ВыбраннаяФорма		 - ФормаКлиентскогоПриложения - форма
//  мДеревоСтраницОтчета - ДанныеФормыДерево - дерево страниц отчета
//
Процедура ФормироватьСтруктуруСтраницОтчета(ВыбраннаяФорма, мДеревоСтраницОтчета) Экспорт
	
	мДеревоСтраницОтчета.ПолучитьЭлементы().Очистить();
	
	СтрокаУровня1 = мДеревоСтраницОтчета.ПолучитьЭлементы().Добавить();
	СтрокаУровня1.ИмяСтраницы              = "Титульный";
	СтрокаУровня1.Представление            = "Титульный";
	СтрокаУровня1.ОриентацияСтраницы       = "Ландшафт";
	СтрокаУровня1.ВыводНаПечать            = 1;
	СтрокаУровня1.ПоказатьСтраницу         = 1;
	СтрокаУровня1.ВыгрузитьСтраницу        = 2;
	
	СтрокаУровня1 = мДеревоСтраницОтчета.ПолучитьЭлементы().Добавить();
	СтрокаУровня1.ИмяСтраницы              = "Оборот";
	СтрокаУровня1.Представление            = "Оборот";
	СтрокаУровня1.ОриентацияСтраницы       = "Ландшафт";
	СтрокаУровня1.ВыводНаПечать            = 1;
	СтрокаУровня1.ПоказатьСтраницу         = 1;
	СтрокаУровня1.ВыгрузитьСтраницу        = 2;

	
КонецПроцедуры

// Установить доступность областей.
//
// Параметры:
//  ВыбраннаяФорма		 - ФормаКлиентскогоПриложения - форма
//  Форма				 - ФормаКлиентскогоПриложения - форма 
//  ИмяСтраницыПанели	 - Строка - имя страницы панели.
//
Процедура УстановитьДоступностьОбластей(ВыбраннаяФорма, Форма, ИмяСтраницыПанели = "") Экспорт
	
	ТабДокумент = Форма.ПолеТабличногоДокументаФормаОтчета;
	
	ЗапрещенныеОбласти = Новый Массив;
	ЗапрещенныеОбласти.Добавить("ШапкаОтчета");
	ЗапрещенныеОбласти.Добавить("ШапкаТаблицы");
	ЗапрещенныеОбласти.Добавить("ПромежуточнаяСтрока");
	ЗапрещенныеОбласти.Добавить("СтрокаВсего");
	ЗапрещенныеОбласти.Добавить("ОтчетГод");
	ЗапрещенныеОбласти.Добавить("ДатаЗаголовок");
	ЗапрещенныеОбласти.Добавить("Подпись");
	ЗапрещенныеОбласти.Добавить("Шапка");
	ЗапрещенныеОбласти.Добавить("Дата");
	
	ОбластиРучноеРедактирование = Новый Массив;
	ОбластиРучноеРедактирование.Добавить("ФИОПодпись");
	ОбластиРучноеРедактирование.Добавить("КодОКУД");
	ОбластиРучноеРедактирование.Добавить("Подразделение");
	ОбластиРучноеРедактирование.Добавить("Всего7");
	ОбластиРучноеРедактирование.Добавить("Всего16");
	ОбластиРучноеРедактирование.Добавить("Всего17");
	ОбластиРучноеРедактирование.Добавить("Всего18");
	ОбластиРучноеРедактирование.Добавить("Всего21");
	
	Для Каждого Область Из ТабДокумент.Области Цикл
		Если ЗапрещенныеОбласти.Найти(Область.Имя) = Неопределено И ОбластиРучноеРедактирование.Найти(Область.Имя) = Неопределено Тогда
			МедицинскаяОтчетностьВызовСервера.РазрешитьВводДанныхВОбласть(Форма.мСтруктураЦветовРаскраски["_4"], Область);
		ИначеЕсли ОбластиРучноеРедактирование.Найти(Область.Имя) <>  Неопределено Тогда
			МедицинскаяОтчетностьВызовСервера.РазрешитьВводДанныхВОбласть(Форма.мСтруктураЦветовРаскраски["_0"], Область);	
		КонецЕсли; 		
	КонецЦикла;
		
	мНомераКолонокСтрокой = Новый Массив;
	мНомераКолонокСтрокой.Добавить("001");
	
	ЗапретРедактированияДляКолонокДинамическойТаблицы(Форма, "Титульный", ИмяСтраницыПанели, "СтрокаТаблицы", мНомераКолонокСтрокой);
	
	мНомераКолонокСтрокой = Новый Массив;
	мНомераКолонокСтрокой.Добавить("007");
	мНомераКолонокСтрокой.Добавить("016");
	мНомераКолонокСтрокой.Добавить("017");
	мНомераКолонокСтрокой.Добавить("018");
	мНомераКолонокСтрокой.Добавить("021");
	
	РучноеРедактированиеДляКолонокДинамическойТаблицы(Форма, "Титульный", ИмяСтраницыПанели, "СтрокаТаблицы", мНомераКолонокСтрокой);
	
	мНомераКолонокСтрокой = Новый Массив;
	мНомераКолонокСтрокой.Добавить("006");
	
	РучноеРедактированиеДляКолонокДинамическойТаблицы(Форма, "Оборот", ИмяСтраницыПанели, "Строка", мНомераКолонокСтрокой);
	
КонецПроцедуры

Процедура ЗапретРедактированияДляКолонокДинамическойТаблицы(Форма, ИмяСтраницы, ИмяСтраницыПанели, ИмяОбластиСтроки, мНомераКолонокСтрокой = Неопределено)
	
	ТабДокумент = Форма.ПолеТабличногоДокументаФормаОтчета;
	Если ИмяСтраницыПанели = ИмяСтраницы Тогда
		Для Каждого Область Из ТабДокумент.Области Цикл	
			Если СтрНайти(Область.Имя, ИмяОбластиСтроки) <> 0 Тогда
				Если мНомераКолонокСтрокой <> Неопределено
					И СтрНайти(Область.Имя, "Шапка") = 0 
				Тогда
					ПозицияРазделителяДинамТаблицы = СтрНайти(Область.Имя, "__");
					НомерКолонки = Лев(Прав(Область.Имя, СтрДлина(Область.Имя) - ПозицияРазделителяДинамТаблицы - 1), 3);
					Если мНомераКолонокСтрокой.Найти(НомерКолонки) <> Неопределено Тогда
						Область.Защита = Истина;
						Область.ЦветФона = Форма.мСтруктураЦветовРаскраски["_5"];
					Иначе
						Область.Защита = Ложь;
						Область.ЦветФона = Форма.мСтруктураЦветовРаскраски["_4"];		
					КонецЕсли;		
				Иначе
					Область.Защита = Истина;
					Область.ЦветФона = Форма.мСтруктураЦветовРаскраски["_5"];	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура РучноеРедактированиеДляКолонокДинамическойТаблицы(Форма, ИмяСтраницы, ИмяСтраницыПанели, ИмяОбластиСтроки, мНомераКолонокСтрокой = Неопределено)
	
	ТабДокумент = Форма.ПолеТабличногоДокументаФормаОтчета;
	Если ИмяСтраницыПанели = ИмяСтраницы Тогда
		Для Каждого Область Из ТабДокумент.Области Цикл	
			Если СтрНайти(Область.Имя, ИмяОбластиСтроки) <> 0 Тогда
				Если мНомераКолонокСтрокой <> Неопределено
					И СтрНайти(Область.Имя, "Шапка") = 0 
				Тогда
					ПозицияРазделителяДинамТаблицы = СтрНайти(Область.Имя, "__");
					НомерКолонки = Лев(Прав(Область.Имя, СтрДлина(Область.Имя) - ПозицияРазделителяДинамТаблицы - 1), 3);
					Если мНомераКолонокСтрокой.Найти(НомерКолонки) <> Неопределено Тогда
						Область.Защита = Ложь;
						Область.ЦветФона = Форма.мСтруктураЦветовРаскраски["_0"];		
					КонецЕсли;			
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗаголовокФормы() Экспорт
	
	Возврат "Форма 007/у. Лист ежедневного учета движения пациентов и коечного фонда медицинской организации";	
	
КонецФункции

#Область АлгоритмЗаполнения

// Заполнить отчет.
//
// Параметры:
//  ВыбраннаяФорма			 - ФормаКлиентскогоПриложения	 - форма
//  ПараметрыОтчета			 - Структура					 - параметры отчета
//  ЭтаФорма				 - ФормаКлиентскогоПриложения	 - форма
//  СтруктураРеквизитовФормы - Структура					 - структура реквизитов формы.
//
Процедура ЗаполнитьОтчет(ВыбраннаяФорма, ПараметрыОтчета, ЭтаФорма, СтруктураРеквизитовФормы) Экспорт 
	
	Попытка
		Подразделение = ЭтаФорма.ПолеТабличногоДокументаФормаОтчета.Область("Подразделение").Значение;
		Титульный = Истина;
	Исключение
		Титульный = Ложь;
	КонецПопытки;
	
	Контейнер = Новый Структура();
	Контейнер.Вставить("МногострочныеДанные");
	Контейнер.Вставить("Дата", ПараметрыОтчета.мДатаКонцаПериодаОтчета + 1);
	Контейнер.Вставить("ВсегоДанные");
	Контейнер.Вставить("НаименованиеАдресЛПУ");	
	Контейнер.Вставить("МногострочныеДанныеКлиенты");
	
	МВТ = ПолучитьВременныеТаблицыДанных(Подразделение, ПараметрыОтчета.мДатаКонцаПериодаОтчета);
		
	Контейнер.НаименованиеАдресЛПУ = ПараметрыОтчета.Филиал.НазваниеОрганизации + " " + КонтактнаяИнформацияСерверПереопределяемый.НайтиКонтактнуюИнформацию(ПараметрыОтчета.Филиал, Перечисления.ТипыКонтактнойИнформации.Адрес);
	Контейнер.МногострочныеДанныеКлиенты = ПолучитьТаблицуПоКлиентам(МВТ, Контейнер.Дата, Подразделение);
	
	Если Титульный Тогда
		Контейнер.МногострочныеДанные = ПолучитьТаблицуМногострочныеДанные(ПолучитьДанныеТаблицы(МВТ, ПараметрыОтчета.мДатаКонцаПериодаОтчета, Подразделение));
		Контейнер.ВсегоДанные = ПолучитьСуммарныеДанныеПоКолонкам(Контейнер.МногострочныеДанные);
		
		ВнестиСтрокуВТабличныйДокумент(ЭтаФорма, Контейнер.ВсегоДанные[0], "Титульный");
		ВнестиМногоСтрочнуюДинамичнуюТаблицу(ЭтаФорма, "Титульный", Контейнер.МногострочныеДанные, "СтрокаТаблицы",,Титульный);
	КонецЕсли;
	
	ЭтаФорма["СтруктураДанныхСтраниц"]["Титульный"].Вставить("НаименованиеАдресЛПУ",Контейнер.НаименованиеАдресЛПУ);
	ЭтаФорма["СтруктураДанныхСтраниц"]["Титульный"].Вставить("Дата",Контейнер.Дата);
	ВнестиМногоСтрочнуюДинамичнуюТаблицу(ЭтаФорма, "Оборот", Контейнер.МногострочныеДанныеКлиенты, "Строка",Истина,Истина);
	
КонецПроцедуры

Функция ПолучитьТаблицуМногострочныеДанные(ДанныеПоКойкам)
	
	ТаблицаДанных = Новый ТаблицаЗначений();
	
	ТаблицаДанных.Колонки.Добавить("Колонка1");
	Для Счетчик = 2 По 25 Цикл
		ТаблицаДанных.Колонки.Добавить("Колонка" + Строка(Счетчик), Новый ОписаниеТипов("Число"));
	КонецЦикла;
	
	Для Строка = 0 По ДанныеПоКойкам.ДанныеПоКоличествуКоек.Количество() - 1 Цикл
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.Колонка1 = ДанныеПоКойкам.ДанныеПоКоличествуКоек[Строка].Профиль;
		
		КлиентыНаНачалоПериода 				= ДанныеПоКойкам.КлиентыНаНачалоПериода.Найти(НоваяСтрока.Колонка1);
		ОборотКлиентов						= ДанныеПоКойкам.ОборотКлиентов.Найти(НоваяСтрока.Колонка1);
		КлиентыПоступившиеПереведенные 		= ДанныеПоКойкам.КлиентыПоступившиеПереведенные.Найти(НоваяСтрока.Колонка1);
		ВыписанныеКлиенты 					= ДанныеПоКойкам.ВыписанныеКлиенты.Найти(НоваяСтрока.Колонка1);
		КлиентыВыписанныеВДругиеОрганизации = ДанныеПоКойкам.КлиентыВыписанныеВДругиеОрганизации.Найти(НоваяСтрока.Колонка1); 
		КлиентыНаКонецПериода 				= ДанныеПоКойкам.КлиентыНаКонецПериода.Найти(НоваяСтрока.Колонка1);
		СвободныеКойкиМЖ 					= ДанныеПоКойкам.СвободныеКойкиМЖ.Найти(НоваяСтрока.Колонка1);
		
		НоваяСтрока.Колонка2 = ДанныеПоКойкам.ДанныеПоКоличествуКоек[Строка].ЧислоКоек;
		НоваяСтрока.Колонка3 = ДанныеПоКойкам.ДанныеПоКоличествуКоек[Строка].ЧислоНедоступныхКоек;
		Если КлиентыНаНачалоПериода <> Неопределено Тогда 
			НоваяСтрока.Колонка4 = КлиентыНаНачалоПериода.КлиентовНаНачалоПериода;
		КонецЕсли;
		Если ОборотКлиентов <> Неопределено Тогда
			НоваяСтрока.Колонка5 = ОборотКлиентов.Поступило;
			НоваяСтрока.Колонка6 = ОборотКлиентов.ПоступилоИзДневногоСтационара;
			НоваяСтрока.Колонка8 = ОборотКлиентов.ПоступилоНесовершеннолетних;
			НоваяСтрока.Колонка9 = ОборотКлиентов.ПоступилоСтаршеТрудоспособногоВозраста;
		КонецЕсли;
		Если КлиентыПоступившиеПереведенные <> Неопределено Тогда
			НоваяСтрока.Колонка10 = КлиентыПоступившиеПереведенные.ПереведеноИзДругихОтделений;
			НоваяСтрока.Колонка11 = КлиентыПоступившиеПереведенные.ПереведеноВДругиеОтделения;
			
			НоваяСтрока.Колонка24 = КлиентыПоступившиеПереведенные.ПереведеноИзДругихОтделенийСтаршеТрудоспособногоВозраста;
			НоваяСтрока.Колонка25 = КлиентыПоступившиеПереведенные.ПереведеноВДругиеОтделенияСтаршеТрудоспособногоВозраста;
		КонецЕсли;
		Если ВыписанныеКлиенты <> Неопределено Тогда
			НоваяСтрока.Колонка12 = ВыписанныеКлиенты.Выписано;
			НоваяСтрока.Колонка13 = ВыписанныеКлиенты.ВыписаноСтаршеТрудоспособногоВозраста;
		КонецЕсли;
		Если КлиентыВыписанныеВДругиеОрганизации <> Неопределено Тогда
			НоваяСтрока.Колонка14 = КлиентыВыписанныеВДругиеОрганизации.ВыписаноВДневнойСтационар;
			НоваяСтрока.Колонка15 = КлиентыВыписанныеВДругиеОрганизации.ВыписаноВКруглосуточныйСтационар;
		КонецЕсли;
		Если КлиентыНаКонецПериода <> Неопределено Тогда
			НоваяСтрока.Колонка19 = КлиентыНаКонецПериода.КлиентовНаКонецПериода;
			НоваяСтрока.Колонка20 = КлиентыНаКонецПериода.КлиентовНаКонецПериодаСтаршеТрудоспособногоВозраста;
		КонецЕсли;
		Если СвободныеКойкиМЖ <> Неопределено Тогда
			НоваяСтрока.Колонка22 = СвободныеКойкиМЖ.СвободныхМестМужских;
			НоваяСтрока.Колонка23 = СвободныеКойкиМЖ.СвободныхМестЖенских;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьСуммарныеДанныеПоКолонкам(ДанныеПоКойкам)

	ТаблицаДанных = Новый ТаблицаЗначений();
	
	Для Счетчик = 2 По 25 Цикл
		ТаблицаДанных.Колонки.Добавить("Колонка" + Строка(Счетчик));
	КонецЦикла;
	
	СтрокаСуммы = ТаблицаДанных.Добавить();
	
	Для Счетчик = 2 По 25 Цикл
		СтрокаСуммы["Колонка" + Счетчик] = ПолучитьСуммуПоКолонке(ДанныеПоКойкам, "Колонка" + Счетчик);
	КонецЦикла;
	
	Возврат ТаблицаДанных; 
		
КонецФункции

Функция ПолучитьСуммуПоКолонке(ДанныеПоКойкам, Колонка)
	
	Сумма = 0;
	
	Попытка 
		Для Каждого Строка Из ДанныеПоКойкам Цикл
			Сумма = Сумма + Строка[Колонка];
		КонецЦикла;
	Исключение
		Возврат 0;
	КонецПопытки;
	
	Возврат Сумма;
	
КонецФункции

Функция ПолучитьДанныеТаблицы(МВТ, Период, Подразделение) Экспорт
	
	НачалоПериода = Дата(Год(Период), Месяц(Период), День(Период), 9, 0, 0);
	КонецПериода = Дата(Год(Период + 1), Месяц(Период + 1), День(Период + 1), 8, 59, 59);
	
	ТаблицыДанных = Новый Структура;
		
	ТаблицыДанных.Вставить("ДанныеПоКоличествуКоек",ПолучитьДанныеПоКоличествуКоек(МВТ));
	ТаблицыДанных.Вставить("КлиентыНаНачалоПериода",ПолучитьКлиентовНаНачалоПериода(МВТ, НачалоПериода, Подразделение));
	ТаблицыДанных.Вставить("ОборотКлиентов",ПолучитьОборотКлиентов(МВТ, НачалоПериода, Подразделение));
	ТаблицыДанных.Вставить("КлиентыПоступившиеПереведенные",ПолучитьЧислоПоступившихПереведенных(МВТ, НачалоПериода, Подразделение));
	ТаблицыДанных.Вставить("ВыписанныеКлиенты",ПолучитьЧислоВыписанныхКлиентов(МВТ, НачалоПериода, Подразделение));
	ТаблицыДанных.Вставить("КлиентыВыписанныеВДругиеОрганизации",ПолучитьЧислоКлиентовВыписанныхВДругиеОрганизации(МВТ, Подразделение));
	ТаблицыДанных.Вставить("КлиентыНаКонецПериода",ПолучитьКлиентовНаКонецПериода(МВТ, КонецПериода, Подразделение));
	ТаблицыДанных.Вставить("СвободныеКойкиМЖ",ПолучитьСвободныеКойкиМЖ(МВТ, КонецПериода, Подразделение));
		
	Возврат ТаблицыДанных;
	
КонецФункции

Функция ПолучитьТаблицуПоКлиентам(МВТ, Период, Подразделение)
	
	ТаблицаДанных = Новый ТаблицаЗначений();
	
	Для Счетчик = 1 По 6 Цикл
		ТаблицаДанных.Колонки.Добавить("Колонка" + Строка(Счетчик));
	КонецЦикла;
	
	ДанныеПоКлиентам = ПолучитьДанныеПоКлиентам(МВТ, Период, Подразделение);
	
	ПоступившиеКлиенты = ДанныеПоКлиентам.ПоступившиеКлиенты;
	ПоступившиеКлиентыИзвне = ДанныеПоКлиентам.ПоступившиеКлиентыИзвне;
	ВыписанныеКлиенты = ДанныеПоКлиентам.ВыписанныеКлиенты;
	ПереведенныеКлиенты = ДанныеПоКлиентам.ПереведенныеКлиенты;
	КлиентыПереведенныеВДругиеОгранизации = ДанныеПоКлиентам.КлиентыПереведенныеВДругиеОгранизации;
	
	Для Каждого Клиент Из КлиентыПереведенныеВДругиеОгранизации Цикл
		Индекс = ВыписанныеКлиенты.Найти(Клиент);
		Если Индекс <> Неопределено Тогда
			ВыписанныеКлиенты.Удалить(Индекс);	
		КонецЕсли;
	КонецЦикла;
	
	ЧислоСтрок = Макс(ПоступившиеКлиенты.Количество(),ПоступившиеКлиентыИзвне.Количество(),ВыписанныеКлиенты.Количество(),
				КлиентыПереведенныеВДругиеОгранизации.Количество(), ПереведенныеКлиенты.Количество());
	
	Для Счетчик = 0 По ЧислоСтрок - 1 Цикл
		НоваяСтрока = ТаблицаДанных.Добавить();
		Если Счетчик <= ПоступившиеКлиенты.Количество() - 1 Тогда 
			НоваяСтрока.Колонка1 = ПоступившиеКлиенты[Счетчик];
		КонецЕсли;
		Если Счетчик <= ПоступившиеКлиентыИзвне.Количество() - 1 Тогда	
			НоваяСтрока.Колонка2 = ПоступившиеКлиентыИзвне[Счетчик];
		КонецЕсли;
		Если Счетчик <= ВыписанныеКлиенты.Количество() - 1 Тогда
			НоваяСтрока.Колонка3 = ВыписанныеКлиенты[Счетчик];
		КонецЕсли;
		Если Счетчик <= ПереведенныеКлиенты.Количество() - 1 Тогда
			НоваяСтрока.Колонка4 = ПереведенныеКлиенты[Счетчик];
		КонецЕсли;
		Если Счетчик <= КлиентыПереведенныеВДругиеОгранизации.Количество() - 1 Тогда
			НоваяСтрока.Колонка5 = КлиентыПереведенныеВДругиеОгранизации[Счетчик];
		КонецЕсли;
	КонецЦикла;
	
	Для Счетчик = 0 По ЧислоПустыхСтрокДляОборота() - 1 Цикл
		ТаблицаДанных.Добавить();	
	КонецЦикла;
	
	Возврат ТаблицаДанных;	
	
КонецФункции

Процедура ВнестиМногоСтрочнуюДинамичнуюТаблицу(ЭтаФорма, ИмяРаздела, Таблица, ИмяОбластиСтрок, ВыводитьПустыеСтроки = Ложь, ОчищатьТаблицу = Ложь)
	
	СтруктураДанных = ЭтаФорма["СтруктураДанныхСтраниц"][ИмяРаздела];
	МаксКол = Таблица.Колонки.Количество();	
	
	Если ОчищатьТаблицу Тогда
		Для Каждого КлючИЗначение Из СтруктураДанных Цикл
			Если СтрНайти(КлючИЗначение.Ключ, ИмяОбластиСтрок + "__") Тогда
				СтруктураДанных.Удалить(КлючИЗначение.Ключ);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Стр = 1;
	Для каждого СтрокаТаблицы Из Таблица Цикл
		Для Сч = 0 По МаксКол - 1 Цикл
			ИмяЯчейки = ИмяОбластиСтрок + "__" + Формат(Сч + 1, "ЧЦ=3; ЧВН=") + "_" + Строка(Стр);	
			Значение = СтрокаТаблицы[Сч]; 
			Если ЗначениеЗаполнено(Значение) Или ВыводитьПустыеСтроки Тогда
				СтруктураДанных.Вставить(ИмяЯчейки,Значение);
			ИначеЕсли СтруктураДанных.Свойство(ИмяЯчейки) Тогда 
				СтруктураДанных.Удалить(ИмяЯчейки);	
			КонецЕсли;
		КонецЦикла;
		Стр = Стр + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВнестиСтрокуВТабличныйДокумент(ЭтаФорма, ДанныеСтроки, Раздел);
	
	Для Счетчик = 2 По 25 Цикл
		ЭтаФорма["СтруктураДанныхСтраниц"][Раздел].Вставить("Всего" + Счетчик,ДанныеСтроки["Колонка" + Счетчик]);
	КонецЦикла;		
	
КонецПроцедуры
 

Процедура ПоказатьДопКолонки(СтруктураДанных, ИмяОбласти)
	
	Если СтруктураДанных.Свойство("ТабДок") Тогда
		
		ИмяОбластиКолонки = Лев(ИмяОбласти, 19);
		Если ИмяОбластиКолонки = "СтрокаТаблицы__010_" 
			Или ИмяОбласти  = "Всего10" 
		Тогда
			СтруктураДанных.ТабДок.Область("C23").ШиринаКолонки = 11;	
		ИначеЕсли ИмяОбластиКолонки = "СтрокаТаблицы__011_" 
			Или ИмяОбласти  = "Всего11"	
		Тогда
			СтруктураДанных.ТабДок.Область("C25").ШиринаКолонки = 11;	
		КонецЕсли;
		
	КонецЕсли
	

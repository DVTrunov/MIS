	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Данные.Профиль КАК Профиль,
	               |	СУММА(ВЫБОР
	               |			КОГДА Данные.ПалатаГендер <> ЗНАЧЕНИЕ(Перечисление.ПолФизическихЛиц.Женский)

Функция ПолучитьВременныеТаблицыДанных(Подразделение, Период)
	
	НачалоПериода = Дата(Год(Период), Месяц(Период), День(Период), 9, 0, 0);
	КонецПериода = Дата(Год(Период + 1), Месяц(Период + 1), День(Период + 1), 8, 59, 59);
	
	Запрос = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДвижениеКоечногоФондаСрезПоследних.Палата.Профиль КАК Профиль,
	               |	ДвижениеКоечногоФондаСрезПоследних.Койка КАК Койка,
	               |	ДвижениеКоечногоФондаСрезПоследних.Палата КАК Палата,
	               |	ДвижениеКоечногоФондаСрезПоследних.Палата.Гендер КАК ПалатаГендер,
	               |	ДвижениеКоечногоФондаСрезПоследних.Статус КАК Статус,
	               |	&Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ Данные
	               |ИЗ
	               |	РегистрСведений.ДвижениеКоечногоФонда.СрезПоследних(&КонецПериода, Палата.Подразделение = &Подразделение) КАК ДвижениеКоечногоФондаСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КлиентыСтационара.Период КАК Период,
	               |	КлиентыСтационара.Регистратор КАК Регистратор,
	               |	КлиентыСтационара.Клиент КАК Клиент,
	               |	КлиентыСтационара.ДокументПоступления КАК ДокументПоступления,
	               |	КлиентыСтационара.Подразделение КАК Подразделение,
	               |	КлиентыСтационара.КойкоМесто КАК КойкоМесто,
	               |	КлиентыСтационара.ДатаНачала КАК ДатаНачала,
	               |	КлиентыСтационара.ДатаОкончания КАК ДатаОкончания,
	               |	КлиентыСтационара.Выписан КАК Выписан
	               |ПОМЕСТИТЬ КлиентыЗаПериод
	               |ИЗ
	               |	РегистрСведений.КлиентыСтационара КАК КлиентыСтационара
	               |ГДЕ
	               |	КлиентыСтационара.ДатаНачала МЕЖДУ &НачалоПериода И &КонецПериода
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КлиентыЗаПериод.Регистратор КАК Регистратор,
	               |	КлиентыЗаПериод.Клиент КАК Клиент,
	               |	КлиентыЗаПериод.ДокументПоступления КАК ДокументПоступления,
	               |	МАКСИМУМ(КлиентыСтационара.ДатаНачала) КАК ДатаНачала
	               |ПОМЕСТИТЬ ДатыПредыдущихУстановокУсловий
	               |ИЗ
	               |	КлиентыЗаПериод КАК КлиентыЗаПериод
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыСтационара КАК КлиентыСтационара
	               |		ПО КлиентыЗаПериод.Клиент = КлиентыСтационара.Клиент
	               |			И КлиентыЗаПериод.ДокументПоступления = КлиентыСтационара.ДокументПоступления
	               |			И КлиентыЗаПериод.ДатаНачала > КлиентыСтационара.ДатаНачала
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КлиентыЗаПериод.Регистратор,
	               |	КлиентыЗаПериод.Клиент,
	               |	КлиентыЗаПериод.ДокументПоступления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДатыПредыдущихУстановокУсловий.Регистратор КАК Регистратор,
	               |	КлиентыСтационара.Клиент КАК Клиент,
	               |	КлиентыСтационара.ДокументПоступления КАК ДокументПоступления,
	               |	КлиентыСтационара.КойкоМесто КАК КойкоМесто,
	               |	КлиентыСтационара.Подразделение КАК Подразделение,
	               |	Данные.Профиль КАК Профиль
	               |ПОМЕСТИТЬ ПредыдущиеУУ
	               |ИЗ
	               |	РегистрСведений.КлиентыСтационара КАК КлиентыСтационара
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыПредыдущихУстановокУсловий КАК ДатыПредыдущихУстановокУсловий
	               |		ПО КлиентыСтационара.Клиент = ДатыПредыдущихУстановокУсловий.Клиент
	               |			И КлиентыСтационара.ДокументПоступления = ДатыПредыдущихУстановокУсловий.ДокументПоступления
	               |			И КлиентыСтационара.ДатаНачала = ДатыПредыдущихУстановокУсловий.ДатаНачала
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Данные КАК Данные
	               |		ПО КлиентыСтационара.КойкоМесто = Данные.Койка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КлиентыЗаПериод.Период КАК Период,
	               |	КлиентыЗаПериод.Регистратор КАК Регистратор,
	               |	КлиентыЗаПериод.Регистратор.ДокументОбращения.ВидСтационараНаправления КАК РегистраторДокументОбращенияВидСтационараНаправления,
	               |	КлиентыЗаПериод.Регистратор.ВидОперации КАК РегистраторВидОперации,
	               |	КлиентыЗаПериод.Клиент КАК Клиент,
	               |	КлиентыЗаПериод.Клиент.ДатаРождения КАК КлиентДатаРождения,
	               |	КлиентыЗаПериод.Клиент.Пол КАК КлиентПол,
	               |	КлиентыЗаПериод.ДокументПоступления КАК ДокументПоступления,
	               |	КлиентыЗаПериод.Подразделение КАК Подразделение,
	               |	КлиентыЗаПериод.КойкоМесто КАК КойкоМесто,
	               |	Данные.Профиль КАК КойкоМестоПрофиль,
	               |	КлиентыЗаПериод.ДатаНачала КАК ДатаНачала,
	               |	КлиентыЗаПериод.ДатаОкончания КАК ДатаОкончания,
	               |	КлиентыЗаПериод.Выписан КАК Выписан,
	               |	ПредыдущиеУУ.Профиль КАК КойкоМестоПредыдущееВладелецПрофиль,
	               |	ПредыдущиеУУ.КойкоМесто КАК КойкоМестоПредыдущее,
	               |	ПредыдущиеУУ.Подразделение КАК ПодразделениеПредыдущее,
	               |	КлиентыЗаПериод.Регистратор.ДокументОбращения.МедицинскаяКарта КАК МедицинскаяКарта
	               |ПОМЕСТИТЬ КлиентыСтационара
	               |ИЗ
	               |	КлиентыЗаПериод КАК КлиентыЗаПериод
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПредыдущиеУУ КАК ПредыдущиеУУ
	               |		ПО КлиентыЗаПериод.Регистратор = ПредыдущиеУУ.Регистратор
	               |			И КлиентыЗаПериод.Клиент = ПредыдущиеУУ.Клиент

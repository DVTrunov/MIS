	               |							И СостояниеКойкоМестаСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Справочник.ВидыСостоянийКойкоМест.Недоступно)
	               |						ИЛИ СостояниеКойкоМестаСрезПоследних.Состояние ЕСТЬ NULL
	               |						ИЛИ СостояниеКойкоМестаСрезПоследних.ДатаОкончания < &Период)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СвободныхМестМужских,
	               |	СУММА(ВЫБОР
	               |			КОГДА Данные.ПалатаГендер <> ЗНАЧЕНИЕ(Перечисление.ПолФизическихЛиц.Мужской)
	               |					И Данные.Статус = ЗНАЧЕНИЕ(Перечисление.СостоянияКоек.ПустаяСсылка)
	               |					И (СостояниеКойкоМестаСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Справочник.ВидыСостоянийКойкоМест.ЗанятоПациентом)
	               |							И СостояниеКойкоМестаСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Справочник.ВидыСостоянийКойкоМест.Недоступно)
	               |						ИЛИ СостояниеКойкоМестаСрезПоследних.Состояние ЕСТЬ NULL
	               |						ИЛИ СостояниеКойкоМестаСрезПоследних.ДатаОкончания < &Период)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СвободныхМестЖенских
	               |ИЗ
	               |	Данные КАК Данные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеКойкоМеста.СрезПоследних(&Период, ) КАК СостояниеКойкоМестаСрезПоследних
	               |		ПО Данные.Койка = СостояниеКойкоМестаСрезПоследних.КойкоМесто
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Данные.Профиль";
	
	Запрос.УстановитьПараметр("Период", Период);
	
	Возврат Запрос.Выполнить().Выгрузить();
	

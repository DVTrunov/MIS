Процедура ПриЗаписи(Объект, СтруктураДанных, Отказ, ОписаниеОшибки) Экспорт
		
	Если СтруктураДанных.Свойство("СтруктураДанныхСтраниц") Тогда
		Движения = Объект.Движения.ДанныеМедицинскихОтчетов007у;
		Данные = СтруктураДанных.СтруктураДанныхСтраниц.Титульный;
		
		Если СуществуетДругой007(Объект.Ссылка, Данные.Подразделение, Данные.Дата) Тогда
			ОписаниеОшибки = "Отчет по этому подразделению на эту дату уже существует!";
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если СтрНайти(Объект.Комментарий, Строка(Данные.Подразделение)) = 0 Тогда
			Объект.Комментарий = ?(Данные.Подразделение = "", Строка(Данные.Подразделение), Строка(Данные.Подразделение) + ". " + Объект.Комментарий);
		КонецЕсли;                                                                    
		
		Строка = 1;
		ИмяСтроки = "СтрокаТаблицы__001_1";
		Пока Данные.Свойство(ИмяСтроки) Цикл
			
		    Запись = Движения.Добавить();
			
			Запись.Период 							= Данные.Дата;
			Запись.Подразделение 					= Данные.Подразделение;
			Запись.Профиль 							= Данные[ИмяСтроки];
			Запись.ЧислоКоек 						= ?(Данные.Свойство("СтрокаТаблицы__002_" + Строка), Данные["СтрокаТаблицы__002_" + Строка], 0);
			Запись.ЧислоНедоступныхКоек 			= ?(Данные.Свойство("СтрокаТаблицы__003_" + Строка), Данные["СтрокаТаблицы__003_" + Строка], 0);
			Запись.КлиентовНаНачалоПериода 			= ?(Данные.Свойство("СтрокаТаблицы__004_" + Строка), Данные["СтрокаТаблицы__004_" + Строка], 0);
			Запись.Поступило 						= ?(Данные.Свойство("СтрокаТаблицы__005_" + Строка), Данные["СтрокаТаблицы__005_" + Строка], 0);
			Запись.ПоступилоИзДневногоСтационара 	= ?(Данные.Свойство("СтрокаТаблицы__006_" + Строка), Данные["СтрокаТаблицы__006_" + Строка], 0);
			Запись.ПоступилоСельскихЖителей 		= ?(Данные.Свойство("СтрокаТаблицы__007_" + Строка), Данные["СтрокаТаблицы__007_" + Строка], 0);
			Запись.ПоступилоНесовершеннолетних 		= ?(Данные.Свойство("СтрокаТаблицы__008_" + Строка), Данные["СтрокаТаблицы__008_" + Строка], 0);
			Запись.ПоступилоСтаршеТрудоспособногоВозраста = ?(Данные.Свойство("СтрокаТаблицы__009_" + Строка), Данные["СтрокаТаблицы__009_" + Строка], 0);
			Запись.ПереведеноИзДругихОтделений 		= ?(Данные.Свойство("СтрокаТаблицы__010_" + Строка), Данные["СтрокаТаблицы__010_" + Строка], 0);
			Запись.ПереведеноВДругиеОтделения 		= ?(Данные.Свойство("СтрокаТаблицы__011_" + Строка), Данные["СтрокаТаблицы__011_" + Строка], 0);
			Запись.Выписано 						= ?(Данные.Свойство("СтрокаТаблицы__012_" + Строка), Данные["СтрокаТаблицы__012_" + Строка], 0);
			Запись.ВыписаноСтаршеТрудоспособногоВозраста = ?(Данные.Свойство("СтрокаТаблицы__013_" + Строка), Данные["СтрокаТаблицы__013_" + Строка], 0);
			Запись.ВыписаноВДневнойСтационар 		= ?(Данные.Свойство("СтрокаТаблицы__014_" + Строка), Данные["СтрокаТаблицы__014_" + Строка], 0);
			Запись.ВыписаноВКруглосуточныйСтационар = ?(Данные.Свойство("СтрокаТаблицы__015_" + Строка), Данные["СтрокаТаблицы__015_" + Строка], 0);
			Запись.Умерло 							= ?(Данные.Свойство("СтрокаТаблицы__016_" + Строка), Данные["СтрокаТаблицы__016_" + Строка], 0);
			Запись.УмерлоНесовершеннолетних 		= ?(Данные.Свойство("СтрокаТаблицы__017_" + Строка), Данные["СтрокаТаблицы__017_" + Строка], 0);
			Запись.УмерлоСтаршеТрудоспособногоВозраста = ?(Данные.Свойство("СтрокаТаблицы__018_" + Строка), Данные["СтрокаТаблицы__018_" + Строка], 0);
			Запись.КлиентовНаКонецПериода 			= ?(Данные.Свойство("СтрокаТаблицы__019_" + Строка), Данные["СтрокаТаблицы__019_" + Строка], 0);
			Запись.КлиентовНаКонецПериодаСтаршеТрудоспособногоВозраста = ?(Данные.Свойство("СтрокаТаблицы__020_" + Строка), Данные["СтрокаТаблицы__020_" + Строка], 0);
			Запись.ЗаконныхПредставителейНаКонецПериода = ?(Данные.Свойство("СтрокаТаблицы__021_" + Строка), Данные["СтрокаТаблицы__021_" + Строка], 0);
			Запись.СвободныхМестМужских				= ?(Данные.Свойство("СтрокаТаблицы__022_" + Строка), Данные["СтрокаТаблицы__022_" + Строка], 0);
			Запись.СвободныхМестЖенских 			= ?(Данные.Свойство("СтрокаТаблицы__023_" + Строка), Данные["СтрокаТаблицы__023_" + Строка], 0);
			Запись.ПереведеноИзДругихОтделенийСтаршеТрудоспособногоВозраста = ?(Данные.Свойство("СтрокаТаблицы__024_" + Строка), Данные["СтрокаТаблицы__024_" + Строка], 0);
			Запись.ПереведеноВДругиеОтделенияСтаршеТрудоспособногоВозраста = ?(Данные.Свойство("СтрокаТаблицы__025_" + Строка), Данные["СтрокаТаблицы__025_" + Строка], 0);
			
			Строка = Строка + 1;
			ИмяСтроки = "СтрокаТаблицы__001_" + Строка;
			
		КонецЦикла;
		
		Если Движения.Количество() = 0 Тогда
			Запись = Движения.Добавить();
			Запись.Период 			= Данные.Дата;
			Запись.Подразделение	= Данные.Подразделение;
		КонецЕсли;
		
	КонецЕсли;	
		
КонецПроцедуры

Функция СуществуетДругой007(Объект, Подразделение, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеМедицинскихОтчетов007у.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ДанныеМедицинскихОтчетов007у КАК ДанныеМедицинскихОтчетов007у
	               |ГДЕ
	               |	ДанныеМедицинскихОтчетов007у.Регистратор <> &Регистратор
	               |	И ДанныеМедицинскихОтчетов007у.Подразделение = &Подразделение
	               |	И ДанныеМедицинскихОтчетов007у.Период = &Период"; 
	
	Запрос.УстановитьПараметр("Регистратор",Объект);
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Запрос.УстановитьПараметр("Период",Дата);
	
	Возврат Запрос.Выполнить().Выбрать().Следующий();
	

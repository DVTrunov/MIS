		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	омг_КоличествоПроданныхНаборов.Набор КАК омг_Набор,
	СУММА(омг_КоличествоПроданныхНаборов.Количество) КАК КоличествоНаборов,
	омг_КоличествоПроданныхНаборов.Регистратор КАК Регистратор,
	СУММА(омг_КоличествоПроданныхНаборов.Сумма) КАК Сумма
ИЗ
	РегистрСведений.омг_КоличествоПроданныхНаборов КАК омг_КоличествоПроданныхНаборов
ГДЕ
	омг_КоличествоПроданныхНаборов.Регистратор.Дата &gt;= &amp;ДатаНачала
	И омг_КоличествоПроданныхНаборов.Регистратор.Дата &lt;= &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	омг_КоличествоПроданныхНаборов.Набор,
	омг_КоличествоПроданныхНаборов.Регистратор</query>
	</dataSet>

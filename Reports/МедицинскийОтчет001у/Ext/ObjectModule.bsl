#Область РазделОписанияПеременных
Перем мВерсияОтчета Экспорт;// Строка, версия отчета
#КонецОбласти

#Область ПрограммныйИнтерфейс

// Таблица форм отчета
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица форм отчета.
//
Функция ТаблицаФормОтчета() Экспорт
	
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0));
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Дата"));
	ОписаниеТиповДата = Новый ОписаниеТипов(МассивТипов, , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	
	ТаблицаФормОтчета = Новый ТаблицаЗначений;
	ТаблицаФормОтчета.Колонки.Добавить("ФормаОтчета",        ОписаниеТиповСтрока);
	ТаблицаФормОтчета.Колонки.Добавить("ОписаниеОтчета",     ОписаниеТиповСтрока, "Утверждена",  20);
	ТаблицаФормОтчета.Колонки.Добавить("ДатаНачалоДействия", ОписаниеТиповДата,   "Действует с", 5);
	ТаблицаФормОтчета.Колонки.Добавить("ДатаКонецДействия",  ОписаниеТиповДата,   "         по", 5);
	ТаблицаФормОтчета.Колонки.Добавить("РедакцияФормы",      ОписаниеТиповСтрока, "Редакция формы", 20);
	
	НоваяФорма = ТаблицаФормОтчета.Добавить();
	НоваяФорма.ФормаОтчета        = "ФормаОтчета";
	НоваяФорма.ОписаниеОтчета     = "Журнал учета приема пациентов и отказов в оказании медицинской помощи в стационарных условиях, в условиях дневного стационара";
	НоваяФорма.РедакцияФормы      = "от 05.08.2022 № 1";
	НоваяФорма.ДатаНачалоДействия = '20230301';
	НоваяФорма.ДатаКонецДействия  = МедицинскаяОтчетностьКлиентСервер.ПустоеЗначениеТипа(Тип("Дата"));
			
	Возврат ТаблицаФормОтчета;
	
КонецФункции

// Периодичность отчета.
//
// Параметры:
//  ПараметрыОтчета	 - Неопределено - не используется.
// 
// Возвращаемое значение:
//  Строка - периодичность Год, Полугодие, Квартал, Месяц, День.
//
Функция ПериодичностьОтчета(ПараметрыОтчета = Неопределено) Экспорт
	
	Возврат "День"; // "Год,Полугодие,Квартал,Месяц,День".
	
КонецФункции

// Структура страниц отчета.
//
// Параметры:
//  ВыбраннаяФорма		 - ФормаКлиентскогоПриложения - форма
//  мДеревоСтраницОтчета - ДанныеФормыДерево - дерево страниц отчета
//
Процедура ФормироватьСтруктуруСтраницОтчета(ВыбраннаяФорма, мДеревоСтраницОтчета) Экспорт
	
	мДеревоСтраницОтчета.ПолучитьЭлементы().Очистить();
	
	СтрокаУровня1 = мДеревоСтраницОтчета.ПолучитьЭлементы().Добавить();
	СтрокаУровня1.ИмяСтраницы              = "Титульный";
	СтрокаУровня1.Представление            = "Титульный";
	СтрокаУровня1.ОриентацияСтраницы       = "Ландшафт";
	СтрокаУровня1.ВыводНаПечать            = 1;
	СтрокаУровня1.ПоказатьСтраницу         = 1;
	СтрокаУровня1.ВыгрузитьСтраницу        = 2;
	
КонецПроцедуры

// Установить доступность областей.
//
// Параметры:
//  ВыбраннаяФорма		 - ФормаКлиентскогоПриложения - форма
//  Форма				 - ФормаКлиентскогоПриложения - форма 
//  ИмяСтраницыПанели	 - Строка - имя страницы панели.
//
Процедура УстановитьДоступностьОбластей(ВыбраннаяФорма, Форма, ИмяСтраницыПанели = "") Экспорт
	
	ТабДокумент = Форма.ПолеТабличногоДокументаФормаОтчета;
	
	ЗапрещенныеОбласти = Новый Массив;
	ЗапрещенныеОбласти.Добавить("Область1");
	ЗапрещенныеОбласти.Добавить("Подпись");
	ЗапрещенныеОбласти.Добавить("ОтчетГод");
	ЗапрещенныеОбласти.Добавить("Область2");
	
	ОбластиРучноеРедактирование = Новый Массив;
	ОбластиРучноеРедактирование.Добавить("ФИОПодпись");
	ОбластиРучноеРедактирование.Добавить("ДатаНачала");
	ОбластиРучноеРедактирование.Добавить("ДатаОкончания");
	ОбластиРучноеРедактирование.Добавить("КодОКУД");
	
	Для Каждого Область Из ТабДокумент.Области Цикл
		Если ЗапрещенныеОбласти.Найти(Область.Имя) = Неопределено И ОбластиРучноеРедактирование.Найти(Область.Имя) = Неопределено Тогда
			МедицинскаяОтчетностьВызовСервера.РазрешитьВводДанныхВОбласть(Форма.мСтруктураЦветовРаскраски["_4"], Область);
		ИначеЕсли ОбластиРучноеРедактирование.Найти(Область.Имя) <>  Неопределено Тогда
			МедицинскаяОтчетностьВызовСервера.РазрешитьВводДанныхВОбласть(Форма.мСтруктураЦветовРаскраски["_0"], Область);	
		КонецЕсли; 		
	КонецЦикла;
			
КонецПроцедуры
 
// Возвращает заголовок формы создания сед. отчетности
// 
// Возвращаемое значение:
// Строка  - Заголовок формы
//
Функция ПолучитьЗаголовокФормы() Экспорт
	
	Возврат "Журнал учета приема пациентов и отказов в оказании медицинской помощи в стационарных условиях, в условиях дневного стационара";
	
КонецФункции

#Область АлгоритмЗаполнения

// Заполнить отчет.
//
// Параметры:
//  ВыбраннаяФорма			 - ФормаКлиентскогоПриложения	 - форма
//  ПараметрыОтчета			 - Структура					 - параметры отчета
//  ЭтаФорма				 - ФормаКлиентскогоПриложения	 - форма
//  СтруктураРеквизитовФормы - Структура					 - структура реквизитов формы.
//
Процедура ЗаполнитьОтчет(ВыбраннаяФорма, ПараметрыОтчета, ЭтаФорма, СтруктураРеквизитовФормы) Экспорт 
	
	ДатаНачала = ?(ЗначениеЗаполнено(ЭтаФорма.ПолеТабличногоДокументаФормаОтчета.Область("ДатаНачала").Значение),ЭтаФорма.ПолеТабличногоДокументаФормаОтчета.Область("ДатаНачала").Значение, Неопределено);
	ДатаОкончания = ?(ЗначениеЗаполнено(ЭтаФорма.ПолеТабличногоДокументаФормаОтчета.Область("ДатаОкончания").Значение),КонецДня(ЭтаФорма.ПолеТабличногоДокументаФормаОтчета.Область("ДатаОкончания").Значение), Неопределено);
	
	Контейнер = Новый Структура();
	 
	Контейнер.Вставить("МногострочныеДанные");
	Контейнер.Вставить("НаименованиеАдресЛПУ");
	
	Контейнер.МногострочныеДанные = ПолучитьТаблицуМногострочныеДанные(ДатаНачала, ДатаОкончания, ПараметрыОтчета.Филиал);;
	Контейнер.НаименованиеАдресЛПУ = ПараметрыОтчета.Филиал.НазваниеОрганизации + " " + КонтактнаяИнформацияСерверПереопределяемый.НайтиКонтактнуюИнформацию(ПараметрыОтчета.Филиал, Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	ВнестиМногоСтрочнуюДинамичнуюТаблицу(ЭтаФорма, "Титульный", Контейнер.МногострочныеДанные, "ОбластьСтрока");
	ЭтаФорма["СтруктураДанныхСтраниц"]["Титульный"].Вставить("НаименованиеАдресЛПУ",Контейнер.НаименованиеАдресЛПУ);
	
КонецПроцедуры

Функция ПолучитьТаблицуМногострочныеДанные(НачалоПериода, КонецПериода, Филиал)
		
	ТаблицаДанных = Новый ТаблицаЗначений();
	
	Для Счетчик = 1 По 23 Цикл
		ТаблицаДанных.Колонки.Добавить("Колонка" + Строка(Счетчик));
	КонецЦикла;
	
	ПоступившиеЗаПериод = ПолучитьПоступившихЗаПериод(НачалоПериода, КонецПериода, Филиал);
	
	Счетчик = 1;
	Для Каждого Обращение Из ПоступившиеЗаПериод Цикл
		
		Клиент = Обращение.Клиент;
		ПаспортныеДанные = ПолучитьПаспортныеДанныеКлиента(Клиент, КонецПериода); 
				
		СтрокаДанных = ТаблицаДанных.Добавить();
		СтрокаДанных.Колонка1 = Счетчик;
		СтрокаДанных.Колонка2 = Обращение.ДатаВремяПоступления;
		СтрокаДанных.Колонка3 = Обращение.ДатаВремяПоступления;
		СтрокаДанных.Колонка4 = Клиент;
		СтрокаДанных.Колонка5 = Клиент.ДатаРождения;
		СтрокаДанных.Колонка6 = Клиент.Пол;
		Если ПаспортныеДанные <> Неопределено Тогда
			СтрокаДанных.Колонка7 = ПаспортныеДанные.ДокументСерия + " " + ПаспортныеДанные.ДокументНомер;
		КонецЕсли;
		// Гражданство
		Гражданство = Клиент.Гражданство;
		Если Не ЗначениеЗаполнено(Гражданство) Тогда
			Гражданство = Справочники.СтраныМира.Россия;
		КонецЕсли;
		НаименованиеСтраны = ?(ЗначениеЗаполнено(Гражданство.НаименованиеПолное), Гражданство.НаименованиеПолное, Гражданство.Наименование);
		СтрокаДанных.Колонка8 = НаименованиеСтраны;
		
		СтрокаДанных.Колонка9 = КонтактнаяИнформацияСерверПереопределяемый.НайтиКонтактнуюИнформацию(Клиент, Перечисления.ТипыКонтактнойИнформации.Адрес, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
		СтрокаДанных.Колонка10 = КонтактнаяИнформацияСерверПереопределяемый.НайтиКонтактнуюИнформацию(Клиент, Перечисления.ТипыКонтактнойИнформации.Адрес, Справочники.ВидыКонтактнойИнформации.АдресФактический);
		СтрокаДанных.Колонка10 = СокрЛП(Строка(СтрокаДанных.Колонка10) + " " + Клиент.ЗаконныйПредставительТелефон);
		СтрокаДанных.Колонка11 = Клиент.СНИЛС;
		
		ПолисОМС = МедицинскоеСтрахование.ПолисОМСКлиента(Клиент, КонецПериода);
		Если ЗначениеЗаполнено(ПолисОМС.Полис) Тогда
			СтрокаДанных.Колонка12 = СокрЛП(ПолисОМС.НомерПолиса + " " + ПолисОМС.СерияПолиса);
		КонецЕсли;
		
		СтрокаДанных.Колонка13 = Обращение.КаналГоспитализации;
		СтрокаДанных.Колонка14 = Обращение.МедицинскаяКарта.НомерКарты;
		СтрокаДанных.Колонка15 = ?(ТипЗнч(Обращение.ДиагнозНаправления) = Тип("Строка"),Обращение.ДиагнозНаправления, Обращение.ДиагнозНаправления.КодДиагноза);
		СтрокаДанных.Колонка16 = ?(ТипЗнч(Обращение.ДиагнозПоступления) = Тип("Строка"),Обращение.ДиагнозПоступления, Обращение.ДиагнозПоступления.КодДиагноза);
		
		// Колонка 17 (алкоголь, нарктики).
		Если Обращение.АлкогольноеОпьянение И Обращение.НаркотическоеОпьянение Тогда
			СтрокаДанных.Колонка17 = "Употребление алкоголя и иных психоактивных веществ";
		ИначеЕсли Обращение.АлкогольноеОпьянение Тогда
			СтрокаДанных.Колонка17 = "Употребление алкоголя";
		ИначеЕсли Обращение.НаркотическоеОпьянение Тогда
			СтрокаДанных.Колонка17 = "Употребление иных психоактивных веществ";
		Иначе
			СтрокаДанных.Колонка17 = "Нет признаков состояния опьянения";
		КонецЕсли;
		Если ЗначениеЗаполнено(Обращение.ОпьянениеДатаВремяВзятияПробы) Тогда
			СтрокаДанных.Колонка17 = СтрокаДанных.Колонка17 + ". " + "Проба от: " + Формат(Обращение.ОпьянениеДатаВремяВзятияПробы, "ДФ='dd.MM.yyyy HH:mm'");
		КонецЕсли;
		Если ЗначениеЗаполнено(Обращение.ОпьянениеРезультатВзятияПробы) Тогда
			СтрокаДанных.Колонка17 = СтрокаДанных.Колонка17 + ". " + "Результат пробы: " + Обращение.ОпьянениеРезультатВзятияПробы;
		КонецЕсли;
		
		СтрокаДанных.Колонка18 = Обращение.Подразделение;
		
		// Исход госпитализации
		МедКарта = Обращение.МедицинскаяКарта;
		КодCDAПоляИсход = ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(12157, "КлассификаторыМинЗдрава", Перечисления.ВидыКлассификаторовМинЗдрава.КодируемыеПоляCDAДокументов); // Исход.
		КодCDAПоляДатаВыписки = ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(12496, "КлассификаторыМинЗдрава", Перечисления.ВидыКлассификаторовМинЗдрава.КодируемыеПоляCDAДокументов); // Дата выписки
		КодCDAПоляОрганизация = ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(8038, "КлассификаторыМинЗдрава", Перечисления.ВидыКлассификаторовМинЗдрава.КодируемыеПоляCDAДокументов); // Организация, в которую был переведен пациент 
		
		МассивCDA = Новый Массив;
		МассивCDA.Добавить(КодCDAПоляИсход);
		МассивCDA.Добавить(КодCDAПоляДатаВыписки);
		МассивCDA.Добавить(КодCDAПоляОрганизация);
		
		ЗначенияНазначения = МедицинскаяДеятельность.ЗначенияПоНазначениямПолейМедкарты(МедКарта, МассивCDA);
		Если ЗначенияНазначения.Количество() <> 0 Тогда
			// Т.к. значения отсортированы по документу - берем последний документ за тот, который нам нужен
			Документ = ЗначенияНазначения[ЗначенияНазначения.Количество() - 1].Документ;
			ПараметрыДокумента = ЗначенияНазначения.НайтиСтроки(Новый Структура("Документ", Документ));
			
			ИсходГоспитализации = Неопределено;
			ДатаВыписки = Неопределено; 
			Организация = Неопределено;
			// Определяем значения параметров
			Для Каждого СтрокаПараметра Из ПараметрыДокумента Цикл
				Если СтрокаПараметра.Назначение = КодCDAПоляИсход Тогда
					ИсходГоспитализации = СтрокаПараметра.Значение;		
				ИначеЕсли СтрокаПараметра.Назначение = КодCDAПоляДатаВыписки Тогда 
					ДатаВыписки = СтрокаПараметра.Значение;
				ИначеЕсли СтрокаПараметра.Назначение = КодCDAПоляОрганизация Тогда 
					Организация = СтрокаПараметра.Значение;		
				КонецЕсли;
			КонецЦикла;			
			
			Если ИсходГоспитализации <> Неопределено Тогда 
				Если ИсходГоспитализации.УИДЕГИСЗ = 1 		// Выписан
					Или ИсходГоспитализации.УИДЕГИСЗ = 5    // Амбулаторное лечение
				Тогда
					// Выписан
					СтрокаДанных.Колонка19 = ?(ДатаВыписки = Неопределено, "Выписан", "Выписан, " + ДатаВыписки); 
				ИначеЕсли ИсходГоспитализации.УИДЕГИСЗ = 2	// Дневной стационар
					Или ИсходГоспитализации.УИДЕГИСЗ = 3 	// Круглосуточные стационар
					Или ИсходГоспитализации.УИДЕГИСЗ = 4	// Переведен в другую организацию 
				Тогда
					// Переведен в другую организацию 
					СтрокаДанных.Колонка19 = ?(Организация = Неопределено, "Переведен", "Переведен в " + Организация);
					СтрокаДанных.Колонка19 = ?(ДатаВыписки = Неопределено, СтрокаДанных.Колонка19, СтрокаДанных.Колонка19 + ", " + ДатаВыписки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаДанных.Колонка20 = ?(Обращение.СообщитьРодственникам, Обращение.ДатаВремяИнформированияЗП, Неопределено);
		СтрокаДанных.Колонка21 = ?(Обращение.ОтказВГоспитализации, Обращение.ПричинаОтказаВГоспитализации, Неопределено);
		СтрокаДанных.Колонка22 = ?(Обращение.ОтказВГоспитализации, Обращение.СотрудникЗафиксировавшийОтказ, Неопределено);
		СтрокаДанных.Колонка23 = Обращение.ПричинаГоспитализации;
		
		КолонкиНеИзвестно = Новый Массив;
		КолонкиНеИзвестно.Добавить(5);
		КолонкиНеИзвестно.Добавить(6);
		КолонкиНеИзвестно.Добавить(7);
		КолонкиНеИзвестно.Добавить(9);
		КолонкиНеИзвестно.Добавить(11);
		КолонкиНеИзвестно.Добавить(12);
		Для Каждого КолонкаНеИзвестно Из КолонкиНеИзвестно Цикл
			Если Не ЗначениеЗаполнено(СтрокаДанных["Колонка"+КолонкаНеИзвестно]) Тогда
				СтрокаДанных["Колонка"+КолонкаНеИзвестно] = "неизвестно";
			КонецЕсли;
		КонецЦикла;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции


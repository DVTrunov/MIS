Функция ПолучитьДанныеНазначений()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПланыЛечения.ИдентификаторЭлемента КАК ИдентификаторЭлемента,
		|	ПланыЛечения.ВидЭлемента КАК ВидЭлемента,
		|	ПланыЛечения.Номенклатура КАК Назначение,
		|	ПланыЛечения.ДокументРегистратор КАК ДокументРегистратор,
		|	ВЫБОР
		|		КОГДА ПланыЛечения.Дата = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ПланыЛечения.ДокументРегистратор.Дата
		|		ИНАЧЕ ПланыЛечения.Дата
		|	КОНЕЦ КАК ДатаНазначения,
		|	ВЫБОР
		|		КОГДА ПланыЛечения.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				И ПланыЛечения.Дата <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ПланыЛечения.Дата
		|		ИНАЧЕ ПланыЛечения.ДатаОкончания
		|	КОНЕЦ КАК ДатаОтмены,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ПланыЛечения.ПриемовВДень, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ПланыЛечения.ПриемовВДень
		|	КОНЕЦ КАК РазВДень
		|ИЗ
		|	РегистрСведений.ПланыЛечения КАК ПланыЛечения
		|ГДЕ
		|	ПланыЛечения.ПервичныйПрием.МедицинскаяКарта = &МедицинскаяКарта
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаНазначения,
		|	ВидЭлемента,
		|	ПланыЛечения.Номенклатура
		|ИТОГИ ПО
		|	ВидЭлемента";
	
	Запрос.УстановитьПараметр("МедицинскаяКарта", МедицинскаяКарта);
	
	Возврат Запрос.Выполнить();
	
КонецФункции


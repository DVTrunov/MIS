Функция ПолучитьДиагнозПоМедицинскойКарта(МедицинскаяКарта)
	
	ВручнуюЗаполненныйДиагнозКлинический = Неопределено;
	ДиагнозКлиническийПолныйТекст = Неопределено;
	
	СтрокиВручнуюЗаполненногоДиагнозаКлинического = МедицинскаяКарта.ЗаполняемыеПараметры.НайтиСтроки(Новый Структура("ИмяВручнуюЗаполненногоПараметра", "ДиагнозКлиническийПолныйТекст"));
	Если СтрокиВручнуюЗаполненногоДиагнозаКлинического.Количество() > 0 Тогда
		Возврат СтрокиВручнуюЗаполненногоДиагнозаКлинического[0].Значение;
	КонецЕсли;
	
	ДатаИДокументКлиническогоДиагноза = Стационар.ДанныеДокументаКлиническогоДиагнозаМедкарты(МедицинскаяКарта);
	Если ЗначениеЗаполнено(ДатаИДокументКлиническогоДиагноза.Документ) Тогда
		СтандатноеОписаниеДиагнозов = Стационар.СтандатноеОписаниеДиагнозовМД_003(ДатаИДокументКлиническогоДиагноза.Документ);
		Если ЗначениеЗаполнено(СтандатноеОписаниеДиагнозов.ОписаниеДиагнозов) Тогда
			Возврат СтандатноеОписаниеДиагнозов.ОписаниеДиагнозов;
		КонецЕсли;
	КонецЕсли;
	
	ВручнуюЗаполненныйДиагнозПриПоступлении = Неопределено;
	ДиагнозПриПоступленииПолныйТекст = Неопределено;
	
	СтрокиВручнуюЗаполненногоДиагнозаПриПоступлении = МедицинскаяКарта.ЗаполняемыеПараметры.НайтиСтроки(Новый Структура("ИмяВручнуюЗаполненногоПараметра", "ДиагнозПриПоступленииПолныйТекст"));
	Если СтрокиВручнуюЗаполненногоДиагнозаПриПоступлении.Количество() > 0 Тогда
		Возврат СтрокиВручнуюЗаполненногоДиагнозаПриПоступлении[0].Значение;
	КонецЕсли;
	
	ВидМД = ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(381, "ВидыМедицинскихДокументов"); // Первичный осмотр приемного отделения.
	ДокументыКарты = МедицинскаяДеятельность.ДокументыПоВидуДокументации(МедицинскаяКарта, ВидМД);
	Если ДокументыКарты.Количество() <> 0 Тогда
		СтандатноеОписаниеДиагнозов = Стационар.СтандатноеОписаниеДиагнозовМД_003(ДокументыКарты[ДокументыКарты.Количество() - 1].Документ);
		Возврат СтандатноеОписаниеДиагнозов.ОписаниеДиагнозов;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
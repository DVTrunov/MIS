#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	// Заполнение параметров по реквизитам отчета.
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Клиент", Клиент);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("МедицинскаяКарта", МедицинскаяКарта);
	
	УниверсальныеМеханизмыСервер.ОтчетПриКомпоновкеРезультата(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция СформироватьЛистНазначений() Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("ЛистНазначений");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьВидНазначения = Макет.ПолучитьОбласть("СтрокаВидНазначения");
	ОбластьДанные = Макет.ПолучитьОбласть("СтрокаНазначение");
	
	ОписаниеПребывания = Стационар.ПолучитьОписаниеПребыванияПациентаВСтационареПоМедкарте(МедицинскаяКарта);
	
	ОбластьШапка.Параметры.Пациент			= Клиент;
	ОбластьШапка.Параметры.МедицинскаяКарта	= МедицинскаяКарта;
	ОбластьШапка.Параметры.Палата			= ОписаниеПребывания.ПалатаПоступления;
	ОбластьШапка.Параметры.КойкоМесто		= ОписаниеПребывания.КойкоМестоПоступления;
	
	ТабДок.Вывести(ОбластьШапка);
	
	РезультатЗапроса = ПолучитьДанныеНазначений();
	ВыборкаВидыНазначений = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Сч = 0;
	Пока ВыборкаВидыНазначений.Следующий() Цикл
		Cч = Сч+1;
		
		ВыборкаДанныеНазначений = ВыборкаВидыНазначений.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДанныеНазначений.Следующий() Цикл
			ОбластьДанные.Параметры.Назначение		= ВыборкаДанныеНазначений.Назначение;
			ОбластьДанные.Параметры.ДатаНазначения	= ВыборкаДанныеНазначений.ДатаНазначения;
			ОбластьДанные.Параметры.ДатаОтмены		= ВыборкаДанныеНазначений.ДатаОтмены;
			ОбластьДанные.Параметры.РазВДень		= ВыборкаДанныеНазначений.РазВДень;
			ТабДок.Вывести(ОбластьДанные);
		КонецЦикла;
	КонецЦикла;
	
	ТабДок.КлючПараметровПечати = "ЛистНазначений";
	ТабДок.ОтображатьСетку = Ложь;
	Возврат ТабДок;
	
КонецФункции

Функция СформироватьЛистВыполненияНазначений() Экспорт
	
	// Изменения Макеев 10-12-2025 (
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.КлючПараметровПечати = "ЛистВыполненияНазначений";
	ТабДок.РазмерСтраницы = "A4 Rotated";
	ТабДок.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;
	ТабДок.ОтображатьСетку = Ложь;
	
	Макет = Отчеты.ЛистНазначений.ПолучитьМакет("ЛистВыполненияНазначений");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	ОбластьШапка.Параметры.ФИО = ОбщегоНазначения.ФамилияИнициалыФизЛица(Клиент);
	ОбластьШапка.Параметры.ДатаРождения = Формат(Клиент.ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.НомерМедКарты = МедицинскаяКарта.НомерКарты;
	ОбластьШапка.Параметры.НомерПалаты = Стационар.ПолучитьПалатыКлиентаПоМедкарте(МедицинскаяКарта, Истина);
	ОбластьШапка.Параметры.Диагноз = ПолучитьДиагнозПоМедицинскойКарта(МедицинскаяКарта);
	
	ТабДок.Вывести(ОбластьШапка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПланыЛечения.ИдентификаторЭлемента КАК ИдентификаторЭлемента,
		|	ПланыЛечения.ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.ВидыНазначений.Медикаменты) КАК ДляТаблицыОтметок,
		|	ПланыЛечения.Номенклатура КАК Назначение,
		|	ВЫБОР
		|		КОГДА ПланыЛечения.Дата = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ПланыЛечения.ДокументРегистратор.Дата
		|		ИНАЧЕ ПланыЛечения.Дата
		|	КОНЕЦ КАК ДатаНазначения,
		|	ВЫБОР
		|		КОГДА ПланыЛечения.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				И ПланыЛечения.Дата <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ПланыЛечения.Дата
		|		ИНАЧЕ ПланыЛечения.ДатаОкончания
		|	КОНЕЦ КАК ДатаОтмены
		|ПОМЕСТИТЬ ЭлементыПланаЛечения
		|ИЗ
		|	РегистрСведений.ПланыЛечения КАК ПланыЛечения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Прием КАК ПервичныеПриемы
		|		ПО (ПервичныеПриемы.Ссылка = ПланыЛечения.ПервичныйПрием)
		|			И (ПервичныеПриемы.МедицинскаяКарта = &МедицинскаяКарта)
		|			И (ПланыЛечения.ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.ВидыНазначений.Медикаменты)
		|				ИЛИ ПланыЛечения.ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.ВидыНазначений.Обследование)
		|				ИЛИ ПланыЛечения.ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.ВидыНазначений.Процедура))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИзменениеРежимаДействияСтационара.ИдентификаторДействия,
		|	ИСТИНА,
		|	ИзменениеРежимаДействияСтационара.ДействиеСтационара,
		|	ИзменениеРежимаДействияСтационара.ДатаНачала,
		|	ИзменениеРежимаДействияСтационара.ДатаОкончания
		|ИЗ
		|	Документ.ИзменениеРежима.ДействияСтационара КАК ИзменениеРежимаДействияСтационара
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРежима КАК ИзменениеРежима
		|		ПО (ИзменениеРежима.Ссылка = ИзменениеРежимаДействияСтационара.Ссылка)
		|			И (ИзменениеРежима.МедицинскаяКарта = &МедицинскаяКарта)
		|ГДЕ
		|	НЕ ИзменениеРежимаДействияСтационара.ДействиеСтационара В (&ДействияТемпературногоЛиста)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЭлементыПланаЛечения.ИдентификаторЭлемента КАК ИдентификаторЭлемента,
		|	ЭлементыПланаЛечения.Назначение КАК Назначение,
		|	ЭлементыПланаЛечения.ДатаНазначения КАК ДатаНазначения,
		|	ЭлементыПланаЛечения.ДатаОтмены КАК ДатаОтмены,
		|	НАЧАЛОПЕРИОДА(ВыполнениеДействийСтационара.ДатаВремяВыполнения, ДЕНЬ) КАК ДатаВыполнения,
		|	ВыполнениеДействийСтационара.ДатаВремяВыполнения КАК ДатаВремяВыполнения
		|ИЗ
		|	ЭлементыПланаЛечения КАК ЭлементыПланаЛечения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВыполнениеДействийСтационара КАК ВыполнениеДействийСтационара
		|		ПО (ВыполнениеДействийСтационара.ИдентификаторЭлемента = ЭлементыПланаЛечения.ИдентификаторЭлемента)
		|			И (ВыполнениеДействийСтационара.ДействиеСтационара = ЭлементыПланаЛечения.Назначение)
		|ГДЕ
		|	ЭлементыПланаЛечения.ДляТаблицыОтметок
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЭлементыПланаЛечения.ИдентификаторЭлемента,
		|	ЭлементыПланаЛечения.Назначение,
		|	ЭлементыПланаЛечения.ДатаНазначения,
		|	NULL,
		|	НАЧАЛОПЕРИОДА(ВыполнениеПланаЛечения.Период, ДЕНЬ),
		|	ВыполнениеПланаЛечения.Период
		|ИЗ
		|	ЭлементыПланаЛечения КАК ЭлементыПланаЛечения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВыполнениеПланаЛечения КАК ВыполнениеПланаЛечения
		|		ПО (ВыполнениеПланаЛечения.ИдентификаторЭлемента = ЭлементыПланаЛечения.ИдентификаторЭлемента)
		|ГДЕ
		|	НЕ ЭлементыПланаЛечения.ДляТаблицыОтметок
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаНазначения,
		|	ИдентификаторЭлемента,
		|	ДатаВремяВыполнения";
	
	Запрос.УстановитьПараметр("МедицинскаяКарта", МедицинскаяКарта);
	Запрос.УстановитьПараметр("ДействияТемпературногоЛиста", Справочники.ДействияМедсестрыСтационара.ПоказателиЗдоровья003уССопутствующими());
	
	КоличествоКолонокДат = КоличествоКолонокДат();
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыполненияДляТаблицыОтметок = РезультатыЗапроса[1].Выгрузить();
	//ВыполненияДляТаблицыВмешательств = РезультатыЗапроса[2].Выгрузить();
	
	ВыполненияДляТаблицыОтметок.Колонки.Добавить("ИндексКолонки");
	ВыполненияДляТаблицыОтметок.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ВыполненияДляТаблицыОтметок.ЗаполнитьЗначения(1, "Количество");
	
	// Пустой бланк
	Если ВыполненияДляТаблицыОтметок.Количество() = 0 Тогда
		ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицыОтметок"));
		Для Итератор = 1 По 10 Цикл
			ТабДок.Вывести(Макет.ПолучитьОбласть("СтрокаТаблицыОтметок"));
		КонецЦикла;
		ТабДок.Вывести(Макет.ПолучитьОбласть("ПодвалТаблицыОтметок"));
	КонецЕсли;
	
	мДанныеТаблицОтметок = Новый Массив;
	
	Пока ВыполненияДляТаблицыОтметок.Количество() > 0 Цикл
		ДатыВыполнения = ВыполненияДляТаблицыОтметок.Скопировать();
		ДатыВыполнения.Свернуть("ИдентификаторЭлемента, ДатаВыполнения", "Количество");
		ДатыВыполнения.Сортировать("ДатаВыполнения");
		
		РазличныеДаты = ДатыВыполнения.Скопировать();
		РазличныеДаты.Свернуть("ДатаВыполнения");
		
		ДатыТекущейТаблицы = Новый Массив;
		КоличествоДатВТекущейТаблице = Новый Соответствие;
		
		Для Каждого СтрокаДаты Из РазличныеДаты Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаДаты.ДатаВыполнения) Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоКолонокТекущейДаты = 1;
			КоличествоКолонокТекущейДатыВТекущейТаблице = 0;
			
			СтрокиДаты = ДатыВыполнения.НайтиСтроки(Новый Структура("ДатаВыполнения", СтрокаДаты.ДатаВыполнения));
			Для Каждого СтрокаДаты Из СтрокиДаты Цикл
				КоличествоКолонокТекущейДаты = Макс(КоличествоКолонокТекущейДаты, СтрокаДаты.Количество);
			КонецЦикла;
			
			Для Итератор = 1 По КоличествоКолонокТекущейДаты Цикл
				ДатыТекущейТаблицы.Добавить(СтрокаДаты.ДатаВыполнения);
				КоличествоКолонокТекущейДатыВТекущейТаблице = КоличествоКолонокТекущейДатыВТекущейТаблице + 1;
				Если ДатыТекущейТаблицы.Количество() = КоличествоКолонокДат Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			КоличествоДатВТекущейТаблице.Вставить(СтрокаДаты.ДатаВыполнения, КоличествоКолонокТекущейДатыВТекущейТаблице);
			
			Если ДатыТекущейТаблицы.Количество() = КоличествоКолонокДат Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		мСтрокиТекущейТаблицы = Новый Массив;
		ЭлементыПланаЛеченияТекущейТаблицы = ВыполненияДляТаблицыОтметок.СкопироватьКолонки();
		
		Для Каждого КлючЗначение Из КоличествоДатВТекущейТаблице Цикл
			ТекущаяДатаВыполнения = КлючЗначение.Ключ;
			МаксимальноеКоличествоПоНазначению = КлючЗначение.Значение;
			
			КоличествоСтрокПоЭлементам = Новый Соответствие;
			СтрокиПоТекущейДатеВыполнения = ВыполненияДляТаблицыОтметок.НайтиСтроки(Новый Структура("ДатаВыполнения", ТекущаяДатаВыполнения));
			ОбщегоНазначенияБИТКлиентСервер.ВосстановитьПорядокНайденныхСтрок(СтрокиПоТекущейДатеВыполнения, ВыполненияДляТаблицыОтметок);
			
			Для Каждого СтрокаПоДате Из СтрокиПоТекущейДатеВыполнения Цикл
				
				КоличествоСтрокПоИдентификатору = КоличествоСтрокПоЭлементам.Получить(СтрокаПоДате.ИдентификаторЭлемента);
				Если КоличествоСтрокПоИдентификатору = Неопределено Тогда
					КоличествоСтрокПоИдентификатору = 0;
				ИначеЕсли КоличествоСтрокПоИдентификатору = МаксимальноеКоличествоПоНазначению Тогда
					Продолжить;
				КонецЕсли;
				
				мСтрокиТекущейТаблицы.Добавить(СтрокаПоДате);
				ЗаполнитьЗначенияСвойств(ЭлементыПланаЛеченияТекущейТаблицы.Добавить(), СтрокаПоДате);
				
				КоличествоСтрокПоЭлементам.Вставить(СтрокаПоДате.ИдентификаторЭлемента, КоличествоСтрокПоИдентификатору + 1);
			КонецЦикла;
		КонецЦикла;
		
		Для Каждого СтрокаБезВыполнений Из ВыполненияДляТаблицыОтметок.НайтиСтроки(Новый Структура("ДатаВыполнения", Null)) Цикл
			
			Если ДатыТекущейТаблицы.Количество() = 0
				Или СтрокаБезВыполнений.ДатаНазначения <= ДатыТекущейТаблицы[ДатыТекущейТаблицы.ВГраница()]
				Или СтрокаБезВыполнений.ДатаОтмены >= ДатыТекущейТаблицы[0]
			Тогда
				мСтрокиТекущейТаблицы.Добавить(СтрокаБезВыполнений);
				ЗаполнитьЗначенияСвойств(ЭлементыПланаЛеченияТекущейТаблицы.Добавить(), СтрокаБезВыполнений);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаТекТаблицы Из мСтрокиТекущейТаблицы Цикл
			ВыполненияДляТаблицыОтметок.Удалить(СтрокаТекТаблицы);
		КонецЦикла;
		
		ЭлементыПланаЛеченияТекущейТаблицы.Сортировать("ДатаНазначения, ИдентификаторЭлемента, ДатаВремяВыполнения");
		
		мДанныеТаблицОтметок.Добавить(Новый Структура("Даты, Элементы", ДатыТекущейТаблицы, ЭлементыПланаЛеченияТекущейТаблицы));
	КонецЦикла;
	
	Для Каждого ДанныеТаблицыОтметок Из мДанныеТаблицОтметок Цикл
		
		ОбластьШапкиТаблицыОтметок = Макет.ПолучитьОбласть("ШапкаТаблицыОтметок");
		ИндексДаты = 0;
		Для Каждого ДатаТаблицы Из ДанныеТаблицыОтметок.Даты Цикл
			ОбластьШапкиТаблицыОтметок.Параметры[СтрШаблон("Дата%1", ИндексДаты)] = Формат(ДатаТаблицы, "ДФ=dd.MM.yyyy");
			ИндексДаты = ИндексДаты + 1;
		КонецЦикла;
		ТабДок.Вывести(ОбластьШапкиТаблицыОтметок);
		
		ИдентификаторыЭлементов = ДанныеТаблицыОтметок.Элементы.Скопировать();
		ИдентификаторыЭлементов.Свернуть("ИдентификаторЭлемента, Назначение, ДатаНазначения, ДатаОтмены");
		
		Для Каждого СтрокаНазначения Из ИдентификаторыЭлементов Цикл
			
			ОбластьСтрокиТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицыОтметок");
			ОбластьСтрокиТаблицы.Параметры.ПрепаратРежим	= СтрокаНазначения.Назначение;
			ОбластьСтрокиТаблицы.Параметры.ДатаНазначения	= Формат(СтрокаНазначения.ДатаНазначения, "ДФ=dd.MM.yyyy");
			ОбластьСтрокиТаблицы.Параметры.ДатаОтмены		= Формат(СтрокаНазначения.ДатаОтмены, "ДФ=dd.MM.yyyy");
			
			СтрокиВремениВыполненияНазначений = ДанныеТаблицыОтметок.Элементы.НайтиСтроки(Новый Структура("ИдентификаторЭлемента", СтрокаНазначения.ИдентификаторЭлемента));
			ОбщегоНазначенияБИТКлиентСервер.ВосстановитьПорядокНайденныхСтрок(СтрокиВремениВыполненияНазначений, ДанныеТаблицыОтметок.Элементы);
			
			ИндексДаты = 0;
			Для Каждого Дата Из ДанныеТаблицыОтметок.Даты Цикл
				Для Каждого СтрокаВремениВыполнения Из СтрокиВремениВыполненияНазначений Цикл
					
					Если СтрокаВремениВыполнения.ИндексКолонки = Неопределено
						И СтрокаВремениВыполнения.ДатаВыполнения = Дата
					Тогда
						СтрокаВремениВыполнения.ИндексКолонки = ИндексДаты;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				ИндексДаты = ИндексДаты + 1;
			КонецЦикла;
			
			Для Каждого СтрокаВремениВыполнения Из СтрокиВремениВыполненияНазначений Цикл
				Если СтрокаВремениВыполнения.ИндексКолонки <> Неопределено Тогда
					ОбластьСтрокиТаблицы.Параметры[СтрШаблон("Время%1", СтрокаВремениВыполнения.ИндексКолонки)] = Формат(СтрокаВремениВыполнения.ДатаВремяВыполнения, "ДФ=ЧЧ:мм");
				КонецЕсли;
			КонецЦикла;
			
			ТабДок.Вывести(ОбластьСтрокиТаблицы);
		КонецЦикла;
		
		ТабДок.Вывести(Макет.ПолучитьОбласть("ПодвалТаблицыОтметок"));
	КонецЦикла;
	
	ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
	
	//ОбластьШапкиТаблицыВмешательств = Макет.ПолучитьОбласть("ШапкаТаблицыВмешательств");

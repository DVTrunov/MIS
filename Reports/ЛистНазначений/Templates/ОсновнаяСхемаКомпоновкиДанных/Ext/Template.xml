		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(ВыполнениеДействийСтационара.ДатаВремяВыполнения, ДЕНЬ) КАК ДатаВыполнения,
	ВыполнениеДействийСтационара.Документ КАК Документ,
	ВыполнениеДействийСтационара.ИдентификаторЭлемента КАК ИдентификаторЭлемента,
	СУММА(ВыполнениеДействийСтационара.Количество) КАК Количество,
	ВыполнениеДействийСтационара.Регистратор.Ответственный КАК ДокументВыполненияДействияОтветственный,
	ВыполнениеДействийСтационара.Регистратор КАК ДокументВыполненияДействия
ПОМЕСТИТЬ ВыполнениеДействийСтационара
ИЗ
	РегистрСведений.ВыполнениеДействийСтационара КАК ВыполнениеДействийСтационара
ГДЕ
	ВыполнениеДействийСтационара.Документ ССЫЛКА Документ.Прием
	И ВЫРАЗИТЬ(ВыполнениеДействийСтационара.Документ КАК Документ.Прием).МедицинскаяКарта = &amp;МедицинскаяКарта

СГРУППИРОВАТЬ ПО
	НАЧАЛОПЕРИОДА(ВыполнениеДействийСтационара.ДатаВремяВыполнения, ДЕНЬ),
	ВыполнениеДействийСтационара.Документ,
	ВыполнениеДействийСтационара.ИдентификаторЭлемента,
	ВыполнениеДействийСтационара.Регистратор.Ответственный,
	ВыполнениеДействийСтационара.Регистратор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	&amp;Клиент КАК Пациент,
	&amp;МедицинскаяКарта КАК МедицинскаяКарта,
	ПланыЛечения.Комментарий КАК Комментарий,
	ПланыЛечения.Дата КАК ДатаНачала,
	ПланыЛечения.ДатаОкончания КАК ДатаОкончания,
	ПланыЛечения.Количество КАК ВсегоНазначено,
	ВЫБОР
		КОГДА ПланыЛечения.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДействийСтационара.Медикаменты)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДействийСтационара.Процедуры)
	КОНЕЦ КАК ВидыДействияСтационара,
	ПланыЛечения.ИдентификаторЭлемента КАК ИдентификаторЭлемента,
	ПланыЛечения.Номенклатура КАК ДействиеСтационара,
	ВЫБОР
		КОГДА ПланыЛечения.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал)
			ТОГДА ПланыЛечения.ПриемовВДень
		ИНАЧЕ ВЫБОР
				КОГДА ПланыЛечения.ПриемовВДень = 0
					ТОГДА 1
				ИНАЧЕ ПланыЛечения.ПриемовВДень
			КОНЕЦ
	КОНЕЦ КАК РазВДень,
	ПланыЛечения.Дозировка КАК Дозировка,
	СУММА(ЕСТЬNULL(ВыполнениеДействийСтационара.Количество, 0)) КАК Выполнено,
	ПланыЛечения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ПланыЛечения.Коэффициент КАК Коэффициент,
	ВыполнениеДействийСтационара.ДатаВыполнения КАК ДатаВыполнения,
	ВыполнениеДействийСтационара.ДокументВыполненияДействия КАК ДокументВыполненияДействия,
	ВыполнениеДействийСтационара.ДокументВыполненияДействияОтветственный КАК ДокументВыполненияДействияОтветственный,
	ВыполнениеДействийСтационара.Документ.Ответственный КАК НазначениеОтветственный,
	ПланыЛечения.Количество КАК КоличествоНазначенное
ПОМЕСТИТЬ ПланыЛеченияИтог
ИЗ
	РегистрСведений.ПланыЛечения КАК ПланыЛечения
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			&amp;Клиент КАК Клиент) КАК КлиентыВСтационаре
		ПО (ПланыЛечения.Номенклатура ССЫЛКА Справочник.Номенклатура)
			И (ПланыЛечения.ПервичныйПрием.МедицинскаяКарта = &amp;МедицинскаяКарта)
		ЛЕВОЕ СОЕДИНЕНИЕ ВыполнениеДействийСтационара КАК ВыполнениеДействийСтационара
		ПО ПланыЛечения.ДокументРегистратор = ВыполнениеДействийСтационара.Документ
			И ПланыЛечения.ИдентификаторЭлемента = ВыполнениеДействийСтационара.ИдентификаторЭлемента

СГРУППИРОВАТЬ ПО
	ПланыЛечения.ПервичныйПрием.Клиент,
	ПланыЛечения.ПервичныйПрием.МедицинскаяКарта,
	ПланыЛечения.Комментарий,
	ПланыЛечения.ПервичныйПрием,
	ПланыЛечения.Дата,
	ПланыЛечения.ДатаОкончания,
	ВЫБОР
		КОГДА ПланыЛечения.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДействийСтационара.Медикаменты)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДействийСтационара.Процедуры)
	КОНЕЦ,
	ПланыЛечения.ИдентификаторЭлемента,
	ПланыЛечения.Номенклатура,
	ВЫБОР
		КОГДА ПланыЛечения.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал)
			ТОГДА ПланыЛечения.ПриемовВДень
		ИНАЧЕ ВЫБОР
				КОГДА ПланыЛечения.ПриемовВДень = 0
					ТОГДА 1
				ИНАЧЕ ПланыЛечения.ПриемовВДень
			КОНЕЦ
	КОНЕЦ,
	ПланыЛечения.Дозировка,
	ПланыЛечения.ЕдиницаИзмерения,
	ПланыЛечения.Коэффициент,
	ПланыЛечения.Количество,
	ВыполнениеДействийСтационара.ДатаВыполнения,
	ВыполнениеДействийСтационара.ДокументВыполненияДействия,
	ВыполнениеДействийСтационара.ДокументВыполненияДействияОтветственный,
	ВыполнениеДействийСтационара.Документ.Ответственный,
	ПланыЛечения.Количество
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПланыЛеченияИтог.Пациент КАК Пациент,
	ПланыЛеченияИтог.МедицинскаяКарта КАК МедицинскаяКарта,
	ПланыЛеченияИтог.ДатаНачала КАК ДатаНачала,
	ПланыЛеченияИтог.ДатаОкончания КАК ДатаОкончания,
	ПланыЛеченияИтог.ВидыДействияСтационара КАК ВидДействия,
	ПланыЛеченияИтог.ДействиеСтационара КАК ДействиеСтационара,
	ПланыЛеченияИтог.РазВДень КАК РазВДень,
	ПланыЛеченияИтог.Дозировка КАК Дозировка,
	ПланыЛеченияИтог.Выполнено КАК Выполнено,
	ПланыЛеченияИтог.ДатаВыполнения КАК ДатаВыполнения,
	НАЧАЛОПЕРИОДА(ПланыЛеченияИтог.ДатаВыполнения, ДЕНЬ) КАК ДеньВыполнения,
	ПланыЛеченияИтог.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ПланыЛеченияИтог.Коэффициент КАК Коэффициент,
	ПланыЛеченияИтог.ВсегоНазначено КАК ВсегоНазначено,
	ПланыЛеченияИтог.ДокументВыполненияДействия КАК Документ,
	ПланыЛеченияИтог.ДокументВыполненияДействияОтветственный КАК ДокументОтветственный,
	ПланыЛеченияИтог.НазначениеОтветственный КАК НазначениеОтветственный,
	ПланыЛеченияИтог.КоличествоНазначенное КАК КоличествоНазначенное
ИЗ
	ПланыЛеченияИтог КАК ПланыЛеченияИтог</query>
	</dataSet>
	<calculatedField>
		<dataPath>ДатыНазначений</dataPath>
		<expression>ОбщегоНазначенияБИТКлиентСервер.ВернутьСтрокойПериодДат(ДатаНачала, ДатаОкончания)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Даты назначений</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ФактПлан</dataPath>
		<expression>1</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Факт/План</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Выполнено</dataPath>
		<expression>Сумма(Выполнено)</expression>
	</totalField>
	<totalField>
		<dataPath>ФактПлан</dataPath>
		<expression>Строка(Сумма(Выполнено)) + "/" + Строка(Сумма(ВычислитьВыражениеСГруппировкойМассив("ВсегоНазначено", "ДействиеСтационара,ДатыНазначений,НазначениеОтветственный")))</expression>
		<group>ВидДействия</group>
	</totalField>
	<totalField>
		<dataPath>ФактПлан</dataPath>
		<expression>Строка(Сумма(Выполнено)) + "/" + Строка(ВсегоНазначено)</expression>
		<group>ДействиеСтационара</group>
		<group>ДействиеСтационара Иерархия</group>
		<group>ДеньВыполнения</group>
		<group>Документ</group>
	</totalField>

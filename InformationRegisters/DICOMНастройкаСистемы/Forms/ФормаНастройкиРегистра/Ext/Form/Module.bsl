&НаКлиенте
Процедура ВыборКаталога(Заголовок, ПеременнаяПуть)
	
	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = Заголовок;
	ДиалогОткрытияФайла.Каталог = ПеременнаяПуть;
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		ПеременнаяПуть = ДиалогОткрытияФайла.Каталог;
		Модифицированность = Истина;
	Иначе
		Предупреждение(НСтр("ru = 'Каталог не выбран'; en = 'Directory not selected!'"));
	КонецЕсли;
		
КонецПроцедуры

// Функция - Проверка заполнения Поля формы, передаваемого в функцию
//
// Параметры:
//  Значение			 - Произвольное	 - Значение, которое необходимо проверить
//  СтрПолеЗначения		 - Строка	 -  Поле, которое должен на форме заполнить пользователь
//  НестандартныйТекст	 - Строка	 -  Сообщение, которое будет показано пользователю
// 
// Возвращаемое значение:
//  Булево - Истина, если НЕ заполнена
//
&НаКлиенте
Функция УказанноеПолеНеЗаполнено(Значение, СтрПолеЗначения = Неопределено, НестандартныйТекст = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(?(НестандартныйТекст = Неопределено,"необходимо заполнить это значение!", НестандартныйТекст),
						Неопределено, СтрПолеЗначения,);
		
		//// Сообщение некрасиво вываливаются из-за того, что данные находятся в группе "страницы"
		//Сообщение = Новый СообщениеПользователю();
		//Сообщение.Поле  = СтрПолеЗначения; 
		//Сообщение.Текст = ?(НестандартныйТекст = Неопределено,"необходимо заполнить это значение!", НестандартныйТекст); 
		//Сообщение.Сообщить();
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;		
	
КонецФункции

// Проверить существование каталога по его пути
//
// Параметры:
//  ПутьКаталога  - Строка - Строка полного пути к каталогу
//
// Возвращаемое значение:
//   Булево   - существует ли файл или нет
//
&НаКлиенте
Функция КаталогСуществует(ПутьКаталога)

	КаталогНаДиске = Новый Файл(ПутьКаталога);
    Возврат КаталогНаДиске.Существует();

КонецФункции 
	
// Процедура обходит все элементы внутри группы на форме, после чего ставит видимым указанный элемент
//
// Параметры:
//  ГруппаНаОбход  - Строка - Имя группы формы, элементы которой необходимо скрыть
//  ИмяЭлемента  - Строка - Имя элемента, который должен быть видимым
//
&НаКлиенте
Процедура СкрытьВсеЭлементыГруппыКромеУказанного(ГруппаНаОбход, ИмяЭлемента = Неопределено)

	Для каждого ЭлементГруппы из Элементы[ГруппаНаОбход].ПодчиненныеЭлементы Цикл
		
		Если ТипЗнч(ЭлементГруппы) = Тип("ДекорацияФормы") Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементГруппы.Видимость = Ложь; 
		
	КонецЦикла;	
	
	Если ИмяЭлемента <> Неопределено Тогда	
		Элементы[ИмяЭлемента].Видимость = Истина; 
		Элементы[ИмяЭлемента].Доступность = Истина;  
		Элементы[ИмяЭлемента].ТолькоПросмотр = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

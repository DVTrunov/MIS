Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
    Для Каждого Запись Из ЭтотОбъект Цикл
        ЗаполненПользователь = ЗначениеЗаполнено(Запись.Пользователь);
        ЗаполненПрофиль      = ЗначениеЗаполнено(Запись.Профиль);
        Если ЗаполненПользователь = ЗаполненПрофиль Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Заполните либо пользователя, либо профиль — но не оба сразу";
            Сообщение.Сообщить();
            Отказ = Истина;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
// Возвращает варианты, доступные пользователю.
// Персональные настройки полностью перекрывают профильные.
//
Функция ВариантыПользователя(Пользователь) Экспорт

    УстановитьПривилегированныйРежим(Истина);

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Пользователь", Пользователь);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Н.ВариантРабочегоМеста КАК Вариант,
    |    Н.ВариантРабочегоМеста.Наименование КАК Наименование,
    |    Н.ВариантРабочегоМеста.Заголовок КАК Заголовок,
    |    Н.ОсновнойВариант КАК ОсновнойВариант,
    |    Н.Порядок КАК Порядок,
    |    ВЫБОР КОГДА Н.Пользователь = &Пользователь ТОГДА 1 ИНАЧЕ 2 КОНЕЦ КАК Уровень
    |ИЗ РегистрСведений.омг_НазначениеРабочихМест КАК Н
    |ГДЕ
    |    (Н.Пользователь = &Пользователь
    |        ИЛИ Н.Профиль В
    |            (ВЫБРАТЬ П.Профиль ИЗ Справочник.Пользователи КАК П ГДЕ П.Ссылка = &Пользователь))
    |    И НЕ Н.ВариантРабочегоМеста.ПометкаУдаления
    |    И Н.ВариантРабочегоМеста <> ЗНАЧЕНИЕ(Справочник.омг_ВариантыРабочихМест.ПустаяСсылка)
    |УПОРЯДОЧИТЬ ПО Уровень, Порядок, Наименование";

    Таблица = Запрос.Выполнить().Выгрузить();

    Персональные = Таблица.НайтиСтроки(Новый Структура("Уровень", 1));
    Строки = ?(Персональные.Количество() > 0, Персональные, Таблица);

    Результат = Новый СписокЗначений;
    Добавленные = Новый Соответствие;
    Для Каждого Стр Из Строки Цикл
        Если Добавленные.Получить(Стр.Вариант) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Добавленные.Вставить(Стр.Вариант, Истина);
        Представление = ?(ПустаяСтрока(Стр.Заголовок), Стр.Наименование, Стр.Заголовок);
        Результат.Добавить(Стр.Вариант, Представление, Стр.ОсновнойВариант);
    КонецЦикла;

    Возврат Результат;

КонецФункции
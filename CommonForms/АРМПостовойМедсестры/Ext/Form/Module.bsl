&НаКлиенте
Процедура ДоговорыКлиента(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаОбращения Тогда
		ТекущиеДанные = Элементы.СписокОбращений.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.Клиент) Тогда
			ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Клиент", ТекущиеДанные.Клиент));
			ОткрытьФорму("Документ.ДоговорСКлиентом.ФормаСписка",ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаправление(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаОбращения Тогда
		
		ТекущиеДанные = Элементы.СписокОбращений.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.Клиент) Тогда
				ЗначенияЗаполнения = Новый Структура("Клиент,ВрачНаправивший,Диагноз,МедицинскаяКарта", ТекущиеДанные.Клиент,ТекущиеДанные.ЛечащийВрач, ТекущиеДанные.ДиагнозПоступления, ТекущиеДанные.МедицинскаяКарта);
				ОткрытьФорму("Документ.НаправлениеСтационар.ФормаОбъекта",Новый Структура("ЗначенияЗаполнения",ЗначенияЗаполнения));
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПациентыВСтационаре Тогда
		
		ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ЗначенияЗаполнения = Новый Структура("Клиент", ТекущиеДанные.Клиент);
			
			ДокументОбращения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.ДокументПоступления, "ДокументОбращения");
			Если ЗначениеЗаполнено(ДокументОбращения) Тогда
				РеквизитыОбращения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбращения, "ЛечащийВрач,ДиагнозПоступления,МедицинскаяКарта");
				ЗначенияЗаполнения.Вставить("ВрачНаправивший",	РеквизитыОбращения.ЛечащийВрач);
				ЗначенияЗаполнения.Вставить("Диагноз",			РеквизитыОбращения.ДиагнозПоступления);
				ЗначенияЗаполнения.Вставить("МедицинскаяКарта", РеквизитыОбращения.МедицинскаяКарта);
			КонецЕсли;
			
			ОткрытьФорму("Документ.НаправлениеСтационар.ФормаОбъекта",Новый Структура("ЗначенияЗаполнения",ЗначенияЗаполнения));
		КонецЕсли;
			
	КонецЕсли;
	
	ОткрытьФорму("Документ.НаправлениеСтационар.ФормаОбъекта");		
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументДвиженияВСтационаре(ВидОперации)
	
	ЗначенияЗаполнения = Новый Структура;
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаОбращения	Тогда
		
		ТекущиеДанные = Элементы.СписокОбращений.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			
			СтрокиПоступления = ПациентыВСтационаре.НайтиСтроки(Новый Структура("ДокументОбращения", Элементы.СписокОбращений.ТекущаяСтрока));
			Если СтрокиПоступления.Количество() = 0 Тогда
				
				ЗначенияЗаполнения = Новый Структура("Клиент,МедицинскаяКарта", ТекущиеДанные.Клиент,ТекущиеДанные.МедицинскаяКарта);
				Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.Поступление") Тогда
					ЗначенияЗаполнения.Вставить("ДокументОбращения", Элементы.СписокОбращений.ТекущаяСтрока);
				КонецЕсли;
			Иначе
				Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.Поступление") Тогда
					ВариантыОтвета = Новый СписокЗначений;
					ВариантыОтвета.Добавить(1, "Открыть существующий");
					ВариантыОтвета.Добавить(2, "Создать новый");
					ВариантыОтвета.Добавить(3, "Отмена");
					Ответ = Вопрос(	"По выбранному обращению уже есть документ поступления в стационар.
									|Открыть это поступление или создать новое?", ВариантыОтвета, 30, ВариантыОтвета[2].Значение);
					Если Ответ = 1 Тогда
						ОткрытьЗначение(СтрокиПоступления[0].ДокументПоступления);
						Возврат;
					ИначеЕсли Ответ = 3 Тогда
						Возврат;
					КонецЕсли;
				Иначе
					ЗначенияЗаполнения = Новый Структура("Клиент,МедицинскаяКарта", ТекущиеДанные.Клиент,ТекущиеДанные.МедицинскаяКарта);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
			
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПациентыВСтационаре
		И ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.Поступление")
	Тогда
		
		ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			
			ЗначенияЗаполнения = Новый Структура("Клиент", ТекущиеДанные.Клиент);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗначенияЗаполнения.Вставить("ВидОперации", ВидОперации);
	ОткрытьФорму("Документ.УстановкаУсловийПребывания.ФормаОбъекта",Новый Структура("ЗначенияЗаполнения",ЗначенияЗаполнения));
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПоступлениеИзменениеВыписку(Команда)
	
	Если Команда = Команды.Найти("СоздатьПоступление") Тогда
		
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.Поступление");
		
	ИначеЕсли Команда = Команды.Найти("СоздатьИзменениеУсловий") Тогда
		
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.ИзменениеУсловий");
		
	ИначеЕсли Команда = Команды.Найти("СоздатьПереводМеждуПодразделениями") Тогда
		
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.ПереводМеждуПодразделениями");
		
	ИначеЕсли Команда = Команды.Найти("СоздатьВыписку") Тогда
		
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.Выписка");
		
	Иначе
		Возврат;
	КонецЕсли;
	
	СоздатьДокументДвиженияВСтационаре(ВидОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОбращенийПоФилиалам()
	
	Если Не омг_Филиалы.Количество() = 0 Тогда
		РаботаСФормамиКлиент.УстановитьОтборСписка("Филиал", омг_Филиалы, СписокОбращений, ВидСравненияКомпоновкиДанных.ВСписке);
	Иначе
		РаботаСФормамиКлиент.СнятьОтборСписка("Филиал", СписокОбращений);
	КонецЕсли;
	Если Не омг_Отделения.Количество() = 0 Тогда
		РаботаСФормамиКлиент.УстановитьОтборСписка("Подразделение", омг_Отделения, СписокОбращений, ВидСравненияКомпоновкиДанных.ВСписке);
	Иначе
		РаботаСФормамиКлиент.СнятьОтборСписка("Подразделение", СписокОбращений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСегодняшниеОбращения(Команда)
	
	// Изменения Макеевв 13-12-2025 (
	Элементы.ОтборСегодняшниеОбращения.Пометка = Не Элементы.ОтборСегодняшниеОбращения.Пометка;
	
	Если Элементы.ОтборСегодняшниеОбращения.Пометка Тогда

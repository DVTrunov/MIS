&НаКлиенте
Процедура СоздатьОУ(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаОбращения Тогда
	
		ТекущиеДанные = Элементы.СписокОбращений.ТекущиеДанные;
			
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПациентыВСтационаре Тогда
		
		ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
			
	КонецЕсли;	
	
	Если ТекущиеДанные = Неопределено Тогда
		ПараметрыФормы = Неопределено;
	Иначе
		ПараметрыФормы = Новый Структура("Клиент",ТекущиеДанные.Клиент);
	КонецЕсли;
	
	ФормаСозданияОУ = ОткрытьФорму("ОбщаяФорма.ФормаСозданияОУВСтационаре", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокТекущихПациентовСтационара(Команда)
	
	// Изменения Макеев 13-12-2025 (
	ПациентыВСтационаре.Очистить();
	
	ТекущиеПациенты = ПолучитьТекущихПациентовСтационара(Истина, омг_Филиалы, омг_Отделения);
	Для Каждого СтрокаТекущегоПациента Из ТекущиеПациенты Цикл
		
		ЗаполнитьЗначенияСвойств(ПациентыВСтационаре.Добавить(), СтрокаТекущегоПациента);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущихПациентовСтационара(ДляОбработкиНаКлиенте, Знач омг_Филиалы, Знач омг_Отделения)
	
	// Изменения Макеев 13-12-2025 (
	
	ДополнительныеПоляЗапроса = Новый СписокЗначений;
	ДополнительныеПоляЗапроса.Добавить("Пациент", "Клиент");
	ДополнительныеПоляЗапроса.Добавить("ДатаРождения", "Клиент.ДатаРождения");
	ДополнительныеПоляЗапроса.Добавить("ДиагнозПоступления", "ДокументПоступления.ДокументОбращения.ДиагнозПоступления");
	ДополнительныеПоляЗапроса.Добавить("МедицинскаяКарта", "ДокументПоступления.ДокументОбращения.МедицинскаяКарта");
	
	ДополнительныеУсловия = Новый Массив;
	
	Если Не омг_Отделения.Количество() = 0 Тогда
		ТекстЗапроса = "КлиентыСтационара.КойкоМесто.Владелец.Подразделение В (&Подразделения)";
		ПараметрЗапроса = Новый Структура("Подразделения", омг_Отделения);
		ДополнительныеУсловия.Добавить(Новый Структура("Текст, Параметры", ТекстЗапроса, ПараметрЗапроса));
	КонецЕсли;
	
	Если Не омг_Филиалы.Количество() = 0 Тогда
		ТекстЗапроса = "Регистратор.Филиал В (&Филиалы)";
		ПараметрЗапроса = Новый Структура("Филиалы", омг_Филиалы);
		ДополнительныеУсловия.Добавить(Новый Структура("Текст, Параметры", ТекстЗапроса, ПараметрЗапроса));
	КонецЕсли;
	
	ТаблицаПациентов = Стационар.ПолучитьКлиентовСтационара(ТекущаяДата(),,ДополнительныеПоляЗапроса, ДополнительныеУсловия);
	
	Если ДляОбработкиНаКлиенте Тогда
		Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаПациентов);
	Иначе
		Возврат ТаблицаПациентов;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПациентыВСтационареВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = ПациентыВСтационаре.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле = Элементы.ПациентыВСтационареДатаПоследнегоИзменения Тогда
		ОткрытьЗначение(ТекущиеДанные.ДокументИзмененияРазмещения);
	Иначе
		ОткрытьЗначение(ТекущиеДанные.ДокументПоступления);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПребыванияПациента(Команда)
	
	ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Клиент", ТекущиеДанные.Клиент));
		ОткрытьФорму("РегистрСведений.КлиентыСтационара.ФормаСписка", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ФилиалыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;//("Организация", Объект.омг_Организация);
	СписокВыбранных = омг_Филиалы;
	ОткрытьФорму("ОбщаяФорма.омг_ФормаВыбораСИерархией", 
		Новый Структура("Справочник, СписокВыбранных, Отбор", "Филиалы", СписокВыбранных, Отбор), Элементы.омг_Филиалы,
		УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ОтделенияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокВыбранных = омг_Отделения;

	Отбор = Новый Структура;//("Организация", Объект.омг_Организация);
	
	ПараметрыЗапроса = Новый Массив;
	ПараметрыЗапроса.Добавить(Новый Структура("Параметр, Значение", "Филиалы", омг_Филиалы.ВыгрузитьЗначения()));
	
	Отбор.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	
	СложныеОтборы = Новый Массив;
	Если Не омг_Филиалы.Количество() = 0 Тогда
		СложныеОтборы.Добавить("Филиал В (&Филиалы)");
	КонецЕсли;
	
	Отбор.Вставить("СложныеОтборы", СложныеОтборы);
	ОткрытьФорму("ОбщаяФорма.омг_ФормаВыбораСИерархией", 
		Новый Структура("Справочник, СписокВыбранных, Отбор", "Подразделения", СписокВыбранных, Отбор), Элементы.омг_Отделения,
		УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура омг_ФилиалыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	омг_Филиалы = ВыбранноеЗначение;
	
	ОбновитьСписокТекущихПациентовСтационара(Неопределено);
	ОтборОбращенийПоФилиалам();
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ОтделенияОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	омг_Отделения = ВыбранноеЗначение;
	
	ОбновитьСписокТекущихПациентовСтационара(Неопределено);
	ОтборОбращенийПоФилиалам();
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ФилиалыПриИзменении(Элемент)
	
	Если Не омг_Филиалы.Количество() = 0 Тогда
		омг_Отделения.Очистить();
	КонецЕсли;
	ОбновитьСписокТекущихПациентовСтационара(Неопределено);
	ОтборОбращенийПоФилиалам();

КонецПроцедуры


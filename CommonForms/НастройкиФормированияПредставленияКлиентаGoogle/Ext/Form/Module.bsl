#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьТекущиеНастройки();		
	
КонецПроцедуры   

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьКонстанту();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗаписатьКонстанту();
	ЭтотОбъект.Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&НаСервере
Процедура ЗаполнитьТекущиеНастройки()
	
	ШаблонПредставления = Константы.НастройкиФормированияПредставленияКлиентаGoogle.ПолучитьНастройкиФормированияНаименованияСобытияGoogle();
	Если ШаблонПредставления = "-" Тогда
		Возврат;
	КонецЕсли;
	
	КомпонентыШаблона = СтрРазделить(ШаблонПредставления, " ", Ложь);
	
	ПередаватьТелефон = СтрНайти(ШаблонПредставления, "ТЕЛЕФОН");
	
	Переключатели = Новый Массив;
	Переключатели.Добавить(Элементы.ПредставлениеФамилия);
	Переключатели.Добавить(Элементы.ПредставлениеИмя);
	Переключатели.Добавить(Элементы.ПредставлениеОтчество);
	
	Для Каждого Переключатель Из Переключатели Цикл
		Для Каждого КомпонентШаблона Из КомпонентыШаблона Цикл
			Если Переключатель.СписокВыбора.НайтиПоЗначению(КомпонентШаблона) <> Неопределено Тогда
				ЭтотОбъект[Переключатель.Имя] = КомпонентШаблона;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениеНастройки(Реквизит, Настройка)
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Неопределено, 0);
	Соответствие.Вставить(Истина, 2);
	Соответствие.Вставить(Ложь, 1);

	ЭтотОбъект[Реквизит] = Соответствие.Получить(Настройка);
	
КонецПроцедуры

Процедура ЗаписатьКонстанту()
	
	ШаблонПредставления = "";
	
	Если ЗначениеЗаполнено(ПредставлениеФамилия) Тогда
		ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ШаблонПредставления, ПредставлениеФамилия, " ");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПредставлениеИмя) Тогда
		ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ШаблонПредставления, ПредставлениеИмя, " ");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПредставлениеОтчество) Тогда
		ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ШаблонПредставления, ПредставлениеОтчество, " ");
	КонецЕсли;
	Если ПередаватьТелефон Тогда
		ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ШаблонПредставления, "ТЕЛЕФОН", " ");
	КонецЕсли;
	
	ШаблонПредставления = ?(ШаблонПредставления = "", "-", ШаблонПредставления);

	Константы.НастройкиФормированияПредставленияКлиентаGoogle.Установить(ШаблонПредставления);
	
КонецПроцедуры

#КонецОбласти

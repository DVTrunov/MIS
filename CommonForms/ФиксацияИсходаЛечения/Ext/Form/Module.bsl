                        #Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПервичныйПрием = Параметры.ПервичныйПрием;
	ДокументЗакрытия = Параметры.ДокументЗакрытия;
	
	Если Не ЗначениеЗаполнено(ПервичныйПрием) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Заголовок = "Исход маршрута лечения";
	ПрочитатьТекущийИтог();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьТекущийИтог()
	
	МенеджерЗаписи = РегистрыСведений.ИтогиЛечения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ПервичныйПрием = ПервичныйПрием;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Итог = МенеджерЗаписи.Итог;
		ДатаЗакрытия = МенеджерЗаписи.ДатаЗакрытия;
		Комментарий = МенеджерЗаписи.Комментарий;
		ИтогУжеЗафиксирован = Истина;
	Иначе
		ДатаЗакрытия = НачалоДня(ТекущаяДатаСеанса());
		ИтогУжеЗафиксирован = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьИтогНаСервере()
	
	Если Не ЗначениеЗаполнено(Итог) Тогда
		Возврат "Не выбран исход.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаЗакрытия) Тогда
		Возврат "Не указана дата закрытия.";
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ИтогиЛечения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ПервичныйПрием = ПервичныйПрием;
	МенеджерЗаписи.Итог = Итог;
	МенеджерЗаписи.ДатаЗакрытия = ДатаЗакрытия;
	МенеджерЗаписи.ДокументЗакрытия = ДокументЗакрытия;
	МенеджерЗаписи.Комментарий = Комментарий;
	МенеджерЗаписи.Записать();
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	ОшибкаЗаписи = ЗаписатьИтогНаСервере();
	Если ЗначениеЗаполнено(ОшибкаЗаписи) Тогда
		ПоказатьПредупреждение(, ОшибкаЗаписи);
		Возврат;
	КонецЕсли;
	
	Оповестить("ЗафиксированИсходЛечения", ПервичныйПрием);
	Закрыть(Истина);
	
КонецПроцедуры

#КонецОбласти
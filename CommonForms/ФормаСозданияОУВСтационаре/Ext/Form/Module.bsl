&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	мУчетнаяПолитика = УправлениеНастройками.ПолучитьУчетнуюПолитику();
	
	ФилиалТекущий = УправлениеНастройками.ПолучитьФилиалПоУмолчаниюПользователя();
	ОсновнойПрейскурант = мУчетнаяПолитика.ОсновнойПрейскурант;

	Если ЗначениеЗаполнено(Параметры.Клиент) Тогда 
		
		Клиент = Параметры.Клиент;
		ДатаПоследнегоРасчета = ПолучитьДатуПоследнегоРасчета(ФилиалТекущий,Клиент);
		
		Если ДатаПоследнегоРасчета = Неопределено Тогда
			ДатаПоступления = ПолучитьДатуПоступления(ФилиалТекущий,Клиент);
			Если ЗначениеЗаполнено(ДатаПоступления) Тогда
				НачалоПериода = НачалоДня(ДатаПоступления);
			КонецЕсли;
		Иначе
			НачалоПериода = НачалоДня(ДатаПоследнегоРасчета) + 86400;
		КонецЕсли;
		УчитыватьПервыйДень = Истина;

		ОкончаниеПериода = КонецДня(ПолучитьДатуВыписки(ФилиалТекущий,Клиент,НачалоПериода));
		
		Если НачалоПериода <> Дата(1,1,1) И ОкончаниеПериода <= НачалоПериода Тогда 
			ОкончаниеПериода = Дата(1,1,1);	
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.СписокНоменклатурыХарактеристикаНоменклатуры.Видимость = мУчетнаяПолитика.ВестиУчетПоХарактеристикам;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатуПоследнегоРасчета(ФилиалТекущий,Клиент)
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ПериодыПроведенныхОбщихРасчетов.ДатаОкончания
	                      |ИЗ
	                      |	РегистрСведений.ПериодыПроведенныхОбщихРасчетов КАК ПериодыПроведенныхОбщихРасчетов
	                      |ГДЕ
	                      |	ПериодыПроведенныхОбщихРасчетов.Клиент = &Клиент
	                      |	И ПериодыПроведенныхОбщихРасчетов.Филиал = &Филиал
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ПериодыПроведенныхОбщихРасчетов.ДатаОкончания УБЫВ");
	Запрос.УстановитьПараметр("Филиал",ФилиалТекущий);
	Запрос.УстановитьПараметр("Клиент",Клиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ДатаОкончания;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДатуПоступления(ФилиалТекущий,Клиент)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КлиентыСтационара.ДокументПоступления,
	                      |	КлиентыСтационара.ДокументПоступления.ДокументОбращения КАК ДокументОбращения,
	                      |	КлиентыСтационара.ДокументПоступления.ДатаНачала КАК ДатаНачала
	                      |ИЗ
	                      |	РегистрСведений.КлиентыСтационара КАК КлиентыСтационара
	                      |ГДЕ
	                      |	КлиентыСтационара.Клиент = &Клиент
	                      |	И КлиентыСтационара.ДокументПоступления.ВидОперации = &ВидОперации
	                      |	И КлиентыСтационара.ДокументПоступления.Филиал = &Филиал");
	Запрос.УстановитьПараметр("Филиал",ФилиалТекущий);
	Запрос.УстановитьПараметр("Клиент",Клиент);
	Запрос.УстановитьПараметр("ВидОперации",Перечисления.ВидыДвиженияВСтационаре.Поступление);
	
	ТабРез = Запрос.Выполнить().Выгрузить();
	ТабРез.Колонки.Добавить("ДатаПоступления", Новый ОписаниеТипов("Дата"));
	
	ДатаПоступления = Неопределено;
	
	Если ТабРез.Количество() <> 0 Тогда
		Для Каждого СтрокаТаблицы Из ТабРез Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы.ДокументОбращения) Тогда
				ДатаПоступления = СтрокаТаблицы.ДокументОбращения.ДатаВремяПоступления;
				Если ЗначениеЗаполнено(ДатаПоступления) Тогда
					СтрокаТаблицы.ДатаПоступления = ДатаПоступления;
				Иначе
					СтрокаТаблицы.ДатаПоступления = СтрокаТаблицы.ДатаНачала;
				КонецЕсли;
			Иначе
				СтрокаТаблицы.ДатаПоступления = СтрокаТаблицы.ДатаНачала;
			КонецЕсли;
		КонецЦикла;
		
		ТабРез.Сортировать("ДатаПоступления УБЫВ");
		ДатаПоступления = ТабРез[0].ДатаПоступления;
	КонецЕсли;
	
	Возврат ДатаПоступления;
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДатуВыписки(ФилиалТекущий,Клиент, ДатаНачала)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КлиентыСтационараСрезПоследних.Период КАК ДатаВыписки
	                      |ИЗ
	                      |	РегистрСведений.КлиентыСтационара.СрезПоследних(, Клиент = &Клиент) КАК КлиентыСтационараСрезПоследних
	                      |ГДЕ
	                      |	КлиентыСтационараСрезПоследних.Выписан");
	Запрос.УстановитьПараметр("Клиент",Клиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий()
		И Выборка.ДатаВыписки > ДатаНачала
	Тогда 
		Возврат Выборка.ДатаВыписки;
	Иначе 
		Возврат ТекущаяДата();	
	КонецЕсли;
		
КонецФункции


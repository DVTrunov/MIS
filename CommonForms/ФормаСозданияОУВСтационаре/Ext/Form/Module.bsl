КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОказанныеУслугиНаСервере()
	
	ТаблицаПериодов = Новый ТаблицаЗначений;
	ПодготовитьТаблицуПериодов(ТаблицаПериодов);
	
	Если ТаблицаПериодов.Количество() > 0 Тогда 

		Запрос = Новый Запрос;
		МВТ  = Новый МенеджерВременныхТаблиц;
		Запрос.МенеджерВременныхТаблиц = МВТ;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаПериодов.тзНачалоПериода,
		               |	ТаблицаПериодов.тзОкончаниеПериода,
		               |	ТаблицаПериодов.тзДляРасчета
		               |ПОМЕСТИТЬ ТаблицаПериодов
		               |ИЗ
		               |	&ТаблицаПериодов КАК ТаблицаПериодов
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	УсловияПребывания.Период,
		               |	УсловияПребывания.Регистратор,
		               |	УсловияПребывания.НомерСтроки,
		               |	УсловияПребывания.Активность,
		               |	УсловияПребывания.Клиент,
		               |	УсловияПребывания.Прейскурант,
		               |	УсловияПребывания.Номенклатура,
		               |	УсловияПребывания.Полис,
		               |	УсловияПребывания.ДатаНачала,
		               |	УсловияПребывания.ДатаОкончания
		               |ПОМЕСТИТЬ УсловияПребывания
		               |ИЗ
		               |	РегистрСведений.УсловияПребывания КАК УсловияПребывания
		               |ГДЕ
		               |	УсловияПребывания.Клиент = &Клиент
		               |	И УсловияПребывания.Регистратор.Филиал = &Филиал
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаПериодов.тзНачалоПериода,
		               |	ТаблицаПериодов.тзОкончаниеПериода,
		               |	ТаблицаПериодов.тзДляРасчета,
		               |	МАКСИМУМ(УсловияПребывания.Период) КАК Период
		               |ПОМЕСТИТЬ тбМаксПериод
		               |ИЗ
		               |	ТаблицаПериодов КАК ТаблицаПериодов
		               |		ЛЕВОЕ СОЕДИНЕНИЕ УсловияПребывания КАК УсловияПребывания
		               |		ПО ТаблицаПериодов.тзОкончаниеПериода >= УсловияПребывания.Период
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТаблицаПериодов.тзНачалоПериода,
		               |	ТаблицаПериодов.тзОкончаниеПериода,
		               |	ТаблицаПериодов.тзДляРасчета
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	тбМаксПериод.тзНачалоПериода,
		               |	тбМаксПериод.тзОкончаниеПериода,
		               |	тбМаксПериод.тзДляРасчета,
		               |	УсловияПребывания.Период,
		               |	УсловияПребывания.Регистратор,
		               |	УсловияПребывания.НомерСтроки,
		               |	УсловияПребывания.Активность,
		               |	УсловияПребывания.Клиент,
		               |	УсловияПребывания.Прейскурант,
		               |	УсловияПребывания.Номенклатура,
		               |	УсловияПребывания.Полис,
		               |	УсловияПребывания.ДатаНачала,
		               |	УсловияПребывания.ДатаОкончания
		               |ПОМЕСТИТЬ тбУсловияПребывания
		               |ИЗ
		               |	тбМаксПериод КАК тбМаксПериод
		               |		ЛЕВОЕ СОЕДИНЕНИЕ УсловияПребывания КАК УсловияПребывания
		               |		ПО тбМаксПериод.Период = УсловияПребывания.Период";
					   
		Запрос.УстановитьПараметр("ТаблицаПериодов",ТаблицаПериодов);
		Запрос.УстановитьПараметр("Клиент",Клиент);
		Запрос.УстановитьПараметр("Филиал",ФилиалТекущий);
		
		Запрос.Выполнить();
		
		ТаблицаДанных = СписокНоменклатуры.Выгрузить(Новый Массив,);
		
		ЗаполнитьПоПриемам(МВТ,ТаблицаДанных);
		ЗаполнитьПоДействиям(МВТ,ТаблицаДанных);
		ЗаполнитьПоУсловиям(МВТ,ТаблицаДанных);

		Если ТаблицаДанных.Количество() > 0 Тогда 
			ЗаполнитьТЧПоУслугам(ТаблицаДанных);
		КонецЕсли;
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОказанияУслуг(Команда)
	
	СоздатьОказанияУслугСервер();
	
	Если СписокОУ.Количество() <> 0 Тогда
		Состояние("Документы созданы, но не проведены. Проверьте документы перед проведением");
		Если СписокОУ.Количество() = 1 Тогда
			ОткрытьЗначение(СписокОУ[СписокОУ.Количество()-1].Ссылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьОказанияУслугСервер()
	
	Если СписокНоменклатуры.Количество() > 0 Тогда 
		мсДокументов = Новый Массив;
		
		СоздатьДокументыОУ(мсДокументов, СписокНоменклатуры.Выгрузить());
		
		Если мсДокументов.Количество() > 0 Тогда 
			СписокОУ.Очистить();
			Для Каждого эл Из мсДокументов Цикл 
				ЗаполнитьЗначенияСвойств(СписокОУ.Добавить(),эл);
				ЗаполнитьРегистрПериодом(эл);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьТаблицуПериодов(ТаблицаПериодов)
	
	Если УчитыватьПервыйДень Тогда 
		РасчетнаяДатаНачалаПериода = НачалоДня(НачалоПериода);
	Иначе 
		РасчетнаяДатаНачалаПериода = НачалоДня(НачалоПериода + 86400);
	КонецЕсли;
	
	РасчетнаяДатаОкончанияПериода = КонецДня(ОкончаниеПериода);
	
	ТаблицаПериодов.Колонки.Добавить("тзНачалоПериода",Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаПериодов.Колонки.Добавить("тзОкончаниеПериода",Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));	
	ТаблицаПериодов.Колонки.Добавить("тзДляРасчета",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,0,ДопустимыйЗнак.Неотрицательный)));
	
	НовыйДень = РасчетнаяДатаНачалаПериода;
	
	Пока НовыйДень <= РасчетнаяДатаОкончанияПериода Цикл 
		стрТЗ = ТаблицаПериодов.Добавить();
		стрТЗ.тзНачалоПериода = НачалоДня(НовыйДень);
		стрТЗ.тзОкончаниеПериода = КонецДня(НовыйДень);
		стрТЗ.тзДляРасчета = 1;
		НовыйДень = НовыйДень + 86400;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	Если УчитыватьПервыйДень Тогда 
		НачалоПериода = НачалоДня(НачалоПериода);
	Иначе 
		НачалоПериода = НачалоДня(НачалоПериода + 86400);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеПериодаПриИзменении(Элемент)
	ОкончаниеПериода = КонецДня(ОкончаниеПериода);
КонецПроцедуры

&НаКлиенте
Процедура СписокОУВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьЗначение(Элементы.СписокОУ.ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыЦенаКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	ТекущиеДанные.Цена = ТекущиеДанные.Сумма / ?(ТекущиеДанные.Количество = 0, 1, ТекущиеДанные.Количество);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыПрейскурантПриИзменении(Элемент)
	
	ПересчитатьЦенуУслуги(Элементы.СписокНоменклатуры.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЦенуУслуги(СтрокаНоменклатуры)
	
	Если ЗначениеЗаполнено(СтрокаНоменклатуры.Прейскурант)
		И ЗначениеЗаполнено(СтрокаНоменклатуры.Номенклатура)
	Тогда
		СтрокаНоменклатуры.Цена = Ценообразование.ПолучитьЦену(СтрокаНоменклатуры.Прейскурант, СтрокаНоменклатуры.Номенклатура,ТекущаяДата(), СтрокаНоменклатуры.ХарактеристикаНоменклатуры, СтрокаНоменклатуры.ЕдиницаИзмерения).Цена;	
	Иначе
		СтрокаНоменклатуры.Цена = 0;
	КонецЕсли;
	
	СтрокаНоменклатуры.Сумма = СтрокаНоменклатуры.Количество * СтрокаНоменклатуры.Цена;
	
КонецПроцедуры
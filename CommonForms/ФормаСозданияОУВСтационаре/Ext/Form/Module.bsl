//Обработка данных

&НаСервере
Процедура ЗаполнитьПоПриемам(МВТ,ТаблицаДанных)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("Клиент",Клиент);
	Запрос.УстановитьПараметр("Филиал",ФилиалТекущий);
	Запрос.УстановитьПараметр("ДатаНачала",НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания",ОкончаниеПериода);
	Запрос.УстановитьПараметр("Прейскурант",ОсновнойПрейскурант);		
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриемРаботы.Ссылка КАК Ссылка,
	               |	ПриемРаботы.Ссылка.Дата КАК Дата,
	               |	ПриемРаботы.Ссылка.Врач КАК Врач,
	               |	ПриемРаботы.Номенклатура КАК Номенклатура,
	               |	ПриемРаботы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ПриемРаботы.Количество КАК Количество
	               |ПОМЕСТИТЬ ТаблицаПрием
	               |ИЗ
	               |	Документ.Прием.Работы КАК ПриемРаботы
	               |ГДЕ
	               |	ПриемРаботы.Ссылка.УчитываетсяВОбщемРасчете
	               |	И ПриемРаботы.Ссылка.Клиент = &Клиент
	               |	И ПриемРаботы.Ссылка.Филиал = &Филиал
	               |	И ПриемРаботы.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	тбУсловияПребывания.тзНачалоПериода КАК тзНачалоПериода,
	               |	тбУсловияПребывания.тзОкончаниеПериода КАК тзОкончаниеПериода,
	               |	тбУсловияПребывания.тзДляРасчета КАК тзДляРасчета,
	               |	тбУсловияПребывания.Регистратор КАК Регистратор,
	               |	тбУсловияПребывания.Период КАК Период,
	               |	тбУсловияПребывания.Прейскурант КАК Прейскурант,
	               |	тбУсловияПребывания.Полис КАК Полис
	               |ПОМЕСТИТЬ тбУсловияПребыванияСв
	               |ИЗ
	               |	тбУсловияПребывания КАК тбУсловияПребывания
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(тбУсловияПребывания.Прейскурант, &Прейскурант) КАК Прейскурант,
	               |	ЕСТЬNULL(тбУсловияПребывания.Полис, ЗНАЧЕНИЕ(Справочник.СтраховыеПолисы.ПустаяСсылка)) КАК Полис,
	               |	Прием.Ссылка КАК Прием,
	               |	Прием.Врач КАК Врач,
	               |	Прием.Номенклатура КАК Номенклатура,
	               |	Прием.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения,
	               |	Прием.Количество КАК Количество
	               |ИЗ
	               |	ТаблицаПрием КАК Прием
	               |		ЛЕВОЕ СОЕДИНЕНИЕ тбУсловияПребыванияСв КАК тбУсловияПребывания
	               |		ПО Прием.Дата >= тбУсловияПребывания.тзНачалоПериода
	               |			И Прием.Дата <= тбУсловияПребывания.тзОкончаниеПериода
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ тбУсловияПребыванияСв";
	
	Выборка = Запрос.Выполнить().Выбрать();
	МассивПриемов = Новый Массив;
	Пока Выборка.Следующий() Цикл 
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),Выборка);
		МассивПриемов.Добавить(Выборка.Прием);
	КонецЦикла;
	
	ЗаполнитьМатериалыПоПриемам(МассивПриемов);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДействиям(МВТ,ТаблицаДанных)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("Клиент",Клиент);
	Запрос.УстановитьПараметр("Филиал",ФилиалТекущий);
	Запрос.УстановитьПараметр("ДатаНачала",НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания",ОкончаниеПериода);
	Запрос.УстановитьПараметр("Прейскурант",ОсновнойПрейскурант);		
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ВыполнениеДействийСтационара.ДействиеСтационара ССЫЛКА Справочник.ДействияМедсестрыСтационара
	               |			ТОГДА ВыполнениеДействийСтационара.ДействиеСтационара.Номенклатура
	               |		ИНАЧЕ ВыполнениеДействийСтационара.ДействиеСтационара
	               |	КОНЕЦ КАК Номенклатура,
	               |	ВыполнениеДействийСтационара.Количество КАК Количество,
	               |	ВыполнениеДействийСтационара.ДатаВремяВыполнения КАК Период,
	               |	ВыполнениеДействийСтационара.Регистратор.Ответственный.Сотрудник КАК Врач,
	               |	ВыполнениеДействийСтационара.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ВыполнениеДействийСтационара.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ПОМЕСТИТЬ ТаблицаНоменклатурыПоДействиям
	               |ИЗ
	               |	РегистрСведений.ВыполнениеДействийСтационара КАК ВыполнениеДействийСтационара
	               |ГДЕ
	               |	ВыполнениеДействийСтационара.Клиент = &Клиент
	               |	И ВыполнениеДействийСтационара.Регистратор.Филиал = &Филиал
	               |	И ВыполнениеДействийСтационара.ДатаВремяВыполнения МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И (ВыполнениеДействийСтационара.ДействиеСтационара ССЫЛКА Справочник.Номенклатура
	               |			ИЛИ ВЫРАЗИТЬ(ВыполнениеДействийСтационара.ДействиеСтационара КАК Справочник.ДействияМедсестрыСтационара).Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
				   |	И (НЕ ВыполнениеДействийСтационара.ДействиеСтационара ССЫЛКА Справочник.Номенклатура
				   |			ИЛИ ВыполнениеДействийСтационара.ДействиеСтационара.ИсполнительВСтационаре = ЗНАЧЕНИЕ(Перечисление.ИсполнителиВСтационаре.ВыполняетсяМедсестрой))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	тбУсловияПребывания.тзНачалоПериода КАК тзНачалоПериода,
	               |	тбУсловияПребывания.тзОкончаниеПериода КАК тзОкончаниеПериода,
	               |	тбУсловияПребывания.тзДляРасчета КАК тзДляРасчета,
	               |	тбУсловияПребывания.Регистратор КАК Регистратор,
	               |	тбУсловияПребывания.Период КАК Период,
	               |	тбУсловияПребывания.Прейскурант КАК Прейскурант,
	               |	тбУсловияПребывания.Полис КАК Полис
	               |ПОМЕСТИТЬ тбУсловияПребыванияСв
	               |ИЗ
	               |	тбУсловияПребывания КАК тбУсловияПребывания
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(тбУсловияПребывания.Прейскурант, &Прейскурант) КАК Прейскурант,
	               |	ЕСТЬNULL(тбУсловияПребывания.Полис, ЗНАЧЕНИЕ(Справочник.СтраховыеПолисы.ПустаяСсылка)) КАК Полис,
	               |	ТаблицаСводная.Врач КАК Врач,
	               |	ТаблицаСводная.Номенклатура КАК Номенклатура,
	               |	ТаблицаСводная.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ТаблицаСводная.Количество КАК Количество,
	               |	ТаблицаСводная.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	ТаблицаНоменклатурыПоДействиям КАК ТаблицаСводная
	               |		ЛЕВОЕ СОЕДИНЕНИЕ тбУсловияПребыванияСв КАК тбУсловияПребывания
	               |		ПО (ТаблицаСводная.Период МЕЖДУ тбУсловияПребывания.тзНачалоПериода И тбУсловияПребывания.тзОкончаниеПериода)
	               |ГДЕ
	               |	ТаблицаСводная.Количество > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ тбУсловияПребыванияСв";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),Выборка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУсловиям(МВТ,ТаблицаДанных)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("Клиент",Клиент);
	Запрос.УстановитьПараметр("Филиал",ФилиалТекущий);
	Запрос.УстановитьПараметр("ДатаВыписки",ДатаВыписки);
	Запрос.УстановитьПараметр("ДатаНачала",НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания",ОкончаниеПериода);
	Запрос.УстановитьПараметр("Прейскурант",ОсновнойПрейскурант);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	тбУсловияПребывания.Прейскурант,
	               |	тбУсловияПребывания.Полис,
	               |	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Врач,
	               |	тбУсловияПребывания.Номенклатура,
	               |	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры,
	               |	СУММА(тбУсловияПребывания.тзДляРасчета) КАК Количество,
	               |	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения
	               |ИЗ
	               |	тбУсловияПребывания КАК тбУсловияПребывания
	               |ГДЕ
	               |	тбУсловияПребывания.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	тбУсловияПребывания.Прейскурант,
	               |	тбУсловияПребывания.Полис,
	               |	тбУсловияПребывания.Номенклатура";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),Выборка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧПоУслугам(ТаблицаДанных)
	
	ВрачПоУмолчанию = МедицинскаяДеятельностьКОРП.ПолучитьПараметрМедДеятельности("ВрачПоУмолчаниюСтационара");
	
	ТаблицаДанных.Свернуть("Прейскурант, Полис, Врач, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения","Количество");
	
	Если ТаблицаДанных.Количество() > 0 Тогда 
		СписокНоменклатуры.Очистить();
		Для Каждого стрТ Из ТаблицаДанных Цикл 
			НоваяСтрока = СписокНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,стрТ);
			НоваяСтрока.Цена = Ценообразование.ПолучитьЦену(НоваяСтрока.Прейскурант, НоваяСтрока.Номенклатура,ТекущаяДата(), НоваяСтрока.ХарактеристикаНоменклатуры, НоваяСтрока.Номенклатура.ЕдиницаХраненияОстатков).Цена;	
			НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
			Если Не ЗначениеЗаполнено(НоваяСтрока.Врач) Тогда
				НоваяСтрока.Врач = ВрачПоУмолчанию;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоПриемам(МассивПриемов)
	
	СписокМатериалов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриемМатериалы.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА ПриемМатериалы.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	               |			ТОГДА ПриемМатериалы.Ссылка.СкладМатериалов
	               |		ИНАЧЕ ПриемМатериалы.Склад
	               |	КОНЕЦ КАК Склад,
	               |	ПриемМатериалы.Работа КАК Работа,
	               |	ПриемМатериалы.Номенклатура КАК Номенклатура,
	               |	ПриемМатериалы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ПриемМатериалы.Количество КАК Количество,
	               |	ПриемМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ПриемМатериалы.Коэффициент КАК Коэффициент,
	               |	ПриемМатериалы.ВходитВСтоимость КАК ВходитВСтоимость,
	               |	ПриемМатериалы.СерияНоменклатуры КАК СерияНоменклатуры
	               |ИЗ
	               |	Документ.Прием.Материалы КАК ПриемМатериалы
	               |ГДЕ
	               |	ПриемМатериалы.Ссылка В(&МассивПриемов)";
	
	Запрос.УстановитьПараметр("МассивПриемов", МассивПриемов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СписокМатериалов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если Не Выборка.ВходитВСтоимость Тогда 
			НоваяСтрока.Цена = Ценообразование.ПолучитьЦену(ОсновнойПрейскурант, НоваяСтрока.Номенклатура,ТекущаяДата(), НоваяСтрока.ХарактеристикаНоменклатуры, НоваяСтрока.Номенклатура.ЕдиницаХраненияОстатков).Цена;	
			НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;	
		КонецЕсли;
	КонецЦикла;  
		
КонецПроцедуры

&НаСервере 
Процедура СоздатьДокументыОУПоПриемам(мсДокументов, ТаблицаОУ);
	
	ДокументОУ = Документы.ОказаниеУслуг.ПустаяСсылка();
	СообщениеПользователю = Новый СообщениеПользователю;
	
	ТаблицаПП = ТаблицаОУ.Скопировать();
	ТаблицаПП.Свернуть("Прейскурант,Полис");
	МассивДанных = Новый Массив;
	мсПриемы = Новый Массив;

	Комментарий = "Расчет за период с " + Формат(НачалоПериода,"ДЛФ=") + " по " + Формат(ОкончаниеПериода,"ДЛФ=");

	Если ТаблицаПП.Количество() > 0 Тогда 
		Для Каждого стрПП Из ТаблицаПП Цикл 
	
			стрПриемов = ТаблицаОУ.НайтиСтроки(Новый Структура("Прейскурант,Полис", стрПП.Прейскурант,стрПП.Полис));
			Если стрПриемов.Количество() > 0 Тогда 
				Для Каждого эл Из стрПриемов Цикл 
					мсПриемы.Добавить(эл.Прием);
				КонецЦикла;
			КонецЕсли;
			МассивДанных.Добавить(Новый Структура("Клиент,Прейскурант,Полис,Комментарий,мсПриемы",Клиент,стрПП.Прейскурант,стрПП.Полис,Комментарий,мсПриемы));

			НовоеОУ = Документы.ОказаниеУслуг.СоздатьДокумент();
			НовоеОУ.Заполнить(МассивДанных);
			РаботаСДокументамиКлиентСервер.РасчитатьСуммуДокументаОказанияУслуг(НовоеОУ);
			
			Если НовоеОУ.Работы.Количество() > 0 Тогда 
				//Попытка 
				//	НовоеОУ.Записать(РежимЗаписиДокумента.Проведение);
				//	ДокументОУ = НовоеОУ.Ссылка;
				//Исключение
					Попытка
						НовоеОУ.Записать(РежимЗаписиДокумента.Запись);
						ДокументОУ = НовоеОУ.Ссылка;
						//СообщениеПользователю.Текст = "Документ оказания услуг не проведен!";
					Исключение
						СообщениеПользователю.Текст = "Не удалось записать документ оказания услуг!";
					КонецПопытки;
				//КонецПопытки;
				Иначе 
					СообщениеПользователю.Текст = "Не удалось записать услуги!";
				КонецЕсли;
				
			Если СообщениеПользователю.Текст <> "" Тогда 
				СообщениеПользователю.Сообщить();
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДокументОУ) Тогда 
				мсДокументов.Добавить(ДокументОУ);
			КонецЕсли;

		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере 
Процедура СоздатьДокументыОУ(мсДокументов, ТаблицаОУ);
	
	ДокументОУ = Документы.ОказаниеУслуг.ПустаяСсылка();
	СозданНовыйДокумент = Ложь;
	СообщениеПользователю = Новый СообщениеПользователю;
	
	ТаблицаПП = ТаблицаОУ.Скопировать();
	ТаблицаПП.Свернуть("Прейскурант,Полис");
	
	Для Каждого стрПП Из ТаблицаПП Цикл 

		СозданНовыйДокумент = Истина;
		НовоеОУ = Документы.ОказаниеУслуг.СоздатьДокумент();
		НовоеОУ.Дата = ТекущаяДата();
		НовоеОУ.Филиал = ФилиалТекущий;
		
		НовоеОУ.ВидОперации = Перечисления.ВидыОперацийОказанияУслуг.ПродажаКлиенту;
		НовоеОУ.Документ = стрПП.Полис;
		НовоеОУ.Клиент = Клиент;
		НовоеОУ.Касса = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(,"ОсновнаяКасса");
		НовоеОУ.Прейскурант = стрПП.Прейскурант;
		НовоеОУ.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		НовоеОУ.Комментарий = "Расчет за период с " + Формат(НачалоПериода,"ДЛФ=") + " по " + Формат(ОкончаниеПериода,"ДЛФ=");
		
		ВыборкаУслуги = ТаблицаОУ.НайтиСтроки(Новый Структура("Прейскурант,Полис", стрПП.Прейскурант,стрПП.Полис));
		Если ВыборкаУслуги.Количество() > 0 Тогда 
			Для Каждого Эл Из ВыборкаУслуги Цикл 
				
				Если Эл.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга Тогда
					НоваяСтрока = НовоеОУ.Работы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Эл);
					СтрокиМатериалов = СписокМатериалов.НайтиСтроки(Новый Структура("Работа, Распределен", НоваяСтрока.Номенклатура, Ложь));
					Для Каждого СтрокаМатериала Из СтрокиМатериалов Цикл
						НоваяСтрокаМатериала = НовоеОУ.Материалы.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериала, СтрокаМатериала);
						НоваяСтрокаМатериала.КлючСтрокиРаботы = НоваяСтрока.КлючСтроки;
						СтрокаМатериала.Распределен = Истина;
						НовоеОУ.РучнаяКорректировкаМатериалов = Истина;
					КонецЦикла;
				Иначе
					НоваяСтрока = НовоеОУ.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Эл);
					Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
						НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ЕдиницаХраненияОстатков;
					КонецЕсли;
					НоваяСтрока.Коэффициент = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
					НоваяСтрока.БезСкладскогоУчета = Истина;
				КонецЕсли;
				
				НоваяСтрока.Цена = Эл.Цена;
				НоваяСтрока.Сумма = Эл.Количество * НоваяСтрока.Цена;
				НоваяСтрока.КлючСтроки = НоваяСтрока.НомерСтроки;
				НоваяСтрока.Сотрудник = Эл.Врач;
				
				Если ЗначениеЗаполнено(НоваяСтрока.Сотрудник)
					И Не ЗначениеЗаполнено(НовоеОУ.Сотрудник)
				Тогда
					НовоеОУ.Сотрудник = НоваяСтрока.Сотрудник;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		РаботаСДокументамиКлиентСервер.РасчитатьСуммуДокументаОказанияУслуг(НовоеОУ);

		Если НовоеОУ.Работы.Количество() > 0 Тогда 
			//Попытка 
			//	НовоеОУ.Записать(РежимЗаписиДокумента.Проведение);
			//	ДокументОУ = НовоеОУ.Ссылка;
			//Исключение
				Попытка
					НовоеОУ.Записать(РежимЗаписиДокумента.Запись);
					ДокументОУ = НовоеОУ.Ссылка;
					//СообщениеПользователю.Текст = "Документ оказания услуг не проведен!";
				Исключение
					СообщениеПользователю.Текст = "Не удалось записать документ оказания услуг!";
				КонецПопытки;
			//КонецПопытки;
		Иначе 
			СообщениеПользователю.Текст = "Не удалось записать услуги!";
		КонецЕсли;
			
		Если СообщениеПользователю.Текст <> "" Тогда 
			СообщениеПользователю.Сообщить();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументОУ) И СозданНовыйДокумент Тогда 
			мсДокументов.Добавить(ДокументОУ);
		КонецЕсли;
			
	КонецЦикла;
	
	// После распределения материалов снимаем флаг
	Для Каждого СтрокаМатериалов Из СписокМатериалов Цикл
		СтрокаМатериалов.Распределен = Ложь;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОказанныеУслуги(Команда)
	
	СоздатьОУ = Истина;
	
	Если Не ЗначениеЗаполнено(Клиент) Тогда 
		Предупреждение("Для создания документов выберите клиента");
		СоздатьОУ = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда 
		Предупреждение("Для создания документов укажите начало периода");
		СоздатьОУ = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОкончаниеПериода) Тогда 
		ОкончаниеПериода = ТекущаяДата();
	КонецЕсли;
	
	Если СоздатьОУ Тогда 
		Если ПроверитьНаличиеОУ() Тогда
			Ответ = Вопрос("В выбранный период уже созданы документы оказания услуг. Продолжить? ",РежимДиалогаВопрос.ОКОтмена, ,КодВозвратаДиалога.Отмена,"Создание документов оказания услуг");
			Если Ответ = КодВозвратаДиалога.ОК Тогда
				ЗаполнитьОказанныеУслугиНаСервере();
			КонецЕсли;
		Иначе 
			ЗаполнитьОказанныеУслугиНаСервере();
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьНаличиеОУ()
	
	Запрос = НОвый Запрос("ВЫБРАТЬ
	                      |	ПериодыПроведенныхОбщихРасчетов.Клиент
	                      |ИЗ
	                      |	РегистрСведений.ПериодыПроведенныхОбщихРасчетов КАК ПериодыПроведенныхОбщихРасчетов
	                      |ГДЕ
	                      |	ПериодыПроведенныхОбщихРасчетов.Филиал = &Филиал
	                      |	И ПериодыПроведенныхОбщихРасчетов.Клиент = &Клиент
	                      |	И (&ДатаНачала МЕЖДУ ПериодыПроведенныхОбщихРасчетов.ДатаНачала И ПериодыПроведенныхОбщихРасчетов.ДатаОкончания
	                      |			ИЛИ &ДатаОкончания МЕЖДУ ПериодыПроведенныхОбщихРасчетов.ДатаНачала И ПериодыПроведенныхОбщихРасчетов.ДатаОкончания
	                      |			ИЛИ &ДатаНачала <= ПериодыПроведенныхОбщихРасчетов.ДатаНачала
	                      |				И &ДатаОкончания >= ПериодыПроведенныхОбщихРасчетов.ДатаОкончания)");
	Запрос.УстановитьПараметр("Филиал",ФилиалТекущий);						  
	Запрос.УстановитьПараметр("Клиент",Клиент);	
	Запрос.УстановитьПараметр("ДатаНачала",НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания",ОкончаниеПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЗаполнитьРегистрПериодом(ДокументОУ)
	
	НоваяЗапись = РегистрыСведений.ПериодыПроведенныхОбщихРасчетов.СоздатьМенеджерЗаписи();
	НоваяЗапись.Филиал 		  = ФилиалТекущий;	
	НоваяЗапись.Клиент 		  = Клиент;
	НоваяЗапись.ДатаНачала 	  = НачалоПериода;
	НоваяЗапись.ДатаОкончания = ОкончаниеПериода;
	НоваяЗапись.ОказаниеУслуг = ДокументОУ;
	НоваяЗапись.Записать();
	
КонецФункции


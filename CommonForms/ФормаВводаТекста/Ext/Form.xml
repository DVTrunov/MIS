			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникСоставныеФразы.Ссылка КАК Ссылка,
	СправочникСоставныеФразы.ВерсияДанных КАК ВерсияДанных,
	СправочникСоставныеФразы.ПометкаУдаления КАК ПометкаУдаления,
	СправочникСоставныеФразы.Предопределенный КАК Предопределенный,
	СправочникСоставныеФразы.Родитель КАК Родитель,
	СправочникСоставныеФразы.Наименование КАК Наименование,
	СправочникСоставныеФразы.Текст КАК Текст,
	СправочникСоставныеФразы.Пользователь КАК Пользователь,
	СправочникСоставныеФразы.Параметр КАК Параметр
ИЗ
	Справочник.СоставныеФразы КАК СправочникСоставныеФразы
ГДЕ
	(СправочникСоставныеФразы.Параметр = &amp;Параметр
			ИЛИ СправочникСоставныеФразы.Параметр = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыHTML.ПустаяСсылка)
			ИЛИ СправочникСоставныеФразы.Параметр = НЕОПРЕДЕЛЕНО
			ИЛИ СправочникСоставныеФразы.Параметр В
				(ВЫБРАТЬ
					ПараметрыHTMLПакетыСоставныхФраз.Пакет
				ИЗ
					ПланВидовХарактеристик.ПараметрыHTML.ПакетыСоставныхФраз КАК ПараметрыHTMLПакетыСоставныхФраз
				ГДЕ
					ПараметрыHTMLПакетыСоставныхФраз.Ссылка = &amp;Параметр))
	И (СправочникСоставныеФразы.Пользователь = &amp;Пользователь
			ИЛИ СправочникСоставныеФразы.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
	И НЕ СправочникСоставныеФразы.ПометкаУдаления</QueryText>
				<MainTable>Catalog.СоставныеФразы</MainTable>
				<AutoSaveUserSettings>false</AutoSaveUserSettings>
				<ListSettings>
					<dcsset:filter>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">ПометкаУдаления</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>

&НаКлиенте
Процедура КомандаОК(Команда)
	
	СкрытьОшибку();
	
	// 1. Проверка на заполненность
	Если ПустаяСтрока(Пароль) Тогда
		ПоказатьОшибку("Пароль не может быть пустым.");
		Возврат;
	КонецЕсли;
	
	// 2. Проверка совпадения паролей (ТОЛЬКО если включены звездочки)
	Если Элементы.Пароль.РежимПароля Тогда
		Если Пароль <> ПодтверждениеПароля Тогда
			ПоказатьОшибку("Введенные пароли не совпадают.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// 3. Проверка по правилам
	Если СтрДлина(Пароль) < 8 Тогда
		ПоказатьОшибку("Пароль слишком короткий. Минимум 8 символов.");
		Возврат;
	КонецЕсли;
	
	// Дальше идет запись...
	Попытка
		УстановитьНовыйПарольНаСервере(Пароль);
		ПоказатьОповещениеПользователя("Успешно", , "Пароль изменен");
		Закрыть();
	Исключение
		ПоказатьОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры
&НаКлиенте
Процедура КомандаОтмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибку(ТекстОшибки)
	// Делаем красную надпись видимой и подставляем текст
	Элементы.ДекорацияОшибка.Заголовок = ТекстОшибки;
	Элементы.ДекорацияОшибка.Видимость = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СкрытьОшибку()
	Элементы.ДекорацияОшибка.Видимость = Ложь;
КонецПроцедуры  
&НаСервереБезКонтекста
Процедура УстановитьНовыйПарольНаСервере(Знач НовыйПароль)
	
	// Получаем текущего пользователя БД
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение "Не удалось определить текущего пользователя информационной базы.";
	КонецЕсли;
	
	// Проверим, не запрещено ли ему менять пароль
	Если ПользовательИБ.ЗапрещеноИзменятьПароль Тогда
		ВызватьИсключение "Вам запрещено изменять пароль. Обратитесь к администратору.";
	КонецЕсли;
	
	ПользовательИБ.Пароль = НовыйПароль;
	ПользовательИБ.Записать();
	
	// Если у вас в МИС есть регистры сведений или реквизиты в справочнике Пользователи 
	// типа "ДатаПоследнейСменыПароля" или "ПотребоватьСменуПароляПриВходе", 
	// их нужно обновить здесь. Для записи в справочник может потребоваться ПривилегированныйРежим.
	// 
	// УстановитьПривилегированныйРежим(Истина);
	// ОбновитьДопДанныеПользователяВМис();
	// УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСкрытьПароль(Команда)
	// Инвертируем режим пароля (были звездочки - станет текст, и наоборот)
	Элементы.Пароль.РежимПароля = Не Элементы.Пароль.РежимПароля;
	
	// Если пароль видим (РежимПароля = Ложь), блокируем поле подтверждения
	Элементы.ПодтверждениеПароля.Доступность = Элементы.Пароль.РежимПароля;
	
	// Очищаем поле подтверждения, если перешли в открытый режим 
	// (чтобы там не висели старые звездочки)
	Если Не Элементы.Пароль.РежимПароля Тогда
		ПодтверждениеПароля = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти // ЗаполнитьСписокДействийКЭШ

// ЗаданияНаДень - Выборка из запроса.
&НаСервереБезКонтекста
Функция ОстаткиВыполненияНазначений(Дата, ЗаданияНаДень)
	
	// Отбираю те назначения, по которым можно проверить, не выполнено ли общее количество.
	ЗавершаемыеНазначения = Новый ТаблицаЗначений;
	ЗавершаемыеНазначения.Колонки.Добавить("ИдентификаторДействия");
	ЗавершаемыеНазначения.Колонки.Добавить("Пациент");
	ЗавершаемыеНазначения.Колонки.Добавить("ДокументИзмененияРежима");
	ЗавершаемыеНазначения.Колонки.Добавить("ВсегоНазначено", Новый ОписаниеТипов("Число"));
	ЗавершаемыеНазначения.Колонки.Добавить("ОстатосьВыполнить", Новый ОписаниеТипов("Число"));
	Пока ЗаданияНаДень.Следующий() Цикл
		Если ЗначениеЗаполнено(ЗаданияНаДень.ВсегоНазначено)
			И ЗначениеЗаполнено(ЗаданияНаДень.ИдентификаторДействия)
		Тогда
			ЗаполнитьЗначенияСвойств(ЗавершаемыеНазначения.Добавить(), ЗаданияНаДень);
		КонецЕсли;
	КонецЦикла;
	ЗавершаемыеНазначения.ЗагрузитьКолонку(ЗавершаемыеНазначения.ВыгрузитьКолонку("ВсегоНазначено"), "ОстатосьВыполнить");
	
	Если ЗавершаемыеНазначения.Количество() <> 0 Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата", НачалоДня(Дата)-1);
		Запрос.УстановитьПараметр("Клиенты", ЗавершаемыеНазначения.ВыгрузитьКолонку("Пациент"));
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыполнениеДействийСтационара.ИдентификаторЭлемента КАК ИдентификаторДействия,
		|	ВыполнениеДействийСтационара.Клиент,
		|	СУММА(ВыполнениеДействийСтационара.Количество) КАК Количество,
		|	ВыполнениеДействийСтационара.Документ КАК ДокументИзмененияРежима
		|ИЗ
		|	РегистрСведений.ВыполнениеДействийСтационара КАК ВыполнениеДействийСтационара
		|ГДЕ
		|	ВыполнениеДействийСтационара.ДатаВремяВыполнения <= &Дата
		|	И ВыполнениеДействийСтационара.Клиент В(&Клиенты)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыполнениеДействийСтационара.ИдентификаторЭлемента,
		|	ВыполнениеДействийСтационара.Клиент,
		|	ВыполнениеДействийСтационара.Документ"
		;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			мсСтр = ЗавершаемыеНазначения.НайтиСтроки(Новый Структура("ИдентификаторДействия, Пациент", Выборка.ИдентификаторДействия, Выборка.Клиент));
			Для Каждого СтрокаНазначния Из мсСтр Цикл
				СтрокаНазначния.ОстатосьВыполнить = СтрокаНазначния.ВсегоНазначено - Выборка.Количество;	
			КонецЦикла;												
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЗавершаемыеНазначения;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтруктуруОтбора()
	
	Если ТипЗнч(СтруктураОтбора) <> Тип("Структура") Тогда 
		СтруктураОтбора = Новый Структура;
	Иначе 
		СтруктураОтбора.Очистить();
	КонецЕсли;
	
	Для Каждого ЭлементФормы Из Элементы.ГруппаОтборы.ПодчиненныеЭлементы Цикл 
		Если ТипЗнч(ЭлементФормы) <> Тип("КнопкаФормы")
			И ЗначениеЗаполнено(ЭтотОбъект[ЭлементФормы.Имя]) 
			И ЭлементФормы.Имя <> "ДатаПросмотра" 
			И ЭлементФормы.Имя <> "ПоказыватьПоПациентам"
		Тогда 
			СтруктураОтбора.Вставить(ЭлементФормы.Имя, ЭтотОбъект[ЭлементФормы.Имя]);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДействиеСтационараПриИзменении(Элемент)
	ЗаполнитьСписокДействий();
КонецПроцедуры

&НаКлиенте
Процедура ПациентПриИзменении(Элемент)
	
	Если	ЗначениеЗаполнено(Пациент) И Не ПоказыватьПоПациентам
		Или Не ЗначениеЗаполнено(Пациент) И ПоказыватьПоПациентам
	Тогда
		ПоказыватьПоПациентам(Неопределено);
	КонецЕсли;
	
	ЗаполнитьСписокДействий();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуСортировки()
	
	СтрокаСортировки = "";
	
	Для Каждого эл Из Элементы.ГруппаСортировки.ПодчиненныеЭлементы Цикл 
		Если ЭтаФорма[эл.Имя] Тогда 
			СтрокаСортировки = СтрокаСортировки + СтрЗаменить(эл.Имя,"Сортировка","") + ",";		
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(СтрокаСортировки) > 0 Тогда 
		СтрокаСортировки = СокрЛП(СтрЗаменить(СтрокаСортировки + ")",",)",""));
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СортировкаВидДействияПриИзменении(Элемент)
	ЗаполнитьСписокДействий();
КонецПроцедуры

&НаКлиенте
Процедура СортировкаДействиеСтационараПриИзменении(Элемент)
	ЗаполнитьСписокДействий();
КонецПроцедуры

&НаКлиенте
Процедура СортировкаПациентПриИзменении(Элемент)
	ЗаполнитьСписокДействий();
КонецПроцедуры

&НаСервереБезконтекста
Функция ПолучитьКомментарийКлиента(Клиент)
	
	Выб = РегистрыСведений.ДополнительнаяИнформацияПоКлиентам.Выбрать(Новый Структура("Клиент",Клиент));
	Если Выб.Следующий() Тогда 
		Возврат Выб.ПолучитьМенеджерЗаписи().Комментарий;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОтменитьВыполнение(Команда)
	
	ТекущиеДанные = Элементы.СписокДействий.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокДействий.ТекущаяСтрока;
		ПараметрыФормы = Новый Структура("ДатаВыполнения,ИдентификаторЭлемента", ДатаПросмотра,Новый УникальныйИдентификатор(ТекущиеДанные.ИдентификаторДействия));
		ФормаДанныеВыполнения = ПолучитьФорму("Документ.ДействияЗаСутки.Форма.ФормаПросмотраДействий",ПараметрыФормы);
		ФормаДанныеВыполнения.ОткрытьМодально();
		ЗаполнитьСписокДействийКЭШ();
		ЗаполнитьСписокДействий();
		
		Элементы.СписокДействий.ТекущаяСтрока = ТекущаяСтрока;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКомментарий(Команда)
	
	Если ПоказыватьПоПациентам Тогда 
		Клиент = Пациент;
	Иначе  
		Клиент = Элементы.СписокДействий.ТекущиеДанные.Пациент;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура("Клиент",Клиент);

	ФормаКомментария = ПолучитьФорму("РегистрСведений.ДополнительнаяИнформацияПоКлиентам.ФормаЗаписи",ПараметрыФормы);	
	ФормаКомментария.ОткрытьМодально();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПервичныйПрием(ДокументИзмененияРежима)
	
	Если ТипЗнч(ДокументИзмененияРежима) = Тип("ДокументСсылка.Прием") Тогда 
		ПервичныйПрием = ДокументИзмененияРежима.ПервичныйПрием;
	ИначеЕсли ТипЗнч(ДокументИзмененияРежима) = Тип("ДокументСсылка.ИзменениеРежима") Тогда 
		ПервичныйПрием = ДокументИзмененияРежима.ДокументОснование.ПервичныйПрием;
	Иначе 
		ПервичныйПрием = Документы.Прием.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ПервичныйПрием;
	
КонецФункции

&НаКлиенте
Процедура КомментарийПоКлиентуПриИзменении(Элемент)
	
	Если ПоказыватьПоПациентам Тогда 
		Клиент = Элементы.СписокПациентов.ТекущиеДанные.Пациент;
	Иначе 
		Клиент = Элементы.СписокДействий.ТекущиеДанные.Пациент;
	КонецЕсли;
	
	Если Клиент <> Неопределено Тогда 
		КомментарийПоКлиентуПриИзмененииСервер(Клиент,КомментарийПоПациенту);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура КомментарийПоКлиентуПриИзмененииСервер(Клиент,КомментарийПоПациенту)
	
	НаборЗаписей = РегистрыСведений.ДополнительнаяИнформацияПоКлиентам.Выбрать(Новый Структура("Клиент",Клиент));
	
	Если НаборЗаписей.Следующий() Тогда 
		ЗаписьРегистра = НаборЗаписей.ПолучитьМенеджерЗаписи();
       	Если СокрЛП(КомментарийПоПациенту) <> "" Тогда 
			ЗаписьРегистра.Комментарий = КомментарийПоПациенту;
			ЗаписьРегистра.Записать(Истина);
		Иначе 
			ЗаписьРегистра.Удалить();
		КонецЕсли;
	Иначе 
	    ЗаписьРегистра = РегистрыСведений.ДополнительнаяИнформацияПоКлиентам.СоздатьМенеджерЗаписи();
	    ЗаписьРегистра.Период = ТекущаяДата();
	    ЗаписьРегистра.Клиент = Клиент;
	    ЗаписьРегистра.Комментарий = КомментарийПоПациенту;
		ЗаписьРегистра.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры


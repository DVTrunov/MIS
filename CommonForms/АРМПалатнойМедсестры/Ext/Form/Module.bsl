&НаКлиенте
Перем мНеАктивизироватьСтроку;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Изменено Макеев 02-12-2025
	ПериодичностьАвтообновленияНазначений = УправлениеНастройкамиМедицинскогоУчета.ПолучитьПараметрУчетнойПолитики("Стационар_ПериодичностьАвтообновленияАРМПалатной");
	
	ВосстановитьНастройкиФормы();
	ДатаПросмотра = ТекущаяДата();
	
	Филиал = УправлениеНастройками.ПолучитьФилиалПоУмолчаниюПользователя();
	
	Если Не ЗначениеЗаполнено(СкладСписания) Тогда
		СкладСписания = УправлениеНастройками.ПолучитьЗначениеСотрудникаПоУмолчанию(ПараметрыСеанса.ТекущийПользователь.Сотрудник,"ОсновнойСкладМатериалов");
		Если Не ЗначениеЗаполнено(СкладСписания) Тогда
			УправлениеНастройками.ПолучитьЗначениеСотрудникаПоУмолчанию(ПараметрыСеанса.ТекущийПользователь.Сотрудник,"ОсновнойСкладТоваров");
		КонецЕсли;
	КонецЕсли;
	
	НастроитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Изменено Макеев 02-12-2025 (
	ЗаполнитьСписокДействий();
	мНеАктивизироватьСтроку = Ложь;
	
	Если ПериодичностьАвтообновленияНазначений > 0 Тогда
		ПодключитьОбработчикОжидания("ОбновитьНазначенияОбработчикОжидания", ПериодичностьАвтообновленияНазначений * 60);
	КонецЕсли;
	
	ОбновитьНазначенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, СтандартнаяОбработка)
	
	Если Не ЗавершениеРаботы Тогда
		
		НастройкиФормы = Новый Структура;
		НастройкиФормы.Вставить("СкладСписания", СкладСписания);
		
		СохранитьНастройкиФормы(НастройкиФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ScanData" Тогда
		Если ВводДоступен() Тогда
			ТипШК = Неопределено;
			РаботаСТорговымОборудованиемКлиент.ОбработатьСобытиеСШКФормы(ЭтаФорма, Параметр, ТипШК);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.ДействияНадАнализами.Форма.ФормаДокумента" Тогда
		Для Каждого Значение Из ВыбранноеЗначение Цикл
			ПараметрыОтбора = Новый Структура("Пациент, ДействиеСтационара", Значение.Клиент, Значение.Номенклатура);
			СтрокиДействий = СписокДействий.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаДейтсвия Из СтрокиДействий Цикл
				ОбработкаВыполненияДействия(СтрокаДейтсвия);	
			КонецЦикла;  	
		КонецЦикла; 	
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройкиФормы(НастройкиФормы)
	
	Для Каждого Настройка Из НастройкиФормы Цикл
		ХранилищеПользовательскихНастроекОтчетов.Сохранить("ФормаАРМПалатнойМедсестры", Настройка.Ключ, 
															Настройка.Значение);
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиФормы()
	
	СкладСписания = ХранилищеПользовательскихНастроекОтчетов.Загрузить("ФормаАРМПалатнойМедсестры", "СкладСписания");
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПросмотраПриИзменении(Элемент)

	мНеАктивизироватьСтроку = Истина;
	
	Если Элементы.СписокПациентов.ТекущиеДанные <> Неопределено Тогда
		ТекущийПациент = Элементы.СписокПациентов.ТекущиеДанные.Пациент;
	КонецЕсли;
	
	СписокПациентов.Очистить();
	СписокДействийКэш.Очистить();
	СписокДействий.Очистить();
	
	ПриИзмененииДатаПросмотра();
	
	Если ЗначениеЗаполнено(ТекущийПациент) Тогда
		мсСтр = СписокПациентов.НайтиСтроки(Новый Структура("Пациент", ТекущийПациент));
		Если мсСтр.Количество() <> 0 Тогда 
			Элементы.СписокПациентов.ТекущаяСтрока = мсСтр[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
	мНеАктивизироватьСтроку = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииДатаПросмотра()
	
	ОбновитьНазначенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПросмотраРегулирование(Элемент, Направление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДатаПросмотра = ДатаПросмотра + Направление * 86400;
	ДатаПросмотраПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ДатаПросмотраОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДатаПросмотра = ТекущаяДата();
	ДатаПросмотраПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьПоПациентам(Команда)
	
	Элементы.ПоказыватьПоПациентам.Пометка = Не Элементы.ПоказыватьПоПациентам.Пометка;
	ОбщегоНазначенияСервер.НастройкиВХранилище("АРММедсестры", "ПоказыватьПоПациентам", Элементы.ПоказыватьПоПациентам.Пометка);
	Элементы.ГруппаПациенты.Видимость = Элементы.ПоказыватьПоПациентам.Пометка;	
	Элементы.ГруппаИнформацияПациента.Видимость = Элементы.ПоказыватьПоПациентам.Пометка;	
	Элементы.СписокДействийПациент.Видимость = Не Элементы.ПоказыватьПоПациентам.Пометка;	
	Элементы.СписокДействийМедицинскаяКарта.Видимость = Не Элементы.ПоказыватьПоПациентам.Пометка;	
	
	ПоказыватьПоПациентам = Элементы.ПоказыватьПоПациентам.Пометка;
	Если Не ПоказыватьПоПациентам Тогда 
		Пациент = Неопределено;
	Иначе 
		ЗаполнитьСписокПациентов();
	КонецЕсли;
	ЗаполнитьСписокДействий();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьЭлементов()

	ПоказыватьПоПациентам = ОбщегоНазначенияСервер.НастройкиИзХранилища("АРММедсестры", "ПоказыватьПоПациентам");
	ПоказыватьПоПациентам = ?(ПоказыватьПоПациентам = Неопределено, Ложь, ПоказыватьПоПациентам);

	Элементы.ПоказыватьПоПациентам.Пометка = ПоказыватьПоПациентам;
	Элементы.ГруппаПациенты.Видимость = ПоказыватьПоПациентам;	
	Элементы.ГруппаИнформацияПациента.Видимость = ПоказыватьПоПациентам;	
	Элементы.СписокДействийПациент.Видимость = Не ПоказыватьПоПациентам;	
	Элементы.СписокДействийМедицинскаяКарта.Видимость = Не ПоказыватьПоПациентам;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДействий()
	
	Если СписокДействийКэш.Количество() > 0 Тогда 
		
		ЗаполнитьСтруктуруОтбора();
		ЗаполнитьСтрокуСортировки();
		
		Если СтрДлина(СтрокаСортировки) > 0 Тогда 
			СписокДействийКэш.Сортировать(СтрокаСортировки);
		КонецЕсли;
		
		Если СтруктураОтбора.Количество() > 0 Тогда  
			СтрокиПоОтбору = СписокДействийКэш.НайтиСтроки(СтруктураОтбора);
		Иначе 
			СтрокиПоОтбору = СписокДействийКэш.Выгрузить();
		КонецЕсли;
		
		СписокДействий.Очистить();
		Если СтрокиПоОтбору.Количество() > 0 Тогда
			Для Каждого стрОтбора Из СтрокиПоОтбору Цикл 
				ЗаполнитьЗначенияСвойств( СписокДействий.Добавить(),стрОтбора);
			КонецЦикла;
		КонецЕсли;
		СписокДействий.Сортировать("ДействиеСтационара");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПациентовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено 
		И ЗначениеЗаполнено(ТекущиеДанные.Пациент)
		И Не мНеАктивизироватьСтроку
	Тогда 
		
		Пациент = ТекущиеДанные.Пациент;
		ДанныеПоПациенту = СписокПациентов.НайтиСтроки(Новый Структура("Пациент",Пациент));
		
		Если ДанныеПоПациенту.Количество() > 0 Тогда 
			
			МедицинскаяКарта	= ДанныеПоПациенту[0].МедицинскаяКарта;
			ДатаРождения 		= Формат(ДанныеПоПациенту[0].ДатаРождения,"ДФ=dd.MM.yyyy");
			ДиагнозПоступления	= ДанныеПоПациенту[0].ДиагнозПоступления;
			ДатаПоступления 	= Формат(ДанныеПоПациенту[0].ДатаПоступления,"ДФ=dd.MM.yyyy");		
			
		КонецЕсли;
		КомментарийПоПациенту = ПолучитьКомментарийКлиента(Пациент);
		ПациентПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПациентов()
	
	// Изменено Макеев 02-12-2025 (
	
	СписокПациентов.Очистить();
	
	ДополнительныеПоляЗапроса = Новый СписокЗначений;
	ДополнительныеПоляЗапроса.Добавить("Пациент", "Клиент");
	ДополнительныеПоляЗапроса.Добавить("ДатаРождения", "Клиент.ДатаРождения");
	ДополнительныеПоляЗапроса.Добавить("ДиагнозПоступления", "ДокументПоступления.ДокументОбращения.ДиагнозПоступления");
	ДополнительныеПоляЗапроса.Добавить("МедицинскаяКарта", "ДокументПоступления.ДокументОбращения.МедицинскаяКарта");
	
	ДополнительныеУсловия = Новый Массив;
	
	Если Не омг_Отделения.Количество() = 0 Тогда
		ТекстЗапроса = "КлиентыСтационара.КойкоМесто.Владелец.Подразделение В (&Подразделения)";
		ПараметрЗапроса = Новый Структура("Подразделения", омг_Отделения);
		ДополнительныеУсловия.Добавить(Новый Структура("Текст, Параметры", ТекстЗапроса, ПараметрЗапроса));
	КонецЕсли;
	
	Если Не омг_Филиалы.Количество() = 0 Тогда
		ТекстЗапроса = "Регистратор.Филиал В (&Филиалы)";
		ПараметрЗапроса = Новый Структура("Филиалы", омг_Филиалы);
		ДополнительныеУсловия.Добавить(Новый Структура("Текст, Параметры", ТекстЗапроса, ПараметрЗапроса));
	КонецЕсли;
	
	ТаблицаПациентов = Стационар.ПолучитьКлиентовСтационара(ДатаПросмотра, Филиал,ДополнительныеПоляЗапроса, ДополнительныеУсловия);
	
	Для Каждого СтрокаПациент Из ТаблицаПациентов Цикл
		
		ПациентСписка = СписокПациентов.Добавить();
		ЗаполнитьЗначенияСвойств(ПациентСписка, СтрокаПациент);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьДокументСписания(ДокументОснование, СписаниеТоваров)

	Если ЗначениеЗаполнено(СписаниеТоваров) Тогда
		ДокументСписания = СписаниеТоваров.ПолучитьОбъект();
	Иначе
		ДокументСписания = Документы.СписаниеТоваров.СоздатьДокумент();
	КонецЕсли;
	ДокументСписания.Товары.Очистить();
	ДокументСписания.Заполнить(ДокументОснование);
	Если ДокументСписания.Товары.Количество() = 0 Тогда
		ВызватьИсключение(НСтр("ru='В документе нет позиций для списания по складу.'"));
	КонецЕсли;

	ДокументСписания.Дата = ТекущаяДата();
	ДокументСписания.Филиал = ДокументОснование.Филиал;
	ДокументСписания.Ответственный = ОбщегоНазначения.ТекущийПользователь();
	
	ДокументСписания.Комментарий = НСтр("ru='Списание по документу " + ДокументОснование + "'");
	
	ДокументСписания.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат ДокументСписания.Ссылка;
	
КонецФункции	

&НаСервере
Функция ОтметитьВыполнениеНаСервере(СтруктураДанных)
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
		
	// Создаем документ ДействияЗаСутки
	
	// Изменения Макеев 17-12-2025 (
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ДействияЗаСутки.Ссылка КАК Ссылка,
	                      |	ДействияЗаСутки.СписаниеТоваров КАК СписаниеТоваров
	                      |ИЗ
	                      |	Документ.ДействияЗаСутки КАК ДействияЗаСутки
	                      |ГДЕ
	                      |	НЕ ДействияЗаСутки.ПометкаУдаления
	                      |	И ДействияЗаСутки.Ответственный = &Ответственный
	                      |	И ДействияЗаСутки.Филиал = &Филиал
	                      |	И НАЧАЛОПЕРИОДА(ДействияЗаСутки.Дата, ДЕНЬ) = &Дата");
	Запрос.УстановитьПараметр("Филиал",Филиал);
	Запрос.УстановитьПараметр("Ответственный", ТекущийПользователь);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда 
		ДействияЗаСуткиОбъект = Документы.ДействияЗаСутки.СоздатьДокумент();
	
		ДействияЗаСуткиОбъект.Дата  		= ТекущаяДата();
		ДействияЗаСуткиОбъект.Филиал         = Филиал;
		ДействияЗаСуткиОбъект.Ответственный = ТекущийПользователь;
	Иначе 
		ДействияЗаСуткиОбъект = Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если СтруктураДанных.Количество() > 0 Тогда 
		стрДействий = ДействияЗаСуткиОбъект.ДействияСтационара.Добавить();
	    ЗаполнитьЗначенияСвойств(стрДействий,СтруктураДанных);		
		// Изменения Макеев 13-12-2025 (
		стрДействий.Количество = СтруктураДанных.Значение;
		стрДействий.ДатаВремяВыполнения = ТекущаяДата();
		ДействияЗаСуткиОбъект.Склад = СтруктураДанных.Склад;
		Если ТипЗнч(стрДействий.ДействиеСтационара) = Тип("СправочникСсылка.Номенклатура")
			И РаботаСФормамиСервер.ЭтоМатериал(стрДействий.ДействиеСтационара)
			И Не ЗначениеЗаполнено(стрДействий.Коэффициент)
		Тогда
			стрДействий.Коэффициент = стрДействий.ЕдиницаИзмерения.Коэффициент;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		НачатьТранзакцию();
		ДействияЗаСуткиОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		СписаниеТоваров = СоздатьДокументСписания(ДействияЗаСуткиОбъект.Ссылка, ДействияЗаСуткиОбъект.СписаниеТоваров);
		
		Если Не ЗначениеЗаполнено(ДействияЗаСуткиОбъект.СписаниеТоваров) Тогда
			ДействияЗаСуткиОбъект.СписаниеТоваров = СписаниеТоваров;
			ДействияЗаСуткиОбъект.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		ОтменитьТранзакцию();
		Возврат Ложь;			
	КонецПопытки;
		
КонецФункции

&НаКлиенте
Процедура Обработчик_ПослеОтветаНаВопросОВыполненииДействия(Ответ, ТекущиеДанные) Экспорт
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаВыполненияДействия(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	
	ТекущиеДанные = Элементы.СписокДействий.ТекущиеДанные;	
	// Добавлено Макеев (
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ТекущиеДанные.ДействиеСтационара) = Тип("СправочникСсылка.Номенклатура")
		И Не РаботаСФормамиСервер.ЭтоМатериал(ТекущиеДанные.ДействиеСтационара) Тогда
		ТекстВопроса = "Выполнить действия по назначению?";
		ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеОтветаНаВопросОВыполненииДействия", ЭтаФорма, ТекущиеДанные);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да, "", КодВозвратаДиалога.Нет);
		Возврат;
	КонецЕсли;
	// )
	ОбработкаВыполненияДействия(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыполненияДействия(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДатаПросмотра <> НачалоДня(ТекущаяДата()) Тогда
		
		Если Не ЭтоДействиеТемпературногоЛиста(ТекущиеДанные.ДействиеСтационара) Тогда 
			ТекстЗаголовка = НСтр("ru='Дата просмотра не совпадает с текущей датой!'");
			ТекстВопроса = НСтр("ru='Выполнение действия будет отмечено сегодняшним днём
			|и уменьшит требуемое количество выполнения за сегодня, а не за просматриваемый день.
			|Все равно выполнить отметку выполнения?'");
			Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, 30, КодВозвратаДиалога.Отмена, ТекстЗаголовка, КодВозвратаДиалога.Отмена) = КодВозвратаДиалога.Отмена Тогда
				Возврат;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для изменения даты фактического выполнения следует вручную внести изменения в документы ""Действия медсестры за сутки""");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураДанных = Новый Структура("Документ,ИдентификаторДействия,ДействиеСтационара",ТекущиеДанные.ДокументИзмененияРежима,ТекущиеДанные.ИдентификаторДействия,ТекущиеДанные.ДействиеСтационара);
	СтруктураДанных.Вставить("Склад",СкладСписания);
	СтруктураДанных.Вставить("Клиент", ТекущиеДанные.Пациент);
	СтруктураДанных.Вставить("МедицинскаяКарта",ТекущиеДанные.МедицинскаяКарта);
	СтруктураДанных.Вставить("ПервичныйПрием",ПолучитьПервичныйПрием(ТекущиеДанные.ДокументИзмененияРежима));
	СтруктураДанных.Вставить("ВидыДействийСтационара",ТекущиеДанные.ВидДействия);
	СтруктураДанных.Вставить("ИдентификаторЭлемента",Новый УникальныйИдентификатор(ТекущиеДанные.ИдентификаторДействия));
	СтруктураДанных.Вставить("Дозировка",ТекущиеДанные.Дозировка);
	СтруктураДанных.Вставить("Количество",1);
	СтруктураДанных.Вставить("Коэффициент",ТекущиеДанные.Коэффициент);
	СтруктураДанных.Вставить("ЕдиницаИзмерения",ТекущиеДанные.ЕдиницаИзмерения);
	СтруктураДанных.Вставить("ХарактеристикаНоменклатуры", Неопределено);
	
	Если ЭтоДействиеТемпературногоЛиста(ТекущиеДанные.ДействиеСтационара) Тогда 
		
		СтруктураДанных.Вставить("ДатаПросмотра", ДатаПросмотра);
		СтруктураОтбора = Новый Структура("Пациент, ВидДействия", ТекущиеДанные.Пациент, ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Манипуляции"));	
		МсСтрокиДействияПациента = СписокДействий.НайтиСтроки(СтруктураОтбора);
		
		СоответствиеДействияСтационара = Новый Соответствие;
		Для каждого СтрокаДействияПациента Из МсСтрокиДействияПациента Цикл
			Если СоответствиеДействияСтационара.Получить(СтрокаДействияПациента.ДействиеСтационара) = Неопределено Тогда
				СоответствиеДействияСтационара.Вставить(СтрокаДействияПациента.ДействиеСтационара, 
																Новый Структура("ИдентификаторДействия, ДокументИзмененияРежима", 
																СтрокаДействияПациента.ИдентификаторДействия, СтрокаДействияПациента.ДокументИзмененияРежима));
			КонецЕсли;
		КонецЦикла;
		
		СтруктураДанных.Вставить("НазначенныеДействия", СоответствиеДействияСтационара);
		ФормаВводаЗначения = ПолучитьФорму("ОбщаяФорма.ТемпературныйЛистВводПоказателей", СтруктураДанных);
		ОткрытьФорму("ОбщаяФорма.ТемпературныйЛистВводПоказателей",СтруктураДанных,,,,, Новый ОписаниеОповещения("ОтметитьВыполнениеТЛНаСервере", ЭтаФорма, СтруктураДанных));	
	Иначе
	//Если Не ТекущиеДанные.ОтметкаВыполнения Тогда 
		Если ТекущиеДанные.ВыполнениеВводомЗначения Тогда 
			ПараметрыФормы = Новый Структура("ДействиеСтационара, ЕдиницаИзмерения, СкладСписания",ТекущиеДанные.ДействиеСтационара, ТекущиеДанные.ЕдиницаИзмерения, СкладСписания);
			ФормаВводаЗначения = ПолучитьФорму("ОбщаяФорма.ФормаПростановкиЗначения",ПараметрыФормы);
			ФормаВводаЗначения.Элементы.Значение.Заголовок = Строка(ТекущиеДанные.ДействиеСтационара);
			Значение = ФормаВводаЗначения.ОткрытьМодально();
			Если Значение = Неопределено Тогда
				// Отмена действия
				Возврат;
			КонецЕсли;
		Иначе 
			Если ТипЗнч(ТекущиеДанные.ДействиеСтационара) = Тип("СправочникСсылка.Номенклатура")
				И РаботаСФормамиСервер.ЭтоМатериал(ТекущиеДанные.ДействиеСтационара)
			Тогда 
				Если Не ЗначениеЗаполнено(СкладСписания) Тогда 
					ПоказатьПредупреждение(,"Выберите склад для проведения действий с лекарствами и другими товарно-материальными ценностями!", 30);
					Возврат;
				Иначе
					ПараметрыФормы = Новый Структура("Дозировка, ДействиеСтационара, ЕдиницаИзмерения, СкладСписания",ТекущиеДанные.Дозировка,ТекущиеДанные.ДействиеСтационара, ТекущиеДанные.ЕдиницаИзмерения, СкладСписания);
					ФормаВводаЗначения = ПолучитьФорму("ОбщаяФорма.ФормаПростановкиЗначения",ПараметрыФормы);
					ФормаВводаЗначения.Элементы.Значение.Заголовок = "Дозировка " + Строка(ТекущиеДанные.ДействиеСтационара);
					Значение = ФормаВводаЗначения.ОткрытьМодально();
					Если Значение = Неопределено Тогда
						// Отмена действия
						Возврат;
					ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
						СтруктураДанных.Вставить("ХарактеристикаНоменклатуры", Значение.ХарактеристикаНоменклатуры);
						СтруктураДанных.Вставить("СерияНоменклатуры",		   Значение.СерияНоменклатуры);
						Значение = Значение.Значение;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		СтруктураДанных.Вставить("Значение",Значение);
		Если ОтметитьВыполнениеНаСервере(СтруктураДанных) Тогда 
			// Изменено Макеев 18-12-2025 (
			ТекущиеДанные.Выполнено = ТекущиеДанные.Выполнено + 1;
			Если СтруктураДанных.ВидыДействийСтационара = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Медикаменты") Тогда
				ТекущиеДанные.омг_Введено = ТекущиеДанные.омг_Введено + Значение;
				ТекущиеДанные.Выполнено = Цел(ТекущиеДанные.РазВДень * (ТекущиеДанные.омг_Введено / (ТекущиеДанные.Дозировка * ТекущиеДанные.РазВДень)));
			КонецЕсли;
			СтрокаКЭШ = СписокДействийКэш.НайтиСтроки(Новый Структура("ИдентификаторДействия",ТекущиеДанные.ИдентификаторДействия));
			
			Если ДатаПросмотра = НачалоДня(ТекущаяДата()) Тогда
				ТекущиеДанные.ВыполненоИтог = Строка(ТекущиеДанные.Выполнено) + "/" + Строка(ТекущиеДанные.РазВДень);
			КонецЕсли;
			
			Если ТекущиеДанные.Выполнено >= ТекущиеДанные.РазВДень Тогда 
				ТекущиеДанные.ОтметкаВыполнения = Истина;
			КонецЕсли;
			
			Если СтрокаКЭШ.Количество() > 0 Тогда 
				СтрокаКЭШ[0].Выполнено = ТекущиеДанные.Выполнено;
				СтрокаКЭШ[0].ВыполненоИтог = ТекущиеДанные.ВыполненоИтог;
				СтрокаКЭШ[0].ОтметкаВыполнения = ТекущиеДанные.ОтметкаВыполнения;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокДействий(Команда)
	ЗаполнитьСписокДействий();
КонецПроцедуры

&НаКлиенте
Процедура ВидДействияПриИзменении(Элемент)
	ЗаполнитьСписокДействий();
КонецПроцедуры

#Область ЗаполнитьСписокДействийКЭШ

&НаСервере
Процедура ЗаполнитьСписокДействийКЭШ()
	
	// Изменено Макеев 18-12-2025 (
	СписокДействийКэш.Очистить();
	
	Медкарты = СписокПациентов.Выгрузить().ВыгрузитьКолонку("МедицинскаяКарта");
	
	// Сбор данных из базы
	НазначенныеДействияМедсестры = НазначенныеДействияМедсестрыПациентов(ДатаПросмотра, Медкарты, омг_Филиалы, омг_Отделения);
	ПланыЛечения = ПланыЛеченияПациентов(ДатаПросмотра, Медкарты, омг_Филиалы, омг_Отделения);
	ПланыЛечения.Колонки.Добавить("ВыполнениеВводомЗначения", Новый ОписаниеТипов("Булево"));
	
	ИдентификаторНазначений = НазначенныеДействияМедсестры.ВыгрузитьКолонку("ИдентификаторДействия");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ИдентификаторНазначений, ПланыЛечения.ВыгрузитьКолонку("ИдентификаторДействия"));
	
	ВыполнениеНазначений = ВыполнениеНазначенийПациентов(ДатаПросмотра, ИдентификаторНазначений);
	
	// Наполнение кеша режимом
	Источники = ОбщегоНазначенияКлиентСервер.НовыйМассив(НазначенныеДействияМедсестры, ПланыЛечения);
	Для Каждого Источник Из Источники Цикл
		Для Каждого СтрокаНазначение Из Источник Цикл
			
			ВыполнениеНазначения = ВыполнениеНазначений.Найти(СтрокаНазначение.ИдентификаторДействия, "ИдентификаторЭлемента");
			Выполнено = ?(ВыполнениеНазначения = Неопределено, 0, ВыполнениеНазначения.Количество);
			
			новСтр = СписокДействийКэш.Добавить();
			ЗаполнитьЗначенияСвойств(новСтр, СтрокаНазначение);
			
			новСтр.Выполнено = Выполнено;
			Если СтрокаНазначение.ВидДействия = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Медикаменты") Тогда
				новСтр.Выполнено = Цел(СтрокаНазначение.РазВДень * (новСтр.омг_Введено / (СтрокаНазначение.Дозировка * СтрокаНазначение.РазВДень)));
			КонецЕсли;
			новСтр.ВыполненоИтог = Строка(новСтр.Выполнено) + "/" + Строка(новСтр.РазВДень);
			Если новСтр.Выполнено >= новСтр.РазВДень Тогда 
				новСтр.ОтметкаВыполнения = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НазначенныеДействияМедсестрыПациентов(ДатаПросмотра, Медкарты, Филиалы, Отделения)
	
	// Изменено Макеев 03-12-2025 (
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПросмотра", ДатаПросмотра);
	Запрос.УстановитьПараметр("Медкарты", Медкарты);
	Запрос.УстановитьПараметр("ОтборПоФилиалам", Не Филиалы.Количество() = 0);
	Запрос.УстановитьПараметр("ОтборПоОтделениям", Не Отделения.Количество() = 0);
	Запрос.УстановитьПараметр("Филиалы", Филиалы);
	Запрос.УстановитьПараметр("Отделения", Отделения);
	Запрос.Текст = 			"ВЫБРАТЬ
	               			|	МАКСИМУМ(ИзменениеРежима.Ссылка) КАК Ссылка,
	               			|	ИзменениеРежима.МедицинскаяКарта КАК МедицинскаяКарта,
	               			|	ИзменениеРежима.Клиент КАК Клиент,
	               			|	КлиентыСтационараСрезПоследних.Подразделение КАК Отделение,
	               			|	КлиентыСтационараСрезПоследних.Подразделение.Филиал КАК Филиал
	               			|ПОМЕСТИТЬ ИзменениеРежима
	               			|ИЗ
	               			|	Документ.ИзменениеРежима КАК ИзменениеРежима
	               			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыСтационара.СрезПоследних(КОНЕЦПЕРИОДА(&ДатаПросмотра, ДЕНЬ), ) КАК КлиентыСтационараСрезПоследних
	               			|		ПО ИзменениеРежима.Клиент = КлиентыСтационараСрезПоследних.Клиент
	               			|			И (НЕ КлиентыСтационараСрезПоследних.Выписан)
	               			|ГДЕ
	               			|	ИзменениеРежима.МедицинскаяКарта В(&Медкарты)
	               			|	И ИзменениеРежима.Дата < КОНЕЦПЕРИОДА(&ДатаПросмотра, ДЕНЬ)
	               			|	И НЕ ИзменениеРежима.ПометкаУдаления
	               			|	И ВЫБОР
	               			|			КОГДА НЕ &ОтборПоОтделениям
	               			|				ТОГДА ИСТИНА
	               			|			ИНАЧЕ КлиентыСтационараСрезПоследних.Подразделение В (&Отделения)
	               			|		КОНЕЦ
	               			|	И ВЫБОР
	               			|			КОГДА НЕ &ОтборПоФилиалам
	               			|				ТОГДА ИСТИНА
	               			|			ИНАЧЕ КлиентыСтационараСрезПоследних.Подразделение.Филиал В (&Филиалы)
	               			|		КОНЕЦ
	               			|
	               			|СГРУППИРОВАТЬ ПО
	               			|	ИзменениеРежима.МедицинскаяКарта,
	               			|	ИзменениеРежима.Клиент,
	               			|	КлиентыСтационараСрезПоследних.Подразделение,
	               			|	КлиентыСтационараСрезПоследних.Подразделение.Филиал
	               			|;
	               			|
	               			|////////////////////////////////////////////////////////////////////////////////
	               			|ВЫБРАТЬ
	               			|	ИзменениеРежима.Клиент КАК Пациент,
	               			|	ИзменениеРежима.МедицинскаяКарта КАК МедицинскаяКарта,
	               			|	ИзменениеРежимаНазначения.ДействиеСтационара КАК ДействиеСтационара,
	               			|	ИзменениеРежимаНазначения.ДействиеСтационара.ВыполнениеВводомЗначения КАК ВыполнениеВводомЗначения,
	               			|	ИзменениеРежимаНазначения.ДатаНачала КАК ДатаНачала,
	               			|	ИзменениеРежимаНазначения.ДатаОкончания КАК ДатаОкончания,
	               			|	ВЫБОР
	               			|		КОГДА ЕСТЬNULL(ИзменениеРежимаНазначения.СколькоРазВДень, 0) = 0
	               			|			ТОГДА 1
	               			|		ИНАЧЕ ИзменениеРежимаНазначения.СколькоРазВДень
	               			|	КОНЕЦ КАК РазВДень,
	               			|	1 КАК Дозировка,
	               			|	ИзменениеРежимаНазначения.Комментарий КАК Комментарий,
	               			|	ИзменениеРежимаНазначения.Ссылка КАК ДокументИзмененияРежима,
	               			|	ИзменениеРежимаНазначения.ИдентификаторДействия КАК ИдентификаторДействия,
	               			|	ЗНАЧЕНИЕ(Перечисление.ВидыДействийСтационара.Манипуляции) КАК ВидДействия,
	               			|	ИзменениеРежима.Филиал КАК Филиал,
	               			|	ИзменениеРежима.Отделение КАК Отделение
	               			|ИЗ
	               			|	Документ.ИзменениеРежима.ДействияСтационара КАК ИзменениеРежимаНазначения
	               			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзменениеРежима КАК ИзменениеРежима
	               			|		ПО ИзменениеРежимаНазначения.Ссылка = ИзменениеРежима.Ссылка
	               			|ГДЕ
	               			|	(ИзменениеРежимаНазначения.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	               			|				И ИзменениеРежимаНазначения.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	               			|			ИЛИ ИзменениеРежимаНазначения.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	               			|				И ИзменениеРежимаНазначения.ДатаОкончания >= НАЧАЛОПЕРИОДА(&ДатаПросмотра, ДЕНЬ)
	               			|			ИЛИ ИзменениеРежимаНазначения.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	               			|				И НАЧАЛОПЕРИОДА(ИзменениеРежимаНазначения.ДатаНачала, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&ДатаПросмотра, ДЕНЬ)
	               			|			ИЛИ НАЧАЛОПЕРИОДА(&ДатаПросмотра, ДЕНЬ) МЕЖДУ ИзменениеРежимаНазначения.ДатаНачала И ИзменениеРежимаНазначения.ДатаОкончания)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПланыЛеченияПациентов(ДатаПросмотра, Медкарты, Филиалы, Отделения)
	
	// Изменено Макеев 18-12-2025 (
	Запрос = Новый Запрос;
	
	пчИсполнители = Перечисления.ИсполнителиВСтационаре;
	ИсполнительНеДопустимый = ОбщегоНазначенияБИТКлиентСервер.НовыйМассив(пчИсполнители.ВыполняетсяВрачом, пчИсполнители.ПустаяСсылка());
	Запрос.УстановитьПараметр("ИсполнительНеДопустимый", ИсполнительНеДопустимый);
	Запрос.УстановитьПараметр("ДатаПросмотра", ДатаПросмотра);
	Запрос.УстановитьПараметр("Медкарты", Медкарты);
	Запрос.УстановитьПараметр("ОтборПоФилиалам", Не Филиалы.Количество() = 0);
	Запрос.УстановитьПараметр("ОтборПоОтделениям", Не Отделения.Количество() = 0);
	Запрос.УстановитьПараметр("Филиалы", Филиалы);
	Запрос.УстановитьПараметр("Отделения", Отделения);
	
	Запрос.Текст = 			"ВЫБРАТЬ
	               			|	ПланыЛечения.ПервичныйПрием.Клиент КАК Пациент,
	               			|	ПланыЛечения.ПервичныйПрием.МедицинскаяКарта КАК МедицинскаяКарта,
	               			|	ПланыЛечения.Комментарий КАК Комментарий,
	               			|	ПланыЛечения.ДокументРегистратор КАК ДокументИзмененияРежима,
	               			|	ПланыЛечения.Дата КАК ДатаНачала,
	               			|	ПланыЛечения.ДатаОкончания КАК ДатаОкончания,
	               			|	ПланыЛечения.Количество КАК ВсегоНазначено,
	               			|	ВЫБОР
	               			|		КОГДА ПланыЛечения.ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.ВидыНазначений.Медикаменты)
	               			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДействийСтационара.Медикаменты)
	               			|		КОГДА ПланыЛечения.ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.ВидыНазначений.Обследование)
	               			|				ИЛИ ПланыЛечения.ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.ВидыНазначений.Процедура)
	               			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДействийСтационара.Процедуры)
	               			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДействийСтационара.Процедуры)
	               			|	КОНЕЦ КАК ВидДействия,
	               			|	ПланыЛечения.ИдентификаторЭлемента КАК ИдентификаторДействия,
	               			|	ПланыЛечения.Номенклатура КАК ДействиеСтационара,
	               			|	ВЫБОР
	               			|		КОГДА ПланыЛечения.ПриемовВДень = 0
	               			|			ТОГДА 1
	               			|		ИНАЧЕ ПланыЛечения.ПриемовВДень
	               			|	КОНЕЦ КАК РазВДень,
	               			|	ПланыЛечения.Дозировка КАК Дозировка,
	               			|	ПланыЛечения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               			|	ПланыЛечения.Коэффициент КАК Коэффициент,
	               			|	ЕСТЬNULL(ПланыЛечения.Номенклатура.ВестиУчетПоХарактеристикам, ЛОЖЬ) КАК ВестиУчетПоХарактеристикам,
	               			|	КлиентыСтационараСрезПоследних.Подразделение КАК Отделение,
	               			|	КлиентыСтационараСрезПоследних.Подразделение.Филиал КАК Филиал,
	               			|	ЕСТЬNULL(ВведенныеДозировки.Значение, 0) КАК омг_Введено,
	               			|	ПланыЛечения.Дозировка * ВЫБОР
	               			|		КОГДА ПланыЛечения.ПриемовВДень = 0
	               			|			ТОГДА 1
	               			|		ИНАЧЕ ПланыЛечения.ПриемовВДень
	               			|	КОНЕЦ КАК омг_ДозировкаОбщая
	               			|ИЗ
	               			|	РегистрСведений.ПланыЛечения КАК ПланыЛечения
	               			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыСтационара.СрезПоследних(КОНЕЦПЕРИОДА(&ДатаПросмотра, ДЕНЬ), ) КАК КлиентыСтационараСрезПоследних
	               			|		ПО ПланыЛечения.ПервичныйПрием.Клиент = КлиентыСтационараСрезПоследних.Клиент
	               			|			И (НЕ КлиентыСтационараСрезПоследних.Выписан)
	               			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               			|			ВыполнениеДействийСтационара.ИдентификаторЭлемента КАК ИдентификаторЭлемента,
	               			|			СУММА(ВыполнениеДействийСтационара.Значение) КАК Значение
	               			|		ИЗ
	               			|			РегистрСведений.ВыполнениеДействийСтационара КАК ВыполнениеДействийСтационара
	               			|		ГДЕ
	               			|			ВыполнениеДействийСтационара.Документ.МедицинскаяКарта В(&Медкарты)
	               			|		
	               			|		СГРУППИРОВАТЬ ПО
	               			|			ВыполнениеДействийСтационара.ИдентификаторЭлемента) КАК ВведенныеДозировки
	               			|		ПО ПланыЛечения.ИдентификаторЭлемента = ВведенныеДозировки.ИдентификаторЭлемента
	               			|ГДЕ
	               			|	ПланыЛечения.ПервичныйПрием ССЫЛКА Документ.Прием
	               			|	И ПланыЛечения.ПервичныйПрием.МедицинскаяКарта В(&Медкарты)
	               			|	И НЕ ПланыЛечения.Номенклатура.ИсполнительВСтационаре В (&ИсполнительНеДопустимый)
	               			|	И (ПланыЛечения.Дата = ДАТАВРЕМЯ(1, 1, 1)
	               			|				И (ПланыЛечения.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	               			|					ИЛИ ПланыЛечения.ДатаОкончания >= НАЧАЛОПЕРИОДА(&ДатаПросмотра, ДЕНЬ))
	               			|			ИЛИ ПланыЛечения.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	               			|				И НАЧАЛОПЕРИОДА(ПланыЛечения.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаПросмотра, ДЕНЬ)
	               			|			ИЛИ НАЧАЛОПЕРИОДА(&ДатаПросмотра, ДЕНЬ) МЕЖДУ ПланыЛечения.Дата И ПланыЛечения.ДатаОкончания)
	               			|	И ПланыЛечения.ДокументРегистратор.Проведен
	               			|	И ВЫБОР
	               			|			КОГДА НЕ &ОтборПоОтделениям
	               			|				ТОГДА ИСТИНА
	               			|			ИНАЧЕ КлиентыСтационараСрезПоследних.Подразделение В (&Отделения)
	               			|		КОНЕЦ
	               			|	И ВЫБОР
	               			|			КОГДА НЕ &ОтборПоФилиалам
	               			|				ТОГДА ИСТИНА
	               			|			ИНАЧЕ КлиентыСтационараСрезПоследних.Подразделение.Филиал В (&Филиалы)
	               			|		КОНЕЦ";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнениеНазначенийПациентов(ДатаПросмотра, ИдентификаторыНазначений)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПросмотра", ДатаПросмотра);
	Запрос.УстановитьПараметр("ИдентификаторыНазначений", ИдентификаторыНазначений);

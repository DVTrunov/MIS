	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("ДатаВыполнения,ИдентификаторЭлемента", ДатаПросмотра,Новый УникальныйИдентификатор(ТекущиеДанные.ИдентификаторДействия));
		ПараметрыФормы.Вставить("СкрытьКомандуУдаления", Истина);
		ОткрытьФорму("Документ.ДействияЗаСутки.Форма.ФормаПросмотраДействий",ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ЭтоДействиеТемпературногоЛиста(ДействиеСтационара) Экспорт

	Возврат ТипЗнч(ДействиеСтационара) = Тип("СправочникСсылка.ДействияМедсестрыСтационара") И ДействиеСтационара.Предопределенный;
		
КонецФункции

&НаСервере
Процедура ОтметитьВыполнениеТЛНаСервере(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат.Результат) = Тип("Массив") И Результат.Результат.Количество() > 0 Тогда
		ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
		
		// Создаем документ ДействияЗаСутки
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДействияЗаСутки.Ссылка
		|ИЗ
		|	Документ.ДействияЗаСутки КАК ДействияЗаСутки
		|ГДЕ
		|	Не ДействияЗаСутки.ПометкаУдаления
		|	И ДействияЗаСутки.Ответственный = &Ответственный
		|	И ДействияЗаСутки.Филиал = &Филиал
		|	И НАЧАЛОПЕРИОДА(ДействияЗаСутки.Дата,ДЕНЬ) = &Дата");
		
		Запрос.УстановитьПараметр("Филиал",Филиал);
		Запрос.УстановитьПараметр("Ответственный", ТекущийПользователь);
		Запрос.УстановитьПараметр("Дата", НачалоДня(Результат.Данные.Дата));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Не Выборка.Следующий() Тогда 
			ДействияЗаСуткиОбъект = Документы.ДействияЗаСутки.СоздатьДокумент();
			ДействияЗаСуткиОбъект.Дата			 = Результат.Данные.Дата;
			ДействияЗаСуткиОбъект.Филиал         = Филиал;
			ДействияЗаСуткиОбъект.Ответственный	 = ТекущийПользователь;
		Иначе 
			ДействияЗаСуткиОбъект = Выборка.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Для Каждого ДействиеМедсестрыСтационара Из Результат.Результат Цикл
			
			// Отбор и перезапись старых
			Отбор = Новый Структура("Клиент, МедицинскаяКарта, ИдентификаторЭлемента, ДатаВремяВыполнения");
			Отбор.ИдентификаторЭлемента = ДействиеМедсестрыСтационара.ИдентификаторЭлемента;
			ЗаполнитьЗначенияСвойств(Отбор, ДополнительныеПараметры);
			ЗаполнитьЗначенияСвойств(Отбор, ДействиеМедсестрыСтационара);
			Отбор.ДатаВремяВыполнения = Результат.Данные.Дата;
			
			МсСтрокиВыполнения = ДействияЗаСуткиОбъект.ДействияСтационара.НайтиСтроки(Отбор);
			Если МсСтрокиВыполнения.Количество() = 0 Тогда
				стрДействий = ДействияЗаСуткиОбъект.ДействияСтационара.Добавить();
			Иначе
				стрДействий = МсСтрокиВыполнения[0];
				ДействиеМедсестрыСтационара.ЭтоПерезапись = Истина;
			КонецЕсли;
			стрДействий.ВидыДействийСтационара = Перечисления.ВидыДействийСтационара.Манипуляции;
			ЗаполнитьЗначенияСвойств(стрДействий, ДополнительныеПараметры);
			ЗаполнитьЗначенияСвойств(стрДействий, ДействиеМедсестрыСтационара);			
			стрДействий.ДатаВремяВыполнения = Результат.Данные.Дата; // + ?(Результат.Данные.ЭтоВечер, 54000, 0); // вечер - в 15:00 проставится
			СтрДействий.ЭтоВечер = Результат.Данные.ЭтоВечер;
			стрДействий.ДействиеСтационара = Справочники.ДействияМедсестрыСтационара[ДействиеМедсестрыСтационара.Ключ];
			стрДействий.Значение = ДействиеМедсестрыСтационара.Значение;
		КонецЦикла; 				
		
		Попытка
			ДействияЗаСуткиОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			Для Каждого ДействиеМедсестрыСтационара Из Результат.Результат Цикл
				Если Не ДействиеМедсестрыСтационара.ЭтоПерезапись Тогда
					СтрокаДействие = СписокДействий.НайтиСтроки(Новый Структура("ИдентификаторДействия",(ДействиеМедсестрыСтационара.ИдентификаторДействия)));
					ТекущиеДанные = СтрокаДействие[0];
					ТекущиеДанные.Выполнено = ТекущиеДанные.Выполнено + 1;
					СтрокаКЭШ = СписокДействийКэш.НайтиСтроки(Новый Структура("ИдентификаторДействия",ТекущиеДанные.ИдентификаторДействия));
					
					Если ДатаПросмотра = НачалоДня(Результат.Данные.Дата) Тогда
						ТекущиеДанные.ВыполненоИтог = Строка(ТекущиеДанные.Выполнено) + "/" + Строка(ТекущиеДанные.РазВДень);
					КонецЕсли;
					
					Если ТекущиеДанные.Выполнено >= ТекущиеДанные.РазВДень Тогда 
						ТекущиеДанные.ОтметкаВыполнения = Истина;
					КонецЕсли;
					
					Если СтрокаКЭШ.Количество() > 0 Тогда 
						СтрокаКЭШ[0].Выполнено = ТекущиеДанные.Выполнено;
						СтрокаКЭШ[0].ВыполненоИтог = ТекущиеДанные.ВыполненоИтог;
						СтрокаКЭШ[0].ОтметкаВыполнения = ТекущиеДанные.ОтметкаВыполнения;
					КонецЕсли;
				КонецЕсли;			
			КонецЦикла;
		Исключение
		КонецПопытки;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТемпературныйЛист(Команда)
	
	ТекущиеДанные = Элементы.СписокПациентов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		
		СтруктураДанных = Новый Структура();
		СтруктураДанных.Вставить("Клиент", ТекущиеДанные.Пациент);
		СтруктураДанных.Вставить("МедицинскаяКарта",ТекущиеДанные.МедицинскаяКарта);
		СтруктураДанных.Вставить("ДатаПросмотра", ДатаПросмотра);		
		
		СоответствиеДействияСтационара = Новый Соответствие;
		
		СтруктураОтбора = Новый Структура("Пациент, ВидДействия", ТекущиеДанные.Пациент, ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Манипуляции"));	
		МсСтрокиДействияПациента = СписокДействий.НайтиСтроки(СтруктураОтбора);
		Для каждого СтрокаДействияПациента Из МсСтрокиДействияПациента Цикл
			Если СоответствиеДействияСтационара.Получить(СтрокаДействияПациента.ДействиеСтационара) = Неопределено Тогда
				СоответствиеДействияСтационара.Вставить(СтрокаДействияПациента.ДействиеСтационара, 
																Новый Структура("ИдентификаторДействия, ДокументИзмененияРежима", 
																СтрокаДействияПациента.ИдентификаторДействия, СтрокаДействияПациента.ДокументИзмененияРежима));
			КонецЕсли;
		КонецЦикла;
		СтруктураДанных.Вставить("НазначенныеДействия", СоответствиеДействияСтационара);
		ФормаВводаЗначения = ПолучитьФорму("ОбщаяФорма.ТемпературныйЛистВводПоказателей", СтруктураДанных);
		ОткрытьФорму("ОбщаяФорма.ТемпературныйЛистВводПоказателей",СтруктураДанных,,,,, Новый ОписаниеОповещения("ОтметитьВыполнениеТЛНаСервере", ЭтаФорма, СтруктураДанных));	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗабор(Команда)
	Если ЗначениеЗаполнено(Пациент) Тогда
		Клиент = Пациент;
	Иначе
		Попытка
			Клиент = Элементы.СписокДействий.ТекущиеДанные.Пациент;	
		Исключение
		    ПоказатьПредупреждение(,НСтр("ru='Не выбран пациент!'"), 30);
		КонецПопытки;
	КонецЕсли;
	ПараметрыОтбора = Новый Структура("Пациент",Клиент);
	ДействияКлиента = СписокДействий.НайтиСтроки(ПараметрыОтбора);
	ПараметрАнализы = Новый Массив;
	Для Каждого СтрокаДействия Из ДействияКлиента Цикл
		Если ТипЗнч(СтрокаДействия.ДействиеСтационара) = Тип("СправочникСсылка.Номенклатура")
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДействия.ДействиеСтационара,"Анализ")
			И Не СтрокаДействия.ОтметкаВыполнения
			И СтрокаДействия.РазВДень > СтрокаДействия.Выполнено
		Тогда
			ПараметрАнализы.Добавить(Новый Структура("Клиент, Номенклатура, Количество",Клиент,СтрокаДействия.ДействиеСтационара, 1));
		КонецЕсли; 	
	КонецЦикла;
	
	Если ПараметрАнализы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Нет невыполенных анализов у пациента!'"), 30);
	ИначеЕсли ПараметрАнализы.Количество() = 1 Тогда
		// Сразу открываем документ забора, т.к. не нужно выбирать из единственного варианта.
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения",
			Новый Структура("Клиент, Анализы, ВидОперации", Клиент, ПараметрАнализы	, ПредопределенноеЗначение("Перечисление.ВидыОперацийАнализов.Забор")));
		ОткрытьФорму("Документ.ДействияНадАнализами.ФормаОбъекта", ПараметрыФормы, ЭтаФорма.ВладелецФормы);
	Иначе
		РаботаСКлиентамиКлиентПереопределяемый.ВыборатьУслугиКлиентовДляСозданияДокумента("Забор", Клиент, ПараметрАнализы);
	КонецЕсли;
	
КонецПроцедуры


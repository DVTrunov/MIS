#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтандартЛечения = Параметры.СтандартЛечения;
	
	Если Не ЗначениеЗаполнено(СтандартЛечения) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Заголовок = "Выбор услуг стандарта: " + СтандартЛечения;
	ЗаполнитьДеревоУслуг();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Для Каждого СтрокаЭтапа Из Услуги.ПолучитьЭлементы() Цикл
		Элементы.Услуги.Развернуть(СтрокаЭтапа.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДеревоУслуг()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Стандарт", СтандартЛечения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Назначения.ЭтапМаршрутаПациента КАК Этап,
	|	Назначения.Назначение КАК Назначение,
	|	Назначения.Количество КАК Количество,
	|	Назначения.ИдентификаторНазначения КАК ИдентификаторНазначения,
	|	Назначения.ПорядковыйНомер КАК ПорядковыйНомер,
	|	ВЫБОР
	|		КОГДА Назначения.ЭтапМаршрутаПациента = ЗНАЧЕНИЕ(Перечисление.ЭтапыМаршрутаПациента.Консультация)
	|			ТОГДА 1
	|		КОГДА Назначения.ЭтапМаршрутаПациента = ЗНАЧЕНИЕ(Перечисление.ЭтапыМаршрутаПациента.ДиагностикаЛабораторная)
	|			ТОГДА 2
	|		КОГДА Назначения.ЭтапМаршрутаПациента = ЗНАЧЕНИЕ(Перечисление.ЭтапыМаршрутаПациента.ДиагностикаИнструментальная)
	|			ТОГДА 3
	|		КОГДА Назначения.ЭтапМаршрутаПациента = ЗНАЧЕНИЕ(Перечисление.ЭтапыМаршрутаПациента.Лечение)
	|			ТОГДА 4
	|		КОГДА Назначения.ЭтапМаршрутаПациента = ЗНАЧЕНИЕ(Перечисление.ЭтапыМаршрутаПациента.ДинамическийКонтроль)
	|			ТОГДА 5
	|		ИНАЧЕ 99
	|	КОНЕЦ КАК ПорядокЭтапа
	|ИЗ
	|	Справочник.СтандартыЛечения.Назначения КАК Назначения
	|ГДЕ
	|	Назначения.Ссылка = &Стандарт
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокЭтапа,
	|	ПорядковыйНомер";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДеревоУслуг = РеквизитФормыВЗначение("Услуги", Тип("ДеревоЗначений"));
	ДеревоУслуг.Строки.Очистить();
	СтрокиЭтапов = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаЭтапа = СтрокиЭтапов.Получить(Выборка.Этап);
		Если СтрокаЭтапа = Неопределено Тогда
			СтрокаЭтапа = ДеревоУслуг.Строки.Добавить();
			СтрокаЭтапа.ЭтоГруппа = Истина;
			СтрокаЭтапа.Этап = Выборка.Этап;
			СтрокаЭтапа.Пометка = Истина;
			СтрокаЭтапа.Представление = ?(ЗначениеЗаполнено(Выборка.Этап), Строка(Выборка.Этап), "Без этапа");
			СтрокиЭтапов.Вставить(Выборка.Этап, СтрокаЭтапа);
		КонецЕсли;
		
		СтрокаУслуги = СтрокаЭтапа.Строки.Добавить();
		СтрокаУслуги.ЭтоГруппа = Ложь;
		СтрокаУслуги.Этап = Выборка.Этап;
		СтрокаУслуги.Пометка = Истина;
		СтрокаУслуги.Представление = Строка(Выборка.Назначение);
		СтрокаУслуги.Количество = Выборка.Количество;
		СтрокаУслуги.ИдентификаторНазначения = Строка(Выборка.ИдентификаторНазначения);
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоУслуг, "Услуги");
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа Тогда
		Для Каждого СтрокаУслуги Из ТекущиеДанные.ПолучитьЭлементы() Цикл
			СтрокаУслуги.Пометка = ТекущиеДанные.Пометка;
		КонецЦикла;
	Иначе
		Родитель = ТекущиеДанные.ПолучитьРодителя();
		Если Родитель <> Неопределено Тогда
			ВсеОтмечены = Истина;
			Для Каждого СтрокаУслуги Из Родитель.ПолучитьЭлементы() Цикл
				Если Не СтрокаУслуги.Пометка Тогда
					ВсеОтмечены = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Родитель.Пометка = ВсеОтмечены;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуВсем(Пометка)
	
	Для Каждого СтрокаЭтапа Из Услуги.ПолучитьЭлементы() Цикл
		СтрокаЭтапа.Пометка = Пометка;
		Для Каждого СтрокаУслуги Из СтрокаЭтапа.ПолучитьЭлементы() Цикл
			СтрокаУслуги.Пометка = Пометка;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьПометкуВсем(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьПометкуВсем(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьУслуги(Команда)
	
	ВыбранныеИдентификаторы = Новый Массив;
	Для Каждого СтрокаЭтапа Из Услуги.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаУслуги Из СтрокаЭтапа.ПолучитьЭлементы() Цикл
			Если СтрокаУслуги.Пометка Тогда
				ВыбранныеИдентификаторы.Добавить(СтрокаУслуги.ИдентификаторНазначения);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ВыбранныеИдентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одной услуги.");
		Возврат;
	КонецЕсли;
	
	Закрыть(ВыбранныеИдентификаторы);
	
КонецПроцедуры

#КонецОбласти
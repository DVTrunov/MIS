#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Изменено Макеев 02-12-2025 (
	
	СоответствиеШаблоновМД = Новый ФиксированноеСоответствие(СоздатьКнопкиИПолучитьЗначенияСоответствия());
	
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	
	ДопПараметрыЗапроса = Новый Структура("омг_Филиалы, омг_Отделения", омг_Филиалы, омг_Отделения);
	ПациентыВСтационаре.Загрузить(ПолучитьТекущихПациентовСтационара(Ложь, ДопПараметрыЗапроса));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "УстановкаУсловийПребывания" Тогда 
		ОбновитьСписокТекущихПациентовСтационара(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСписокТекущихПациентовСтационара(Команда)
	
	// Изменено Макеев 02-12-2025 (
	ПациентыВСтационаре.Очистить();	
	ДопПараметрыЗапроса = Новый Структура("омг_Филиалы, омг_Отделения", омг_Филиалы, омг_Отделения);
	ТекущиеПациенты = ПолучитьТекущихПациентовСтационара(Истина, ДопПараметрыЗапроса);
	Для Каждого СтрокаТекущегоПациента Из ТекущиеПациенты Цикл	
		ЗаполнитьЗначенияСвойств(ПациентыВСтационаре.Добавить(), СтрокаТекущегоПациента);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПребыванияПациента(Команда)
	
	ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Клиент", ТекущиеДанные.Клиент));
		ОткрытьФорму("РегистрСведений.КлиентыСтационара.ФормаСписка", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТемпературныйЛист(Команда)
	ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьФорму("Отчет.ТемпературныйЛист.Форма.ФормаОтчета",Новый Структура("Пациент, Медицинскаякарта", 
															Элементы.ПациентыВСтационаре.ТекущиеДанные.Клиент),
															Элементы.ПациентыВСтационаре.ТекущиеДанные.МедицинскаяКарта);
	КонецЕсли;
							
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЛистНазначений(Команда)
	
	ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормыОтчета = Новый Структура;
		ПараметрыФормыОтчета.Вставить("Клиент", ТекущиеДанные.Клиент);
		ПараметрыФормыОтчета.Вставить("СформироватьПриОткрытии", Истина);
		
		Если ЗначениеЗаполнено(ТекущиеДанные.МедицинскаяКарта) Тогда
			ПараметрыФормыОтчета.Вставить("МедицинскаяКарта", ТекущиеДанные.МедицинскаяКарта);
		КонецЕсли;
		
		ОткрытьФорму("Отчет.ЛистНазначений.ФормаОбъекта", Новый Структура("Клиент, СформироватьПриОткрытии", ТекущиеДанные.Клиент, Истина));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьМД(Команда)
	
	ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Шаблоны = Новый Массив();
		Шаблоны.Добавить(СоответствиеШаблоновМД[Команда.Имя]);
		ПараметрыФормы = Новый Структура("ШаблоныПриема, Клиент, МедицинскаяКарта, ЭтоПриемВСтационаре", Шаблоны, ТекущиеДанные.Клиент, ТекущиеДанные.МедицинскаяКарта, Истина);
		ОткрытьФорму("Документ.Прием.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПросмотрЭМК(Команда)
	
	ТекущиеДанные = Элементы.ПациентыВСтационаре.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда

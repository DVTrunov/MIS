#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПациентыВСтационареВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = ПациентыВСтационаре.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле = Элементы.ПациентыВСтационареДатаПоследнегоИзменения Тогда
		ПоказатьЗначение(,ТекущиеДанные.ДокументИзмененияРазмещения);
	ИначеЕсли Поле = Элементы.ПациентыВСтационареПервичныйПрием Тогда
		ПоказатьЗначение(,ТекущиеДанные.ПервичныйПрием);
	Иначе
		ПоказатьЗначение(,ТекущиеДанные.ДокументПоступления);	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущихПациентовСтационара(ДляОбработкиНаКлиенте, ДопПараметры)
	
	// Изменено Макеев 02-12-2025 (
	СЗПолеМедкарта = Новый СписокЗначений;
	СЗПолеМедкарта.Добавить("МедицинскаяКарта", "ДокументПоступления.ДокументОбращения.МедицинскаяКарта");
	СЗПолеМедкарта.Добавить("ПервичныйПрием", "ДокументПоступления.ДокументОбращения.ДокументОснование");

	ДополнительныеУсловия = Новый Массив;
	
	Если Не ДопПараметры.омг_Отделения.Количество() = 0 Тогда
		ТекстЗапроса = "КлиентыСтационара.КойкоМесто.Владелец.Подразделение В (&Подразделения)";
		ПараметрЗапроса = Новый Структура("Подразделения", ДопПараметры.омг_Отделения);
		ДополнительныеУсловия.Добавить(Новый Структура("Текст, Параметры", ТекстЗапроса, ПараметрЗапроса));
	КонецЕсли;
	
	Если Не ДопПараметры.омг_Филиалы.Количество() = 0 Тогда
		ТекстЗапроса = "Регистратор.Филиал В (&Филиалы)";
		ПараметрЗапроса = Новый Структура("Филиалы", ДопПараметры.омг_Филиалы);
		ДополнительныеУсловия.Добавить(Новый Структура("Текст, Параметры", ТекстЗапроса, ПараметрЗапроса));
	КонецЕсли;
	
	ТаблицаПациентов = Стационар.ПолучитьКлиентовСтационара(ТекущаяДата(), , СЗПолеМедкарта, ДополнительныеУсловия);
	
	Для Каждого СтрокаТекущегоПациента Из ТаблицаПациентов Цикл
		
		Если СтрокаТекущегоПациента.МедицинскаяКарта = Null или СтрокаТекущегоПациента.ПервичныйПрием.Пустая()  Тогда     
			Данные = Стационар.ПолучитьМедкартуИлиСсылкуПервичногоПриемаСтационара(
						СтрокаТекущегоПациента.Клиент, ТекущаяДата(), Неопределено); // Получим и медкарту, и прием.
														
			ЗаполнитьЗначенияСвойств(СтрокаТекущегоПациента, Данные); 
		КонецЕсли;
	КонецЦикла;
	
	Если ДляОбработкиНаКлиенте Тогда
		Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаПациентов);
	Иначе
		Возврат ТаблицаПациентов;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СоздатьКнопкиИПолучитьЗначенияСоответствия()
	
	ПанельПодменю = Элементы.СоздатьДокументПодменю;
	СоответствиеШаблонов = Новый Соответствие;
	
	Сотрудник = ПараметрыСеанса.ТекущийПользователь.Сотрудник;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		СпециализацииСотрудника = Сотрудник.Специализации.ВыгрузитьКолонку("Специализация");
	Иначе
		СпециализацииСотрудника = Новый Массив;
	КонецЕсли;
	СпециализацииСотрудника.Добавить(Справочники.КатегорииВыработки.ПустаяСсылка());
	
	// Создадим список медицинских документов из регистра
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СпециализацииСотрудника", СпециализацииСотрудника);	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныСтационара.ШаблонОсмотра КАК ШаблонОсмотра,
		|	ШаблоныСтационара.РольШаблона КАК РольШаблона,
		|	ШаблоныСтационара.Специализация КАК Специализация,
		|	ПРЕДСТАВЛЕНИЕ(ШаблоныСтационара.РольШаблона) КАК РольШаблонаПредставление,
		|	ПРЕДСТАВЛЕНИЕ(ШаблоныСтационара.Специализация) КАК СпециализацияПредставление,
		|	ШаблоныСтационара.РольШаблона.Порядок КАК Порядок
		|ИЗ
		|	РегистрСведений.ШаблоныМедицинскихДокументовСтационара КАК ШаблоныСтационара
		|ГДЕ
		|	ШаблоныСтационара.Специализация В(&СпециализацииСотрудника)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Сч = 0;
		ИмяКоманды	 = "Кнопка"
					 + ОбщегоНазначения.ИмяЗначенияПеречисления(Выборка.РольШаблона)
					 + ?(ЗначениеЗаполнено(Выборка.Специализация), СтрЗаменить(Выборка.Специализация.УникальныйИдентификатор(),"-",""), "");
		Попытка	
	    	КомандаПриНажатии = ЭтаФорма.Команды.Добавить(ИмяКоманды);
			КомандаПриНажатии.Действие = "СоздатьМД";
			
			КнопкаШаблон = ЭтаФорма.Элементы.Добавить("Кнопка" + ИмяКоманды, Тип("КнопкаФормы"), ПанельПодменю);
			КнопкаШаблон.ИмяКоманды	 = ИмяКоманды;
			КнопкаШаблон.Заголовок	 = Выборка.РольШаблонаПредставление
									 + ?(ЗначениеЗаполнено(Выборка.Специализация), "(" + Выборка.СпециализацияПредставление + ")", "");
		Исключение		
		КонецПопытки;
		СоответствиеШаблонов.Вставить(ИмяКоманды, Выборка.ШаблонОсмотра);
	КонецЦикла;
	
	Возврат СоответствиеШаблонов;
	
КонецФункции	

&НаКлиенте
Процедура омг_ФилиалыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;//("Организация", Объект.омг_Организация);
	СписокВыбранных = омг_Филиалы;
	ОткрытьФорму("ОбщаяФорма.омг_ФормаВыбораСИерархией", 
		Новый Структура("Справочник, СписокВыбранных, Отбор", "Филиалы", СписокВыбранных, Отбор), Элементы.омг_Филиалы,
		УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ОтделенияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокВыбранных = омг_Отделения;

	Отбор = Новый Структура;//("Организация", Объект.омг_Организация);
	
	ПараметрыЗапроса = Новый Массив;
	ПараметрыЗапроса.Добавить(Новый Структура("Параметр, Значение", "Филиалы", омг_Филиалы.ВыгрузитьЗначения()));
	
	Отбор.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	
	СложныеОтборы = Новый Массив;
	Если Не омг_Филиалы.Количество() = 0 Тогда
		СложныеОтборы.Добавить("Филиал В (&Филиалы)");
	КонецЕсли;
	
	Отбор.Вставить("СложныеОтборы", СложныеОтборы);
	ОткрытьФорму("ОбщаяФорма.омг_ФормаВыбораСИерархией", 
		Новый Структура("Справочник, СписокВыбранных, Отбор", "Подразделения", СписокВыбранных, Отбор), Элементы.омг_Отделения,
		УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура омг_ФилиалыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	омг_Филиалы = ВыбранноеЗначение;
	
	ОбновитьСписокТекущихПациентовСтационара(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ОтделенияОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	омг_Отделения = ВыбранноеЗначение;
	
	ОбновитьСписокТекущихПациентовСтационара(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ФилиалыПриИзменении(Элемент)
	
	Если Не омг_Филиалы.Количество() = 0 Тогда
		омг_Отделения.Очистить();
	КонецЕсли;
	ОбновитьСписокТекущихПациентовСтационара(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура омг_ОтделенияПриИзменении(Элемент)

	ОбновитьСписокТекущихПациентовСтационара(Неопределено);

КонецПроцедуры

#КонецОбласти

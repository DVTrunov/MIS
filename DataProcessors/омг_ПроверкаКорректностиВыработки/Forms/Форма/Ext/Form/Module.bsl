
&НаСервере
Процедура СформироватьНаСервере()
	
	Результат.Очистить();
    

	СхемаКД = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКД));
	Компоновщик.ЗагрузитьНастройки(СхемаКД.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	
	ПараметрыДанных = Настройки.ПараметрыДанных;
	
	ЭлементНачало = ПараметрыДанных.Элементы.Найти("НачалоПериода");
	Если ЭлементНачало <> Неопределено Тогда
		ЭлементНачало.Значение = Период.ДатаНачала;
		ЭлементНачало.Использование = Истина;
	КонецЕсли;
	
	ЭлементКонец = ПараметрыДанных.Элементы.Найти("КонецПериода");
	Если ЭлементКонец <> Неопределено Тогда
		ЭлементКонец.Значение = КонецДня(Период.ДатаОкончания);
		ЭлементКонец.Использование = Истина;
	КонецЕсли;

	Настройки.Отбор.Элементы.Очистить();
	
	ДобавитьОтбор(Настройки, "Филиал",      МедицинскийЦентр);
	ДобавитьОтбор(Настройки, "Сотрудник",   Сотрудник);
	
	Если РольДоступна("ПолныеПрава") Тогда
		
		ФилиалВар = Филиал;
		
	иначе 
		
		ФилиалВар = омг_ДополнительныеАлгоритмы.ПолучитьОрганизациюСотрудника();
		
	КонецЕсли;
		
	ДобавитьОтбор(Настройки, "Организация", ФилиалВар);

	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКД, Настройки, ДанныеРасшифровки); 	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки); 
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Результат.ОтображатьГруппировки = Истина; 	Результат.ТолькоПросмотр = Истина;
	Результат.Защита = Ложь;
	
	АдресРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, УникальныйИдентификатор);

КонецПроцедуры

Процедура ДобавитьОтбор(Настройки, ИмяПоля, Значение)
    Если ЗначениеЗаполнено(Значение) Тогда
        ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяПоля);
        ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
        ЭлементОтбора.ПравоеЗначение = Значение;
        ЭлементОтбора.Использование  = Истина;
    КонецЕсли;
КонецПроцедуры

Процедура УстановитьПараметр(ПараметрыДанных, ИмяПараметра, Значение)
    Элемент = ПараметрыДанных.Элементы.Найти(ИмяПараметра);
    Если Элемент <> Неопределено Тогда
        Элемент.Значение = Значение;
        Элемент.Использование = Истина;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СтандартнаяОбработка = Ложь;
	
	Если ПустаяСтрока(АдресРасшифровки) Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаДляОткрытия = ПолучитьСсылкуИзРасшифровки(Расшифровка);
	
	Если ЗначениеЗаполнено(СсылкаДляОткрытия) Тогда
		ОткрытьЗначение(СсылкаДляОткрытия);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьСсылкуИзРасшифровки(Идентификатор)
	
	Данные = ПолучитьИзВременногоХранилища(АдресРасшифровки);
	Если Данные = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	
	ЭлементРасшифровки = Данные.Элементы.Получить(Идентификатор);
	
	Для Каждого Поле Из ЭлементРасшифровки.ПолучитьПоля() Цикл
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Поле.Значение)) 
		   Или Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Поле.Значение)) Тогда
			Возврат Поле.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

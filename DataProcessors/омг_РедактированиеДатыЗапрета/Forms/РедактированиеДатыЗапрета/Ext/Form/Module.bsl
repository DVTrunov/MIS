&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_ДатыЗапретаИзменения.Объект КАК Объект,
	               |	омг_ДатыЗапретаИзменения.Пользователь КАК Пользователь,
	               |	омг_ДатыЗапретаИзменения.ДатаЗапрета КАК ДатаЗапрета
	               |ИЗ
	               |	РегистрСведений.омг_ДатыЗапретаИзменения КАК омг_ДатыЗапретаИзменения
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Пользователь,
	               |	Объект,
	               |	ДатаЗапрета
	               |ИТОГИ ПО
	               |	Пользователь
	               |АВТОУПОРЯДОЧИВАНИЕ";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаПользователей = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПользователей.Следующий() Цикл
			СтрокаПользователей  = ПользователиЗапрета.Добавить();
			СтрокаПользователей.Пользователь = ВыборкаПользователей.Пользователь;
			СтрокаПользователей.КлючСтроки = Новый УникальныйИдентификатор;
			
			ВыборкаОбъектов = ВыборкаПользователей.Выбрать();
			Пока ВыборкаОбъектов.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаОбъектов.Объект) Тогда
					СтрокаОбъектов = ОбъектыЗапрета.Добавить();
					СтрокаОбъектов.Объект = ВыборкаОбъектов.Объект;
					СтрокаОбъектов.ДатаЗапрета = ВыборкаОбъектов.ДатаЗапрета;
					СтрокаОбъектов.КлючСтроки = СтрокаПользователей.КлючСтроки;
				Иначе
					СтрокаПользователей.ДатаЗапрета = ВыборкаОбъектов.ДатаЗапрета;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьТипыОбъектов(ОбъектыЗапрета);
	
КонецПроцедуры


&НаСервере
Процедура ПрименитьНаСервере()
	
	
	РегистрыСведений.омг_ДатыЗапретаИзменения.СоздатьНаборЗаписей().Записать();
	
	СтруктураПоиска = Новый Структура("КлючСтроки");
	
	Для Каждого СтрокаПользователей Из ПользователиЗапрета Цикл
		Если ЗначениеЗаполнено(СтрокаПользователей.ДатаЗапрета) Тогда
			Запись = РегистрыСведений.омг_ДатыЗапретаИзменения.СоздатьМенеджерЗаписи();
			Запись.Пользователь = СтрокаПользователей.Пользователь;
			Запись.ДатаЗапрета = СтрокаПользователей.ДатаЗапрета;
			Запись.Записать();
		КонецЕсли;
		СтруктураПоиска.КлючСтроки = СтрокаПользователей.КлючСтроки;
		НайденныеСтроки = ОбъектыЗапрета.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрокаОбъектов Из НайденныеСтроки Цикл
			Запись = РегистрыСведений.омг_ДатыЗапретаИзменения.СоздатьМенеджерЗаписи();
			Запись.Пользователь = СтрокаПользователей.Пользователь;
			Запись.Объект = СтрокаОбъектов.Объект;
			Запись.ДатаЗапрета = СтрокаОбъектов.ДатаЗапрета;
			Запись.Записать();
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура Применить(Команда)
	
	ПрименитьНаСервере();
	Модифицированность = Ложь;
	
КонецПроцедуры



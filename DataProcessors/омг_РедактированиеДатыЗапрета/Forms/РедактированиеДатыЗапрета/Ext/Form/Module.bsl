
&НаКлиенте
Процедура ПользователиПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Пользователи.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.ОбъектыЗапрета.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки", Неопределено));
		Возврат;
	КонецЕсли;
	
	Элементы.ОбъектыЗапрета.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки", ТекущиеДанные.КлючСтроки));
	
КонецПроцедуры

&НаКлиенте
Процедура ПользователиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.Пользователи.ТекущиеДанные;
		ТекущиеДанные.КлючСтроки = Новый УникальныйИдентификатор;
		Элементы.ОбъектыЗапрета.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки", ТекущиеДанные.КлючСтроки));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыЗапретаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ПользователиЗапретаТекущиеДанные = Элементы.Пользователи.ТекущиеДанные;
		ТекущиеДанные = Элементы.ОбъектыЗапрета.ТекущиеДанные;
		ТекущиеДанные.КлючСтроки = ПользователиЗапретаТекущиеДанные.КлючСтроки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПользователей(Команда)
	
	Форма = ОткрытьФорму("Справочник.Пользователи.Форма.ФормаВыбораУпр", 
		Новый Структура("ЗакрыватьПриВыборе", Ложь), ЭтаФорма, УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Форма.Элементы.Список.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.ГруппыИЭлементы;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(Знач ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		ВыбранноеЗначение = ВыбранноеЗначение[0];
	КонецЕсли;
	
	Если СтрНайти(ИсточникВыбора.ИмяФормы, "Пользователи") > 0
		Или СтрНайти(ИсточникВыбора.ИмяФормы, "ГруппыПользователей") > 0 Тогда
		НайденныеСтроки = ПользователиЗапрета.НайтиСтроки(Новый Структура("Пользователь", ВыбранноеЗначение));
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ПользователиЗапрета.Добавить();
			НоваяСтрока.Пользователь = ВыбранноеЗначение;
			НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	ИначеЕсли СтрНайти(ИсточникВыбора.ИмяФормы, "Организации") > 0
		Или СтрНайти(ИсточникВыбора.ИмяФормы, "Филиалы") > 0 Тогда
		
		ПользователиТекущиеДанные = Элементы.Пользователи.ТекущиеДанные;
			
		НайденныеСтроки = ОбъектыЗапрета.НайтиСтроки(Новый Структура("Объект, КлючСтроки", ВыбранноеЗначение, ПользователиТекущиеДанные.КлючСтроки));
		Если НайденныеСтроки.Количество() = 0 Тогда
			
			НоваяСтрока = ОбъектыЗапрета.Добавить();
			НоваяСтрока.Объект = ВыбранноеЗначение;
			НоваяСтрока.КлючСтроки = ПользователиТекущиеДанные.КлючСтроки;
		КонецЕсли;
		ОбновитьТипыОбъектов(ОбъектыЗапрета);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПользователиПередУдалением(Элемент, Отказ)
	
	ПользователиТекущиеДанные = Элементы.Пользователи.ТекущиеДанные;
	
	НайденныеСтроки = ОбъектыЗапрета.НайтиСтроки(Новый Структура("КлючСтроки", ПользователиТекущиеДанные.КлючСтроки));
	Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		ОбъектыЗапрета.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры


// Просмотр и печать протокола со свободной вёрсткой (HTML) - в тонком и веб-клиенте.
// Параметры: ТекстHTML - HTML протокола (омг_ПротоколыПриемаСервер.ТекстHTMLПечати), Заголовок.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПолеHTML = Строка(Параметры.ТекстHTML);
	Заголовок = Строка(Параметры.Заголовок);
	ИмяФайла = ?(ПустаяСтрока(Заголовок), НСтр("ru = 'Протокол'"), Заголовок) + ".html";
	Для Каждого Символ Из СтрРазделить("\,/,:,*,?,"",<,>,|", ",") Цикл
		ИмяФайла = СтрЗаменить(ИмяФайла, Символ, " ");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Печать средствами браузера поля HTML: execCommand("Print") (как у шаблонов HTML), иначе window.print().
&НаКлиенте
Процедура Печать(Команда)

	ДокументHTML = Элементы.ПолеHTML.Документ;
	Попытка
		ДокументHTML.execCommand("Print");
		Возврат;
	Исключение
		// В браузерах без execCommand("Print") - печать окна страницы.
	КонецПопытки;
	Попытка
		ДокументHTML.defaultView.print();
	Исключение
		Попытка
			ДокументHTML.parentWindow.print();
		Исключение
			ПоказатьПредупреждение(, НСтр("ru = 'Не удалось вызвать печать. Сохраните протокол кнопкой «Сохранить» и напечатайте из браузера или Word.'"));
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Адрес = ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(ПолеHTML, КодировкаТекста.UTF8), УникальныйИдентификатор);
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайла);

КонецПроцедуры

#КонецОбласти

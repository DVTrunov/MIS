// Форма заполнения протокола приёма по структурированному шаблону.
// Поля рисует HTML-страница (макет ФормаВводаHTML); 1С забирает значения через
// функции страницы omgGetData / omgMissingRequired и пишет их на сервере.
// На клиенте нет работы с DOM средствами 1С, поэтому форма одинаково работает
// в тонком клиенте и в браузере.

&НаКлиенте
Перем ЗакрытиеПодтверждено;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Документ = Параметры.Документ;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Сначала запишите приём.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Шаблон = Параметры.Шаблон;
	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		Шаблон = ШаблонПоУмолчанию(Документ);
	КонецЕсли;
	ПредыдущийШаблон = Шаблон;

	ОбновитьСтраницу();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗакрытиеПодтверждено = Истина Или Не ЕстьНесохраненныеИзменения() Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Протокол приёма не сохранён.'");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
		НСтр("ru = 'Сохранить изменения протокола?'"), РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ШаблонПриИзменении(Элемент)

	Если Шаблон = ПредыдущийШаблон Тогда
		Возврат;
	КонецЕсли;

	Если ЕстьНесохраненныеИзменения() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ШаблонПриИзмененииЗавершение", ЭтотОбъект),
			НСтр("ru = 'Несохранённые изменения текущего протокола будут потеряны. Сменить шаблон?'"), РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	СменитьШаблонНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ЗаписатьПротокол() Тогда
		ЗакрытиеПодтверждено = Истина;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьПротокол();

КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)

	Если Не ЗаписатьПротокол() Тогда
		Возврат;
	КонецЕсли;
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм(), , ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если Не ЗаписатьПротокол() Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Ответ <> КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;

	ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ШаблонПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		СменитьШаблонНаСервере();
	Иначе
		Шаблон = ПредыдущийШаблон;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЗаписатьПротокол()

	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите шаблон протокола.'"));
		Возврат Ложь;
	КонецЕсли;

	Окно = ОкноСтраницы();
	Если Окно = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Страница протокола ещё загружается, повторите через секунду.'"));
		Возврат Ложь;
	КонецЕсли;

	НеЗаполнены = Окно.omgMissingRequired();
	Если Не ПустаяСтрока(НеЗаполнены) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Заполните обязательные поля:'") + Символы.ПС + НеЗаполнены);
		Возврат Ложь;
	КонецЕсли;

	ЗаписатьНаСервере(Окно.omgGetData());
	Окно.omgSetSaved();
	Оповестить("Запись_омг_ПротоколПриема", Шаблон, Документ);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Протокол сохранён'"), , Строка(Шаблон));
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ЕстьНесохраненныеИзменения()

	Окно = ОкноСтраницы();
	Если Окно = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Окно.omgIsDirty() = "true";
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Окно (window) HTML-страницы: defaultView в WebKit и браузерах, parentWindow в старом движке IE.
&НаКлиенте
Функция ОкноСтраницы()

	ДокументСтраницы = Элементы.ПолеHTML.Документ;
	Если ДокументСтраницы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Окно = Неопределено;
	Попытка
		Окно = ДокументСтраницы.defaultView;
	Исключение
		Окно = Неопределено;
	КонецПопытки;
	Если Окно = Неопределено Тогда
		Попытка
			Окно = ДокументСтраницы.parentWindow;
		Исключение
			Окно = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Окно <> Неопределено Тогда
		Попытка
			Окно.omgIsDirty();
		Исключение
			Возврат Неопределено; // Скрипт страницы ещё не выполнился.
		КонецПопытки;
	КонецЕсли;

	Возврат Окно;

КонецФункции

&НаСервере
Процедура ЗаписатьНаСервере(ТекстJSON)

	омг_ПротоколыПриемаСервер.ЗаписатьЗначенияПротокола(Документ, Шаблон, ТекстJSON);

КонецПроцедуры

&НаСервере
Процедура СменитьШаблонНаСервере()

	ПредыдущийШаблон = Шаблон;
	ОбновитьСтраницу();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСтраницу()

	ПолеHTML = омг_ПротоколыПриемаСервер.ТекстHTMLФормыВвода(Шаблон, Документ);
	Заголовок = ?(ЗначениеЗаполнено(Шаблон), Строка(Шаблон), НСтр("ru = 'Протокол приёма'"));

КонецПроцедуры

&НаСервере
Функция КоллекцияПечатныхФорм()

	Возврат омг_ПротоколыПриемаСервер.КоллекцияПечатныхФормПротокола(Шаблон, Документ);

КонецФункции

// Уже заполненный по приёму шаблон, иначе единственный шаблон специализации приёма.
&НаСервереБезКонтекста
Функция ШаблонПоУмолчанию(Документ)

	Заполненные = омг_ПротоколыПриемаСервер.ЗаполненныеШаблоныПриема(Документ);
	Если Заполненные.Количество() > 0 Тогда
		Возврат Заполненные[0];
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Шаблоны.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.омг_ШаблоныПротоколов КАК Шаблоны
	|ГДЕ
	|	НЕ Шаблоны.ПометкаУдаления
	|	И НЕ Шаблоны.ЭтоШапка
	|	И Шаблоны.Специализация = &Специализация";
	Запрос.УстановитьПараметр("Специализация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Специализация"));
	Выгрузка = Запрос.Выполнить().Выгрузить();

	Возврат ?(Выгрузка.Количество() = 1, Выгрузка[0].Ссылка, Справочники.омг_ШаблоныПротоколов.ПустаяСсылка());

КонецФункции

#КонецОбласти

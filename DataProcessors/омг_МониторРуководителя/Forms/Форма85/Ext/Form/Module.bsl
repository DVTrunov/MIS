&НаСервере
Процедура ЗаполнитьСтатистику()
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПоказателиДляМонитораРуководителя.Показатель КАК Показатель,
	|	ПоказателиДляМонитораРуководителя.Разрез КАК Разрез,
	|	ПоказателиДляМонитораРуководителя.ТипУслуги КАК ТипУслуги,
	|	ПоказателиДляМонитораРуководителя.ТипОплаты КАК ТипОплаты,
	|	СУММА(ПоказателиДляМонитораРуководителя.Значение) КАК Значение,
	|	НАЧАЛОПЕРИОДА(ПоказателиДляМонитораРуководителя.Период, МЕСЯЦ) КАК Месяц,
	|	ПоказателиДляМонитораРуководителя.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.омг_ПоказателиДляМонитораРуководителя КАК ПоказателиДляМонитораРуководителя
	|ГДЕ
	|	ПоказателиДляМонитораРуководителя.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПоказателиДляМонитораРуководителя.Организация В(&МассивОрганизаций)
	|	И ПоказателиДляМонитораРуководителя.МедицинскийЦентр = &МедицинскийЦентр
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ПоказателиДляМонитораРуководителя.Период, МЕСЯЦ),
	|	ПоказателиДляМонитораРуководителя.Показатель,
	|	ПоказателиДляМонитораРуководителя.Разрез,
	|	ПоказателиДляМонитораРуководителя.ТипУслуги,
	|	ПоказателиДляМонитораРуководителя.ТипОплаты,
	|	ПоказателиДляМонитораРуководителя.МедицинскийЦентр,
	|	ПоказателиДляМонитораРуководителя.Организация";
	
	
	Если ЗначениеЗаполнено(Филиал) Тогда
		МассивОрганизаций = Новый Массив;
		МассивОрганизаций.Добавить(Филиал);
	Иначе
		МассивОрганизаций = ПолучитьМассивОрганизаций();
	КонецЕсли;
	
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода);
	Запрос.УстановитьПараметр("КонецПериода", КонецГода);
	Запрос.УстановитьПараметр("МассивОрганизаций", МассивОрганизаций);
	Запрос.УстановитьПараметр("МедицинскийЦентр", МедицинскийЦентр);
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ПоказательСреднийЧек = Справочники.ПоказателиПланирования.СреднийЧек;
	ПоказательДоход = Справочники.ПоказателиПланирования.Доход;
	ПоказательКоличествоВизитов = Справочники.ПоказателиПланирования.КоличествоВизитов;
	ПоказательКоличествоУникальныхПациентов = Справочники.ПоказателиПланирования.КоличествоУникальныхПациентов;	
	ПоказательКоличествоПостоянныхПациентов = Справочники.ПоказателиПланирования.КоличествоПостоянныхПациентов;
	ПоказательПроцентПовторныхПосещений = Справочники.ПоказателиПланирования.ПроцентПовторныхПосещений;
	ПоказательПроцентПостоянныхКлиентов = Справочники.ПоказателиПланирования.ПроцентПостоянныхКлиентов;
	
	
		ГрафикДоходыСтатистика.Обновление = Ложь;
		ГрафикДоходыСтатистика.Очистить();
		ГрафикДоходыСтатистика.АвтоТранспонирование = Ложь;		
        //////////////////// 
		ГрафикСреднийЧекСтатистика.Обновление = Ложь;
		ГрафикСреднийЧекСтатистика.Очистить();
		ГрафикСреднийЧекСтатистика.АвтоТранспонирование = Ложь;		
        //////////////////// 
		ГрафикПосещенийСтатистика.Обновление = Ложь;
		ГрафикПосещенийСтатистика.Очистить();
		ГрафикПосещенийСтатистика.АвтоТранспонирование = Ложь;		

	Пока Выборка.Следующий() Цикл
			Если Выборка.Показатель = ПоказательДоход Тогда
		     	Точка = ГрафикДоходыСтатистика.УстановитьТочку(Выборка.Месяц);
				Точка.Текст = Формат(Выборка.Месяц,"ДФ=ММММ");
				Серия = ГрафикДоходыСтатистика.УстановитьСерию(Выборка.Организация);
				ГрафикДоходыСтатистика.УстановитьЗначение(Точка, Серия, Выборка.Значение);
            ИначеЕсли Выборка.Показатель = ПоказательСреднийЧек Тогда 
		        Точка = ГрафикСреднийЧекСтатистика.УстановитьТочку(Выборка.Месяц);
				Точка.Текст = Формат(Выборка.Месяц,"ДФ=ММММ");
				Серия = ГрафикСреднийЧекСтатистика.УстановитьСерию(Выборка.Организация);
				ГрафикСреднийЧекСтатистика.УстановитьЗначение(Точка, Серия, Выборка.Значение);
			ИначеЕсли Выборка.Показатель = ПоказательКоличествоВизитов Тогда 
		        Точка = ГрафикПосещенийСтатистика.УстановитьТочку(Выборка.Месяц);
				Точка.Текст = Формат(Выборка.Месяц,"ДФ=ММММ");
				Серия = ГрафикПосещенийСтатистика.УстановитьСерию(Выборка.Организация);
				ГрафикПосещенийСтатистика.УстановитьЗначение(Точка, Серия, Выборка.Значение);

             КонецЕсли;
     КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивОрганизаций()
        Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Организации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации";
       	Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		МассивОрганизаций = Новый Массив;
        	Пока Выборка.Следующий() Цикл
                 МассивОрганизаций.Добавить(Выборка.Ссылка);
			 КонецЦикла;
	Возврат МассивОрганизаций;
	
КонецФункции




&НаСервере
Процедура РассчитатьДанныеНаСервере()
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПоказателиДляМонитораРуководителя.Показатель КАК Показатель,
	|	ПоказателиДляМонитораРуководителя.Разрез КАК Разрез,
	|	ПоказателиДляМонитораРуководителя.ТипУслуги КАК ТипУслуги,
	|	ПоказателиДляМонитораРуководителя.ТипОплаты КАК ТипОплаты,
	|	СУММА(ПоказателиДляМонитораРуководителя.Значение) КАК Значение,
	|	НАЧАЛОПЕРИОДА(ПоказателиДляМонитораРуководителя.Период, МЕСЯЦ) КАК Месяц
	|ИЗ
	|	РегистрСведений.омг_ПоказателиДляМонитораРуководителя КАК ПоказателиДляМонитораРуководителя
	|ГДЕ
	|	ПоказателиДляМонитораРуководителя.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПоказателиДляМонитораРуководителя.Организация = &Организация
	|	И ПоказателиДляМонитораРуководителя.МедицинскийЦентр = &МедицинскийЦентр
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ПоказателиДляМонитораРуководителя.Период, МЕСЯЦ),
	|	ПоказателиДляМонитораРуководителя.Показатель,
	|	ПоказателиДляМонитораРуководителя.Разрез,
	|	ПоказателиДляМонитораРуководителя.ТипУслуги,
	|	ПоказателиДляМонитораРуководителя.ТипОплаты,
	|	ПоказателиДляМонитораРуководителя.Организация,
	|	ПоказателиДляМонитораРуководителя.МедицинскийЦентр";
	
	
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Филиал);
	Запрос.УстановитьПараметр("МедицинскийЦентр", МедицинскийЦентр);
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ПоказательСреднийЧек = Справочники.ПоказателиПланирования.СреднийЧек;
	ПоказательДоход = Справочники.ПоказателиПланирования.Доход;
	ПоказательКоличествоВизитов = Справочники.ПоказателиПланирования.КоличествоВизитов;
	ПоказательКоличествоУникальныхПациентов = Справочники.ПоказателиПланирования.КоличествоУникальныхПациентов;	
	ПоказательКоличествоПостоянныхПациентов = Справочники.ПоказателиПланирования.КоличествоПостоянныхПациентов;
	ПоказательПроцентПовторныхПосещений = Справочники.ПоказателиПланирования.ПроцентПовторныхПосещений;
	ПоказательПроцентПостоянныхКлиентов = Справочники.ПоказателиПланирования.ПроцентПостоянныхКлиентов;
	
	Если ВыборМесяц Тогда
		Пока Выборка.Следующий() Цикл
			Если Выборка.Показатель = ПоказательСреднийЧек И Выборка.ТипУслуги = "" И Выборка.ТипОплаты = "" Тогда
				СреднийЧекОбщий = Выборка.Значение;
			ИначеЕсли
				Выборка.Показатель = ПоказательСреднийЧек И Выборка.ТипУслуги = "Лабораторные услуги" И Выборка.ТипОплаты = "" Тогда
				СреднийЧекЛабораторные = Выборка.Значение;
			ИначеЕсли
				Выборка.Показатель = ПоказательСреднийЧек И Выборка.ТипУслуги = "Медицинские услуги" И Выборка.ТипОплаты = "" Тогда
				СреднийЧекМедицинские = Выборка.Значение;
			ИначеЕсли
				Выборка.Показатель = ПоказательСреднийЧек И Выборка.ТипУслуги = "Лабораторные услуги" И Выборка.ТипОплаты = "ГОБМП" Тогда
				СреднийЧекЛабораторныеГОБМП = Выборка.Значение;	
			ИначеЕсли
				Выборка.Показатель = ПоказательСреднийЧек И Выборка.ТипУслуги = "Лабораторные услуги" И Выборка.ТипОплаты = "Платные" Тогда
				СреднийЧекЛабораторныеПлатные = Выборка.Значение;	
			ИначеЕсли
				Выборка.Показатель = ПоказательСреднийЧек И Выборка.ТипУслуги = "Медицинские услуги" И Выборка.ТипОплаты = "ГОБМП" Тогда
				СреднийЧекМедицинскиеГОБМП = Выборка.Значение;	
			ИначеЕсли
				Выборка.Показатель = ПоказательСреднийЧек И Выборка.ТипУслуги = "Медицинские услуги" И Выборка.ТипОплаты = "Платные" Тогда
				СреднийЧекМедицинскиеПлатные = Выборка.Значение;	
			ИначеЕсли 
				Выборка.Показатель = ПоказательДоход И Выборка.ТипУслуги = "" И Выборка.ТипОплаты = "" Тогда
				ДоходыОбщие = Выборка.Значение;	
			ИначеЕсли 
				Выборка.Показатель = ПоказательДоход И Выборка.ТипУслуги = "Лабораторные услуги" И Выборка.ТипОплаты = "" Тогда
				ДоходыЛабораторные = Выборка.Значение;	
			ИначеЕсли 
				Выборка.Показатель = ПоказательДоход И Выборка.ТипУслуги = "Медицинские услуги" И Выборка.ТипОплаты = "" Тогда
				ДоходыМедицинские = Выборка.Значение;	
			ИначеЕсли 
				Выборка.Показатель = ПоказательДоход И Выборка.ТипУслуги = "Лабораторные услуги" И Выборка.ТипОплаты = "ГОБМП" Тогда
				ДоходыЛабораторныеГОБМП = Выборка.Значение;		
			ИначеЕсли 
				Выборка.Показатель = ПоказательДоход И Выборка.ТипУслуги = "Лабораторные услуги" И Выборка.ТипОплаты = "Платные" Тогда
				ДоходыЛабораторныеПлатные = Выборка.Значение;	
			ИначеЕсли
				Выборка.Показатель = ПоказательДоход И Выборка.ТипУслуги = "Медицинские услуги" И Выборка.ТипОплаты = "ГОБМП" Тогда
				ДоходыМедицинскиеГОБМП = Выборка.Значение;	
			ИначеЕсли
				Выборка.Показатель = ПоказательДоход И Выборка.ТипУслуги = "Медицинские услуги" И Выборка.ТипОплаты = "Платные" Тогда
				ДоходыМедицинскиеПлатные = Выборка.Значение;	
			ИначеЕсли 
				Выборка.Показатель = ПоказательКоличествоВизитов Тогда
				КоличествоВизитов = Выборка.Значение;
			ИначеЕсли 
				Выборка.Показатель = ПоказательКоличествоУникальныхПациентов Тогда
				КоличествоПациентов = Выборка.Значение;	
			ИначеЕсли 
				Выборка.Показатель = ПоказательКоличествоПостоянныхПациентов Тогда
				КоличествоПостоянныхПациентов = Выборка.Значение;
			ИначеЕсли 
				Выборка.Показатель = ПоказательПроцентПовторныхПосещений Тогда
				ПроцентПовторныхПосещений = Выборка.Значение;
			ИначеЕсли 
				Выборка.Показатель = ПоказательПроцентПостоянныхКлиентов Тогда
				ПроцентПостоянныхКлиентов = Выборка.Значение;
			КонецЕсли;	
		КонецЦикла;
	Иначе          
		////////////////////////
		ГрафикДоходыГлав.Обновление = Ложь;
		ГрафикДоходыГлав.Очистить();
		ГрафикДоходыГлав.АвтоТранспонирование = Ложь;
		////////////////////////
		ГрафикСреднийЧекГлав.Обновление = Ложь;
		ГрафикСреднийЧекГлав.Очистить();
		ГрафикСреднийЧекГлав.АвтоТранспонирование = Ложь;
		////////////////////////
		ДоляУслугВВыручкеДлительныйПериод.Обновление = Ложь;
		ДоляУслугВВыручкеДлительныйПериод.Очистить();
		ДоляУслугВВыручкеДлительныйПериод.АвтоТранспонирование = Ложь;
		
		
		
		Пока Выборка.Следующий() Цикл
			Если Выборка.Показатель = ПоказательСреднийЧек И Выборка.ТипУслуги = "" И Выборка.ТипОплаты = "" Тогда
				
				Точка = ГрафикСреднийЧекГлав.УстановитьТочку(Выборка.Месяц);
				Точка.Текст = Формат(Выборка.Месяц,"ДФ=ММММ");
				СерияСреднийЧекОбщий = ГрафикСреднийЧекГлав.УстановитьСерию("Средний чек");
				//СерияСреднийЧекОбщий.Текст = "Средний чек";
				ГрафикСреднийЧекГлав.УстановитьЗначение(Точка, СерияСреднийЧекОбщий, Выборка.Значение);
				
			ИначеЕсли

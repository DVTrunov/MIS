	//|	И ПоказателиДляМонитораРуководителя.МедицинскийЦентр = &МедицинскийЦентр
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ПоказателиДляМонитораРуководителя.Период, МЕСЯЦ),
	|	ПоказателиДляМонитораРуководителя.Показатель,
	|	ПоказателиДляМонитораРуководителя.Разрез,
	|	ПоказателиДляМонитораРуководителя.ТипУслуги,
	|	ПоказателиДляМонитораРуководителя.ТипОплаты,
	|	ПоказателиДляМонитораРуководителя.Организация,
	|	ПоказателиДляМонитораРуководителя.МедицинскийЦентр";
	
	
	ПоказательСреднийЧек = Справочники.ПоказателиПланирования.СреднийЧек;
	ПоказательДоход = Справочники.ПоказателиПланирования.Доход;
	ПоказательКоличествоВизитов = Справочники.ПоказателиПланирования.КоличествоВизитов;
	ПоказательКоличествоУникальныхПациентов = Справочники.ПоказателиПланирования.КоличествоУникальныхПациентов;	
	ПоказательКоличествоПостоянныхПациентов = Справочники.ПоказателиПланирования.КоличествоПостоянныхПациентов;
	ПоказательПроцентПовторныхПосещений = Справочники.ПоказателиПланирования.ПроцентПовторныхПосещений;
	ПоказательПроцентПостоянныхКлиентов = Справочники.ПоказателиПланирования.ПроцентПостоянныхКлиентов;
	ПоказательПервичныхПриемов = Справочники.ПоказателиПланирования.КоличествоПервичныхПриемов;
	ПоказательПовторныхПриемов = Справочники.ПоказателиПланирования.КоличествоПовторныхПриемов;
	ПоказательНовыйКлиентов = Справочники.ПоказателиПланирования.КоличествоНовыхПациентов;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("ТипУслуги", "");
	Запрос.УстановитьПараметр("ТипОплаты", "");
	Запрос.УстановитьПараметр("Организация", "");
	//Запрос.УстановитьПараметр("МедицинскийЦентр", МедицинскийЦентр);
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать(); 
	
	
	
	ГрафикДоходов.Обновление = Ложь;
	ГрафикДоходов.Очистить();
	ГрафикДоходов.АвтоТранспонирование = Ложь;
	/////////////////////
	ГрафикСреднийЧек.Обновление = Ложь;
	ГрафикСреднийЧек.Очистить();
	ГрафикСреднийЧек.АвтоТранспонирование = Ложь;    
	
	ДанныеПоАналитикеПациентов.Очистить();
	Пока Выборка.Следующий() Цикл
		Если ПоВсейГруппеКомпаний Тогда
			Если Выборка.Показатель = ПоказательДоход И ЗначениеЗаполнено(Выборка.Организация) И НЕ ЗначениеЗаполнено(Выборка.МедицинскийЦентр) Тогда 
				Точка = ГрафикДоходов.УстановитьТочку(Выборка.Месяц);
				Точка.Текст = Формат(Выборка.Месяц,"ДФ=ММММ");
				Серия = ГрафикДоходов.УстановитьСерию(Выборка.Организация);
				ГрафикДоходов.УстановитьЗначение(Точка, Серия, Выборка.Значение);
			ИначеЕсли Выборка.Показатель = ПоказательСреднийЧек И ЗначениеЗаполнено(Выборка.Организация) И НЕ ЗначениеЗаполнено(Выборка.МедицинскийЦентр) Тогда 
				Точка = ГрафикСреднийЧек.УстановитьТочку(Выборка.Месяц);
				Точка.Текст = Формат(Выборка.Месяц,"ДФ=ММММ");
				Серия = ГрафикСреднийЧек.УстановитьСерию(Выборка.Организация);
				ГрафикСреднийЧек.УстановитьЗначение(Точка, Серия, Выборка.Значение);
			ИначеЕсли Выборка.Показатель = ПоказательКоличествоВизитов ИЛИ 
				Выборка.Показатель = ПоказательКоличествоУникальныхПациентов ИЛИ 
				Выборка.Показатель = ПоказательКоличествоПостоянныхПациентов ИЛИ 
				Выборка.Показатель = ПоказательПроцентПовторныхПосещений ИЛИ 
				Выборка.Показатель = ПоказательПроцентПостоянныхКлиентов ИЛИ
				Выборка.Показатель = ПоказательПервичныхПриемов ИЛИ
				Выборка.Показатель = ПоказательПовторныхПриемов ИЛИ
				Выборка.Показатель = ПоказательНовыйКлиентов Тогда
				НоваяСтрока = ДанныеПоАналитикеПациентов.Добавить();
				НоваяСтрока.Период = Выборка.Месяц;
				НоваяСтрока.Филиал = ВЫборка.Организация;
				НоваяСтрока.Показатель = Выборка.Показатель;
				НоваяСтрока.Значение = Выборка.Значение;
				НоваяСтрока.МедицинскийЦентр = Выборка.МедицинскийЦентр;
				
			КонецЕсли;
		ИначеЕсли ПоФилиалу Тогда
			Если Выборка.Организация = Филиал И Выборка.Показатель = ПоказательДоход И ЗначениеЗаполнено(Выборка.МедицинскийЦентр)  Тогда 
				Точка = ГрафикДоходов.УстановитьТочку(Выборка.Месяц);
				Точка.Текст = Формат(Выборка.Месяц,"ДФ=ММММ");
				Серия = ГрафикДоходов.УстановитьСерию(Выборка.МедицинскийЦентр);
				ГрафикДоходов.УстановитьЗначение(Точка, Серия, Выборка.Значение);
			ИначеЕсли Выборка.Организация = Филиал И Выборка.Показатель = ПоказательСреднийЧек И ЗначениеЗаполнено(Выборка.МедицинскийЦентр) Тогда 
				Точка = ГрафикСреднийЧек.УстановитьТочку(Выборка.Месяц);
				Точка.Текст = Формат(Выборка.Месяц,"ДФ=ММММ");
				Серия = ГрафикСреднийЧек.УстановитьСерию(Выборка.МедицинскийЦентр);
				ГрафикСреднийЧек.УстановитьЗначение(Точка, Серия, Выборка.Значение);
			ИначеЕсли Выборка.Показатель = ПоказательКоличествоВизитов ИЛИ 
				Выборка.Показатель = ПоказательКоличествоУникальныхПациентов ИЛИ 
				Выборка.Показатель = ПоказательКоличествоПостоянныхПациентов ИЛИ 
				Выборка.Показатель = ПоказательПроцентПовторныхПосещений ИЛИ 
				Выборка.Показатель = ПоказательПроцентПостоянныхКлиентов ИЛИ
				Выборка.Показатель = ПоказательПервичныхПриемов ИЛИ
				Выборка.Показатель = ПоказательПовторныхПриемов ИЛИ
				Выборка.Показатель = ПоказательНовыйКлиентов Тогда
				НоваяСтрока = ДанныеПоАналитикеПациентов.Добавить();
				НоваяСтрока.Период = Выборка.Месяц;
				НоваяСтрока.Филиал = ВЫборка.Организация;
				НоваяСтрока.Показатель = Выборка.Показатель;
				НоваяСтрока.Значение = Выборка.Значение;
				НоваяСтрока.МедицинскийЦентр = Выборка.МедицинскийЦентр;
			КонецЕсли;
		ИначеЕсли ПоМедицинскомуЦентру Тогда
			Если Выборка.Показатель = ПоказательКоличествоВизитов ИЛИ 
				Выборка.Показатель = ПоказательКоличествоУникальныхПациентов ИЛИ 
				Выборка.Показатель = ПоказательКоличествоПостоянныхПациентов ИЛИ 
				Выборка.Показатель = ПоказательПроцентПовторныхПосещений ИЛИ 
				Выборка.Показатель = ПоказательПроцентПостоянныхКлиентов ИЛИ
				Выборка.Показатель = ПоказательПервичныхПриемов ИЛИ
				Выборка.Показатель = ПоказательПовторныхПриемов ИЛИ
				Выборка.Показатель = ПоказательНовыйКлиентов Тогда
				НоваяСтрока = ДанныеПоАналитикеПациентов.Добавить();
				НоваяСтрока.Период = Выборка.Месяц;
				НоваяСтрока.Филиал = ВЫборка.Организация;
				НоваяСтрока.Показатель = Выборка.Показатель;
				НоваяСтрока.Значение = Выборка.Значение;
				НоваяСтрока.МедицинскийЦентр = Выборка.МедицинскийЦентр;
			КонецЕсли;
			
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


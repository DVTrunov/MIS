&НаСервере
Функция ПолучитьПереченьПоказателейНаСервере()
	
	ПереченьПоказателей = Новый Структура;
	ПереченьПоказателей.Вставить("ПоказательСреднийЧек", Справочники.ПоказателиПланирования.СреднийЧек);
	ПереченьПоказателей.Вставить("ПоказательДоход", Справочники.ПоказателиПланирования.Доход);
	ПереченьПоказателей.Вставить("ПоказательКоличествоВизитов", Справочники.ПоказателиПланирования.КоличествоВизитов);
	ПереченьПоказателей.Вставить("ПоказательКоличествоУникальныхПациентов", Справочники.ПоказателиПланирования.КоличествоУникальныхПациентов);
	ПереченьПоказателей.Вставить("ПоказательКоличествоПостоянныхПациентов", Справочники.ПоказателиПланирования.КоличествоПостоянныхПациентов);
	ПереченьПоказателей.Вставить("ПоказательПроцентПовторныхПосещений", Справочники.ПоказателиПланирования.ПроцентПовторныхПосещений);
	ПереченьПоказателей.Вставить("ПоказательПроцентПостоянныхКлиентов", Справочники.ПоказателиПланирования.ПроцентПостоянныхКлиентов);
	ПереченьПоказателей.Вставить("ПоказательКоличествоПервичныхПриемов", Справочники.ПоказателиПланирования.КоличествоПервичныхПриемов);
	ПереченьПоказателей.Вставить("ПоказательКоличествоПовторныхПриемов", Справочники.ПоказателиПланирования.КоличествоПовторныхПриемов);
	ПереченьПоказателей.Вставить("ПоказательКоличествоНовыхКлиентов", Справочники.ПоказателиПланирования.КоличествоНовыхПациентов);
	Возврат ПереченьПоказателей
КонецФункции

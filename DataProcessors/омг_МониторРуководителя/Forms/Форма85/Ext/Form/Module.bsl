Процедура УстановитьПериод(НомерКвартала, НомерПолугодия, ТипПериода)
	
	ТекущийГод = Год(ТекущаяДата());
	Если ТипПериода = "Квартал" Тогда
		НачальныйМесяц = (НомерКвартала - 1) * 3 + 1;
		НачалоПериода = Дата(ТекущийГод, НачальныйМесяц, 1);
		КонечныйМесяц = НачальныйМесяц + 2;
		КонецПериода = КонецМесяца(Дата(ТекущийГод, КонечныйМесяц, 1));
	ИначеЕсли
		ТипПериода = "Полугодие" Тогда
		НачальныйМесяц = (НомерПолугодия - 1) * 6 + 1;
		НачалоПериода = Дата(ТекущийГод, НачальныйМесяц, 1);
		КонечныйМесяц = НачальныйМесяц + 5;
		КонецПериода = КонецМесяца(Дата(ТекущийГод, КонечныйМесяц, 1));
	ИначеЕсли
		ТипПериода = "Месяц" Тогда
		НачалоПериода = НачалоМесяца(Месяц);
		КонецПериода = КонецМесяца(Месяц);
	ИначеЕсли
		ТипПериода = "Год" Тогда
		НачалоПериода = НачалоГода(ТекущаяДата());
		КонецПериода = КонецГода(ТекущаяДата());
	КонецЕсли;
	
КонецПроцедуры





&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Месяц = НачалоМесяца(ТекущаяДата());
	НачалоГода = НачалоГода(ТекущаяДата());
	КонецГода = КонецГода(ТекущаяДата());
	УстановитьПериод(Неопределено, Неопределено, "Месяц");
	ПоВсейГруппеКомпаний = Истина;
	ПоФилиалу = Ложь;
	ПоМедицинскомуЦентру = Ложь;
	ВыборМесяц = Истина;
	ВыборКвартал = Ложь;
	ВыборПолугодие = Ложь;
	ВыборГод = Ложь;
	ПроизвольныйПериод = Ложь;
	ПризнакГрафикДоходов = Истина;
	ПризнакГрафикСрЧеки = Ложь;
	ОбновитьВидимостьЭлементов();
	ОбновитьВидимостьГрафиков();
	ОбновитьПодсветкуЭлементов();
	Элементы.ВерхняяЧастьОП.Видимость = Ложь;
	Элементы.НижняяЧастьОП.Видимость = Ложь;
	Элементы.СтатистическиеДанные.Видимость = Ложь;
	Элементы.АналитикаКлиентскойБазы.Видимость = Ложь;
	ПризнакГрафикДоходыГлав = Истина;
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()
	Если ПоФилиалу = Истина Тогда
		Элементы.Филиал.Видимость = Истина;
	Иначе
		Элементы.Филиал.Видимость = Ложь;
	КонецЕсли;
	///////////////
	Если ПоМедицинскомуЦентру = Истина Тогда
		Элементы.МедицинскийЦентр.Видимость = Истина;
	Иначе
		Элементы.МедицинскийЦентр.Видимость = Ложь;
	КонецЕсли;
	///////////////
	Если ВыборМесяц = Истина Тогда
		IКвартал = Ложь;
		IIКвартал = Ложь;
		IIIКвартал = Ложь;
		IVКвартал = Ложь;
		IПолугодие = Ложь;
		IIПолугодие = Ложь;
		Элементы.ГруппаМесяц.Видимость = Истина;
	Иначе
		Элементы.ГруппаМесяц.Видимость = Ложь;
	КонецЕсли;
	///////////////
	Если ВыборКвартал = Истина Тогда
		IПолугодие = Ложь;
		IIПолугодие = Ложь;
		Элементы.ГруппаКвартал.Видимость = Истина;
		
	Иначе
		Элементы.ГруппаКвартал.Видимость = Ложь;
	КонецЕсли;
	///////////////
	Если ВыборПолугодие = Истина Тогда
		IКвартал = Ложь;
		IIКвартал = Ложь;
		IIIКвартал = Ложь;
		IVКвартал = Ложь;
		Элементы.ГруппаПолугодие.Видимость = Истина;
	Иначе
		Элементы.ГруппаПолугодие.Видимость = Ложь;
	КонецЕсли;
	///////////////
	Если ПроизвольныйПериод = Истина Тогда
		IКвартал = Ложь;
		IIКвартал = Ложь;
		IIIКвартал = Ложь;
		IVКвартал = Ложь;
		IПолугодие = Ложь;
		IIПолугодие = Ложь;	
		Элементы.ГруппаПроизвольный.Видимость = Истина;
	Иначе
		Элементы.ГруппаПроизвольный.Видимость = Ложь;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПодсветкуЭлементов()
	Если ПоВсейГруппеКомпаний = Истина Тогда
		Элементы.ПоВсейГруппеКомпаний.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.ПоВсейГруппеКомпаний.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ПоФилиалу = Истина Тогда
		Элементы.ПоФилиалу.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.ПоФилиалу.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ПоМедицинскомуЦентру = Истина Тогда
		Элементы.ПоМедицинскомуЦентру.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.ПоМедицинскомуЦентру.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ВыборМесяц = Истина Тогда
		Элементы.ВыборМесяц.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.ВыборМесяц.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ВыборКвартал = Истина Тогда
		Элементы.ВыборКвартал.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.ВыборКвартал.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ВыборПолугодие = Истина Тогда
		Элементы.ВыборПолугодие.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.ВыборПолугодие.ЦветФона = Новый Цвет();
	КонецЕсли;
	Если ВыборГод = Истина Тогда
		Элементы.ВыборГод.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.ВыборГод.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ПроизвольныйПериод = Истина Тогда
		Элементы.ПроизвольныйПериод.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.ПроизвольныйПериод.ЦветФона = Новый Цвет();
	КонецЕсли; 
	///////////////
	Если IКвартал = Истина Тогда
		Элементы.IКвартал.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.IКвартал.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если IIКвартал = Истина Тогда
		Элементы.IIКвартал.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.IIКвартал.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если IIIКвартал = Истина Тогда
		Элементы.IIIКвартал.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.IIIКвартал.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если IVКвартал = Истина Тогда
		Элементы.IVКвартал.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.IVКвартал.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если IПолугодие = Истина Тогда
		Элементы.IПолугодие.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.IПолугодие.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если IIПолугодие = Истина Тогда
		Элементы.IIПолугодие.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.IIПолугодие.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ПризнакГрафикДоходов = Истина Тогда
		Элементы.КомандаГрафикДоходов.ЦветФона = WebЦвета.Желтый;
	Иначе
		Элементы.КомандаГрафикДоходов.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ПризнакГрафикСрЧеки = Истина Тогда
		Элементы.КомандаСредниеЧеки.ЦветФона = WebЦвета.Желтый;
	Иначе                                                           
		Элементы.КомандаСредниеЧеки.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ПризнакАналитикаПоПациентам = Истина Тогда
		Элементы.ГрафикАналитикаПациентов.ЦветФона = WebЦвета.Желтый;
	Иначе                                                           
		Элементы.ГрафикАналитикаПациентов.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ПризнакГрафикДоходыГлав = Истина Тогда
		Элементы.КомандаГрафикДоходыГлав.ЦветФона = WebЦвета.Желтый;
	Иначе                                                           
		Элементы.КомандаГрафикДоходыГлав.ЦветФона = Новый Цвет();
	КонецЕсли;
	///////////////
	Если ПризнакГрафикСреднийЧекГлав = Истина Тогда
		Элементы.КомандаГрафикСреднийЧекГлав.ЦветФона = WebЦвета.Желтый;
	Иначе                                                           
		Элементы.КомандаГрафикСреднийЧекГлав.ЦветФона = Новый Цвет();
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьГрафиков()
	Если ПризнакГрафикДоходов = Истина Тогда
		Элементы.ГрафикДоходов.Видимость = Истина
	Иначе
		Элементы.ГрафикДоходов.Видимость = Ложь
	КонецЕсли;
	////////////////////
	Если ПризнакГрафикСрЧеки = Истина Тогда
		Элементы.ГрафикСреднийЧек.Видимость = Истина
	Иначе
		Элементы.ГрафикСреднийЧек.Видимость = Ложь
	КонецЕсли;
	////////////////////
	Если ПризнакАналитикаПоПациентам = Истина Тогда
		Элементы.ГрафикПосещенийИПациентовИПостоянных.Видимость = Истина;
		Элементы.ГрафикПроцентовПовторныхПациентовИПостоянных.Видимость = Истина;
		Если ПоВсейГруппеКомпаний Тогда
			Элементы.ФилиалДляАналитикиПоПациентам.Видимость = Истина;
			Элементы.МедицинскийЦентрДляАналитикиПоПациентам.Видимость = Ложь;
			
		ИначеЕсли ПоФилиалу Тогда
			Элементы.ФилиалДляАналитикиПоПациентам.Видимость = Ложь;
			Элементы.МедицинскийЦентрДляАналитикиПоПациентам.Видимость = Истина;
		КонецЕсли;
	Иначе
		Элементы.ГрафикПосещенийИПациентовИПостоянных.Видимость = Ложь;
		Элементы.ГрафикПроцентовПовторныхПациентовИПостоянных.Видимость = Ложь;
		Элементы.ФилиалДляАналитикиПоПациентам.Видимость = Ложь;
		Элементы.МедицинскийЦентрДляАналитикиПоПациентам.Видимость = Ложь;
		
	КонецЕсли;
	////////////////////
	Если ПризнакГрафикДоходыГлав = Истина Тогда
		Элементы.ГрафикДоходыГлав.Видимость = Истина
	Иначе
		Элементы.ГрафикДоходыГлав.Видимость = Ложь
	КонецЕсли;
	////////////////////
	Если ПризнакГрафикСреднийЧекГлав = Истина Тогда
		Элементы.ГрафикСреднийЧекГлав.Видимость = Истина
	Иначе
		Элементы.ГрафикСреднийЧекГлав.Видимость = Ложь
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьГруппПриИзмененииНастроек()
	Элементы.ВерхняяЧастьОП.Видимость = Истина;
	Элементы.НижняяЧастьОП.Видимость = Истина;
	Элементы.АналитикаКлиентскойБазы.Видимость = Истина;
	Элементы.СтатистическиеДанные.Видимость = Истина;
	
	Если ВыборМесяц = Истина Тогда
		Элементы.ГруппаГрафикиДоходыИСреднийЧек.Видимость = Ложь;
		Элементы.ГруппаМесячныхПоказателей.Видимость = Истина;
		Элементы.ДоляУслугВВыручкеДлительныйПериод.Видимость = Ложь;
		Элементы.ДоляУслугВВыручке.Видимость = Истина;
		Элементы.ГрафикПервичныхПовторныхПриемовВПериоде.Видимость = Ложь;
		
	Иначе
		Элементы.ДоляУслугВВыручкеДлительныйПериод.Видимость = Истина;
		Элементы.ДоляУслугВВыручке.Видимость = Ложь;
		Элементы.ГрафикПервичныхПовторныхПриемовВПериоде.Видимость = Истина;

		
	КонецЕсли;
	///////////////
	Если ВыборКвартал = Истина Тогда
		Элементы.ГруппаГрафикиДоходыИСреднийЧек.Видимость = Истина;
		Элементы.ГруппаМесячныхПоказателей.Видимость = Ложь;
		
	Иначе
	КонецЕсли;
	///////////////
	Если ВыборПолугодие = Истина Тогда
		Элементы.ГруппаГрафикиДоходыИСреднийЧек.Видимость = Истина;
		Элементы.ГруппаМесячныхПоказателей.Видимость = Ложь;
		
	Иначе
	КонецЕсли;
	///////////////
	Если ВыборГод = Истина Тогда
		Элементы.ГруппаГрафикиДоходыИСреднийЧек.Видимость = Истина;
		Элементы.ГруппаМесячныхПоказателей.Видимость = Ложь;
		
	Иначе
	КонецЕсли;

	///////////////
	Если ПроизвольныйПериод = Истина Тогда
		Элементы.ГруппаГрафикиДоходыИСреднийЧек.Видимость = Истина;
		Элементы.ГруппаМесячныхПоказателей.Видимость = Ложь;
		
	Иначе
	КонецЕсли;
	/////////////////
	Если ПоВсейГруппеКомпаний Тогда
		Элементы.НадписьДляФилиалов.Видимость = Истина;
		Элементы.НадписьДляМедЦентров.Видимость = Ложь;
		Элементы.КомандаГрафикДоходов.Видимость = Истина;
		//Элементы.ГрафикДоходов.Видимость = Истина;
		Элементы.КомандаСредниеЧеки.Видимость = Истина;
		//Элементы.ГрафикСреднийЧек.Видимость = Истина;
		ПризнакГрафикДоходов = Истина;
		ПризнакГрафикСрЧеки = Ложь;
		ПризнакАналитикаПоПациентам = Ложь;
	КонецЕсли;
	/////////////////
	Если ПоФилиалу = Истина Тогда
		Элементы.НадписьДляФилиалов.Видимость = Ложь;
		Элементы.НадписьДляМедЦентров.Видимость = Истина;
		Элементы.КомандаГрафикДоходов.Видимость = Истина;
		//Элементы.ГрафикДоходов.Видимость = Истина;
		Элементы.КомандаСредниеЧеки.Видимость = Истина;
		//Элементы.ГрафикСреднийЧек.Видимость = Истина;
		ПризнакГрафикДоходов = Истина;
		ПризнакГрафикСрЧеки = Ложь;
		ПризнакАналитикаПоПациентам = Ложь;
	КонецЕсли;
	///////////////
	Если ПоМедицинскомуЦентру = Истина Тогда
		Элементы.НадписьДляФилиалов.Видимость = Ложь;
		Элементы.НадписьДляМедЦентров.Видимость = Ложь;
		Элементы.КомандаГрафикДоходов.Видимость = Ложь;
		//Элементы.ГрафикДоходов.Видимость = Ложь;
		Элементы.КомандаСредниеЧеки.Видимость = Ложь;
		//Элементы.ГрафикСреднийЧек.Видимость = Ложь;
		ПризнакГрафикДоходов = Ложь;
		ПризнакГрафикСрЧеки = Ложь;
		ПризнакАналитикаПоПациентам = Истина;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура МесяцРегулирование(Элемент, Направление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Попытка
		Месяц = НачалоМесяца(ДобавитьМесяц(Месяц, Направление));
	Исключение
	КонецПопытки;
	Модифицированность = Истина;
	УстановитьПериод(Неопределено, Неопределено, "Месяц");
КонецПроцедуры

&НаКлиенте
Процедура МесяцПриИзменении(Элемент)
	Месяц = НачалоМесяца(Месяц);
	УстановитьПериод(Неопределено, Неопределено, "Месяц");
КонецПроцедуры

&НаКлиенте
Процедура ВыборМесяц(Команда)
	Месяц = НачалоМесяца(ТекущаяДата());
	ВыборМесяц = Истина;
	ВыборКвартал = Ложь;
	ВыборПолугодие = Ложь; 
	ВыборГод = Ложь;
	ПроизвольныйПериод = Ложь;
	ОбновитьВидимостьЭлементов();
	ОбновитьПодсветкуЭлементов()
КонецПроцедуры

&НаКлиенте
Процедура ВыборКвартал(Команда)
	ВыборМесяц = Ложь;
	ВыборКвартал = Истина;
	ВыборПолугодие = Ложь; 
	ВыборГод = Ложь;
	ПроизвольныйПериод = Ложь;
	ОбновитьВидимостьЭлементов();
	ОбновитьПодсветкуЭлементов()
КонецПроцедуры

&НаКлиенте
Процедура ВыборПолугодие(Команда)
	ВыборМесяц = Ложь;
	ВыборКвартал = Ложь;
	ВыборПолугодие = Истина; 
	ВыборГод = Ложь;
	ПроизвольныйПериод = Ложь;
	ОбновитьВидимостьЭлементов();
	ОбновитьПодсветкуЭлементов()
КонецПроцедуры

&НаКлиенте
Процедура ВыборГод(Команда)
	УстановитьПериод(Неопределено, Неопределено, "Год");
	ВыборМесяц = Ложь;
	ВыборКвартал = Ложь;
	ВыборПолугодие = Ложь; 
	ВыборГод = Истина;
	ПроизвольныйПериод = Ложь;
	ОбновитьВидимостьЭлементов();
	ОбновитьПодсветкуЭлементов()
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольныйПериод(Команда)
	ВыборМесяц = Ложь;
	ВыборКвартал = Ложь;
	ВыборПолугодие = Ложь; 
	ВыборГод = Ложь;
	ПроизвольныйПериод = Истина;
	ОбновитьВидимостьЭлементов();
	ОбновитьПодсветкуЭлементов()
КонецПроцедуры


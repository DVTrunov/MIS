<?xml version="1.0" encoding="UTF-8"?>
<Form xmlns="http://v8.1c.ru/8.3/xcf/logform" xmlns:app="http://v8.1c.ru/8.2/managed-application/core" xmlns:cfg="http://v8.1c.ru/8.1/data/enterprise/current-config" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcssch="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:ent="http://v8.1c.ru/8.1/data/enterprise" xmlns:lf="http://v8.1c.ru/8.2/managed-application/logform" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows" xmlns:xr="http://v8.1c.ru/8.3/xcf/readable" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.16">
	<Title>
		<v8:item>
			<v8:lang>ru</v8:lang>
			<v8:content>Загрузка номенклатуры и складских остатков из 1С:Бухгалтерии предприятия</v8:content>
		</v8:item>
	</Title>
	<AutoTitle>false</AutoTitle>
	<Customizable>false</Customizable>
	<VerticalScroll>useIfNecessary</VerticalScroll>
	<AutoCommandBar name="ФормаКоманднаяПанель" id="-1">
		<Autofill>false</Autofill>
	</AutoCommandBar>
	<ChildItems>
		<InputField name="ПутьКФайлуВыгрузки" id="1">
			<DataPath>ПутьКФайлуВыгрузки</DataPath>
			<Width>60</Width>
			<HorizontalStretch>false</HorizontalStretch>
			<ChoiceButton>true</ChoiceButton>
			<AutoMarkIncomplete>true</AutoMarkIncomplete>
			<ContextMenu name="ПутьКФайлуВыгрузкиКонтекстноеМеню" id="2"/>
			<ExtendedTooltip name="ПутьКФайлуВыгрузкиРасширеннаяПодсказка" id="9"/>
			<Events>
				<Event name="StartChoice">ПутьКФайлуВыгрузкиНачалоВыбора</Event>
			</Events>
		</InputField>
		<InputField name="КатегорияВыработки" id="3">
			<DataPath>КатегорияВыработки</DataPath>
			<Width>60</Width>
			<HorizontalStretch>false</HorizontalStretch>
			<OpenButton>false</OpenButton>
			<ChoiceFoldersAndItems>Items</ChoiceFoldersAndItems>
			<ContextMenu name="КатегорияВыработкиКонтекстноеМеню" id="4"/>
			<ExtendedTooltip name="КатегорияВыработкиРасширеннаяПодсказка" id="10"/>
		</InputField>
		<LabelDecoration name="Описание" id="7">
			<AutoMaxWidth>false</AutoMaxWidth>
			<MaxWidth>80</MaxWidth>
			<Height>9</Height>
			<HorizontalStretch>true</HorizontalStretch>
			<VerticalStretch>true</VerticalStretch>
			<TextColor>web:Navy</TextColor>
			<Font height="10" kind="AutoFont"/>
			<Title formatted="false">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Данная обработка предназначена для первоначальной загрузки номенклатуры и складских остатков из конфигурации 1С:Бухгалтерия предприятия. Перед загрузкой необходимо выгрузить эти данные из бухгалтерской базы, используя специальные правила обмена и обработку "Универсальный обмен данными формате XML". Правила обмена поставляются вместе с данной конфигурации, при установке дистрибутива конфигурации они распаковываются в каталог шаблонов релиза.

Для загрузки требуется указать путь к файлу выгрузки. Следует указать специализацию, которая подставится в созданную при загрузке номенклатуру. Если специализацию не указать, то в созданной номенклатуре это поле будет не заполнено, поэтому в дальнейшем следует его заполнить.</v8:content>
				</v8:item>
			</Title>
			<ContextMenu name="ОписаниеКонтекстноеМеню" id="8"/>
			<ExtendedTooltip name="ОписаниеРасширеннаяПодсказка" id="11"/>
		</LabelDecoration>
		<CommandBar name="ГруппаКнопок" id="6">
			<ExtendedTooltip name="ГруппаКнопокРасширеннаяПодсказка" id="12"/>
			<ChildItems>
				<Button name="ФормаКомандаЗагрузить" id="5">
					<Type>CommandBarButton</Type>
					<DefaultButton>true</DefaultButton>
					<CommandName>Form.Command.КомандаЗагрузить</CommandName>
					<Font height="12" kind="AutoFont"/>
					<ExtendedTooltip name="ФормаКомандаЗагрузитьРасширеннаяПодсказка" id="13"/>
				</Button>
			</ChildItems>
		</CommandBar>
	</ChildItems>
	<Attributes>
		<Attribute name="Объект" id="1">
			<Type>
				<v8:Type>cfg:DataProcessorObject.ЗагрузкаОстатковИзБухгалтерии</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
		</Attribute>
		<Attribute name="КатегорияВыработки" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Специализация новой номенклатуры</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:CatalogRef.КатегорииВыработки</v8:Type>
			</Type>
		</Attribute>
		<Attribute name="ПутьКФайлуВыгрузки" id="3">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Путь к файлу выгрузки из 1С:Бухгалтерии</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>xs:string</v8:Type>
				<v8:StringQualifiers>
					<v8:Length>0</v8:Length>
					<v8:AllowedLength>Variable</v8:AllowedLength>
				</v8:StringQualifiers>
			</Type>
		</Attribute>
	</Attributes>
	<Commands>
		<Command name="КомандаЗагрузить" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Загрузить</v8:content>
				</v8:item>
			</Title>
			<Picture>
				<xr:Ref>StdPicture.GenerateReport</xr:Ref>
				<xr:LoadTransparent>true</xr:LoadTransparent>
			</Picture>
			<Action>КомандаЗагрузить</Action>
			<Representation>TextPicture</Representation>
		</Command>
	</Commands>
</Form>
// Помощник настройки CRM (входящий трафик): что ещё не настроено, основные параметры и быстрые действия.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПрочитатьПараметры();
	ЗаполнитьПроверки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПроверкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаПроверки = Проверки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаПроверки <> Неопределено Тогда
		ВыполнитьДействие(СтрокаПроверки.Действие);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьПроверки(Команда)

	ЗаполнитьПроверки();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьПараметры(Команда)

	ТекстОшибки = СохранитьПараметрыНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Параметры CRM сохранены'"));
	КонецЕсли;
	ЗаполнитьПроверки();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАдрес(Команда)

	Состояние(НСтр("ru = 'Проверка адреса HTTP-сервисов...'"));
	ПоказатьПредупреждение(, ПроверитьАдресНаСервере(АдресHTTPСервисов));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИсточникTilda(Команда)

	ОткрытьНовыйИсточник(ПредопределенноеЗначение("Перечисление.омг_ТипыИсточниковЛидов.Tilda"), НСтр("ru = 'Сайт Tilda'"));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИсточникMeta(Команда)

	ОткрытьНовыйИсточник(ПредопределенноеЗначение("Перечисление.омг_ТипыИсточниковЛидов.Meta"), НСтр("ru = 'Meta Lead Ads'"));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИсточникВебхук(Команда)

	ОткрытьНовыйИсточник(ПредопределенноеЗначение("Перечисление.омг_ТипыИсточниковЛидов.Вебхук"), НСтр("ru = 'Вебхук'"));

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаправления(Команда)

	Количество = НовыеНаправленияПоСпециализациям(Ложь);
	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для всех специализаций направления лидов уже есть.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьНаправленияЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, СтрШаблон(НСтр("ru = 'Будет создано направлений лидов: %1 — по одному на каждую специализацию, для которой его ещё нет.
		|Лишние потом можно пометить на удаление. Продолжить?'"), Количество), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаправленияЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Количество = НовыеНаправленияПоСпециализациям(Истина);
	ПоказатьОповещениеПользователя(СтрШаблон(НСтр("ru = 'Создано направлений лидов: %1'"), Количество));
	ЗаполнитьПроверки();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТиповыеМетки(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗаполнитьТиповыеМеткиЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Будут заполнены «Имя UTM» у источников информации (Instagram, Facebook, TikTok, 2ГИС, Google, Яндекс)
		|и типов рекламы (таргет, контекст, лид-формы, органика). Существующие элементы с тем же названием
		|получат «Имя UTM», недостающие будут созданы. Продолжить?'"), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТиповыеМеткиЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ЗаполнитьТиповыеМеткиНаСервере());
	ЗаполнитьПроверки();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИсточникиТрафика(Команда)

	ВыполнитьДействие("Источники");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНаправления(Команда)

	ВыполнитьДействие("Направления");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРекламныеКампании(Команда)

	ВыполнитьДействие("Кампании");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЛинии(Команда)

	ВыполнитьДействие("Линии");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьДействие(Действие)

	Если Действие = "Адрес" Тогда
		ТекущийЭлемент = Элементы.АдресHTTPСервисов;
	ИначеЕсли Действие = "Задания" Тогда
		ТекущийЭлемент = Элементы.ПроверкаПропущенныхВключена;
	ИначеЕсли Действие = "Направления" Тогда
		ОткрытьФорму("Справочник.омг_НаправленияЛидов.ФормаСписка", , ЭтотОбъект);
	ИначеЕсли Действие = "Источники" Тогда
		ОткрытьФорму("Справочник.омг_ИсточникиТрафика.ФормаСписка", , ЭтотОбъект);
	ИначеЕсли Действие = "ИсточникиИнформации" Тогда
		ОткрытьФорму("Справочник.ИсточникиИнформации.ФормаСписка", , ЭтотОбъект);
	ИначеЕсли Действие = "ТипыРекламы" Тогда
		ОткрытьФорму("Справочник.ТипыРекламы.ФормаСписка", , ЭтотОбъект);
	ИначеЕсли Действие = "Кампании" Тогда
		ОткрытьФорму("Справочник.РекламныеКомпании.ФормаСписка", , ЭтотОбъект);
	ИначеЕсли Действие = "Линии" Тогда
		ОткрытьФорму("РегистрСведений.ПараметрыUTMПоТелефону.ФормаСписка", , ЭтотОбъект);
	ИначеЕсли Действие = "Пользователи" Тогда
		ОткрытьФорму("Справочник.Пользователи.ФормаСписка", , ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНовыйИсточник(ТипИсточника, Наименование)

	ЗначенияЗаполнения = Новый Структура("ТипИсточника, Наименование, Используется", ТипИсточника, Наименование, Истина);
	ОткрытьФорму("Справочник.омг_ИсточникиТрафика.ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьПараметры()

	АдресHTTPСервисов = Константы.омг_ЛидыАдресHTTPСервисов.Получить();
	МинутДоПропуска = Константы.омг_ЛидыМинутДоПропуска.Получить();
	ПопытокДоУпущен = Константы.омг_ЛидыПопытокДоУпущен.Получить();

	УстановитьПривилегированныйРежим(Истина);
	ПроверкаПропущенныхВключена = ЗаданиеВключено(Метаданные.РегламентныеЗадания.омг_ПроверкаПропущенныхЛидов);
	ЗагрузкаMetaВключена = ЗаданиеВключено(Метаданные.РегламентныеЗадания.омг_ЗагрузкаЛидовMeta);
	УстановитьПривилегированныйРежим(Ложь);

	Элементы.ГруппаЗадания.Доступность = ПравоДоступа("Администрирование", Метаданные);

КонецПроцедуры

&НаСервере
Функция СохранитьПараметрыНаСервере()

	Ошибки = Новый Массив;
	Адрес = СокрЛП(АдресHTTPСервисов);
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ЗначениеЗаполнено(Адрес) И Не СтрЗаканчиваетсяНа(НРег(Адрес), "/hs") Тогда
		Ошибки.Добавить(НСтр("ru = 'Адрес HTTP-сервисов обычно заканчивается на /hs, например https://1c.example.kz/base/hs. Проверьте адрес.'"));
	КонецЕсли;
	АдресHTTPСервисов = Адрес;

	Попытка
		Если Константы.омг_ЛидыАдресHTTPСервисов.Получить() <> Адрес Тогда
			Константы.омг_ЛидыАдресHTTPСервисов.Установить(Адрес);
			ОбновитьАдресаИсточников();
		КонецЕсли;
		Константы.омг_ЛидыМинутДоПропуска.Установить(МинутДоПропуска);
		Константы.омг_ЛидыПопытокДоУпущен.Установить(ПопытокДоУпущен);
	Исключение
		Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если ПравоДоступа("Администрирование", Метаданные) Тогда
		Попытка
			ВключитьЗадание(Метаданные.РегламентныеЗадания.омг_ПроверкаПропущенныхЛидов, ПроверкаПропущенныхВключена);
			ВключитьЗадание(Метаданные.РегламентныеЗадания.омг_ЗагрузкаЛидовMeta, ЗагрузкаMetaВключена);
		Исключение
			Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Возврат СтрСоединить(Ошибки, Символы.ПС);

КонецФункции

// Адрес для подключения в источниках пересчитывается при записи источника.
//
&НаСервере
Процедура ОбновитьАдресаИсточников()

	Выборка = Справочники.омг_ИсточникиТрафика.Выбрать();
	Пока Выборка.Следующий() Цикл
		ИсточникОбъект = Выборка.ПолучитьОбъект();
		ИсточникОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВключено(МетаданныеЗадания)

	Задание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеЗадания);
	Возврат Задание <> Неопределено И Задание.Использование;

КонецФункции

&НаСервереБезКонтекста
Процедура ВключитьЗадание(МетаданныеЗадания, Включить)

	Задание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеЗадания);
	Если Задание <> Неопределено И Задание.Использование <> Включить Тогда
		Задание.Использование = Включить;
		Задание.Записать();
	КонецЕсли;

КонецПроцедуры

// Запрос к HTTP-сервису с заведомо несуществующим ключом: опубликованный сервис отвечает 404 «unknown source».
//
&НаСервереБезКонтекста
Функция ПроверитьАдресНаСервере(Знач Адрес)

	Адрес = СокрЛП(Адрес);
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат НСтр("ru = 'Укажите адрес HTTP-сервисов.'");
	КонецЕсли;

	Попытка
		СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес + "/leads/tilda/proverka");
		Защищенное = (НРег(СтруктураАдреса.Схема) = "https");
		Соединение = Новый HTTPСоединение(СтруктураАдреса.Хост, СтруктураАдреса.Порт, , , , 15,
			?(Защищенное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено));
		Путь = СтруктураАдреса.ПутьНаСервере;
		Если Не СтрНачинаетсяС(Путь, "/") Тогда
			Путь = "/" + Путь;
		КонецЕсли;
		Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь));
		Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		Возврат НСтр("ru = 'Сервер не ответил: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + НСтр("ru = 'Если сайт с этим адресом открывается из браузера, возможно, сервер 1С не видит сам себя по внешнему адресу — это не мешает приёму заявок.'");
	КонецПопытки;

	Если Ответ.КодСостояния = 404 И СтрНайти(Строка(Текст), "unknown source") > 0 Тогда
		Возврат НСтр("ru = 'Всё в порядке: HTTP-сервис лидов опубликован и отвечает.'");
	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		Возврат НСтр("ru = 'Сервис требует логин и пароль (401). В публикации HTTP-сервисов должен быть указан пользователь с ролью «Лиды: интеграция (HTTP-сервис)».'");
	ИначеЕсли Ответ.КодСостояния = 403 Тогда
		Возврат НСтр("ru = 'Доступ запрещён (403). У пользователя публикации нет роли «Лиды: интеграция (HTTP-сервис)».'");
	ИначеЕсли Ответ.КодСостояния = 404 Тогда
		Возврат НСтр("ru = 'Адрес не найден (404). Проверьте, что адрес заканчивается на /hs и что при публикации отмечены HTTP-сервисы.'");
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Сервер ответил кодом %1. Проверьте адрес и публикацию.'"), Ответ.КодСостояния);

КонецФункции

&НаСервере
Функция НовыеНаправленияПоСпециализациям(Создавать)

	Если Создавать И Не ПравоДоступа("Добавление", Метаданные.Справочники.омг_НаправленияЛидов) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для добавления направлений лидов'");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Специализации.Ссылка КАК Ссылка,
	|	Специализации.Наименование КАК Наименование
	|ИЗ
	|	Справочник.КатегорииВыработки КАК Специализации
	|ГДЕ
	|	НЕ Специализации.ПометкаУдаления
	|	И НЕ Специализации.ЭтоГруппа
	|	И НЕ Специализации.Ссылка В
	|				(ВЫБРАТЬ
	|					Направления.Специализация
	|				ИЗ
	|					Справочник.омг_НаправленияЛидов КАК Направления
	|				ГДЕ
	|					НЕ Направления.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Создавать Тогда
		Возврат Выборка.Количество();
	КонецЕсли;

	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Направление = Справочники.омг_НаправленияЛидов.СоздатьЭлемент();
		Направление.Наименование = Выборка.Наименование;
		Направление.Специализация = Выборка.Ссылка;
		Направление.Записать();
		Количество = Количество + 1;
	КонецЦикла;
	Возврат Количество;

КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьТиповыеМеткиНаСервере()

	Строки = Новый Массив;
	Источники = Новый Массив;
	Источники.Добавить(Новый Структура("Наименование, ИмяUTM", "Instagram", "instagram"));
	Источники.Добавить(Новый Структура("Наименование, ИмяUTM", "Facebook", "facebook"));
	Источники.Добавить(Новый Структура("Наименование, ИмяUTM", "TikTok", "tiktok"));
	Источники.Добавить(Новый Структура("Наименование, ИмяUTM", "2ГИС", "2gis"));
	Источники.Добавить(Новый Структура("Наименование, ИмяUTM", "Google", "google"));
	Источники.Добавить(Новый Структура("Наименование, ИмяUTM", "Яндекс", "yandex"));
	Строки.Добавить(ЗаполнитьМетки("ИсточникиИнформации", НСтр("ru = 'Источники информации'"), Источники));

	Типы = Новый Массив;
	Типы.Добавить(Новый Структура("Наименование, ИмяUTM", "Таргетированная реклама", "target"));
	Типы.Добавить(Новый Структура("Наименование, ИмяUTM", "Контекстная реклама", "cpc"));
	Типы.Добавить(Новый Структура("Наименование, ИмяUTM", "Лид-формы", "lead_ads"));
	Типы.Добавить(Новый Структура("Наименование, ИмяUTM", "Органика", "organic"));
	Строки.Добавить(ЗаполнитьМетки("ТипыРекламы", НСтр("ru = 'Типы рекламы'"), Типы));

	Строки.Добавить("");
	Строки.Добавить(НСтр("ru = 'Рекламные кампании заводятся вручную: в «Имя UTM» указывается то, что маркетолог пишет в utm_campaign.'"));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Элемент с тем же «Имя UTM» не трогаем; с тем же наименованием и пустым «Имя UTM» — дописываем метку; иначе создаём.
//
&НаСервереБезКонтекста
Функция ЗаполнитьМетки(ИмяСправочника, Представление, Описания)

	Если Не ПравоДоступа("Изменение", Метаданные.Справочники[ИмяСправочника]) Тогда
		Возврат СтрШаблон(НСтр("ru = '%1: недостаточно прав.'"), Представление);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ
	|	Элементы.Ссылка КАК Ссылка,
	|	Элементы.Наименование КАК Наименование,
	|	Элементы.ИмяUTM КАК ИмяUTM
	|ИЗ
	|	Справочник.ИмяСправочника КАК Элементы
	|ГДЕ
	|	НЕ Элементы.ПометкаУдаления", "ИмяСправочника", ИмяСправочника);
	Существующие = Запрос.Выполнить().Выгрузить();

	Создано = 0;
	Дополнено = 0;
	Для Каждого Элемент Из Описания Цикл
		ПоМетке = Неопределено;
		ПоИмени = Неопределено;
		Для Каждого Существующий Из Существующие Цикл
			Если НРег(СокрЛП(Существующий.ИмяUTM)) = Элемент.ИмяUTM Тогда
				ПоМетке = Существующий.Ссылка;
				Прервать;
			ИначеЕсли ПоИмени = Неопределено И Не ЗначениеЗаполнено(Существующий.ИмяUTM)
				И НРег(СокрЛП(Существующий.Наименование)) = НРег(Элемент.Наименование) Тогда
				ПоИмени = Существующий.Ссылка;
			КонецЕсли;
		КонецЦикла;

		Если ПоМетке <> Неопределено Тогда
			Продолжить;
		ИначеЕсли ПоИмени <> Неопределено Тогда
			ЭлементОбъект = ПоИмени.ПолучитьОбъект();
			ЭлементОбъект.ИмяUTM = Элемент.ИмяUTM;
			ЭлементОбъект.Записать();
			Дополнено = Дополнено + 1;
		Иначе
			ЭлементОбъект = Справочники[ИмяСправочника].СоздатьЭлемент();
			ЭлементОбъект.Наименование = Элемент.Наименование;
			ЭлементОбъект.ИмяUTM = Элемент.ИмяUTM;
			ЭлементОбъект.Записать();
			Создано = Создано + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = '%1: создано %2, дополнено «Имя UTM» %3.'"), Представление, Создано, Дополнено);

КонецФункции

&НаСервере
Процедура ЗаполнитьПроверки()

	Проверки.Очистить();

	Адрес = Константы.омг_ЛидыАдресHTTPСервисов.Получить();
	ДобавитьПроверку("Основное", НСтр("ru = 'Адрес HTTP-сервисов базы (для вебхуков Tilda и Meta)'"),
		ЗначениеЗаполнено(Адрес), "Адрес", ?(ЗначениеЗаполнено(Адрес), Адрес, НСтр("ru = 'Не указан'")));

	УстановитьПривилегированныйРежим(Истина);
	Включено = ЗаданиеВключено(Метаданные.РегламентныеЗадания.омг_ПроверкаПропущенныхЛидов);
	УстановитьПривилегированныйРежим(Ложь);
	ДобавитьПроверку("Основное", НСтр("ru = 'Регламентное задание «Проверка пропущенных лидов»'"), Включено, "Задания",
		?(Включено, НСтр("ru = 'Включено'"), НСтр("ru = 'Выключено: лиды не будут становиться «Пропущен» по времени'")));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Всего,
	|	СУММА(ВЫБОР
	|			КОГДА Направления.Специализация = ЗНАЧЕНИЕ(Справочник.КатегорииВыработки.ПустаяСсылка)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК БезСпециализации
	|ИЗ
	|	Справочник.омг_НаправленияЛидов КАК Направления
	|ГДЕ
	|	НЕ Направления.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Источники.Ссылка КАК Ссылка,
	|	Источники.Наименование КАК Наименование,
	|	Источники.ТипИсточника КАК ТипИсточника,
	|	Источники.Используется КАК Используется,
	|	Источники.АдресДляПодключения КАК Адрес,
	|	Источники.ИдентификаторСтраницы КАК ИдентификаторСтраницы,
	|	Источники.ИсточникИнформации КАК ИсточникИнформации,
	|	ЕСТЬNULL(Состояние.Результат, """") КАК РезультатЗагрузки
	|ИЗ
	|	Справочник.омг_ИсточникиТрафика КАК Источники
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.омг_СостояниеЗагрузкиЛидов КАК Состояние
	|		ПО Источники.Ссылка = Состояние.ИсточникТрафика
	|ГДЕ
	|	НЕ Источники.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ИсточникиИнформации"" КАК ИмяСправочника,
	|	КОЛИЧЕСТВО(*) КАК СМеткой
	|ИЗ
	|	Справочник.ИсточникиИнформации КАК Элементы
	|ГДЕ
	|	НЕ Элементы.ПометкаУдаления
	|	И Элементы.ИмяUTM <> """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ТипыРекламы"",
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.ТипыРекламы КАК Элементы
	|ГДЕ
	|	НЕ Элементы.ПометкаУдаления
	|	И Элементы.ИмяUTM <> """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Кампании"",
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.РекламныеКомпании КАК Элементы
	|ГДЕ
	|	НЕ Элементы.ПометкаУдаления
	|	И Элементы.ИмяUTM <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Линии.НомерТелефона) КАК Количество
	|ИЗ
	|	РегистрСведений.ПараметрыUTMПоТелефону КАК Линии";
	УстановитьПривилегированныйРежим(Истина);
	Результаты = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);

	// Направления
	Направления = Результаты[0].Выбрать();
	Направления.Следующий();
	Всего = ?(Направления.Всего = NULL, 0, Направления.Всего);
	БезСпециализации = ?(Направления.БезСпециализации = NULL, 0, Направления.БезСпециализации);
	ДобавитьПроверку("Направления", НСтр("ru = 'Направления лидов (УЗИ, Гинекология и т.п.) с синонимами названий услуг с сайта'"),
		Всего > 0, "Направления", ?(Всего = 0, НСтр("ru = 'Нет ни одного: значения с форм уходят в комментарий'"),
		СтрШаблон(НСтр("ru = 'Направлений: %1'"), Всего)));
	Если БезСпециализации > 0 Тогда
		ДобавитьПроверку("Направления", НСтр("ru = 'Направления без специализации (нужна для записи на приём)'"), Ложь, "Направления",
			СтрШаблон(НСтр("ru = 'Без специализации: %1'"), БезСпециализации));
	КонецЕсли;

	// Источники трафика
	ТаблицаИсточников = Результаты[1].Выгрузить();
	Активных = 0;
	ЕстьMeta = Ложь;
	Для Каждого Источник Из ТаблицаИсточников Цикл
		Если Не Источник.Используется Тогда
			Продолжить;
		КонецЕсли;
		Активных = Активных + 1;
		Если Источник.ТипИсточника = Перечисления.омг_ТипыИсточниковЛидов.Meta Тогда
			ЕстьMeta = Истина;
			УстановитьПривилегированныйРежим(Истина);
			ЕстьТокен = ЗначениеЗаполнено(
				ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Источник.Ссылка, "ТокенДоступа"));
			УстановитьПривилегированныйРежим(Ложь);
			Готов = ЗначениеЗаполнено(Источник.ИдентификаторСтраницы) И ЕстьТокен
				И Не СтрНачинаетсяС(Источник.РезультатЗагрузки, НСтр("ru = 'Ошибка'"));
			Если Не ЗначениеЗаполнено(Источник.ИдентификаторСтраницы) Тогда
				Пояснение = НСтр("ru = 'Не указан ID страницы Facebook'");
			ИначеЕсли Не ЕстьТокен Тогда
				Пояснение = НСтр("ru = 'Не указан токен доступа (команда «Указать токен доступа» в карточке)'");
			ИначеЕсли ЗначениеЗаполнено(Источник.РезультатЗагрузки) Тогда
				Пояснение = Источник.РезультатЗагрузки;
			Иначе
				Пояснение = НСтр("ru = 'Загрузок ещё не было'");
			КонецЕсли;
		Иначе
			Готов = ЗначениеЗаполнено(Источник.Адрес);
			Пояснение = ?(Готов, Источник.Адрес, НСтр("ru = 'Нет адреса вебхука: заполните адрес HTTP-сервисов и перезапишите источник'"));
		КонецЕсли;
		Если Готов И Не ЗначениеЗаполнено(Источник.ИсточникИнформации) Тогда
			Готов = Ложь;
			Пояснение = НСтр("ru = 'Не указан источник информации — лиды без меток останутся без источника'");
		КонецЕсли;
		ДобавитьПроверку("Источники трафика", СтрШаблон("%1 (%2)", Источник.Наименование, Источник.ТипИсточника),
			Готов, "Источники", Пояснение);
	КонецЦикла;
	Если Активных = 0 Тогда
		ДобавитьПроверку("Источники трафика", НСтр("ru = 'Источники трафика (сайт, Meta, вебхук)'"), Ложь, "Источники",
			НСтр("ru = 'Нет ни одного используемого источника'"));
	КонецЕсли;
	Если ЕстьMeta Тогда
		УстановитьПривилегированныйРежим(Истина);
		Включено = ЗаданиеВключено(Метаданные.РегламентныеЗадания.омг_ЗагрузкаЛидовMeta);
		УстановитьПривилегированныйРежим(Ложь);
		ДобавитьПроверку("Источники трафика", НСтр("ru = 'Регламентное задание «Загрузка лидов из Meta Lead Ads»'"), Включено,
			"Задания", ?(Включено, НСтр("ru = 'Включено'"), НСтр("ru = 'Выключено: лиды из Meta не загружаются'")));
	КонецЕсли;

	// Метки UTM
	Метки = Новый Соответствие;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Метки.Вставить(Выборка.ИмяСправочника, Выборка.СМеткой);
	КонецЦикла;
	Для Каждого Описание Из СтрРазделить("ИсточникиИнформации|Источники информации|utm_source;ТипыРекламы|Типы рекламы|utm_medium;Кампании|Рекламные кампании|utm_campaign", ";") Цикл
		Части = СтрРазделить(Описание, "|");
		Количество = ?(Метки.Получить(Части[0]) = Неопределено, 0, Метки.Получить(Части[0]));
		ДобавитьПроверку("Метки UTM", СтрШаблон(НСтр("ru = '%1 с заполненным «Имя UTM» (для %2)'"), Части[1], Части[2]),
			Количество > 0, Части[0], ?(Количество = 0, НСтр("ru = 'Ни у одного не заполнено — метки не будут распознаваться'"),
			СтрШаблон(НСтр("ru = 'Заполнено у %1'"), Количество)));
	КонецЦикла;

	// Линии телефонии
	Выборка = Результаты[3].Выбрать();
	Выборка.Следующий();
	Линий = ?(Выборка.Количество = NULL, 0, Выборка.Количество);
	ДобавитьПроверку("Телефония", НСтр("ru = 'Источники рекламы внешних номеров (номер линии → источник, кампания)'"), Линий > 0, "Линии",
		?(Линий = 0, НСтр("ru = 'Не заполнено: звонки не получат источник по номеру (необязательно)'"),
		СтрШаблон(НСтр("ru = 'Номеров: %1'"), Линий)));

	// Пользователи
	Операторов = 0;
	Интеграторов = 0;
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если Пользователь.Роли.Содержит(Метаданные.Роли.омг_РаботаСЛидами) Тогда
			Операторов = Операторов + 1;
		КонецЕсли;
		Если Пользователь.Роли.Содержит(Метаданные.Роли.омг_ИнтеграцияЛиды) Тогда
			Интеграторов = Интеграторов + 1;
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	ДобавитьПроверку("Пользователи", НСтр("ru = 'Операторы КЦ / ОП с ролью «Работа с лидами»'"), Операторов > 0, "Пользователи",
		СтрШаблон(НСтр("ru = 'Пользователей: %1'"), Операторов));
	ДобавитьПроверку("Пользователи", НСтр("ru = 'Пользователь публикации HTTP-сервисов с ролью «Лиды: интеграция»'"), Интеграторов > 0,
		"Пользователи", ?(Интеграторов = 0, НСтр("ru = 'Нет: вебхуки не смогут создавать лиды'"),
		СтрШаблон(НСтр("ru = 'Пользователей: %1'"), Интеграторов)));

	Выполнено = 0;
	Для Каждого СтрокаПроверки Из Проверки Цикл
		Выполнено = Выполнено + ?(СтрокаПроверки.Готово, 1, 0);
	КонецЦикла;
	ИтогПроверок = СтрШаблон(НСтр("ru = 'Готово %1 из %2'"), Выполнено, Проверки.Количество());

КонецПроцедуры

&НаСервере
Процедура ДобавитьПроверку(Раздел, Описание, Готово, Действие, Пояснение)

	СтрокаПроверки = Проверки.Добавить();
	СтрокаПроверки.Раздел = Раздел;
	СтрокаПроверки.Описание = Описание;
	СтрокаПроверки.Готово = Готово;
	СтрокаПроверки.Состояние = ?(Готово, НСтр("ru = 'Готово'"), НСтр("ru = 'Настроить'"));
	СтрокаПроверки.Действие = Действие;
	СтрокаПроверки.Пояснение = Пояснение;

КонецПроцедуры

#КонецОбласти

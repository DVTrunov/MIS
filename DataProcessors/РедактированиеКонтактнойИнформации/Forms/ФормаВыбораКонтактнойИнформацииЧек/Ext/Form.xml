			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>КонтактнаяИнформация.Вид</Field>
				<Field>КонтактнаяИнформация.ГородскойРайон</Field>
				<Field>КонтактнаяИнформация.ЗначениеПоУмолчанию</Field>

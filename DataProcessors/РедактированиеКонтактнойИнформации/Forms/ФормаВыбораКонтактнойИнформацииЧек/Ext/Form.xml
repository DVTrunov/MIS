				<Field>КонтактнаяИнформация.Поле6</Field>
				<Field>КонтактнаяИнформация.Поле7</Field>
				<Field>КонтактнаяИнформация.Поле8</Field>
				<Field>КонтактнаяИнформация.Поле9</Field>
				<Field>КонтактнаяИнформация.Представление</Field>
				<Field>КонтактнаяИнформация.Тип</Field>
				<Field>КонтактнаяИнформация.ТипДома</Field>
				<Field>КонтактнаяИнформация.ТипКвартиры</Field>
				<Field>КонтактнаяИнформация.ТипКорпуса</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕдиныйЗапрос.Объект,
	ЕдиныйЗапрос.Тип,
	ЕдиныйЗапрос.Вид,
	МАКСИМУМ(ЕдиныйЗапрос.Комментарий) КАК Комментарий,
	МАКСИМУМ(ЕдиныйЗапрос.Представление) КАК Представление,
	МАКСИМУМ(ВЫБОР
			КОГДА ЕдиныйЗапрос.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
				ТОГДА 3

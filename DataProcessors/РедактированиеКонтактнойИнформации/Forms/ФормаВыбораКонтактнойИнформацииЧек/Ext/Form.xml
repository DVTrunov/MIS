				<Field>КонтактнаяИнформация.Поле11</Field>
				<Field>КонтактнаяИнформация.Поле12</Field>
				<Field>КонтактнаяИнформация.Поле2</Field>
				<Field>КонтактнаяИнформация.Поле3</Field>
				<Field>КонтактнаяИнформация.Поле4</Field>

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВопросаПередСохранением(Ответ, Ошибки) Экспорт
	
	Если Ответ = "ЗакрытьФорму" Тогда
		СохранитьИЗакрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть()
	
	Закрыть(СформироватьРезультат());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОшибкиНаполнения(Ошибки)
	
	Если Не ИсследованияВыполнены Тогда
		Если Не ЗначениеЗаполнено(ПричинаОтменыВыполненияИсследований) Тогда
			Ошибки.Добавить(НСтр("ru='Не заполнена причина отмены исследований'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаИсследования Из Исследования Цикл
		
		ЗаголовокИсследования = СтрШаблон(НСтр("ru='Исследование №%1'"), Исследования.Индекс(СтрокаИсследования) + 1);
		Если ЗначениеЗаполнено(СтрокаИсследования.ИсследованиеПрофиль) Тогда
			ЗаголовокИсследования = СтрШаблон(НСтр("ru='%1 (%2)'"), ЗаголовокИсследования, СтрокаИсследования.ИсследованиеПрофиль);
		//Иначе
		//	Ошибки.Добавить(СтрШаблон(НСтр("ru='Не заполнен профиль исследования %1'"), Исследования.Индекс(СтрокаИсследования) + 1));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаИсследования.ИсследованиеПримечаниеКРезультату) Тогда
			Если Не ЗначениеЗаполнено(СтрокаИсследования.ИсследованиеДатаПримечания) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не заполнена дата примечания'"), ЗаголовокИсследования));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаИсследования.ИсследованиеАвторПримечания) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не заполнен автор примечания'"), ЗаголовокИсследования));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаИсследования.ИсследованиеДолжностьАвтораПримечания) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не заполнена должность автора примечания'"), ЗаголовокИсследования));
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаИсследования.ЛабораторныеТесты.Количество() = 0 Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указан ни один лабораторный тест'"), ЗаголовокИсследования));
		КонецЕсли;
		
		Для Каждого СтрокаТеста Из СтрокаИсследования.ЛабораторныеТесты Цикл
			
			ЗаголовокТеста = СтрШаблон(НСтр("ru='%1, лаб. тест №%2'"), ЗаголовокИсследования, СтрокаИсследования.ЛабораторныеТесты.Индекс(СтрокаТеста) + 1);
			
			Если ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТест) Тогда
				ЗаголовокТеста = СтрШаблон("%1 (%2)", ЗаголовокТеста, СтрокаТеста.ЛабораторныйТест);
			Иначе
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указан тест по классификатору'"), ЗаголовокТеста));
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестДатаВыполнения) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указана дата'"), ЗаголовокТеста));
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестСотрудник) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указан сотрудник, проводивший исследование'"), ЗаголовокТеста));
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестДолжностьСотрудника) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указана должность сотрудника, проводившего исследование'"), ЗаголовокТеста));
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестКомментарий) Тогда
				Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестДатаКомментария) Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указана дата комментария'"), ЗаголовокТеста));
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестАвторКомментария) Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указан автор комментария'"), ЗаголовокТеста));
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестДолжностьАвтораКомментария) Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указана должность автора комментария'"), ЗаголовокТеста));
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаТеста.ЛабораторныйТестВыполнен Тогда
				Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестЗначение) Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указано значение результата'"), ЗаголовокТеста));
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестШтрихкод) Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указан штрихкод'"), ЗаголовокТеста));
				КонецЕсли;
				
				ОборудованиеУказано = Ложь;
				Для Каждого СтрокаОборудования Из СтрокаТеста.ИспользованноеОборудование Цикл
					Если ЗначениеЗаполнено(СтрокаОборудования.Оборудование) Тогда
						ОборудованиеУказано = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если Не ОборудованиеУказано Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указано ни одного использованного оборудования'"), ЗаголовокТеста));
				КонецЕсли;
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаТеста.ЛабораторныйТестПричинаОтмены) Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указана причина отмены'"), ЗаголовокТеста));
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаУслуги Из СтрокаИсследования.ОказанныеУслуги Цикл
			ЗаголовокУслуги = СтрШаблон(НСтр("ru='%1, услуга №%2'"), ЗаголовокИсследования, СтрокаИсследования.ОказанныеУслуги.Индекс(СтрокаУслуги) + 1);
			
			Если ЗначениеЗаполнено(СтрокаУслуги.ОказаннаяУслуга) Тогда
				ЗаголовокУслуги = СтрШаблон("%1 (%2)", ЗаголовокУслуги, СтрокаУслуги.ОказаннаяУслуга);
			Иначе
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указана номенклатура'"), ЗаголовокУслуги));
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаУслуги.ОказаннаяУслугаДата) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru='%1: не указана дата оказания'"), ЗаголовокУслуги));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредзаполнитьНовуюСтроку(КоллекцияСтрокТекущейТаблицы)
	
	Для Каждого СтрокаТаблицы Из КоллекцияСтрокТекущейТаблицы Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки) Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗначенияПараметровПоУмолчанию);
			СтрокаТаблицы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПрофилиИсследований(ПриСохранении = Ложь)
	
	Для Каждого СтрокаИсследования Из Исследования Цикл
		Если ПриСохранении Тогда
			Если Не ЗначениеЗаполнено(СтрокаИсследования.ИсследованиеПрофиль) Тогда
				СтрокаИсследования.ИсследованиеПрофиль = "Отдельные лабораторные тесты";
			КонецЕсли;
		Иначе
			Если ТипЗнч(СтрокаИсследования.ИсследованиеПрофиль) <> Тип("СправочникСсылка.КлассификаторыМинЗдрава") Тогда
				СтрокаИсследования.ИсследованиеПрофиль = ПредопределенноеЗначение("Справочник.КлассификаторыМинЗдрава.ПустаяСсылка");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанные(РодительскийРеквизит, Иерархия, ЗначенияПараметровПоПолям, ИдентификаторыТаблицПоИменам, ДанныеТаблицПараметров, ИдентификаторРодительскойСтроки = "", ОтборПараметров = Неопределено)
	
	Для Каждого ПолеИнтерфейса Из Иерархия.Поля Цикл
		СтруктураПараметра = ЗначенияПараметровПоПолям.Получить(ПолеИнтерфейса.Имя);
		ЗначениеПараметра = Неопределено;
		Если ОтборПараметров = Неопределено Тогда
			ЗначениеПараметра = СтруктураПараметра.Значение;
		Иначе
			ПараметрПоИмениПоля = ПараметрПоИмениПоля(ДанныеПараметровПоИменам, ПолеИнтерфейса.Имя);
			Если ПараметрПоИмениПоля <> Неопределено Тогда
				ОтборПараметров.Вставить("Параметр", ПараметрПоИмениПоля);
				СтрокиПараметра = ДанныеТаблицПараметров.НайтиСтроки(ОтборПараметров);
				Если СтрокиПараметра.Количество() > 0 Тогда
					ЗначениеПараметра = СтрокиПараметра[0].Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		РодительскийРеквизит[ПолеИнтерфейса.Имя] = ЗначениеПараметра;
	КонецЦикла;
	
	Для Каждого ТаблицаИнтерфейса Из Иерархия.Таблицы Цикл
		ИдентификаторТаблицы = Строка(ИдентификаторыТаблицПоИменам.Получить(ТаблицаИнтерфейса.Имя));
		
		СтрокиДанныхТаблицы = ДанныеТаблицПараметров.НайтиСтроки(Новый Структура("ИдентификаторТаблицы, ИдентификаторРодительскойСтроки", Строка(ИдентификаторТаблицы), ИдентификаторРодительскойСтроки));
		
		Если СтрокиДанныхТаблицы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеТекущейТаблицы = ДанныеТаблицПараметров.СкопироватьКолонки();
		Для Каждого СтрокаДанных Из СтрокиДанныхТаблицы Цикл
			ЗаполнитьЗначенияСвойств(ДанныеТекущейТаблицы.Добавить(), СтрокаДанных);
		КонецЦикла;
		
		НомераСтрокТекущейТаблицы = ДанныеТекущейТаблицы.Скопировать();
		НомераСтрокТекущейТаблицы.Свернуть("НомерСтрокиТаблицы, ИдентификаторСтроки");
		НомераСтрокТекущейТаблицы.Сортировать("НомерСтрокиТаблицы");
		
		Для Каждого СтрокаНомераСтроки Из НомераСтрокТекущейТаблицы Цикл
			
			ОтборПоТекущейСтроке = Новый Структура;
			ОтборПоТекущейСтроке.Вставить("ИдентификаторТаблицы",			 Строка(ИдентификаторТаблицы));
			ОтборПоТекущейСтроке.Вставить("ИдентификаторРодительскойСтроки", ИдентификаторРодительскойСтроки);
			ОтборПоТекущейСтроке.Вставить("НомерСтрокиТаблицы",				 СтрокаНомераСтроки.НомерСтрокиТаблицы);
			
			НоваяСтрока = РодительскийРеквизит[ТаблицаИнтерфейса.Имя].Добавить();
			НоваяСтрока.ИдентификаторСтроки = СтрокаНомераСтроки.ИдентификаторСтроки;
			ЗаполнитьДанные(НоваяСтрока, ТаблицаИнтерфейса.Подчиненные, ЗначенияПараметровПоПолям, ИдентификаторыТаблицПоИменам, ДанныеТаблицПараметров, СтрокаНомераСтроки.ИдентификаторСтроки, ОтборПоТекущейСтроке);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьВидимость()
	
	Элементы.ПричинаОтменыВыполненияИсследований.Видимость	= Не ИсследованияВыполнены;
	Элементы.ОписаниеИсследований.Видимость					= ИсследованияВыполнены;
	Элементы.ОписаниеИсследованияПоПрофилю.Видимость		= Исследования.Количество() > 0;
	
	Если Не ИсследованияВыполнены Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеПрофиля = Элементы.Исследования.ТекущиеДанные;
	
	Если ТекущиеДанныеПрофиля = Неопределено Тогда
		Элементы.ЛабораторныеТестыПоПрофилю.Видимость	= Ложь;
		Элементы.ПримечаниеПоПрофилю.Видимость			= Ложь;
		Элементы.ОказанныеУслугиПоПрофилю.Видимость		= Ложь;
	Иначе
		Элементы.ЛабораторныеТестыПоПрофилю.Видимость	= Истина;
		Элементы.ПримечаниеПоПрофилю.Видимость			= ВидимостьПримечанияПоПрофилю;
		Элементы.ОказанныеУслугиПоПрофилю.Видимость		= ВидимостьОказанныхУслуг;
		
		Элементы.ИсследованияИсследованиеДолжностьАвтораПримечания.Доступность = ЗначениеЗаполнено(ТекущиеДанныеПрофиля.ИсследованиеАвторПримечания);
		
		Если ТекущиеДанныеПрофиля.ЛабораторныеТесты.Количество() > 0 Тогда
			Элементы.ПараметрыЛабораторногоТеста.Видимость = Истина;
			ТекущиеДанныеТеста = Элементы.ЛабораторныеТесты.ТекущиеДанные;
			Если ТекущиеДанныеТеста <> Неопределено Тогда
				Элементы.КомментарийКТесту.Видимость								= ВидимостьКомментарияТеста;
				Элементы.ЛабораторныеТестыЛабораторныйТестПричинаОтмены.Видимость	= Не ТекущиеДанныеТеста.ЛабораторныйТестВыполнен;
				Элементы.ПараметрыВыполненногоТеста.Видимость						= ТекущиеДанныеТеста.ЛабораторныйТестВыполнен;
				Элементы.ГруппаИспользованноеОборудование.Видимость					= ТекущиеДанныеТеста.ЛабораторныйТестВыполнен;
				Элементы.ПараметрыПримечанияЛабТеста.Видимость						= ЗначениеЗаполнено(ТекущиеДанныеТеста.ЛабораторныйТестКомментарий);
				
				Элементы.ЛабораторныеТестыЛабораторныйТестИнтерпретацияРезультата.Видимость = ТекущиеДанныеТеста.ЛабораторныйТестВыполнен И ВидимостьИнтерпретацииРезультата;
				
				Элементы.ЛабораторныеТестыЛабораторныйТестДолжностьСотрудника.Доступность		 = ЗначениеЗаполнено(ТекущиеДанныеТеста.ЛабораторныйТестСотрудник);
				Элементы.ЛабораторныеТестыЛабораторныйТестДолжностьАвтораКомментария.Доступность = ЗначениеЗаполнено(ТекущиеДанныеТеста.ЛабораторныйТестАвторКомментария);
			КонецЕсли;
		Иначе
			Элементы.ПараметрыЛабораторногоТеста.Видимость = Ложь;
		КонецЕсли;
		Элементы.ПараметрыПримечанияИсследования.Видимость = ЗначениеЗаполнено(ТекущиеДанныеПрофиля.ИсследованиеПримечаниеКРезультату);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьРезультат()
	
	Результат = Новый Структура("МассивДанныхТаблицы, МассивЗначенийПараметров", Новый Массив, Новый Массив);
	ПоляТаблицыИнтерфейса = РаботаСИнтерфейсамиЗаполненияПараметровКлиентСервер.ПоляТаблицыИнтерфейса(ИдентификаторИнтерфейса);
	РекурсивноеЗаполнениеДанных(Результат, ЭтотОбъект, ПоляТаблицыИнтерфейса.Иерархия);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РекурсивноеЗаполнениеДанных(Результат, РодительскийРеквизит, Иерархия, СтруктураСтрокиТаблицы = Неопределено)
	
	Для Каждого ПолеИнтерфейса Из Иерархия.Поля Цикл
		
		ПараметрПоля = ПараметрПоИмениПоля(ДанныеПараметровПоИменам, ПолеИнтерфейса.Имя);
		Если ПараметрПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеПараметра = РодительскийРеквизит[ПолеИнтерфейса.Имя];
		
		Если СтруктураСтрокиТаблицы = Неопределено Тогда
			Результат.МассивЗначенийПараметров.Добавить(Новый Структура("Параметр, Значение", ПараметрПоля, ЗначениеПараметра));
		Иначе
			СтруктураТекущегоПараметра = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураСтрокиТаблицы);
			СтруктураТекущегоПараметра.Вставить("Параметр", ПараметрПоля);
			СтруктураТекущегоПараметра.Вставить("Значение", ЗначениеПараметра);
			Результат.МассивДанныхТаблицы.Добавить(СтруктураТекущегоПараметра);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТаблицаИнтерфейса Из Иерархия.Таблицы Цикл
		
		СтрокиТаблицы = ДанныеТаблицПоИменам.НайтиСтроки(Новый Структура("ИмяТаблицы", ТаблицаИнтерфейса.Имя));
		Если СтрокиТаблицы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторРодительскойСтроки = "";
		Если СтруктураСтрокиТаблицы <> Неопределено Тогда
			ИдентификаторРодительскойСтроки = СтруктураСтрокиТаблицы.ИдентификаторСтроки;
		КонецЕсли;
		
		ТаблицаШаблонов = СтрокиТаблицы[0].ТаблицаШаблонов;
		ТаблицаФормы = РодительскийРеквизит[ТаблицаИнтерфейса.Имя];
		
		Для Каждого СтрокаТаблицы Из ТаблицаФормы Цикл
			СтруктураТекущейСтроки = Новый Структура;
			СтруктураТекущейСтроки.Вставить("ИдентификаторТаблицы",				Строка(ТаблицаШаблонов.УникальныйИдентификатор()));
			СтруктураТекущейСтроки.Вставить("НомерСтрокиТаблицы",				ТаблицаФормы.Индекс(СтрокаТаблицы) + 1);
			СтруктураТекущейСтроки.Вставить("ИдентификаторСтроки",				СтрокаТаблицы.ИдентификаторСтроки);
			СтруктураТекущейСтроки.Вставить("ИдентификаторРодительскойСтроки",	ИдентификаторРодительскойСтроки);
			РекурсивноеЗаполнениеДанных(Результат, СтрокаТаблицы, ТаблицаИнтерфейса.Подчиненные, СтруктураТекущейСтроки);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрПоИмениПоля(ДанныеПараметровПоИменам, ИмяПоля)
	
	СтрокиПараметраПоля = ДанныеПараметровПоИменам.НайтиСтроки(Новый Структура("ИмяПоля", ИмяПоля));
	Если СтрокиПараметраПоля.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтрокиПараметраПоля[0].Параметр;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДопустимыеДолжности(ВидДокумента)
	
	ДопустимыеДолжностиПоВидамЭМД = ИнтеграцияЕГИСЗ_РЭМД.ПолучитьДолжностиПоВидамЭМД(ОбщегоНазначенияБИТКлиентСервер.НовыйМассив(ВидДокумента));
	
	ДопустимыеДолжностиПоВидуДокумента = ДопустимыеДолжностиПоВидамЭМД.НайтиСтроки(Новый Структура("ВидДокумента", ВидДокумента));
	
	Если ДопустимыеДолжностиПоВидуДокумента.Количество() > 0
		И ДопустимыеДолжностиПоВидуДокумента[0].Должности.Количество() > 0
	Тогда
		ДопустимыеДолжности.ЗагрузитьЗначения(ДопустимыеДолжностиПоВидуДокумента[0].Должности);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПодходящиеДолжностиСотрудника(Сотрудник, ДопустимыеДолжности, ВернутьПервое = Ложь)
	
	ПодходящиеДолжности = Новый Массив;
	
	ДолжностиСотрудника = ИнтеграцияЕГИСЗВызовСервера.ДолжностиМЗ(Сотрудник);
	
	Для Каждого ДолжностьСотрудника Из ДолжностиСотрудника Цикл
		Если (ДопустимыеДолжности.Количество() = 0
				Или ДопустимыеДолжности.НайтиПоЗначению(ДолжностьСотрудника) <> Неопределено)
			И ПодходящиеДолжности.Найти(ДолжностьСотрудника) = Неопределено
		Тогда
			ПодходящиеДолжности.Добавить(ДолжностьСотрудника);
		КонецЕсли;
	КонецЦикла;
	
	Если ВернутьПервое Тогда
		Если ПодходящиеДолжности.Количество() = 0 Тогда
			Возврат Неопределено;
		Иначе
			Возврат ПодходящиеДолжности[0];
		КонецЕсли;
	Иначе
		Возврат ПодходящиеДолжности;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура УстановитьДопустимыеДолжности(ЭлементДолжности, СотрудникДолжности)
	
	Если ДопустимыеДолжности.Количество() > 0 Тогда
		ПодходящиеДолжности = ПолучитьПодходящиеДолжностиСотрудника(СотрудникДолжности, ДопустимыеДолжности);
		
		ПараметрыВыбораДолжности = Новый Массив;
		ПараметрыВыбораДолжности.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", ПодходящиеДолжности));
		ЭлементДолжности.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораДолжности);
		ЭлементДолжности.СписокВыбора.ЗагрузитьЗначения(ПодходящиеДолжности);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТаблицыПоляНастроены(ИменаПолей = Неопределено, ИменаТаблиц = Неопределено)
	
	Если ИменаПолей <> Неопределено Тогда
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Если ДанныеПараметровПоИменам.НайтиСтроки(Новый Структура("ИмяПоля", ИмяПоля)).Количество() = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИменаТаблиц <> Неопределено Тогда
		Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
			Если ДанныеТаблицПоИменам.НайтиСтроки(Новый Структура("ИмяТаблицы", ИмяТаблицы)).Количество() = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
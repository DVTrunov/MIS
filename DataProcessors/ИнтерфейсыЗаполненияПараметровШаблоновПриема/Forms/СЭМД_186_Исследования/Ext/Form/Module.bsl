&НаКлиенте
Процедура ИсследованияИсследованиеПримечаниеКРезультатуПриИзменении(Элемент)
	
	ОбновитьДоступностьВидимость();
	ТекущееИсследование = Элементы.Исследования.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущееИсследование.ИсследованиеПримечаниеКРезультату)
		И Не (ЗначениеЗаполнено(ТекущееИсследование.ИсследованиеДатаПримечания)
			Или ЗначениеЗаполнено(ТекущееИсследование.ИсследованиеАвторПримечания)
			Или ЗначениеЗаполнено(ТекущееИсследование.ИсследованиеДолжностьАвтораПримечания))
	Тогда
		ТекущееИсследование.ИсследованиеДатаПримечания = ТекущаяДата();
		ТекущееИсследование.ИсследованиеАвторПримечания = ТекущийСотрудник;
		ТекущееИсследование.ИсследованиеДолжностьАвтораПримечания = ПолучитьПодходящиеДолжностиСотрудника(ТекущийСотрудник, ДопустимыеДолжности, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияИсследованиеАвторПримечанияПриИзменении(Элемент)
	
	ТекущееИсследование = Элементы.Исследования.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущееИсследование.ИсследованиеАвторПримечания) Тогда
		ТекущееИсследование.ИсследованиеДолжностьАвтораПримечания = ПолучитьПодходящиеДолжностиСотрудника(ТекущееИсследование.ИсследованиеАвторПримечания, ДопустимыеДолжности, Истина);
	Иначе
		ТекущееИсследование.ИсследованиеДолжностьАвтораПримечания = Неопределено;
	КонецЕсли;
	
	ОбновитьДоступностьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛабораторныеТестыЛабораторныйТестКомментарийПриИзменении(Элемент)
	
	ОбновитьДоступностьВидимость();
	ТекущийТест = Элементы.ЛабораторныеТесты.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущийТест.ЛабораторныйТестКомментарий)
		И Не (ЗначениеЗаполнено(ТекущийТест.ЛабораторныйТестДатаКомментария)
			Или ЗначениеЗаполнено(ТекущийТест.ЛабораторныйТестАвторКомментария)
			Или ЗначениеЗаполнено(ТекущийТест.ЛабораторныйТестДолжностьАвтораКомментария))
	Тогда
		ТекущийТест.ЛабораторныйТестДатаКомментария = ТекущаяДата();
		ТекущийТест.ЛабораторныйТестАвторКомментария = ТекущийСотрудник;
		ТекущийТест.ЛабораторныйТестДолжностьАвтораКомментария = ПолучитьПодходящиеДолжностиСотрудника(ТекущийСотрудник, ДопустимыеДолжности, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛабораторныеТестыЛабораторныйТестАвторКомментарияПриИзменении(Элемент)
	
	ТекущийТест = Элементы.ЛабораторныеТесты.ТекущиеДанные;

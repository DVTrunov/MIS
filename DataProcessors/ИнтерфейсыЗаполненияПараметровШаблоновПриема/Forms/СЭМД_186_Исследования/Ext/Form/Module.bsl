#Область РазделОписанияПеременных

&НаКлиенте
Перем ЗначенияПараметровПоУмолчанию;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = Параметры.ЗаголовокИнтерфейса;
	
	ДобавляемыеРеквизиты = Новый Массив;
	ТипЗначенияПараметраHTML = Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.ПараметрыHTML.Тип, , , , Новый КвалификаторыСтроки());
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ЗначениеПоУмолчанию", ТипЗначенияПараметраHTML, "ДанныеПараметровПоИменам", "ЗначениеПоУмолчанию"));
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ИдентификаторИнтерфейса = Параметры.ИдентификаторИнтерфейса;
	
	ЗначенияПараметровПоПолям = Новый Соответствие;
	Для Каждого ДанныеПараметраПоля Из Параметры.ПараметрыПолей Цикл
		ЗначенияПараметровПоПолям.Вставить(ДанныеПараметраПоля.ИмяПоля, Новый Структура("Идентификатор, Значение", ДанныеПараметраПоля.Идентификатор, ДанныеПараметраПоля.Значение));
	КонецЦикла;
	
	ДанныеТаблицПараметров = Новый ТаблицаЗначений;
	ДанныеТаблицПараметров.Колонки.Добавить("НомерСтрокиТаблицы");
	ДанныеТаблицПараметров.Колонки.Добавить("Параметр");
	ДанныеТаблицПараметров.Колонки.Добавить("Значение");
	ДанныеТаблицПараметров.Колонки.Добавить("ИдентификаторТаблицы");
	ДанныеТаблицПараметров.Колонки.Добавить("ИдентификаторСтроки");
	ДанныеТаблицПараметров.Колонки.Добавить("ИдентификаторРодительскойСтроки");
	
	ИдентификаторыТаблицПоИменам = Новый Соответствие;
	Для Каждого ТаблицыПараметров Из Параметры.ТаблицыПараметров Цикл
		ИдентификаторыТаблицПоИменам.Вставить(ТаблицыПараметров.ИмяТаблицы, ТаблицыПараметров.Идентификатор);
		Для Каждого ДанныеСтрокиТаблицы Из ТаблицыПараметров.МассивДанныхТаблицы Цикл
			ЗаполнитьЗначенияСвойств(ДанныеТаблицПараметров.Добавить(), ДанныеСтрокиТаблицы);
		КонецЦикла;
	КонецЦикла;
	
	ПоляТаблицыИнтерфейса = РаботаСИнтерфейсамиЗаполненияПараметровКлиентСервер.ПоляТаблицыИнтерфейса(ИдентификаторИнтерфейса);
	
	Для Каждого ПолеИнтерфейса Из ПоляТаблицыИнтерфейса.Поля Цикл
		СтруктураПараметра = ЗначенияПараметровПоПолям.Получить(ПолеИнтерфейса.Имя);
		
		Если СтруктураПараметра = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаПараметра = ДанныеПараметровПоИменам.Добавить();
		НоваяСтрокаПараметра.ИмяПоля = ПолеИнтерфейса.Имя;
		НоваяСтрокаПараметра.Параметр = ПланыВидовХарактеристик.ПараметрыHTML.ПолучитьСсылку(СтруктураПараметра.Идентификатор);
		Если Не НоваяСтрокаПараметра.Параметр.ИспользуетсяВычисляемоеЗначение Тогда
			НоваяСтрокаПараметра.ЗначениеПоУмолчанию = НоваяСтрокаПараметра.Параметр.ЗначениеПоУмолчанию;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТаблицаИнтерфейса Из ПоляТаблицыИнтерфейса.Таблицы Цикл
		ИдентификаторТаблицы = ИдентификаторыТаблицПоИменам.Получить(ТаблицаИнтерфейса.Имя);
		
		Если ИдентификаторТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаТаблицы = ДанныеТаблицПоИменам.Добавить();
		НоваяСтрокаТаблицы.ИмяТаблицы = ТаблицаИнтерфейса.Имя;
		НоваяСтрокаТаблицы.ТаблицаШаблонов = Справочники.ТаблицыШаблоновПриема.ПолучитьСсылку(ИдентификаторТаблицы);
	КонецЦикла;
	
	ЗаполнитьДанные(ЭтотОбъект, ПоляТаблицыИнтерфейса.Иерархия, ЗначенияПараметровПоПолям, ИдентификаторыТаблицПоИменам, ДанныеТаблицПараметров);
	
	Если Параметры.Свойство("ДополнительныеПараметры")
		И ТипЗнч(Параметры.ДополнительныеПараметры) = Тип("Структура")
	Тогда
		Если Параметры.ДополнительныеПараметры.Свойство("Филиал") Тогда
			ТекущийСотрудник = ОтраслевыеДополнения.СотрудникПользователяПоФилиалу(ПараметрыСеанса.ТекущийПользователь, Параметры.ДополнительныеПараметры.Филиал);
		КонецЕсли;
		Если Параметры.ДополнительныеПараметры.Свойство("ВидДокумента") Тогда
			ЗаполнитьДопустимыеДолжности(Параметры.ДополнительныеПараметры.ВидДокумента);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийСотрудник) Тогда
		СотрудникиПользователя = ОтраслевыеДополнения.СотрудникиПользователя(ПараметрыСеанса.ТекущийПользователь);
		Если СотрудникиПользователя.Количество() > 0 Тогда
			ТекущийСотрудник = СотрудникиПользователя[0];
		КонецЕсли;
	КонецЕсли;
	
	ВидимостьПримечанияПоПрофилю	 = ТаблицыПоляНастроены(ОбщегоНазначенияБИТКлиентСервер.НовыйМассив("ИсследованиеПримечаниеКРезультату", "ИсследованиеДатаПримечания", "ИсследованиеАвторПримечания", "ИсследованиеДолжностьАвтораПримечания"));
	ВидимостьИнтерпретацииРезультата = ТаблицыПоляНастроены(ОбщегоНазначенияБИТКлиентСервер.НовыйМассив("ЛабораторныйТестИнтерпретацияРезультата"));
	ВидимостьКомментарияТеста		 = ТаблицыПоляНастроены(ОбщегоНазначенияБИТКлиентСервер.НовыйМассив("ЛабораторныйТестКомментарий", "ЛабораторныйТестДатаКомментария", "ЛабораторныйТестАвторКомментария", "ЛабораторныйТестДолжностьАвтораКомментария"));
	ВидимостьОказанныхУслуг			 = ТаблицыПоляНастроены(ОбщегоНазначенияБИТКлиентСервер.НовыйМассив("ОказаннаяУслуга", "ОказаннаяУслугаДата"), ОбщегоНазначенияБИТКлиентСервер.НовыйМассив("ОказанныеУслуги"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗначенияПараметровПоУмолчанию = Новый Структура;
	Для Каждого СтрокаПараметра Из ДанныеПараметровПоИменам Цикл
		Если ЗначениеЗаполнено(СтрокаПараметра.ЗначениеПоУмолчанию) Тогда
			ЗначенияПараметровПоУмолчанию.Вставить(СтрокаПараметра.ИмяПоля, СтрокаПараметра.ЗначениеПоУмолчанию);
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьПрофилиИсследований();
	
	ОбновитьДоступностьВидимость();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОбновитьПрофилиИсследований(Истина);
	
	Ошибки = Новый Массив;
	ЗаполнитьОшибкиНаполнения(Ошибки);
	
	Если Ошибки.Количество() > 0 Тогда
		Для Каждого ТекстОшибки Из Ошибки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЦикла;
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить("ЗакрытьФорму", НСтр("ru='Закрыть форму'"));
		СписокКнопок.Добавить("ВернутьсяНаФорму", НСтр("ru='Вернуться на форму'"));
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаПередСохранением", ЭтотОбъект, Ошибки);
		ПоказатьВопрос(Оповещение, НСтр("ru='Не все обязательные параметры заполнены, некоторые стоки будут отсутствовать в результате'"), СписокКнопок,, "ЗакрытьФорму");
	Иначе
		СохранитьИЗакрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы


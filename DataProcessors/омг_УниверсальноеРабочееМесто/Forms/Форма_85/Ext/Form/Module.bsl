      &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    омг_КаталогДействийРабочихМест.ОбеспечитьАктуальностьКаталога();
    ЗаполнитьДоступныеВарианты();

    Если ЗначениеЗаполнено(Параметры.Вариант) Тогда
        ТекущийВариант = Параметры.Вариант;
    Иначе
        Для Каждого Элемент Из ДоступныеВарианты Цикл
            Если Элемент.Пометка Тогда
                ТекущийВариант = Элемент.Значение;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если НЕ ЗначениеЗаполнено(ТекущийВариант) И ДоступныеВарианты.Количество() > 0 Тогда
            ТекущийВариант = ДоступныеВарианты[0].Значение;
        КонецЕсли;
    КонецЕсли;

    Элементы.ГруппаНетНазначений.Видимость = НЕ ЗначениеЗаполнено(ТекущийВариант);
    ПерестроитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоступныеВарианты()
    ДоступныеВарианты = РегистрыСведений.омг_НазначениеРабочихМест.ВариантыПользователя(
        ПараметрыСеанса.ТекущийПользователь);

    Элементы.ТекущийВариант.СписокВыбора.ЗагрузитьЗначения(ДоступныеВарианты.ВыгрузитьЗначения());
    Для Каждого Элемент Из Элементы.ТекущийВариант.СписокВыбора Цикл
        Найденный = ДоступныеВарианты.НайтиПоЗначению(Элемент.Значение);
        Если Найденный <> Неопределено Тогда
            Элемент.Представление = Найденный.Представление;
        КонецЕсли;
    КонецЦикла;

    Элементы.ГруппаВыборВарианта.Видимость = (ДоступныеВарианты.Количество() > 1);
КонецПроцедуры

&НаКлиенте
Процедура ТекущийВариантПриИзменении(Элемент)
    ПерестроитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПерестроитьНаСервере()
     ЭтаФорма.АвтоЗаголовок = Ложь;

    Если ЗначениеЗаполнено(ТекущийВариант) Тогда
        Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущийВариант, "Заголовок, Наименование");
        ЭтаФорма.Заголовок = ?(ПустаяСтрока(Реквизиты.Заголовок), Реквизиты.Наименование, Реквизиты.Заголовок);
    Иначе
        ЭтаФорма.Заголовок = "Рабочее место";
    КонецЕсли;

    омг_РабочиеМестаПостроение.Построить(ЭтаФорма, ТекущийВариант);
КонецПроцедуры


&НаКлиенте
Процедура Подключаемый_НажатиеПлитки(Команда)

    Строки = ПараметрыДействий.НайтиСтроки(Новый Структура("ИмяКоманды", Команда.Имя));
    Если Строки.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    Действие = Строки[0];

    Попытка

        Если Действие.ТипДействия = ПредопределенноеЗначение("Перечисление.омг_ТипыДействийРабочихМест.ПроцедураМодуля") Тогда
            Выполнить(Действие.Параметр + "(ЭтаФорма)");

        ИначеЕсли Действие.ТипДействия = ПредопределенноеЗначение("Перечисление.омг_ТипыДействийРабочихМест.Форма") Тогда
            Режим = ?(Действие.РежимОткрытия = ПредопределенноеЗначение("Перечисление.омг_РежимыОткрытияФорм.БлокироватьОкноВладельца"),
                РежимОткрытияОкнаФормы.БлокироватьОкноВладельца,
                РежимОткрытияОкнаФормы.Независимый);
            ОткрытьФорму(Действие.Параметр, ПараметрыФормыИзСтроки(Действие.ПараметрыФормы),
                ЭтаФорма, , , , , Режим);

        Иначе
            ПерейтиПоНавигационнойСсылке(Действие.Параметр);
        КонецЕсли;

    Исключение
        ПоказатьПредупреждение(, СтрШаблон("Не удалось открыть: %1",
            КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
    КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция ПараметрыФормыИзСтроки(Текст)
    Если ПустаяСтрока(Текст) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Чтение, Ложь);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции
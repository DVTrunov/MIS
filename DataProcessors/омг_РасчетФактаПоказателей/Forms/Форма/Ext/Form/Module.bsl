    УникальныеПосещенияПоПациентам = Новый Соответствие;
    
    Для Каждого Строка Из ТЗДанные Цикл
        СоответствуетФильтру = Истина;
        
        Для Каждого Условие Из УсловияФильтрации Цикл
            Если Строка[Условие.Колонка] <> Условие.Значение Тогда
                СоответствуетФильтру = Ложь;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        
        Если СоответствуетФильтру И Строка.Клиент <> Неопределено Тогда
            ДатаПосещения = НачалоДня(Строка.Период);
            КлючПосещения = Строка(Строка.Клиент) + "|" + Формат(ДатаПосещения, "ДФ=dd.MM.yyyy");
            
            ПосещенияПациента = УникальныеПосещенияПоПациентам.Получить(Строка.Клиент);

                УникальныеПосещенияПоПациентам.Вставить(Строка.Клиент, ПосещенияПациента);
            КонецЕсли;
            
            ПосещенияПациента.Вставить(КлючПосещения, Истина);
        КонецЕсли;
    КонецЦикла;
    
    КоличествоПациентовСПовторными = 0;
    ОбщееКоличествоПациентов = УникальныеПосещенияПоПациентам.Количество();
    

	Возврат Константы.омг_ГруппаЛабораторныхИсследований.Получить();
КонецФункции

&НаСервере
Процедура ПолучитьДанныеДляДашбоарда(ГруппаЛабУслуг) Экспорт
	
	ПериодС = Период;
	ПериодПо = КонецМесяца(Период);
	
	ЧекНеПробит = Перечисления.СостоянияЧековККМ.ЧекиНеПробиты;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.Филиал КАК Филиал,
	               |	Филиалы.Организация КАК Организация,
	               |	Продажи.Сумма КАК Сумма,
	               |	Продажи.СуммаБезСкидок КАК СуммаБезСкидок,
	               |	Продажи.Количество КАК Количество,
	               |	ВЫБОР
	               |		КОГДА Продажи.Номенклатура В ИЕРАРХИИ (&ГруппаЛИС)
	               |			ТОГДА ""Лабораторные услуги""
	               |		ИНАЧЕ ""Медицинские услуги""
	               |	КОНЕЦ КАК ТипУслуги,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ДокРегистратор.омг_СтраховаяПрограмма.Код, """") = """"
	               |				И ДокРегистратор.СостояниеЧековККМ <> &СостояниеНЕПробиты
	               |			ТОГДА ""Платные""
	               |		КОГДА ДокРегистратор.омг_СтраховаяПрограмма <> """"
	               |			ТОГДА ""ГОБМП""
	               |		ИНАЧЕ ""Неопределен""
	               |	КОНЕЦ КАК ТипОплаты,
	               |	ДокРегистратор.СостояниеЧековККМ КАК СостояниеЧековККМ,
	               |	ДокРегистратор.омг_СтраховаяПрограмма КАК омг_СтраховаяПрограмма,
	               |	Продажи.Клиент КАК Клиент,
	               |	Продажи.Сотрудник КАК Сотрудник,
	               |	Продажи.Номенклатура КАК Номенклатура,
	               |	ДокРегистратор.Ссылка КАК Ссылка,
	               |	Продажи.Период КАК Период,
	               |	Продажи.Клиент.омг_ПостоянныйКлиент КАК ПостоянныйКлиент
	               |ИЗ
	               |	РегистрНакопления.Продажи КАК Продажи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Филиалы КАК Филиалы
	               |		ПО Продажи.Филиал = Филиалы.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг КАК ДокРегистратор
	               |		ПО Продажи.Регистратор.Ссылка = ДокРегистратор.Ссылка
	               |ГДЕ
	               |	Продажи.Период МЕЖДУ &ПериодС И &ПериодПо
	               |	И (&ПоВсейГруппеКомпаний
	               |			ИЛИ НЕ &ПоВсейГруппеКомпаний
	               |				И &ФилиалОрганизация ЕСТЬ NULL
	               |				И &МедицинскийЦентр ЕСТЬ NULL
	               |			ИЛИ НЕ &ПоВсейГруппеКомпаний
	               |				И Филиалы.Организация = &ФилиалОрганизация
	               |			ИЛИ НЕ &ПоВсейГруппеКомпаний
	               |				И Продажи.Филиал = &МедицинскийЦентр)";
	Запрос.УстановитьПараметр("ПериодС", ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);
	Запрос.УстановитьПараметр("ФилиалОрганизация", Филиал);
	Запрос.УстановитьПараметр("МедицинскийЦентр", МедицинскийЦентр);
	Запрос.УстановитьПараметр("ПоВсейГруппеКомпаний", ПоВсейГруппеКомпаний);
	Запрос.УстановитьПараметр("ГруппаЛИС", ГруппаЛабУслуг);  
	Запрос.УстановитьПараметр("СостояниеНЕПробиты", ЧекНеПробит);
	РезультатЗапроса = Запрос.Выполнить();
	//ТЗРезультат = Новый ТаблицаЗначений;
	//ТЗРезультат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	//ТЗРезультат.Колонки.Добавить("МедицинскийЦентр", Новый ОписаниеТипов("СправочникСсылка.Филиалы"));
	//ТЗРезультат.Колонки.Добавить("ТипУслуги", Новый ОписаниеТипов("Строка"));
	//ТЗРезультат.Колонки.Добавить("ТипОплаты", Новый ОписаниеТипов("Строка"));
	//КолонкаСумма = ТЗРезультат.Колонки.Добавить("Сумма");
	//КолонкаСумма.ТипЗначения = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2));
	// 
	//КолонкаСуммаБезСкидок = ТЗРезультат.Колонки.Добавить("СуммаБезСкидок");
	//КолонкаСуммаБезСкидок.ТипЗначения = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2));
	
	//КолонкаКоличество = ТЗРезультат.Колонки.Добавить("Количество");
	//КолонкаКоличество.ТипЗначения = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3));    
	Выборка = РезультатЗапроса.Выбрать();
	ТЗДанные.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗДанные.Добавить();
		НоваяСтрока.Организация = Выборка.Организация;
		НоваяСтрока.МедицинскийЦентр = Выборка.Филиал;
		НоваяСтрока.ТипУслуги = Выборка.ТипУслуги;
		НоваяСтрока.ТипОплаты = Выборка.ТипОплаты;
		НоваяСтрока.Сумма = Выборка.Сумма;
		НоваяСтрока.СуммаБезСкидок = Выборка.СуммаБезСкидок;
		НоваяСтрока.Количество = Выборка.Количество;
		НоваяСтрока.Документ = Выборка.Ссылка;
		НоваяСтрока.Период = Выборка.Период;
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Клиент = Выборка.Клиент; 
		НоваяСтрока.ПостоянныйКлиент = Выборка.ПостоянныйКлиент;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьПоказатели(Команда)
	ТЗПоказатели.Очистить();
	      
	РассчитатьСредниеЧеки();
	РассчитатьДоходы();
	РассчитатьКоличествоУникальныхПациентов();  
	РассчитатьКоличествоПосещений();
	РассчитатьКоличествоПостоянныхПациентов();
	РассчитатьПроцентПовторныхПосещений();        
    РассчитатьПроцентПостоянныхКлиентов();
	РассчитатьКоличествоПриемов();
	РассчитатьКоличествоНовыхКлиентов();
КонецПроцедуры





&НаКлиенте
Процедура РассчитатьСредниеЧеки()
    
    ОбщийСреднийЧек = РассчитатьСреднийЧекПоФильтрам(Новый Массив);
	ПоказательСреднийЧек = ОпределитьПоказатель ("Средний чек");
    ДобавитьПоказатель(ПоказательСреднийЧек, "Общий", , , , , ОбщийСреднийЧек);
    
    РассчитатьВсеРазрезыСреднегоЧека(ПоказательСреднийЧек);
    
КонецПроцедуры


&НаСервере
Функция ОпределитьПоказатель(ТипПоказателя)
	Если ТипПоказателя = "Средний чек" Тогда
		Показатель = Справочники.ПоказателиПланирования.СреднийЧек;
	ИначеЕсли ТипПоказателя = "Доход" Тогда
		Показатель = Справочники.ПоказателиПланирования.Доход;
	ИначеЕсли ТипПоказателя = "Количество уникальных пациентов" Тогда
		Показатель = Справочники.ПоказателиПланирования.КоличествоУникальныхПациентов;
	ИначеЕсли ТипПоказателя = "Количество посещений" Тогда
		Показатель = Справочники.ПоказателиПланирования.КоличествоВизитов;		
	ИначеЕсли ТипПоказателя = "Количество постоянных пациентов" Тогда
		Показатель = Справочники.ПоказателиПланирования.КоличествоПостоянныхПациентов;
	ИначеЕсли ТипПоказателя = "Процент повторных посещений" Тогда          
        Показатель = Справочники.ПоказателиПланирования.ПроцентПовторныхПосещений;
    ИначеЕсли ТипПоказателя = "Процент постоянных клиентов" Тогда          
        Показатель = Справочники.ПоказателиПланирования.ПроцентПостоянныхКлиентов;
	ИначеЕсли ТипПоказателя = "Количество первичных приемов" Тогда
        Показатель = Справочники.ПоказателиПланирования.КоличествоПервичныхПриемов;
    ИначеЕсли ТипПоказателя = "Количество повторных приемов" Тогда
        Показатель = Справочники.ПоказателиПланирования.КоличествоПовторныхПриемов;
	ИначеЕсли ТипПоказателя = "Количество новых клиентов" Тогда
        Показатель = Справочники.ПоказателиПланирования.КоличествоНовыхПациентов;
	КонецЕсли;
	
	Возврат Показатель;
		
        
КонецФункции


&НаКлиенте
Процедура РассчитатьВсеРазрезыСреднегоЧека(ПоказательСреднийЧек)
    
    Организации = ПолучитьУникальныеЗначения("Организация");
    МедЦентры = ПолучитьУникальныеЗначения("МедицинскийЦентр");
    СоответствиеМедЦентрОрганизация = ПолучитьСоответствиеМедЦентрОрганизация();
    
    ТипыУслуг = Новый Массив;
    ТипыУслуг.Добавить("Лабораторные услуги");
    ТипыУслуг.Добавить("Медицинские услуги");
    
    ТипыОплат = Новый Массив;
    ТипыОплат.Добавить("ГОБМП");
    ТипыОплат.Добавить("Платные");
    
    РассчитатьБазовыеРазрезы(ПоказательСреднийЧек, ТипыУслуг, ТипыОплат);
    
    РассчитатьРазрезыПоОрганизациям(ПоказательСреднийЧек, Организации, ТипыУслуг, ТипыОплат);
    
    РассчитатьРазрезыПоМедЦентрам(ПоказательСреднийЧек, МедЦентры, СоответствиеМедЦентрОрганизация, ТипыУслуг, ТипыОплат);
    
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьБазовыеРазрезы(ПоказательСреднийЧек, ТипыУслуг, ТипыОплат)
    Для Каждого ТипУслуги Из ТипыУслуг Цикл
        Фильтр = Новый Массив;
        Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипУслуги", ТипУслуги));
        
        СреднийЧек = РассчитатьСреднийЧекПоФильтрам(Фильтр);
		
        ДобавитьПоказатель(ПоказательСреднийЧек, "По типам услуг", ТипУслуги, , , , СреднийЧек);
    КонецЦикла;
    
    Для Каждого ТипУслуги Из ТипыУслуг Цикл
        Для Каждого ТипОплаты Из ТипыОплат Цикл
            Фильтр = Новый Массив;
            Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипУслуги", ТипУслуги));
            Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипОплаты", ТипОплаты));
            
            СреднийЧек = РассчитатьСреднийЧекПоФильтрам(Фильтр);
            ДобавитьПоказатель(ПоказательСреднийЧек, "По типам оплат и услуг", ТипУслуги, ТипОплаты, , , СреднийЧек);
        КонецЦикла;
    КонецЦикла;
    
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьРазрезыПоОрганизациям(ПоказательСреднийЧек, Организации, ТипыУслуг, ТипыОплат)
    Для Каждого Элемент Из Организации Цикл
        Организация = Элемент.Ключ;
        
        // Только организация
        Фильтр = Новый Массив;
        Фильтр.Добавить(Новый Структура("Колонка, Значение", "Организация", Организация));
        СреднийЧек = РассчитатьСреднийЧекПоФильтрам(Фильтр);
		
        ДобавитьПоказатель(ПоказательСреднийЧек, "По организациям", , , Организация, , СреднийЧек);
        
        // Организация + тип услуги
        Для Каждого ТипУслуги Из ТипыУслуг Цикл
            Фильтр = Новый Массив;
            Фильтр.Добавить(Новый Структура("Колонка, Значение", "Организация", Организация));
            Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипУслуги", ТипУслуги));
            
            СреднийЧек = РассчитатьСреднийЧекПоФильтрам(Фильтр);
            ДобавитьПоказатель(ПоказательСреднийЧек, "По организациям и типам услуг", ТипУслуги, , Организация, , СреднийЧек);
        КонецЦикла;
        
        // Организация + тип услуги + тип оплаты
        Для Каждого ТипУслуги Из ТипыУслуг Цикл
            Для Каждого ТипОплаты Из ТипыОплат Цикл
                Фильтр = Новый Массив;
                Фильтр.Добавить(Новый Структура("Колонка, Значение", "Организация", Организация));
                Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипУслуги", ТипУслуги));
                Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипОплаты", ТипОплаты));
                
                СреднийЧек = РассчитатьСреднийЧекПоФильтрам(Фильтр);
                ДобавитьПоказатель(ПоказательСреднийЧек, "По организациям, типам услуг и оплат", ТипУслуги, ТипОплаты, Организация, , СреднийЧек);
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьРазрезыПоМедЦентрам(ПоказательСреднийЧек, МедЦентры, СоответствиеМедЦентрОрганизация, ТипыУслуг, ТипыОплат)
    Для Каждого Элемент Из МедЦентры Цикл
        МедЦентр = Элемент.Ключ;
        Организация = СоответствиеМедЦентрОрганизация.Получить(МедЦентр);
        
        // Только мед. центр
        Фильтр = Новый Массив;
        Фильтр.Добавить(Новый Структура("Колонка, Значение", "МедицинскийЦентр", МедЦентр));
        СреднийЧек = РассчитатьСреднийЧекПоФильтрам(Фильтр);
        ДобавитьПоказатель(ПоказательСреднийЧек, "По мед. центрам", , , Организация, МедЦентр, СреднийЧек);
        
        // Мед. центр + тип услуги
        Для Каждого ТипУслуги Из ТипыУслуг Цикл
            Фильтр = Новый Массив;
            Фильтр.Добавить(Новый Структура("Колонка, Значение", "МедицинскийЦентр", МедЦентр));
            Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипУслуги", ТипУслуги));
            
            СреднийЧек = РассчитатьСреднийЧекПоФильтрам(Фильтр);
            ДобавитьПоказатель(ПоказательСреднийЧек, "По мед. центрам и типам услуг", ТипУслуги, , Организация, МедЦентр, СреднийЧек);
        КонецЦикла;
        
        // Мед. центр + тип услуги + тип оплаты
        Для Каждого ТипУслуги Из ТипыУслуг Цикл
            Для Каждого ТипОплаты Из ТипыОплат Цикл
                Фильтр = Новый Массив;
                Фильтр.Добавить(Новый Структура("Колонка, Значение", "МедицинскийЦентр", МедЦентр));
                Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипУслуги", ТипУслуги));
                Фильтр.Добавить(Новый Структура("Колонка, Значение", "ТипОплаты", ТипОплаты));
                
                СреднийЧек = РассчитатьСреднийЧекПоФильтрам(Фильтр);
                ДобавитьПоказатель(ПоказательСреднийЧек, "По мед. центрам, типам услуг и оплат", ТипУслуги, ТипОплаты, Организация, МедЦентр, СреднийЧек);
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    
КонецПроцедуры

&НаКлиенте
Функция РассчитатьСреднийЧекПоФильтрам(УсловияФильтрации)
    
    ОбщаяСумма = 0;
    УникальныеВизиты = Новый Соответствие;
    

            КоличествоУникальныхДней = КлючИЗначение.Значение.Количество();
            Если КоличествоУникальныхДней > 1 Тогда
                КоличествоПациентовСПовторными = КоличествоПациентовСПовторными + 1;
            КонецЕсли;
        КонецЦикла;
        
        Возврат (КоличествоПациентовСПовторными / ОбщееКоличествоПациентов) * 100;
    Иначе
        Возврат 0;
    КонецЕсли;
    
КонецФункции

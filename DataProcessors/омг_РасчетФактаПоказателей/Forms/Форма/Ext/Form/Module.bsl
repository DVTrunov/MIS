    МассивКлиентов = Новый Массив;
    Для Каждого Элемент Из КлиентыТекущегоПериода Цикл
        МассивКлиентов.Добавить(Элемент.Ключ);
    КонецЦикла;
    
    Запрос.УстановитьПараметр("ПериодС", ПериодС);
    Запрос.УстановитьПараметр("СписокКлиентов", МассивКлиентов);
    Запрос.УстановитьПараметр("СостояниеНЕПробиты", Перечисления.СостоянияЧековККМ.ЧекиНеПробиты);

    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    КлиентыИзПрошлыхПериодов = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        КлиентыИзПрошлыхПериодов[Выборка.Клиент] = Истина;
    КонецЦикла;
    
    КоличествоНовыхКлиентов = 0;
    Для Каждого Элемент Из КлиентыТекущегоПериода Цикл
        Если КлиентыИзПрошлыхПериодов.Получить(Элемент.Ключ) = Неопределено Тогда
            КоличествоНовыхКлиентов = КоличествоНовыхКлиентов + 1;
        КонецЕсли;
    КонецЦикла;
    
    Возврат КоличествоНовыхКлиентов;
    
КонецФункции
&НаКлиенте
Функция ПолучитьУникальныеЗначения(ИмяКолонки)
	
	УникальныеЗначения = Новый Соответствие;
	
	Для Каждого Строка Из ТЗДанные Цикл
		Значение = Строка[ИмяКолонки];
		Если Значение <> Неопределено Тогда
			УникальныеЗначения[Значение] = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат УникальныеЗначения;
	
КонецФункции 



&НаКлиенте
Процедура ДобавитьПоказатель(Показатель, Разрез, ТипУслуги = Неопределено, ТипОплаты = Неопределено, 
	Организация = Неопределено, МедицинскийЦентр = Неопределено, Значение = 0)
	
	НоваяСтрока = ТЗПоказатели.Добавить();
	НоваяСтрока.Показатель = Показатель;
	НоваяСтрока.Разрез = Разрез;
	НоваяСтрока.ТипУслуги = ТипУслуги;
	НоваяСтрока.ТипОплаты = ТипОплаты;
	НоваяСтрока.Организация = Организация;
	НоваяСтрока.МедицинскийЦентр = МедицинскийЦентр;
	НоваяСтрока.Значение = Значение;
	
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьСоответствиеМедЦентрОрганизация()
	
	Соответствие = Новый Соответствие;
	
	Для Каждого Строка Из ТЗДанные Цикл
		Если Строка.МедицинскийЦентр <> Неопределено И Строка.Организация <> Неопределено Тогда
			Если Соответствие.Получить(Строка.МедицинскийЦентр) = Неопределено Тогда
				Соответствие.Вставить(Строка.МедицинскийЦентр, Строка.Организация);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Соответствие;    
КонецФункции


&НаСервере
Процедура ЗаписатьПоказателиНаСервере()
	НаборЗаписей = РегистрыСведений.омг_ПоказателиДляМонитораРуководителя.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(Период);
	//НаборЗаписей.Прочитать();
	Для Каждого СтрокаПоказателя Из ТЗПоказатели Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Период = Период;
        НоваяЗапись.Показатель = СтрокаПоказателя.Показатель;
        НоваяЗапись.Разрез = СтрокаПоказателя.Разрез;
        НоваяЗапись.ТипУслуги = СтрокаПоказателя.ТипУслуги;
        НоваяЗапись.ТипОплаты = СтрокаПоказателя.ТипОплаты;
        НоваяЗапись.Организация = СтрокаПоказателя.Организация;
        НоваяЗапись.МедицинскийЦентр = СтрокаПоказателя.МедицинскийЦентр;
        НоваяЗапись.Значение = СтрокаПоказателя.Значение;
		
	КонецЦикла;
	НаборЗаписей.Записать();	
	КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПоказатели(Команда)
	ЗаписатьПоказателиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВсеДействия(Команда)
	ОбновитьДанные();
	ТЗПоказатели.Очистить();
	РассчитатьСредниеЧеки();
	РассчитатьДоходы();
	РассчитатьКоличествоУникальныхПациентов();  
	РассчитатьКоличествоПосещений();
	РассчитатьКоличествоПостоянныхПациентов();
	РассчитатьПроцентПовторныхПосещений();        
    РассчитатьПроцентПостоянныхКлиентов();
	РассчитатьКоличествоПриемов();
	РассчитатьКоличествоНовыхКлиентов();
	ЗаписатьПоказателиНаСервере();
	
КонецПроцедуры

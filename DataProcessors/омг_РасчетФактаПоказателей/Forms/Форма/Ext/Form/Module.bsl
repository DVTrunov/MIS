Функция РассчитатьКоличествоПриемовПоФильтрам(УсловияФильтрации)
    
    ПериодС = Период;
    ПериодПо = КонецМесяца(Период);
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    Прием.ЭтоПервичный,
    |    КОЛИЧЕСТВО(Прием.Ссылка) КАК КоличествоПриемов
    |ИЗ
    |    Документ.Прием КАК Прием
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка КАК Заявка
    |        ПО Прием.ДокументОснование = Заявка.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Филиалы КАК Филиалы
    |        ПО Прием.Филиал = Филиалы.Ссылка
    |ГДЕ
    |    Прием.Проведен = Истина
    |    И Прием.ПометкаУдаления = Ложь
    |    И Прием.Дата МЕЖДУ &ПериодС И &ПериодПо
    |    И Заявка.Состояние В (&МассивСостоянийЗаявок)";
    
    Если УсловияФильтрации.Количество() > 0 Тогда
        Запрос.Текст = Запрос.Текст + "
        |    // Условия фильтрации";
        
        Для Каждого Условие Из УсловияФильтрации Цикл
            Если Условие.Колонка = "Организация" Тогда
                Запрос.Текст = Запрос.Текст + "
                |    И Филиалы.Организация = &Организация";
                Запрос.УстановитьПараметр("Организация", Условие.Значение);
            ИначеЕсли Условие.Колонка = "МедицинскийЦентр" Тогда
                Запрос.Текст = Запрос.Текст + "
                |    И Прием.Филиал = &МедицинскийЦентр";
                Запрос.УстановитьПараметр("МедицинскийЦентр", Условие.Значение);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    Запрос.Текст = Запрос.Текст + "
    |СГРУППИРОВАТЬ ПО
    |    Прием.ЭтоПервичный";
    
    МассивСостоянийЗаявок = Новый Массив;
    МассивСостоянийЗаявок.Добавить(Справочники.ВидыСостоянийЗаявок.Выполнена);
    МассивСостоянийЗаявок.Добавить(Справочники.ВидыСостоянийЗаявок.Оплачена);
    МассивСостоянийЗаявок.Добавить(Справочники.ВидыСостоянийЗаявок.Прием);
    
    Запрос.УстановитьПараметр("ПериодС", ПериодС);
    Запрос.УстановитьПараметр("ПериодПо", ПериодПо);
    Запрос.УстановитьПараметр("МассивСостоянийЗаявок", МассивСостоянийЗаявок);

    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Первичные = 0;
    Повторные = 0;
    
    Пока Выборка.Следующий() Цикл
        Если Выборка.ЭтоПервичный Тогда
            Первичные = Первичные + Выборка.КоличествоПриемов;
        Иначе
            Повторные = Повторные + Выборка.КоличествоПриемов;
        КонецЕсли;
    КонецЦикла;
    
    РезультатРасчета = Новый Структура;
    РезультатРасчета.Вставить("Первичные", Первичные);
    РезультатРасчета.Вставить("Повторные", Повторные);
    
    Возврат РезультатРасчета;
    
КонецФункции


	ЭлементыПарам = РаботаСHTMLКлиентСервер.ПолучитьЭлементыПоЗначениюАтрибута(HTMLДокумент, ИмяПараметра,, "data-bit-underline-name");
	Для Каждого ЭлементПарам Из ЭлементыПарам Цикл
		
		Если ИдентификаторПодчеркнутогоЭлемента <> Неопределено
			И ЭлементПарам.ПолучитьАтрибут("data-bit-underline-id") = ИдентификаторПодчеркнутогоЭлемента
		Тогда
			// в отдельную процедуру
			ЭлементПарам.УстановитьАтрибут("style", "border-bottom:1px solid gray");
		КонецЕсли;
		ЭлементПарам.УдалитьАтрибут("data-bit-underline-name");
		ЭлементПарам.УдалитьАтрибут("data-bit-underline-id");
	КонецЦикла;
	

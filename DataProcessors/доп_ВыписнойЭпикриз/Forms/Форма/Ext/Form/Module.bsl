&НаКлиенте
Перем ДанныеЗаголовка;

&НаКлиенте
Перем ЭлементыТаблиц;

&НаКлиенте
Перем СтраницыТекстовыхПолей;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервереБезКонтекста
Функция ВычислитьЗначениеПараметра(Параметр, ДокументОбъект, Выражение, Параметры)
	
	Результат = Неопределено;
	
	Попытка
		Выполнить(Выражение)
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось вычислить значение параметра """ + Параметр + """
		|" + ОписаниеОшибки();
		Сообщение.Сообщить();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.СтруктураШапки <> Неопределено Тогда
		ПервичныйПрием		= Параметры.СтруктураШапки.ПервичныйПрием;
		ТекущийПрием		= Параметры.СтруктураШапки.Ссылка;
		Филиал				= Параметры.СтруктураШапки.Филиал;
		Клиент				= Параметры.СтруктураШапки.Клиент;
		МедицинскаяКарта	= Параметры.СтруктураШапки.МедицинскаяКарта;
	КонецЕсли;
	
	ЗаполнитьОсмотры();
	АвтозаполнениеПараметров();
	
	ТекстВерсии = СтрШаблон(НСтр("ru='Версия %1'"), РеквизитФормыВЗначение("Объект").ВерсияОбработки());
	Элементы.ВерсияОбработки.Заголовок = ТекстВерсии;
	Элементы.ГруппаВерсия.Заголовок = ТекстВерсии;
	
	УстановитьПараметрыВыбора();
	ИсходВыписан = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(1, Перечисления.ВидыКлассификаторовМинЗдрава.ИсходыГоспитализации);
	
	ШаблонЭпикризаНачало = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ШаблонЭпикризаНачало");
	ШаблонЭпикризаКонец = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ШаблонЭпикризаКонец");
	ШаблонЭпикриза = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Шаблон").ПолучитьТекст();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныHTMLСоответствияПараметрам.Наименование КАК Наименование,
	               |	ШаблоныHTMLСоответствияПараметрам.Параметр.ТипЗначения КАК ТипЗначения,
	               |	ШаблоныHTMLСоответствияПараметрам.Представление КАК Представление,
	               |	ШаблоныHTMLСоответствияПараметрам.Параметр.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	               |	ШаблоныHTMLСоответствияПараметрам.Параметр КАК Параметр,
	               |	ШаблоныHTMLСоответствияПараметрам.Параметр.ФорматнаяСтрока КАК ФорматнаяСтрока,
	               |	ШаблоныHTMLСоответствияПараметрам.Параметр.ЗначениеПоУмолчанию.АлгоритмВычисления КАК АлгоритмВычисления
	               |ИЗ
	               |	Справочник.ШаблоныHTML.СоответствияПараметрам КАК ШаблоныHTMLСоответствияПараметрам
	               |ГДЕ
	               |	ШаблоныHTMLСоответствияПараметрам.Ссылка = &Ссылка И Параметр В (&ПараметрыПриема)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВычисляемыеЗначенияПараметровСписокПеременных.Ссылка КАК Параметр,
	               |	ВычисляемыеЗначенияПараметровСписокПеременных.Параметр КАК ВложенныйПараметр,
	               |	ВычисляемыеЗначенияПараметровСписокПеременных.Параметр.Наименование КАК ИмяПараметра,
	               |	ВычисляемыеЗначенияПараметровСписокПеременных.ИмяПеременной КАК ИмяПеременной,
	               |	ВычисляемыеЗначенияПараметровСписокПеременных.Параметр.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	               |	ЕстьNull(ВычисляемыеЗначенияПараметровСписокПеременных.Параметр.ЗначениеПоУмолчанию.АлгоритмВычисления, """") КАК АлгоритмВычисления
	               |ИЗ
	               |	Справочник.ВычисляемыеЗначенияПараметров.СписокПеременных КАК ВычисляемыеЗначенияПараметровСписокПеременных
	               |ИТОГИ ПО
	               |	Параметр";
	МассивПараметровПриема = Новый Массив;
	Для Каждого ДанныеПараметра Из Параметры.ЗначенияПараметров Цикл
		МассивПараметровПриема.Добавить(ДанныеПараметра.Параметр);
	КонецЦикла;
	Запрос.УстановитьПараметр("ПараметрыПриема", МассивПараметровПриема);
	Запрос.УстановитьПараметр("Ссылка", Параметры.ШаблонПриема);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	ВыборкаПараметров = ПакетРезультатов.Получить(0).Выбрать();
	ВыборкаВложенныеПараметрыПоВладельцу = ПакетРезультатов.Получить(1).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДобавляемыеРеквизиты = Новый Массив;
	
	Пока ВыборкаПараметров.Следующий() Цикл
		УИдРеквизита = "_" + СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
		СтрокаПараметров = СписокПараметров.Добавить();
		СтрокаПараметров.Имя = ВыборкаПараметров.Наименование;
		СтрокаПараметров.УИд = УИдРеквизита;
		СтрокаПараметров.Представление = ВыборкаПараметров.Представление;
		СтрокаПараметров.Параметр = ВыборкаПараметров.Параметр;
		СтрокаПараметров.ФорматнаяСтрока = ВыборкаПараметров.ФорматнаяСтрока;
		СтрокаПараметров.Алгоритм = ВыборкаПараметров.АлгоритмВычисления;
		ВыборкаВложенныеПараметрыПоВладельцу.Сбросить();
		Если ВыборкаВложенныеПараметрыПоВладельцу.НайтиСледующий(ВыборкаПараметров.ЗначениеПоУмолчанию) Тогда
			ВыборкаВложенныеПараметры = ВыборкаВложенныеПараметрыПоВладельцу.Выбрать();
			Пока ВыборкаВложенныеПараметры.Следующий() Цикл
				
				ВложенныйПараметр = Новый Структура;
				ВложенныйПараметр.Вставить("ИмяПеременной", ВыборкаВложенныеПараметры.ИмяПеременной);
				ВложенныйПараметр.Вставить("Параметр", ВыборкаВложенныеПараметры.ВложенныйПараметр);
				ВложенныйПараметр.Вставить("Имя", ВыборкаВложенныеПараметры.ИмяПараметра);
				ВложенныйПараметр.Вставить("Алгоритм", ВыборкаВложенныеПараметры.АлгоритмВычисления);
				
				СтрокаПараметров.ВложенныеПараметры.Добавить(ВложенныйПараметр);
			КонецЦикла;
		КонецЕсли;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(УИдРеквизита, ВыборкаПараметров.ТипЗначения,, ВыборкаПараметров.Представление));
	КонецЦикла;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	ВыборкаПараметров.Сбросить();
	СтруктураПоиска = Новый Структура("Имя");
	Пока ВыборкаПараметров.Следующий() Цикл
		Если ТипЗнч(ВыборкаПараметров.ЗначениеПоУмолчанию) = Тип("СправочникСсылка.ВычисляемыеЗначенияПараметров") Тогда
			Продолжить;
		КонецЕсли;
		СтруктураПоиска.Имя = ВыборкаПараметров.Наименование;
		Параметр = СписокПараметров.НайтиСтроки(СтруктураПоиска)[0].УИд;
		ПолеПараметра = Элементы.Добавить(Параметр, Тип("ПолеФормы"), Элементы.СтраницаПараметрыОбщиеДанные);
		ПолеПараметра.ПутьКДанным = Параметр;
		ПолеПараметра.Вид = ВидПоляФормы.ПолеВвода;
		
		ЭтаФорма[Параметр] = ВыборкаПараметров.ЗначениеПоУмолчанию;

		Для Каждого СохраненныйПараметр Из Параметры.ЗначенияПараметров Цикл
			Если СохраненныйПараметр.Параметр = ВыборкаПараметров.Параметр Тогда
				ЭтаФорма[Параметр] = СохраненныйПараметр.Значение;
			КонецЕсли;
		КонецЦикла;
		
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодтверждениеЗакрытияФормы = Ложь;
	
	ЭлементыТаблиц = Новый Соответствие;
	ЭлементыТаблиц.Вставить(Элементы.ГруппаКонсультации,			 Элементы.Консультации);
	
	СтраницыТекстовыхПолей = Новый Массив;
	
	ДанныеЗаголовка = Новый Структура;
	ЗаполнитьСтруктуруДанныхЗаголовка(ДанныеЗаголовка);
	
	ЗаполнитьТекстыHTML();
	ЗаполнитьЗаголовкиТекстовРекомендаций();
	
	ОбновитьПолныйТекстHTML();
	ОбновитьОсмотр();
	
	УстановитьДоступностьПоИсходу();
	
КонецПроцедуры


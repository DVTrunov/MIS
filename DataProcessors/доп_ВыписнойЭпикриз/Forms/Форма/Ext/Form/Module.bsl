// Обязательная процедура
//  массив параметрво содержит имя параметра (реквизита формы), а так же его значение
//  в "Текст" хранится строка которая будет выведена на форме в документе "Прием"
//  Должна возвращать структуру с массивом параметров и текстом
//
&НаКлиенте
Процедура Сохранить(Команда)
	
	Если ЗначениеЗаполнено(Объект.ОрганизацияПеревода)
		И Не ЗначениеЗаполнено(Объект.ВидСтационараОрганизацииПеревода)
	Тогда
		ПоказатьПредупреждение(, НСтр("ru='Необходимо указать вид стационара организации, в которую переведён пациент'"));
		Возврат;
	КонецЕсли;
	
	ОбновитьПолныйТекстHTML();
	ПодтверждениеЗакрытияФормы = Истина;
	СтруктураВозврата = СохранитьНаСервере();
	Закрыть(СтруктураВозврата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СобытийФормы

&НаСервере
Функция СохранитьНаСервере()
	
	Если Объект.ИсходГоспитализации = ИсходВыписан Тогда
		Объект.ПодразделениеПеревода = Неопределено;
		Объект.ОрганизацияПеревода = Неопределено;
	ИначеЕсли ЗначениеЗаполнено(Объект.ПодразделениеПеревода) Тогда
		Объект.ОрганизацияПеревода = Неопределено;
		Объект.ВидСтационараОрганизацииПеревода = Неопределено;
	ИначеЕсли ЗначениеЗаполнено(Объект.ОрганизацияПеревода) Тогда
		Объект.ПодразделениеПеревода = Неопределено;
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	МассивПараметров = Новый Массив;
	ТаблицаПараметров = Новый Массив;
	
	МетаданныеОбработки = РеквизитФормыВЗначение("Объект").Метаданные();
	//Для Каждого Реквизит Из МетаданныеОбработки.Реквизиты Цикл
	Для Каждого Реквизит Из СписокПараметров Цикл
		//СтрокаПараметра = Параметры.ШаблонПриема.СоответствияПараметрам.Найти(Реквизит.Имя, "Наименование");
		//Если СтрокаПараметра = Неопределено Тогда
		//	Продолжить;
		//КонецЕсли;
		
		//МассивПараметров.Добавить(Новый Структура("Параметр, Значение", СтрокаПараметра.Параметр, Объект[Реквизит.Имя]));
		МассивПараметров.Добавить(Новый Структура("Параметр, Значение", Реквизит.Имя, ЭтаФорма[Реквизит.УИд]));
	КонецЦикла;
	
	Для Каждого ТЧ Из МетаданныеОбработки.ТабличныеЧасти Цикл
		Для Каждого СтрокаТЧ Из Объект[ТЧ.Имя] Цикл
			Если Не ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторСтроки) Тогда
				СтрокаТЧ.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				СтрокаПараметраТаблицы = Параметры.ШаблонПриема.СоответствияТаблицамШаблонов.НайтиСтроки(Новый Структура("ТаблицаОбработки, Наименование", ТЧ.Имя, Реквизит.Имя));
				Если СтрокаПараметраТаблицы.Количество() > 0 Тогда
					ПараметрыДинТаблицы = Новый Структура;
					ПараметрыДинТаблицы.Вставить("СсылкаНаТаблицу", СтрокаПараметраТаблицы[0].ТаблицаШаблонов);
					ПараметрыДинТаблицы.Вставить("НомерСтрокиТаблицы", Объект[ТЧ.Имя].Индекс(СтрокаТЧ) + 1);
					ПараметрыДинТаблицы.Вставить("ИдентификаторСтроки", СтрокаТЧ.ИдентификаторСтроки);
					ПараметрыДинТаблицы.Вставить("Параметр", СтрокаПараметраТаблицы[0].Параметр);
					ПараметрыДинТаблицы.Вставить("Значение", СтрокаТЧ[Реквизит.Имя]);
					
					ТаблицаПараметров.Добавить(ПараметрыДинТаблицы);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	СтруктураВозврата.Вставить("МассивПараметров",			 МассивПараметров);
	СтруктураВозврата.Вставить("ТаблицаПараметров",			 ТаблицаПараметров);
	СтруктураВозврата.Вставить("ПредставлениеОсмотра",		 ТекстHTMLОбщий);
	СтруктураВозврата.Вставить("ИдентификаторСтрокиШаблона", Параметры.ИдентификаторСтрокиШаблона);
	СтруктураВозврата.Вставить("Действие",					 "ЗаполнениеОсмотраПоРезультатуОбработки");
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЗаголовкиТекстовРекомендаций()
	
	// Рекомендации
	ЗначениеПустогоТекстаРекомендаций = ЗначениеПустогоТекстаРекомендаций();

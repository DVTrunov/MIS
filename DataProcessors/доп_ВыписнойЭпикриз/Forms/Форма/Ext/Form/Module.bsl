&НаСервереБезКонтекста
Функция ПолучитьДанныеПриема(Прием)
	
	ДанныеПриема = Новый Структура("Дата, ФИОВрача, ДолжностьПредставление, СпециализацияПредставление, НМУ");
	
	Если ЗначениеЗаполнено(Прием) Тогда
		ДанныеПриема.Дата = Прием.Дата;
		
		ЗаполнитьЗначенияСвойств(ДанныеПриема, ПолучитьДанныеВрача(Прием.Врач));
		
		мНМУ = Новый Массив;
		Для Каждого СтрокаРаботы Из Прием.Работы Цикл
			Если ЗначениеЗаполнено(СтрокаРаботы.Номенклатура.НоменклатураМедицинскихУслуг) Тогда
				НМУ = СтрокаРаботы.Номенклатура.НоменклатураМедицинскихУслуг;
				мНМУ.Добавить(СтрШаблон("%1 [%2]", НМУ.ПолноеНаименование, НМУ.Код));
			КонецЕсли;
		КонецЦикла;
		
		ДанныеПриема.НМУ = СтрСоединить(мНМУ, ", ");
	КонецЕсли;
	
	Возврат ДанныеПриема;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеВрача(Врач)
	
	ДанныеВрача = Новый Структура("ФИОВрача, ДолжностьПредставление, СпециализацияПредставление");
	
	ДанныеВрача.ФИОВрача = ОбщегоНазначения.ФИОФизЛица(Врач);
	Если ЗначениеЗаполнено(Врач.Должность) Тогда
		ДанныеВрача.ДолжностьПредставление = Врач.Должность.ДолжностьМинздрава.НаименованиеПолное;
	КонецЕсли;
	Если Врач.СпециализацииФРМР.Количество() > 0 Тогда
		ДанныеВрача.СпециализацияПредставление = Врач.СпециализацииФРМР[0].Специализация.НаименованиеПолное;
	КонецЕсли;
	
	Возврат ДанныеВрача;
	
КонецФункции


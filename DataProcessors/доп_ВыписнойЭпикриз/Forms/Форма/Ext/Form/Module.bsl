&НаСервереБезКонтекста
Функция ПолучитьДанныеЛНПоМедкартеДляСтационара(МедКарта) Экспорт
	
	ПервыйЛН = ПолучитьДАнныеПервогоЛН(МедКарта);
	
	СтруктураВозврата = ПолучитьСтруктуруЛН();
	
	Если ПервыйЛН.Следующий() Тогда
		
		СтруктураВозврата.НомерЛН = ПервыйЛН.Номер;
		СтруктураВозврата.ДатаНачала = ПервыйЛН.Запись1ДатаНачала;
		СтруктураВозврата.ДатаОкончания = Макс(ПервыйЛН.Запись1ДатаОкончания, ПервыйЛН.Запись2ДатаОкончания, ПервыйЛН.Запись3ДатаОкончания);
		СтруктураВозврата.ВидЛистка = ПервыйЛН.ВидЛистка;
		СтруктураВозврата.Дубликат = ПервыйЛН.Дубликат;
		Если СтруктураВозврата.Дубликат Тогда
			СтруктураВозврата.Вставить("ДокументОснованиеНомер", ?(ТипЗнч(ПервыйЛН.ДокументОснование) = Тип("Строка"), ПервыйЛН.ДокументОснование, ПервыйЛН.ДокументОснование.Номер));
		КонецЕсли;
		
		Если ПервыйЛН.СледующийЛН <> "" Тогда
			СтруктураВозврата.ЛНПродолжение = ПолучитьДанныеЛНПоНомеру(Число(ПервыйЛН.СледующийЛН));
		КонецЕсли;
		
		//Если ЗначениеЗаполнено(СтруктураВозврата.ЛНПродолжение) Тогда
		//	СтруктураВозврата.ДатаВыходаНаРаботу = Макс(СтруктураВозврата.ДатаОкончания, СтруктураВозврата.ЛНПродолжение.ДатаНачалаРаботы);
		//Иначе
		//	СтруктураВозврата.ДатаВыходаНаРаботу = СтруктураВозврата.ДатаОкончания;
		//КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеПервогоЛН(МедКарта)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛистокНетрудоспособности.Номер КАК Номер,
		|	ЛистокНетрудоспособности.Дата КАК Дата,
		|	ЛистокНетрудоспособности.Запись1ДатаНачала КАК Запись1ДатаНачала,
		|	ЛистокНетрудоспособности.Запись1ДатаОкончания КАК Запись1ДатаОкончания,
		|	ЛистокНетрудоспособности.Запись2ДатаОкончания КАК Запись2ДатаОкончания,
		|	ЛистокНетрудоспособности.Запись3ДатаОкончания КАК Запись3ДатаОкончания,
		|	ЛистокНетрудоспособности.ВидЛистка КАК ВидЛистка,
		|	ЛистокНетрудоспособности.Дубликат КАК Дубликат,
		|	ЛистокНетрудоспособности.ДокументОснование КАК ДокументОснование,
		|	ЛистокНетрудоспособности.СледующийЛН КАК СледующийЛН
		|ИЗ
		|	Документ.ЛистокНетрудоспособности КАК ЛистокНетрудоспособности
		|ГДЕ
		|	ЛистокНетрудоспособности.МедицинскаяКарта = &МедКарта
		|	И НЕ ЛистокНетрудоспособности.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	Запрос.УстановитьПараметр("МедКарта", МедКарта);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруЛН()
	
	СтруктураВозврата = Новый Структура;
	
	СтруктураВозврата.Вставить("НомерЛН");
	СтруктураВозврата.Вставить("ДатаНачала");
	СтруктураВозврата.Вставить("ДатаОкончания");
	СтруктураВозврата.Вставить("Дубликат");
	СтруктураВозврата.Вставить("ЛНПродолжение");
	//СтруктураВозврата.Вставить("ДатаВыходаНаРаботу", Дата(1,1,1));
	СтруктураВозврата.Вставить("ВидЛистка");
	
	Возврат СтруктураВозврата;
	

	Элементы.ТрудовыеРекомендации.Заголовок		= ?(ЗначениеЗаполнено(Объект.ТрудовыеРекомендации),		Объект.ТрудовыеРекомендации,	ЗначениеПустогоТекстаРекомендаций);
	Элементы.ПрочиеРекомендации.Заголовок		= ?(ЗначениеЗаполнено(Объект.ПрочиеРекомендации),		Объект.ПрочиеРекомендации,		ЗначениеПустогоТекстаРекомендаций);
	Элементы.РежимИДиета.Заголовок				= ?(ЗначениеЗаполнено(Объект.РежимИДиета),				Объект.РежимИДиета,				ЗначениеПустогоТекстаРекомендаций);
	
КонецПроцедуры


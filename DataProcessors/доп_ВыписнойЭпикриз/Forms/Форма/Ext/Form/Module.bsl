&НаСервере
Процедура ЗаполнитьСтруктуруДанныхЗаголовка(ДанныеЗаголовка)
	
	РеквизитыОрганизации = ПроцедурыСпециализацииПоставки.ПолучитьРеквизитыОрганизации(Филиал);
	ЮрАдрес = Новый Структура("Страна, СубъектРФ, Район, Город, НаселПункт, Улица, Дом, Корпус, Квартира");
	ЗаполнитьЗначенияСвойств(ЮрАдрес, МедицинскаяДеятельность.ПолучитьАдресКлиентаДляМедкарты(Клиент, Ложь, Справочники.ВидыКонтактнойИнформации.АдресЮридический));
	ФактАдрес = Новый Структура("Страна, СубъектРФ, Район, Город, НаселПункт, Улица, Дом, Корпус, Квартира");
	ЗаполнитьЗначенияСвойств(ФактАдрес, МедицинскаяДеятельность.ПолучитьАдресКлиентаДляМедкарты(Клиент, Ложь, Справочники.ВидыКонтактнойИнформации.АдресФактический));
	
	ДанныеЗаголовка.Вставить("НазваниеОрганизации",    РеквизитыОрганизации.НазваниеОрганизации);
	ДанныеЗаголовка.Вставить("ОГРН",          РеквизитыОрганизации.ОГРН);
	ДанныеЗаголовка.Вставить("ФИОКлиента",        ОбщегоНазначения.ФИОФизЛица(Клиент));
	ДанныеЗаголовка.Вставить("НомерМедицинскойКарты",  НомерКарты);
	ДанныеЗаголовка.Вставить("ПолКлиента",        Клиент.Пол);
	ДанныеЗаголовка.Вставить("ДатаРожденияКлиента",    Формат(Клиент.ДатаРождения, "ДЛФ=Д"));
	ДанныеЗаголовка.Вставить("ЮрАдрес",          ЮрАдрес);
	ДанныеЗаголовка.Вставить("ФактАдрес",        ФактАдрес);
	ДанныеЗаголовка.Вставить("Подразделение",      Подразделение.Наименование);
	
КонецПроцедуры

&НаСервере
Процедура АвтозаполнениеПараметров()
	
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеПребывания = Стационар.ПолучитьОписаниеПребыванияПациентаВСтационареПоМедкарте(МедицинскаяКарта);
	Обращение = ОписаниеПребывания.Обращение;
	НомерКарты = МедицинскаяКарта.НомерКарты;
	
	ДатаИДокументКлиническогоДиагноза = Стационар.ДанныеДокументаКлиническогоДиагнозаМедкарты(МедицинскаяКарта);
	Если ЗначениеЗаполнено(ДатаИДокументКлиническогоДиагноза.Документ) Тогда
		ОписаниеДиагнозов = Стационар.СтандатноеОписаниеДиагнозовМД_003(ДатаИДокументКлиническогоДиагноза.Документ).ОписаниеДиагнозов;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Обращение) Тогда
		ДатаПоступления = Обращение.ДатаВремяПоступления;
		Если ЗначениеЗаполнено(ДатаПоступления) Тогда
			ДатаВыписки = ОписаниеПребывания.ДатаВыписки;
			Если Не ЗначениеЗаполнено(ДатаВыписки) Тогда
				ДатаВыписки = КонецДня(ДатаПоступления);
			КонецЕсли;
			Объект.ДатаВыписки = ДатаВыписки;
		КонецЕсли;
	
		Подразделение = Обращение.Подразделение;
		ВидСтационара = Подразделение.ВидСтационара;
	КонецЕсли;
	
	СформироватьТекстНетрудоспособности();
	
	МетаданныеОбработки = РеквизитФормыВЗначение("Объект").Метаданные();
	
	Для Каждого ЗначениеПарметра Из Параметры.ЗначенияПараметров Цикл
		
		Если Не ЗначениеЗаполнено(ЗначениеПарметра.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПараметра = Параметры.ШаблонПриема.СоответствияПараметрам.Найти(ЗначениеПарметра.Параметр, "Параметр");
		Если СтрокаПараметра = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если МетаданныеОбработки.Реквизиты.Найти(СтрокаПараметра.Наименование) <> Неопределено Тогда
			Объект[СтрокаПараметра.Наименование] = ЗначениеПарметра.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Обращение) Тогда
		ДатаПоступления = Обращение.ДатаВремяПоступления;
		Если ЗначениеЗаполнено(ДатаПоступления) Тогда
			Объект.ДатаПоступления = ДатаПоступления;
		КонецЕсли;
		ОбновитьПродолжительностьГоспитализации();
	КонецЕсли;
	
	ТаблицыПараметров = Новый Соответствие;
	ТаблицыОбработки = Новый Массив;
	
	Для Каждого ПараметрТШ Из Параметры.ЗначенияПараметровТаблицШаблона Цикл
		
		Таблица = ТаблицыПараметров.Получить(ПараметрТШ.ИдентификаторТаблицы);
		Если Таблица = Неопределено Тогда
			Попытка
				Таблица = Справочники.ТаблицыШаблоновПриема.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрТШ.ИдентификаторТаблицы));
				ТаблицыПараметров.Вставить(ПараметрТШ.ИдентификаторТаблицы, Таблица);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		СтрокиПараметра = Параметры.ШаблонПриема.СоответствияТаблицамШаблонов.НайтиСтроки(Новый Структура("ТаблицаШаблонов, Параметр", Таблица, ПараметрТШ.Параметр));
		Если СтрокиПараметра.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяТаблицы = СтрокиПараметра[0].ТаблицаОбработки;
		ИмяКолонки = СтрокиПараметра[0].Наименование;
		
		МетаданныеТаблицы = МетаданныеОбработки.ТабличныеЧасти.Найти(ИмяТаблицы);
		Если МетаданныеТаблицы = Неопределено
			Или МетаданныеТаблицы.Реквизиты.Найти(ИмяКолонки) = Неопределено
		Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаОбработки = Объект[ИмяТаблицы];
		Пока ПараметрТШ.НомерСтрокиТаблицы > ТаблицаОбработки.Количество() Цикл
			ТаблицаОбработки.Добавить();
		КонецЦикла;
		
		СтрокаТаблицы = ТаблицаОбработки[ПараметрТШ.НомерСтрокиТаблицы-1];
		СтрокаТаблицы[ИмяКолонки] = ПараметрТШ.Значение;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ПараметрТШ, "ИдентификаторСтроки");
		
		Если ТаблицыОбработки.Найти(ИмяТаблицы) = Неопределено Тогда
			ТаблицыОбработки.Добавить(ИмяТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяЗаполненнойТаблицы Из ТаблицыОбработки Цикл
		Для Каждого СтрокаТаблицы Из Объект[ИмяЗаполненнойТаблицы] Цикл
			Если ИмяЗаполненнойТаблицы = МетаданныеОбработки.ТабличныеЧасти.ДневниковыеЗаписи.Имя Тогда
				ДанныеПриема = ПолучитьДанныеПриема(СтрокаТаблицы.Прием);
			//ИначеЕсли ИмяЗаполненнойТаблицы = МетаданныеОбработки.ТабличныеЧасти.ОперативныеВмешательства.Имя Тогда
			//	ДанныеПриема = ПолучитьДанныеОперативногоВмешательства(СтрокаТаблицы.Прием);
			Иначе
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеПриема);
		КонецЦикла;
	КонецЦикла;
	
	// По умолчанию
	Если Не ЗначениеЗаполнено(Объект.ИсходГоспитализации) Тогда
		Объект.ИсходГоспитализации = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(1, Перечисления.ВидыКлассификаторовМинЗдрава.ИсходыГоспитализации);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.РезультатГоспитализации) Тогда
		Объект.РезультатГоспитализации = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(1, Перечисления.ВидыКлассификаторовМинЗдрава.РезультатыОбращения);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ЛечащийВрач) Тогда
		Объект.ЛечащийВрач = Параметры.СтруктураШапки.Врач;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросСохранитьРезультатПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы
		Или Отказ
		Или ПодтверждениеЗакрытияФормы = Истина
	Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Отказ = Истина;
	ОписаниеОповещения = Новый ОписаниеОповещения("ВопросПередЗакрытиемЗавершение", ЭтотОбъект, Новый Структура("Отказ, ЗавершениеРаботы", Отказ, ЗавершениеРаботы));
	ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Отмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗакрытиемЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПодтверждениеЗакрытияФормы = Истина;
		Закрыть(СохранитьНаСервере());
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		ПодтверждениеЗакрытияФормы = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеТекстовHTML

&НаКлиенте
Процедура ОбновитьПолныйТекстHTML()
	
	ТекстHTMLОбщий = ШаблонЭпикриза; 
	
	СоответствиеПройденных = Новый Соответствие;
	СоответствиеПройденныхПоУИду = Новый Соответствие;
	СтруктураВложенныхЗначенийПараметров = Новый Структура;
	
	Для Каждого Параметр Из СписокПараметров Цикл
		Если Не Параметр.Алгоритм = "" Тогда
			Продолжить;
		КонецЕсли;
		
		СоответствиеПройденныхПоУИду.Вставить(Параметр.Параметр, ЭтаФорма[Параметр.УИд]);
	КонецЦикла;
	
	Для Каждого Параметр Из СписокПараметров Цикл
		Если ЗначениеЗаполнено(Параметр.Алгоритм) Тогда
			
			Если Параметр.ВложенныеПараметры.Количество() > 0 Тогда
				
				Для Каждого ВложенныйПараметр Из Параметр.ВложенныеПараметры Цикл
					
					ВложенныйПараметр = ВложенныйПараметр.Значение;
					
					ЗначениеВложенногоПараметра = СоответствиеПройденных.Получить(ВложенныйПараметр.Параметр);
					
					Если ЗначениеВложенногоПараметра = Неопределено Тогда
						Если ЗначениеЗаполнено(ВложенныйПараметр.Алгоритм) Тогда
							ЗначениеВложенногоПараметра = ВычислитьЗначениеПараметра(Параметр.ИмяПеременной, ТекущийПрием, ВложенныйПараметр.Алгоритм, СтруктураВложенныхЗначенийПараметров);
						Иначе
							ЗначениеВложенногоПараметра = СоответствиеПройденныхПоУИду.Получить(ВложенныйПараметр.Параметр);
						КонецЕсли;
					КонецЕсли;     
					
					ЗначениеВложенногоПараметра = ?(ЗначениеВложенногоПараметра = Неопределено, "", ЗначениеВложенногоПараметра);
					
					СтруктураВложенныхЗначенийПараметров.Вставить(ВложенныйПараметр.ИмяПеременной, ЗначениеВложенногоПараметра);
					
				КонецЦикла;
				
			КонецЕсли;
			
			ИсходноеЗначениеПараметра = ВычислитьЗначениеПараметра(Параметр.Имя, ТекущийПрием, Параметр.Алгоритм, СтруктураВложенныхЗначенийПараметров);
			ЗначениеПараметра = ИсходноеЗначениеПараметра;
		Иначе
			
			ИсходноеЗначениеПараметра = ЭтаФорма[Параметр.УИд];
			ЗначениеПараметра = Формат(ИсходноеЗначениеПараметра, Параметр.ФорматнаяСтрока);
		КонецЕсли;
		
		Параметр.Значение = ИсходноеЗначениеПараметра;
		СоответствиеПройденных.Вставить(Параметр.Параметр, ИсходноеЗначениеПараметра);
		
		ТекстHTMLОбщий = СтрЗаменить(ТекстHTMLОбщий, Параметр.Имя, ЗначениеПараметра);
	КонецЦикла; 
	
	ТекстHTMLОбщий = СтрЗаменить(ТекстHTMLОбщий, "{ДневниковыеЗаписи}", ТекстHTMLКонсультации);

	ТекстHTMLОбщий = РаботаСDOMКлиентСервер.СформироватьПолныйТекстДокументаHTML(СформироватьТекстТелаРезультата());
	
КонецПроцедуры

Функция ПолучитьТаблицуЗначенийПараметров(ДокументСсылка)
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗначенияПараметровHTML.Параметр КАК Параметр,
	               |	ЗначенияПараметровHTML.Документ КАК Документ,
	               |	ЗначенияПараметровHTML.ИндексШаблона КАК ИндексШаблона,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ЗначенияПараметровHTML.Значение) = ТИП(Справочник.СтрокиЭМКНеограниченнойДлины)
	               |			ТОГДА ЗначенияПараметровHTML.Значение.Значение
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК ЗначениеЭМК,
	               |	ЗначенияПараметровHTML.Значение КАК Значение,
	               |	ЗначенияПараметровHTML.Параметр.ВыборПоСсылкеИзОграниченногоСписка КАК ВыборПоСсылкеИзОграниченногоСписка,
	               |	ЗначенияПараметровHTML.Параметр.ФорматнаяСтрока КАК ФорматнаяСтрока,
	               |	ЗначенияПараметровHTML.Параметр.ТипЗначения КАК ТипЗначения,
	               |	ЗначенияПараметровHTML.Параметр.НеРедактируетсяПользователем КАК НеРедактируетсяПользователем,
	               |	ВЫБОР КОГДА ЗначенияПараметровHTML.Параметр.НаименованиеДляВрача = """" ТОГДА ПРЕДСТАВЛЕНИЕ(ЗначенияПараметровHTML.Параметр) ИНАЧЕ ЗначенияПараметровHTML.Параметр.НаименованиеДляВрача КОНЕЦ КАК НаименованиеДляВрача
	               |ИЗ
	               |	РегистрСведений.ЗначенияПараметровHTML КАК ЗначенияПараметровHTML
	               |ГДЕ
	               |	ЗначенияПараметровHTML.Документ = &Документ
	               |	И НЕ ЗначенияПараметровHTML.Параметр.ЭтоГруппа";
	Запрос.УстановитьПараметр("Документ",ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеЗаписей(Записи)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗначенияПараметровHTML.Параметр КАК Параметр,
	               |	ЗначенияПараметровHTML.Документ КАК Документ,
	               |	ЗначенияПараметровHTML.ИндексШаблона КАК ИндексШаблона,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ЗначенияПараметровHTML.Значение) = ТИП(Справочник.СтрокиЭМКНеограниченнойДлины)
	               |			ТОГДА ЗначенияПараметровHTML.Значение.Значение
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК ЗначениеЭМК,
	               |	ЗначенияПараметровHTML.Значение КАК Значение,
	               |	ЗначенияПараметровHTML.Параметр.ВыборПоСсылкеИзОграниченногоСписка КАК ВыборПоСсылкеИзОграниченногоСписка,
	               |	ЗначенияПараметровHTML.Параметр.ФорматнаяСтрока КАК ФорматнаяСтрока,
	               |	ЗначенияПараметровHTML.Параметр.ТипЗначения КАК ТипЗначения,
	               |	ЗначенияПараметровHTML.Параметр.НеРедактируетсяПользователем КАК НеРедактируетсяПользователем,
	               |	ВЫБОР
	               |		КОГДА ЗначенияПараметровHTML.Параметр.НаименованиеДляВрача = """"
	               |			ТОГДА ПРЕДСТАВЛЕНИЕ(ЗначенияПараметровHTML.Параметр)
	               |		ИНАЧЕ ЗначенияПараметровHTML.Параметр.НаименованиеДляВрача
	               |	КОНЕЦ КАК НаименованиеДляВрача,
	               |	ЗначенияПараметровHTML.Документ.Дата КАК ДокументДата
	               |ИЗ
	               |	РегистрСведений.ЗначенияПараметровHTML КАК ЗначенияПараметровHTML
	               |ГДЕ
	               |	ЗначенияПараметровHTML.Документ В(&Записи)
	               |	И НЕ ЗначенияПараметровHTML.Параметр.ЭтоГруппа
	               |	И ЗначенияПараметровHTML.Параметр.Код = ""000003966""
	               |ИТОГИ ПО
	               |	Документ";
	Запрос.УстановитьПараметр("Записи", Записи);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДокументов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СоответствиеДанных = Новый Соответствие;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		ВыборкаДанных = ВыборкаДокументов.Выбрать();
		СтруктураЗначения = Новый Соответствие;
		Если ВыборкаДанных.Следующий() Тогда
			СтруктураЗначения.Вставить("Результат", ВыборкаДанных.Значение);
		КонецЕсли;
		СтруктураЗначения.Вставить("Дата", ВыборкаДокументов.ДокументДата);
		СоответствиеДанных.Вставить(ВыборкаДокументов.Документ, СтруктураЗначения);
	КонецЦикла;
	
	Возврат СоответствиеДанных;
	
КонецФункции


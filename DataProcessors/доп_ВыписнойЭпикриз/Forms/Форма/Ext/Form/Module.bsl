		|	ЛистокНетрудоспособности.Запись1ДатаНачала КАК Запись1ДатаНачала,
		|	ЛистокНетрудоспособности.Запись1ДатаОкончания КАК Запись1ДатаОкончания,
		|	ЛистокНетрудоспособности.Запись2ДатаОкончания КАК Запись2ДатаОкончания,
		|	ЛистокНетрудоспособности.Запись3ДатаОкончания КАК Запись3ДатаОкончания,
		|	ЛистокНетрудоспособности.СледующийЛН КАК СледующийЛН
		|ИЗ
		|	Документ.ЛистокНетрудоспособности КАК ЛистокНетрудоспособности
		|ГДЕ
		|	ЛистокНетрудоспособности.Номер = &Номер";
	
	Запрос.УстановитьПараметр("Номер", Номер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураЛН = ПолучитьСтруктуруЛН();
	
	Если Выборка.Следующий() Тогда
		
		СтруктураЛН.НомерЛН = Выборка.Номер;
		СтруктураЛН.ДатаНачала = Выборка.Запись1ДатаНачала;
		СтруктураЛН.ДатаОкончания = Макс(Выборка.Запись1ДатаОкончания, Выборка.Запись2ДатаОкончания, Выборка.Запись3ДатаОкончания);
		СтруктураЛН.ВидЛистка = Выборка.ВидЛистка;
		Если Выборка.СледующийЛН <> "" Тогда
			СтруктураЛН.ЛНПродолжение = ПолучитьДанныеЛНПоНомеру(Число(Выборка.СледующийЛН));
		Иначе
			СтруктураЛН.ЛНПродолжение = ПолучитьСтруктуруЛН();
		КонецЕсли;
		
		//СтруктураЛН.ДатаВыходаНаРаботу = Макс(СтруктураЛН.ДатаОкончания, СтруктураЛН.ЛНПродолжение.ДатаНачалаРаботы);
		
	КонецЕсли;
	
	Возврат СтруктураЛН;
	
КонецФункции


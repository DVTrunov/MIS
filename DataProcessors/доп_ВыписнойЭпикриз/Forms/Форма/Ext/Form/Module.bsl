&НаСервере
Процедура СформироватьТекстНетрудоспособности()
	
	ДанныеЛН = ПолучитьДанныеЛНПоМедкартеДляСтационара(МедицинскаяКарта);
	
	Если Не ЗначениеЗаполнено(ДанныеЛН.НомерЛН) Тогда
		Возврат;
	КонецЕсли;
	
	ЧастиТекстаЛН = Новый Массив;
	ЧастиТекстаЛН.Добавить(СтрШаблон("Номер листка нетрудоспособности: %1.", ДанныеЛН.НомерЛН));
	Если ЗначениеЗаполнено(ДанныеЛН.ДатаНачала)
		И ЗначениеЗаполнено(ДанныеЛН.ДатаОкончания)
	Тогда
		ЧастиТекстаЛН.Добавить(СтрШаблон("Период нетрудоспособности: с %1 по %2.", Формат(ДанныеЛН.ДатаНачала, "ДЛФ=Д"), Формат(ДанныеЛН.ДатаОкончания, "ДЛФ=Д")));
	КонецЕсли;
	
	ТекстНетрудоспособности = СтрСоединить(ЧастиТекстаЛН, " ");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОсмотр()
	
	ТекстОсмотраТекущегоПриема = РаботаСHTMLКлиентСервер.ПолучитьТекстHTMLПустогоДокумента();
	ТекСтраница = Элементы.СтраницыЭпикриза.ТекущаяСтраница;
	
	Если СтраницыТекстовыхПолей.Найти(ТекСтраница) <> Неопределено Тогда
		Элементы.ГруппаСписокПриемов.Видимость = Истина;
		
		Если Элементы.Осмотры.ТекущиеДанные <> Неопределено Тогда
			ТекстОсмотраТекущегоПриема = Осмотры.НайтиПоИдентификатору(Элементы.Осмотры.ТекущиеДанные.ПолучитьИдентификатор()).Осмотр;
		КонецЕсли;
	Иначе
		Элементы.ГруппаСписокПриемов.Видимость = Ложь;
		
		ЭлементТаблицы = ЭлементыТаблиц.Получить(ТекСтраница);
		Если ЭлементТаблицы <> Неопределено
			И ЭлементТаблицы.ТекущиеДанные <> Неопределено
			И ЗначениеЗаполнено(ЭлементТаблицы.ТекущиеДанные.Прием)
		Тогда
			ТекстОсмотраТекущегоПриема = Осмотры.НайтиСтроки(Новый Структура("Прием", ЭлементТаблицы.ТекущиеДанные.Прием))[0].Осмотр;
		КонецЕсли;
	КонецЕсли;
	
	ТекстПросмотраHTMLПриема = ТекстОсмотраТекущегоПриема;
	
КонецПроцедуры


&НаКлиенте
Процедура ОткрытьМаршрутыЛечения(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОтборВрач", ПолучитьСотрудникаПользователя());
	ОткрытьФорму("Отчет.МаршрутЛеченияПациента.Форма.ФормаОтчета_85", ПараметрыФормы, ЭтотОбъект);
КонецПроцедуры

&НаСервере
Функция ПолучитьСотрудникаПользователя()
	Пользователь = Пользователи.ТекущийПользователь();
	Врач =  Пользователь.Сотрудник;
	Возврат Врач; 
КонецФункции



&НаКлиенте
Процедура ОткрытьКалендарь(Команда) 
	
	ДанныеАРМ = Новый Структура;
	ДанныеАРМ.Вставить("ФормаВызова", "Обработка.омг_АРМ_Врача.Форма.Форма_85");
	
	ПараметрыФормы = Новый Структура("Данные");
	ПараметрыФормы.Данные = ДанныеАРМ;
	
	ОткрытьФорму("Отчет.КалендарьПланирования.Форма.ФормаОтчетаУпр_85", ПараметрыФормы);
	//ОткрытьКалендарьНаСервере();
КонецПроцедуры


&НаСервере
Функция ПолучитьФилиалПользователя()
	
	ОсновнаяОрганизация = Справочники.Организации.ПустаяСсылка(); 
	
	НастройкаОрганизация = ПланыВидовХарактеристик.НастройкиПользователей.омг_ОсновнаяОрганизация;
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиПользователей.Значение КАК Организация
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК НастройкиПользователей
	|ГДЕ
	|	НастройкиПользователей.Пользователь = &Пользователь
	|	И НастройкиПользователей.Настройка = &НастройкаОрганизация";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("НастройкаОрганизация", НастройкаОрганизация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОсновнаяОрганизация = Выборка.Организация;
	КонецЕсли;
	
	Возврат ОсновнаяОрганизация;
	
КонецФункции

&НаСервере
Процедура РассчитатьПоказателиНаСервере()
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	ТекФилиал = ПолучитьФилиалПользователя();
	
	// ==========================================
	// 1. РАСЧЕТ ЗВОНКОВ
	// ==========================================
	ЗапросЗвонки = Новый Запрос;
	ЗапросЗвонки.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА Событие.ФактическийИсполнитель = &Пользователь
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК МоиЗвонки,
	|	КОЛИЧЕСТВО(Событие.Ссылка) КАК ЗвонкиФилиала
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ВходящийЗвонок)
	|	И Событие.ДатаФакт МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Событие.УспешностьЗвонка = ИСТИНА
	|	И Событие.омг_Организация = &ТекФилиал"; 
	
	ЗапросЗвонки.УстановитьПараметр("Пользователь", ТекПользователь);
	ЗапросЗвонки.УстановитьПараметр("ТекФилиал", ТекФилиал);
	ЗапросЗвонки.УстановитьПараметр("ДатаНачала", ПериодОтчета.ДатаНачала);
	ЗапросЗвонки.УстановитьПараметр("ДатаОкончания", КонецДня(ПериодОтчета.ДатаОкончания));
	
	РезЗвонки = ЗапросЗвонки.Выполнить();
	
	Если Не РезЗвонки.Пустой() Тогда
		ВыбЗвонки = РезЗвонки.Выбрать();
		ВыбЗвонки.Следующий();
		
		КоличествоВходящихЗвонков = ?(ВыбЗвонки.МоиЗвонки = NULL, 0, ВыбЗвонки.МоиЗвонки);
		ВсегоЗвонковПоФилиалу     = ?(ВыбЗвонки.ЗвонкиФилиала = NULL, 0, ВыбЗвонки.ЗвонкиФилиала);
	Иначе
		КоличествоВходящихЗвонков = 0;
		ВсегоЗвонковПоФилиалу = 0;
	КонецЕсли;
	// ==========================================
	// ОТРИСОВКА ДИАГРАММЫ ЗВОНКОВ
	// ==========================================
	ЗвонкиКоллег = ВсегоЗвонковПоФилиалу - КоличествоВходящихЗвонков;
	Если ЗвонкиКоллег < 0 Тогда 
		ЗвонкиКоллег = 0; 
	КонецЕсли;
	
	ДиаграммаЗвонков.Обновление = Ложь;
	ДиаграммаЗвонков.Очистить();
	ДиаграммаЗвонков.АвтоТранспонирование = Ложь;
	Точка = ДиаграммаЗвонков.УстановитьТочку(ВсегоЗвонковПоФилиалу);
	СерияМои = ДиаграммаЗвонков.УстановитьСерию("Принятые мной");
	СерияМои.Цвет = WebЦвета.Бирюзовый;
	ДиаграммаЗвонков.УстановитьЗначение(Точка , СерияМои, КоличествоВходящихЗвонков);
	СерияКоллеги = ДиаграммаЗвонков.УстановитьСерию("Принятые другими операторами");
	СерияКоллеги.Цвет = WebЦвета.Киноварь;
	ДиаграммаЗвонков.УстановитьЗначение(Точка , СерияКоллеги, ЗвонкиКоллег);
	ДиаграммаЗвонков.Обновление = Истина;
	
	// ==========================================
	// 2. РАСЧЕТ ВЫРУЧКИ ПО ОКАЗАНИЮ УСЛУГ
	// ==========================================
	ЗапросВыручка = Новый Запрос;
	
	ЗапросВыручка.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ПродажиОбороты.СуммаОборот), 0) КАК СуммаВыручки
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.Регистратор ССЫЛКА Документ.ОказаниеУслуг
	|	И ПродажиОбороты.Регистратор.ДокументОснование.Ответственный = &Пользователь
	|	И ПродажиОбороты.Регистратор.ДокументОснование.Состояние = &СостояниеВыполнена
	|	И (ПродажиОбороты.Регистратор.СостояниеЧековККМ = ЗНАЧЕНИЕ(Перечисление.СостоянияЧековККМ.ЧекиПробиты)
	|		ИЛИ ПродажиОбороты.Регистратор.омг_СтраховаяПрограмма <> ЗНАЧЕНИЕ(Справочник.СоглашенияСтрахования.ПустаяСсылка))";
	
	ЗапросВыручка.УстановитьПараметр("Пользователь", ТекПользователь);
	ЗапросВыручка.УстановитьПараметр("ДатаНачала", ПериодОтчета.ДатаНачала);
	ЗапросВыручка.УстановитьПараметр("ДатаОкончания", КонецДня(ПериодОтчета.ДатаОкончания));
	
	СостояниеЗаявки = Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Выполнена");
	ЗапросВыручка.УстановитьПараметр("СостояниеВыполнена", СостояниеЗаявки);
	
	РезВыручка = ЗапросВыручка.Выполнить();
	Если Не РезВыручка.Пустой() Тогда
		ВыбВыручка = РезВыручка.Выбрать();
		ВыбВыручка.Следующий();
		ВыручкаОператора = ВыбВыручка.СуммаВыручки;
	КонецЕсли;
	Если ВыручкаОператора = Неопределено Тогда 
		ВыручкаОператора = 0; 
	КонецЕсли;
	
	// ==========================================
	// 2.1. ПОЛУЧЕНИЕ ПЛАНА (KPI) И РАСЧЕТ % ВЫПОЛНЕНИЯ
	// ==========================================
	ЗапросПлан = Новый Запрос;
	ЗапросПлан.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ПлановыеПоказателиСотрудниковСрезПоследних.Значение, 0) КАК ПланВыручки
	|ИЗ
	|	РегистрСведений.омг_ПлановыеПоказателиСотрудников.СрезПоследних(
	|		&ДатаОкончания,
	|		Пользователь = &Пользователь
	|			И Показатель = &ПоказательВыручка
	|	) КАК ПлановыеПоказателиСотрудниковСрезПоследних";
	
	ЗапросПлан.УстановитьПараметр("Пользователь", ТекПользователь);
	ЗапросПлан.УстановитьПараметр("ДатаОкончания", КонецДня(ПериодОтчета.ДатаОкончания)); 
	
	ПоказательВыручки = Справочники.ПоказателиKPI.НайтиПоНаименованию("Выручка оператора");
	ЗапросПлан.УстановитьПараметр("ПоказательВыручка", ПоказательВыручки);
	
	РезПлан = ЗапросПлан.Выполнить();
	Если Не РезПлан.Пустой() Тогда
		ВыбПлан = РезПлан.Выбрать();
		ВыбПлан.Следующий();
		ПланОператора = ВыбПлан.ПланВыручки;
	Иначе
		ПланОператора = 0;
	КонецЕсли;
	
	Если ПланОператора > 0 Тогда
		ПроцентВыполненияПлана = Окр((ВыручкаОператора / ПланОператора) * 100, 1);
	Иначе
		ПроцентВыполненияПлана = 0; 
	КонецЕсли;
	
	ОсталосьВыполнить = ПланОператора - ВыручкаОператора;
	Если ОсталосьВыполнить < 0 Тогда 
		ОсталосьВыполнить = 0; 
	КонецЕсли;
	// ==========================================
	// 2.2. ОТРИСОВКА ДИАГРАММЫ: СПИДОМЕТР (KPI ВЫРУЧКА)
	// ==========================================
	ДиаграммаВыручка.Обновление = Ложь;
	ДиаграммаВыручка.Очистить();
	ДиаграммаВыручка.АвтоТранспонирование = Ложь;
	
	ТочкаВыручка = ДиаграммаВыручка.УстановитьТочку("Выполнение плана");
	СерияФакт    = ДиаграммаВыручка.УстановитьСерию("Факт");
	
	ДиаграммаВыручка.УстановитьЗначение(ТочкаВыручка, СерияФакт, ВыручкаОператора);
	
	
	Если ПланОператора > 0 Тогда
		ДиаграммаВыручка.ОбластьЗаголовка.Текст = "План: " + ПланОператора + Символы.ПС + 
												  "Выполнено: " + ПроцентВыполненияПлана + "%";
	Иначе
		ДиаграммаВыручка.ОбластьЗаголовка.Текст = "Выручка: " + ВыручкаОператора + " (План не задан)";
	КонецЕсли;
    
	ДиаграммаВыручка.Обновление = Истина;
	// ==========================================
	// 3. WHATSAPP: ЗАВЕРШЕННЫЕ ЧАТЫ
	// ==========================================
	ЗапросЧаты = Новый Запрос;
	ЗапросЧаты.Текст = 
	"ВЫБРАТЬ
	|	// 1. Сколько всего чатов было у оператора
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР 
	|		КОГДА iga_ОчередьРаспределения.Оператор = &Пользователь 
	|		ТОГДА iga_ОчередьРаспределения.Чат 
	|		ИНАЧЕ NULL 
	|	КОНЕЦ) КАК МоиЧатыВсего,
	|
	|	// 2. Сколько чатов оператор завершил
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР 
	|		КОГДА iga_ОчередьРаспределения.Оператор = &Пользователь 
	|			И iga_ОчередьРаспределения.Статус = &СтатусЗавершен 
	|		ТОГДА iga_ОчередьРаспределения.Чат 
	|		ИНАЧЕ NULL 
	|	КОНЕЦ) КАК МоиЧатыЗавершенные,
	|
	|	// 3. Сколько всего чатов завершено по всему филиалу
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР 
	|		КОГДА iga_ОчередьРаспределения.Статус = &СтатусЗавершен 
	|		ТОГДА iga_ОчередьРаспределения.Чат 
	|		ИНАЧЕ NULL 
	|	КОНЕЦ) КАК ЧатыФилиалаЗавершенные
	|ИЗ
	|	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	|		// Связываем с настройками, чтобы отфильтровать операторов только нашего филиала
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПользователей КАК НастройкиПользователей
	|		ПО iga_ОчередьРаспределения.Оператор = НастройкиПользователей.Пользователь
	|ГДЕ
	|	iga_ОчередьРаспределения.ДатаПоследнейАктивности МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НастройкиПользователей.Настройка = &НастройкаОрганизация
	|	И НастройкиПользователей.Значение = &ТекФилиал";
	
	ЗапросЧаты.УстановитьПараметр("Пользователь", ТекПользователь);
	ЗапросЧаты.УстановитьПараметр("ТекФилиал", ТекФилиал);
	ЗапросЧаты.УстановитьПараметр("НастройкаОрганизация", ПланыВидовХарактеристик.НастройкиПользователей.омг_ОсновнаяОрганизация);
	ЗапросЧаты.УстановитьПараметр("ДатаНачала", ПериодОтчета.ДатаНачала);
	ЗапросЧаты.УстановитьПараметр("ДатаОкончания", КонецДня(ПериодОтчета.ДатаОкончания));
	ЗапросЧаты.УстановитьПараметр("СтатусЗавершен", ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.Завершен"));
	
	РезЧаты = ЗапросЧаты.Выполнить(); 	
	Если Не РезЧаты.Пустой() Тогда
		ВыбЧаты = РезЧаты.Выбрать();
		ВыбЧаты.Следующий();
		
		МоиЧатыВсего           = ?(ВыбЧаты.МоиЧатыВсего = NULL, 0, ВыбЧаты.МоиЧатыВсего);
		МоиЧатыЗавершенные     = ?(ВыбЧаты.МоиЧатыЗавершенные = NULL, 0, ВыбЧаты.МоиЧатыЗавершенные);
		ЧатыФилиалаЗавершенные = ?(ВыбЧаты.ЧатыФилиалаЗавершенные = NULL, 0, ВыбЧаты.ЧатыФилиалаЗавершенные);
	Иначе
		МоиЧатыВсего           = 0;
		МоиЧатыЗавершенные     = 0;
		ЧатыФилиалаЗавершенные = 0;
	КонецЕсли;
	
	МоиЧатыВРаботе = МоиЧатыВсего - МоиЧатыЗавершенные;
	Если МоиЧатыВРаботе < 0 Тогда 
		МоиЧатыВРаботе = 0; 
	КонецЕсли;
	
	ЧатыКоллегЗавершенные = ЧатыФилиалаЗавершенные - МоиЧатыЗавершенные;
	Если ЧатыКоллегЗавершенные < 0 Тогда 
		ЧатыКоллегЗавершенные = 0; 
	КонецЕсли;
	// ==========================================
	// ОТРИСОВКА: ЛИЧНАЯ ЭФФЕКТИВНОСТЬ (% своих завершенных)
	// ==========================================
	ДиаграммаЧатыМои.Обновление = Ложь;
	ДиаграммаЧатыМои.Очистить();
	ДиаграммаЧатыМои.АвтоТранспонирование = Ложь;
	
	ТочкаМоиЧаты = ДиаграммаЧатыМои.УстановитьТочку(МоиЧатыВсего);
	
	СерияМоиЗаверш = ДиаграммаЧатыМои.УстановитьСерию("Мои завершенные");
	СерияМоиЗаверш.Цвет = WebЦвета.ЗеленыйЛес; 	
	ДиаграммаЧатыМои.УстановитьЗначение(ТочкаМоиЧаты, СерияМоиЗаверш, МоиЧатыЗавершенные);
	
	СерияМоиВРаботе = ДиаграммаЧатыМои.УстановитьСерию("Мои в работе (незавершенные)");
	СерияМоиВРаботе.Цвет = WebЦвета.СветлоСерый;
	ДиаграммаЧатыМои.УстановитьЗначение(ТочкаМоиЧаты, СерияМоиВРаботе, МоиЧатыВРаботе);
	
	ДиаграммаЧатыМои.Обновление = Истина;
	
	
	// ==========================================
	// ОТРИСОВКА: ВКЛАД В ФИЛИАЛ (Сравнение с коллегами)
	// ==========================================
	ДиаграммаЧатыФилиал.Обновление = Ложь;
	ДиаграммаЧатыФилиал.Очистить();
	ДиаграммаЧатыФилиал.АвтоТранспонирование = Ложь;
	
	ТочкаЧатыФилиал = ДиаграммаЧатыФилиал.УстановитьТочку(ЧатыФилиалаЗавершенные);
	
	СерияМойВклад = ДиаграммаЧатыФилиал.УстановитьСерию("Завершенные мной");
	СерияМойВклад.Цвет = WebЦвета.Желтый; 
	ДиаграммаЧатыФилиал.УстановитьЗначение(ТочкаЧатыФилиал, СерияМойВклад, МоиЧатыЗавершенные);
	
	СерияКоллегиЧаты = ДиаграммаЧатыФилиал.УстановитьСерию("Завершенные другими операторами");
	ДиаграммаЧатыФилиал.УстановитьЗначение(ТочкаЧатыФилиал, СерияКоллегиЧаты, ЧатыКоллегЗавершенные);
	
	ДиаграммаЧатыФилиал.Обновление = Истина;
	
	// ==========================================
	// 4. СРЕДНЯЯ ОЦЕНКА ОПЕРАТОРА (ЗА ВСЕ ВРЕМЯ)
	// ==========================================
	ЗапросОценка = Новый Запрос;
	ЗапросОценка.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СРЕДНЕЕ(iga_ИсторияОценокРаботыОператоров.Оценка), 0) КАК СреднийБалл
	|ИЗ
	|	РегистрСведений.iga_ИсторияОценокРаботыОператоров КАК iga_ИсторияОценокРаботыОператоров
	|ГДЕ
	|	iga_ИсторияОценокРаботыОператоров.Оператор = &Пользователь"; 
	
	ЗапросОценка.УстановитьПараметр("Пользователь", ТекПользователь);
	
	РезОценка = ЗапросОценка.Выполнить();
	Если Не РезОценка.Пустой() Тогда
		ВыбОценка = РезОценка.Выбрать();
		ВыбОценка.Следующий();
		
		СредняяОценка = Окр(ВыбОценка.СреднийБалл, 1);
	Иначе
		СредняяОценка = 0;
	КонецЕсли;
	// ==========================================
	// 4.1. ОТРИСОВКА ОЦЕНКИ И ПОЯСНЯЮЩЕГО ТЕКСТА
	// ==========================================
	
	ТекстПояснения = "";
	ЦветОценки = WebЦвета.Черный;
	
	Если СредняяОценка >= 4.8 Тогда
		ТекстПояснения = "Отличный сервис! Так держать!";
		ЦветОценки = WebЦвета.ЗеленыйЛес; 
		
	ИначеЕсли СредняяОценка >= 4.0 Тогда
		ТекстПояснения = "Хорошая работа";
		ЦветОценки = WebЦвета.Оливковый; 
		
	ИначеЕсли СредняяОценка >= 3.0 Тогда
		ТекстПояснения = "В пределах нормы, но есть куда расти";
		ЦветОценки = WebЦвета.Оранжевый; 
		
	ИначеЕсли СредняяОценка > 0 Тогда
		ТекстПояснения = "Критично! Требуется внимание";
		ЦветОценки = WebЦвета.Красный; 
		
	Иначе
		ТекстПояснения = "Оценок пока нет";
		ЦветОценки = WebЦвета.СероеОкно; 
	КонецЕсли;
	
	Если СредняяОценка > 0 Тогда
		Элементы.ДекорацияОценка.Заголовок = Строка(СредняяОценка) + Символы.ПС + ТекстПояснения;
	Иначе
		Элементы.ДекорацияОценка.Заголовок = "0.0 / 5.0" + Символы.ПС + ТекстПояснения;
	КонецЕсли;
	
	Элементы.ДекорацияОценка.ЦветТекста = ЦветОценки;
	
КонецПроцедуры


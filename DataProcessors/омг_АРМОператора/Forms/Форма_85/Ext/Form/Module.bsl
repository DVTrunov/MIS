&НаКлиенте
Процедура ОткрытьОтчетКонверсия(Команда)
	//ОткрытьФорму("Отчет.омг_КонверсияСобытий.Форма",);
	КлючНужногоВарианта = ПолучитьКлючВариантаНаСервере("Конверсия событий (для операторов)");
	Если КлючНужногоВарианта = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Система не нашла вариант отчета с таким именем!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", КлючНужногоВарианта);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Ответственный", ПолучитьТекущегоПользователяНаСервере()); 
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
	
	ТекПериод = Новый СтандартныйПериод;
	ТекПериод.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("Период", ТекПериод); 
	ПараметрыФормы.Вставить("ПараметрыДанных", ПараметрыДанных);
	
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина); 
	
	ОткрытьФорму("Отчет.омг_КонверсияСобытий.Форма", ПараметрыФормы);
КонецПроцедуры 
&НаСервереБезКонтекста
Функция ПолучитьТекущегоПользователяНаСервере()
	

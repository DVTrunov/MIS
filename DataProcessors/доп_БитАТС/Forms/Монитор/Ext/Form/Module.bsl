				доп_АТССервер.ВебСервисОтбойРазговора(ТекущаяАТС, ВебСервисИдКлиента, стрКанал);
			Иначе
				обКонтроллерАТС.Hangup(стрКанал);
			КонецЕсли;
		Исключение
			доп_ТелефонияКлиент.ВывестиСообщение( ОписаниеОшибки(), ЭтаФорма );
		КонецПопытки;

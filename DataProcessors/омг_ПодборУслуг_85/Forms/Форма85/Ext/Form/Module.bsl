&НаСервере
Процедура ДобавитьНаборВКорзинуНаСервере(СсылкаНабора)

	ПустаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();

	// 1. Структура набора - из состава, НЕ из регистра цен
	КэшСостава    = Новый Соответствие;
	МассивНаборов = Новый Массив;
	РазвернутьСоставНабора(СсылкаНабора, КэшСостава, МассивНаборов, Новый Соответствие);

	Если КэшСостава[СсылкаНабора].Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(
			"Состав набора """ + Строка(СсылкаНабора) + """ не заполнен.");
		Возврат;
	КонецЕсли;

	// 2. Цены и признаки ЛИС - по одному запросу на всё дерево
	КэшЦен = ПолучитьКэшЦен(МассивНаборов);
	КэшЛИС = ПолучитьКэшЛИС(МассивНаборов);

	КорневойЭтоЛИС = (КэшЛИС[СсылкаНабора] = Истина);
	// Логика сохранена из прежней версии: набор ЛИС не считается "главным набором"
	ГлавныйНабор   = ?(КорневойЭтоЛИС, ПустаяНоменклатура, СсылкаНабора);
	СтартовыйЛИС   = ?(КорневойЭтоЛИС, СсылкаНабора, ПустаяНоменклатура);

	// 3. Корневая строка корзины
	КорневыеСтроки = Корзина.ПолучитьЭлементы();
	КорневаяСтрока = Неопределено;
	Для Каждого Стр Из КорневыеСтроки Цикл
		Если Стр.Номенклатура = СсылкаНабора И Стр.омг_Набор = ПустаяНоменклатура Тогда
			КорневаяСтрока = Стр;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если КорневаяСтрока = Неопределено Тогда
		КорневаяСтрока = КорневыеСтроки.Добавить();
		КорневаяСтрока.Номенклатура = СсылкаНабора;
		КорневаяСтрока.Количество   = 1;
		КорневаяСтрока.омг_Набор    = ПустаяНоменклатура;
		КорневаяСтрока.омг_НаборЛИС = СтартовыйЛИС;
	Иначе
		КорневаяСтрока.Количество = КорневаяСтрока.Количество + 1;
	КонецЕсли;

	// 4. Строим/обновляем поддерево. Количества АБСОЛЮТНЫЕ (норма * количество
	//    родителя), поэтому повторный подбор идемпотентен.
	ЗаполнитьПоддеревоНабора(
		КорневаяСтрока,
		СсылкаНабора,
		КорневаяСтрока.Количество,
		КэшСостава, КэшЦен, КэшЛИС,
		СсылкаНабора,   // верхний набор - контекст цены
		ГлавныйНабор,   // значение реквизита омг_Набор для листьев
		СтартовыйЛИС);

	// 5. Суммы - строго снизу вверх
	ПересчитатьСуммыДерева(КорневыеСтроки);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоддеревоНабора(РодительскаяСтрока, СсылкаНабора, КоличествоРодителя,
	КэшСостава, КэшЦен, КэшЛИС, ВерхнийНабор, ГлавныйНабор, ТекущийНаборЛИС)

	СтрокиСостава = КэшСостава[СсылкаНабора];
	Если СтрокиСостава = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПодчиненныеСтроки = РодительскаяСтрока.ПолучитьЭлементы();

	Для Каждого ЭлементСостава Из СтрокиСостава Цикл

		Номенклатура     = ЭлементСостава.Номенклатура;
		КоличествоСтроки = ЭлементСостава.Количество * КоличествоРодителя;

		// Ищем уже существующую строку этого уровня
		СтрокаУзла = Неопределено;
		Для Каждого Стр Из ПодчиненныеСтроки Цикл
			Если Стр.Номенклатура = Номенклатура Тогда
				СтрокаУзла = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если СтрокаУзла = Неопределено Тогда
			СтрокаУзла = ПодчиненныеСтроки.Добавить();
			СтрокаУзла.Номенклатура = Номенклатура;
		КонецЕсли;

		СтрокаУзла.Количество = КоличествоСтроки;

		Если ЭлементСостава.ЭтоНабор Тогда

			ВложенныйЭтоЛИС  = (КэшЛИС[Номенклатура] = Истина);
			НаборЛИСДляВетки = ?(ВложенныйЭтоЛИС, Номенклатура, ТекущийНаборЛИС);

			СтрокаУзла.омг_Набор    = ГлавныйНабор;
			СтрокаУзла.омг_НаборЛИС = НаборЛИСДляВетки;

			// ВАЖНО: ВерхнийНабор передаём БЕЗ изменений - "пакетная" цена
			// листьев лежит именно в контексте верхнего набора.
			ЗаполнитьПоддеревоНабора(
				СтрокаУзла,
				Номенклатура,
				КоличествоСтроки,
				КэшСостава, КэшЦен, КэшЛИС,
				ВерхнийНабор,
				ГлавныйНабор,
				НаборЛИСДляВетки);

			// Цена/Сумма узла-набора считаются в ПересчитатьСуммыДерева

		Иначе

			СтрокаУзла.Цена         = ПолучитьЦенуУслуги(КэшЦен, Номенклатура, ВерхнийНабор, СсылкаНабора);
			СтрокаУзла.омг_Набор    = ГлавныйНабор;
			СтрокаУзла.омг_НаборЛИС = ТекущийНаборЛИС;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры


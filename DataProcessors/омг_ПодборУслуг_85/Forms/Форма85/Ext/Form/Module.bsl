&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("Период", ТекущаяДата());
	Если Параметры.Свойство("Филиал") Тогда
		МедицинскийЦентр = Параметры.Филиал; 
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("Филиал", МедицинскийЦентр);
	Страховая = Неопределено;
	Параметры.Свойство("СтраховаяПрограмма", Страховая);
	
	Если ЗначениеЗаполнено(Страховая) Тогда
		Прейскурант = Страховая;
	Иначе
		Прейскурант = Справочники.Прейскуранты.НайтиПоНаименованию("Розничная цена");
		
		Если Прейскурант.Пустая() Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Прейскуранты ГДЕ НЕ ПометкаУдаления");
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Прейскурант = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("Прейскурант", Прейскурант);
	
	ТолькоСЦенами = Истина;
	ОбновитьОтборПоЦенеНаСервере();	
КонецПроцедуры
&НаКлиенте
Процедура ТолькоСЦенамиПриИзменении(Элемент)
	ОбновитьОтборПоЦенеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПрейскурантПриИзменении(Элемент)
	Список.Параметры.УстановитьЗначениеПараметра("Прейскурант", Прейскурант);
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборПоЦенеНаСервере()
	
	ЭлементыДляУдаления = Новый Массив;
	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Цена") Тогда
			ЭлементыДляУдаления.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Эл Из ЭлементыДляУдаления Цикл
		Список.Отбор.Элементы.Удалить(Эл);
	КонецЦикла;
	
	Если ТолькоСЦенами Тогда
		ЭлементОтбораЦена = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбораЦена.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Цена");
		ЭлементОтбораЦена.ВидСравнения  = ВидСравненияКомпоновкиДанных.Больше;
		ЭлементОтбораЦена.ПравоеЗначение = 0;
		ЭлементОтбораЦена.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ВидНоменклатуры = ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Набор") Тогда
		ДобавитьНаборВКорзинуНаСервере(ТекущиеДанные.Ссылка);
		ПересчитатьИтогоКорзины()

	Иначе
		ДобавитьВКорзинуКлиент(ТекущиеДанные.Ссылка, ТекущиеДанные.Цена);
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура ДобавитьВКорзинуКлиент(Номенклатура, Цена, Набор = Неопределено, НаборЛИС = Неопределено)
	
	ПустаяНоменклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	
	КорневыеСтроки = Корзина.ПолучитьЭлементы();
	
	СтрокаКорзины = Неопределено;
	Для Каждого Стр Из КорневыеСтроки Цикл
		Если Стр.Номенклатура = Номенклатура И Стр.омг_Набор = ПустаяНоменклатура Тогда
			СтрокаКорзины = Стр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаКорзины = Неопределено Тогда
		СтрокаКорзины = КорневыеСтроки.Добавить();
		СтрокаКорзины.Номенклатура = Номенклатура;
		СтрокаКорзины.Количество   = 1;
		СтрокаКорзины.Цена         = Цена;
		СтрокаКорзины.омг_Набор    = ПустаяНоменклатура;
		СтрокаКорзины.омг_НаборЛИС = ?(НаборЛИС = Неопределено, ПустаяНоменклатура, НаборЛИС);
	Иначе
		СтрокаКорзины.Количество = СтрокаКорзины.Количество + 1;
	КонецЕсли;
	
	СтрокаКорзины.Сумма = СтрокаКорзины.Количество * СтрокаКорзины.Цена;
	
	Элементы.Корзина.ТекущаяСтрока = СтрокаКорзины.ПолучитьИдентификатор();
	
	ПересчитатьИтогоКорзины();
КонецПроцедуры 

&НаСервере
Процедура РазвернутьСоставНабора(СсылкаНабора, КэшСостава, МассивНаборов, ВСтеке)

	// Уже развернут в другой ветке - структуру не перечитываем
	Если КэшСостава[СсылкаНабора] <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Защита от циклического вложения набора в самого себя
	Если ВСтеке[СсылкаНабора] <> Неопределено Тогда
		ЗаписьЖурналаРегистрации("Подбор услуг.Циклический набор",
			УровеньЖурналаРегистрации.Ошибка, , СсылкаНабора,
			"Набор прямо или косвенно включает сам себя. Ветка не разворачивается.");
		КэшСостава.Вставить(СсылкаНабора, Новый Массив);
		Возврат;
	КонецЕсли;
	ВСтеке.Вставить(СсылкаНабора, Истина);

	МассивНаборов.Добавить(СсылкаНабора);

	СтрокиСостава = Новый Массив;
	Состав = ОбщегоНазначенияСервер.ПолучитьСоставНабора(СсылкаНабора);

	Для Каждого СтрокаСостава Из Состав Цикл

		Комплектующая = СтрокаСостава.Комплектующая;

		Если Не ЗначениеЗаполнено(Комплектующая) Тогда
			Продолжить;
		КонецЕсли;

		ЭтоНабор = (Комплектующая.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор);

		Элемент = Новый Структура;
		Элемент.Вставить("Номенклатура", Комплектующая);
		Элемент.Вставить("Количество",   ?(СтрокаСостава.Количество = 0, 1, СтрокаСостава.Количество));
		Элемент.Вставить("ЭтоНабор",     ЭтоНабор);

		СтрокиСостава.Добавить(Элемент);

		Если ЭтоНабор Тогда
			РазвернутьСоставНабора(Комплектующая, КэшСостава, МассивНаборов, ВСтеке);
		КонецЕсли;

	КонецЦикла;

	КэшСостава.Вставить(СсылкаНабора, СтрокиСостава);
	ВСтеке.Удалить(СсылкаНабора);

КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючЦены(Набор, Номенклатура)
	ЧастьНабора = ?(ЗначениеЗаполнено(Набор), Строка(Набор.УникальныйИдентификатор()), "");
	Возврат ЧастьНабора + "|" + Строка(Номенклатура.УникальныйИдентификатор());
КонецФункции

// Один запрос на все цены всей ветки набора.
// Возврат: Соответствие, ключ "УИД_набора|УИД_номенклатуры" -> Цена
&НаСервере
Функция ПолучитьКэшЦен(МассивНаборов)

	НаборыДляЗапроса = Новый Массив;
	Для Каждого Н Из МассивНаборов Цикл
		НаборыДляЗапроса.Добавить(Н);
	КонецЦикла;
	// пустая ссылка - цены вне набора, последний фолбэк
	НаборыДляЗапроса.Добавить(Справочники.Номенклатура.ПустаяСсылка());

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	Цены.омг_Набор    КАК Набор,
		|	Цены.Цена         КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период,
		|		Прейскурант = &Прейскурант
		|		И омг_Филиал = &Филиал
		|		И омг_Набор В (&МассивНаборов)) КАК Цены";

	Запрос.УстановитьПараметр("Период",        ТекущаяДата());
	Запрос.УстановитьПараметр("Прейскурант",   Прейскурант);
	Запрос.УстановитьПараметр("Филиал",        МедицинскийЦентр);
	Запрос.УстановитьПараметр("МассивНаборов", НаборыДляЗапроса);

	Кэш = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кэш.Вставить(КлючЦены(Выборка.Набор, Выборка.Номенклатура), Выборка.Цена);
	КонецЦикла;

	Возврат Кэш;

КонецФункции

// Цена услуги с приоритетом контекста:
//   1. верхний (главный) набор - там лежит "пакетная" цена
//   2. непосредственный родитель
//   3. вне набора
&НаСервере
Функция ПолучитьЦенуУслуги(КэшЦен, Номенклатура, ВерхнийНабор, РодительскийНабор)

	Цена = КэшЦен[КлючЦены(ВерхнийНабор, Номенклатура)];
	Если Цена <> Неопределено Тогда
		Возврат Цена;
	КонецЕсли;

	Если РодительскийНабор <> ВерхнийНабор Тогда
		Цена = КэшЦен[КлючЦены(РодительскийНабор, Номенклатура)];
		Если Цена <> Неопределено Тогда
			Возврат Цена;
		КонецЕсли;
	КонецЕсли;

	Цена = КэшЦен[КлючЦены(Справочники.Номенклатура.ПустаяСсылка(), Номенклатура)];
	Возврат ?(Цена = Неопределено, 0, Цена);

КонецФункции

// Один запрос: какие из наборов ветки являются наборами ЛИС.
&НаСервере
Функция ПолучитьКэшЛИС(МассивНаборов)

	Кэш = Новый Соответствие;
	Для Каждого Н Из МассивНаборов Цикл
		Кэш.Вставить(Н, Ложь);
	КонецЦикла;

	ГруппаЛИС = Константы.омг_ГруппаЛабораторныхИсследований.Получить();
	Если Не ЗначениеЗаполнено(ГруппаЛИС) Тогда
		Возврат Кэш;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В (&МассивНаборов)
		|	И Номенклатура.ВидНоменклатуры = &ВидНабор
		|	И Номенклатура.Ссылка В ИЕРАРХИИ (&ГруппаЛИС)";

	Запрос.УстановитьПараметр("МассивНаборов", МассивНаборов);
	Запрос.УстановитьПараметр("ВидНабор",      Перечисления.ВидыНоменклатуры.Набор);
	Запрос.УстановитьПараметр("ГруппаЛИС",     ГруппаЛИС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кэш.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;

	Возврат Кэш;

КонецФункции

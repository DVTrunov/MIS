&НаКлиенте
Процедура КорзинаКоличествоПриИзменении(Элемент)

	СтрокаТЧ = Элементы.Корзина.ТекущиеДанные;
	Если СтрокаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СтрокаТЧ.Количество <= 0 Тогда
		СтрокаТЧ.Количество = 1;
	КонецЕсли;

	// Если поменяли количество узла-набора - масштабируем всю его ветку
	Если СтрокаТЧ.ПолучитьЭлементы().Количество() > 0 Тогда
		МасштабироватьВеткуНаСервере(СтрокаТЧ.ПолучитьИдентификатор());
	КонецЕсли;

	ПересчитатьИтогоКорзины();

КонецПроцедуры

&НаСервере
Процедура МасштабироватьВеткуНаСервере(ИдентификаторСтроки)

	СтрокаУзла = Корзина.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаУзла = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КэшСостава    = Новый Соответствие;
	МассивНаборов = Новый Массив;
	РазвернутьСоставНабора(СтрокаУзла.Номенклатура, КэшСостава, МассивНаборов, Новый Соответствие);

	КэшЦен = ПолучитьКэшЦен(МассивНаборов);
	КэшЛИС = ПолучитьКэшЛИС(МассивНаборов);

	// Верхний набор для контекста цены: если узел корневой - он сам,
	// иначе - тот набор, что записан в омг_Набор
	ВерхнийНабор = ?(ЗначениеЗаполнено(СтрокаУзла.омг_Набор), СтрокаУзла.омг_Набор, СтрокаУзла.Номенклатура);

	ЗаполнитьПоддеревоНабора(
		СтрокаУзла,
		СтрокаУзла.Номенклатура,
		СтрокаУзла.Количество,
		КэшСостава, КэшЦен, КэшЛИС,
		ВерхнийНабор,
		СтрокаУзла.омг_Набор,
		СтрокаУзла.омг_НаборЛИС);

	ПересчитатьСуммыДерева(Корзина.ПолучитьЭлементы());

КонецПроцедуры
&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	Если Корзина.ПолучитьЭлементы().Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Корзина пуста! Выберите услуги.");
		Возврат;
	КонецЕсли;
	
	ВыбранныеТовары = Новый Массив;
	СобратьДанныеИзДерева(Корзина.ПолучитьЭлементы(), ВыбранныеТовары);
	
	ОповеститьОВыборе(ВыбранныеТовары);
	
КонецПроцедуры

&НаКлиенте
Процедура СобратьДанныеИзДерева(СтрокиДерева, МассивРезультат)
	
	Для Каждого Стр Из СтрокиДерева Цикл
		Если Стр.ПолучитьЭлементы().Количество() > 0 Тогда
			СобратьДанныеИзДерева(Стр.ПолучитьЭлементы(), МассивРезультат);
		Иначе
			НоваяЗапись = Новый Структура("Номенклатура, Количество, Цена, Сумма, омг_Набор, омг_НаборЛИС");
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Стр);
			МассивРезультат.Добавить(НоваяЗапись);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры
&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьСуммыДерева(Строки)

	ИтогУровня = 0;

	Для Каждого Стр Из Строки Цикл

		Подчиненные = Стр.ПолучитьЭлементы();

		Если Подчиненные.Количество() = 0 Тогда
			Стр.Сумма = Стр.Количество * Стр.Цена;
		Иначе
			Стр.Сумма = ПересчитатьСуммыДерева(Подчиненные);
			Стр.Цена  = ?(Стр.Количество = 0, 0, Стр.Сумма / Стр.Количество);
		КонецЕсли;

		ИтогУровня = ИтогУровня + Стр.Сумма;

	КонецЦикла;

	Возврат ИтогУровня;

КонецФункции

&НаКлиенте
Процедура ПересчитатьИтогоКорзины()
	ИтогоСтоимостьКорзины = ПересчитатьСуммыДерева(Корзина.ПолучитьЭлементы());
КонецПроцедуры


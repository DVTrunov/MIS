// Окно входящего трафика: очередь лидов для КЦ/ОП.
// Каждый лид отрабатывается вручную: взять в работу → позвонить → результат или запись на приём.

&НаКлиенте
Перем ЛидЗвонка; // лид, по которому из окна начат звонок через Битфон
&НаКлиенте
Перем ЛидПослеЗвонка; // лид, для которого после звонка откроется «Результат звонка»

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Значение по умолчанию; сохранённые настройки пользователя загрузятся позже.
	ТолькоАктивные = Истина;
	
	омг_ЛидыСервер.НастроитьСписокЛидов(Список);
	ПрименитьОтборы();
	ИзвестныеЛиды = омг_ЛидыВызовСервера.КлючНовыхЛидов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ПрименитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ПроверитьНовыеЛиды", 60);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ОтключитьОбработчикОжидания("ПроверитьНовыеЛиды");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_омг_Лид" Или ИмяСобытия = "Запись_Заявка" Тогда
		Элементы.Список.Обновить();
	ИначеЕсли ИмяСобытия = "омг_БитфонЗвонокЗавершен" И ЛидЗвонка <> Неопределено Тогда
		// Битфон закончил звонок, начатый из окна: возвращаемся к лиду.
		// Пауза — чтобы окно оказалось поверх формы события, которую обновляет Битфон.
		ЛидПослеЗвонка = ЛидЗвонка;
		ЛидЗвонка = Неопределено;
		ПодключитьОбработчикОжидания("ВернутьсяКЛидуПослеЗвонка", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	ПрименитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, ВыбраннаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВзятьВРаботу(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид <> Неопределено Тогда
		омг_ЛидыКлиент.ВзятьВРаботу(ТекущийЛид);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Позвонить(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид <> Неопределено И омг_ЛидыКлиент.Позвонить(ТекущийЛид) Тогда
		ЛидЗвонка = ТекущийЛид;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяКЛидуПослеЗвонка() Экспорт
	
	Лид = ЛидПослеЗвонка;
	ЛидПослеЗвонка = Неопределено;
	Если Лид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Активизировать();
	Элементы.Список.Обновить();
	Элементы.Список.ТекущаяСтрока = Лид;
	омг_ЛидыКлиент.ОткрытьРезультатЗвонка(Лид, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗвонка(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид <> Неопределено Тогда
		омг_ЛидыКлиент.ОткрытьРезультатЗвонка(ТекущийЛид, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНаПрием(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид <> Неопределено Тогда
		омг_ЛидыКлиент.ОбработатьЛидСКлиентом(ТекущийЛид, "Записать", ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКарточкуПациента(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид <> Неопределено Тогда
		омг_ЛидыКлиент.ОбработатьЛидСКлиентом(ТекущийЛид, "Карточка", ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	омг_ЛидыКлиент.ОбработкаВыбораКлиента(ЭтотОбъект, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЛид(Команда)
	
	ЗначенияЗаполнения = Новый Структура;
	Если ЗначениеЗаполнено(ОтборНаправлениеТрафика) Тогда
		ЗначенияЗаполнения.Вставить("НаправлениеТрафика", ОтборНаправлениеТрафика);
	КонецЕсли;
	ЗначенияЗаполнения.Вставить("Канал", НСтр("ru = 'Вручную'"));
	ОткрытьФорму("Документ.омг_Лид.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ВыбранныйЛид()
	
	// Ключ строки динамического списка документов — ссылка на документ.
	ТекущаяСсылка = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(ТекущаяСсылка) <> Тип("ДокументСсылка.омг_Лид") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите лид в списке.'"));
		Возврат Неопределено;
	КонецЕсли;
	Возврат ТекущаяСсылка;
	
КонецФункции

&НаСервере
Процедура ПрименитьОтборы()
	
	Если ЗначениеЗаполнено(ОтборСтатус) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Статус", ОтборСтатус,
			ВидСравненияКомпоновкиДанных.Равно, , Истина);
	Иначе
		СписокАктивных = Новый СписокЗначений;
		СписокАктивных.ЗагрузитьЗначения(омг_ЛидыСервер.АктивныеСтатусы());
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Статус", СписокАктивных,
			ВидСравненияКомпоновкиДанных.ВСписке, , ТолькоАктивные);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НаправлениеТрафика", ОтборНаправлениеТрафика,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборНаправлениеТрафика));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ИсточникИнформации", ОтборИсточник,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборИсточник));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НаправлениеЛида", ОтборНаправление,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборНаправление));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ответственный",
		Пользователи.ТекущийПользователь(), ВидСравненияКомпоновкиДанных.Равно, , ТолькоМои);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНовыеЛиды() Экспорт
	
	Ключ = ИзвестныеЛиды;
	Если омг_ЛидыКлиент.ПроверитьНовыеЛиды(Ключ) Тогда
		ИзвестныеЛиды = Ключ;
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

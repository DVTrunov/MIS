// Окно входящего трафика: очередь лидов для КЦ/ОП.
// Каждый лид отрабатывается вручную: взять в работу → позвонить → результат или запись на приём.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Значение по умолчанию; сохранённые настройки пользователя загрузятся позже.
	ТолькоАктивные = Истина;
	
	НастроитьОформлениеСписка();
	ПрименитьОтборы();
	ИзвестныеЛиды = КлючНовыхЛидов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ПрименитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ПроверитьНовыеЛиды", 60);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ОтключитьОбработчикОжидания("ПроверитьНовыеЛиды");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_омг_Лид" Или ИмяСобытия = "Запись_Заявка" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	ПрименитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, ВыбраннаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВзятьВРаботу(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = ВзятьВРаботуНаСервере(ТекущийЛид);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура Позвонить(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЛида = ДанныеДляЗвонка(ТекущийЛид);
	Если ЗначениеЗаполнено(ДанныеЛида.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ДанныеЛида.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Элементы.Список.Обновить();
	
	доп_БитфонКлиент.ОткрытьБитфонНачатьРазговор(ДанныеЛида.Телефон);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗвонка(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Лид", ТекущийЛид);
	Оповещение = Новый ОписаниеОповещения("РезультатЗвонкаЗавершение", ЭтотОбъект);
	ОткрытьФорму("Обработка.омг_ОкноВходящегоТрафика.Форма.ФормаРезультатаЗвонка", ПараметрыФормы, ЭтотОбъект,,,,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗвонкаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.Список.Обновить();
	Если Результат = "Записать" Тогда
		ЗаписатьНаПрием(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНаПрием(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗаписи = ПодготовитьЗаписьНаСервере(ТекущийЛид);
	Если ЗначениеЗаполнено(ДанныеЗаписи.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ДанныеЗаписи.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Элементы.Список.Обновить();
	
	ПараметрыЗаписи = ДанныеЗаписи.ПараметрыЗаписи;
	КалендарьПланированияКлиент.ОткрытьАктивизироватьКалендарьПланирования();
	Оповестить("НамерениеЗаписиПоДокументу", ПараметрыЗаписи, ПараметрыЗаписи.ДокументЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКарточкуПациента(Команда)
	
	ТекущийЛид = ВыбранныйЛид();
	Если ТекущийЛид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗаписи = ПодготовитьЗаписьНаСервере(ТекущийЛид);
	Если ЗначениеЗаполнено(ДанныеЗаписи.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ДанныеЗаписи.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Элементы.Список.Обновить();
	ПоказатьЗначение(, ДанныеЗаписи.ПараметрыЗаписи.Клиент);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЛид(Команда)
	
	ЗначенияЗаполнения = Новый Структура;
	Если ЗначениеЗаполнено(ОтборНаправлениеТрафика) Тогда
		ЗначенияЗаполнения.Вставить("НаправлениеТрафика", ОтборНаправлениеТрафика);
	КонецЕсли;
	ЗначенияЗаполнения.Вставить("Канал", НСтр("ru = 'Вручную'"));
	ОткрытьФорму("Документ.омг_Лид.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ВыбранныйЛид()
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите лид в списке.'"));
		Возврат Неопределено;
	КонецЕсли;
	Возврат ТекущиеДанные.Ссылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВзятьВРаботуНаСервере(Лид)
	
	Возврат омг_ЛидыСервер.ВзятьВРаботу(Лид);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеДляЗвонка(Лид)
	
	Результат = Новый Структура("Телефон, ТекстОшибки", Лид.Телефон, "");
	Если Не ЗначениеЗаполнено(Лид.Телефон) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У лида не указан телефон.'");
		Возврат Результат;
	КонецЕсли;
	Если Не омг_ЛидыСервер.ЭтоЗавершающийСтатус(Лид.Статус) Тогда
		Результат.ТекстОшибки = омг_ЛидыСервер.ВзятьВРаботу(Лид);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьЗаписьНаСервере(Лид)
	
	Результат = Новый Структура("ПараметрыЗаписи, ТекстОшибки", Неопределено, "");
	
	Если Лид.Статус = Перечисления.омг_СтатусыЛидов.Упущен Или Лид.Статус = Перечисления.омг_СтатусыЛидов.Нецелевой Тогда
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Лид закрыт со статусом «%1».'"), Лид.Статус);
		Возврат Результат;
	КонецЕсли;
	Если Не омг_ЛидыСервер.ЭтоЗавершающийСтатус(Лид.Статус) Тогда
		ТекстОшибки = омг_ЛидыСервер.ВзятьВРаботу(Лид);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Результат.ТекстОшибки = ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Клиент = омг_ЛидыСервер.ОбеспечитьКлиента(Лид);
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось найти или создать карточку клиента: укажите имя лида.'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.ПараметрыЗаписи = омг_ЛидыСервер.ПараметрыЗаписиПоЛиду(Лид);
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПрименитьОтборы()
	
	Если ЗначениеЗаполнено(ОтборСтатус) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Статус", ОтборСтатус,
			ВидСравненияКомпоновкиДанных.Равно, , Истина);
	Иначе
		СписокАктивных = Новый СписокЗначений;
		СписокАктивных.ЗагрузитьЗначения(омг_ЛидыСервер.АктивныеСтатусы());
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Статус", СписокАктивных,
			ВидСравненияКомпоновкиДанных.ВСписке, , ТолькоАктивные);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НаправлениеТрафика", ОтборНаправлениеТрафика,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборНаправлениеТрафика));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ИсточникИнформации", ОтборИсточник,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборИсточник));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НаправлениеЛида", ОтборНаправление,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборНаправление));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ответственный",
		Пользователи.ТекущийПользователь(), ВидСравненияКомпоновкиДанных.Равно, , ТолькоМои);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеСписка()
	
	Список.Порядок.Элементы.Очистить();
	ЭлементПорядка = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("Дата");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	ЭлементПорядка.Использование = Истина;
	
	Цвета = Новый Соответствие;
	Цвета.Вставить(Перечисления.омг_СтатусыЛидов.Новый, Новый Цвет(255, 244, 214));
	Цвета.Вставить(Перечисления.омг_СтатусыЛидов.Пропущен, Новый Цвет(255, 214, 214));
	Цвета.Вставить(Перечисления.омг_СтатусыЛидов.Недозвон, Новый Цвет(255, 232, 204));
	Цвета.Вставить(Перечисления.омг_СтатусыЛидов.Записан, Новый Цвет(222, 242, 222));
	Цвета.Вставить(Перечисления.омг_СтатусыЛидов.Визит, Новый Цвет(204, 236, 204));
	Цвета.Вставить(Перечисления.омг_СтатусыЛидов.Упущен, Новый Цвет(235, 235, 235));
	Цвета.Вставить(Перечисления.омг_СтатусыЛидов.Нецелевой, Новый Цвет(235, 235, 235));
	
	Для Каждого ЭлементЦвета Из Цвета Цикл
		ЭлементОформления = Список.УсловноеОформление.Элементы.Добавить();
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ЭлементЦвета.Ключ;
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЭлементЦвета.Значение);
		ЭлементОформления.Представление = НСтр("ru = 'Цвет статуса'") + " " + ЭлементЦвета.Ключ;
	КонецЦикла;
	
	// Перезвон на сегодня и просроченный — красный текст.
	ЭлементОформления = Список.УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПерезвонитьВ");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПерезвонитьВ");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ЭлементОтбора.ПравоеЗначение = Новый СтандартнаяДатаНачала(ВариантСтандартнойДатыНачала.НачалоСледующегоДня);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ПерезвонитьВ");
	ЭлементОформления.Представление = НСтр("ru = 'Перезвонить сегодня'");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючНовыхЛидов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Лид.Ссылка) КАК Количество,
	|	МАКСИМУМ(Лид.Дата) КАК Дата
	|ИЗ
	|	Документ.омг_Лид КАК Лид
	|ГДЕ
	|	Лид.Статус В (&Статусы)
	|	И Лид.Ответственный = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	И НЕ Лид.ПометкаУдаления";
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.омг_СтатусыЛидов.Новый);
	Статусы.Добавить(Перечисления.омг_СтатусыЛидов.Пропущен);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Количество) Тогда
		Возврат Формат(Выборка.Количество, "ЧГ=0") + "|" + Формат(Выборка.Дата, "ДФ=yyyyMMddHHmmss");
	КонецЕсли;
	Возврат "0|";
	
КонецФункции

&НаКлиенте
Процедура ПроверитьНовыеЛиды() Экспорт
	
	НовыйКлюч = КлючНовыхЛидов();
	Если НовыйКлюч = ИзвестныеЛиды Тогда
		Возврат;
	КонецЕсли;
	
	СтарыеЧасти = СтрРазделить(ИзвестныеЛиды, "|");
	НовыеЧасти = СтрРазделить(НовыйКлюч, "|");
	ИзвестныеЛиды = НовыйКлюч;
	Элементы.Список.Обновить();
	
	// Сообщаем, только если появился более свежий лид.
	Если НовыеЧасти.Количество() > 1 И СтарыеЧасти.Количество() > 1 И НовыеЧасти[1] > СтарыеЧасти[1] Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Новый лид'"), ,
			СтрШаблон(НСтр("ru = 'Ждут обработки: %1'"), НовыеЧасти[0]));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

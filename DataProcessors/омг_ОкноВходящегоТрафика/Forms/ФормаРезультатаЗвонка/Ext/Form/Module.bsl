// Результат звонка по лиду. Закрывается со значением выбранного результата,
// чтобы окно трафика при «Записать» сразу открыло календарь.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Лид = Параметры.Лид;
	Если Не ЗначениеЗаполнено(Лид) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ЛидПредставление = СтрШаблон("%1, %2 (%3)", СокрЛП(Лид.Имя), Лид.Телефон, Лид.Статус);
	
	СписокРезультатов = Элементы.Результат.СписокВыбора;
	СписокРезультатов.Добавить("Записать", НСтр("ru = 'Записать на приём'"));
	СписокРезультатов.Добавить("Перезвонить", НСтр("ru = 'Перезвонить позже'"));
	СписокРезультатов.Добавить("Недозвон", НСтр("ru = 'Недозвон'"));
	СписокРезультатов.Добавить("Отказ", НСтр("ru = 'Отказ (упущен)'"));
	СписокРезультатов.Добавить("Нецелевой", НСтр("ru = 'Нецелевой'"));
	Результат = "Недозвон";
	
	УстановитьДоступностьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура РезультатПриИзменении(Элемент)
	
	УстановитьДоступностьНаКлиенте();
	Если Результат = "Перезвонить" И Не ЗначениеЗаполнено(ПерезвонитьВ) Тогда
		ПерезвонитьВ = ОбщегоНазначенияКлиент.ДатаСеанса() + 3600;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьРезультат(Команда)
	
	ТекстОшибки = СохранитьНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	Оповестить("Запись_омг_Лид", , Лид);
	Закрыть(Результат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СохранитьНаСервере()
	
	Возврат омг_ЛидыСервер.ЗаписатьРезультатЗвонка(Лид, Результат, ПерезвонитьВ, ПричинаОтказа, Комментарий);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НужнаПричина(ЗначениеРезультата)
	
	Возврат ЗначениеРезультата = "Отказ" Или ЗначениеРезультата = "Нецелевой";
	
КонецФункции

&НаСервере
Процедура УстановитьДоступностьНаСервере()
	
	Элементы.ПерезвонитьВ.Видимость = (Результат = "Перезвонить");
	Элементы.ПричинаОтказа.Видимость = НужнаПричина(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьНаКлиенте()
	
	Элементы.ПерезвонитьВ.Видимость = (Результат = "Перезвонить");
	Элементы.ПричинаОтказа.Видимость = НужнаПричина(Результат);
	
КонецПроцедуры

#КонецОбласти

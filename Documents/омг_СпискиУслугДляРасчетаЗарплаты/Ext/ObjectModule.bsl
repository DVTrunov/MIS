Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	СтараяТаблицаУслуг = ЭтотОбъект.УслугиПодробно.Выгрузить();
	
	ТабУслуги = ЭтотОбъект.Услуги.Выгрузить();
	ТабУслуги.Свернуть("Услуга");
	
	УслугиПодробно.Очистить();
	
	Если ТабУслуги.Количество() > 0 Тогда
		
		МассивНоменклатуры = ТабУслуги.ВыгрузитьКолонку("Услуга");
		СоответствиеЭтоГруппа = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивНоменклатуры, "ЭтоГруппа");
		
		МассивГрупп = Новый Массив;
		МассивУслуг = Новый Массив;
		
		Для Каждого Строка Из ТабУслуги Цикл
			Если СоответствиеЭтоГруппа.Получить(Строка.Услуга).ЭтоГруппа Тогда
				МассивГрупп.Добавить(Строка.Услуга);
			Иначе
				МассивУслуг.Добавить(Строка.Услуга);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Услуга Из МассивУслуг Цикл
			СтрУслугиПодробно = УслугиПодробно.Добавить();
			СтрУслугиПодробно.Услуга    = Услуга;
			СтрУслугиПодробно.Приоритет = 1;
		КонецЦикла;
		
		Если МассивГрупп.Количество() > 0 Тогда
			
			УслугиИзГрупп = омг_ДополнительныеАлгоритмы.ВернутьСписокУслугСприоритетом(МассивГрупп);
			
			Для Каждого Строка Из УслугиИзГрупп Цикл
				СтрУслугиПодробно = УслугиПодробно.Добавить();
				СтрУслугиПодробно.Услуга               = Строка.Услуга;
				СтрУслугиПодробно.Приоритет            = Строка.Приоритет;
				СтрУслугиПодробно.ИсходнаяУслугаГруппа = Строка.ИсходнаяУслугаГруппа;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Дифф = омг_ДополнительныеАлгоритмы.ВычислитьДиффУслуг(СтараяТаблицаУслуг, УслугиПодробно.Выгрузить());
	
	ЗатронутыеУслуги = Новый Массив;
	Для Каждого Элемент Из Дифф.Удаленные Цикл
		ЗатронутыеУслуги.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Элемент Из Дифф.Добавленные Цикл
		ЗатронутыеУслуги.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Элемент Из Дифф.Измененные Цикл
		ЗатронутыеУслуги.Добавить(Элемент);
	КонецЦикла;
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("омг_ЗатронутыеУслуги", ЗатронутыеУслуги);

КонецПроцедуры
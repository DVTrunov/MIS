&НаСервере
Процедура Омг_НесколькоВрачей()
	
	Элементы.Сотрудник.Доступность = Не Объект.НесколькоСотрудников;
		
	Элементы.омг_РаботыВремяНачала.Видимость = Объект.НесколькоСотрудников;
	Элементы.омг_РаботыДатаНачала.Видимость = Объект.НесколькоСотрудников; 
	Элементы.омг_РаботыВремяОкончания.Видимость = Объект.НесколькоСотрудников; 
	Элементы.Работыомг_БезЗаписиНесколькоВрачей.Видимость = Объект.НесколькоСотрудников;
	
	Для каждого строка из Объект.Работы Цикл
		
		Если не ЗначениеЗаполнено(строка.ДатаНачала) и не ЗначениеЗаполнено(строка.ДатаОкончания) Тогда
		ЗаполнитьЗначенияСвойств(строка,Объект,"ДатаНачала,ДатаОкончания");	
		строка.Продолжительность = Продолжительность * 60;	
		КонецЕсли;	
		
		Если (не ЗначениеЗаполнено(строка.Сотрудник) и Объект.НесколькоСотрудников) или не Объект.НесколькоСотрудников Тогда
		ЗаполнитьЗначенияСвойств(строка,Объект,"Сотрудник");		
		КонецЕсли;    
		
		Если строка.омг_БезЗаписиНесколькоВрачей Тогда
			строка.ДатаНачала = НачалоДня(строка.ДатаНачала) + Час(мУчетнаяПолитика.ВремяНачалаРаботы) *60*60;
			строка.ДатаОкончания = строка.ДатаНачала;
		КонецЕсли;	
	
	КонецЦикла;	
		
КонецПроцедуры


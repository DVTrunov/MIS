		Элементы.Сотрудник.СписокВыбора.Очистить();
		Элементы.Сотрудник.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		Элементы.Сотрудник.КнопкаВыпадающегоСписка = Ложь;

&НаКлиенте
Процедура омг_ВзятьПредоплату(Команда) 
	
	Если Объект.Ссылка.Пустая() Тогда
		Записать()
	КонецЕсли;	
	
	Если омг_СтатусПредоплаты = "Оплата принята" Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораКнопки", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, "Вернуть предоплату?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да); 
		
	иначе
		
		Кнопки = Новый СписокЗначений; 
		Кнопки.Добавить("БанковскаяКарта", "Банковская карта");
		Кнопки.Добавить("Наличные", "Наличные");
		Кнопки.Добавить("Отмена", "Отмена");
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораКнопки", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, "Выберите тип оплаты:", Кнопки,,"Отмена"); 
		
	КонецЕсли;
	
КонецПроцедуры    
&НаКлиенте
Процедура ПослеВыбораКнопки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Ссылка.Пустая() Тогда	
		  Записать()
	КонецЕсли;
	
	Если Результат = "Наличные" Тогда
		
		ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
		ОткрытьФорму("Документ.ПриходныйКассовыйОрдер.Форма.ФормаДокументаУпр", ПараметрыФормы);
		
	ИначеЕсли Результат = "БанковскаяКарта" Тогда
		
		ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
		ОткрытьФорму("Документ.ОплатаПлатежнойКартой.Форма.ФормаДокументаУпр", ПараметрыФормы);
		
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда	
		
		ПлатежныйДокумент = ВернутьПлатежныйДокумент();
		ПараметрыФормы = Новый Структура("Основание",ПлатежныйДокумент);
		
		Если ТипЗнч(ПлатежныйДокумент)   = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
			
			ОткрытьФорму("Документ.РасходныйКассовыйОрдер.Форма.ФормаДокументаУпр", ПараметрыФормы);
			
		иначе
			
			ОткрытьФорму("Документ.ВозвратПоПлатежнойКарте.Форма.ФормаДокументаУпр", ПараметрыФормы);
			
		КонецЕсли;
		
	КонецЕсли;    
	
	ОбновитьПредоплату();
	
КонецПроцедуры    

 &НаСервере
Функция ВернутьСтатусОплаты()  
	
	ВозЗначение = Ложь;
	
	Если не Объект.Ссылка.Пустая() Тогда
		Если ЗначениеЗаполнено(омг_Предоплата.ВернутьСтатусОплаты(Объект.Ссылка)) Тогда
			ВозЗначение = Истина
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВозЗначение
	
КонецФункции     

&НаСервере
Процедура ОбновитьПредоплату()   
	// Временно закомментить для отладки 8.5
	Элементы.ГруппаПредоплатыИОповещений.Видимость = Ложь; 
	Элементы.омг_СтатусПредоплаты.Видимость = Ложь; 
	Элементы.омг_Ссылка.Видимость = Ложь;
	Элементы.омг_ВзятьПредоплату.Видимость = Ложь; 
	Элементы.ОМГ_ПричинаОтсутствияПредоплаты.Видимость = Ложь;
	//Временно для отладки 8.5
	Организация  = омг_ДополнительныеАлгоритмы.омг_ВернутьОрганизациюПоФилиалу(Объект.Филиал);
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Если омг_Предоплата.омг_ИспользуетсяПредоплата(Организация) Тогда 
			
			Элементы.омг_ВзятьПредоплату.Видимость = Истина;
			Элементы.ОМГ_ПричинаОтсутствияПредоплаты.Видимость = Истина;
			
			Если не Объект.Ссылка.Пустая() Тогда
				
				СтатусОплаты = омг_Предоплата.ВернутьСтатусОплаты(Объект.Ссылка);
				
				Если ЗначениеЗаполнено(СтатусОплаты) Тогда
					омг_СтатусПредоплаты = СтатусОплаты.Статус;
					омг_Ссылка = СтатусОплаты.Ссылка;
					Элементы.омг_ВзятьПредоплату.Видимость = Ложь;
					Элементы.омг_СтатусПредоплаты.Видимость = Истина;  
					Элементы.омг_Ссылка.Видимость = Истина;
					Элементы.ОМГ_ПричинаОтсутствияПредоплаты.Видимость = Ложь; 
					
					Если СтатусОплаты.Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыПредоплаты.ОплатаПринята") Тогда
						Элементы.омг_ВзятьПредоплату.Видимость = Истина;
						Элементы.омг_ВзятьПредоплату.Заголовок = "Вернуть предоплату";
					иначе
						Элементы.омг_ВзятьПредоплату.Видимость = Ложь;
						Элементы.омг_ВзятьПредоплату.Заголовок = "Взять предоплату";
					КонецЕсли;	
				КонецЕсли;	
				
			КонецЕсли; 
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры  
 &НаСервере
Функция ВернутьПлатежныйДокумент()  
	
	Возврат омг_Предоплата.ВернутьСтатусОплаты(Объект.Ссылка).ПлатежныйДокумент;
	 
КонецФункции


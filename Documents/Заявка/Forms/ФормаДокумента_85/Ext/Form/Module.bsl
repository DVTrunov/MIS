&НаСервере
Процедура омг_ПерезаполнитьУслугиПерсоналПриемыНаСервере(ЭтоУслуги)
	
	Табсотрудников = Объект.Работы.Выгрузить(,"Сотрудник"); 
	Табсотрудников.Свернуть("Сотрудник");
	
	Для каждого стрТабсотрудников из Табсотрудников Цикл 
      	Сотрудник = ?(ЗначениеЗаполнено(стрТабсотрудников.Сотрудник),стрТабсотрудников.Сотрудник,Объект.Сотрудник);
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Прием.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Прием КАК Прием
		|ГДЕ
		|	Прием.ДокументОснование = &ЭтаЗаявка
		|	И Прием.ПометкаУдаления = ЛОЖЬ
		|	И Прием.Врач = &Сотрудник
		|
		|СГРУППИРОВАТЬ ПО
		|	Прием.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Прием.Дата";
		
		Запрос.УстановитьПараметр("ЭтаЗаявка", Объект.Ссылка); 
		Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Сч = Ложь;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл        
			
			ПриемОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект(); 
			Если ЭтоУслуги Тогда
				ПриемОбъект.Работы.Очистить();
			Иначе
				ПриемОбъект.омг_МедПерсонал.Очистить();
			КонецЕсли;		
			
			Если Сч = Ложь и ЭтоУслуги Тогда 
				СтрПоиска = Новый Структура("Сотрудник",Сотрудник); 
				МассивНайденных =  Объект.Работы.Выгрузить().НайтиСтроки(СтрПоиска);
				Для каждого стрМассивНайденных из МассивНайденных Цикл 
					Если ЗначениеЗаполнено(стрМассивНайденных.Номенклатура) Тогда
						ЗаполнитьЗначенияСвойств(ПриемОбъект.Работы.Добавить(),стрМассивНайденных)
					КонецЕсли;
				КонецЦикла; 
			Если Сотрудник = Объект.Сотрудник Тогда	
				СтрПоиска = Новый Структура("Сотрудник",Справочники.Сотрудники.ПустаяСсылка()); 
				МассивНайденных =  Объект.Работы.Выгрузить().НайтиСтроки(СтрПоиска);
				Для каждого стрМассивНайденных из МассивНайденных Цикл 
					Если ЗначениеЗаполнено(стрМассивНайденных.Номенклатура) Тогда
						ЗаполнитьЗначенияСвойств(ПриемОбъект.Работы.Добавить(),стрМассивНайденных)
					КонецЕсли;
				КонецЦикла;
             КонецЕсли;
				Сч = Истина;
			ИначеЕсли не ЭтоУслуги Тогда 
				ПриемОбъект.омг_МедПерсонал.Загрузить(Объект.омг_МедПерсонал.Выгрузить());			
			КонецЕсли;
			
			Если ПриемОбъект.Проведен Тогда 
				ПриемОбъект.Записать(РежимЗаписиДокумента.Проведение);
			иначе
				ПриемОбъект.Записать();
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
КонецПроцедуры   


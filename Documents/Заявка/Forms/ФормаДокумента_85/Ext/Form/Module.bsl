&НаСервере
Процедура ЗаполнитьИнструкциюНаСервере()
	
	ПолноеИмяМетаданных = Объект.Ссылка.Метаданные().ПолноеИмя();
	
	Идентификатор = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", ПолноеИмяМетаданных);
	
	Если Идентификатор.Пустая() Тогда
		Элементы.ГруппаОписания.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ТипОбъекта", Идентификатор);
	ЗаписьРегистра = РегистрыСведений.ИнструкцииКОбъектам.Получить(Отбор);
	
	Если ЗначениеЗаполнено(ЗаписьРегистра.ТекстИнструкции) Тогда
		ТекстИнструкцииДляПользователя = ЗаписьРегистра.ТекстИнструкции.Получить();
	Иначе
		Элементы.ГруппаОписания.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьИнформациюОКорзине()
	
	ОбщееКоличествоУслуг = Объект.Работы.Итог("Количество");
	Если ОбщееКоличествоУслуг = 0 Тогда
    	КоличествоУслугВКорзине = "Корзина пуста";
	Иначе
	//КоличествоУслугВКорзине = "В корзине " + Количество + " услуг";
	

		Остаток10 = ОбщееКоличествоУслуг % 10;
		Остаток100 = ОбщееКоличествоУслуг % 100;
	
	Если Остаток10 = 1 И Остаток100 <> 11 Тогда
		Слово = "услуга";
	ИначеЕсли (Остаток10 >= 2 И Остаток10 <= 4) И (Остаток100 < 10 Или Остаток100 >= 20) Тогда
		Слово = "услуги";
	Иначе
		Слово = "услуг";
	КонецЕсли;
	
	КоличествоУслугВКорзине = СтрШаблон("В корзине %1 %2", ОбщееКоличествоУслуг, Слово);
	КонецЕсли;
	

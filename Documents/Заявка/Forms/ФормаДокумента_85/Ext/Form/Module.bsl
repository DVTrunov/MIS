&НаСервере
Процедура ДобавитьРаботыИзПодбораНаСервере(МассивВыбранныхУслуг)
	
	Для Каждого ДанныеУслуги Из МассивВыбранныхУслуг Цикл
		
		ПараметрыПоиска = Новый Структура("Номенклатура", ДанныеУслуги.Номенклатура);
		НайденныеСтроки = Объект.Работы.НайтиСтроки(ПараметрыПоиска);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НоваяСтрока = НайденныеСтроки[0];
			НоваяСтрока.Количество = НоваяСтрока.Количество + ДанныеУслуги.Количество;
		Иначе
			НоваяСтрока = Объект.Работы.Добавить();
			НоваяСтрока.Номенклатура = ДанныеУслуги.Номенклатура;
			НоваяСтрока.Количество   = ДанныеУслуги.Количество;
			НоваяСтрока.Цена         = ДанныеУслуги.Цена;
		КонецЕсли;
		
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
		
		
	КонецЦикла;
	 
КонецПроцедуры


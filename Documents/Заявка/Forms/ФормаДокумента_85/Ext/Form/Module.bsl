&НаКлиенте
Процедура ОМГ_ПересчитатьПРодолжительность()    
	
	Если Элементы.Работы.ТекущиеДанные.омг_БезЗаписиНесколькоВрачей Тогда
		Элементы.Работы.ТекущиеДанные.Продолжительность = '00010101'; 
		Элементы.Работы.ТекущиеДанные.ДатаНачала = НачалоДня(Элементы.Работы.ТекущиеДанные.ДатаНачала);
		Элементы.Работы.ТекущиеДанные.ДатаОкончания = НачалоДня(Элементы.Работы.ТекущиеДанные.ДатаОкончания);
	иначе	
		Элементы.Работы.ТекущиеДанные.Продолжительность = Дата(1,1,1) + (Элементы.Работы.ТекущиеДанные.ДатаОкончания - Элементы.Работы.ТекущиеДанные.ДатаНачала);	
	КонецЕсли;

КонецПроцедуры


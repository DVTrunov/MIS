&НаСервере
Процедура ОМГ_ЗаполнитьПродажи()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_НоменклатураЗаявокДляОказаний.Номенклатура КАК Номенклатура,
		|	СУММА(ВЫБОР
		|			КОГДА омг_НоменклатураЗаявокДляОказаний.ВидДвижения = &Приход
		|				ТОГДА омг_НоменклатураЗаявокДляОказаний.Количество * -1
		|			ИНАЧЕ омг_НоменклатураЗаявокДляОказаний.Количество
		|		КОНЕЦ) КАК Продано,
		|	омг_НоменклатураЗаявокДляОказаний.Врач КАК Врач
		|ИЗ
		|	РегистрНакопления.омг_НоменклатураЗаявокДляОказаний КАК омг_НоменклатураЗаявокДляОказаний
		|ГДЕ
		|	омг_НоменклатураЗаявокДляОказаний.Оплачено
		|	И омг_НоменклатураЗаявокДляОказаний.Заявка = &Заявка
		|	И ТИПЗНАЧЕНИЯ(омг_НоменклатураЗаявокДляОказаний.Регистратор) = ТИП(Документ.ОказаниеУслуг)
		|
		|СГРУППИРОВАТЬ ПО
		|	омг_НоменклатураЗаявокДляОказаний.Номенклатура,
		|	омг_НоменклатураЗаявокДляОказаний.Врач";
	
	Запрос.УстановитьПараметр("Заявка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Приход", ВидДвиженияНакопления.Приход);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Для каждого строка из Объект.Работы Цикл
		СтрПоиска = Новый Структура();
		СтрПоиска.Вставить("Номенклатура",строка.Номенклатура);
		СотрудникДляПоиска = ?(ЗначениеЗаполнено(строка.Сотрудник),строка.Сотрудник,Объект.Сотрудник);
		СтрПоиска.Вставить("Врач",СотрудникДляПоиска);
		ВыборкаДетальныеЗаписи.Сбросить();
		Если ВыборкаДетальныеЗаписи.НайтиСледующий(СтрПоиска) Тогда
			 строка.омг_Продано = ВыборкаДетальныеЗаписи.Продано
		КонецЕсли;	
	КонецЦикла;	
		
КонецПроцедуры	

&НаКлиенте
Процедура РаботыПередНачаломИзменения(Элемент, Отказ) 
	
	Если Элемент.ТекущиеДанные.омг_Продано > 0 Тогда
		Если не Элемент.ТекущийЭлемент.Имя = "Количество" Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыПередУдалением(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные.омг_Продано > 0 Тогда
			Отказ = Истина;
			Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РаботыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если Элемент.ТекущиеДанные.омг_Продано > 0 Тогда
		Если Элемент.ТекущиеДанные.омг_Продано > Элемент.ТекущиеДанные.Количество Тогда
			Элемент.ТекущиеДанные.Количество = Элемент.ТекущиеДанные.омг_Продано
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция омг_ПроверкаНаПовторСтраховых()
	
	Номенклатуры = Объект.Работы.Выгрузить(,"Номенклатура").ВыгрузитьКолонку("Номенклатура");
	ТекстОшибки = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_НоменклатураИКлиентыПоСтраховым.Период КАК Период,
		|	омг_НоменклатураИКлиентыПоСтраховым.Регистратор КАК Регистратор,
		|	омг_НоменклатураИКлиентыПоСтраховым.НомерСтроки КАК НомерСтроки,
		|	омг_НоменклатураИКлиентыПоСтраховым.Активность КАК Активность,
		|	омг_НоменклатураИКлиентыПоСтраховым.Клиент КАК Клиент,
		|	омг_НоменклатураИКлиентыПоСтраховым.Номенклатура КАК Номенклатура,
		|	омг_НоменклатураИКлиентыПоСтраховым.СтраховаяПрограмма КАК СтраховаяПрограмма,
		|	омг_НоменклатураИКлиентыПоСтраховым.Заявка КАК Заявка
		|ИЗ
		|	РегистрСведений.омг_НоменклатураИКлиентыПоСтраховым КАК омг_НоменклатураИКлиентыПоСтраховым
		|ГДЕ
		|	омг_НоменклатураИКлиентыПоСтраховым.Период >= &НачалоМесяц
		|	И омг_НоменклатураИКлиентыПоСтраховым.Номенклатура В(&Номенклатуры)
		|	И омг_НоменклатураИКлиентыПоСтраховым.Клиент = &Клиент
		|	И омг_НоменклатураИКлиентыПоСтраховым.СтраховаяПрограмма = &СтраховаяПрограмма
		|	И омг_НоменклатураИКлиентыПоСтраховым.Период <= &КонецМесяца
		|	И омг_НоменклатураИКлиентыПоСтраховым.Регистратор.Состояние <> &Отменена
		|	И омг_НоменклатураИКлиентыПоСтраховым.Регистратор <> &ЭтаЗаявка";
	
	Запрос.УстановитьПараметр("Клиент", Объект.Клиент);
	Запрос.УстановитьПараметр("КонецМесяца", Объект.Дата);
	Запрос.УстановитьПараметр("НачалоМесяц", НачалоДня(НачалоМесяца(Объект.Дата)));           
	Запрос.УстановитьПараметр("Номенклатуры", Номенклатуры);
	Запрос.УстановитьПараметр("СтраховаяПрограмма", Объект.омг_СтраховаяПрограмма);
	Запрос.УстановитьПараметр("Отменена", Справочники.ВидыСостоянийЗаявок.Отменена);
	Запрос.УстановитьПараметр("ЭтаЗаявка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номенклатура) Тогда
		ТекстОшибки = "" + ТекстОшибки + ВыборкаДетальныеЗаписи.Номенклатура +" в "+ВыборкаДетальныеЗаписи.Заявка + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекстОшибки; 
	
КонецФункции

&НаКлиенте
Процедура СостояниеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
    СписокЭлемент = Новый СписокЗначений;
	МассивСостояний = ВернутьСостояния();
	Для каждого строка из МассивСостояний Цикл
    СписокЭлемент.Добавить(строка,строка);
    КонецЦикла;
    ВыбранныйЭлемент = ВыбратьИзСписка(СписокЭлемент);
    Если ВыбранныйЭлемент <> Неопределено Тогда
        Объект.Состояние = ВыбранныйЭлемент.Значение;
	КонецЕсли;
	

КонецПроцедуры  


&НаСервере
Функция ВернутьСостояния()
		
	Запрос = Новый Запрос; 
	
	Если РольДоступна("ПолныеПрава") тогда 
		
		Условие = "";  
		
	иначе   
		
		Условие ="
		|
		|ГДЕ
		|	ВидыСостоянийЗаявок.Наименование В (&СписокНаименований)";  
		
		СписокНаименований = Новый Массив;
		СписокНаименований.Добавить("Запланирована");
		СписокНаименований.Добавить("Подтверждена");
		СписокНаименований.Добавить("Отменена");	
		Запрос.УстановитьПараметр("СписокНаименований", СписокНаименований); 
		
	КонецЕсли;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	ВидыСостоянийЗаявок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыСостоянийЗаявок КАК ВидыСостоянийЗаявок" + Условие;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат ВыборкаДетальныеЗаписи; 
	
КонецФункции	


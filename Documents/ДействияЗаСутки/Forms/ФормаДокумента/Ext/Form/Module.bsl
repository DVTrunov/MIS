// Функция осуществляет обработку считывания штрих-кода номенклатуры.
//
// Параметры:
//  Номенклатура   - <СправочникСсылка.Номенклатура>
//                 - Номенклатура, штрих-код которой был отсканирован.
//
//  Единица        - <СправочникСсылка.ЕдиницыИзмерения>
//                 - Единица измерения отсканированной номенклатуры.
//
//  Количество     - <Число>
//                 - Количество отсканированной номенклатуры.
//
//  СШК            - <Строка>
//                 - Идентификатор сканера штрих-кода, с которым связано данное
//                   событие.
//
// Возвращаемое значение:
//  <Булево>       - Данная ситуация обработана.
//
//&НаКлиенте
//Функция СШКНоменклатура(Номенклатура, Единица, Количество, СШК, ХарактеристикаНоменклатуры = Неопределено, Цена = 0) Экспорт
&НаКлиенте
Функция СШКНоменклатура(ДанныеНоменклатуры, СШК) Экспорт
	Номенклатура				= ДанныеНоменклатуры.Номенклатура;
	Количество					= ДанныеНоменклатуры.Количество;
	ХарактеристикаНоменклатуры	= ДанныеНоменклатуры.ХарактеристикаНоменклатуры;
	Единица						= ДанныеНоменклатуры.ЕдиницаИзмерения;
	СерияНоменклатуры           = ДанныеНоменклатуры.СерияНоменклатуры;
	
	ТабличнаяЧасть	= Объект.ДействияСтационара;
	Отбор = РаботаСДокументамиКлиент.ЧтениеШтрихкода_ОтборДляПоискаСтрокиДокумента(ДанныеНоменклатуры);
	Отбор.Вставить("ДействиеСтационара", Номенклатура);
	Отбор.Удалить("Номенклатура");
	мсСтрокиТовары = ТабличнаяЧасть.НайтиСтроки(Отбор);
	
	Если мсСтрокиТовары.Количество() = 0 Тогда
		// Определяем, следует добавить новую строку или использовать текущую
		ТекущаяСтрока = Элементы.ДействияСтационара.ТекущиеДанные;
		Если ТекущаяСтрока <> Неопределено
			И (Не ЗначениеЗаполнено(ТекущаяСтрока.ДействиеСтационара) Или Номенклатура = ТекущаяСтрока.ДействиеСтационара)
			И Не ЗначениеЗаполнено(ТекущаяСтрока.СерияНоменклатуры)
		Тогда
			СтрокаТЧ = ТекущаяСтрока;
			
			Если  ЗначениеЗаполнено(ТекущаяСтрока.ДействиеСтационара)
				И Не ЗначениеЗаполнено(Единица)
				И ЗначениеЗаполнено(ТекущаяСтрока.ЕдиницаИзмерения)
			Тогда
				Единица = ТекущаяСтрока.ЕдиницаИзмерения;
			КонецЕсли;
		Иначе
			// Добавление новой строки
			СтрокаТЧ = ТабличнаяЧасть.Добавить();
		КонецЕсли;
		
		СтрокаТЧ.ВидыДействийСтационара = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Медикаменты");
		СтрокаТЧ.ДействиеСтационара = Номенклатура;
		СтрокаТЧ.Количество = Количество;
		СтрокаТЧ.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
		СтрокаТЧ.СерияНоменклатуры = СерияНоменклатуры;
		Если ЗначениеЗаполнено(Единица) Тогда
			СтрокаТЧ.ЕдиницаИзмерения = Единица;
		Иначе
			СтрокаТЧ.ЕдиницаИзмерения = ДопСерверныеФункции.ПолучитьРеквизит(Номенклатура, "ЕдиницаХраненияОстатков");
		КонецЕсли;
		
		СтрокаТЧ.Коэффициент = ДопСерверныеФункции.ПолучитьРеквизит(СтрокаТЧ.ЕдиницаИзмерения, "Коэффициент");
		
		ОбработкаРеквизитаУпр("ДействияСтационара.Номенклатура", СтрокаТЧ);
	Иначе
		// Увеличивается количество в существующей строке
		СтрокаТЧ = мсСтрокиТовары[0];
		СтрокаТЧ.Количество = СтрокаТЧ.Количество + Количество;      
	КонецЕсли;

	Возврат Истина;
	
КонецФункции // СШКНоменклатура()

&НаСервереБезКонтекста
Функция РассчитатьВидимостьСписанияТоваров(Дата, СписаниеТоваров)
	
	Возврат ЗначениеЗаполнено(СписаниеТоваров)
		Или Не УправлениеНастройками.ПолучитьПериодическийПараметрУчетнойПолитики("СписыватьМатериалыСтационараСразу", Дата);
	
КонецФункции

&НаСервереБезКонтекста	
Функция СоздатьДокументСписания(ДокументОснование)
	
	ДокументСписания = Документы.СписаниеТоваров.СоздатьДокумент();
	ДокументСписания.Заполнить(ДокументОснование);
	Если ДокументСписания.Товары.Количество() = 0 Тогда
		Возврат НСтр("ru='В документе нет позиций для списания по складу.'");
	КонецЕсли;

	ДокументСписания.Дата = ТекущаяДата();
	ДокументСписания.Филиал = ДокументОснование.Филиал;
	ДокументСписания.Ответственный = ОбщегоНазначения.ТекущийПользователь();
	
	ДокументСписания.Комментарий = НСтр("ru='Списание по документу " + ДокументОснование + "'");
	
	ДокументСписания.Записать();
	Попытка
		ДокументСписания.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	КонецПопытки;
	
	Возврат ДокументСписания.Ссылка;
	
КонецФункции	

&НаКлиенте
Процедура ПривестиТипДанныхДействияСтационараКВидуДействия()
	
	ТекущиеДанные = Элементы.ДействияСтационара.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ВидыДействийСтационара) Тогда
		Если ТекущиеДанные.ВидыДействийСтационара = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Манипуляции") Тогда
			ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.ДействияМедсестрыСтационара");
		Иначе
			ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
		КонецЕсли;
		ТекущиеДанные.ДействиеСтационара = ОписаниеТипа.ПривестиЗначение(ТекущиеДанные.ДействиеСтационара);
	Иначе
		ТекущиеДанные.ДействиеСтационара = Неопределено;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыВыбораДействияСтационара()
	
	ПараметрыВыбораЗначения = Новый Массив;
	
	ТекущиеДанные = Элементы.ДействияСтационара.ТекущиеДанные;
	
	Элементы.ДействияСтационараДействиеСтационара.ВыбиратьТип = (ТекущиеДанные.ДействиеСтационара = Неопределено);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ВидыДействийСтационара)
		И ТекущиеДанные.ВидыДействийСтационара <> ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Манипуляции")
	Тогда
		Если ТекущиеДанные.ВидыДействийСтационара = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Процедуры") Тогда
			ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("Отбор.ВидНоменклатуры", ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Услуга")));
		ИначеЕсли ТекущиеДанные.ВидыДействийСтационара = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Медикаменты") Тогда
			ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("Отбор.ВидНоменклатуры", ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Материал")));
		КонецЕсли;
	КонецЕсли;
		
	Элементы.ДействияСтационараДействиеСтационара.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияСтационараДействиеСтационараАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	УстановитьПараметрыВыбораДействияСтационара();
КонецПроцедуры

&НаКлиенте
Процедура ДействияСтационараСерияНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ДействияСтационара.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ДействиеСтационара) Тогда 
		Возврат;	
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Склад, ЕдиницаИзмерения, ЭтоПодбор, ТолькоВНаличии", ТекущиеДанные.ДействиеСтационара, ТекущиеДанные.ХарактеристикаНоменклатуры, 
					?(ЗначениеЗаполнено(ТекущиеДанные.Склад), ТекущиеДанные.Склад, Объект.Склад), ТекущиеДанные.ЕдиницаИзмерения, Ложь, Истина);
	ОткрытьФорму("Справочник.СерииНоменклатуры.Форма.ФормаПодбораСерийНоменклатуры", ПараметрыФормы, Элемент,ПараметрыФормы,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерерасходСерияНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Перерасход.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда 
		Возврат;	
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Склад, ЕдиницаИзмерения, ЭтоПодбор, ТолькоВНаличии", ТекущиеДанные.Номенклатура, ТекущиеДанные.ХарактеристикаНоменклатуры, 
					?(ЗначениеЗаполнено(ТекущиеДанные.Склад), ТекущиеДанные.Склад, Объект.Склад), ТекущиеДанные.ЕдиницаИзмерения, Ложь, Истина);
	ОткрытьФорму("Справочник.СерииНоменклатуры.Форма.ФормаПодбораСерийНоменклатуры", ПараметрыФормы, Элемент,ПараметрыФормы,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормамиСервер.ФормаДокументаПриОткрытииСервер(ЭтаФорма, Ложь);
	
	Элементы.ГруппаСписаниеТоваров.Видимость = РассчитатьВидимостьСписанияТоваров(Объект.Дата, Объект.СписаниеТоваров);
	Элементы.КомандаСоздатьСписаниеТоваров.Видимость = Не ЗначениеЗаполнено(Объект.СписаниеТоваров);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПечатьДокументовКлиент.УстановитьЗаголовокПечатнойФормы(ЭтаФорма);
	
	Если Истина // ИспользоватьПодключаемоеОборудование Проверка на включенную ФО "Использовать ВО"
	   И МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда // Проверка на определенность рабочего места ВО.
		ОписаниеОшибки = "";
		
		ПоддерживаемыеТипыВО = Новый Массив();
		ПоддерживаемыеТипыВО.Добавить("СканерШтрихкода");
		
		ОповещенияПриПодключении = Новый ОписаниеОповещения("ПодключитьОборудованиеЗавершение", ЭтотОбъект);    
		МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(ОповещенияПриПодключении, УникальныйИдентификатор, ПоддерживаемыеТипыВО);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	// МеханизмВнешнегоОборудования
	ПоддерживаемыеТипыВО = Новый Массив();
	ПоддерживаемыеТипыВО.Добавить("СканерШтрихкода");
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПоТипу(Неопределено, УникальныйИдентификатор, ПоддерживаемыеТипыВО);
	// Конец МеханизмВнешнегоОборудования

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ДействияСтационара.Количество() = 0 Тогда 
		Предупреждение("Табличная часть документа пуста! Запись невозможна");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	РаботаСФормамиСервер.ВывестиЗаголовокФормыДокумента(ТекущийОбъект,,ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ScanData" Тогда
		Если ВводДоступен() Тогда
			ТипШК = Неопределено;
			РаботаСТорговымОборудованиемКлиент.ОбработатьСобытиеСШКФормы(ЭтотОбъект, Параметр, ТипШК);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОборудованиеЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр( "ru = 'При подключении оборудования произошла ошибка:
				|""%ОписаниеОшибки%"".'" );
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%" , РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#Область ОбработчикиДинамическиСоздаваемыхКоманд

&НаКлиенте
Процедура Подключаемый_КнопкаФилиалПриНажатии(Команда)
	РаботаСДиалогамиКлиент.ДиалогКнопкаФилиалПриНажатии(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВывестиДвиженияДокумента(Команда)
	РаботаСДиалогамиКлиент.ВывестиДвиженияДокумента(Объект.Ссылка, Команда);
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура КомандаСоздатьСписаниеТоваров(Команда)
	
	Если РаботаСДиалогамиКлиент.ПроверитьМодифицированностьВФорме(ЭтаФорма, Истина) Тогда
		Если Не ЗначениеЗаполнено(Объект.СписаниеТоваров) Тогда
			РезультатСоздания = СоздатьДокументСписания(Объект.Ссылка);
			Если ТипЗнч(РезультатСоздания) = Тип("Строка") Тогда
				ПоказатьПредупреждение(, РезультатСоздания, 60);
			Иначе
				Объект.СписаниеТоваров = РезультатСоздания;
				Если ЗначениеЗаполнено(Объект.СписаниеТоваров) Тогда
					Элементы.КомандаСоздатьСписаниеТоваров.Видимость = Ложь;
					ЭтаФорма.Записать();
					ОткрытьФорму("Документ.СписаниеТоваров.ФормаОбъекта", Новый Структура("Ключ", Объект.СписаниеТоваров));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Элементы.ГруппаСписаниеТоваров.Видимость = РассчитатьВидимостьСписанияТоваров(Объект.Дата, Объект.СписаниеТоваров);
	Элементы.КомандаСоздатьСписаниеТоваров.Видимость = Не ЗначениеЗаполнено(Объект.СписаниеТоваров);
	
КонецПроцедуры

// Обработка изменения реквизитов документа.
// Параметры
//  Имя			– Строка			– Имя реквизита документа с полным путем (например Тавары.Номенклатура).
//  ЭтаФорма	– Форма				– Ссылка на форму документа. 
// 									  Если значение неопределено, производится программная обработка реквизитов.
//  ТекСтрока	– СтрокаТабличнойЧасти – Ссылка на строку табличной части документа, реквизит которой обрабатывается.
// 										 Имеет смысл только для табличных частей документов.
//  ДопПараметры– Стркутура			– Структура, содержащая дополнительные параметры обработки реквизита.
// Возвращаемое значение:
//   Булево   – Результат выполнения обработки.
&НаКлиенте
Функция ОбработкаРеквизитаУпр(Имя,ТекСтрока=Неопределено,ЭтаФорма=Неопределено,ДопПараметры=Неопределено)
	
	// ОБРАБОТКА РЕКВИЗИТОВ ДОКУМЕНТА
	Если Имя = "Перерасход.Номенклатура" Тогда 
		
		Рез=РаботаСДокументамиКлиент.дкОбработкаРеквизитаКлиент(Объект,"Товары.Номенклатура",ТекСтрока,ЭтаФорма,ДопПараметры);
		ТекСтрока.Коэффициент = ДопСерверныеФункции.ПолучитьРеквизит(ТекСтрока.ЕдиницаИзмерения, "Коэффициент");
		
	ИначеЕсли Имя = "ДействияСтационара.Номенклатура" Тогда
		
		Если ТипЗнч(ТекСтрока.ДействиеСтационара) = Тип("СправочникСсылка.Номенклатура") Тогда
			ДанныеСтроки = Новый Структура("НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, Количество, Коэффициент");
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, ТекСтрока);
			ДанныеСтроки.Номенклатура = ТекСтрока.ДействиеСтационара;
			
			Рез=РаботаСДокументамиКлиент.дкОбработкаРеквизитаКлиент(Объект,"Товары.Номенклатура",ДанныеСтроки,ЭтаФорма,ДопПараметры);
			ЗаполнитьЗначенияСвойств(ТекСтрока, ДанныеСтроки);
			
			ТекСтрока.Коэффициент = ДопСерверныеФункции.ПолучитьРеквизит(ТекСтрока.ЕдиницаИзмерения, "Коэффициент");
		КонецЕсли;
		
	ИначеЕсли Имя = "Перерасход.ЕдиницаИзмерения" Или Имя = "ДействияСтационара.ЕдиницаИзмерения" Тогда
		
		ТекСтрока.Коэффициент = ДопСерверныеФункции.ПолучитьРеквизит(ТекСтрока.ЕдиницаИзмерения, "Коэффициент");
		
	Иначе 
		Возврат РаботаСДокументамиКлиент.дкОбработкаРеквизитаКлиент(Объект,Имя,ТекСтрока,ЭтаФорма,ДопПараметры);
	КонецЕсли;
	
КонецФункции // ОбработкаРеквизита()

&НаКлиенте
Процедура ДействияСтационараПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекущиеДанные.ИдентификаторЭлемента = Новый УникальныйИдентификатор;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияСтационараВидДействияПриИзменении(Элемент)
	
	ПривестиТипДанныхДействияСтационараКВидуДействия();
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияСтационараДействиеСтационараПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДействияСтационара.ТекущиеДанные;
	
	ОбработкаРеквизитаУпр("ДействияСтационара.Номенклатура", ТекущиеДанные);
	
	// Автоопределение вида действия стационара, если не заполнено при выборе самого действия
	Если ЗначениеЗаполнено(ТекущиеДанные.ДействиеСтационара) Тогда
		Если ТипЗнч(ТекущиеДанные.ДействиеСтационара) = Тип("СправочникСсылка.ДействияМедсестрыСтационара") Тогда
			ТекущиеДанные.ВидыДействийСтационара = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Манипуляции");
			
		ИначеЕсли ТипЗнч(ТекущиеДанные.ДействиеСтационара) = Тип("СправочникСсылка.Номенклатура") Тогда
			
			ВидНоменклатуры = ДопСерверныеФункции.ПолучитьРеквизит(ТекущиеДанные.ДействиеСтационара, "ВидНоменклатуры");
			Если ВидНоменклатуры = ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Материал") Тогда 
				ТекущиеДанные.ВидыДействийСтационара = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Медикаменты");
			ИначеЕсли ВидНоменклатуры = ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Услуга") Тогда 
				ТекущиеДанные.ВидыДействийСтационара = ПредопределенноеЗначение("Перечисление.ВидыДействийСтационара.Процедуры");
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТекущиеДанные.ВидыДействийСтационара = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияСтационараДействиеСтационараНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	УстановитьПараметрыВыбораДействияСтационара();
	
КонецПроцедуры


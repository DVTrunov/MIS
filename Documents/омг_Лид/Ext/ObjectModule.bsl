Перем СтарыйСтатус;

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.омг_СтатусыЛидов.Новый;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НаправлениеТрафика) Тогда
		НаправлениеТрафика = Перечисления.омг_НаправленияТрафика.Входящий;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.омг_СтатусыЛидов.Новый;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НаправлениеТрафика) Тогда
		НаправлениеТрафика = Перечисления.омг_НаправленияТрафика.Входящий;
	КонецЕсли;
	
	Телефон = омг_ЛидыСервер.НормализоватьТелефон(Телефон);
	
	Если Не ЗначениеЗаполнено(Клиент) И ЗначениеЗаполнено(Телефон) Тогда
		Клиент = омг_ЛидыСервер.НайтиКлиентаПоТелефону(Телефон);
	КонецЕсли;
	
	Если омг_ЛидыСервер.ЭтоЗавершающийСтатус(Статус) Тогда
		Если Не ЗначениеЗаполнено(ДатаЗавершения) Тогда
			ДатаЗавершения = ТекущаяДатаСеанса();
		КонецЕсли;
	Иначе
		ДатаЗавершения = '00010101';
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		СтарыйСтатус = Неопределено;
	Иначе
		СтарыйСтатус = Ссылка.Статус;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если СтарыйСтатус <> Статус Тогда
		КомментарийИстории = "";
		ДополнительныеСвойства.Свойство("КомментарийИстории", КомментарийИстории);
		омг_ЛидыСервер.ЗаписатьИсториюСтатуса(Ссылка, Статус, ПричинаОтказа, КомментарийИстории);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Статус = Перечисления.омг_СтатусыЛидов.Новый;
	Ответственный = Справочники.Пользователи.ПустаяСсылка();
	ДатаВзятияВРаботу = '00010101';
	ДатаПервогоЗвонка = '00010101';
	ДатаЗавершения = '00010101';
	ПерезвонитьВ = '00010101';
	КоличествоПопыток = 0;
	ПричинаОтказа = Справочники.омг_ПричиныОтказаЛидов.ПустаяСсылка();
	Заявка = Документы.Заявка.ПустаяСсылка();
	ОказаниеУслуг = Документы.ОказаниеУслуг.ПустаяСсылка();
	ВнешнийИдентификатор = "";
	ИсходныеДанные = "";
	
КонецПроцедуры

#КонецОбласти

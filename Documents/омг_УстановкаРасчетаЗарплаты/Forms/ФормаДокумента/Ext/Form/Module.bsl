
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() И Не ЗначениеЗаполнено(Объект.Автор) Тогда
		Объект.Автор = Пользователи.ТекущийПользователь();
	КонецЕсли;

	Если Не омг_РасчетЗаработнойПлатыСервер.ЭтоУпрощенныйРасчетЗарплаты(ТекущаяДатаСеанса()) Тогда
		Элементы.ДекорацияРежимНеУпрощенный.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПроценты

&НаКлиенте
Процедура ПроцентыСотрудникПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Проценты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Сотрудник) Тогда
		Возврат;
	КонецЕсли;

	ДолжностьСотрудника = ДолжностьСотрудника(ТекущиеДанные.Сотрудник);
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Должность) Тогда
		ТекущиеДанные.Должность = ДолжностьСотрудника;
	ИначеЕсли ТекущиеДанные.Должность <> ДолжностьСотрудника Тогда
		ПоказатьПредупреждение(, СтрШаблон("У сотрудника в карточке указана должность ""%1"". Процент сработает только при совпадении должностей.",
			ДолжностьСотрудника));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоГруппе(Команда)

	Если Не ПроверитьТекущуюСтроку() Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ДобавитьСтрокуПослеВыбора", ЭтотОбъект);
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыбораГруппыУпр",, ЭтотОбъект,,,, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоТипу(Команда)

	Если Не ПроверитьТекущуюСтроку() Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ДобавитьСтрокуПослеВыбора", ЭтотОбъект);
	ОткрытьФорму("Справочник.омг_ТипыУслуг.ФормаВыбора",, ЭтотОбъект,,,, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПроцент(Команда)

	Если Элементы.Проценты.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите строки, для которых нужно установить процент.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("УстановитьПроцентЗавершение", ЭтотОбъект);
	ПоказатьВводЧисла(Оповещение, 0, "Процент для выделенных строк", 5, 2);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПроцентЗавершение(Процент, ДополнительныеПараметры) Экспорт

	Если Процент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Идентификатор Из Элементы.Проценты.ВыделенныеСтроки Цикл
		Объект.Проценты.НайтиПоИдентификатору(Идентификатор).Процент = Процент;
	КонецЦикла;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьАссистирование(Команда)

	ВыделенныеСтроки = Элементы.Проценты.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Если хотя бы одна выделенная строка не отмечена - отмечаем все, иначе снимаем отметку со всех.
	НовоеЗначение = Ложь;
	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		Если Не Объект.Проценты.НайтиПоИдентификатору(Идентификатор).Ассистирование Тогда
			НовоеЗначение = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		Объект.Проценты.НайтиПоИдентификатору(Идентификатор).Ассистирование = НовоеЗначение;
	КонецЦикла;
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПроверитьТекущуюСтроку()

	ТекущиеДанные = Элементы.Проценты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Должность) Тогда
		ПоказатьПредупреждение(, "Встаньте на строку с заполненной должностью (и сотрудником, если настройка индивидуальная). Новая строка получит ту же должность и сотрудника.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ДобавитьСтрокуПослеВыбора(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.Проценты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		НоваяСтрока = ТекущиеДанные;
	Иначе
		НоваяСтрока = Объект.Проценты.Добавить();
		НоваяСтрока.Должность      = ТекущиеДанные.Должность;
		НоваяСтрока.Сотрудник      = ТекущиеДанные.Сотрудник;
		НоваяСтрока.Ассистирование = ТекущиеДанные.Ассистирование;
		НоваяСтрока.Процент        = ТекущиеДанные.Процент;
	КонецЕсли;
	НоваяСтрока.Номенклатура = ВыбранноеЗначение;

	Элементы.Проценты.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	Модифицированность = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДолжностьСотрудника(Сотрудник)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Должность");

КонецФункции

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Автор = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Автор = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Одна и та же связка "Должность - Сотрудник - Номенклатура - Ассистирование" не должна повторяться.
	КлючиСтрок = Новый Соответствие;
	Для Каждого СтрокаТЧ Из Проценты Цикл

		Ключ = Строка(СтрокаТЧ.Должность.УникальныйИдентификатор()) + "|"
			+ ?(ЗначениеЗаполнено(СтрокаТЧ.Сотрудник), Строка(СтрокаТЧ.Сотрудник.УникальныйИдентификатор()), "") + "|"
			+ ?(ЗначениеЗаполнено(СтрокаТЧ.Номенклатура), Строка(СтрокаТЧ.Номенклатура.УникальныйИдентификатор()), "") + "|"
			+ Формат(СтрокаТЧ.Ассистирование, "БЛ=0; БИ=1");

		ПерваяСтрока = КлючиСтрок.Получить(Ключ);
		Если ПерваяСтрока <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Строка %1 повторяет строку %2 (должность, сотрудник, номенклатура и признак ассистирования совпадают).",
					СтрокаТЧ.НомерСтроки, ПерваяСтрока),
				ЭтотОбъект, "Проценты[" + Формат(СтрокаТЧ.НомерСтроки - 1, "ЧГ=0") + "].Номенклатура", , Отказ);
		Иначе
			КлючиСтрок.Вставить(Ключ, СтрокаТЧ.НомерСтроки);
		КонецЕсли;

		// Индивидуальная настройка не сработает, если в карточке сотрудника другая должность.
		Если ЗначениеЗаполнено(СтрокаТЧ.Сотрудник)
			И ЗначениеЗаполнено(СтрокаТЧ.Должность)
			И СтрокаТЧ.Сотрудник.Должность <> СтрокаТЧ.Должность Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Строка %1: у сотрудника %2 в карточке указана должность ""%3"", а в строке ""%4"". Пока должности не совпадают, процент применяться не будет.",
					СтрокаТЧ.НомерСтроки, СтрокаТЧ.Сотрудник, СтрокаТЧ.Сотрудник.Должность, СтрокаТЧ.Должность),
				ЭтотОбъект, "Проценты[" + Формат(СтрокаТЧ.НомерСтроки - 1, "ЧГ=0") + "].Сотрудник");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.омг_ПроцентыРасчетаЗарплаты.Записывать = Истина;

	Для Каждого СтрокаТЧ Из Проценты Цикл

		Движение = Движения.омг_ПроцентыРасчетаЗарплаты.Добавить();
		Движение.Период         = Дата;
		Движение.Организация    = Организация;
		Движение.Филиал         = Филиал;
		Движение.Должность      = СтрокаТЧ.Должность;
		Движение.Сотрудник      = СтрокаТЧ.Сотрудник;
		Движение.Номенклатура   = СтрокаТЧ.Номенклатура;
		Движение.Ассистирование = СтрокаТЧ.Ассистирование;
		Движение.Процент        = СтрокаТЧ.Процент;

	КонецЦикла;

КонецПроцедуры

#КонецЕсли

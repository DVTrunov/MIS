&НаСервере
Процедура УстановитьВидимостьРЭМД(ПриСоздании = Ложь, ПересчитатьЕдиницыПоКлассификатору = Ложь)
	
	// ЭЦП
	ИспользуютсяЭП = ЭЦП_УМЦ_Сервер.ИспользоватьЭлектронныеПодписиЭМК();
	Если ИспользуютсяЭП И Не Объект.Ссылка.Пустая() Тогда
		Если Объект.ПодписанЭП Тогда
			ОбновитьСписокПодписей();
		Иначе
			доп_СертификатыЭЦП.ЗаполнитьСводкуПодписей(Объект.Ссылка, СводкаHTML, ЭлектронныеПодписи);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьДоступностьВидимостьПоЭП();
	
	// РЭМД
	ИспользуетсяРЭМД = ИнтеграцияЕГИСЗСерверПовтИсп.ИспользуетсяИнтеграцияРЭМД();
	
	ВидРЭМДПоФормеРецепта = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ВидРЭМДРецепта(Объект.ФормаРецепта);
	
	ДокументДоРЭМД = Объект.Дата < ИнтеграцияЕГИСЗСерверПовтИсп.ПолучитьДатуНачалаОбменаИнформациейСРЭМД(Объект.Филиал);
	
	// Выводим группу ЭП только для тех форм рецептов у которых существует вид РЭМД
	ВыводитьГруппуЭП = ИспользуютсяЭП И ИспользуетсяРЭМД И Не ДокументДоРЭМД И ВидРЭМДПоФормеРецепта <> Неопределено;
	РаботаСФормамиКлиентСервер.УстановитьВидимостьЭлементаФормы(Элементы, "ЭП", ВыводитьГруппуЭП);
	
	Элементы.ЕдИзмПоКлассификатору1.Видимость = ВыводитьГруппуЭП;
	Элементы.ЕдИзмПоКлассификатору2.Видимость = ВыводитьГруппуЭП;
	Элементы.ЕдИзмПоКлассификатору3.Видимость = ВыводитьГруппуЭП;
	
	Если ПриСоздании Тогда
		ПараметрыВыбораПоТипуЛьгот = Новый Массив;
		ПараметрыВыбораПоТипуЛьгот.Добавить(Новый ПараметрВыбора("Отбор.ВидКлассификатора", ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовМинЗдрава.ЕдиницыИзмерения")));
		
		Элементы.ЕдИзмПоКлассификатору1.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораПоТипуЛьгот);
		Элементы.ЕдИзмПоКлассификатору2.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораПоТипуЛьгот);
		Элементы.ЕдИзмПоКлассификатору3.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораПоТипуЛьгот);
	КонецЕсли;
	
	Если ПересчитатьЕдиницыПоКлассификатору Тогда
		Для Индекс = 1 По 3 Цикл
			Если Не ЗначениеЗаполнено(Объект["ЕдИзмПоКлассификатору" + Строка(Индекс)]) Тогда
				Объект["ЕдИзмПоКлассификатору" + Строка(Индекс)] = ПолучитьЕдиницуИзмеренияПоКлассификатору(Объект["ЕдиницаИзмерения" + Строка(Индекс)]);
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


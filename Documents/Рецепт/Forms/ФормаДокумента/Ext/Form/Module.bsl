&НаСервере
Процедура омг_ОтправитьРецептНаСервере(Записывать = Истина)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) и Записывать или ЭтаФорма.Модифицированность и Записывать Тогда
	Попытка
		Записать()
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Перед отправкой необходимо записать документ!";
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	СоединениеHTTP = Новый HTTPСоединение("1c.ubtech.pro",443,"httpSalesOrder","Le6c^Yo)6by",,,Новый ЗащищенноеСоединениеOpenSSL(),);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Рецепт.омг_Аптека.ключ КАК store,
	|	Рецепт.Клиент.ИНН КАК comment
	|ИЗ
	|	Документ.Рецепт КАК Рецепт
	|ГДЕ
	|	Рецепт.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Рецептомг_Препараты.Номенклатура.ключ КАК Номенклатураключ,
	|	Рецептомг_Препараты.Количество КАК Количество
	|ИЗ
	|	Документ.Рецепт.омг_Препараты КАК Рецептомг_Препараты
	|ГДЕ
	|	Рецептомг_Препараты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаОсновная = РезультатЗапроса[0].Выбрать(); 
	ВыборкаОсновная.Следующий();
	ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
	
	ДанныеРецепта = Новый Структура;
	
	Если ЗначениеЗаполнено(Объект.омг_ключ) Тогда
		
		ДанныеРецепта.Вставить("order",Объект.омг_ключ);
		
	КонецЕсли;  
	
	ДанныеРецепта.Вставить("store",ВыборкаОсновная.store);
	ДанныеРецепта.Вставить("comment",ВыборкаОсновная.comment);
	
	goods = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Стрgoods = Новый Структура;
		Стрgoods.Вставить("id",ВыборкаДетальныеЗаписи.Номенклатураключ);
		Стрgoods.Вставить("qnt",ВыборкаДетальныеЗаписи.Количество);
		goods.Добавить(Стрgoods);
	КонецЦикла;	 
	
	ДанныеРецепта.Вставить("goods",goods);
	
	//сериализуем в json
	ЗаписьJSON = Новый ЗаписьJSON;               
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеРецепта);
	СтрокаДляТела = ЗаписьJSON.Закрыть();
	// Отправка
	
	//заголовок создадим в виде соответствия
	ЗаголовокЗапросаHTTP = Новый Соответствие();
	//передаем в заголовках размер и тип данных на отправку
	ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
	//создадим заголовок запроса
	ЗапросHTTP = Новый HTTPЗапрос("/prod-atk-meditec/hs/so/order", ЗаголовокЗапросаHTTP);
	//загрузить строку в тело
	ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаДляТела);
	//отсылаем POST-запрос на обработку.
	Если ЗначениеЗаполнено(Объект.омг_ключ) Тогда
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод("PUT", ЗапросHTTP);
	Иначе
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
	КонецЕсли;
	
	Если ОтветHTTP.КодСостояния = 200 Тогда
		
		Сообщение = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Сообщение);
		ДанныеРецепта = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть(); 

		Если не ЗначениеЗаполнено(Объект.омг_ключ) Тогда			
			Объект.омг_ключ = ДанныеРецепта.order_id;
			Объект.омг_РецептОтправлен = Истина;
			Объект.омг_Статус = Перечисления.омг_СтатусыРецептов.НеСогласован;
			Записывать = Истина;
		иначе  
			Элементы.Формаомг_ОтправитьРецепт.Доступность = Истина;
			Если ДанныеРецепта.status = "НеСогласован" Тогда
				Если не Объект.омг_Статус = Перечисления.омг_СтатусыРецептов.НеСогласован Тогда
				Объект.омг_Статус = Перечисления.омг_СтатусыРецептов.НеСогласован;
				КонецЕсли;
			ИначеЕсли ДанныеРецепта.status = "Согласован" Тогда
				Если не Объект.омг_Статус = Перечисления.омг_СтатусыРецептов.Согласован Тогда
				Объект.омг_Статус = Перечисления.омг_СтатусыРецептов.Согласован;
				КонецЕсли;
				Элементы.Формаомг_ОтправитьРецепт.Доступность = Ложь;
			ИначеЕсли ДанныеРецепта.status = "Закрыт" Тогда
				Если не Объект.омг_Статус = Перечисления.омг_СтатусыРецептов.Закрыт Тогда
				Объект.омг_Статус = Перечисления.омг_СтатусыРецептов.Закрыт;
				КонецЕсли;
				Элементы.Формаомг_ОтправитьРецепт.Доступность = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		Попытка  
			Если Записывать Тогда
			Записать();
			КонецЕсли;
			ЭтотОбъект.Прочитать();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Рецепт успешно отправлен!";
			Сообщение.Сообщить();
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Рецепт отправлен, но не записан. Необходимо записать вручную!";
			Сообщение.Сообщить();
		КонецПопытки;
	иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось отправить рецепт! Код: " + ОтветHTTP.КодСостояния;
		Сообщение.Сообщить();	
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);	 
	
КонецПроцедуры    


&НаКлиенте
Процедура омг_ОбновитьСтатусРецпета(Команда) 
	
		Статус = омг_РаботаСАптекамиСервер.омг_ОбновитьСтатусРецептаНаСервере(Объект.омг_ключ,Объект.Ссылка); 
		Если Статус = "НеСогласован" Тогда
			Если не Объект.омг_Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыРецептов.НеСогласован") Тогда
				Объект.омг_Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыРецептов.НеСогласован");
			КонецЕсли;
		ИначеЕсли Статус = "Согласован" Тогда
			Если не Объект.омг_Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыРецептов.Согласован") Тогда
				Объект.омг_Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыРецептов.Согласован");
			КонецЕсли;
			Элементы.Формаомг_ОтправитьРецепт.Доступность = Ложь;
		ИначеЕсли Статус = "Закрыт" Тогда
			Если не Объект.омг_Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыРецептов.Закрыт") Тогда
				Объект.омг_Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыРецептов.Закрыт");
			КонецЕсли;
			Элементы.Формаомг_ОтправитьРецепт.Доступность = Ложь;
		КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЭтаФорма.Модифицированность и ЗначениеЗаполнено(Объект.омг_ключ) Тогда 
		омг_ОтправитьРецептНаСервере(Ложь)
	КонецЕсли;
		
КонецПроцедуры




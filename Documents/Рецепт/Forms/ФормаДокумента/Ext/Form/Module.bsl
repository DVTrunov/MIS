&НаКлиенте
Процедура ОстаткиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтрПоиска = Новый Структура("Номенклатура",Элемент.ТекущиеДанные.Номенклатура);
    НайдСтроки = Объект.омг_Препараты.НайтиСтроки(СтрПоиска); 
	Если НайдСтроки.Количество() > 0 Тогда
		
	ТекСТрока = НайдСтроки[0];	
	СтрПередачи = Новый Структура;  
	СтрПередачи.Вставить("Номенклатура",ТекСТрока.Номенклатура); 
	СтрПередачи.Вставить("Количество",ТекСТрока.Количество+1);
	СтрПередачи.Вставить("ЕдиницаИзмерения",ТекСТрока.ЕдиницаИзмерения);
	СтрПередачи.Вставить("СпособПрименения",ТекСТрока.СпособПрименения);
	СтрПередачи.Вставить("РазВдень",ТекСТрока.РазВдень);
	СтрПередачи.Вставить("СколькоДней",ТекСТрока.СколькоДней);
	СтрПередачи.Вставить("Дозировка",ТекСТрока.Дозировка);
	СтрПередачи.Вставить("Дополнение",ТекСТрока.Дополнение); 	
	СтрПередачи.Вставить("ТекСтрока",ТекСТрока.НомерСтроки); 
	
	иначе
 	
	СтрПередачи = Новый Структура;  
	СтрПередачи.Вставить("Номенклатура",Элемент.ТекущиеДанные.Номенклатура); 
	СтрПередачи.Вставить("Количество",1);
	СтрПередачи.Вставить("ЕдиницаИзмерения",Элемент.ТекущиеДанные.омг_ЕдиницаХраненияАптеки);
	СтрПередачи.Вставить("СпособПрименения","");
	СтрПередачи.Вставить("РазВдень",0);
	СтрПередачи.Вставить("СколькоДней",0);
	СтрПередачи.Вставить("Дозировка","");
	СтрПередачи.Вставить("Дополнение","");	
			
	КонецЕсли;	  
	СтрПередачи.Вставить("ЭтоПодбор",Истина);
	Оповещение = Новый ОписаниеОповещения("омг_ОбработкаВыбораРедактирование",ЭтаФорма);
	ОткрытьФорму("Документ.Рецепт.Форма.омг_ФормаВводаНоменклатуры",СтрПередачи,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);


Функция ПечатьПротоколВКК(СсылкаНаОбъект)
	
	Перем Выборка;
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	
	Макет = ПолучитьМакет("ПротоколВКК");
	
	РеквизитыОрганизации = ПроцедурыСпециализацииПоставки.ПолучитьРеквизитыОрганизации(СсылкаНаОбъект);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.Номер = ОбщегоНазначения.ПолучитьНомерНаПечать(СсылкаНаОбъект);
	ОбластьМакета.Параметры.Дата = Формат(СсылкаНаОбъект.Дата, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.ДанныеОрганизацииНаименование = РеквизитыОрганизации.НазваниеОрганизации;
	ОбластьМакета.Параметры.ДанныеОрганизацииАдрес = РеквизитыОрганизации.Адрес;
	ОбластьМакета.Параметры.ДанныеОрганизацииОГРН = РеквизитыОрганизации.ОГРН;
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ДанныеПациента");
	ОбластьМакета.Параметры.ФИОПациента = СсылкаНаОбъект.Клиент;
	ОбластьМакета.Параметры.ДатаРождения = Формат(СсылкаНаОбъект.Клиент.ДатаРождения, "ДФ=dd.MM.yyyy");
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Повестка");
	ОбластьМакета.Параметры.Цель = НРег(СсылкаНаОбъект.Цель.НаименованиеПолное);
	ТабДок.Вывести(ОбластьМакета);
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект.РассмотренныеВопросы) Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("РассмотренныеВопросы");
		ОбластьМакета.Параметры.РассмотренныеВопросы = СсылкаНаОбъект.РассмотренныеВопросы;
		ТабДок.Вывести(ОбластьМакета);
	КонецЕсли; 
	
	// Лист нетрудоспособности
	ОснованиеДокумента = СсылкаНаОбъект.Основание;
	Если ЗначениеЗаполнено(ОснованиеДокумента)
		И ТипЗнч(ОснованиеДокумента) = Тип("ДокументСсылка.ЛистокНетрудоспособности")
	Тогда
		Если ЗначениеЗаполнено(ОснованиеДокумента.Номер) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ЛННомер");
			ОбластьМакета.Параметры.НомерЛисткаНетрудоспособности = ОснованиеДокумента.Номер;
			ТабДок.Вывести(ОбластьМакета);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СсылкаНаОбъект.ДатаНачалаНетрудоспособности)
			И ЗначениеЗаполнено(СсылкаНаОбъект.ДатаОкончанияНетрудоспособности)
		Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ЛНПериод");
			ОбластьМакета.Параметры.ДатаНачало		= Формат(СсылкаНаОбъект.ДатаНачалаНетрудоспособности,	 "ДФ=dd.MM.yyyy");
			ОбластьМакета.Параметры.ДатаОкончание	= Формат(СсылкаНаОбъект.ДатаОкончанияНетрудоспособности, "ДФ=dd.MM.yyyy");
			ОбластьМакета.Параметры.ВсегоДней		= 1 + (НачалоДня(СсылкаНаОбъект.ДатаОкончанияНетрудоспособности) - НачалоДня(СсылкаНаОбъект.ДатаНачалаНетрудоспособности)) / 86400;
		КонецЕсли;
		ТабДок.Вывести(ОбластьМакета);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Жалобы) Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Жалобы");
		ОбластьМакета.Параметры.Жалобы = СсылкаНаОбъект.Жалобы;
		ТабДок.Вывести(ОбластьМакета);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Лечение) Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Лечение");
		ОбластьМакета.Параметры.Лечение = СсылкаНаОбъект.Лечение;
		ТабДок.Вывести(ОбластьМакета);
	КонецЕсли;
	
	ВывестиДиагнозыПротоколаВКК(СсылкаНаОбъект, ТабДок, Макет);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заключение");
	ОбластьМакета.Параметры.Заключение = СсылкаНаОбъект.Заключение;
	ТабДок.Вывести(ОбластьМакета);
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Рекомендации) Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Рекомендации");
		ОбластьМакета.Параметры.Рекомендации = СсылкаНаОбъект.Рекомендации;
		ТабДок.Вывести(ОбластьМакета);
	КонецЕсли;
	
	// ЭЦП
	ЭЦПСотрудников = Новый Соответствие;
	Если ЭЦП_УМЦ_Сервер.ИспользоватьЭлектронныеПодписиЭМК()
		И СсылкаНаОбъект.ПодписанЭП
	Тогда
		Выборка = доп_СертификатыЭЦП.ПолучитьЭлектронныеПодписи(СсылкаНаОбъект);
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.УстановившийПодпись.Сотрудник) Тогда
				ДанныеСертификата = ЭЦП_УМЦ_Сервер.ПолучитьДанныеСертификата(Выборка.Сертификат, СсылкаНаОбъект, Выборка.ДатаПодписи);
				ЭЦПСотрудников.Вставить(Выборка.УстановившийПодпись.Сотрудник, ДанныеСертификата);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("ПредседательКомиссии");
	ОбластьМакета.Параметры.ФИОПредседатель = ОбщегоНазначения.ФИОФизЛица(СсылкаНаОбъект.ПредседательКомиссии);
	ДобавитьШтампЭЦП(ЭЦПСотрудников, СсылкаНаОбъект.ПредседательКомиссии, "ЭЦППредседателя", ОбластьМакета, Макет);
	ТабДок.Вывести(ОбластьМакета);
	
	ПервыйСотрудник = Истина;
	Для Каждого СтрокаСотрудника Из СсылкаНаОбъект.СоставКомиссии Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("ЧленыКомиссии");
		ОбластьМакета.Параметры.ФИОСотрудник = ОбщегоНазначения.ФИОФизЛица(СтрокаСотрудника.Сотрудник);
		Если ПервыйСотрудник Тогда
			ПервыйСотрудник = Ложь;
		Иначе
			ОбластьЗаголовка = ОбластьМакета.Области.Найти("ЗаголовокЧленКомиссии");
			ОбластьЗаголовка.Текст = "";
		КонецЕсли;
		ДобавитьШтампЭЦП(ЭЦПСотрудников, СтрокаСотрудника.Сотрудник, "ЭЦПЧленаКомиссии", ОбластьМакета, Макет);
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Процедура ДобавитьШтампЭЦП(ЭЦПСотрудников, Сотрудник, ИмяОбластиПодписи, ОбластьМакета, Макет)
	
	ДанныеПодписи = ЭЦПСотрудников.Получить(Сотрудник);
	Если ДанныеПодписи <> Неопределено Тогда
		ОбластьЭЦП = Макет.ПолучитьОбласть("ЭЦП");
		ЗаполнитьЗначенияСвойств(ОбластьЭЦП.Параметры, ДанныеПодписи);
		ТабДокЭЦП = Новый ТабличныйДокумент;
		ТабДокЭЦП.Вывести(ОбластьЭЦП);
		ОбластьМакета.ВставитьОбласть(ТабДокЭЦП.Области["ЭЦП"], ОбластьМакета.Области[ИмяОбластиПодписи]);
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьПротоколВКК_ДляМедкарты(СсылкаНаОбъект)
	
	Перем Выборка;
	
	ТхтДок = Новый ТекстовыйДокумент;

	Макет = ПолучитьМакет("ПротоколВКК_ДляМедкарты");
	
	КодыЗначений = Новый Соответствие;
	
	Макет.УстановитьТекст(СтрЗаменить(Макет.ПолучитьТекст(),"<","&lt;"));
	Макет.УстановитьТекст(СтрЗаменить(Макет.ПолучитьТекст(),">","&gt;"));
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	
	УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(Область, "Дата", Формат(СсылкаНаОбъект.Дата, "ДФ=dd.MM.yyyy"), КодыЗначений);
	УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(Область, "Цель", НРег(СсылкаНаОбъект.Цель.НаименованиеПолное), КодыЗначений);
	ТхтДок.Вывести(Область); 	
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Жалобы) Тогда
		Область = Макет.ПолучитьОбласть("Жалобы");
		УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(Область, "Жалобы", СсылкаНаОбъект.Жалобы, КодыЗначений);
		ТхтДок.Вывести(Область); 	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Лечение) Тогда
		Область = Макет.ПолучитьОбласть("Лечение");
		УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(Область, "Лечение", СсылкаНаОбъект.Лечение, КодыЗначений);
		ТхтДок.Вывести(Область); 	
	КонецЕсли; 
	
	ВывестиДиагнозыПротоколаВКК(СсылкаНаОбъект, ТхтДок, Макет, КодыЗначений);
	
	Область = Макет.ПолучитьОбласть("Заключение");
	УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(Область, "Заключение", СсылкаНаОбъект.Заключение, КодыЗначений);
	ТхтДок.Вывести(Область); 
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Рекомендации) Тогда
		Область = Макет.ПолучитьОбласть("Рекомендации");
		УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(Область, "Рекомендации", СсылкаНаОбъект.Рекомендации, КодыЗначений);
		ТхтДок.Вывести(Область); 	
	КонецЕсли; 
	
	Область = Макет.ПолучитьОбласть("Подвал");
	УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(Область, "ФИОПредседатель", ОбщегоНазначения.ФИОФизЛица(СсылкаНаОбъект.ПредседательКомиссии), КодыЗначений);
	
	Если СсылкаНаОбъект.СоставКомиссии.Количество() <> 0 Тогда
		ЧленыКомиссии = "";
		Для Каждого СтрокаСотрудника Из СсылкаНаОбъект.СоставКомиссии Цикл
			ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ЧленыКомиссии, ОбщегоНазначения.ФИОФизЛица(СтрокаСотрудника.Сотрудник));
		КонецЦикла;
	КонецЕсли;
	УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(Область, "ФИОСотрудники", ЧленыКомиссии, КодыЗначений);
	ТхтДок.Вывести(Область);		
	
	Для Сч = 1 По 10 Цикл
		ТхтДок.УстановитьТекст(СтрЗаменить(ТхтДок.ПолучитьТекст(),"  "," "));
	КонецЦикла;
	
	УниверсальныеМеханизмыСервер.РаскодироватьПараметрыТХТМакетаHTML(ТхтДок, КодыЗначений);
	
	ТхтДок.УстановитьТекст(СтрЗаменить(ТхтДок.ПолучитьТекст(),"&lt;","<"));
	ТхтДок.УстановитьТекст(СтрЗаменить(ТхтДок.ПолучитьТекст(),"&gt;",">"));
	
	Возврат ТхтДок;
	
КонецФункции

Процедура ВывестиДиагнозыВидаВПечатнуюФорму(ДеревоДиагнозов, ВидДиагноза, Заголовок, ТабДок, ОбластьЗаголовокДиагноза, ОбластьДиагноз, КодыЗначений = Неопределено)
	
	ВетвьВидаДиагнозов = ДеревоДиагнозов.Строки.Найти(ВидДиагноза, "ВидНозологическойЕдиницы");
	Если ВетвьВидаДиагнозов <> Неопределено Тогда
		Если ТипЗнч(ТабДок) = Тип("ТабличныйДокумент") Тогда
			ОбластьЗаголовокДиагноза.Параметры.ЗаголовокДиагноз = Заголовок;
		Иначе
			УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(ОбластьЗаголовокДиагноза, "ЗаголовокДиагноз", Заголовок, КодыЗначений);
		КонецЕсли;
		ТабДок.Вывести(ОбластьЗаголовокДиагноза);
		
		Для Каждого СтрокаДиагноза Из ВетвьВидаДиагнозов.Строки Цикл
	
			ДиагнозТекст = "[" + Строка(СтрокаДиагноза.Диагноз.КодДиагноза) + "] "  + Строка(СтрокаДиагноза.Диагноз);
			Если ЗначениеЗаполнено(СтрокаДиагноза.Описание) Тогда
				ДиагнозТекст = ДиагнозТекст + ", " + СтрокаДиагноза.Описание;
			КонецЕсли; 
			Если ЗначениеЗаполнено(СтрокаДиагноза.СтепеньОбоснованности) Тогда
				ДиагнозТекст = ДиагнозТекст + " (" + Строка(СтрокаДиагноза.СтепеньОбоснованности) + ")";
			КонецЕсли;
			
			Если ТипЗнч(ТабДок) = Тип("ТабличныйДокумент") Тогда
				ОбластьДиагноз.Параметры.Диагноз = ДиагнозТекст;
			Иначе
				УниверсальныеМеханизмыСервер.УстановитьПараметрТХТМакета(ОбластьДиагноз, "Диагноз", ДиагнозТекст, КодыЗначений);
			КонецЕсли;
			ТабДок.Вывести(ОбластьДиагноз);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиДиагнозыПротоколаВКК(СсылкаНаОбъект, ТабДок, Макет, КодыЗначений = Неопределено)
	
	Если СсылкаНаОбъект.Диагнозы.Количество() <> 0 Тогда
		
		ОбластьЗаголовокДиагноза = Макет.ПолучитьОбласть("ДиагнозЗаголовок");
		ОбластьДиагноз = Макет.ПолучитьОбласть("Диагноз");
		
		ТаблицаДиагнозы = ?(ТипЗнч(СсылкаНаОбъект.Диагнозы) = Тип("ТаблицаЗначений"), СсылкаНаОбъект.Диагнозы.Скопировать(), СсылкаНаОбъект.Диагнозы.Выгрузить());
		
		ДеревоДиагнозов = ОбщегоНазначенияСервер.ТаблицуЗначенийВДеревоЗначений(ТаблицаДиагнозы, "ВидНозологическойЕдиницы");
		пчВидыДиагнозов = Перечисления.КлассификацииДиагнозов;
		
		ВидыНозологическихЕдиниц = Новый Соответствие;
		ВидыНозологическихЕдиниц.Вставить(пчВидыДиагнозов.ОсновноеЗаболевание,			  НСтр("ru='Основное заболевание:'"));
		ВидыНозологическихЕдиниц.Вставить(пчВидыДиагнозов.ОсложнениеОсновногоЗаболевания, НСтр("ru='Осложнения:'"));
		ВидыНозологическихЕдиниц.Вставить(пчВидыДиагнозов.СопутствующееЗаболевание,		  НСтр("ru='Сопутствующие заболевания:'"));
		ВидыНозологическихЕдиниц.Вставить(пчВидыДиагнозов.ВнешняяПричина,				  НСтр("ru='Внешняя причина при травмах (отравлениях):'"));
		Для Каждого КлючЗначение Из ВидыНозологическихЕдиниц Цикл
			ВывестиДиагнозыВидаВПечатнуюФорму(ДеревоДиагнозов, КлючЗначение.Ключ, КлючЗначение.Значение, ТабДок, ОбластьЗаголовокДиагноза, ОбластьДиагноз, КодыЗначений);	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
#Область ПрограммныйИнтерфейс

// Возвращает доступные варианты печати документа
// 
// Возвращаемое значение:
//   - Струткура - структура, каждая строка которой соответствует одному из вариантов печати.
//
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	СтруктураМакетов = Новый Структура;
	СтруктураМакетов.Вставить("Протокол", НСтр("ru='Протокол'"));
	
	Возврат СтруктураМакетов;

КонецФункции // ПолучитьСтруктуруПечатныхФорм()

// Процедура формирует печатную форму документа
// Название макета печати передается в качестве параметра,
// по переданному названию находим имя макета в соответствии.
//
// Параметры:
//  СсылкаНаОбъект	 - ДокументСсылка.ВрачебнаяКомиссия - Печатаемый документ.
//  ИмяМакета		 - Строка - Имя печатной формы
// 
// Возвращаемое значение:
//   - ТабличныйДокумент.
//
Функция Печать(СсылкаНаОбъект, ИмяМакета) Экспорт
	
	Перем ТабДок;
	
	// Получить экземпляр документа на печать
	Если ИмяМакета = "Протокол" Тогда
		ТабДок = ПечатьПротоколВКК(СсылкаНаОбъект);
	ИначеЕсли ИмяМакета = "ПротоколВКК_ДляМедкарты" Тогда
		ТабДок = ПечатьПротоколВКК_ДляМедкарты(СсылкаНаОбъект);
	КонецЕсли;
	
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьИменаКлючевыхРеквизитов() Экспорт
	
	// !ДанныеОбъекта - служебное имя реквизита, означающее, что процедура формирования строки значений полей полностью переопределена.
	// !ХешФайлов - служебное имя реквизита, формирует строку хеша файлов по объекту
	МассивИмен = Новый Массив;
	МассивИмен.Добавить("!ДанныеОбъекта");
	Возврат МассивИмен;

КонецФункции

Процедура ДополнитьТекстЗапросаДляПолученияПриемовЭМКПоВрачебнойКомиссии(Форма, ТекстЗапроса) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВК") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапросаВК =
		"  ОБЪЕДИНИТЬ ВСЕ
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВрачебнаяКомиссия.Ссылка КАК Ссылка,
		|	ВрачебнаяКомиссия.ПредседательКомиссии КАК ПредседательКомиссии,
		|	ВрачебнаяКомиссия.Дата КАК Дата,
		|	ВрачебнаяКомиссия.Представление КАК Представление,
		|	ЛОЖЬ,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВрачебнаяКомиссия.Основание) = ТИП(Документ.Прием)
		|			ТОГДА ВрачебнаяКомиссия.Основание.ПервичныйПрием
		|		ИНАЧЕ ВрачебнаяКомиссия.Ссылка
		|	КОНЕЦ КАК ПервичныйПрием
		|ИЗ
		|	Документ.ВрачебнаяКомиссия КАК ВрачебнаяКомиссия
		|ГДЕ
		|	ВрачебнаяКомиссия.Клиент = &Клиент
		|	И ВрачебнаяКомиссия.Проведен";
	
	Если ЗначениеЗаполнено(Форма.МедицинскаяКарта) Тогда
		ТекстЗапросаВК = ТекстЗапросаВК + "
		|	И ВрачебнаяКомиссия.МедицинскаяКарта = &Карта";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ДатаНачала) Тогда
		ТекстЗапросаВК = ТекстЗапросаВК + " И НачалоПериода(ВрачебнаяКомиссия.Дата,ДЕНЬ) >= &ДатаНач";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ДатаОкончания) Тогда
		ТекстЗапросаВК = ТекстЗапросаВК + " И НачалоПериода(ВрачебнаяКомиссия.Дата,ДЕНЬ) <= &ДатаКон";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.Врач) Тогда
		ТекстЗапросаВК = ТекстЗапросаВК + " И ВрачебнаяКомиссия.ПредседательКомиссии В ИЕРАРХИИ (&Врач)";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаВК;
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаДляРазделовЭМКПоВрачебнойКомиссии(НачалоТекстаЗапроса) Экспорт
	
	ПродолжениеТекстаЗапроса = 
		"ВЫБРАТЬ
		|	РазделыМедицинскихКарт.Порядок,
		|	РазделыМедицинскихКарт.Наименование,
		|	ВрачебнаяКомиссия.HTMLПредставление,
		|	НЕОПРЕДЕЛЕНО,
		|	РазделыМедицинскихКарт.Ссылка,
		|	ЛОЖЬ КАК ПечатаетсяБезПереходаНаНовуюСтраницу,
		|	НЕОПРЕДЕЛЕНО КАК ВидШаблона,
		|	ВрачебнаяКомиссия.Ссылка КАК Прием
		|ИЗ
		|	РазделыМедицинскихКарт КАК РазделыМедицинскихКарт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВрачебнаяКомиссия КАК ВрачебнаяКомиссия
		|		ПО (ВрачебнаяКомиссия.Проведен)
		|			И (ВрачебнаяКомиссия.МедицинскаяКарта = &МедицинскаяКарта)
		|			И (РазделыМедицинскихКарт.ВыводитьПротоколыВрачебныхКомиссий)
		|			И (РазделыМедицинскихКарт.ТипРаздела В (&ВидыРазделовДляВыводаШаблонов))
		|			И (ВрачебнаяКомиссия.Ссылка В (&ВыбранныеДокументы))";
	
	НачалоТекстаЗапроса = СтрШаблон("%1%2%2ОБЪЕДИНИТЬ ВСЕ%2%2%3", НачалоТекстаЗапроса, Символы.ПС, ПродолжениеТекстаЗапроса);
	
КонецПроцедуры

Функция РолиДляПодписания() Экспорт
	
	Роли = Новый Массив;
	Роли.Добавить(ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(14, "РолиПриПодписиМедДокументов"));
	Роли.Добавить(ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(16, "РолиПриПодписиМедДокументов"));
	Возврат Роли;
	
КонецФункции

Функция РольДоступнаТекущемуПользователю(СсылкаНаОбъект, Роль) Экспорт
	
	ТекущийСотрудник = ПараметрыСеанса.ТекущийПользователь.Сотрудник;
	
	Если Не ЗначениеЗаполнено(ТекущийСотрудник) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Роль = ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(14, "РолиПриПодписиМедДокументов") Тогда
		Возврат ТекущийСотрудник = СсылкаНаОбъект.ПредседательКомиссии;
	ИначеЕсли Роль = ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(16, "РолиПриПодписиМедДокументов") Тогда
		Возврат СсылкаНаОбъект.СоставКомиссии.НайтиСтроки(Новый Структура("Сотрудник", ТекущийСотрудник)).Количество() > 0;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция СохранитьЭМД(МедицинскийДокумент, ТекстОшибки, СохранитьЭМД) Экспорт
	
	ДанныеВК = Новый Соответствие;
	
	ДанныеВК.Вставить("Документ",						 МедицинскийДокумент.УникальныйИдентификатор());
	ДанныеВК.Вставить("Дата",							 НачалоДня(МедицинскийДокумент.Дата));
	ДанныеВК.Вставить("Клиент",							 МедицинскийДокумент.Клиент);
	ДанныеВК.Вставить("Цель",							 МедицинскийДокумент.Цель);
	ДанныеВК.Вставить("Заключение",						 МедицинскийДокумент.Заключение);
	ДанныеВК.Вставить("ДатаНачалаНетрудоспособности",	 МедицинскийДокумент.ДатаНачалаНетрудоспособности);
	ДанныеВК.Вставить("ДатаОкончанияНетрудоспособности", МедицинскийДокумент.ДатаОкончанияНетрудоспособности);
	ДанныеВК.Вставить("ПредседательКомиссии",			 МедицинскийДокумент.ПредседательКомиссии);
	ДанныеВК.Вставить("HTMLПредставление",				 МедицинскийДокумент.HTMLПредставление);
	ДанныеВК.Вставить("МедицинскаяКарта",				 МедицинскийДокумент.МедицинскаяКарта);
	ДанныеВК.Вставить("РассмотренныеВопросы",			 МедицинскийДокумент.РассмотренныеВопросы);
	ДанныеВК.Вставить("Рекомендации",					 МедицинскийДокумент.Рекомендации);
	ДанныеВК.Вставить("Жалобы",							 МедицинскийДокумент.Жалобы);
	ДанныеВК.Вставить("Лечение",						 МедицинскийДокумент.Лечение);
	
	СоставКомиссии = Новый Массив;
	Для Каждого СтрокаСоставаКомиссии Из МедицинскийДокумент.СоставКомиссии Цикл
		СоставКомиссии.Добавить(СтрокаСоставаКомиссии.Сотрудник);
	КонецЦикла;
	ДанныеВК.Вставить("СоставКомиссии", СоставКомиссии);
	
	Диагнозы = Новый Массив;
	Для Каждого СтрокаДиагноза Из МедицинскийДокумент.Диагнозы Цикл
		СтруктураДиагноза = Новый Структура;
		СтруктураДиагноза.Вставить("Диагноз",					СтрокаДиагноза.Диагноз);
		СтруктураДиагноза.Вставить("СтепеньОбоснованности",		СтрокаДиагноза.СтепеньОбоснованности);
		СтруктураДиагноза.Вставить("ВидНозологическойЕдиницы",	СтрокаДиагноза.ВидНозологическойЕдиницы);
		СтруктураДиагноза.Вставить("Описание",					СтрокаДиагноза.Описание);
		Диагнозы.Добавить(СтруктураДиагноза);
	КонецЦикла;
	ДанныеВК.Вставить("Диагнозы", Диагнозы);
	
	Поток = Новый ПотокВПамяти();
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьПоток(Поток,,, Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(ЗаписьJSON, ДанныеВК, , "ПреобразованиеJSON", ОбщегоНазначенияПереопределяемый);
	ЗаписьJSON.Закрыть();
	
	ДД = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
	Если СохранитьЭМД Тогда
		доп_РаботаСФайлами.ДобавитьФайлЭМД(МедицинскийДокумент, ДД, "json");
	КонецЕсли;
	
	Возврат Новый Структура("ДД, Расширение", ДД, "json");;
	
КонецФункции

Функция ПолучитьНеподписанныеДокументыДляОтчётаЭЦП(ПараметрыДанных, ДокументыРЭМД) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""Врачебные комиссии"" КАК ТипМедицинскогоДокумента,
		|	ВрачебнаяКомиссия.Ссылка КАК Ссылка,
		|	ВрачебнаяКомиссия.ДатаДокумента КАК ДатаДокумента,
		|	ЛОЖЬ КАК ПодписьРЭМД,
		|	ИСТИНА КАК ПодписьФайловЭМД
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ВрачебнаяКомиссия.Ссылка КАК Ссылка,
		|		ВрачебнаяКомиссия.Дата КАК ДатаДокумента,
		|		ЗНАЧЕНИЕ(Перечисление.РолиПодписей.ПредседательВрачебнойКомиссии) КАК Роль
		|	ИЗ
		|		Документ.ВрачебнаяКомиссия КАК ВрачебнаяКомиссия
		|	ГДЕ
		|		ВрачебнаяКомиссия.ПредседательКомиссии = &СотрудникДокумента
		|		И НЕ ВрачебнаяКомиссия.ПометкаУдаления
		|		И НЕ ВрачебнаяКомиссия.Тестовый
		|		И ВрачебнаяКомиссия.Проведен
		|		И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|				ИЛИ ВрачебнаяКомиссия.Дата МЕЖДУ &НачалоПериода И &КонецПериода)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ВрачебнаяКомиссия.Ссылка,
		|		ВрачебнаяКомиссия.Дата,
		|		ЗНАЧЕНИЕ(Перечисление.РолиПодписей.ЧленВрачебнойКомиссии)
		|	ИЗ
		|		Документ.ВрачебнаяКомиссия КАК ВрачебнаяКомиссия
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВрачебнаяКомиссия.СоставКомиссии КАК СоставВрачебнойКомиссии
		|			ПО (СоставВрачебнойКомиссии.Ссылка = ВрачебнаяКомиссия.Ссылка)
		|				И (СоставВрачебнойКомиссии.Сотрудник = &СотрудникДокумента)
		|				И (НЕ ВрачебнаяКомиссия.ПометкаУдаления)
		|				И (НЕ ВрачебнаяКомиссия.Тестовый)
		|				И (ВрачебнаяКомиссия.Проведен)
		|				И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|					ИЛИ ВрачебнаяКомиссия.Дата МЕЖДУ &НачалоПериода И &КонецПериода)) КАК ВрачебнаяКомиссия
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭлектронныеПодписи КАК ЭлектронныеПодписи
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РолиИПодписиЭМД КАК РолиИПодписиЭМД
		|			ПО (РолиИПодписиЭМД.УИД_ЭЦП = ЭлектронныеПодписи.УникальныйИдентификатор)
		|		ПО (ЭлектронныеПодписи.Объект = ВрачебнаяКомиссия.Ссылка)
		|			И (НЕ ЭлектронныеПодписи.ПодписанФайлЭМД)
		|			И (РолиИПодписиЭМД.РольПодписи = ВрачебнаяКомиссия.Роль)
		|ГДЕ
		|	ЭлектронныеПодписи.Объект ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыДанных.КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыДанных.НачалоПериода);
	Запрос.УстановитьПараметр("СотрудникДокумента", ПараметрыДанных.СотрудникДокумента);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


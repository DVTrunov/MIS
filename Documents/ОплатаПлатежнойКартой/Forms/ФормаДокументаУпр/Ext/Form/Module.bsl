	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура омг_ПринятьОплату(Команда) 
	
	ОписаниеОшибки = "";
	
	Если Объект.НомерЧекаККМ <> 0 Тогда
		//ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном регистраторе!'"); 
		ТекстСообщения = "";
		РаботаСДокументамиКлиент.ПредложитьПечатьКопииЧекаПоДокументу(Объект.Ссылка, УникальныйИдентификатор, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Модифицированность Тогда
		 ЭтаФорма.Записать();
	КонецЕсли; 

	Омг_Подтверждение(); 
	
КонецПроцедуры    

&НаКлиенте
Процедура Омг_Подтверждение()
	
	Если Объект.омг_ВидОплаты = ПредопределенноеЗначение("Перечисление.омг_ВидыОплаты.Предоплата") Тогда 
		ТекстВопроса = "ПРИНЯТЬ ПРЕДОПЛАТУ?";
		ТекстОплаты = "К предоплате ";
	иначе
		ТекстВопроса = "ПРИНЯТЬ ОПЛАТУ?";
		ТекстОплаты = "К оплате ";
	КонецЕсли;	
		
	Нал = Ложь;	
    ЭтоПродажа = Ложь; 

	ВидОплаты = "Безналичными";	

	ЭтоПродажа = Истина;
	
	Оповещение = Новый ОписаниеОповещения("Омг_ПослеЗакрытияВопроса",
	ЭтотОбъект,ВидОплаты);	
	ПоказатьВопрос(Оповещение,
	ТекстВопроса,
	РежимДиалогаВопрос.ДаНетОтмена,
	0, // таймаут в секундах
	КодВозвратаДиалога.Да, 
	ТекстОплаты + Объект.СуммаДокумента + " тг."+ Символы.ПС+
	//"ОПЛАЧЕНО: "+ Объект.СуммаДокумента +" тг."+Символы.ПС+
	ВидОплаты +" " + Объект.СуммаДокумента +" тг."+ Символы.ПС+
	"ИТОГО "+ Объект.СуммаДокумента+" тг." 
	);     

КонецПроцедуры    

&НаКлиенте
Процедура Омг_ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Если Объект.Ссылка.Пустая() Тогда
			
			// ИСПРАВЛЕНО: результат записи теперь проверяется - раньше при отказе
			// в записи (например, срабатывании проверки заполнения) код продолжал
			// работать дальше с Объект.Ссылка, которая могла остаться пустой
			Если Не Записать() Тогда
				ПоказатьПредупреждение(, "Не удалось записать документ.", 10);
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Объект.омг_ВидОплаты = ПредопределенноеЗначение("Перечисление.омг_ВидыОплаты.Предоплата") Тогда
			
			омг_Предоплата.омг_ПринятьПредоплату(Объект.Ссылка);
			ОбновитьПредоплату(); 
			Оповестить("ЗаявкаИзменена",Объект.ДокументОснование,Объект.Ссылка); 
			
		иначе
			
			ДанныеТерминалаИнтеграция = омг_WebKassa.омг_ПолучитьIPАдресТерминала(Объект.ЭквайринговыйТерминал);
			
			Если Объект.СуммаДокумента > 0 И Не ДанныеТерминалаИнтеграция.АдресТерминала = "" И ДанныеТерминалаИнтеграция.ИнтеграцияОплатаНаТерминал Тогда
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ДанныеТерминалаИнтеграция", ДанныеТерминалаИнтеграция); 
				ПараметрыФормы.Вставить("Сумма",              Объект.СуммаДокумента);
				ЭтоПродажа = Истина;
				ПараметрыФормы.Вставить("ВидОперации",  "Продажа");
				ПараметрыФормы.Вставить("НомерТранзакцииТерминала",      Объект.омг_НомерТранзакцииТерминала);
				
				Объект.омг_ИспользуемыйТерминал = ДанныеТерминалаИнтеграция.ИспользуемыйТерминал;
				Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("Документ", ЭтаФорма);
				ДополнительныеПараметры.Вставить("ПодключаемоеОборудование", ДанныеТерминалаИнтеграция.ПодключаемоеОборудование);
				ДополнительныеПараметры.Вставить("ВидОплаты", Параметры);
				
				ОбработчикОповещения = Новый ОписаниеОповещения("омг_ВыполнитьИзменениеСостоянияПослеОплаты", ЭтотОбъект, ДополнительныеПараметры);
				
				ОткрытьФорму("ОбщаяФорма.омг_ОжиданиеОтветаТерминала", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры         
&НаКлиенте
Процедура омг_ВыполнитьИзменениеСостоянияПослеОплаты(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено 
		И Не ВРЕГ(Результат) = "НЕТ" Тогда
		
		Если Не ВРЕГ(Результат) = "ДА" Тогда
			Объект.НомерЧекаЭТ         					= Результат;
			Объект.омг_НомерТранзакцииТерминала         = Результат;
		КонецЕсли;
		//Объект.СостояниеЧековККМ = ПредопределенноеЗначение("Перечисление.СостоянияЧековККМ.ЧекиПробиты");
		//Для Каждого СтрокаЧека Из Объект.Чеки Цикл
		//	СтрокаЧека.НомерЧека = 1;
		//	СтрокаЧека.ФискальноеУстройство = ДополнительныеПараметры.ПодключаемоеОборудование;
		//КонецЦикла;
		
				Попытка 
			Записать()
		Исключение  
			// ИСПРАВЛЕНО: логируем ошибку записи через серверную процедуру -
			// ЗаписьЖурналаРегистрации недоступна в клиентском контексте.
			// Раньше исключение проглатывалось молча, а печать чека все равно
			// запускалась на документ, состояние которого фактически не сохранено.
			ТекстОшибкиЗаписи = ОписаниеОшибки();
			омг_ЗафиксироватьОшибкуЗаписи("ОплатаПлатежнойКартой.омг_ВыполнитьИзменениеСостоянияПослеОплаты", ТекстОшибкиЗаписи);
			ПоказатьПредупреждение(, "Не удалось записать документ после оплаты на терминале: " + ТекстОшибкиЗаписи, 15);
			Возврат;
		КонецПопытки;
			
		Если  Не ВРЕГ(Результат) = "НЕТ" или Объект.НомерЧекаККМ = 0 Тогда
		НапечататьЧек(Истина); 
		КонецЕсли;  
	
	КонецЕсли;
	
КонецПроцедуры     

&НаКлиенте
Процедура НапечататьЧек(Пробить=Ложь)
	
	ОчиститьСообщения();
	
	ОписаниеОшибки = "";
	
	Если Объект.НомерЧекаККМ <> 0 Тогда
		ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном регистраторе!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);		
		Возврат;
	КонецЕсли;
			
	Если МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда 
			Контекст = Новый Структура(); 			
			ОписаниеОповещения   = Новый ОписаниеОповещения("ВыборФискальногоУстройстваЗавершение",ЭтотОбъект,Контекст);
			ПоддерживаемыеТипыВО = Новый Массив();
			ПоддерживаемыеТипыВО.Добавить("ФискальныйРегистратор");
			ПоддерживаемыеТипыВО.Добавить("ПринтерЧеков");			
			МенеджерОборудованияКлиент.ПредложитьВыбратьУстройство(ОписаниеОповещения, ПоддерживаемыеТипыВО,
			НСтр("ru = 'Выберите фискальное устройство'"), НСтр("ru = 'Фискальное устройство не подключено.'"),Пробить);
		Иначе
			ТекстСообщения = НСтр("ru = 'Предварительно необходимо выбрать рабочее место внешнего оборудования текущего сеанса.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	
КонецПроцедуры       
	
	&НаКлиенте
Процедура ВыборФискальногоУстройстваЗавершение(ИдентификаторУстройства, Параметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторУстройства) Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Вставить("ИдентификаторУстройства", ИдентификаторУстройства);
	
	ДанныеУстройства = МенеджерОборудованияКлиентПовтИсп.ПолучитьДанныеУстройства(ИдентификаторУстройства);
	ТипУстройства = ?(ДанныеУстройства.Свойство("ТипОборудованияИмя"), ДанныеУстройства.ТипОборудованияИмя, "ККТ");
	
	Если ТипУстройства = "ККТ" Тогда
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПолучитьПараметрыЗавершение", ЭтотОбъект, Параметры);
		МенеджерОборудованияКлиент.НачатьПолучениеПараметровФискальногоУстройства(ОповещениеПриЗавершении, УникальныйИдентификатор , ИдентификаторУстройства, Ложь);
	Иначе
		ПолучитьПараметрыЗавершение(Неопределено, Параметры);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПараметрыЗавершение(ПараметрыФискальногоУстройства, Параметры,Пробить=Ложь) Экспорт
	
	ОписаниеОшибки = "";
	Если ПараметрыФискальногоУстройства =  Неопределено Тогда
		ВерсияФормата = "1.1.0.0";
	ИначеЕсли НЕ ПараметрыФискальногоУстройства.Результат Тогда 
		ОписаниеОшибки = ПараметрыФискальногоУстройства.ОписаниеОшибки;
	Иначе
		ВерсияФормата = омг_WebKassa.ПолучитьВерсиюФФД(ПараметрыФискальногоУстройства.ВыходныеПараметры.ВерсияФФДФН, ПараметрыФискальногоУстройства.ВыходныеПараметры.ВерсияФФДККТ);
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ПараметрыУстройства = МенеджерОборудованияКлиентПовтИсп.ПолучитьПараметрыУстройства(Параметры.ИдентификаторУстройства);
		НомерСекции         = ?(ПараметрыУстройства.Свойство("НомерСекции"), ПараметрыУстройства.НомерСекции, 0);
		
		МассивЧеков = ПодготовитьДанныеДляПробитияЧека(НомерСекции, ВерсияФормата, ОписаниеОшибки);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ТекстСообщения = НСтр("ru = 'При подключении устройства произошла ошибка.
		|Чек не напечатан на фискальном устройстве.
		|Дополнительное описание:
		|%ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	ИначеЕсли МассивЧеков.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(Объект.НомерЧекаЭТ) и ЗначениеЗаполнено(Объект.омг_НомерТранзакцииТерминала) Тогда
		Пробить = Истина;	
		КонецЕсли; 	
			НапечататьЧекКлиент(МассивЧеков, Параметры.ИдентификаторУстройства, ВерсияФормата, Пробить);
	КонецЕсли;   
	
КонецПроцедуры   

&НаКлиенте
Процедура НапечататьЧекКлиент(МассивЧеков, ИдентификаторУстройства, ВерсияФормата,Пробить=Ложь)
	
	НомерСекции = 0;
	
	ЭтаФорма.Доступность = Ложь;
	Контекст = Новый Структура("ИдентификаторУстройства", ИдентификаторУстройства);
	Оповещение = Новый ОписаниеОповещения("НапечататьЧекКлиентЗавершение", ЭтотОбъект, Контекст);
	
	ПодключенноеОборудование = Новый Структура("Терминал, ФискальныеУстройства");
	ПодключенноеОборудование.ФискальныеУстройства = Новый Массив; 
	ПодключенноеОборудование.ФискальныеУстройства.Добавить(ИдентификаторУстройства);
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ДокументСсылка", Объект.Ссылка);
	ПараметрыОперации.Вставить("Организация", омг_WebKassa.ПолучитьОрганизацию(Объект.Филиал));
	Если Объект.Свойство("Контрагент") Тогда
	ПараметрыОперации.Вставить("Партнер", Объект.Контрагент)
	ИначеЕсли Объект.Свойство("Клиент") Тогда
	ПараметрыОперации.Вставить("Партнер", Объект.Клиент)
	КонецЕсли;
	ПараметрыОперации.Вставить("ПодключенноеОборудование", ПодключенноеОборудование);
	ПараметрыОперации.Вставить("ТорговыйОбъект", Неопределено);
	ПараметрыОперации.Вставить("Пробить", Пробить);
	
	ОткрытьФорму(
		"Обработка.ПечатьЧека.Форма",
		ПараметрыОперации,
		ЭтотОбъект,,,,
		Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЧекКлиентЗавершение(РезультатВыполнения, ПараметрыОперации) Экспорт
	
	Если РезультатВыполнения = КодВозвратаДиалога.Отмена ИЛИ РезультатВыполнения = Неопределено Тогда
		// Отмена в форме печати чека
		ЭтаФорма.Доступность = Истина;
	ИначеЕсли РезультатВыполнения.Свойство("Результат") И РезультатВыполнения.Результат Тогда
		// Установить полученное значение номера чека реквизиту документа.
		ЭтаФорма.Доступность = Истина;
		Объект.НомерЧекаККМ = РезультатВыполнения.ВыходныеПараметры[1];
		Модифицированность  = Истина;
		РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)); 
		СуммаОплаты = Объект.СуммаДокумента;
		РаботаСДокументамиКлиентСервер.ВывестиЗаголовокСуммаОплатыДокумента(ЭтаФорма);  
		ЭтаФорма.Доступность = Истина;
	Иначе
		ЭтаФорма.Доступность = Истина;
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		|Чек не напечатан на фискальном устройстве.
		|Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	//ФискальнаяОперацияОбновитьСтатус();
	//УправлениеФормой(ЭтотОбъект);

КонецПроцедуры

 &НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(Знач НомерСекции, Знач ВерсияФормата, ОписаниеОшибки)

	Возврат Документы.ОплатаПлатежнойКартой.СобратьДанныеЧеков(Объект.Ссылка, НомерСекции, ВерсияФормата, ОписаниеОшибки);

КонецФункции            


КонецПроцедуры

&НаСервере
Процедура ОбновитьПредоплату()
	
	Элементы.омг_СтатусПредоплаты.Видимость = Ложь; 
	Элементы.омг_Ссылка.Видимость = Ложь;  
	
	Организация  = омг_ДополнительныеАлгоритмы.омг_ВернутьОрганизациюПоФилиалу(Объект.Филиал);
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Если омг_Предоплата.омг_ИспользуетсяПредоплата(Организация) Тогда 
			Если не Объект.Ссылка.Пустая() Тогда
				
				СтатусОплаты = омг_Предоплата.ВернутьСтатусОплаты(Объект.Ссылка);
				
				Если ЗначениеЗаполнено(СтатусОплаты) Тогда
					омг_СтатусПредоплаты = СтатусОплаты.Статус;
					омг_Ссылка = СтатусОплаты.Ссылка;
					
					Если СтатусОплаты.Статус = Перечисления.омг_СтатусыПредоплаты.ОплатаПринята
						ИЛИ СтатусОплаты.Статус = Перечисления.омг_СтатусыПредоплаты.ПроизведенВозврат
						Тогда
						Элементы.омг_ПринятьОплату.Видимость = Ложь;
					Иначе
						Элементы.омг_ПринятьОплату.Видимость = Истина;
					КонецЕсли;
					
					Если РольДоступна("ПолныеПрава") Тогда
					// Отменить ссылку можно только пока оплата не подтверждена
					Элементы.омг_ОтменитьСсылку.Видимость = (СтатусОплаты.Статус = Перечисления.омг_СтатусыПредоплаты.ОжиданиеОплаты); 
					КонецЕсли;
				КонецЕсли;	
				
			КонецЕсли; 
			
			Если Объект.омг_ВидОплаты = Перечисления.омг_ВидыОплаты.Предоплата Тогда
				
				Элементы.омг_ПринятьОплату.Заголовок = "Принять оплату"; 
				Элементы.омг_СтатусПредоплаты.Видимость = Истина;
				Элементы.омг_Ссылка.Видимость = Истина;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры       

&НаКлиенте
Процедура омг_ОтменитьСсылку(Команда)
	
	Оповещение = Новый ОписаниеОповещения("омг_ПослеПодтвержденияОтменыСсылки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Отменить ссылку на оплату?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ПослеПодтвержденияОтменыСсылки(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		РезультатОтмены = омг_ОтменитьСсылкуНаПредоплатуНаСервере(Объект.Ссылка);
		
		Если РезультатОтмены.Успех Тогда
			ОбновитьПредоплату();
			ПоказатьПредупреждение(, "Ссылка на оплату отменена.", 5);
		Иначе
			ПоказатьПредупреждение(, "Не удалось отменить ссылку: " + РезультатОтмены.ТекстОшибки, 15);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция омг_ОтменитьСсылкуНаПредоплатуНаСервере(Знач ДокументСсылка)
	
	Возврат омг_Предоплата.омг_ОтменитьСсылкуНаПредоплату(ДокументСсылка);
	
КонецФункции


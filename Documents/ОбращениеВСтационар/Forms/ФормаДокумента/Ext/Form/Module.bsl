#Область РазделОписанияПеременных

&НаКлиенте
Перем мИспользоватьАвтоПодборКлиентовПоКоду; // При автоподборе и окончании ввода текста указывает, следует ли искать введенное значение в кодах справочника.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	мУчетнаяПолитика = УправлениеНастройками.ПолучитьУчетнуюПолитику();	
	
	РаботаСФормамиСервер.ФормаДокументаПриОткрытииСервер(ЭтаФорма);
	
	Если Объект.Ссылка.Пустая() Тогда 
		Если Не ЗначениеЗаполнено(Объект.ДатаВремяПоступления) Тогда
			Объект.ДатаВремяПоступления = ТекущаяДата();
		КонецЕсли;
		
		Если Параметры.Свойство("ЗначенияЗаполнения")
			И Параметры.ЗначенияЗаполнения.Свойство("ДокументОснование") 
		Тогда
			ПараметрДокументОснование = Параметры.ЗначенияЗаполнения.ДокументОснование;
		ИначеЕсли Параметры.Свойство("Основание") Тогда
			ПараметрДокументОснование = Параметры.Основание;
		КонецЕсли;
		
		// Добавлено Макеев (
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Прием.МедицинскаяКарта КАК МедицинскаяКарта,
		               |	Прием.Ссылка КАК Ссылка,
		               |	Прием.Дата КАК Дата,
		               |	Прием.Врач.Подразделение КАК ВрачПодразделение
		               |ПОМЕСТИТЬ ВТ_ДанныеДокумента
		               |ИЗ
		               |	Документ.Прием КАК Прием
		               |ГДЕ
		               |	Прием.Ссылка = &Ссылка
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Дата УБЫВ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА НЕ ЗначенияПараметровHTML.Параметр.Код = ""000003959""
		               |			ТОГДА ""Палата""
		               |		ИНАЧЕ ""Койка""
		               |	КОНЕЦ КАК ТипПараметра,
		               |	ЗначенияПараметровHTML.Значение КАК Значение
		               |ПОМЕСТИТЬ ВТ_ДопПараметры
		               |ИЗ
		               |	РегистрСведений.ЗначенияПараметровHTML КАК ЗначенияПараметровHTML
		               |ГДЕ
		               |	(ЗначенияПараметровHTML.Параметр.Код = ""000003958""
		               |			ИЛИ ЗначенияПараметровHTML.Параметр.Код = ""000003959"")
		               |	И ЗначенияПараметровHTML.Документ В
		               |			(ВЫБРАТЬ
		               |				ВТ_ДанныеДокумента.Ссылка КАК Ссылка
		               |			ИЗ
		               |				ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_ДанныеДокумента.МедицинскаяКарта КАК МедицинскаяКарта,
		               |	ВТ_ДанныеДокумента.Ссылка КАК Ссылка,
		               |	ВТ_ДанныеДокумента.Дата КАК Дата,
		               |	Палаты.Ссылка КАК Палата,
		               |	КойкоМеста.Ссылка КАК Койка
		               |ИЗ
		               |	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента
		               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		               |			ВТ_ДопПараметры.Значение КАК Палата,
		               |			ВТ_ДопПараметры1.Значение КАК Койка
		               |		ИЗ
		               |			ВТ_ДопПараметры КАК ВТ_ДопПараметры
		               |				ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ДопПараметры КАК ВТ_ДопПараметры1
		               |				ПО ВТ_ДопПараметры.ТипПараметра <> ВТ_ДопПараметры1.ТипПараметра) КАК ВложенныйЗапрос
		               |		ПО (ИСТИНА)
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Палаты КАК Палаты
		               |		ПО ВТ_ДанныеДокумента.ВрачПодразделение = Палаты.Подразделение
		               |			И (Палаты.Наименование = ЕСТЬNULL(ВложенныйЗапрос.Палата, """"))
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КойкоМеста КАК КойкоМеста
		               |		ПО (КойкоМеста.Владелец = Палаты.Ссылка)
		               |			И (КойкоМеста.Наименование = ЕСТЬNULL(ВложенныйЗапрос.Койка, """"))";
		Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда 
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Палата = Выборка.Палата;
			Койка = Выборка.Койка;
		КонецЕсли;
		// )
		Если ТипЗнч(ПараметрДокументОснование) = Тип("ДокументСсылка.БронированиеКойкоМеста") Тогда
			Палата = ПараметрДокументОснование.Палата;
			Койка  = ПараметрДокументОснование.КойкоМесто;
			Объект.ДатаВремяГоспитализации = ПараметрДокументОснование.ДатаНачала;
		Иначе
			Объект.ДатаВремяГоспитализации = Объект.ДатаВремяПоступления;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.КаналГоспитализации) Тогда
			Объект.КаналГоспитализации = ИнтеграцияЕГИСЗСервер.ЭлементКлассификатораПоID(4, "КаналыГоспитализации");
		КонецЕсли;
	КонецЕсли;
	
	Режим530н = Объект.Дата >= Стационар.ДатаВступленияПриказа530н();
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		Полис = Объект.Клиент.умцОсновнойСтраховойПолис;
		Элементы.Полис.ПараметрыВыбора = СформироватьПараметрыВыбораДляПолиса(Объект.Клиент);
	КонецЕсли;
	
	НастроитьЭлементыФормыПриСоздании(); 
	
	ОбновитьНадписьБронь(ЭтотОбъект);
	
	// В старых документах причина отказа из отдельного справочника. В новых из КлассификаторыМинЗдрава
	Если Не ЗначениеЗаполнено(Объект.ПричинаОтказаВГоспитализации) 
		Или ТипЗнч(Объект.ПричинаОтказаВГоспитализации) = Тип("СправочникСсылка.КлассификаторыМинЗдрава")
	Тогда
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.КлассификаторыМинЗдрава");
		ЭтаФорма.Элементы.ПричинаОтказаВГоспитализации.ОграничениеТипа = ОписаниеТипа;
		Объект.ПричинаОтказаВГоспитализации = ОписаниеТипа.ПривестиЗначение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПечатьДокументовКлиент.УстановитьЗаголовокПечатнойФормы(ЭтаФорма);
	
	МедицинскаяКартаПриИзменении(Неопределено);
	ОтказВГоспитализацииПриИзменении(Неопределено);
	ПересчитатьЗаголовокФактУпотребленияВеществ();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не Объект.ПометкаУдаления Тогда
	
		// Проверка, что по этой медкарте еще нет документа обращения в стационар
		Если Объект.Ссылка.Пустая() Тогда
			Обращение = Стационар.ОбращениеПоМедкарте(Объект.МедицинскаяКарта);
			Если ЗначениеЗаполнено(Обращение) Тогда
				Отказ = Истина;
				СообщениеПользователю = СтрШаблон("По данной медкарте уже оформлено обращение: %1", Строка(Обращение));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеПользователю);
			КонецЕсли;
		КонецЕсли;
		
		// Проверки по коечному фонду
		Если Не ЗначениеЗаполнено(Элементы.ПоступлениеВпалату.Заголовок)
			И ЗначениеЗаполнено(Койка)
		Тогда
			// Проверка занятости койки, указанной для быстрого создания Установки условий пребывания.
			СостояниеКойки = РегистрыСведений.ДвижениеКоечногоФонда.ПолучитьДвижениеКойки(Койка, Объект.ДатаВремяГоспитализации);
			Документ = Неопределено;
			Если РегистрыСведений.СостояниеКойкоМеста.КойкаЗанята(Койка, Объект.ДатаВремяГоспитализации, Документ) Тогда
				Если Документ.Клиент <> Объект.Клиент Тогда
					Отказ = Истина;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Койка %1 занята документом %2!", Койка, Документ));
				КонецЕсли;
			ИначеЕсли СостояниеКойки <> Неопределено И СостояниеКойки.Статус <> Перечисления.СостоянияКоек.ПустаяСсылка() Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Койка %1 недоступна, так как находится %2!", Койка, Нрег(Строка(СостояниеКойки.Статус))));					
			КонецЕсли;
		
			// Проверка, числятся ли пациент в стационаре (занимает койку)
			ДокументРазмещенияВПалату = Стационар.ПолучитьДокументПоступленияПациентаСтационара(Объект.Клиент,Объект.ДатаВремяГоспитализации);
			Если ЗначениеЗаполнено(ДокументРазмещенияВПалату) Тогда
				Отказ = Истина;
				Сообщение = СтрШаблон("Пациент уже размещен в палате стационара %1 (по состоянию на %2)!",
									   ДокументРазмещенияВПалату.Палата,
									   Формат(Объект.ДатаВремяГоспитализации, "ДФ=dd.MM.yyyy"));
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	РаботаСФормамиСервер.ВывестиЗаголовокФормыДокумента(ТекущийОбъект,,ЭтаФорма);
	
	Если Не Объект.ОтказВГоспитализации
		И Не ЗначениеЗаполнено(Элементы.ПоступлениеВПалату.Заголовок)
		И ПравоДоступа("Добавление", Метаданные.Документы.УстановкаУсловийПребывания)
	Тогда
		СоздатьПоступлениеПациентаВПалату();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


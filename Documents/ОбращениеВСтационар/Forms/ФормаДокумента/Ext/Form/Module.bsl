КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьПоступлениеПациентаВПалату() 
	
	Если ЗначениеЗаполнено(Объект.ДатаВремяГоспитализации)
		И ЗначениеЗаполнено(Койка)
		И ЗначениеЗаполнено(Палата)
	Тогда
		НовыйУУ = Документы.УстановкаУсловийПребывания.СоздатьДокумент();
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("Палата", Палата);
		ДанныеЗаполнения.Вставить("Полис", Полис);
		ДанныеЗаполнения.Вставить("Койка", Койка);
		ДанныеЗаполнения.Вставить("ВидОперации", Перечисления.ВидыДвиженияВСтационаре.Поступление);
		ДанныеЗаполнения.Вставить("ДокументОбращения", Объект.Ссылка);
		НовыйУУ.Заполнить(ДанныеЗаполнения);
		НовыйУУ.Дата = Объект.ДатаВремяГоспитализации;
		НовыйУУ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
	Элементы.ПоступлениеВПалату.Заголовок = ПолучитьФорматнуюСтрокуПоступленияВПалату(Объект.Ссылка);
	Элементы.ГруппаПолейПоступления.Видимость = Не ЗначениеЗаполнено(Элементы.ПоступлениеВПалату.Заголовок);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьФорматнуюСтрокуПоступленияВПалату(Ссылка, УстановкаУсловий = Неопределено)
	
	МассивСтрок = Новый Массив;
	
	Если УстановкаУсловий = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДокументОбращения", Ссылка);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	УстановкаУсловийПребывания.Ссылка КАК Ссылка,
			|	УстановкаУсловийПребывания.ВидОперации КАК ВидОперации,
			|	УстановкаУсловийПребывания.Номер КАК Номер,
			|	УстановкаУсловийПребывания.Дата КАК Дата
			|ИЗ
			|	Документ.УстановкаУсловийПребывания КАК УстановкаУсловийПребывания
			|ГДЕ
			|	УстановкаУсловийПребывания.ДокументОбращения = &ДокументОбращения
			|	И НЕ УстановкаУсловийПребывания.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СтрокаТекста = Строка(Выборка.ВидОперации) + " " + Строка(Выборка.Номер) + " от " + Строка(Выборка.Дата);
			
			Если МассивСтрок.Количество() <> 0 Тогда
				МассивСтрок.Добавить(", ");
			КонецЕсли;
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(СтрокаТекста,,,,ПолучитьНавигационнуюСсылку(Выборка.Ссылка)));
			
		КонецЦикла;
	Иначе
		СтрокаТекста = Строка(УстановкаУсловий.ВидОперации) + " " + Строка(УстановкаУсловий.Номер) + " от " + Строка(УстановкаУсловий.Дата);
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(СтрокаТекста,,,,ПолучитьНавигационнуюСсылку(УстановкаУсловий)));	
	КонецЕсли;
	
	Если МассивСтрок.Количество() <> 0 Тогда
		ФорматированнаяСтрокаРезультат = Новый ФорматированнаяСтрока(МассивСтрок);
		Возврат ФорматированнаяСтрокаРезультат; 
	Иначе
		Возврат "";	
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура НастроитьЭлементыФормыПриСоздании()
	
	НастроитьЭлементыДиагнозовПриСоздании();
	НастроитьЭлементФормыКаналГоспитализации();
	НастроитьЭлементФормыПричинаОбстоятельство(Элементы.ДиагнозПоступления, Режим530н, Объект.ДиагнозПоступления);
	
	// Установка отбора вида медкарт по типу Стационарная.
	Запрос = Новый Запрос;
	// Добавлено Макеев (
	ПрочиеНастройки = омг_МедицинскаяДеятельность.ПолучитьПрочиеНастройкиСистемы();
	ТипКарты = Перечисления.ТипыМедицинскихКарт.Стационар;
	Если ПрочиеНастройки.Свойство("ТипКартыСтационара") Тогда
		ТипКарты = ПрочиеНастройки.ТипКартыСтационара;
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипКарты", ТипКарты);
	// )
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыМедицинскихКарт.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыМедицинскихКарт КАК ВидыМедицинскихКарт
	|ГДЕ
	|	ВидыМедицинскихКарт.ТипКарты = &ТипКарты";
	ПараметрыВыбораЗначения = Новый Массив;
	ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("Отбор.ВидКарты", Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка")));
	ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("ТолькоАктуальныеКарты", Истина));
	ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("ДатаАктуальностиКарт", Объект.ДатаВремяГоспитализации));
	Элементы.МедицинскаяКарта.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЗначения);
	
	Элементы.СоздатьПриемВрача.Доступность = ДопСерверныеФункцииПовтИсп.ЕстьПравоДоступа("Добавление", "Документ.Прием");
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Элементы.ПоступлениеВПалату.Заголовок = ПолучитьФорматнуюСтрокуПоступленияВПалату(Объект.Ссылка);
		Элементы.ГруппаПолейПоступления.Видимость = Не ЗначениеЗаполнено(Элементы.ПоступлениеВПалату.Заголовок);
	КонецЕсли;
	
	Элементы.НомерНаряда.Видимость = Не Режим530н;
	Элементы.ПервичныйПовторныйОтказ.Видимость = Не Режим530н;
	Элементы.СтраницыГоспитализацияОтказ.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	Если Объект.АлкогольноеОпьянение Или Объект.НаркотическоеОпьянение Тогда
		Элементы.ГруппаСостояниеОпьянения.Показать();
	КонецЕсли;
	
	Элементы.СоздатьМедкарту.Доступность = ПравоДоступа("ИнтерактивноеДобавление", Объект.МедицинскаяКарта.Метаданные());
	Элементы.ДатаГоспитализацииТекущая.Видимость = Не ЗначениеЗаполнено(Объект.ДатаВремяГоспитализации);
	Элементы.ВидСтационараНаправления.Видимость = Объект.ПутьПоступления <> Неопределено И Объект.ПутьПоступления.УИДЕГИСЗ = 4;
	
КонецПроцедуры

&НаСервере
Функция НастроитьЭлементФормыКаналГоспитализации()
	
	ПерваначальнаяСтрогаяНастройкаПоляСоставногоТипа(Объект.КаналГоспитализации,
													 Справочники.КаналыГоспитализации.ПустаяСсылка(),
													 Тип("Строка"),
													 Элементы.КаналГоспитализации);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НастроитьЭлементФормыПричинаОбстоятельство(ПолеПричина, Режим530н, ДиагнозПоступления)
	
	Если Режим530н Тогда
		ПараметрыВыбораПричины = Новый Массив;
		ПараметрыВыбораПричины.Добавить(Новый ПараметрВыбора("ОтборКодовДиагнозов", "S-Z")); // S00-Y99.
		ПолеПричина.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораПричины);
		
		ПолеПричина.ВыбиратьТип = Ложь;
		
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.Диагнозы");
		ДиагнозПоступления = ОписаниеТипа.ПривестиЗначение(ДиагнозПоступления);
	Иначе
		ПолеПричина.ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция НастроитьЭлементыДиагнозовПриСоздании()
	
	Если ТипЗнч(Объект.ДиагнозПоступления) = Тип("СправочникСсылка.Диагнозы") Тогда
		ДиагнозПоступленияКодДиагноза = ДопСерверныеФункции.ПолучитьРеквизит(Объект.ДиагнозПоступления, "КодДиагноза");
	КонецЕсли;
	Если ТипЗнч(Объект.ДиагнозНаправления) = Тип("СправочникСсылка.Диагнозы") Тогда
		ДиагнозНаправленияКодДиагноза = ДопСерверныеФункции.ПолучитьРеквизит(Объект.ДиагнозНаправления, "КодДиагноза");
	КонецЕсли;
	
	ПерваначальнаяСтрогаяНастройкаПоляСоставногоТипа(Объект.ДиагнозПоступления,
													 Справочники.Диагнозы.ПустаяСсылка(),
													 Тип("Строка"),
													 Элементы.ДиагнозПоступления);
	
	ПерваначальнаяСтрогаяНастройкаПоляСоставногоТипа(Объект.ДиагнозНаправления,
													 Справочники.Диагнозы.ПустаяСсылка(),
													 Тип("Строка"),
													 Элементы.ДиагнозНаправления);
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьЗаголовокФактУпотребленияВеществ()
	
	ЗаголовокФактУпотребленияВеществ = "";
	Если Объект.АлкогольноеОпьянение Тогда
		ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ЗаголовокФактУпотребленияВеществ, "Алкогольное опьянение", ". ");
	КонецЕсли;
	Если Объект.НаркотическоеОпьянение Тогда
		ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ЗаголовокФактУпотребленияВеществ, "Иные психоактивные вещества.", ". ");
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПерваначальнаяСтрогаяНастройкаПоляСоставногоТипа(Реквизит, ЗначениеПоУмолчанию, УстаревшийТип, ПолеФормы)
	
	Если ТипЗнч(Реквизит) <> УстаревшийТип
		Или Не ЗначениеЗаполнено(Реквизит)
	Тогда
		ПолеФормы.ВыбиратьТип = Ложь;
		Если ТипЗнч(Реквизит) <> ТипЗнч(ЗначениеПоУмолчанию) Тогда
			Реквизит = ЗначениеПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьПараметрыВыбораДляПолиса(Клиент)
	
	НовыйМассив = Новый Массив;
    НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец", Клиент);
    НовыйМассив.Добавить(НовыйПараметр);
	Возврат Новый ФиксированныйМассив(НовыйМассив);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ПриемЗапись" И Параметр = ЭтаФорма Тогда
		Если Объект.ДокументОснование.Пустая() Тогда
			Объект.ДокументОснование = Источник;
			Модифицированность = Истина;
			
			Если Не ЗначениеЗаполнено(Объект.ДиагнозПоступления) Тогда
				Объект.ДиагнозПоступления = ПолучитьДиагнозПоступленияПриема(Объект.ДокументОснование);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "УстановкаУсловийПребывания"
		И ТипЗнч(Параметр) = Тип("Структура") 
		И Параметр.Обращение = Объект.Ссылка
	Тогда
		Элементы.ПоступлениеВПалату.Заголовок = ПолучитьФорматнуюСтрокуПоступленияВПалату(Объект.Ссылка, Параметр.УстановкаУсловийПребывания);
		Элементы.ГруппаПолейПоступления.Видимость = Не ЗначениеЗаполнено(Элементы.ПоступлениеВПалату.Заголовок);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьДиагнозПоступленияПриема(Прием)

	Если Прием.Диагнозы.Количество() > 0 Тогда
		
		СтрокаОсновнойДиагноз = Прием.Диагнозы.Найти(Перечисления.КлассификацииДиагнозов.ОсновноеЗаболевание, "Классификация3");
		Если СтрокаОсновнойДиагноз <> Неопределено Тогда
			Диагноз = СтрокаОсновнойДиагноз.Диагноз;
		Иначе
			Диагноз = Прием.Диагнозы[0].Диагноз;
		КонецЕсли;
	Иначе
		Диагноз = Справочники.Диагнозы.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Диагноз;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКойкиПалаты(Палата)
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КойкоМеста.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КойкоМеста КАК КойкоМеста
		|ГДЕ
		|	КойкоМеста.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Палата);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервереБезКонтекста
Функция РасположениеКойки(Койка)
	
	Расположение = Новый Структура("Палата, Подразделение");
	
	Расположение.Палата = Койка.Владелец;
	Расположение.Подразделение = Расположение.Палата.Подразделение;
	
	Возврат Расположение;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьДанныеБрони(ДанныеБрони, Клиент, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	БронированиеКойкоМеста.Клиент КАК Клиент,
	               |	БронированиеКойкоМеста.Палата КАК Палата,
	               |	БронированиеКойкоМеста.КойкоМесто КАК КойкоМесто
	               |ИЗ
	               |	Документ.БронированиеКойкоМеста КАК БронированиеКойкоМеста
	               |ГДЕ
	               |	НЕ БронированиеКойкоМеста.ПометкаУдаления
	               |	И БронированиеКойкоМеста.Проведен
	               |	И БронированиеКойкоМеста.Клиент = &Клиент
	               |	И НАЧАЛОПЕРИОДА(БронированиеКойкоМеста.ДатаНачала, ДЕНЬ) = &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	БронированиеКойкоМеста.ДатаНачала";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеБрони = Новый Структура;
		ДанныеБрони.Вставить("Койка", Выборка.КойкоМесто);
		ДанныеБрони.Вставить("Палата", Выборка.Палата);
		ДанныеБрони.Вставить("Подразделение", Выборка.Палата.Подразделение);
	Иначе
		ДанныеБрони = Неопределено;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Функция ТекстДанныхБрони(кешДанныеБрони)

	Возврат "Бронь: " + кешДанныеБрони.Палата + "; " + кешДанныеБрони.Койка;	
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьБронь(Форма)
	
	Если Форма.Элементы.ГруппаПолейПоступления.Видимость Тогда
		ЗаполнитьДанныеБрони(Форма.ДанныеБрони, Форма.Объект.Клиент, Форма.Объект.ДатаВремяГоспитализации);
		Если Форма.ДанныеБрони <> Неопределено Тогда
			Форма.Элементы.НадписьБронь.Заголовок = ТекстДанныхБрони(Форма.ДанныеБрони);
		Иначе
			Форма.Элементы.НадписьБронь.Заголовок = "";	
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры


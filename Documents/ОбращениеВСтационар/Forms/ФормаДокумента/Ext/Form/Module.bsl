&НаКлиенте
Процедура КойкаОбработкаВыбораОбновитьПалату()
	
	РасположениеКойки = РасположениеКойки(Койка);
	
	Если Палата <> РасположениеКойки.Палата Тогда
		Элементы.Койка.СписокВыбора.ЗагрузитьЗначения(Стационар.КойкиПалаты(Палата));
		Палата = РасположениеКойки.Палата;
	КонецЕсли;

	Объект.Подразделение = РасположениеКойки.Подразделение;
	Элементы.ПалатаПолучатель.ОбновитьТекстРедактирования();
	Элементы.Подразделение.ОбновитьТекстРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	Если Палата.Пустая() Тогда
		Койка = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаналГоспитализацииПриИзменении(Элемент)
	
	// Подстановка пути поступления по типу поступления(т.е. по тому, кем доставлен)
	Если ЗначениеЗаполнено(Объект.КаналГоспитализации)
		И ТипЗнч(Объект.КаналГоспитализации) = Тип("СправочникСсылка.КаналыГоспитализации")
	Тогда
		ИД_Пути = Неопределено;
		ИД_Канала = ДопСерверныеФункции.ПолучитьРеквизит(Объект.КаналГоспитализации, "УИДЕГИСЗ");
		
		Если ИД_Канала = 1 Тогда // Поликлиникой.
			ИД_Пути = 3; // Плановая госпитализация.
		ИначеЕсли ИД_Канала = 2 Тогда // Бригада скорой.
			ИД_Пути = 1;
		ИначеЕсли ИД_Канала = 4 Тогда // Самостоятельно.
			ИД_Пути = 2;
		КонецЕсли;
		
		Если ИД_Пути <> Неопределено Тогда
			Путь = ИнтеграцияЕГИСЗВызовСервера.ЭлементКлассификатораПоУИДЕГИСЗ(ИД_Пути, ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовМинЗдрава.ПутиПоступленияПациентаНаГоспитализацию"));
			Если ЗначениеЗаполнено(Путь) Тогда
				Объект.ПутьПоступления = Путь;
				ПутьПоступленияПриИзменении(Элементы.ПутьПоступления);
			КонецЕсли;
		КонецЕсли;				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьПоступленияПриИзменении(Элемент)
	
	Элементы.ВидСтационараНаправления.Видимость = Объект.ПутьПоступления <> Неопределено И ДопСерверныеФункции.ПолучитьРеквизит(Объект.ПутьПоступления, "УИДЕГИСЗ") = 4;
	Объект.ВидСтационараНаправления = ?(Элементы.ВидСтационараНаправления.Видимость, Объект.ВидСтационараНаправления, Неопределено);

КонецПроцедуры


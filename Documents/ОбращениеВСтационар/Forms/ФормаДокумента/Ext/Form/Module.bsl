&НаКлиенте
Процедура Подключаемый_КнопкаФилиалПриНажатии(Команда)
	РаботаСДиалогамиКлиент.ДиалогКнопкаФилиалПриНажатии(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПриемВрача(Команда)
	
	Если РаботаСДиалогамиКлиент.ПроверитьМодифицированностьВФорме(ЭтаФорма) Тогда
		ЗначенияЗаполнения = Новый Структура("Клиент, МедицинскаяКарта, Основание", Объект.Клиент, Объект.МедицинскаяКарта, Объект.Ссылка);
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения, МедицинскаяКарта, ЭтоПриемВСтационаре", ЗначенияЗаполнения, Объект.МедицинскаяКарта, Истина);
		ОткрытьФорму("Документ.Прием.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПоискКлиентов(Команда)
	
	ФормаКлиента =  ПолучитьФорму("ОбщаяФорма.ФормаПоискаКлиентаУпр",,Элементы.Клиент);
	ФормаКлиента.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура ДатаГоспитализацииТекущая(Команда)
	
	Объект.ДатаВремяГоспитализации = ТекущаяДата();
	
КонецПроцедуры

#Область КнопкаСоздатьМедкарту

&НаКлиенте
Процедура СоздатьМедкарту(Команда)
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		
		ВидКарты = ОсновнойВидКартСтационар();
		
		Если ЗначениеЗаполнено(ВидКарты) Тогда
			Объект.МедицинскаяКарта = СоздатьМедкартуСтационар(Объект.Клиент, ВидКарты, Объект.Филиал);
			ТекущийЭлемент = Элементы.МедицинскаяКарта
		Иначе
			Отбор = Новый Структура("ТипКарты", ПредопределенноеЗначение("Перечисление.ТипыМедицинскихКарт.Стационар"));
			Оповещение = Новый ОписаниеОповещения("СоздатьМедкарту_ПослеВыбораВидаКарты", ЭтотОбъект);
			ОткрытьФорму("Справочник.ВидыМедицинскихКарт.ФормаВыбора", Новый Структура("Отбор", Отбор), ЭтотОбъект,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, "Не выбран пациент");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьМедкарту_ПослеВыбораВидаКарты(ВидКарты, ДополнительныеСведения) Экспорт
	
	Если ЗначениеЗаполнено(ВидКарты) Тогда
		
		Объект.МедицинскаяКарта = СоздатьМедкартуСтационар(Объект.Клиент, ВидКарты, Объект.Филиал);
		ТекущийЭлемент = Элементы.МедицинскаяКарта
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьМедкартуСтационар(Клиент, ВидКарты, Филиал)
	
	Медкарта = Справочники.МедицинскиеКарты.СоздатьЭлемент();
	Медкарта.ВидКарты = ВидКарты;
	Медкарта.Клиент = Клиент;
	Медкарта.Филиал = Филиал;
	Медкарта.ДатаРегистрации = ТекущаяДата();
	ОтраслевыеДополнения.ФормированиеНомера(Медкарта, Истина);
	
	Медкарта.Записать();
	
	Возврат Медкарта.Ссылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОсновнойВидКартСтационар() Экспорт
	
	Запрос = Новый Запрос;
	// Изменено Макеев (
	ПрочиеНастройки = омг_МедицинскаяДеятельность.ПолучитьПрочиеНастройкиСистемы();
	ТипКарты = Перечисления.ТипыМедицинскихКарт.Стационар;
	Если ПрочиеНастройки.Свойство("ТипКартыСтационара") Тогда
		ТипКарты = ПрочиеНастройки.ТипКартыСтационара;
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипКарты", ТипКарты);
	// )
	Запрос.Текст = "ВЫБРАТЬ
	|	ВидыМедицинскихКарт.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыМедицинскихКарт КАК ВидыМедицинскихКарт
	|ГДЕ
	|	ВидыМедицинскихКарт.ТипКарты = &ТипКарты
	|	И НЕ ВидыМедицинскихКарт.Архив"
	;
	Выб = Запрос.Выполнить().Выбрать();
	
	Если Выб.Количество() = 1 Тогда
		Выб.Следующий();
		Возврат Выб.Ссылка;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Режим530н = Объект.Дата >= Стационар.ДатаВступленияПриказа530н();
	
	НастроитьЭлементФормыПричинаОбстоятельство(Элементы.ДиагнозПоступления, Режим530н, Объект.ДиагнозПоступления);
	Элементы.ПервичныйПовторныйОтказ.Видимость = Не Режим530н;
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Клиент) 
		И Не ЗначениеЗаполнено(Объект.МедицинскаяКарта)
	Тогда
		Объект.МедицинскаяКарта = Стационар.ПолучитьМедКартуСтационара(Объект.Клиент);
	КонецЕсли;
	
	МедицинскаяКартаПриИзменении(Неопределено);
	
	Полис = ОбщегоНазначения.ПолучитьЗначениеРеквизита( Объект.Клиент, "умцОсновнойСтраховойПолис");
		
	Элементы.Полис.ПараметрыВыбора = СформироватьПараметрыВыбораДляПолиса(Объект.Клиент);
	
	ОбновитьНадписьБронь(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
						  
	РаботаСФормамиКлиент.ПолеВводаКлиентаАвтоПодбор(Текст, СтандартнаяОбработка, ДанныеВыбора, мИспользоватьАвтоПодборКлиентовПоКоду);
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	РаботаСФормамиКлиент.ПолеВводаКлиентаАвтоПодбор(Текст, СтандартнаяОбработка, ДанныеВыбора, мИспользоватьАвтоПодборКлиентовПоКоду);
	
КонецПроцедуры

&НаКлиенте
Процедура МедицинскаяКартаПриИзменении(Элемент)
	Элементы.СоздатьМедкарту.Видимость = Не ЗначениеЗаполнено(Объект.МедицинскаяКарта);
КонецПроцедуры

&НаКлиенте
Процедура ДатаГоспитализацииПриИзменении(Элемент)
	
	// Акутализация параметра выбора медкарты: дата регистрации карты
	ПараметрыВыбораИзменение = Новый Массив(Элементы.МедицинскаяКарта.ПараметрыВыбора);
	Для Инд = 0 По ПараметрыВыбораИзменение.Количество()-1 Цикл
		ПараметрВыбора = ПараметрыВыбораИзменение[Инд];
		Если ПараметрВыбора.Имя = "ДатаАктуальностиКарт" Тогда
			Если НачалоДня(ПараметрВыбора.Значение) <> НачалоДня(Объект.ДатаВремяГоспитализации) Тогда
				
				ПараметрыВыбораИзменение.Удалить(Инд);
				Если ЗначениеЗаполнено(Объект.ДатаВремяГоспитализации) Тогда
					ПараметрВыбораНовый = Новый ПараметрВыбора("ДатаАктуальностиКарт", Объект.ДатаВремяГоспитализации);
					ПараметрыВыбораИзменение.Вставить(Инд, ПараметрВыбораНовый);
				КонецЕсли;
			КонецЕсли;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.МедицинскаяКарта.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораИзменение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказВГоспитализацииПриИзменении(Элемент)
	
	Элементы.СтраницыГоспитализацияОтказ.ТекущаяСтраница =
		?(Объект.ОтказВГоспитализации, Элементы.СтраницаОтказ, Элементы.СтраницаГоспитализация);
	
	Если Объект.ОтказВГоспитализации Тогда 
		Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
			Объект.Подразделение = ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка"); //***
		КонецЕсли;

		Если Объект.Ссылка.Пустая() Тогда 
			Объект.ПервичныйПовторныйОтказ = ПредопределенноеЗначение("Перечисление.ВидыОтказаВГоспитализации.Первичный");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ДатаВремяОтказа) Тогда
			Объект.ДатаВремяОтказа = ТекущаяДата();
		КонецЕсли;
	Иначе
		Если Элемент <> Неопределено Тогда // Интерактивное изменение или аналог.
			Объект.ПервичныйПовторныйОтказ = Неопределено;
			Объект.ПричинаОтказаВГоспитализации = ПредопределенноеЗначение("Справочник.КлассификаторыМинЗдрава.ПустаяСсылка");
			Объект.ДатаВремяОтказа = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДиагнозПоступленияПриИзменении(Элемент)
	
	Если ТипЗнч(Объект.ДиагнозПоступления) = Тип("СправочникСсылка.Диагнозы") Тогда
		ДиагнозПоступленияКодДиагноза = ДопСерверныеФункции.ПолучитьРеквизит(Объект.ДиагнозПоступления, "КодДиагноза");

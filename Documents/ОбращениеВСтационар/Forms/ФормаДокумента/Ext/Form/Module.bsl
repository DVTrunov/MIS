&НаКлиенте
Процедура КойкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВозможныйЛагОформления = 10 * 60;
	Если ТекущаяДата() > Объект.ДатаВремяГоспитализации
		И (ТекущаяДата() - Объект.ДатаВремяГоспитализации) <= ВозможныйЛагОформления
	Тогда
		ДатаАнализаЗанятостиКоек = ТекущаяДата();
	Иначе
		ДатаАнализаЗанятостиКоек = Объект.ДатаВремяГоспитализации;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("Дата, БлокироватьВыборЗанятых", ДатаАнализаЗанятостиКоек, Истина);
	СтруктураПараметров.Вставить("Филиал", Объект.Филиал);
	СтруктураПараметров.Вставить("Клиент", Объект.Клиент);
	ОткрытьФорму("Справочник.КойкоМеста.ФормаВыбора",СтруктураПараметров,Элементы.Койка,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


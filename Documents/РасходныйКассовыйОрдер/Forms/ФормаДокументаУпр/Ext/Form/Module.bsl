&НаСервере
Процедура ЗаполнитьКупюры()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	омг_НоминалыКупюр.Ссылка КАК Ссылка
		|ИЗ
		|	Перечисление.омг_НоминалыКупюр КАК омг_НоминалыКупюр
		|
		|УПОРЯДОЧИТЬ ПО
		|	омг_НоминалыКупюр.Порядок";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрКупюры = Объект.омг_Купюры.Добавить();
		СтрКупюры.Номинал = ВыборкаДетальныеЗаписи.Ссылка
	КонецЦикла;
	  
КонецПроцедуры


	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ПрейскурантНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокВыбранных = омг_Прейскуранты;
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийУстановкиЦен.омг_СтраховаяПрограмма") 
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийУстановкиЦен.омг_СтраховаяПрограммаНаборы") Тогда
		Отбор = Новый Структура("Организация", Объект.омг_Организация);
		
		ПараметрыЗапроса = Новый Массив;
		ПараметрыЗапроса.Добавить(Новый Структура("Параметр, Значение", "Дата", Объект.Дата));
		
		Отбор.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
		
		СложныеОтборы = Новый Массив;
		СложныеОтборы.Добавить("&Дата МЕЖДУ ДатаНачала И ДатаОкончания");
		
		Отбор.Вставить("СложныеОтборы", СложныеОтборы);
		ОткрытьФорму("ОбщаяФорма.омг_ФормаВыбораСИерархией", 
			Новый Структура("Справочник, СписокВыбранных, Отбор", "СоглашенияСтрахования", СписокВыбранных, Отбор), Элементы.Прейскурант,
			УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийУстановкиЦен.ЦеныПрейскурантов")
			Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийУстановкиЦен.омг_ЦеныНаборов") 
			Тогда
		//Отбор = Новый Структура("омг_Организация", Объект.омг_Организация);
		ОткрытьФорму("ОбщаяФорма.омг_ФормаВыбораСИерархией", 
			Новый Структура("Справочник, СписокВыбранных", "Прейскуранты", СписокВыбранных), Элементы.Прейскурант,
			УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму("ОбщаяФорма.омг_ФормаВыбораСИерархией", 
			Новый Структура("Справочник, СписокВыбранных", "Контрагенты", СписокВыбранных), Элементы.Прейскурант,
			УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ПрейскурантОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	Модифицированность = Истина;
	омг_ПерезаполнитьТаблицуПрейскурантов(ВыбранноеЗначение);
КонецПроцедуры

&НаСервере
Функция омг_ЗагрузитьЦеныПоТарификторуНаСервере(ДвоичныеДанные, Начало, Конец, Расширение)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла);
	
	Объект.Номенклатура.Очистить();
	
	ТаблицаАртикулов = Новый ТаблицаЗначений;
	ТаблицаАртикулов.Колонки.Добавить("Артикул", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаАртикулов.Колонки.Добавить("Наименование", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТаблицаАртикулов.Колонки.Добавить("Цена", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ТаблицаАртикулов.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	
	Для НСтроки = Начало По ?(Конец = 0, ТабличныйДокумент.ВысотаТаблицы, Конец) Цикл
		
		СтрокаТаблицы = ТаблицаАртикулов.Добавить();
		СтрокаТаблицы.Артикул = СокрЛП(ТабличныйДокумент.Область(НСтроки, 1, НСтроки, 1).Текст);
		СтрокаТаблицы.Наименование = СокрЛП(ТабличныйДокумент.Область(НСтроки, 2, НСтроки, 2).Текст);
		СтрокаТаблицы.Цена = СокрЛП(ТабличныйДокумент.Область(НСтроки, 7, НСтроки, 7).Текст);
		СтрокаТаблицы.НомерСтроки = НСтроки;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_ТарификаторСрезПоследних.Период КАК Период,
	               |	омг_ТарификаторСрезПоследних.Организация КАК Организация,
	               |	омг_ТарификаторСрезПоследних.Коэффициент КАК Коэффициент
	               |ПОМЕСТИТЬ ВТ_Коэффициент
	               |ИЗ
	               |	РегистрСведений.омг_Тарификатор.СрезПоследних(&Дата, Организация = &Организация) КАК омг_ТарификаторСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаАртикулов.Артикул КАК Артикул,
	               |	ТаблицаАртикулов.Наименование КАК Наименование,
	               |	ТаблицаАртикулов.Цена КАК Цена,
	               |	ТаблицаАртикулов.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ ВТ_ТаблицаАртикулов
	               |ИЗ
	               |	&ТаблицаАртикулов КАК ТаблицаАртикулов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаАртикулов.Артикул КАК Артикул,
	               |	ВТ_ТаблицаАртикулов.Наименование КАК Наименование,
				   //|	ВТ_ТаблицаАртикулов.Цена * ЕСТЬNULL(ВТ_Коэффициент.Коэффициент, 0) / 100 + ВТ_ТаблицаАртикулов.Цена КАК Цена, 
				   ////////////////////////////////////////////////////////////////
				   // ОМГ
				   |	ВТ_ТаблицаАртикулов.Цена * ЕСТЬNULL(ВТ_Коэффициент.Коэффициент, 1)  КАК Цена, 
				   // ОМГ
				    ////////////////////////////////////////////////////////////////
	               |	ЕСТЬNULL(Номенклатура.Ссылка, НЕОПРЕДЕЛЕНО) КАК Номенклатура,
	               |	ВТ_ТаблицаАртикулов.НомерСтроки КАК НомерСтроки,
	               |	ВТ_ТаблицаАртикулов.Цена КАК омг_ИсходнаяЦена,
	               |	ВТ_Коэффициент.Коэффициент КАК омг_Коэффициент
	               |ИЗ
	               |	ВТ_ТаблицаАртикулов КАК ВТ_ТаблицаАртикулов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО (ВЫБОР
	               |				КОГДА ВТ_ТаблицаАртикулов.Артикул = Номенклатура.Артикул
	               |					ТОГДА ИСТИНА
	               |				КОГДА ВТ_ТаблицаАртикулов.Наименование = Номенклатура.Наименование
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Коэффициент КАК ВТ_Коэффициент
	               |		ПО (ИСТИНА)";
	Запрос.УстановитьПараметр("ТаблицаАртикулов", ТаблицаАртикулов);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.омг_Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Номенклатура = Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Строка документа """ + Выборка.НомерСтроки + 
				""", не найдена номенклатура по артикулу """ + Выборка.Артикул;
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы = Объект.Номенклатура.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Асинх Процедура омг_ЗагрузитьЦеныПоТарификатору(Команда)
	
	ДиалогВыбораФайла = НовыЙ ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = "Выберите файл цен";
	ДиалогВыбораФайла.Фильтр = "Excel|*.xls;*.xlsx";
	Результат = Ждать ДиалогВыбораФайла.ВыбратьАсинх();
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ПутьКФайлу = Результат[0];
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось прочитать файл. Подробности:
		|" + ОписаниеОшибки();
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	
	Начало = Ждать ВвестиЗначениеАсинх(1, "Выберите начало", ОбщегоНазначения.ОписаниеТипаЧисло(15, 0,ДопустимыйЗнак.Неотрицательный));
	
	Если Не ЗначениеЗаполнено(Начало) Тогда
		Возврат;
	КонецЕсли;
	
	Конец = Ждать ВвестиЗначениеАсинх(1, "Выберите конец", ОбщегоНазначения.ОписаниеТипаЧисло(15, 0,ДопустимыйЗнак.Неотрицательный));
	
	Если Не ЗначениеЗаполнено(Конец) И Не Конец = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Файл = Новый Файл(ПутьКФайлу);
	
	
	омг_ЗагрузитьЦеныПоТарификторуНаСервере(ДвоичныеДанные, Начало, Конец, Файл.Расширение);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура омг_УстановитьПометкуЗаполненностиНабора(Объект)
	
	Для Каждого СтрокаТаблицы Из Объект.Номенклатура Цикл
		
		НайденныеПозиции = Объект.омг_НоменклатураНаборов.НайтиСтроки(Новый Структура("Набор", СтрокаТаблицы.Номенклатура));
		
		СтрокаТаблицы.омг_НаборУстановлен = Не НайденныеПозиции.Количество() = 0;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура омг_ПослеВыбораНоменклатурыНабора(МассивПозиций, ДопПараметры) Экспорт
	
	Если МассивПозиций = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДаннные = Элементы.Номенклатура.ТекущиеДанные;
	
	ТекущиеДаннные.омг_НаборУстановлен = МассивПозиций.Количество() > 0;
	
	НайденныеПозиции = Объект.омг_НоменклатураНаборов.НайтиСтроки(Новый Структура("Набор", ТекущиеДаннные.Номенклатура));
	
	Для Каждого СтрокаТаблицы Из НайденныеПозиции Цикл
		Объект.омг_НоменклатураНаборов.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из МассивПозиций Цикл
		ЗаполнитьЗначенияСвойств(Объект.омг_НоменклатураНаборов.Добавить(), СтрокаТаблицы);
	КонецЦикла;
	
	ТекущиеДаннные.Цена = 0;
	
	Для Каждого СтрокаТаблицы Из МассивПозиций Цикл 
		Если не ЗначениеЗаполнено(СтрокаТаблицы.ВложенныйНабор) Тогда
			Количество = 1;
			Если СтрокаТаблицы.Свойство("Количество") Тогда
				Количество = СтрокаТаблицы.Количество;
			КонецЕсли;
			ТекущиеДаннные.Цена = ТекущиеДаннные.Цена + СтрокаТаблицы.ЦенаВНаборе * Количество;  
		КонецЕсли;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоКомплектующих(Набор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НоменклатураКомплектующиеНоменклатуры.Комплектующая КАК Комплектующая,
	|	НоменклатураКомплектующиеНоменклатуры.Количество КАК Количество
	|ИЗ
	|	Справочник.Номенклатура.КомплектующиеНоменклатуры КАК НоменклатураКомплектующиеНоменклатуры
	|ГДЕ
	|	НоменклатураКомплектующиеНоменклатуры.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Набор);
	Выборка = Запрос.Выполнить().Выбрать();

	Соответсвие = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Соответсвие.Вставить(Выборка.Комплектующая, Выборка.Количество);
	КонецЦикла;
	
	Возврат Соответсвие;
	
КонецФункции

&НаКлиенте
Процедура НоменклатураВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Элемент.ТекущийЭлемент = Элементы.Номенклатураомг_НоменклатураНабора Тогда
				
		ТекущиеДанныеНабора = Элементы.Номенклатура.ТекущиеДанные;
		
		Филиалы = Новый СписокЗначений;
		Для Каждого СтрокаТаблицы Из Объект.омг_Филиалы Цикл
			Филиалы.Добавить(СтрокаТаблицы.Филиал);
		КонецЦикла;
		
		ПараметрыПодбора = Новый Структура("Филиалы, Набор, МассивПозиций", 
			Филиалы, ТекущиеДанныеНабора.Номенклатура, Новый Массив);
			
		НайденныеПозиции = Объект.омг_НоменклатураНаборов.НайтиСтроки(Новый Структура("Набор", ТекущиеДанныеНабора.Номенклатура)); 
		
		//Для каждого подстрокаНоменклатура из НайденныеПозиции Цикл
		//	
		//	Если подстрокаНоменклатура.Номенклатура.ВидНоменклатуры = ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Набор") Тогда
		//	НайденныеПозиции	
		//	КонецЕсли;
		//	
		//КонецЦикла	
		
		КоличествоКомплектующих = ПолучитьКоличествоКомплектующих(ТекущиеДанныеНабора.Номенклатура);
		
		Для Каждого СтрокаТаблицы Из НайденныеПозиции Цикл
			
			СтруктураСтроки = Новый Структура("Номенклатура, ЦенаВНаборе, ЦенаОбщая, Коэффициент, ВложенныйНабор, Количество");
			КоличествоКомлектующей = КоличествоКомплектующих.Получить(СтрокаТаблицы.Номенклатура);
			Если Не КоличествоКомлектующей = Неопределено Тогда
				СтруктураСтроки.Количество = КоличествоКомлектующей;
			Иначе
				СтруктураСтроки.Количество = 1;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТаблицы);
			ПараметрыПодбора.МассивПозиций.Добавить(СтруктураСтроки);
		КонецЦикла;
		
		ОбработчикПослеВыбора = Новый ОписаниеОповещения("омг_ПослеВыбораНоменклатурыНабора", ЭтаФорма);
		
		ОткрытьФорму("Документ.УстановкаЦен.Форма.омг_ФормаПодбораНоменклатурыНабора", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор,,,
			ОбработчикПослеВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура омг_НоменклатураПередУдалением(Элемент, Отказ)
	
	ТекущиеДанныеНабора = Элементы.Номенклатура.ТекущиеДанные;
	НайденныеПозиции = Объект.омг_НоменклатураНаборов.НайтиСтроки(Новый Структура("Набор", ТекущиеДанныеНабора.Номенклатура));
	Для Каждого СтрокаТаблицы Из НайденныеПозиции Цикл
		Объект.омг_НоменклатураНаборов.Удалить(СтрокаТаблицы);

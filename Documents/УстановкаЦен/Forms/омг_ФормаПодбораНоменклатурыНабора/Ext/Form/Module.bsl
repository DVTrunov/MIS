&НаКлиенте
Процедура ЗафиксироватьИзмененияВложенногоНабора(СтрокаТаблицыВложенногоНабора)
	
	Если ЗначениеЗаполнено(СтрокаТаблицыВложенногоНабора.ВложенныйНабор) Тогда		
		стрПоиска = Новый Структура;
		стрПоиска.Вставить("ВложенныйНабор",СтрокаТаблицыВложенногоНабора.ВложенныйНабор);
		стрПоиска.Вставить("Номенклатура",СтрокаТаблицыВложенногоНабора.Номенклатура);
		
		СтрокиИзменения = НоменклатураНабораВложенныйНаборВнутренний.НайтиСтроки(стрПоиска);
		
		Для каждого строкаИзменения из СтрокиИзменения Цикл
			ЗаполнитьЗначенияСвойств(строкаИзменения,СтрокаТаблицыВложенногоНабора);		
		КонецЦикла;	
		
		стрПоиска = Новый Структура;
		стрПоиска.Вставить("Номенклатура",СтрокаТаблицыВложенногоНабора.ВложенныйНабор);
		
		СамНабор = НоменклатураНабора.НайтиСтроки(стрПоиска);
		Если СамНабор.количество() > 0 Тогда 
			СамНабор[0].ЦенаВНаборе = 0;
			стрПоиска = Новый Структура;
			стрПоиска.Вставить("ВложенныйНабор",СтрокаТаблицыВложенногоНабора.ВложенныйНабор);
			
			СтрокиНабора = НоменклатураНабораВложенныйНабор.НайтиСтроки(стрПоиска);
			
			Для каждого СтрокаНабора из СтрокиНабора Цикл
				СамНабор[0].ЦенаВНаборе = СамНабор[0].ЦенаВНаборе + СтрокаНабора.ЦенаВНаборе;
				//ЗаполнитьЗначенияСвойств(НоменклатураНабораВложенныйНабор.Добавить(),СтрокаНабора)
			КонецЦикла
			
		КонецЕсли;
		
		
	КонецЕсли;

	
КонецПроцедуры


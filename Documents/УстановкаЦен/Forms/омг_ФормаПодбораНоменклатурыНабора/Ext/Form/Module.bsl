
&НаСервереБезКонтекста
Функция ПолучитьВыборкуЦен(Набор, Филиалы, ОсновнойПрейскурант, Комплектующая = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Набор", Набор);
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураКомплектующиеНоменклатуры.Комплектующая КАК Комплектующая,
	               |	НоменклатураКомплектующиеНоменклатуры.НомерСтроки КАК НомерСтроки,
	               |	НоменклатураКомплектующиеНоменклатуры.Количество КАК Количество
	               |ПОМЕСТИТЬ ВТ_НоменклатураНабора
	               |ИЗ
	               |	Справочник.Номенклатура.КомплектующиеНоменклатуры КАК НоменклатураКомплектующиеНоменклатуры
	               |ГДЕ
	               |	НоменклатураКомплектующиеНоменклатуры.Ссылка = &Набор
	               |	И ВЫБОР
	               |			КОГДА &Комплектующая = НЕОПРЕДЕЛЕНО
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НоменклатураКомплектующиеНоменклатуры.Комплектующая,
	               |	НоменклатураКомплектующиеНоменклатуры.НомерСтроки,
	               |	НоменклатураКомплектующиеНоменклатуры.Количество
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	&Комплектующая,
	               |	1,
	               |	1
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА НЕ &Комплектующая = НЕОПРЕДЕЛЕНО
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НоменклатураНабора.Комплектующая КАК Номенклатура,
	               |	МАКСИМУМ(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)) КАК Цена,
	               |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.омг_Набор, НЕОПРЕДЕЛЕНО) КАК омг_Набор,
	               |	МАКСИМУМ(ВТ_НоменклатураНабора.Количество) КАК Количество
	               |ПОМЕСТИТЬ ВТ_ВсеЦеныКопмлектующих
	               |ИЗ
	               |	ВТ_НоменклатураНабора КАК ВТ_НоменклатураНабора
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |				,
	               |				(Номенклатура В
	               |						(ВЫБРАТЬ
	               |							ВТ_НоменклатураНабора.Комплектующая КАК Комплектующая
	               |						ИЗ
	               |							ВТ_НоменклатураНабора КАК ВТ_НоменклатураНабора)
	               |					ИЛИ Номенклатура = &Комплектующая)
	               |					И омг_Филиал В (&Филиалы)
	               |					И Прейскурант = &ОсновнойПрейскурант
	               |					И (омг_Набор = &Набор
	               |						ИЛИ омг_Набор = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))) КАК ЦеныНоменклатурыСрезПоследних
	               |		ПО ВТ_НоменклатураНабора.Комплектующая = ЦеныНоменклатурыСрезПоследних.Номенклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_НоменклатураНабора.Комплектующая,
	               |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.омг_Набор, НЕОПРЕДЕЛЕНО)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |	ВложенныйЗапрос.ЦенаВНаборе КАК ЦенаВНаборе,
	               |	ВложенныйЗапрос.ЦенаОбщая КАК ЦенаОбщая,
	               |	ВЫБОР
	               |		КОГДА ВложенныйЗапрос.ЦенаОбщая = 0
	               |			ТОГДА 0
	               |		ИНАЧЕ ВложенныйЗапрос.ЦенаВНаборе / ВложенныйЗапрос.ЦенаОбщая
	               |	КОНЕЦ КАК Коэффициент,
	               |	ВложенныйЗапрос.НомерСтроки КАК НомерСтроки,
	               |	ВложенныйЗапрос.Количество КАК Количество
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_НоменклатураНабора.Комплектующая КАК Номенклатура,
	               |		МАКСИМУМ(ЕСТЬNULL(ЦеныВНаборе.Цена, 0)) КАК ЦенаВНаборе,
	               |		МАКСИМУМ(ЕСТЬNULL(ЦеныОбщие.Цена, 0)) КАК ЦенаОбщая,
	               |		МАКСИМУМ(ВТ_НоменклатураНабора.НомерСтроки) КАК НомерСтроки,
	               |		МАКСИМУМ(ВТ_НоменклатураНабора.Количество) КАК Количество
	               |	ИЗ
	               |		ВТ_НоменклатураНабора КАК ВТ_НоменклатураНабора
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеЦеныКопмлектующих КАК ЦеныВНаборе
	               |			ПО ВТ_НоменклатураНабора.Комплектующая = ЦеныВНаборе.Номенклатура
	               |				И (ЦеныВНаборе.омг_Набор = &Набор)
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеЦеныКопмлектующих КАК ЦеныОбщие
	               |			ПО ВТ_НоменклатураНабора.Комплектующая = ЦеныОбщие.Номенклатура
	               |				И (ЦеныОбщие.омг_Набор = ЗНАЧЕНИЕ(Справочник.НОменклатура.ПустаяСсылка))
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_НоменклатураНабора.Комплектующая) КАК ВложенныйЗапрос
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.УстановитьПараметр("Набор", Набор);
	Запрос.УстановитьПараметр("Комплектующая", Комплектующая);
	Запрос.УстановитьПараметр("Филиалы", Филиалы);
	Запрос.УстановитьПараметр("ОсновнойПрейскурант", ОсновнойПрейскурант);
	Выборка = Запрос.Выполнить().Выбрать();
	
    Возврат Выборка;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере(Комплектующая = Неопределено)
	
	Выборка = ПолучитьВыборкуЦен(Набор, Филиалы, ОсновнойПрейскурант, Комплектующая);
	
	НоменклатураНабора.Очистить();
	
	Пока Выборка.Следующий() Цикл
		СтрокаНабора = НоменклатураНабора.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНабора, Выборка);
		Если Выборка.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор Тогда
			ВыборкаНаборВнаборе = ЗапросНаборВнаборе(Выборка.Номенклатура,Филиалы,ОсновнойПрейскурант); 
			НоменклатураНабораВложенныйНабор.Очистить(); 
			стрОТбора = Новый Структура;
			стрОТбора.Вставить("ВложенныйНабор",Выборка.Номенклатура);
			
			СтрокиУдаления = НоменклатураНабораВложенныйНаборВнутренний.НайтиСтроки(стрОТбора);  
			Для каждого строкаУдаления из СтрокиУдаления Цикл
				НоменклатураНабораВложенныйНаборВнутренний.Удалить(строкаУдаления);		
			КонецЦикла;		
			Пока ВыборкаНаборВнаборе.Следующий() Цикл
				СтрокаНабора = НоменклатураНабораВложенныйНаборВнутренний.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНабора, ВыборкаНаборВнаборе);
				СтрокаНабора.ВложенныйНабор = Выборка.Номенклатура; 
				СтрокаНабора = НоменклатураНабораВложенныйНабор.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНабора, ВыборкаНаборВнаборе);
				СтрокаНабора.ВложенныйНабор = Выборка.Номенклатура;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	ЗаполнитьПоУмолчаниюНаСервере();
	ПересчитатьИтогиЦен(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Филиалы = Параметры.Филиалы;
	Набор = Параметры.Набор;
	ТекущийПериод = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(Набор, "омг_ДатаНачалДействияНабора, омг_ДатаОкончанияДействияНабора");
	ПериодДействияНабора.ДатаНачала = ТекущийПериод.омг_ДатаНачалДействияНабора;
	ПериодДействияНабора.ДатаОкончания = ТекущийПериод.омг_ДатаОкончанияДействияНабора;
	ОсновнойПрейскурант = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ОсновнойПрейскурант");
	
	Для Каждого ЭлементМассива Из Параметры.МассивПозиций Цикл
		Если ЗначениеЗаполнено(ЭлементМассива.ВложенныйНабор) Тогда
			СтрокаТаблицы = НоменклатураНабораВложенныйНаборВнутренний.Добавить();	
		иначе	
			СтрокаТаблицы = НоменклатураНабора.Добавить(); 
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЭлементМассива);
	КонецЦикла;
	
	ПересчитатьИтогиЦен(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	МассивПозиций = Новый Массив;
	Для Каждого СтрокаТаблицы Из НоменклатураНабора Цикл
		СтруктураСтроки = Новый Структура("Номенклатура, ЦенаВНаборе, ЦенаОбщая, Коэффициент, Набор,ВложенныйНабор");
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТаблицы);     
		СтруктураСтроки.Набор = Набор; 
		МассивПозиций.Добавить(СтруктураСтроки);
	КонецЦикла;  
	
	Для Каждого СтрокаТаблицы Из НоменклатураНабораВложенныйНаборВнутренний Цикл
		СтруктураСтроки = Новый Структура("Номенклатура, ЦенаВНаборе, ЦенаОбщая, Коэффициент, Набор,ВложенныйНабор");
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТаблицы);     
		СтруктураСтроки.Набор = Набор; 
		МассивПозиций.Добавить(СтруктураСтроки);
	КонецЦикла;

	
	Закрыть(МассивПозиций);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныПоОбщим(Команда)
	
	Для Каждого СтрокаТаблицы Из НоменклатураНабора Цикл
		СтрокаТаблицы.ЦенаВНаборе = СтрокаТаблицы.ЦенаОбщая;
	КонецЦикла;
	
	ПересчитатьИтогиЦен(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьЦеныОднимКоэффициентом(Команда)
	
	Коэффициент = Ждать ВвестиЗначениеАсинх(0, "Коэффициент", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2)); 
	
	Для Каждого СтрокаТаблицы Из НоменклатураНабора Цикл
		СтрокаТаблицы.ЦенаВНаборе = СтрокаТаблицы.ЦенаОбщая * Коэффициент;
		СтрокаТаблицы.Коэффициент = Коэффициент;
	КонецЦикла;
	
	ПересчитатьИтогиЦен(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьИтогиЦен(ЭтаФорма)
	
	ЭтаФорма.Элементы.НоменклатураНабораЦенаОбщая.ТекстПодвала = ЭтаФорма.НоменклатураНабора.Итог("ЦенаОбщая");
	ЭтаФорма.Элементы.НоменклатураНабораЦена.ТекстПодвала = ЭтаФорма.НоменклатураНабора.Итог("ЦенаВНаборе");
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураНабораПриИзменении(Элемент)
	
	ПересчитатьИтогиЦен(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ЗапросНаборВнаборе(НаборНабор,Филиалы,ОсновнойПрейскурантНабор)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Набор", НаборНабор);
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураКомплектующиеНоменклатуры.Комплектующая КАК Комплектующая
	               |ПОМЕСТИТЬ ВТ_НоменклатураНабора
	               |ИЗ
	               |	Справочник.Номенклатура.КомплектующиеНоменклатуры КАК НоменклатураКомплектующиеНоменклатуры
	               |ГДЕ
	               |	НоменклатураКомплектующиеНоменклатуры.Ссылка = &Набор
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НоменклатураКомплектующиеНоменклатуры.Комплектующая
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НоменклатураНабора.Комплектующая КАК Номенклатура,
	               |	МАКСИМУМ(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)) КАК Цена,
	               |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.омг_Набор, НЕОПРЕДЕЛЕНО) КАК омг_Набор
	               |ПОМЕСТИТЬ ВТ_ВсеЦеныКопмлектующих
	               |ИЗ
	               |	ВТ_НоменклатураНабора КАК ВТ_НоменклатураНабора
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |				,
	               |				Номенклатура В
	               |						(ВЫБРАТЬ
	               |							ВТ_НоменклатураНабора.Комплектующая КАК Комплектующая
	               |						ИЗ
	               |							ВТ_НоменклатураНабора КАК ВТ_НоменклатураНабора)
	               |					И омг_Филиал В (&Филиалы)
	               |					И Прейскурант = &ОсновнойПрейскурант
	               |					И (омг_Набор = &Набор
	               |						ИЛИ омг_Набор = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))) КАК ЦеныНоменклатурыСрезПоследних
	               |		ПО ВТ_НоменклатураНабора.Комплектующая = ЦеныНоменклатурыСрезПоследних.Номенклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_НоменклатураНабора.Комплектующая,
	               |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.омг_Набор, НЕОПРЕДЕЛЕНО)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |	МАКСИМУМ(ВложенныйЗапрос.ЦенаВНаборе) КАК ЦенаВНаборе,
	               |	МАКСИМУМ(ВложенныйЗапрос.ЦенаОбщая) КАК ЦенаОбщая
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_НоменклатураНабора.Комплектующая КАК Номенклатура,
	               |		МАКСИМУМ(ЕСТЬNULL(ЦеныВНаборе.Цена, 0)) КАК ЦенаВНаборе,
	               |		МАКСИМУМ(ЕСТЬNULL(ЦеныОбщие.Цена, 0)) КАК ЦенаОбщая
	               |	ИЗ
	               |		ВТ_НоменклатураНабора КАК ВТ_НоменклатураНабора
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеЦеныКопмлектующих КАК ЦеныВНаборе
	               |			ПО ВТ_НоменклатураНабора.Комплектующая = ЦеныВНаборе.Номенклатура
	               |				И (ЦеныВНаборе.омг_Набор = &Набор)
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеЦеныКопмлектующих КАК ЦеныОбщие
	               |			ПО ВТ_НоменклатураНабора.Комплектующая = ЦеныОбщие.Номенклатура
	               |				И (ЦеныОбщие.омг_Набор = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_НоменклатураНабора.Комплектующая) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Номенклатура";
	Запрос.УстановитьПараметр("Набор", НаборНабор);
	Запрос.УстановитьПараметр("Филиалы", Филиалы);
	Запрос.УстановитьПараметр("ОсновнойПрейскурант", ОсновнойПрейскурантНабор);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;
		
КонецФункции


&НаКлиенте
Процедура НоменклатураНабораЦенаПриИзменении(Элемент)

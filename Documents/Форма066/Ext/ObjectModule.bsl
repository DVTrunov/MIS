
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОбращениеВСтационар") Тогда
		
		Клиент = ДанныеЗаполнения.Клиент;
		ДокументОснование = ДанныеЗаполнения.Ссылка;
		
		ДанныеКлиента = Документы.Форма066.ПолучитьДанныеКлиента(Клиент);
		Фамилия = ДанныеКлиента.Фамилия;
		Имя = ДанныеКлиента.Имя;
		Отчество = ДанныеКлиента.Отчество;
		Пол = ДанныеКлиента.Пол;
		ДатаРождения = ДанныеКлиента.ДатаРождения;
		МедицинскаяКарта = ДанныеЗаполнения.МедицинскаяКарта;
		СтраховойПолис = ДанныеКлиента.СтраховойПолис;
		Адрес = ДанныеКлиента.Адрес;
		Местность = ДанныеКлиента.Местность;
		ДокументКлиента = ДанныеКлиента.ДокументКлиента;
				
		ДанныеГоспитализации = Документы.ОбращениеВСтационар.ВычислитьПродолжительностьГоспитализации(ДокументОснование);
		ДатаВремяВыписки = ДанныеГоспитализации.ДатаВремяВыписки;
		ПродолжительностьГоспитализации = ДанныеГоспитализации.ПродолжительностьГоспитализации;
		
	КонецЕсли;
	
КонецПроцедуры

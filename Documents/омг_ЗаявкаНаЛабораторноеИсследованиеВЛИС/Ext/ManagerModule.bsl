	               |	ВТ_ВсеБиоматериалы.Номенклатура КАК Номенклатура,
	               |	ВТ_ВсеБиоматериалы.Проба КАК Проба,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕСТЬNULL(ВложенныйЗапрос.ВсегоБиоматериалов, 0) > 1
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ) КАК НеобходимВыборБиоматериала,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ВложенныйЗапрос.ВсегоБиоматериалов, 0) = 1
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ВТ_ВсеБиоматериалы.ПоУмолчанию
	               |	КОНЕЦ КАК ПоУмолчанию,
	               |	МАКСИМУМ(ВТ_ВсеБиоматериалы.Контейнер) КАК Контейнер,
	               |	ВТ_ВсеБиоматериалы.Набор КАК Набор,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕСТЬNULL(ВТ_ВсеБиоматериалы.омг_КоличествоИсследований, 99) > 0
	               |				ТОГДА ЕСТЬNULL(ВТ_ВсеБиоматериалы.омг_КоличествоИсследований, 99)
	               |			ИНАЧЕ ЕСТЬNULL(ВТ_ВсеБиоматериалы.Контейнер.омг_КоличествоИсследований, 99)
	               |		КОНЕЦ) КАК КоличествоИсследований,
	               |	МАКСИМУМ(ВТ_ВсеБиоматериалы.омг_КодГруппыЗабора) КАК КодГруппыЗабора,
	               |	ВТ_ВсеБиоматериалы.ПропускатьПриВыгрузкеВЛИС КАК ПропускатьПриВыгрузкеВЛИС,
	               |	ВТ_ВсеБиоматериалы.омг_КоличествоКонтейнеров КАК КоличествоКонтейнеров
	               |ИЗ
	               |	ВТ_ВсеБиоматериалы КАК ВТ_ВсеБиоматериалы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВТ_ВсеБиоматериалы.Номенклатура КАК Номенклатура,
	               |			ВТ_ВсеБиоматериалы.Проба КАК Проба,
	               |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ВсеБиоматериалы.Биоматериал) КАК ВсегоБиоматериалов
	               |		ИЗ
	               |			ВТ_ВсеБиоматериалы КАК ВТ_ВсеБиоматериалы
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТ_ВсеБиоматериалы.Проба,
	               |			ВТ_ВсеБиоматериалы.Номенклатура) КАК ВложенныйЗапрос
	               |		ПО ВТ_ВсеБиоматериалы.Номенклатура = ВложенныйЗапрос.Номенклатура
	               |			И ВТ_ВсеБиоматериалы.Проба = ВложенныйЗапрос.Проба
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ВсеБиоматериалы.Проба,
	               |	ВТ_ВсеБиоматериалы.Биоматериал,
	               |	ВТ_ВсеБиоматериалы.Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ВложенныйЗапрос.ВсегоБиоматериалов, 0) = 1
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ВТ_ВсеБиоматериалы.ПоУмолчанию
	               |	КОНЕЦ,
	               |	ВТ_ВсеБиоматериалы.Набор,
	               |	ВТ_ВсеБиоматериалы.ПропускатьПриВыгрузкеВЛИС,
	               |	ВТ_ВсеБиоматериалы.омг_КоличествоКонтейнеров
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Биоматериал,
	               |	КодГруппыЗабора
	               |ИТОГИ
	               |	МАКСИМУМ(НеобходимВыборБиоматериала),
	               |	МАКСИМУМ(ПоУмолчанию),
	               |	МАКСИМУМ(Контейнер),
	               |	МАКСИМУМ(КоличествоИсследований),
	               |	МАКСИМУМ(КодГруппыЗабора),
	               |	МАКСИМУМ(КоличествоКонтейнеров)
	               |ПО
	               |	Биоматериал,
	               |	Проба
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	ТаблицаУслуг = Новый ТаблицаЗначений;
	ТаблицаУслуг.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаУслуг.Колонки.Добавить("Проба", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	
	Для Каждого СтрокаМассива Из МассивУслуг Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаУслуг.Добавить(), СтрокаМассива);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаУслуг", ТаблицаУслуг);
	Запрос.УстановитьПараметр("Филиал", Филиал);
	РезультатЗапроса = Запрос.Выполнить();
	СписокБиоматериалов = Новый Массив;
	ВыборкаПоБиоматериалам = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоБиоматериалам.Следующий() Цикл
		
		ВыборкаПоПробам = ВыборкаПоБиоматериалам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоПробам.Следующий() Цикл
			МассивАнализов = Новый Массив;
			ВыборкаАнализов = ВыборкаПоПробам.Выбрать();
			Пока ВыборкаАнализов.Следующий() Цикл
				СтруктураАнализа = Новый Структура;
				СтруктураАнализа.Вставить("Номенклатура", ВыборкаАнализов.Номенклатура);
				СтруктураАнализа.Вставить("Набор", ВыборкаАнализов.Набор);
				СтруктураАнализа.Вставить("ПоУмолчанию", ВыборкаАнализов.ПоУмолчанию);
				СтруктураАнализа.Вставить("КоличествоИсследований", ВыборкаАнализов.КоличествоИсследований);
				СтруктураАнализа.Вставить("ГруппаЗабора", ВыборкаАнализов.КодГруппыЗабора);
				СтруктураАнализа.Вставить("ПропускатьПриВыгрузке", ВыборкаАнализов.ПропускатьПриВыгрузкеВЛИС);
				СтруктураАнализа.Вставить("КоличествоКонтейнеров", ВыборкаАнализов.КоличествоКонтейнеров);

				МассивАнализов.Добавить(СтруктураАнализа);
			КонецЦикла;
			
			СписокБиоматериалов.Добавить(Новый Структура("Биоматериал, Анализы, Проба, ПоУмолчанию, Контейнер, КоличествоИсследований, КоличествоКонтейнеров", 
				ВыборкаПоПробам.Биоматериал, МассивАнализов, 
				"", ВыборкаПоПробам.ПоУмолчанию, ВыборкаПоПробам.Контейнер, ВыборкаПоПробам.КоличествоИсследований, ВыборкаПоПробам.КоличествоКонтейнеров));
				
		КонецЦикла;
	КонецЦикла;
	
	Возврат СписокБиоматериалов;
	
КонецФункции

Процедура ДобавитьДанныеКонтейнераВТаблицы(Объект, ДанныеКонтейнера, ПропускатьПриВыгрузке = Ложь)
	
		ТекущаяГруппаЗабора = "";
		
		СтрокаТаблицы = Объект.Биоматериалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеКонтейнера);
		СтрокаТаблицы.Проба = Объект.НомерЗаявки;
		СтрокаТаблицы.КодСтроки = СтрокаТаблицы.НомерСтроки;
		СтрокаТаблицы.Проба = ДанныеКонтейнера.Проба;
		
		СчетчикАнализов = 0;
		ПерваяСтрока = Истина;
		
		Для Каждого ДанныеНоменклатуры Из ДанныеКонтейнера.Анализы Цикл
			
			КоличествоИсследований = ?(ЗначениеЗаполнено(ДанныеНоменклатуры.КоличествоИсследований), ДанныеНоменклатуры.КоличествоИсследований, ДанныеКонтейнера.КоличествоИсследований);
			
			Если (Не КоличествоИсследований = 0
				И СчетчикАнализов = КоличествоИсследований 
				Или Не ТекущаяГруппаЗабора = ДанныеНоменклатуры.ГруппаЗабора) И Не ПерваяСтрока Тогда
				
				СчетчикАнализов = 0;
				
				СтрокаТаблицы = Объект.Биоматериалы.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеКонтейнера);
				СтрокаТаблицы.Проба = Объект.НомерЗаявки;
				СтрокаТаблицы.КодСтроки = СтрокаТаблицы.НомерСтроки;
				СтрокаТаблицы.Проба = ДанныеКонтейнера.Проба;
				
				ТекущаяГруппаЗабора = ДанныеНоменклатуры.ГруппаЗабора;
				
			КонецЕсли;
			Если ПерваяСтрока Тогда
				ТекущаяГруппаЗабора = ДанныеНоменклатуры.ГруппаЗабора;
			КонецЕсли;
			СтрокаАнализов = Объект.АнализыПоКонтейнерам.Добавить();
			СтрокаАнализов.КодСтроки = СтрокаТаблицы.КодСтроки;
			СтрокаАнализов.Номенклатура = ДанныеНоменклатуры.Номенклатура;
			СтрокаАнализов.Набор = ДанныеНоменклатуры.Набор;
			СтрокаАнализов.ПропускатьПриВыгрузке = ?(ПропускатьПриВыгрузке, Истина, ДанныеНоменклатуры.ПропускатьПриВыгрузке);
			СчетчикАнализов = СчетчикАнализов + 1;
			
			ПерваяСтрока = Ложь;
		КонецЦикла;

	
КонецПроцедуры

Процедура ЗаполнитьТаблицуБиоматериаловПоАнализам(Объект, СписокКонтейнеров = Неопределено) Экспорт
	
	МассивУслуг = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из Объект.Анализы Цикл
		МассивУслуг.Добавить(Новый Структура("Номенклатура, Проба", СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Проба));
	КонецЦикла;
	
	Если СписокКонтейнеров = Неопределено Тогда
		СписокКонтейнеров = ПолучитьСписокКонтейнеров(МассивУслуг, Объект.Филиал);
	КонецЕсли;
	
	ПрошлыеСтроки = Новый Массив;
	
	
	
	Для Каждого СтрокаТаблицы Из Объект.Биоматериалы Цикл
		
		СтруктураСтроки = Новый Структура("Контейнер, Биоматериал, Проба");
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТаблицы);
		ПрошлыеСтроки.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Объект.Биоматериалы.Очистить();
	Объект.АнализыПоКонтейнерам.Очистить(); 
	
	
	
	
	Для Каждого ДанныеКонтейнера Из СписокКонтейнеров Цикл

		ДобавитьДанныеКонтейнераВТаблицы(Объект, ДанныеКонтейнера);
		Для Счетчик = 2 По ДанныеКонтейнера.КоличествоКонтейнеров Цикл
			ДобавитьДанныеКонтейнераВТаблицы(Объект, ДанныеКонтейнера, Истина);
		КонецЦикла;
		
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Объект.Биоматериалы Цикл
		Для Каждого СтруктураСтроки Из ПрошлыеСтроки Цикл
			Если СтруктураСтроки.Проба = "" Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТаблицы.Проба = ""
				И СтрокаТаблицы.Контейнер = СтруктураСтроки.Контейнер
				И СтрокаТаблицы.Биоматериал = СтруктураСтроки.Биоматериал Тогда
				СтрокаТаблицы.Проба = СтруктураСтроки.Проба;
				СтруктураСтроки.Проба = "";
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	
КонецПроцедуры

Функция ПроверкаБиоматериаловДозаказа(ПозицииДозаказа, ИсходныйЗаказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаДанныхДозаказа.Филиал КАК Филиал,
	               |	ТаблицаДанныхДозаказа.Номенклатура КАК Номенклатура,
	               |	ТаблицаДанныхДозаказа.Биоматериал КАК Биоматериал,
	               |	ТаблицаДанныхДозаказа.Контейнер КАК Контейнер,
	               |	ТаблицаДанныхДозаказа.КодСтроки КАК КодСтроки
	               |ПОМЕСТИТЬ ВТ_ТаблицаДанныхДозаказа
	               |ИЗ
	               |	&ТаблицаДанныхДозаказа КАК ТаблицаДанныхДозаказа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Номенклатура КАК Номенклатура,
	               |	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы.Контейнер КАК Контейнер,
	               |	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы.Биоматериал КАК Биоматериал,
	               |	ВнутренняяЛаборатория_СопоставлениеНоменклатуры.омг_КодГруппыЗабора КАК ГруппаЗабора,
	               |	ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Контейнер.омг_КоличествоИсследований КАК МаксКоличество,
	               |	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы.НомерСтроки КАК НомерСтроки,
	               |	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы.Проба КАК Проба
	               |ПОМЕСТИТЬ ВТ_ДанныеИсходнойЗаявки
	               |ИЗ
	               |	Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.АнализыПоКонтейнерам КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Биоматериалы КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы
	               |		ПО омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Ссылка = омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы.Ссылка
	               |			И омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.КодСтроки = омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы.КодСтроки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВнутренняяЛаборатория_СопоставлениеНоменклатуры КАК ВнутренняяЛаборатория_СопоставлениеНоменклатуры
	               |		ПО омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Номенклатура = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Номенклатура
	               |			И (омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы.Биоматериал = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Биоматериал)
	               |			И (омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСБиоматериалы.Контейнер = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Контейнер)
	               |			И омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Ссылка.Филиал = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.омг_Филиал
	               |ГДЕ
	               |	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИСАнализыПоКонтейнерам.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.НомерСтроки КАК НомерСтроки,
	               |	ВложенныйЗапрос.Биоматериал КАК Биоматериал,
	               |	ВложенныйЗапрос.Контейнер КАК Контейнер,
	               |	ВложенныйЗапрос.ГруппаЗабора КАК ГруппаЗабора,
	               |	ВложенныйЗапрос.ВсегоВКонтейнере КАК ВсегоВКонтейнере,
	               |	ВложенныйЗапрос.МаксКоличество КАК МаксКоличество,
	               |	ВложенныйЗапрос.Проба КАК Проба
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_ДанныеИсходнойЗаявки.НомерСтроки КАК НомерСтроки,
	               |		ВТ_ДанныеИсходнойЗаявки.Биоматериал КАК Биоматериал,
	               |		ВТ_ДанныеИсходнойЗаявки.Контейнер КАК Контейнер,
	               |		ВТ_ДанныеИсходнойЗаявки.ГруппаЗабора КАК ГруппаЗабора,
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ДанныеИсходнойЗаявки.Номенклатура) КАК ВсегоВКонтейнере,
	               |		ВТ_ДанныеИсходнойЗаявки.МаксКоличество КАК МаксКоличество,
	               |		ВТ_ДанныеИсходнойЗаявки.Проба КАК Проба
	               |	ИЗ
	               |		ВТ_ДанныеИсходнойЗаявки КАК ВТ_ДанныеИсходнойЗаявки
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_ДанныеИсходнойЗаявки.Контейнер,
	               |		ВТ_ДанныеИсходнойЗаявки.Биоматериал,
	               |		ВТ_ДанныеИсходнойЗаявки.ГруппаЗабора,
	               |		ВТ_ДанныеИсходнойЗаявки.МаксКоличество,
	               |		ВТ_ДанныеИсходнойЗаявки.НомерСтроки,
	               |		ВТ_ДанныеИсходнойЗаявки.Проба) КАК ВложенныйЗапрос
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Проба
	               |ИТОГИ
	               |	МАКСИМУМ(Биоматериал),
	               |	МАКСИМУМ(Контейнер),
	               |	МАКСИМУМ(ГруппаЗабора),
	               |	МАКСИМУМ(ВсегоВКонтейнере),
	               |	МАКСИМУМ(МаксКоличество),
	               |	МАКСИМУМ(Проба)
	               |ПО
	               |	НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаДанныхДозаказа.Номенклатура КАК Номенклатура,
	               |	ВТ_ТаблицаДанныхДозаказа.Биоматериал КАК Биоматериал,
	               |	ВТ_ТаблицаДанныхДозаказа.Контейнер КАК Контейнер,
	               |	ВнутренняяЛаборатория_СопоставлениеНоменклатуры.омг_КодГруппыЗабора КАК ГруппаЗабора,
	               |	ВТ_ТаблицаДанныхДозаказа.КодСтроки КАК КодСтроки
	               |ИЗ
	               |	ВТ_ТаблицаДанныхДозаказа КАК ВТ_ТаблицаДанныхДозаказа
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВнутренняяЛаборатория_СопоставлениеНоменклатуры КАК ВнутренняяЛаборатория_СопоставлениеНоменклатуры
	               |		ПО ВТ_ТаблицаДанныхДозаказа.Номенклатура = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Номенклатура
	               |			И ВТ_ТаблицаДанныхДозаказа.Биоматериал = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Биоматериал
	               |			И ВТ_ТаблицаДанныхДозаказа.Контейнер = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Контейнер
	               |			И ВТ_ТаблицаДанныхДозаказа.Филиал = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.омг_Филиал";
	
	ТаблицаДанныхДозаказа = Новый ТаблицаЗначений;
	ТаблицаДанныхДозаказа.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДанныхДозаказа.Колонки.Добавить("Биоматериал", Новый ОписаниеТипов("СправочникСсылка.ВнутренняяЛаборатория_Биоматериалы"));
	ТаблицаДанныхДозаказа.Колонки.Добавить("Контейнер", Новый ОписаниеТипов("СправочникСсылка.ВнутренняяЛаборатория_ВидыКонтейнеров"));
	ТаблицаДанныхДозаказа.Колонки.Добавить("Филиал", Новый ОписаниеТипов("СправочникСсылка.Филиалы"));
	ТаблицаДанныхДозаказа.Колонки.Добавить("КодСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	
	Для Каждого СтрокаДозаказа Из ПозицииДозаказа Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаДанныхДозаказа.Добавить(), СтрокаДозаказа);
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаДанныхДозаказа", ТаблицаДанныхДозаказа);
	Запрос.УстановитьПараметр("Ссылка", ИсходныйЗаказ);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	ИсследованияИсходнойЗаявки = ПакетРезультатов.Получить(2).Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДанныеДозаказа = ПакетРезультатов.Получить(3).Выбрать();
	
	ДозаказВозможен = Истина;
	
	ШтрихкодыПоСтрокам = Новый Соответствие;
	
	Пока ДанныеДозаказа.Следующий() Цикл
		
		ДоступноДляВыбора = Ложь;
		
		Для Каждого СтрокаКонтейнера Из ИсследованияИсходнойЗаявки.Строки Цикл
			
			Если Не СтрокаКонтейнера.Биоматериал = ДанныеДозаказа.Биоматериал
				Или Не СтрокаКонтейнера.Контейнер = ДанныеДозаказа.Контейнер Тогда
				Продолжить;
			КонецЕсли;
			
			ПодходящаяГруппаЗабора = Истина;
			
			ЕстьМесто = Истина;
			Если СтрокаКонтейнера.МаксКоличество > 0 Тогда
				ЕстьМесто = Ложь;
				Если СтрокаКонтейнера.МаксКоличество - СтрокаКонтейнера.ВсегоВКонтейнере > 1 Тогда
					ЕстьМесто = Истина;
					СтрокаКонтейнера.ВсегоВКонтейнере = СтрокаКонтейнера.ВсегоВКонтейнере + 1;
				КонецЕсли;
			КонецЕсли;
			
			Если Не ДанныеДозаказа.ГруппаЗабора = СтрокаКонтейнера.ГруппаЗабора Тогда
				ПодходящаяГруппаЗабора = Ложь;
			КонецЕсли;
			
			Если ПодходящаяГруппаЗабора И ЕстьМесто Тогда
				ДоступноДляВыбора = Истина;
				
				ШтрихкодыПоСтрокам.Вставить(ДанныеДозаказа.КодСтроки, СтрокаКонтейнера.Проба);
				
				Прервать;
			КонецЕсли;
			
		КонецЦикла;                                       
		
		Если Не ДоступноДляВыбора Тогда
			ДозаказВозможен = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("ДозаказВозможен, ШтрихкодыПоСтрокам", ДозаказВозможен, ШтрихкодыПоСтрокам);
	
КонецФункции

Процедура Печать(ТабДок, Ссылка) Экспорт
	
	Макет = Документы.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.ПолучитьМакет("Печать");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Дата КАК Дата,
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.ДатаРождения КАК ДатаРождения,
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.НомерНаправления КАК НомерНаправления,
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Пациент КАК Пациент,
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Филиал КАК Филиал,
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Анализы.(
	|		Номенклатура КАК Номенклатура
	|	) КАК Анализы,
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Филиал.Организация КАК Организация,
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Филиал.Организация.ИНН КАК БИН,
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.НомерЗаявки КАК НомерЗаявки,
	|	РАЗНОСТЬДАТ( омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.ДатаРождения,омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Дата, ГОД) КАК Лет
	|ИЗ
	|	Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС КАК омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС
	|ГДЕ
	|	омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Ссылка В(&Ссылка)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	//ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка"); 
	Шапка2 = Макет.ПолучитьОбласть("Шапка2");
    Подвал = Макет.ПолучитьОбласть("Подвал");
	ШтрихкодОбл = Макет.ПолучитьОбласть("ШтрихкодОбласть");

	//ОбластьАнализыШапка = Макет.ПолучитьОбласть("АнализыШапка");
	ОбластьАнализы = Макет.ПолучитьОбласть("СтрокаУслуга");
	ТабДок.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
			Штрихкод = ПолучитьКартинкуШтрихкода(Выборка.НомерЗаявки);
			Если Штрихкод <> Неопределено Тогда 
				Рис = ШтрихкодОбл.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
				Индекс = ШтрихкодОбл.Рисунки.Индекс(Рис);
				ШтрихкодОбл.Рисунки[Индекс].Картинка = Штрихкод;
				ШтрихкодОбл.Рисунки[Индекс].РазмерКартинки = РазмерКартинки.Растянуть;
				ШтрихкодОбл.Рисунки[Индекс].Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
				ШтрихкодОбл.Рисунки[Индекс].Расположить(ШтрихкодОбл.Область("Штрихкод"));
			КонецЕсли;

		Шапка.Параметры.Заполнить(Выборка);  
		Шапка.Параметры.телефон = Строка(КонтактнаяИнформацияСервер.ПолучитьКИОбъекта(Выборка.Филиал, Перечисления.ТипыКонтактнойИнформации.Телефон,,Истина));
		Шапка.Параметры.Адрес = Строка(КонтактнаяИнформацияСервер.ПолучитьКИОбъекта(Выборка.Филиал, Перечисления.ТипыКонтактнойИнформации.Адрес,,Истина));
		Шапка2.Параметры.Заполнить(Выборка);   
		Лет = ОбщегоНазначенияКлиентСервер.ПолучитьПолноеЧислоЛетСДаты(Дата(Выборка.ДатаРождения), Дата(Выборка.Дата));
		Шапка2.Параметры.ДатаРождения = "" + Формат(Шапка2.Параметры.ДатаРождения,"ДФ=dd.MM.yyyy") +" ( " + Лет +" л.)";
		ТабДок.Вывести(Шапка, Выборка.Уровень());
        ТабДок.Вывести(ШтрихкодОбл, Выборка.Уровень());
		ТабДок.Вывести(Шапка2, Выборка.Уровень());
		//ТабДок.Вывести(ОбластьАнализыШапка);
		ВыборкаАнализы = Выборка.Анализы.Выбрать();
		Пока ВыборкаАнализы.Следующий() Цикл
			ОбластьАнализы.Параметры.Заполнить(ВыборкаАнализы);
			ТабДок.Вывести(ОбластьАнализы, ВыборкаАнализы.Уровень());
		КонецЦикла;
        ТабДок.Вывести(Подвал, Выборка.Уровень());
		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
	//}}
КонецПроцедуры     

Функция ПолучитьКартинкуШтрихкода(Штрихкод)
	
	ПараметрыШтрихкода = Новый Структура;
	ПараметрыШтрихкода.Вставить("Ширина"            		, 165);
	ПараметрыШтрихкода.Вставить("Высота"            		, 45);
	ПараметрыШтрихкода.Вставить("ТипКода"           		, 99);
	ПараметрыШтрихкода.Вставить("ОтображатьТекст"   		, Истина);
	ПараметрыШтрихкода.Вставить("Штрихкод"					, Строка(Штрихкод));
	ПараметрыШтрихкода.Вставить("ВертикальноеВыравнивание"	, 2);
	Возврат МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);
	
КонецФункции

Процедура ОбновитьДополнительныеПоля(Объект) Экспорт
	
	МассивИсследований = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.Анализы Цикл
		МассивИсследований.Добавить(СтрокаТаблицы.Номенклатура);
	КонецЦикла;
	
	Запрос =  Новый Запрос;
	Запрос.УстановитьПараметр("МассивИсследований", МассивИсследований);
	Запрос.УстановитьПараметр("ВидНоменклатуры", Перечисления.ВидыНоменклатуры.Набор);
	Запрос.Текст ="ВЫБРАТЬ
	              |	НоменклатураКомплектующиеНоменклатуры.Комплектующая КАК Ссылка,
	              |	НоменклатураКомплектующиеНоменклатуры.Ссылка КАК Набор
	              |ПОМЕСТИТЬ ВТ_Исследования
	              |ИЗ
	              |	Справочник.Номенклатура.КомплектующиеНоменклатуры КАК НоменклатураКомплектующиеНоменклатуры
	              |ГДЕ
	              |	НоменклатураКомплектующиеНоменклатуры.Ссылка В(&МассивИсследований)
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	НоменклатураКомплектующиеНоменклатуры.Комплектующая,
	              |	НоменклатураКомплектующиеНоменклатуры.Ссылка
	              |
	              |ОБЪЕДИНИТЬ ВСЕ
	              |
	              |ВЫБРАТЬ
	              |	Номенклатура.Ссылка,
	              |	НЕОПРЕДЕЛЕНО
	              |ИЗ
	              |	Справочник.Номенклатура КАК Номенклатура
	              |ГДЕ
	              |	Номенклатура.Ссылка В(&МассивИсследований)
	              |	И НЕ Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	НоменклатураКомплектующиеНоменклатуры.Комплектующая КАК Комплектующая,
	              |	ВТ_Исследования.Ссылка КАК Набор
	              |ПОМЕСТИТЬ ВТ_ВложенныеКомплектующие
	              |ИЗ
	              |	ВТ_Исследования КАК ВТ_Исследования
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.КомплектующиеНоменклатуры КАК НоменклатураКомплектующиеНоменклатуры
	              |		ПО ВТ_Исследования.Ссылка = НоменклатураКомплектующиеНоменклатуры.Ссылка
	              |ГДЕ
	              |	НЕ ВТ_Исследования.Набор = НЕОПРЕДЕЛЕНО
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	омг_СоответствиеДопПолейНоменклатуре.Свойство КАК Свойство,
	              |	МАКСИМУМ(омг_СоответствиеДопПолейНоменклатуре.Обязательное) КАК Обязательное,
	              |	омг_СоответствиеДопПолейНоменклатуре.Объект КАК Номенклатура,
	              |	ВТ_Исследования.Набор КАК Набор
	              |ИЗ
	              |	(ВЫБРАТЬ
	              |		ВТ_Исследования.Ссылка КАК Ссылка,
	              |		ВТ_Исследования.Набор КАК Набор
	              |	ИЗ
	              |		ВТ_Исследования КАК ВТ_Исследования
	              |	
	              |	ОБЪЕДИНИТЬ ВСЕ
	              |	
	              |	ВЫБРАТЬ
	              |		ВТ_ВложенныеКомплектующие.Комплектующая,
	              |		ВТ_ВложенныеКомплектующие.Набор
	              |	ИЗ
	              |		ВТ_ВложенныеКомплектующие КАК ВТ_ВложенныеКомплектующие) КАК ВТ_Исследования
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.омг_СоответствиеДопПолейНоменклатуре КАК омг_СоответствиеДопПолейНоменклатуре
	              |		ПО ВТ_Исследования.Ссылка = омг_СоответствиеДопПолейНоменклатуре.Объект
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	омг_СоответствиеДопПолейНоменклатуре.Свойство,
	              |	омг_СоответствиеДопПолейНоменклатуре.Объект,
	              |	ВТ_Исследования.Набор
	              |ИТОГИ
	              |	МАКСИМУМ(Обязательное)
	              |ПО
	              |	Свойство";
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПоСвойствам = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВсеСвойства = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.ДополнительныеСведения Цикл
		
		ВсеСвойства.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	СтруктураПоиска = Новый Структура("Свойство");
	
	Пока ВыборкаПоСвойствам.Следующий() Цикл
		СтруктураПоиска.Свойство = ВыборкаПоСвойствам.Свойство;
		НайденыеСтроки = Объект.ДополнительныеСведения.НайтиСтроки(СтруктураПоиска);
		Если НайденыеСтроки.Количество() = 0 Тогда
			СтрокаТаблицы = Объект.ДополнительныеСведения.Добавить();
			СтрокаТаблицы.Свойство = ВыборкаПоСвойствам.Свойство;
			СтрокаТаблицы.Обязательное = ВыборкаПоСвойствам.Обязательное;
			Если ТипЗнч(Объект) = Тип("ФормаКлиентскогоПриложения") Тогда 
				ВыборкаПоНоменклатуре = ВыборкаПоСвойствам.Выбрать();
				
				Пока ВыборкаПоНоменклатуре.Следующий() Цикл
					
					Номенклатура = ?(ЗначениеЗаполнено(ВыборкаПоНоменклатуре.Набор), ВыборкаПоНоменклатуре.Набор, ВыборкаПоНоменклатуре.Номенклатура);
					
					СтрокаТаблицы.СписокНоменклатуры.Добавить(Номенклатура);
				КонецЦикла;
				
			КонецЕсли;
		Иначе 
			ВсеСвойства.Удалить(ВсеСвойства.Найти(НайденыеСтроки[0]));
		КонецЕсли;
		
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ВсеСвойства Цикл
		Объект.ДополнительныеСведения.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьЖурнал(ТекущийОбъект, Объект) Экспорт
	
	Для Каждого СтрокаЖурнала Из ТекущийОбъект.Журнал Цикл
		
		СтрокаЖурналаНаФорме = Объект.Журнал[СтрокаЖурнала.НомерСтроки - 1];
		
		ДанныеСтроки = СтрокаЖурнала.Детали.Получить();
		Если ТипЗнч(ДанныеСтроки) = Тип("Строка") Тогда
			СтрокаЖурналаНаФорме.ТекстОтвета = СтрокаЖурнала.Детали.Получить();
		ИначеЕсли ТипЗнч(ДанныеСтроки) = Тип("ФиксированнаяСтруктура") Тогда
			ДанныеСтроки.Свойство("ТекстЗапроса", СтрокаЖурналаНаФорме.ТекстЗапроса);
			ДанныеСтроки.Свойство("ТекстОтвета", СтрокаЖурналаНаФорме.ТекстОтвета);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьЖурнал(ТекущийОбъект, Объект) Экспорт
	
	Для Каждого СтрокаЖурнала Из Объект.Журнал Цикл
		
		СтруктураДанных = Новый ФиксированнаяСтруктура(Новый Структура("ТекстЗапроса, ТекстОтвета", СтрокаЖурнала.ТекстЗапроса, СтрокаЖурнала.ТекстОтвета));
		
		ДанныеСтроки = Новый ХранилищеЗначения(СтруктураДанных, Новый СжатиеДанных(9));
		
		СтрокаЖурналаОбъекта = ТекущийОбъект.Журнал[СтрокаЖурнала.НомерСтроки - 1];
		СтрокаЖурналаОбъекта.Детали = ДанныеСтроки;
		
	КонецЦикла;
	
КонецПроцедуры

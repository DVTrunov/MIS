
Функция СобратьДанныеЧеков(ДокументСсылка, НомерСекции, ВерсияФормата, СообщениеОбОшибке) Экспорт
	
	Если ДокументСсылка.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОказанияУслуг.ПродажаКлиенту") Тогда
		ТипРасчета = 1;		
	Иначе
		ТипРасчета = 2;	
	КонецЕсли;

	
	ПараметрыПечатиЧека = ПодготовитьПараметрыПечатиЧека(ДокументСсылка);
	
	РеквизитыПечатиЧека = ПараметрыПечатиЧека.РеквизитыПечатиЧека;
	Если РеквизитыПечатиЧека.Количество() = 0 Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РеквизитыПечатиЧека[0]);
			
	Реквизиты.Вставить("ТипРасчета",              ТипРасчета);
	Реквизиты.Вставить("НаименованиеВСтрокеЧека", НаименованиеВСтрокеЧека(Реквизиты));
	Реквизиты.Вставить("НомерСекции",             НомерСекции);
	Если ДокументСсылка.ПолученоНаличными > 0 Тогда      
	Реквизиты.Вставить("ТипОплаты",               Перечисления.ТипыОплатыККТ.Наличные);	
	Иначе	
	Реквизиты.Вставить("ТипОплаты",               Перечисления.ТипыОплатыККТ.Электронно);
	КонецЕсли;
	Реквизиты.Вставить("ДокументОснование",        ДокументСсылка);
	
	ПараметрыОперацииФискализацииЧека = омг_WebKassa.ПараметрыОперацииФискализацииЧека(Реквизиты, ПараметрыПечатиЧека, ВерсияФормата, СообщениеОбОшибке);
	
	//Данные по первичному чеку для возврата
	ЧекПродажи = Документы.ОказаниеУслуг.ПустаяСсылка();
	Если ТипЗнч(Реквизиты.Основание) = Тип("ДокументСсылка.ОказаниеУслуг") Тогда
		
		ЧекПродажи = Реквизиты.Основание; 
		
	КонецЕсли;

	ПараметрыОперацииФискализацииЧека.Вставить("ДанныеПервичногоЧека", ПодключаемоеОборудованиеБКВызовСервера.СтруктураФискальнойОперацииРК());
	ПараметрыОперацииФискализацииЧека.Вставить("ЧекПродажи", ЧекПродажи);
	
	Возврат ПараметрыОперацииФискализацииЧека;  
	
КонецФункции

Функция НаименованиеВСтрокеЧека(СтруктураШапки)
	
	Если ЗначениеЗаполнено(СтруктураШапки.ПринятоОт) Тогда
		
		ШаблонНаименования = НСтр("ru = 'Оплата от: %1%2Основание: %3'");
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонНаименования, СтруктураШапки.ПринятоОт, " ", СтруктураШапки.Основание);
		
	Иначе
		
		ШаблонНаименования = НСтр("ru = 'Основание: %1'");
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонНаименования, СтруктураШапки.Основание);
		
	КонецЕсли;
	
КонецФункции

Функция ТекстЗапросаРеквизитыПечатиЧека(НомераТаблиц)
	
	НомераТаблиц.Вставить("РеквизитыПечатиЧека",      НомераТаблиц.Количество());
	НомераТаблиц.Вставить("РасшифровкаПлатежа",       НомераТаблиц.Количество());
		
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Заявка.Ссылка КАК Ссылка,
	|	Заявка.Дата КАК Дата,
	|	Заявка.Номер КАК Номер,
	|	Заявка.Филиал.Организация КАК Организация,
	|	"""" КАК Основание,
	|	"""" КАК ВидОперации,
	|	"""" КАК Контрагент,
	|	"""" КАК ПринятоОт,
	|	Заявка.СуммаДокумента КАК СуммаДокумента,
	|	"""" КАК ВалютаДокумента,
	|	"""" КАК ДокументРасшифровкиПозиций,
	|	Заявка.Пациент.ИНН КАК ПолучательИИН
	|ИЗ
	|	Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС КАК Заявка
	|ГДЕ
	|	Заявка.Ссылка = &Заявка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявкаАнализы.Номенклатура.НаименованиеПолное КАК Ссылка,
	|	"""" КАК ДоговорКонтрагента,
	|	"""" КАК СтавкаНДС,
	|	"""" КАК СуммаНДС,
	|	ЗаявкаАнализы.Цена - ЗаявкаАнализы.СуммаСкидки КАК СуммаПлатежа,
	|	ЗаявкаАнализы.Цена - ЗаявкаАнализы.СуммаСкидки КАК СуммаВзаиморасчетов
	|ИЗ
	|	Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Анализы КАК ЗаявкаАнализы
	|ГДЕ
	|	ЗаявкаАнализы.Ссылка = &Заявка";
	
	Возврат ТекстЗапроса + омг_WebKassa.ТекстРазделителяЗапросовПакета();
КонецФункции

Функция ПодготовитьПараметрыПечатиЧека(ДокументСсылка)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", омг_WebKassa.ПолучитьВалютуРегламентированногоУчета());
	
	НомераТаблиц = Новый Структура;
	
	Запрос.Текст = ТекстЗапросаРеквизитыПечатиЧека(НомераТаблиц) ;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ПараметрыПечатиЧека = Новый Структура;
	Для каждого НомерТаблицы Из НомераТаблиц Цикл
		ПараметрыПечатиЧека.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
	Возврат ПараметрыПечатиЧека;
КонецФункции

Функция ПолучитьДанныеПациента(Пациент) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Клиенты.Ссылка КАК Пациент,
	               |	Клиенты.Фамилия КАК Фамилия,
	               |	Клиенты.Имя КАК Имя,
	               |	Клиенты.Отчество КАК Отчество,
	               |	Клиенты.Пол КАК Пол,
	               |	Клиенты.омг_МестоПрикрепления КАК МестоПрикрепления,
	               |	Клиенты.ДатаРождения КАК ДатаРождения,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	               |				ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК СТРОКА(1000))
	               |			ИНАЧЕ """"
	               |		КОНЕЦ) КАК Адрес,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	               |				ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК СТРОКА(1000))
	               |			ИНАЧЕ """"
	               |		КОНЕЦ) КАК НомерТелефона,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	               |				ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК СТРОКА(1000))
	               |			ИНАЧЕ """"
	               |		КОНЕЦ) КАК АдресЭлПочты,
	               |	ВложенныйЗапрос.НомерКарты КАК НомерКарты,
	               |	ВложенныйЗапрос.Скидка КАК Скидка
	               |ИЗ
	               |	Справочник.Клиенты КАК Клиенты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |		ПО (КонтактнаяИнформация.Объект = Клиенты.Ссылка)
	               |			И (КонтактнаяИнформация.Тип В (&ТипыКИ))
	               |			И (КонтактнаяИнформация.Вид В (&ВидыКИ))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	               |			Клиентыомг_КартыСкидок.Карта КАК НомерКарты,
	               |			Клиентыомг_КартыСкидок.Карта.ВидКарты КАК Скидка,
	               |			Клиентыомг_КартыСкидок.НомерСтроки КАК НомерСтроки
	               |		ИЗ
	               |			Справочник.Клиенты.омг_КартыСкидок КАК Клиентыомг_КартыСкидок
	               |		ГДЕ
	               |			Клиентыомг_КартыСкидок.Ссылка = &Пациент
	               |		
	               |		УПОРЯДОЧИТЬ ПО
	               |			НомерКарты УБЫВ) КАК ВложенныйЗапрос
	               |		ПО (ИСТИНА)
	               |ГДЕ
	               |	Клиенты.Ссылка = &Пациент
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Клиенты.Ссылка,
	               |	Клиенты.Фамилия,
	               |	Клиенты.Имя,
	               |	Клиенты.Отчество,
	               |	Клиенты.Пол,
	               |	Клиенты.омг_МестоПрикрепления,
	               |	Клиенты.ДатаРождения,
	               |	ВложенныйЗапрос.НомерКарты,
	               |	ВложенныйЗапрос.Скидка";
	Запрос.УстановитьПараметр("Пациент", Пациент);
	ТипыКИ = Новый Массив;
	ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.Адрес);
	ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.Телефон);
	ВидыКИ = Новый Массив;
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	Запрос.УстановитьПараметр("ТипыКИ", ТипыКИ);
	Запрос.УстановитьПараметр("ВидыКИ", ВидыКИ);
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДанных = Новый Структура;
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		СтруктураДанных.Вставить(Колонка.Имя);
	КонецЦикла;
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтруктураДанных[Колонка.Имя] = Выборка[Колонка.Имя]; 
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.НомерТелефона) Тогда
		СтруктураДанных.НомерТелефона = Прав(омг_ИнтеграцияСЛИСОбщегоНазначенияКлиентСервер.УбратьСимволыИзТелефона(СтруктураДанных.НомерТелефона), 11);
	КонецЕсли;

	Возврат СтруктураДанных;
	
КонецФункции

Процедура ПересчитатьИтоги(Объект, Форма = Неопределено) Экспорт
	
	Возврат;
	
	Если Форма = Неопределено Тогда
		Форма = Новый Структура("ИтогоСоСкидкой, СуммаСкидки", 0, 0);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(РазмерыСкидокСрезПоследних.Фильтр) = ТИП(Справочник.ВидыКартСкидок)
	               |			ТОГДА ""Карта""
	               |		ИНАЧЕ РазмерыСкидокСрезПоследних.Фильтр
	               |	КОНЕЦ КАК Фильтр,
	               |	РазмерыСкидокСрезПоследних.Номенклатура КАК Номенклатура,
	               |	РазмерыСкидокСрезПоследних.ПроцентСкидки КАК ПроцентСкидки,
	               |	ЛОЖЬ КАК Эксклюзивная,
	               |	ВЫБОР
	               |		КОГДА НЕ РазмерыСкидокСрезПоследних.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК Порядок
	               |ИЗ
	               |	РегистрСведений.РазмерыСкидок.СрезПоследних(, Фильтр В (&Фильтр)) КАК РазмерыСкидокСрезПоследних
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	омг_ДополнительныеСкидки.Ссылка,
	               |	NULL,
	               |	омг_ДополнительныеСкидки.Размер,
	               |	омг_ДополнительныеСкидки.Эксклюзивная,
	               |	0
	               |ИЗ
	               |	Справочник.омг_ДополнительныеСкидки КАК омг_ДополнительныеСкидки
	               |ГДЕ
	               |	омг_ДополнительныеСкидки.Ссылка В(&Фильтр)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""Карта"",
	               |	NULL,
	               |	ВидыСкидокРазмерыСкидки.Размер,
	               |	ЛОЖЬ,
	               |	ВЫБОР
	               |		КОГДА ДействиеСкидок.Филиал = &Филиал
	               |			ТОГДА -2
	               |		ИНАЧЕ -1
	               |	КОНЕЦ
	               |ИЗ
	               |	РегистрСведений.ДействиеСкидок КАК ДействиеСкидок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыСкидок.РазмерыСкидки КАК ВидыСкидокРазмерыСкидки
	               |		ПО ДействиеСкидок.ВидСкидки = ВидыСкидокРазмерыСкидки.Ссылка
	               |ГДЕ
	               |	(ДействиеСкидок.Филиал = &Филиал
	               |			ИЛИ ДействиеСкидок.Филиал = ЗНАЧЕНИЕ(Справочник.Филиалы.ПустаяСсылка))
	               |	И ДействиеСкидок.Получатель В(&Фильтр)
	               |	И ВЫБОР
	               |			КОГДА НЕ ДействиеСкидок.ДатаНачалаДействия = &ПустаяДата
	               |					ИЛИ НЕ ДействиеСкидок.ДатаОкончанияДействия = &ПустаяДата
	               |				ТОГДА ВЫБОР
	               |						КОГДА &ДатаДокумента МЕЖДУ ДействиеСкидок.ДатаНачалаДействия И ВЫБОР
	               |								КОГДА ДействиеСкидок.ДатаОкончанияДействия = &ПустаяДата
	               |									ТОГДА &ДатаДокумента
	               |								ИНАЧЕ ДействиеСкидок.ДатаОкончанияДействия
	               |							КОНЕЦ
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Порядок,
	               |	ПроцентСкидки";
	Фильтр = Новый Массив;
	Фильтр.Добавить(Объект.Скидка);
	Фильтр.Добавить(Объект.ДопСкидка1);
	Фильтр.Добавить(Объект.ДопСкидка2);
	Фильтр.Добавить(Объект.НомерКарты);
	Запрос.УстановитьПараметр("Фильтр", Фильтр);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	Запрос.УстановитьПараметр("Филиал", Объект.Филиал);
	Запрос.УстановитьПараметр("ДатаДокумента", ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()));
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаСкидок = РезультатЗапроса.Выбрать();
	
	Форма.ИтогоСоСкидкой = 0;
	Форма.СуммаСкидки = 0;
	
	Для Каждого СтрокаТаблицы Из Объект.Анализы Цикл
		
		ВыборкаСкидок.Сбросить();
		СтрокаТаблицы.СуммаСкидки = 0;
		Если ВыборкаСкидок.НайтиСледующий(СтрокаТаблицы.Номенклатура, "Номенклатура") Тогда
			Форма.СуммаСкидки = Форма.СуммаСкидки + (СтрокаТаблицы.Цена * ВыборкаСкидок.ПроцентСкидки / 100);
			Продолжить;
		КонецЕсли;
		ВыборкаСкидок.Сбросить();
		Если ВыборкаСкидок.НайтиСледующий(Объект.ДопСкидка2, "Фильтр") Тогда
			
			СтрокаТаблицы.СуммаСкидки = (СтрокаТаблицы.Цена * ВыборкаСкидок.ПроцентСкидки / 100);
		
			Форма.СуммаСкидки = Форма.СуммаСкидки + СтрокаТаблицы.СуммаСкидки;
			Продолжить;
		КонецЕсли;
		
		ПроцентСкидки1 = 0;
		ПроцентСкидки2 = 0;
		
		ВыборкаСкидок.Сбросить();
		Если ВыборкаСкидок.НайтиСледующий("Карта", "Фильтр") Тогда
			
			ПроцентСкидки1 = ВыборкаСкидок.ПроцентСкидки;
			
			СтрокаТаблицы.СуммаСкидки = СтрокаТаблицы.СуммаСкидки + (СтрокаТаблицы.Цена * ПроцентСкидки1 / 100);
			
		КонецЕсли;
		ВыборкаСкидок.Сбросить();
		Если ВыборкаСкидок.НайтиСледующий(Объект.ДопСкидка1, "Фильтр") Тогда
			
			ПроцентСкидки2 = ВыборкаСкидок.ПроцентСкидки;
			
			СтрокаТаблицы.СуммаСкидки = СтрокаТаблицы.СуммаСкидки + (СтрокаТаблицы.Цена * ПроцентСкидки2 / 100);		

		КонецЕсли;
		
		Форма.СуммаСкидки = Форма.СуммаСкидки + СтрокаТаблицы.СуммаСкидки;
		Форма.ИтогоСоСкидкой = Форма.ИтогоСоСкидкой + СтрокаТаблицы.Цена;
		
	КонецЦикла;
	
	Форма.ИтогоСоСкидкой = Форма.ИтогоСоСкидкой - Форма.СуммаСкидки;
	Объект.СуммаДокумента = Форма.ИтогоСоСкидкой;
	
	Объект.ОплаченоБезналичным = Объект.СуммаДокумента;
	Объект.ПолученоНаличными = 0;
	Объект.Сдача = 0;
	
КонецПроцедуры



&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	мУчетнаяПолитика = УправлениеНастройками.ПолучитьУчетнуюПолитику();

	СтруктураПараметров = РаботаСФормамиСервер.ФормаДокументаПриОткрытииСервер(ЭтаФорма, Ложь);
	
	Подбор.Параметры.УстановитьЗначениеПараметра("Филиал", Объект.Филиал);
	ОсновнойПрейскурант = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ОсновнойПрейскурант");
	Подбор.Параметры.УстановитьЗначениеПараметра("ОсновнойПрейскурант", ОсновнойПрейскурант);

	Если Параметры.Ключ.Пустая() Тогда 
		
		Объект.ЭквайринговыйТерминал = РаботаСТорговымОборудованием.ПолучитьЭквайринговыйТерминал(, Объект.Филиал, Объект.Касса);
	КонецЕсли;
	
	Элементы.Врач.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	Элементы.Врач.ДоступныеТипы = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	Элементы.Статус.ТолькоПросмотр = Не РольДоступна("ПолныеПрава") И Не РольДоступна("омг_ПравоРедактированияСтатусаЗаявкиВЛИС");
	Элементы.ИдентификаторЛИС.ТолькоПросмотр = Не РольДоступна("ПолныеПрава") И Не РольДоступна("омг_ПравоРедактированияСтатусаЗаявкиВЛИС");
	
	УстановитьДоступность(ЭтаФорма);   
	УстановитьПараметрыСписков();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыСписков()
	
	БланкиРезультатовИсследования.Параметры.УстановитьЗначениеПараметра("Заявка", Параметры.Ключ);
	Ошибки.Параметры.УстановитьЗначениеПараметра("Заявка", Параметры.Ключ);
	ОшибкиОбновленияСтатуса.Параметры.УстановитьЗначениеПараметра("Документ", Объект.Ссылка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоЗаписейТаблиц(Заявка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ омг_БланкиРезультатовИсследованийЛИС.ИдентификаторБланка) КАК КоличествоБланки,
	               |	омг_БланкиРезультатовИсследованийЛИС.Заявка КАК Заявка
	               |ИЗ
	               |	РегистрСведений.омг_БланкиРезультатовИсследованийЛИС КАК омг_БланкиРезультатовИсследованийЛИС
	               |ГДЕ
	               |	омг_БланкиРезультатовИсследованийЛИС.Заявка = &Заявка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	омг_БланкиРезультатовИсследованийЛИС.Заявка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ омг_ОшибкиОтправкиЗаявокЛИС.Период) КАК КоличествоОшибки,
	               |	омг_ОшибкиОтправкиЗаявокЛИС.Заявка КАК Заявка
	               |ИЗ
	               |	РегистрСведений.омг_ОшибкиОтправкиЗаявокЛИС КАК омг_ОшибкиОтправкиЗаявокЛИС
	               |ГДЕ
	               |	омг_ОшибкиОтправкиЗаявокЛИС.Заявка = &Заявка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	омг_ОшибкиОтправкиЗаявокЛИС.Заявка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ омг_ЖурналЗапросовПоЗаявкамЛИС.Период) КАК КоличествоЖурнал,
	               |	омг_ЖурналЗапросовПоЗаявкамЛИС.Заявка КАК Заявка
	               |ИЗ
	               |	РегистрСведений.омг_ЖурналЗапросовПоЗаявкамЛИС КАК омг_ЖурналЗапросовПоЗаявкамЛИС
	               |ГДЕ
	               |	омг_ЖурналЗапросовПоЗаявкамЛИС.Заявка = &Заявка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	омг_ЖурналЗапросовПоЗаявкамЛИС.Заявка";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	СтруктураКоличества = Новый Структура("КоличествоБланки, КоличествоОшибки, КоличествоЖурнал", 0, 0, 0);
	
	Для Каждого РезультатЗапроса Из ПакетРезультатов Цикл
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураКоличества, Выборка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураКоличества;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКоличествоДляЗаголовковСтраниц(ЭтаФорма)
	
	СтруктураКоличества = ПолучитьКоличествоЗаписейТаблиц(ЭтаФорма.Объект.Ссылка);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураКоличества);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЖурналЗапросов(Заявка)
	
	МассивЗаписей = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_ЖурналЗапросовПоЗаявкамЛИС.Период КАК Дата,
	               |	омг_ЖурналЗапросовПоЗаявкамЛИС.Детали КАК Детали
	               |ИЗ
	               |	РегистрСведений.омг_ЖурналЗапросовПоЗаявкамЛИС КАК омг_ЖурналЗапросовПоЗаявкамЛИС
	               |ГДЕ
	               |	омг_ЖурналЗапросовПоЗаявкамЛИС.Заявка = &Заявка";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеЗаписи = Выборка.Детали.Получить();
			Если ДанныеЗаписи = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтруктураЗаписи = Новый Структура("Дата, ТекстЗапроса, ТекстОтвета", Выборка.Дата);
			
			ЗаполнитьЗначенияСвойств(СтруктураЗаписи, ДанныеЗаписи);
			МассивЗаписей.Добавить(СтруктураЗаписи);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивЗаписей;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступность(ЭтаФорма)
	
	ЗаявкаЗакрыта = ЭтаФорма.Объект.Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыЗаякиНаЛабИсследованиеВЛИС.Закрыта")
		Или ЭтаФорма.Объект.Статус = ПредопределенноеЗначение("Перечисление.омг_СтатусыЗаякиНаЛабИсследованиеВЛИС.Отменена");
		
	ОбъектЗаписан = Не ЭтаФорма.Параметры.Ключ.Пустая();
		
	ЭтаФорма.Элементы.ОтменитьЗаявку.Доступность = Не ЗаявкаЗакрыта И ЭтаФорма.Элементы.ФормаПроизвестиЗаборМатериалов.Доступность;
	ЭтаФорма.Элементы.ЗакрытьЗаявку.Доступность = Не ЗаявкаЗакрыта И ЭтаФорма.Элементы.ФормаПроизвестиЗаборМатериалов.Доступность;
	ЭтаФорма.Элементы.ГруппаРезультатыЛИС.Доступность = ОбъектЗаписан;
	ЭтаФорма.Элементы.ГруппаЖурнал.Доступность = ОбъектЗаписан;
	
КонецПроцедуры


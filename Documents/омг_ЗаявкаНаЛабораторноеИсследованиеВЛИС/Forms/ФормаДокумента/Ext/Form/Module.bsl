&НаКлиенте
Асинх Функция СканированиеШтрихкода()
	
	Штрихкод = Ждать ВвестиСтрокуАсинх(, "Введите штрихкод", 50);
	
	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат "";
	КонецЕсли;
	
	СимволыКЗ = "әіңғ,.үұқ";
	СимволыКЗ = """" + СимволыКЗ + ВРег(СимволыКЗ);
	Числа = "1234567890234567890";
	
	Для НСтроки = 1 По СтрДлина(Штрихкод) Цикл
		СимволШтрихкода = Сред(Штрихкод, НСтроки, 1);
		НСимволаКЗ = СтрНайти(СимволыКЗ, СимволШтрихкода);
		Если НСимволаКЗ > 0 Тогда
			СимволЧисло = Сред(Числа, НСимволаКЗ, 1);
			Штрихкод = СтрЗаменить(Штрихкод, СимволШтрихкода, СимволЧисло);
		КонецЕсли;
	КонецЦикла;

	Возврат Штрихкод;
	
КонецФункции

&НаКлиенте
Асинх Процедура СканироватьШтрихкодЗаявки(Команда)
	
    Штрихкод = Ждать СканированиеШтрихкода();
	
	Если Штрихкод = "" Тогда
		Возврат;
	КонецЕсли;
	
	Объект.НомерЗаявки = Штрихкод;
	
	Записать();
	
КонецПроцедуры


&НаКлиенте
Асинх Процедура СканироватьШтрихкодКонтейнера(Команда)
	
	Если Элементы.Биоматериалы.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Штрихкод = Ждать СканированиеШтрихкода();
	
	Если Штрихкод = "" Тогда
		Возврат;
	КонецЕсли;

	Элементы.Биоматериалы.ТекущиеДанные.Проба = Штрихкод;
	
	Модифицированность = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьШтрихкод(Команда)
	Если Элементы.Биоматериалы.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	Элементы.Биоматериалы.ТекущиеДанные.Проба = "";
КонецПроцедуры


&НаКлиенте
Процедура ПодборВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Подбор.ТекущиеДанные;
	
	Если Объект.Анализы.НайтиСтроки(Новый Структура("Номенклатура", ТекущиеДанные.Номенклатура)).Количество() = 0 Тогда
		СтрокаАнализов = Объект.Анализы.Добавить();
		СтрокаАнализов.Номенклатура = ТекущиеДанные.Номенклатура;
		СтрокаАнализов.Цена = ТекущиеДанные.Цена;
		
		ПересчитатьИтоги();
	КонецЕсли;
	
КонецПроцедуры


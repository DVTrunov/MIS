&НаКлиенте
Процедура Обработчик_ПослеОтметкиАнализовДляКонтейнеров(СписокЗначений, ДопПараметры) Экспорт
	
	Если СписокЗначений = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("КодСтроки", Элементы.Биоматериалы.ТекущиеДанные.КодСтроки);
	
	НайденныеСтроки = Объект.АнализыПоКонтейнерам.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		НайденноеЗначение = СписокЗначений.НайтиПоЗначению(СтрокаТаблицы.Номенклатура);
		Если НайденноеЗначение = Неопределено Или Не НайденноеЗначение.Пометка Тогда
			Объект.АнализыПоКонтейнерам.Удалить(СтрокаТаблицы);
		КонецЕсли;                                             
		
	КонецЦикла;
	
	Для Каждого ПозицияСписка Из СписокЗначений Цикл
		Если ПозицияСписка.Пометка Тогда
			
			
			Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
				Если СтрокаТаблицы.Номенклатура = ПозицияСписка.Значение Тогда
					ПозицияСписка.Пометка = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			Если ПозицияСписка.Пометка Тогда
				СтрокаТаблицы = Объект.АнализыПоКонтейнерам.Добавить();
				СтрокаТаблицы.КодСтроки = СтруктураПоиска.КодСтроки;
				СтрокаТаблицы.Номенклатура = ПозицияСписка.Значение;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла; 
	
	ОбновитьВременныеРеквизитыТабличныхЧастей(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура БиоматериалыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.БиоматериалыСостав Тогда
		
		СтруктураПоиска = Новый Структура("КодСтроки", Элементы.Биоматериалы.ТекущиеДанные.КодСтроки);
		
		СписокВыбора = Новый СписокЗначений;
		
		Для Каждого СтрокаТаблицы Из Объект.АнализыПоКонтейнерам Цикл
			Если СписокВыбора.НайтиПоЗначению(СтрокаТаблицы.Номенклатура) = Неопределено Тогда 
				СписокВыбора.Добавить(СтрокаТаблицы.Номенклатура);
			КонецЕсли;
		КонецЦикла;
		
		ОтмеченныеСтроки = Объект.АнализыПоКонтейнерам.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрокаТаблицы Из ОтмеченныеСтроки Цикл
			НайденноеЗначение = СписокВыбора.НайтиПоЗначению(СтрокаТаблицы.Номенклатура);
			Если Не НайденноеЗначение = Неопределено Тогда
				НайденноеЗначение.Пометка = Истина;
			Иначе 
				СтрокаТаблицы.КодСтроки = -1;
			КонецЕсли;
		КонецЦикла;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеОтметкиАнализовДляКонтейнеров", ЭтаФорма);
		СписокВыбора.ПоказатьОтметкуЭлементов(ОписаниеОповещения, "Анализы");
		
	КонецЕсли;
	
КонецПроцедуры


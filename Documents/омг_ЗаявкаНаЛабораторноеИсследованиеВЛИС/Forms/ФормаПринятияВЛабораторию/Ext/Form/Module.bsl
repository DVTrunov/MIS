
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Документ = Параметры.Ссылка;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	0 КАК Индекс
	               |ПОМЕСТИТЬ ВТ_ТаблицаСчетчик
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	1
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	2
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	3
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |ПОМЕСТИТЬ ВТ_Настройки
	               |ИЗ
	               |	РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОказаниеУслугРаботы.омг_НаправившийВрач КАК НаправившийВрач,
	               |	ВЫБОР
	               |		КОГДА НЕ ОказаниеУслугРаботы.омг_НаборЛИС = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |			ТОГДА ОказаниеУслугРаботы.омг_НаборЛИС
	               |		КОГДА ОказаниеУслугРаботы.омг_Набор = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |				ИЛИ НЕ ОказаниеУслугРаботы.омг_Набор В ИЕРАРХИИ
	               |						(ВЫБРАТЬ
	               |							ВТ_Настройки.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |						ИЗ
	               |							ВТ_Настройки КАК ВТ_Настройки)
	               |			ТОГДА ОказаниеУслугРаботы.Номенклатура
	               |		ИНАЧЕ ОказаниеУслугРаботы.омг_Набор
	               |	КОНЕЦ КАК Номенклатура,
	               |	ОказаниеУслугРаботы.Сумма КАК Цена,
	               |	ОказаниеУслугРаботы.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА ОказаниеУслугРаботы.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
	               |			ТОГДА 0
	               |		ИНАЧЕ ОказаниеУслугРаботы.Количество
	               |	КОНЕЦ КАК Количество
	               |ПОМЕСТИТЬ ВТ_ИсследованияОказанияУслуг
	               |ИЗ
	               |	Документ.ОказаниеУслуг.Работы КАК ОказаниеУслугРаботы
	               |ГДЕ
	               |	ОказаниеУслугРаботы.Ссылка = &Ссылка
	               |	И ОказаниеУслугРаботы.Номенклатура В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				ВТ_Настройки.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |			ИЗ
	               |				ВТ_Настройки КАК ВТ_Настройки)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Анализы.НаправившийВрач КАК НаправившийВрач,
	               |	ВТ_Анализы.Номенклатура КАК Номенклатура,
	               |	ВТ_Анализы.Цена КАК Цена,
	               |	ВТ_Анализы.Ссылка КАК Ссылка,
	               |	1 КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ВТ_Анализы.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
	               |			ТОГДА 0
	               |		ИНАЧЕ ВТ_ТаблицаСчетчик.Индекс
	               |	КОНЕЦ КАК Индекс
	               |ПОМЕСТИТЬ ВТ_Анализы
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ОказаниеУслугРаботы.НаправившийВрач КАК НаправившийВрач,
	               |		ОказаниеУслугРаботы.Номенклатура КАК Номенклатура,
	               |		СУММА(ОказаниеУслугРаботы.Цена) КАК Цена,
	               |		ОказаниеУслугРаботы.Ссылка КАК Ссылка,
	               |		СУММА(ОказаниеУслугРаботы.Количество) КАК Количество
	               |	ИЗ
	               |		ВТ_ИсследованияОказанияУслуг КАК ОказаниеУслугРаботы
	               |	ГДЕ
	               |		ОказаниеУслугРаботы.Ссылка = &Ссылка
	               |		И ОказаниеУслугРаботы.Номенклатура В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					ВТ_Настройки.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |				ИЗ
	               |					ВТ_Настройки КАК ВТ_Настройки)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ОказаниеУслугРаботы.Ссылка,
	               |		ОказаниеУслугРаботы.Номенклатура,
	               |		ОказаниеУслугРаботы.НаправившийВрач) КАК ВТ_Анализы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаСчетчик КАК ВТ_ТаблицаСчетчик
	               |		ПО (ВТ_Анализы.Количество >= ВТ_ТаблицаСчетчик.Индекс + 1)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Анализы.Ссылка,
	               |	ВТ_Анализы.НаправившийВрач,
	               |	ВТ_Анализы.Номенклатура,
	               |	ВТ_Анализы.Цена,
	               |	ВЫБОР
	               |		КОГДА ВТ_Анализы.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
	               |			ТОГДА 0
	               |		ИНАЧЕ ВТ_ТаблицаСчетчик.Индекс
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	АнализыЗаявки.Ссылка КАК Заявка,
	               |	АнализыЗаявки.Номенклатура КАК Номенклатура,
	               |	АнализыЗаявки.Проба КАК Проба,
	               |	АнализыЗаявки.Ссылка.ДокументОснование КАК ОказаниеУслуг
	               |ПОМЕСТИТЬ ВТ_ВсеЗаявки
	               |ИЗ
	               |	ВТ_Анализы КАК ВТ_Анализы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Анализы КАК АнализыЗаявки
	               |		ПО ВТ_Анализы.Ссылка = АнализыЗаявки.Ссылка.ДокументОснование
	               |			И ВТ_Анализы.Номенклатура = АнализыЗаявки.Номенклатура
	               |			И (АнализыЗаявки.Ссылка.Проведен)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВсеЗаявки.Заявка КАК Заявка,
	               |	ВТ_ВсеЗаявки.Номенклатура КАК Номенклатура,
	               |	ВТ_ВсеЗаявки.Проба КАК Проба,
	               |	ВТ_ВсеЗаявки.ОказаниеУслуг КАК ОказаниеУслуг,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ВсеЗаявки1.Заявка) - 1 КАК Индекс
	               |ПОМЕСТИТЬ ВТ_ЗаявкиПоИндексам
	               |ИЗ
	               |	ВТ_ВсеЗаявки КАК ВТ_ВсеЗаявки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеЗаявки КАК ВТ_ВсеЗаявки1
	               |		ПО ВТ_ВсеЗаявки.Номенклатура = ВТ_ВсеЗаявки1.Номенклатура
	               |			И ВТ_ВсеЗаявки.ОказаниеУслуг = ВТ_ВсеЗаявки1.ОказаниеУслуг
	               |			И ВТ_ВсеЗаявки.Заявка.Номер >= ВТ_ВсеЗаявки1.Заявка.Номер
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ВсеЗаявки.Заявка,
	               |	ВТ_ВсеЗаявки.Проба,
	               |	ВТ_ВсеЗаявки.Номенклатура,
	               |	ВТ_ВсеЗаявки.ОказаниеУслуг
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОказаниеУслуг.Клиент КАК Клиент,
	               |	ОказаниеУслуг.Филиал КАК Филиал
	               |ИЗ
	               |	Документ.ОказаниеУслуг КАК ОказаниеУслуг
	               |ГДЕ
	               |	ОказаниеУслуг.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Анализы.НаправившийВрач КАК НаправившийВрач,
	               |	ВТ_Анализы.Номенклатура КАК Номенклатура,
	               |	ВТ_Анализы.Цена КАК Цена,
	               |	ВТ_Анализы.Ссылка КАК Ссылка,
	               |	ВТ_Анализы.Количество КАК Количество,
	               |	ВТ_ЗаявкиПоИндексам.Проба КАК Проба,
	               |	ВТ_ЗаявкиПоИндексам.Заявка КАК Заявка,
	               |	ВТ_Анализы.Номенклатура.омг_СрокИсполненияЛаб КАК Срок
	               |ИЗ
	               |	ВТ_Анализы КАК ВТ_Анализы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаявкиПоИндексам КАК ВТ_ЗаявкиПоИндексам
	               |		ПО ВТ_Анализы.Номенклатура = ВТ_ЗаявкиПоИндексам.Номенклатура
	               |			И ВТ_Анализы.Индекс = ВТ_ЗаявкиПоИндексам.Индекс
	               |			И ВТ_Анализы.Ссылка = ВТ_ЗаявкиПоИндексам.ОказаниеУслуг
	               |ИТОГИ ПО
	               |	НаправившийВрач";
	Запрос.УстановитьПараметр("Ссылка", Документ);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	ВыборкаДокумента = ПакетРезультатов.Получить(6).Выбрать();
	ВыборкаДокумента.Следующий();
	
	Филиал = ВыборкаДокумента.Филиал;
	Клиент = ВыборкаДокумента.Клиент;
	
	ВыборкаВрачей = ПакетРезультатов.Получить(7).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаВрачей.Следующий() Цикл
		Уровень1 = Анализы.ПолучитьЭлементы().Добавить();
		Уровень1.НаправившийВрач = ВыборкаВрачей.НаправившийВрач;
		
		ВыборкаАнализов = ВыборкаВрачей.Выбрать();
		Пока ВыборкаАнализов.Следующий() Цикл
			Уровень2 = Уровень1.ПолучитьЭлементы().Добавить();
			Уровень2.Номенклатура = ВыборкаАнализов.Номенклатура;
			Уровень2.Срок = ВыборкаАнализов.Срок;
			Уровень2.Цена = ВыборкаАнализов.Цена;
			Уровень2.КлючСтроки = Новый УникальныйИдентификатор;
			Уровень2.Заявка = ВыборкаАнализов.Заявка;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПометку(Уровень, Знач Пометка)
	
	Для Каждого Уровень1 Из Уровень.ПолучитьЭлементы() Цикл
		Уровень1.Пометка = Пометка;
		Для Каждого Уровень2 Из Уровень1.ПолучитьЭлементы() Цикл
			Уровень2.Пометка = Пометка;
		КонецЦикла;
	КонецЦикла;
	
	ЕстьПомеченные = Ложь;
	Родитель = ?(Уровень = Анализы, Неопределено, Уровень.ПолучитьРодителя());
	Если Не Родитель = Неопределено Тогда
		Для Каждого Уровень2 Из Родитель.ПолучитьЭлементы() Цикл
			
			Если Уровень2.Пометка Тогда
				ЕстьПомеченные = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьПомеченные И Не Пометка Тогда
			Пометка = Истина;
		КонецЕсли;
		
		Родитель.Пометка = Пометка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометку(Команда)
	
	ИзменитьПометку(Анализы, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометку(Команда)
	
	ИзменитьПометку(Анализы, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура АнализыПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Анализы.ТекущиеДанные;
	
	ИзменитьПометку(ТекущиеДанные, ТекущиеДанные.Пометка);
	
	Если ТекущиеДанные.Пометка Тогда
		Для Каждого СтрокаТаблицы Из Анализы.ПолучитьЭлементы() Цикл
			
			Если СтрокаТаблицы = ТекущиеДанные Или СтрокаТаблицы = ТекущиеДанные.ПолучитьРодителя() Или ЗначениеЗаполнено(СтрокаТаблицы.Заявка) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТаблицы.Пометка = Ложь;
			ИзменитьПометку(СтрокаТаблицы, Ложь);
			
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Уровень1 Из Анализы.ПолучитьЭлементы() Цикл
		ВыбранныеПозиции = Новый Массив;
		Для Каждого Уровень2 Из Уровень1.ПолучитьЭлементы() Цикл
			
			Если ВыбранныеПозиции.Найти(Уровень2.Номенклатура) = Неопределено И Уровень2.Пометка Тогда
				ВыбранныеПозиции.Добавить(Уровень2.Номенклатура);
			ИначеЕсли Не ВыбранныеПозиции.Найти(Уровень2.Номенклатура) = Неопределено И Уровень2.Пометка И Не ЗначениеЗаполнено(Уровень2.Заявка) Тогда
				Уровень2.Пометка = Ложь;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура АнализыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура АнализыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьЗаявкиПоАнализам(МассивЗаявок, Дозаказ)
	
	СоответствиеАнализовЗаявкам = Новый Соответствие;
	
	Для Каждого СтруктураЗаявки Из МассивЗаявок Цикл
		СтруктураЗаявки.Вставить("Дозаказ", Дозаказ);
		ДокументОбъект = Документы.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.СоздатьДокумент();
		ДокументОбъект.ИсходнаяЗаявка = Дозаказ;
		ДокументОбъект.Заполнить(СтруктураЗаявки);
		ДокументОбъект.Дата = ТекущаяДата();
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);		
		Для Каждого СтруктураАнализа Из СтруктураЗаявки.Анализы Цикл
			СоответствиеАнализовЗаявкам.Вставить(СтруктураАнализа.КлючСтроки, ДокументОбъект.Ссылка);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СоответствиеАнализовЗаявкам;
	
КонецФункции

&НаКлиенте
Процедура Обработчик_ПослеВыбораЗаявкиДозаказа(ДанныеДоказаза, ДопПараметры) Экспорт
	
	Если ДанныеДоказаза = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьПослеВводаШтрихкода(ДопПараметры.МассивЗаявок, Истина, ДанныеДоказаза.Заявка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПечатьНаправления(Заявки)
	
	Если омг_ПечатьНаправленияСервер.ИспользуетсяПечатьЧерезПринтерЧеков() Тогда
		Для Каждого Заявка Из Заявки Цикл
			омг_ПечатьНаправления.ПечатьНаправленияПоЗаявке(Заявка, ЭтаФорма);
		КонецЦикла;
		
	Иначе
		Если Заявки.Количество() > 0 Тогда
			РаспечататьНаправление(Заявки) 
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьЗаявку(Заявка)
	
	УстановитьПривилегированныйРежим(Истина);
	Заявка.ПолучитьОбъект().Удалить();
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеУстановкиШтрихкодов(Результат, ДопПараметры) Экспорт
	
	Если Не Результат = Истина Тогда
		Для Каждого СтрокаДерева Из ДопПараметры.СтрокиЗаявки Цикл
			Заявка = СтрокаДерева.Заявка;
			СтрокаДерева.Заявка = "";
		КонецЦикла;
		УдалитьЗаявку(Заявка);
		Возврат;
	КонецЕсли;
	
	ПродолжитьПечатьНаправления(ДопПараметры.Заявки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеВводаШтрихкода(МассивЗаявок, ПропускВыбораДозаказа = Ложь, Дозаказ = Неопределено)
	
	Если ЭтоДозаказ И Не ПропускВыбораДозаказа Тогда
		
		МассивДанныхДозаказа = Новый Массив;
		
		КодСтроки = 0;
		
		Для Каждого ДанныеБиоматериалов Из МассивЗаявок[0].Биоматериалы Цикл
			КодСтроки = КодСтроки + 1;
			ДанныеБиоматериалов.Вставить("КодСтроки", КодСтроки);
			Для Каждого ДанныеИсследования Из ДанныеБиоматериалов.Анализы Цикл
				МассивДанныхДозаказа.Добавить(Новый Структура("Номенклатура, Контейнер, Биоматериал, Филиал, КодСтроки",
					ДанныеИсследования.Номенклатура, ДанныеБиоматериалов.Контейнер, ДанныеБиоматериалов.Биоматериал, Филиал, КодСтроки));
			КонецЦикла;
			
		КонецЦикла;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеВыбораЗаявкиДозаказа", ЭтаФорма, 
			Новый Структура("МассивДанныхДозаказа, МассивЗаявок", МассивДанныхДозаказа, МассивЗаявок));

		ПараметрыОткрытия = Новый Структура("Отбор, ЗакрыватьПриВыборе, ДанныеДозаказа, РежимВыбора", 
			Новый Структура("Филиал", Филиал), Ложь, МассивДанныхДозаказа, Истина);
			
		ОткрытьФорму("Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Форма.ФормаВыбораДозаказ", ПараметрыОткрытия, 
			ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
	КонецЕсли;
	
	СоответствиеАнализовЗаявкам = СформироватьЗаявкиПоАнализам(МассивЗаявок, Дозаказ);
	Заявки = Новый Массив;
	
	СтрокиЗаявки = Новый Массив;
	
	Для Каждого Уровень1 Из Анализы.ПолучитьЭлементы() Цикл
		
		Если Не Уровень1.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Уровень2 Из Уровень1.ПолучитьЭлементы() Цикл
			Если Не Уровень2.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Уровень2.Заявка) Тогда
				Продолжить;
			КонецЕсли;
			
			Заявка = СоответствиеАнализовЗаявкам.Получить(Уровень2.КлючСтроки);
			Если Заявка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Уровень2.Заявка = Заявка;
			СтрокиЗаявки.Добавить(Уровень2);
			Если Заявки.Найти(Заявка) = Неопределено Тогда
				Заявки.Добавить(Заявка);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
	Если ЭтоДозаказ Тогда
		ПродолжитьПечатьНаправления(Заявки);
		
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеУстановкиШтрихкодов", 
			ЭтаФорма, Новый Структура("СтрокиЗаявки, Заявки", СтрокиЗаявки, Заявки));
		
		ОткрытьФорму("Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Форма.ФормаУстановкиШтрихкодов",
			Новый Структура("Ключ", Заявка), ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеВыбораБиоматериалов(МассивБиоматериалов, ДопПараметры) Экспорт
	
	Если МассивБиоматериалов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Заявка Из ДопПараметры.МассивЗаявок Цикл
		Заявка.Биоматериалы = МассивБиоматериалов;
	КонецЦикла;
	
	ПоказатьЗаполнениеДопПолей(ДопПараметры.МассивЗаявок, ДопПараметры.МассивНоменклатуры);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура Обработчик_ПослеЗаполненияДопПолей(СтруктураДанныхПолей, ДопПараметры) Экспорт
	
	Если СтруктураДанныхПолей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Заявка Из ДопПараметры.МассивЗаявок Цикл
		Для Каждого ЗначениеДопПоля Из СтруктураДанныхПолей.МассивДанных Цикл
			Для Каждого ДанныеАнализа Из Заявка.Анализы Цикл
				Если Не ЗначениеДопПоля.СписокНоменклатуры.НайтиПоЗначению(ДанныеАнализа.Номенклатура) = Неопределено Тогда
					
					СтруктураЗначенияДопПоля = Новый Структура("Свойство, Значение, Обязательное");
					ЗаполнитьЗначенияСвойств(СтруктураЗначенияДопПоля, ЗначениеДопПоля);
					Заявка.ДополнительныеСведения.Добавить(СтруктураЗначенияДопПоля);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Заявка.Вставить("Примечание", СтруктураДанныхПолей.Примечание);
	КонецЦикла;
	
	ПродолжитьПослеВводаШтрихкода(ДопПараметры.МассивЗаявок);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыборБиоматериалов(МассивЗаявок, МассивНоменклатуры, Штрихкод)
	
	
	МассивУслуг = Новый Массив;
	
	Для Каждого Уровень1 Из Анализы.ПолучитьЭлементы() Цикл
		
		Если Не Уровень1.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Уровень2 Из Уровень1.ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(Уровень2.Заявка) Или Не Уровень2.Пометка Тогда
				Продолжить;
			КонецЕсли;
			МассивУслуг.Добавить(Новый Структура("Номенклатура, Проба", Уровень2.Номенклатура, Штрихкод));

		КонецЦикла;
		
	КонецЦикла;

	омг_ЗаявкаЛИСОбщиеКлиентскиеПроцедуры.ПоказатьВыборБиоматериалов(ЭтаФорма, МассивУслуг, МассивЗаявок, МассивНоменклатуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗаполнениеДопПолей(МассивЗаявок, МассивНоменклатуры)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеЗаполненияДопПолей", 
		ЭтаФорма, Новый Структура("МассивЗаявок", МассивЗаявок));
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Анализы", МассивНоменклатуры);
	ОткрытьФорму("Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Форма.ФормаЗаполненияДопПолейАнализов", 
		СтруктураПараметров, ЭтаФорма, УникальныйИдентификатор,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	
КонецПроцедуры

&НаКлиенте
Асинх Функция СканированиеШтрихкода()
	
	Штрихкод = Ждать ВвестиСтрокуАсинх(, "Введите штрихкод", 50);
	
	Если Штрихкод = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СимволыКЗ = "әіңғ,.үұқ";
	СимволыКЗ = """" + СимволыКЗ + ВРег(СимволыКЗ);
	Числа = "1234567890234567890";
	
	Для НСтроки = 1 По СтрДлина(Штрихкод) Цикл
		СимволШтрихкода = Сред(Штрихкод, НСтроки, 1);
		НСимволаКЗ = СтрНайти(СимволыКЗ, СимволШтрихкода);
		Если НСимволаКЗ > 0 Тогда
			СимволЧисло = Сред(Числа, НСимволаКЗ, 1);
			Штрихкод = СтрЗаменить(Штрихкод, СимволШтрихкода, СимволЧисло);
		КонецЕсли;
	КонецЦикла;

	Возврат Штрихкод;
	
КонецФункции

&НаКлиенте
Асинх Процедура Обработчик_ПослеОтветаНаВопросОФормированииЗаявок(Ответ, ДопПараметры) Экспорт
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Штрихкод = "";

	МассивЗаявок = Новый Массив;
	
	МассивНоменклатуры = Новый Массив;
	
	Для Каждого Уровень1 Из Анализы.ПолучитьЭлементы() Цикл
		
		Если Не Уровень1.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		МассивАнализов = Новый Массив;
		
		СтруктураЗаявки = Новый Структура("Филиал, Ссылка, Клиент, НаправившийВрач, 
			|Анализы, Штрихкод, ДополнительныеСведения, Биоматериалы", 
			Филиал, Документ, Клиент, Уровень1.НаправившийВрач, МассивАнализов, Штрихкод, Новый Массив);
			
		Для Каждого Уровень2 Из Уровень1.ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(Уровень2.Заявка) Или Не Уровень2.Пометка Тогда
				Продолжить;
			КонецЕсли;
			СтруктураАнализа = Новый Структура("Номенклатура, Цена, Заявка, КлючСтроки", 
				Уровень2.Номенклатура, Уровень2.Цена, ,Уровень2.КлючСтроки);
			МассивАнализов.Добавить(СтруктураАнализа);
			
			МассивНоменклатуры.Добавить(Уровень2.Номенклатура);
		КонецЦикла;
		
		МассивЗаявок.Добавить(СтруктураЗаявки);
	КонецЦикла;
	
	ПоказателиПроверки = ДополнительнаяПроверка(МассивНоменклатуры);
	
	Если ПоказателиПроверки.НеобходимВыборБиоматериалов Тогда
		
		ПоказатьВыборБиоматериалов(МассивЗаявок, МассивНоменклатуры, "");
		
		Возврат;
	КонецЕсли;
	
	ПоказатьЗаполнениеДопПолей(МассивЗаявок, МассивНоменклатуры);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДополнительнаяПроверка(МассивНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураКомплектующиеНоменклатуры.Комплектующая КАК Комплектующая
	               |ПОМЕСТИТЬ ВТ_Комплектующие
	               |ИЗ
	               |	Справочник.Номенклатура.КомплектующиеНоменклатуры КАК НоменклатураКомплектующиеНоменклатуры
	               |ГДЕ
	               |	НоменклатураКомплектующиеНоменклатуры.Ссылка В(&МассивНоменклатуры)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураКомплектующиеНоменклатуры.Комплектующая КАК Комплектующая
	               |ПОМЕСТИТЬ ВТ_ВложенныеКомплектующие
	               |ИЗ
	               |	Справочник.Номенклатура.КомплектующиеНоменклатуры КАК НоменклатураКомплектующиеНоменклатуры
	               |ГДЕ
	               |	НоменклатураКомплектующиеНоменклатуры.Ссылка В
	               |			(ВЫБРАТЬ
	               |				ВТ_Комплектующие.Комплектующая КАК Комплектующая
	               |			ИЗ
	               |				ВТ_Комплектующие КАК ВТ_Комплектующие)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	омг_СоответствиеДопПолейНоменклатуре.Объект КАК Объект,
	               |	омг_СоответствиеДопПолейНоменклатуре.Свойство КАК Свойство,
	               |	омг_СоответствиеДопПолейНоменклатуре.Обязательное КАК Обязательное
	               |ИЗ
	               |	РегистрСведений.омг_СоответствиеДопПолейНоменклатуре КАК омг_СоответствиеДопПолейНоменклатуре
	               |ГДЕ
	               |	(омг_СоответствиеДопПолейНоменклатуре.Объект В (&МассивНоменклатуры)
	               |			ИЛИ омг_СоответствиеДопПолейНоменклатуре.Объект В
	               |				(ВЫБРАТЬ
	               |					ВТ_Комплектующие.Комплектующая КАК Комплектующая
	               |				ИЗ
	               |					ВТ_Комплектующие КАК ВТ_Комплектующие
	               |		
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |				ВЫБРАТЬ
	               |					ВТ_ВложенныеКомплектующие.Комплектующая
	               |				ИЗ
	               |					ВТ_ВложенныеКомплектующие КАК ВТ_ВложенныеКомплектующие))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Комплектующие.Комплектующая КАК Комплектующая
	               |ПОМЕСТИТЬ ВТ_НоменклатураДляПроверки
	               |ИЗ
	               |	ВТ_Комплектующие КАК ВТ_Комплектующие
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Номенклатура.Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Ссылка В(&МассивНоменклатуры)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_ВложенныеКомплектующие.Комплектующая
	               |ИЗ
	               |	ВТ_ВложенныеКомплектующие КАК ВТ_ВложенныеКомплектующие
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НоменклатураДляПроверки.Комплектующая КАК Комплектующая,
	               |	ЕСТЬNULL(ВложенныйЗапрос.КоличествоПоУмолчанию, 0) КАК КоличествоПоУмолчанию
	               |ИЗ
	               |	ВТ_НоменклатураДляПроверки КАК ВТ_НоменклатураДляПроверки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВТ_НоменклатураДляПроверки.Комплектующая КАК Комплектующая,
	               |			КОЛИЧЕСТВО(ЕСТЬNULL(ВнутренняяЛаборатория_СопоставлениеНоменклатуры.ПоУмолчанию, 0)) КАК КоличествоПоУмолчанию,
	               |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Биоматериал) КАК ВсегоБиоматериалов
	               |		ИЗ
	               |			ВТ_НоменклатураДляПроверки КАК ВТ_НоменклатураДляПроверки
	               |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВнутренняяЛаборатория_СопоставлениеНоменклатуры КАК ВнутренняяЛаборатория_СопоставлениеНоменклатуры
	               |				ПО ВТ_НоменклатураДляПроверки.Комплектующая = ВнутренняяЛаборатория_СопоставлениеНоменклатуры.Номенклатура
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТ_НоменклатураДляПроверки.Комплектующая) КАК ВложенныйЗапрос
	               |		ПО (ВложенныйЗапрос.Комплектующая = ВТ_НоменклатураДляПроверки.Комплектующая)
	               |ГДЕ
	               |	ЕСТЬNULL(ВложенныйЗапрос.ВсегоБиоматериалов, 0) > 1";
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	ЕстьДопПоля = Не ПакетРезультатов.Получить(1).Пустой();
	НеобходимВыборБиоматериалов = Не ПакетРезультатов.Получить(3).Пустой();
	
	Возврат Новый Структура("ЕстьДопПоля, НеобходимВыборБиоматериалов", 
		ЕстьДопПоля, НеобходимВыборБиоматериалов);
	
КонецФункции

&НаКлиенте
Процедура СформироватьЗаявки(Команда)
	
	ЭтоДозаказ = Ложь;
	
	ТекстВопроса = "Сформировать заявки по выбранным позициям?";
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеОтветаНаВопросОФормированииЗаявок", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да, "", КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспечататьНаправление(Мас)  
		
	ТабДок = Новый ТабличныйДокумент;
	Печать(ТабДок, Мас);

	ТабДок.ОтображатьСетку = Ложь; 
	ТабДок.АвтоМасштаб = Истина; 
	ТабДок.ПолеСверху = 0;
	ТабДок.ПолеСнизу  = 0;
	ТабДок.ПолеСлева  = 0;
	ТабДок.ПолеСправа = 0;	
	ТабДок.Напечатать();
	//}}
КонецПроцедуры

&НаСервере
Процедура Печать(ТабДок, ПараметрКоманды)
	Документы.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Печать(ТабДок, ПараметрКоманды);
КонецПроцедуры


&НаКлиенте
Процедура АнализыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.Анализы.ТекущийЭлемент = Элементы.АнализыЗаявка Тогда
		ПоказатьЗначение(, Элементы.Анализы.ТекущиеДанные.Заявка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьНаправлений(Команда)
	
	Заявки = Новый Массив;
	Для Каждого Уровень1 Из Анализы.ПолучитьЭлементы() Цикл
		
		Если Не Уровень1.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Уровень2 Из Уровень1.ПолучитьЭлементы() Цикл
			Если Не ЗначениеЗаполнено(Уровень2.Заявка) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Заявки.Найти(Уровень2.Заявка) = Неопределено Тогда
				Заявки.Добавить(Уровень2.Заявка);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
	Если омг_ПечатьНаправленияСервер.ИспользуетсяПечатьЧерезПринтерЧеков() Тогда
		
		Для Каждого Заявка Из Заявки Цикл
			омг_ПечатьНаправления.ПечатьНаправленияПоЗаявке(Заявка, ЭтаФорма);
		КонецЦикла;
		
	Иначе
		Если Заявки.Количество() > 0 Тогда
			РаспечататьНаправление(Заявки) 
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроизвестиЗаборМатериалов(Заявка, Медсестра, ДатаЗабора)
	
	ЗаявкаОбъект = Заявка.ПолучитьОбъект();
	
	ЗаявкаОбъект.Медсестра = Медсестра;
	ЗаявкаОбъект.ВремяЗабораМатериала = ДатаЗабора;
	
	ЗаявкаОбъект.Записать();
	
	омг_ЗаявкаЛИСОбщиеКлиентСерверныеПроцедуры.Обработчик_ПослеОтветаНаВопросОбОтправкеВЛИС(Неопределено, ЗаявкаОбъект);
	
КонецПроцедуры


&НаКлиенте
Процедура Обработчик_ПослеВыбораМедсестры(ВыбранныеЗначения, Заявки) Экспорт
	
	Если ВыбранныеЗначения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Заявка Из Заявки Цикл
		ПроизвестиЗаборМатериалов(Заявка, ВыбранныеЗначения.Медсестра, ВыбранныеЗначения.ДатаЗабора);
	КонецЦикла;
	
	ПоказатьПредупреждение(, "Операция отправки завершена.");
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеОтветаНаВопросОбОтправкеВЛабораторию(Ответ, Заявки) Экспорт
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеВыбораМедсестры", ЭтаФорма, Заявки);
	
	ОткрытьФорму("Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Форма.ФормаВыбораМедсестрыИВремени",, 
		ЭтаФорма, УникальныйИдентификатор,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВЛабораторию(Команда)
	
	МассивЗаявок = Новый Массив;
	
	Для Каждого Уровень1 Из Анализы.ПолучитьЭлементы() Цикл
		Для Каждого Уровень2 Из Уровень1.ПолучитьЭлементы() Цикл
			Если Уровень2.Пометка И ЗначениеЗаполнено(Уровень2.Заявка) Тогда
				МассивЗаявок.Добавить(Уровень2.Заявка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если МассивЗаявок.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбрана заявка для отправки в лабораторию!";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Отправить выбранные заявки в лабораторию?";
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеОтветаНаВопросОбОтправкеВЛабораторию", ЭтаФорма, МассивЗаявок);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да, "", КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура Дозаказ(Команда)
	
	ЭтоДозаказ = Истина;
	
	ТекстВопроса = "Сформировать заявки по выбранным позициям?";
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеОтветаНаВопросОФормированииЗаявок", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да, "", КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаШтрихкодов(Команда)
	
	Если Элементы.Анализы.ТекущиеДанные = Неопределено
		Или Элементы.Анализы.ТекущиеДанные.Заявка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Документ.омг_ЗаявкаНаЛабораторноеИсследованиеВЛИС.Форма.ФормаУстановкиШтрихкодов",
		Новый Структура("Ключ, ОтменаНедоступна", Элементы.Анализы.ТекущиеДанные.Заявка), ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры



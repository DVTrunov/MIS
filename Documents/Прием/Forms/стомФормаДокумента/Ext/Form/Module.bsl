// При изменении нескольких диагнозов одновременно (выделили несколько строк и изменили) заполняются все выделенные поля
//
// Параметры:
//  НаименованиеПоля  - Строка - Имя поля диагноза, который подвергается изменению
//  ЗначениеТекстаЗаполнения  - Произвольный - Значение на заполнение полей диагнозов
//
&НаКлиенте
Процедура ИзменениеПоляМножественногоВыделения(НаименованиеПоля, ЗначениеТекстаЗаполнения)	
	
	// Было выделенно несколько строк в диагнозах. Данные поля допускаются для массового изменения.
	// В выделенных строках содержится значение индекса		
	Если Элементы.Диагнозы.ВыделенныеСтроки.Количество() > 1 Тогда
		
		Для каждого ВыделеннаяСтрокаИндекс Из Элементы.Диагнозы.ВыделенныеСтроки Цикл		
			Объект.Диагнозы.Получить(ВыделеннаяСтрокаИндекс)[НаименованиеПоля] = ЗначениеТекстаЗаполнения;					
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры
	
#КонецОбласти

#КонецОбласти

#Область ПланЛеченияСтоматология

&НаКлиенте
Процедура ЗаполнитьПланЛеченияСтоматологияКлиент()
	
	СписокНазначенийКопия = СписокНазначений;
	МедицинскаяДеятельность.ЗагрузитьПланЛеченияСтоматология(СписокНазначенийКопия, Объект.ПервичныйПрием);
	КопироватьДанныеФормы(СписокНазначенийКопия, СписокНазначений);
	
	ПересчитатьСуммыПланаЛечения(ЭтаФорма);
	РазвернутьДеревоНазначений();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНазначениеВыделеннымЗубамСегментам(Назначение)
	
	Если стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() > 0 Тогда 
		Для Каждого СтрокаЗуб Из стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты Цикл
			Если СтрокаЗуб.Сегменты.Количество() = 1 Тогда 
				СегментВЗубе = СтрокаЗуб.Сегменты[0];
				ДобавитьНазначение(ЭтаФорма, Назначение, Строка(СтрокаЗуб.ЗубВКарте.УникальныйИдентификатор()), СтрокаЗуб.ЗубВКарте, СегментВЗубе);	
			Иначе
				ДобавитьНазначение(ЭтаФорма, Назначение, Строка(СтрокаЗуб.ЗубВКарте.УникальныйИдентификатор()), СтрокаЗуб.ЗубВКарте);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьНазначение(Форма, Назначение, ИдентификаторГруппы, ЗубВКарте, СегментВЗубе = Неопределено, Количество = Неопределено, Дата = Неопределено, Сотрудник = Неопределено, Комментарий = Неопределено, ВидНазначения = Неопределено)
	
	ГруппаНазначений = НайтиГруппуПланаЛечения(Форма, ИдентификаторГруппы);
	Если ГруппаНазначений = Неопределено Тогда
		НоваяГруппа = Форма.СписокНазначений.ПолучитьЭлементы().Добавить();
		НоваяГруппа.ЗубВКарте = ЗубВКарте;
		НоваяГруппа.Назначение = ЗубВКарте;
		НоваяГруппа.ИдентификаторНазначения = ИдентификаторГруппы;	
		ГруппаНазначений = НоваяГруппа;
	КонецЕсли;
	
	ЭлементыГруппы = ГруппаНазначений.ПолучитьЭлементы();
	
	ЭлементГруппы = ЭлементыГруппы.Добавить();
	ЭлементГруппы.Назначение = Назначение;
	ЭлементГруппы.ВидНазначения = ?(ВидНазначения = Неопределено, ПредопределенноеЗначение("Перечисление.ВидыНазначений.Процедура"), ВидНазначения);
	ЭлементГруппы.ЗубВКарте = ЗубВКарте;
	ЭлементГруппы.СегментВЗубе = СегментВЗубе;
	ЭлементГруппы.ИдентификаторНазначения = Новый УникальныйИдентификатор;
	ЭлементГруппы.Цена = Ценообразование.ПолучитьЦену(Форма.Прейскурант, Назначение, Форма.Объект.Дата).Цена;
	ЭлементГруппы.Количество = ?(Количество = Неопределено, 1, Количество);
	ЭлементГруппы.Комментарий = Комментарий;
	
	ЭлементГруппы.Дата = Дата;
	ЭлементГруппы.ДатаНачалаБезВремени = Дата;
	ЭлементГруппы.Сотрудник = Сотрудник;
	
	#Если Клиент Тогда
	Если НоваяГруппа <> Неопределено Тогда
		Форма.Элементы.Назначения.Развернуть(НоваяГруппа.ПолучитьИдентификатор(), Истина);
	КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиГруппуПланаЛечения(Форма, ИдентификаторНазначения, ТекущаяГруппа = Неопределено)
	
	ИдентификаторНазначенияСтрокой = Строка(ИдентификаторНазначения);
	
	Для Каждого ГруппаНазначений Из Форма.СписокНазначений.ПолучитьЭлементы() Цикл	
		Если ГруппаНазначений.ИдентификаторНазначения = ИдентификаторНазначенияСтрокой И ГруппаНазначений <> ТекущаяГруппа Тогда
			Возврат ГруппаНазначений;
		КонецЕсли;				
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура НазначенияПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.Назначения.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТекДанные <> Неопределено Тогда
		Элементы.НазначенияКонтекстноеМенюПросмотрВыполнения.Доступность = Элементы.Назначения.ТекущиеДанные.ДокументВыполнения.Количество() <> 0;
	КонецЕсли;
	
	ЭтоЗуб = (ТекДанные.ПолучитьРодителя() = Неопределено);
	Для Каждого Поле Из Элементы.Назначения.ПодчиненныеЭлементы Цикл
		Если Поле.Вид = ВидПоляФормы.ПолеВвода И
			Поле <> Элементы.Назначения.ПодчиненныеЭлементы.НазначенияНазначение И
			Поле <> Элементы.Назначения.ПодчиненныеЭлементы.НазначенияФакт
		Тогда 
			Поле.ТолькоПросмотр = ЭтоЗуб;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.НазначенияНазначение.БыстрыйВыбор = ЭтоЗуб;
	Элементы.НазначенияНазначение.РежимВыбораИзСписка = ЭтоЗуб;
	Элементы.НазначенияНазначение.ИсторияВыбораПриВводе = ?(ЭтоЗуб,ИсторияВыбораПриВводе.НеИспользовать, ИсторияВыбораПриВводе.Авто);
	Элементы.НазначенияНазначение.СписокВыбора.Очистить();
	Если ЭтоЗуб Тогда 
		Для Каждого ЭлементВыбора Из стомДанныеЗубныхКарт.СписокВыбораЗубов Цикл
			Элементы.НазначенияНазначение.СписокВыбора.Добавить(ЭлементВыбора.Значение, ЭлементВыбора.Представление);
		КонецЦикла;
		Элементы.НазначенияНазначение.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.стомЗубыКарты");
	Иначе
		Элементы.НазначенияНазначение.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НазначенияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	ТекДанные = Элементы.Назначения.ТекущиеДанные;
	
	Отказ = Истина;
	Если ТекДанные = Неопределено Или (ТекДанные.ПолучитьРодителя() = Неопределено И СписокНазначений.ПолучитьЭлементы().Количество() > 0) Тогда
		
		ТекстВопроса = "Необходимо добавить:";
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(0, "Зуб/конструкцию");
		Если стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() > 0 Тогда 
			Кнопки.Добавить(1, "Текущий зуб карты");
			Кнопки.Добавить(3, "Назначение в текущий зуб карты");
		КонецЕсли;
		Если ТекДанные <> Неопределено И Не Копирование Тогда
			Кнопки.Добавить(2, "Назначение");
		КонецЕсли;
		Кнопки.СортироватьПоЗначению();
		
		ДополнительныеПараметры = Новый Структура("Копирование", Копирование);
		Если Кнопки.Количество() > 1 Тогда
			ПоказатьВыборИзМеню(Новый ОписаниеОповещения("НазначенияПослеВыбораИзМеню", ЭтаФорма, ДополнительныеПараметры), Кнопки, Элементы.Назначения);
		Иначе
			НазначенияПослеВыбораИзМеню(Новый Структура("Значение", 0), ДополнительныеПараметры);
		КонецЕсли;
		
	Иначе // Добавление/копирование назначения
		
		Назначение = ?(Копирование, ТекДанные.Назначение, Неопределено);
		СегментВЗубе = Неопределено;	// Проверим, выделен ли сегмент у зуба
		Для Сч=0 по стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() - 1 Цикл             
			Если ТекДанные.ЗубВКарте = стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты[Сч].ЗубВКарте 
				И стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты[Сч].Сегменты.Количество() = 1 Тогда
				СегментВЗубе = стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты[Сч].Сегменты[0];
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		Элементы.Назначения.ТекущаяСтрока = ДобавитьНазначениеВПланЛечения(ТекДанные.ПолучитьРодителя(), Назначение, СегментВЗубе);
		Элементы.Назначения.ИзменитьСтроку();
		
		Если Элементы.Назначения.ТекущиеДанные <> Неопределено И Не ЗначениеЗаполнено(Элементы.Назначения.ТекущиеДанные.ЗубВКарте) Тогда 
			Элементы.Назначения.ИзменитьСтроку();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НазначенияПослеВыбораИзМеню(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат <> Неопределено Тогда
		
		Копирование = ДополнительныеПараметры.Копирование;
		РезультатВопроса = Результат.Значение;
		ТекДанные = Элементы.Назначения.ТекущиеДанные;
	
		СписокНазначенийДляКопирования = ?(Копирование, ТекДанные.ПолучитьЭлементы(), Неопределено);		
		Если РезультатВопроса = 0 Тогда
			// Добавление строки с пустым зубом
			Элементы.Назначения.ТекущаяСтрока = ДобавитьЗубВПланЛечения(ЭтаФорма, , СписокНазначенийДляКопирования);
			Элементы.Назначения.Развернуть(Элементы.Назначения.ТекущаяСтрока, Ложь);
			
		ИначеЕсли РезультатВопроса = 1 Тогда
			// Добавление строки с текущим зубом в зубной карте. Если уже есть, переход к его назначениям
			Для Каждого СтрокаЗуб Из стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты Цикл
				Элементы.Назначения.ТекущаяСтрока = ДобавитьЗубВПланЛечения(ЭтаФорма, СтрокаЗуб.ЗубВКарте, СписокНазначенийДляКопирования);
			КонецЦикла;
			
			Элементы.Назначения.Развернуть(Элементы.Назначения.ТекущаяСтрока, Ложь);
			Если СписокНазначений.НайтиПоИдентификатору(Элементы.Назначения.ТекущаяСтрока).ПолучитьЭлементы().Количество() = 0 Тогда
				ТекДанные = Элементы.Назначения.ТекущиеДанные;
				Элементы.Назначения.ТекущаяСтрока = ДобавитьНазначениеВПланЛечения(ТекДанные);
			КонецЕсли;
			
		ИначеЕсли РезультатВопроса = 2 Тогда 
			// Добавление строки назначения
			СегментВЗубе = Неопределено;	// Проверим, выделен ли сегмент у зуба
			Для Сч = 0 по стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() - 1 Цикл             
				Если ТекДанные.ЗубВКарте = стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты[Сч].ЗубВКарте 
					И стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты[Сч].Сегменты.Количество() = 1 Тогда
					СегментВЗубе = стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты[Сч].Сегменты[0];
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			Элементы.Назначения.ТекущаяСтрока = ДобавитьНазначениеВПланЛечения(ТекДанные,,СегментВЗубе);
			Элементы.Назначения.ИзменитьСтроку();
		ИначеЕсли РезультатВопроса = 3 Тогда 
			// Добавление строки назначения текущему зубу зубной карты. При необходимости, добавление самого зуба
			Для Каждого ВыделенныйЗуб Из стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты Цикл
				Если ВыделенныйЗуб.Сегменты.Количество() = 1 Тогда
					СегментВЗубе = ВыделенныйЗуб.Сегменты[0];
				Иначе
					СегментВЗубе = Неопределено;
				КонецЕсли;
				ДобавитьНазначениеЗубуДляРедактирования(ВыделенныйЗуб.ЗубВКарте, СегментВЗубе);
				Прервать;
			КонецЦикла;
		Иначе
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Элементы.Назначения.ТекущиеДанные <> Неопределено И Не ЗначениеЗаполнено(Элементы.Назначения.ТекущиеДанные.ЗубВКарте) Тогда 
		Элементы.Назначения.ИзменитьСтроку();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НазначенияПослеУдаления(Элемент)
	
	ПересчитатьСуммыПланаЛечения(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборЛечения(Команда)
	
	Если стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() = 0 Тогда
		Предупреждение("Не выбран зуб, для которого подбирается план лечения!", 30);
		Возврат;
	КонецЕсли;
	
	мсСостояния = Новый Массив;
	Для Каждого СтрокаСостояние Из стомДоступныеСостояния.ПолучитьЭлементы() Цикл
		мсСостояния.Добавить(СтрокаСостояние.СостояниеСегмент);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения("ПодборПланаЛеченияПослеВыбораНазначений", ЭтаФорма);
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор, СписокСостояний", Ложь, Истина, мсСостояния);
	ОткрытьФорму("Документ.Прием.Форма.стомФормаПодбора", ПараметрыФормы,,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПозициюПланаЛечения(Команда)
	
	Если стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() = 0 Тогда
		Предупреждение("Не выбран зуб, для которого подбирается план лечения!", 30);
		Возврат;
	КонецЕсли;
	
	Если стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() > 0 Тогда 
		ВыделенныйЗуб = стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты[0];
		Если ВыделенныйЗуб.Сегменты.Количество() = 1 Тогда
			СегментВЗубе = ВыделенныйЗуб.Сегменты[0];
		Иначе
			СегментВЗубе = Неопределено;
		КонецЕсли;
		
		ДобавитьНазначениеЗубуДляРедактирования(ВыделенныйЗуб.ЗубВКарте, СегментВЗубе);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНазначениеЗубуДляРедактирования(ЗубВКарте, СегментВЗубе = Неопределено, Назначение = Неопределено)
	
	СтрокаЗубПланаЛечения = ДобавитьЗубВПланЛечения(ЭтаФорма, стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты[0].ЗубВКарте);
	ДанныеСтроки = СписокНазначений.НайтиПоИдентификатору(СтрокаЗубПланаЛечения);
	
	Элементы.Назначения.ТекущаяСтрока = ДобавитьНазначениеВПланЛечения(ДанныеСтроки, Назначение, СегментВЗубе);
	
	Если Не ЗначениеЗаполнено(Назначение) Тогда
		Элементы.Назначения.ИзменитьСтроку();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиПланВФактУслуг(Команда)
	
	ВыделенныеСтроки = Элементы.Назначения.ВыделенныеСтроки;
	
	СтрокиНазначений = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		СтрокаПлана = СписокНазначений.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если СтрокаПлана = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ГруппаЭлемента = СтрокаПлана.ПолучитьРодителя();
		Если ГруппаЭлемента = Неопределено Тогда // Это зуб.
			
			НазначенияЗуба = СтрокаПлана.ПолучитьЭлементы();
			
			// Если выделен и зуб, и хотя бы одно из назначений по нему, то не обрабатываем зуб, только отдельные строки услуг.
			НеОтрабатыватьЗубЦеликом = Ложь;
			Для Каждого СтрокаСегмент Из НазначенияЗуба Цикл
				Если ВыделенныеСтроки.Найти(СтрокаСегмент.ПолучитьИдентификатор()) <> Неопределено Тогда
					НеОтрабатыватьЗубЦеликом = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НеОтрабатыватьЗубЦеликом Тогда
				Продолжить;
			КонецЕсли;
			
			// Добавляем назначения зуба к обработке.
			Для Каждого СтрокаСегмент Из НазначенияЗуба Цикл
				Если СтрокаСегмент.Факт < СтрокаСегмент.Количество
					И СтрокиНазначений.Найти(СтрокаСегмент) = Неопределено
				Тогда
					СтрокиНазначений.Добавить(СтрокаСегмент);
				КонецЕсли;
			КонецЦикла;
		Иначе // Это строка назначения.
			Если СтрокаПлана.Факт < СтрокаПлана.Количество
				И СтрокиНазначений.Найти(СтрокаПлана) = Неопределено
			Тогда
				СтрокиНазначений.Добавить(СтрокаПлана);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаСегмент Из СтрокиНазначений Цикл
		
		УидНазначения = Новый УникальныйИдентификатор(СтрокаСегмент.ИдентификаторНазначения);
		СтрокиРабот = Объект.Работы.НайтиСтроки(Новый Структура("Ид, ЗубВКарте, Номенклатура", УидНазначения, СтрокаСегмент.ЗубВКарте, СтрокаСегмент.Назначение));
		
		Если СтрокиРабот.Количество() = 0 Тогда
			СтрокаРаботы = Объект.Работы.Добавить();
			СтрокаРаботы.ЗубВКарте = СтрокаСегмент.ЗубВКарте;
			СтрокаРаботы.СегментВЗубе = СтрокаСегмент.СегментВЗубе;
			СтрокаРаботы.Номенклатура = СтрокаСегмент.Назначение;
			СтрокаРаботы.Количество = 1;
			СтрокаРаботы.Ид = УидНазначения;
		Иначе
			СтрокаРаботы = СтрокиРабот[0];
			Если СтрокаРаботы.Количество = 0 
				Или СтрокаРаботы.Количество < СтрокаСегмент.Количество
			Тогда
				СтрокаРаботы.Количество = СтрокаРаботы.Количество + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если мАвтоматическиЗаполнятьМатериалы Тогда
		ЗаполнитьМатериалыПоНормамРабот();
	КонецЕсли;
	ОбновитьСписокРаботДокумента();
	
	Если СтрокиНазначений.Количество() <> 0 Тогда
		Состояние(НСтр("ru='Услуги добавлены в состав выполненных.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ИсторияЗубов

&НаКлиенте
Процедура СформироватьИсториюЗубов(ВыделенныеЗубы)
	
	СформироватьИсториюЗубовСервер(ВыделенныеЗубы);
	Для Каждого Элемент Из стомИсторияЗубов.ПолучитьЭлементы() Цикл
		Элементы.стомИсторияЗубов.Развернуть(Элемент.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьИсториюЗубовСервер(ВыделенныеЗубы)
	
	мсВыделенныеЗубы = Новый Массив;
	Для Каждого кзЗуб Из ВыделенныеЗубы Цикл
		мсВыделенныеЗубы.Добавить(Справочники.стомЗубыКарты.ПолучитьСсылку(Новый УникальныйИдентификатор(кзЗуб.Ключ)));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	стомСостоянияЗубов.Регистратор КАК Прием,
	|	стомСостоянияЗубов.Период КАК Дата,
	|	стомСостоянияЗубов.ЗубВКарте КАК ЗубВКарте,
	|	стомСостоянияЗубов.СостояниеСегмента КАК Элемент,
	|	0 КАК ТипИстории,
	|	стомСостоянияЗубов.ЗубВКарте.Наименование КАК ЗубВКартеНаименование
	|ИЗ
	|	РегистрСведений.стомСостоянияЗубов КАК стомСостоянияЗубов
	|ГДЕ
	|	стомСостоянияЗубов.ЗубнаяКарта = &ЗубнаяКарта
	|	И стомСостоянияЗубов.Клиент = &Клиент
	|	И стомСостоянияЗубов.ЗубВКарте В(&ВыделенныеЗубы)
	|	И стомСостоянияЗубов.ВидРедактирования = ЗНАЧЕНИЕ(Перечисление.стомВидыРедактированияЭлементовКарты.Добавление)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Диагнозы.Регистратор,
	|	Диагнозы.Период,
	|	Диагнозы.ЗубВКарте,
	|	Диагнозы.Диагноз,
	|	1,
	|	Диагнозы.ЗубВКарте.Наименование
	|ИЗ
	|	РегистрСведений.Диагнозы КАК Диагнозы
	|ГДЕ
	|	Диагнозы.Регистратор.Клиент = &Клиент
	|	И Диагнозы.Регистратор.ЗубнаяКарта = &ЗубнаяКарта
	|	И Диагнозы.ЗубВКарте В(&ВыделенныеЗубы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПриемРаботы.Ссылка,
	|	ПриемРаботы.Ссылка.Дата,
	|	ПриемРаботы.ЗубВКарте,
	|	ПриемРаботы.Номенклатура,
	|	2,
	|	ПриемРаботы.ЗубВКарте.Наименование
	|ИЗ
	|	Документ.Прием.Работы КАК ПриемРаботы
	|ГДЕ
	|	ПриемРаботы.Ссылка.Клиент = &Клиент
	|	И ПриемРаботы.Ссылка.ЗубнаяКарта = &ЗубнаяКарта
	|	И ПриемРаботы.ЗубВКарте В(&ВыделенныеЗубы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗубВКартеНаименование,
	|	ТипИстории,
	|	Дата УБЫВ
	|ИТОГИ ПО
	|	ЗубВКарте,
	|	ТипИстории";
	
	Запрос.УстановитьПараметр("ЗубнаяКарта", Объект.ЗубнаяКарта);
	Запрос.УстановитьПараметр("Клиент", Объект.Клиент);
	Запрос.УстановитьПараметр("ВыделенныеЗубы", мсВыделенныеЗубы);

	ВыборкаЗубы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	мсТипыИстории = Новый Массив;
	мсТипыИстории.Добавить("История состояний");
	мсТипыИстории.Добавить("История диагнозов");
	мсТипыИстории.Добавить("История услуг");
	
	ВерхУровень = стомИсторияЗубов.ПолучитьЭлементы();
	ВерхУровень.Очистить();
	
	ДанныеОВыделенныхЗубах = стомЗубнаяКартаМетоды.ПолучитьДанныеОВыделенныхЗубахСегментах(стомДанныеЗубныхКарт.Адрес,ВыделенныеЗубы);
	
	Пока ВыборкаЗубы.Следующий() Цикл
		
		//добавляем ветвь зуба
		ВетвьЗуб = ВерхУровень.Добавить();
		ВетвьЗуб.ЗубВКарте = ВыборкаЗубы.ЗубВКарте;
		ВетвьЗуб.Наименование = ПолучитьНаименованиеЗуба(ВыборкаЗубы.ЗубВКарте, ДанныеОВыделенныхЗубах);
		ВетвьЗуб.Уровень = 0;
		
		ВыборкаТипИстории = ВыборкаЗубы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВетвиТипИстории = ВетвьЗуб.ПолучитьЭлементы();
		Пока ВыборкаТипИстории.Следующий() Цикл
			
			ВетвьТипИстории = ВетвиТипИстории.Добавить();
			ВетвьТипИстории.Наименование = мсТипыИстории[ВыборкаТипИстории.ТипИстории];
			ВетвьТипИстории.Уровень = 1;
			
			ВетвиЭлементы = ВетвьТипИстории.ПолучитьЭлементы();
			ВыборкаЭлементы = ВыборкаТипИстории.Выбрать();
			Пока ВыборкаЭлементы.Следующий() Цикл
				
				НоваяВетвь = ВетвиЭлементы.Добавить();
				НоваяВетвь.ЗубВКарте = ВыборкаЭлементы.ЗубВКарте;
				НоваяВетвь.Прием = ВыборкаЭлементы.Прием;
				НоваяВетвь.Наименование = ВыборкаЭлементы.Элемент;
				НоваяВетвь.Элемент = ВыборкаЭлементы.Элемент;
				НоваяВетвь.ТипИстории = ВыборкаЭлементы.ТипИстории;
				НоваяВетвь.Уровень = 2;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура стомИсторияЗубовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = стомИсторияЗубов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ЗначениеЗаполнено(ТекДанные.Прием) Тогда
		ОткрытьЗначение(ТекДанные.Прием)	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантЗубнойКартыПриИзменении(Элемент)
	
	ИнициализироватьЗубнуюКарту();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьИсториюЗубов()
		
	ИнициализироватьИсториюЗубовСервер();
	Если ЗначениеЗаполнено(стомДанныеЗубныхКарт.ИсторияЗубов.ВыбраннаяДата) Тогда 
		УстановитьДатуИсторииЗубов(Команды.Найти(стомДанныеЗубныхКарт.ИсторияЗубов.ВыбраннаяДата));
	Иначе
		стомКомпонентыКлиент.ОбработатьЗагрузкуПриложения(ЭтаФорма, Элементы[стомДанныеЗубныхКарт.ИсторияЗубов.ИмяЭлемента], стомДанныеЗубныхКарт.ИсторияЗубов);
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьИсториюЗубовСервер()
	
	ИсторияЗубов = стомДанныеЗубныхКарт.ИсторияЗубов;
	
	стомЗубнаяКартаМетоды.ОчиститьИсториюЗубов(ИсторияЗубов);
		
	Пока Элементы.ГруппаКомандыДаты.ПодчиненныеЭлементы.Количество() > 0 Цикл
		ТекЭлемент = Элементы.ГруппаКомандыДаты.ПодчиненныеЭлементы.Количество() - 1;
		Элементы.Удалить(Элементы.ГруппаКомандыДаты.ПодчиненныеЭлементы[ТекЭлемент]);
	КонецЦикла;
		
	мсДатыПриемов = стомСтоматология.ПолучитьСписокДатДокументовДляИсторииЗубов(Объект.ЗубнаяКарта, Объект.Клиент);
	Сч = 0;
	
	ГруппаКнопок = Элементы.ГруппаКомандыДаты;
	Для Каждого ДатаПриема Из мсДатыПриемов Цикл
			
		ИмяКоманды = "КнопкаИстория" + Формат(Сч, "ЧН=0; ЧГ=");
		Если Команды.Найти(ИмяКоманды) = Неопределено Тогда
			НоваяКоманда = Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Заголовок = Формат(ДатаПриема, "ДЛФ=D");
			НоваяКоманда.Подсказка = Формат(ДатаПриема, "ДЛФ=DT");
			НоваяКоманда.Действие = "УстановитьДатуИсторииЗубов";
		КонецЕсли;
		
		Если стомДанныеЗубныхКарт.ИсторияЗубов.ВыбраннаяДата = Неопределено Тогда 
			стомДанныеЗубныхКарт.ИсторияЗубов.ВыбраннаяДата = ИмяКоманды;
		КонецЕсли;
		ИсторияЗубов.ДоступныеДаты.Вставить(ИмяКоманды, Новый Структура("Дата, Адрес", ДатаПриема, ""));
		
		Если Сч = 6 Тогда
			ГруппаКнопокПодменю = Элементы.Добавить("ГруппаКомандыДатыПодменю", Тип("ГруппаФормы"), Элементы.ГруппаКомандыДаты);
			ГруппаКнопокПодменю.Заголовок = "Остальные (" + Строка(мсДатыПриемов.Количество() - Сч) + ")";
			ГруппаКнопокПодменю.Вид = ВидГруппыФормы.Подменю;
			ГруппаКнопок = ГруппаКнопокПодменю;
		КонецЕсли;
		
		НовыйЭлемент = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ГруппаКнопок);
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;
		Если Сч = 0 Тогда
			НовыйЭлемент.Пометка = Истина;
		КонецЕсли;
		Сч = Сч + 1;
		
	КонецЦикла;
	
	ИсторияЗубов.ИмяЭлемента = Элементы.стомЗубнаяКартаHTMLИстория.Имя;
	ИсторияЗубов.Загружена = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуИсторииЗубов(Команда)
	
	Если Команда = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	стомИсторияЗубов.ПолучитьЭлементы().Очистить();
	Для Каждого ЭлементКнопка Из Элементы.ГруппаКомандыДаты.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ЭлементКнопка) = Тип("КнопкаФормы") Тогда 
			ЭлементКнопка.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	ГруппаПодменю = Элементы.Найти("ГруппаКомандыДатыПодменю");
	Если ГруппаПодменю <> Неопределено Тогда 
		Для Каждого ЭлементКнопка Из ГруппаПодменю.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(ЭлементКнопка) = Тип("КнопкаФормы") Тогда 
				ЭлементКнопка.Пометка = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ИсторияЗубов = стомДанныеЗубныхКарт.ИсторияЗубов;
	ИсторияЗубов.ВыбраннаяДата = Команда.Имя;
	
	ДатаАдрес = ИсторияЗубов.ДоступныеДаты.Получить(ИсторияЗубов.ВыбраннаяДата);
	
	Если ДатаАдрес = Неопределено Тогда 
		ИсторияЗубов.ВыбраннаяДата = Неопределено;
	КонецЕсли;
	
	ДанныеЗКИстории = Новый Структура("АдресЗК, АдресСостояний", АдресЗКИстории, ДатаАдрес.Адрес);
	ИсторияЗубов.Адрес = стомЗубнаяКартаИнициализация.ИнициализироватьЗубнуюКарту(Объект.ЗубнаяКарта, Объект.Клиент, УникальныйИдентификатор, ДатаАдрес.Дата, Объект.ВариантЗубнойКарты, , ДанныеЗКИстории);
	ИсторияЗубов.СтруктураЗагружена = ЭтоАдресВременногоХранилища(ИсторияЗубов.Адрес);
	
	АдресЗКИстории = ДанныеЗКИстории.АдресЗК;
	ДатаАдрес.Адрес = ДанныеЗКИстории.АдресСостояний;
	
	Элементы[ИсторияЗубов.ВыбраннаяДата].Пометка = ИсторияЗубов.СтруктураЗагружена;
	
	стомКомпонентыКлиент.ОбработатьЗагрузкуПриложения(ЭтаФорма, Элементы[ИсторияЗубов.ИмяЭлемента], ИсторияЗубов);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНаименованиеЗуба(ЗубВКарте, ДанныеОВыделенныхЗубах)
	
	Для Каждого Элемент Из ДанныеОВыделенныхЗубах.ВариантыЗубов.УстановленныеВарианты Цикл		
		
		Если Элемент.ЗубВКарте = ЗубВКарте Тогда
			Вариант = ЗубВКарте.Зуб.СписокВариантов.Найти(Элемент.Вариант);
			Если Вариант <> Неопределено И ЗначениеЗаполнено(Вариант.Обозначение) Тогда
				Возврат Вариант.Обозначение;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат ЗубВКарте; 
	
КонецФункции

#КонецОбласти

#Область ПараметрыЗубов

&НаКлиенте
Процедура ИнициализироватьПараметрыЗубнойФормулы()
	
	Если Не ЗначениеЗаполнено(Объект.Клиент) Или Не ЗначениеЗаполнено(Объект.ЗубнаяКарта) Тогда 
		Возврат;
	КонецЕсли;
	
	ИнициализироватьПараметрыЗубнойФормулыСервер();
	Для Каждого СтрокаПараметр Из стомДеревоПараметровЗК.ПолучитьЭлементы() Цикл
		Если СтрокаПараметр.РазворачиватьПоУмолчанию Тогда 
			Элементы.стомДеревоПараметровЗКВерх.Развернуть(СтрокаПараметр.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПараметрыЗубнойФормулы()
	
	Объект.стомПараметрыЗубнойФормулы.Очистить();
	Если ЗначениеЗаполнено(Объект.Клиент) И ЗначениеЗаполнено(Объект.ЗубнаяКарта) Тогда
		ЗагрузитьПараметрыЗубнойФормулыСервер();
		ТребуетсяПереинициализацияПараметровЗубов = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПараметрыЗубнойФормулыСервер()
		
	Объект.стомПараметрыЗубнойФормулы.Очистить();
	
	Если Не ЗначениеЗаполнено(Объект.Клиент) Или Не ЗначениеЗаполнено(Объект.ЗубнаяКарта) Тогда 
		Возврат;
	КонецЕсли;
	
	Объект.стомПараметрыЗубнойФормулы.Загрузить(
		стомСтоматология.ПолучитьПараметрыЗубнойФормулыНаДату(Объект.Клиент, Объект.ЗубнаяКарта, Объект.Дата, Объект.Ссылка));
		
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьПараметрыЗубнойФормулыСервер()
	
	ТаблицаПорядок = Новый ТаблицаЗначений;
	ТаблицаПорядок.Колонки.Добавить("НаименованиеЗуба", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(10)));
	ТаблицаПорядок.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	ТаблицаПорядок.ЗагрузитьКолонку(стомСтоматология.ПолучитьДиапазонЗубовЧелюсти(), "НаименованиеЗуба");
	ДиапазонЗубов = стомСтоматология.ПолучитьДиапазонЗубовЧелюсти();
	Для Сч = 0 По ДиапазонЗубов.Количество() - 1 Цикл
		НоваяСтрока = ТаблицаПорядок.Добавить();
		НоваяСтрока.НаименованиеЗуба = ДиапазонЗубов[Сч];
		НоваяСтрока.Порядок = Сч;
	КонецЦикла;
	
	ОбозначенияЗубов = стомДанныеЗубныхКарт.СписокВыбораЗубов;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПорядокЗубов.НаименованиеЗуба,
	|	ПорядокЗубов.Порядок
	|ПОМЕСТИТЬ ПорядокЗубов
	|ИЗ
	|	&ПорядокЗубов КАК ПорядокЗубов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стомОбластиСегментовСписокПараметров.Ссылка КАК Область,
	|	стомОбластиСегментовСписокПараметров.Параметр.Родитель КАК ГруппаПараметров,
	|	стомОбластиСегментовСписокПараметров.Параметр
	|ПОМЕСТИТЬ ПараметрыПоОбластям
	|ИЗ
	|	Справочник.стомОбластиСегментов.СписокПараметров КАК стомОбластиСегментовСписокПараметров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияПараметров.ЗубВКарте,
	|	ЗначенияПараметров.СегментВЗубе,
	|	ЗначенияПараметров.Параметр,
	|	ЗначенияПараметров.Значение
	|ПОМЕСТИТЬ ЗначенияПараметров
	|ИЗ
	|	&ЗначенияПараметров КАК ЗначенияПараметров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стомЗубыКарты.Ссылка КАК ЗубВКарте,
	|	ВЫБОР
	|		КОГДА стомЗубыКарты.Наименование ПОДОБНО ""[12]_""
	|			ТОГДА ""Верх""
	|		КОГДА стомЗубыКарты.Наименование ПОДОБНО ""[34]_""
	|			ТОГДА ""Низ""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Расположение,
	|	ПорядокЗубов.Порядок
	|ПОМЕСТИТЬ ЗубыКарты
	|ИЗ
	|	Справочник.стомЗубыКарты КАК стомЗубыКарты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПорядокЗубов КАК ПорядокЗубов
	|		ПО стомЗубыКарты.Наименование = ПорядокЗубов.НаименованиеЗуба
	|ГДЕ
	|	НЕ стомЗубыКарты.ПометкаУдаления
	|	И стомЗубыКарты.Владелец = &ЗубнаяКарта     
	|	И ВЫБОР
	|			КОГДА стомЗубыКарты.Наименование ПОДОБНО ""[12]_""
	|				ТОГДА ""Верх""
	|			КОГДА стомЗубыКарты.Наименование ПОДОБНО ""[34]_""
	|				ТОГДА ""Низ""
	|			ИНАЧЕ """"
	|		КОНЕЦ <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗубыКарты.ЗубВКарте КАК ЗубВКарте,
	|	стомСегментыЗубов.Ссылка КАК СегментВЗубе,
	|	ПараметрыПоОбластям.Область,
	|	ПараметрыПоОбластям.ГруппаПараметров,
	|	ПараметрыПоОбластям.Параметр КАК Параметр,
	|	ЗубыКарты.Порядок,
	|	ЗубыКарты.Расположение
	|ПОМЕСТИТЬ ПараметрыПоЗубам
	|ИЗ
	|	ЗубыКарты КАК ЗубыКарты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.стомСегментыЗубов КАК стомСегментыЗубов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПараметрыПоОбластям КАК ПараметрыПоОбластям
	|			ПО стомСегментыЗубов.Сегмент.Область = ПараметрыПоОбластям.Область
	| 		ПО (НЕ стомСегментыЗубов.ПометкаУдаления
	|			И (стомСегментыЗубов.Владелец = &ЗубнаяКарта
	|				ИЛИ ЗубыКарты.ЗубВКарте.Зуб = стомСегментыЗубов.Владелец))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗубыКарты.ЗубВКарте,
	|	ЗубыКарты.Расположение
	|ИЗ
	|	ЗубыКарты КАК ЗубыКарты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗубыКарты.Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыПоЗубам.ГруппаПараметров КАК ГруппаПараметров,
	|	ПараметрыПоЗубам.Параметр КАК Параметр,
	|	ПараметрыПоЗубам.ЗубВКарте КАК ЗубВКарте,
	|	ПараметрыПоЗубам.Область,
	|	ПараметрыПоЗубам.СегментВЗубе,
	|	ЗначенияПараметров.Значение
	|ИЗ
	|	ПараметрыПоЗубам КАК ПараметрыПоЗубам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗначенияПараметров КАК ЗначенияПараметров
	|		ПО ПараметрыПоЗубам.ЗубВКарте = ЗначенияПараметров.ЗубВКарте
	|			И ПараметрыПоЗубам.СегментВЗубе = ЗначенияПараметров.СегментВЗубе
	|			И ПараметрыПоЗубам.Параметр = ЗначенияПараметров.Параметр
	|ИТОГИ ПО
	|	ГруппаПараметров,
	|	Параметр,
	|	ЗубВКарте";
	Запрос.УстановитьПараметр("ЗначенияПараметров", Объект.стомПараметрыЗубнойФормулы.Выгрузить());
	Запрос.УстановитьПараметр("ПорядокЗубов", ТаблицаПорядок);
	Запрос.УстановитьПараметр("ЗубнаяКарта", Объект.ЗубнаяКарта);
	Результат = Запрос.ВыполнитьПакет();
	
	ТипПараметров = Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.стомПараметрыЗубнойФормулы.Тип, "СписокЗначений");
	ТипЗуб = Новый ОписаниеТипов("СправочникСсылка.стомЗубыКарты");
	ТипСегмент = Новый ОписаниеТипов("СправочникСсылка.стомСегментыЗубов");
	ТипТаблица = Новый ОписаниеТипов("ТаблицаЗначений");
	
	ПутьРеквизитов = "стомДеревоПараметровЗК";
	соотвПараметрыСтрокиТаблицы = Новый Соответствие;
	соотвГруппыПараметровСтрокиТаблицы = Новый Соответствие;
	
	соотвГруппыПараметровСтрокиТаблицы.Вставить(ПланыВидовХарактеристик.стомПараметрыЗубнойФормулы.ПустаяСсылка(), стомДеревоПараметровЗК);
	
	Если стомДанныеЗубныхКарт.ПараметрыЗубов.РеквизитыЗагружены Тогда
		
		// Обновляем обозначения зубов
		ОбновитьОбозначенияКолонокПараметровЗубов(ОбозначенияЗубов);
		
	Иначе
		
		// Создаем динамические реквизиты
		ВыборкаЗубы = Результат[5].Выбрать();
		Пока ВыборкаЗубы.Следующий() Цикл
			
			ОбозначениеЗуба = Строка(ВыборкаЗубы.ЗубВКарте);
			элЗуб = ОбозначенияЗубов.НайтиПоЗначению(ВыборкаЗубы.ЗубВКарте);
			Если элЗуб <> Неопределено Тогда
				ОбозначениеЗуба = элЗуб.Представление;
			КонецЕсли;
			
			УидРеквизита = ОбщегоНазначенияКлиентСерверПереопределяемый.УИДВСтроку(ВыборкаЗубы.ЗубВКарте.УникальныйИдентификатор());
			// Реквизиты ТЧ
			СтолбецЗуб = Новый РеквизитФормы("ЗубВКарте" + УидРеквизита, ТипЗуб, ПутьРеквизитов);
			СтолбецСегмент = Новый РеквизитФормы("СегментВЗубе" + УидРеквизита, ТипСегмент, ПутьРеквизитов);
			СтолбецЗначение = Новый РеквизитФормы("Значение" + УидРеквизита, ТипПараметров, ПутьРеквизитов, ОбозначениеЗуба);
			СтолбецСегменты = Новый РеквизитФормы("Сегменты" + УидРеквизита, ТипТаблица, ПутьРеквизитов);
			СтолбецСегментыСегмент = Новый РеквизитФормы("СегментВЗубе", ТипСегмент, ПутьРеквизитов + "." + СтолбецСегменты.Имя);
			СтолбецСегментыЗначение = Новый РеквизитФормы("Значение", ТипПараметров, ПутьРеквизитов + "." + СтолбецСегменты.Имя);
			
			
			мсНовыеРеквизиты = Новый Массив;
			мсНовыеРеквизиты.Добавить(СтолбецЗуб);
			мсНовыеРеквизиты.Добавить(СтолбецСегмент);
			мсНовыеРеквизиты.Добавить(СтолбецЗначение);
			мсНовыеРеквизиты.Добавить(СтолбецСегменты);
			мсНовыеРеквизиты.Добавить(СтолбецСегментыСегмент);
			мсНовыеРеквизиты.Добавить(СтолбецСегментыЗначение);
			
			Попытка
				ИзменитьРеквизиты(мсНовыеРеквизиты);
				
				// Элемент ТЧ
				ЭлементТЧ = Элементы[ПутьРеквизитов + ВыборкаЗубы.Расположение];
				ЭлементЗначение = Элементы.Добавить(ПутьРеквизитов + "Значение" + УидРеквизита, Тип("ПолеФормы"), ЭлементТЧ);
				ЭлементЗначение.Вид = ВидПоляФормы.ПолеВвода;
				ЭлементЗначение.ПутьКДанным = СтолбецЗначение.Путь + "." + СтолбецЗначение.Имя;
				ЭлементЗначение.Заголовок = ОбозначениеЗуба;
				ЭлементЗначение.ТекстПодвала = ОбозначениеЗуба;
				ЭлементЗначение.ШрифтЗаголовка = Новый Шрифт(ЭлементЗначение.ШрифтЗаголовка, , , Истина);
				ЭлементЗначение.ШрифтПодвала = ЭлементЗначение.ШрифтЗаголовка;
				ЭлементЗначение.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
				ЭлементЗначение.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Центр;
				ЭлементЗначение.Ширина = 1;
				ЭлементЗначение.ВыбиратьТип = Ложь;
				ЭлементЗначение.БыстрыйВыбор = Истина;
				ЭлементЗначение.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
				ЭлементЗначение.УстановитьДействие("НачалоВыбора", "стомДеревоПараметровЗКЗначениеНачалоВыбора");
				ЭлементЗначение.УстановитьДействие("ПриИзменении", "стомДеревоПараметровЗКЗначениеПриИзменении");
				ЭлементЗначение.УстановитьДействие("Регулирование", "стомДеревоПараметровЗКЗначениеРегулирование");
				
				// Связи параметров выбора для параметров с типом "Доп. значения характеристик"
				НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы." + ЭлементТЧ.Имя + ".ТекущиеДанные.Параметр");
				мсСвязиПараметров = Новый Массив;
				мсСвязиПараметров.Добавить(НоваяСвязь);
				ЭлементЗначение.СвязиПараметровВыбора = Новый ФиксированныйМассив(мсСвязиПараметров);
			Исключение КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	ВерхУровеньПараметров = стомДеревоПараметровЗК.ПолучитьЭлементы();
	ВерхУровеньПараметров.Очистить();
	
	// Заполняем параметры зубов
	ВыборкаГруппыПараметров = Результат[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаГруппыПараметров.Следующий() Цикл
		
		НоваяГруппа = ВерхУровеньПараметров.Добавить();
		НоваяГруппа.Параметр = ВыборкаГруппыПараметров.ГруппаПараметров;
		НоваяГруппа.НомерКартинки = 0;
		НоваяГруппа.РазворачиватьПоУмолчанию = ВыборкаГруппыПараметров.ГруппаПараметров.РазворачиватьПоУмолчанию;
		УровеньГруппы = НоваяГруппа.ПолучитьЭлементы();
		
		ВыборкаПараметры = ВыборкаГруппыПараметров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПараметры.Следующий() Цикл
			
			НовыйПараметр = УровеньГруппы.Добавить();
			НовыйПараметр.Параметр = ВыборкаПараметры.Параметр;
			НовыйПараметр.ТипЗначения = ВыборкаПараметры.Параметр.ТипЗначения;
			НовыйПараметр.НомерКартинки = -1;
			НовыйПараметр.Регулирование = ВыборкаПараметры.Параметр.Регулирование;
			
			ЗначениеПоУмолчанию = НовыйПараметр.ТипЗначения.ПривестиЗначение(НовыйПараметр.Параметр.ЗначениеПоУмолчанию);
			
			ВыборкаЗубы = ВыборкаПараметры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗубы.Следующий() Цикл
				
				УидРеквизита = ОбщегоНазначенияКлиентСерверПереопределяемый.УИДВСтроку(ВыборкаЗубы.ЗубВКарте.УникальныйИдентификатор());
				НовыйПараметр["ЗубВКарте" + УидРеквизита] = ВыборкаЗубы.ЗубВКарте;
				НовыйПараметр["Значение" + УидРеквизита] = ЗначениеПоУмолчанию;
				
				ТаблицаСегментов = НовыйПараметр["Сегменты" + УидРеквизита];
				
				ВыборкаЗначения = ВыборкаЗубы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				СписокЗначенийПараметров = Новый СписокЗначений;
				Пока ВыборкаЗначения.Следующий() Цикл
					
					ЗначениеПараметра = ?(ЗначениеЗаполнено(ВыборкаЗначения.Значение), ВыборкаЗначения.Значение, ЗначениеПоУмолчанию);
					
					НовоеЗначение = ТаблицаСегментов.Добавить();
					НовоеЗначение.СегментВЗубе = ВыборкаЗначения.СегментВЗубе;
					НовоеЗначение.Значение = ЗначениеПараметра;
					
					СписокЗначенийПараметров.Добавить(ЗначениеПараметра, Формат(ЗначениеПараметра, НовыйПараметр.Параметр.ФорматПредставления));
					
				КонецЦикла;
				
				Если СписокЗначенийПараметров.Количество() = 1 Тогда // Если один параметр, то он сразу редактируется в поле 
					НовыйПараметр["Значение" + УидРеквизита] = СписокЗначенийПараметров[0].Значение;
				Иначе // Иначе выводится список параметров
					НовыйПараметр["Значение" + УидРеквизита] = СписокЗначенийПараметров;
				КонецЕсли;
				НовыйПараметр.СписокПолейДляУсловногоОформления.Добавить("стомДеревоПараметровЗКЗначение" + УидРеквизита);
				
			КонецЦикла;
			
			Если НовыйПараметр.СписокПолейДляУсловногоОформления.Количество() > 0 Тогда
				ДобавитьУсловноеОформлениеПараметраЗуба(НовыйПараметр.Параметр, НовыйПараметр.СписокПолейДляУсловногоОформления);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	стомДанныеЗубныхКарт.ПараметрыЗубов.Загружены = Истина;
	стомДанныеЗубныхКарт.ПараметрыЗубов.РеквизитыЗагружены = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеПараметраЗуба(Параметр, СписокПолей)
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = "ПараметрыЗубов";
	Для Каждого Элемент Из СписокПолей Цикл
		ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Элемент.Значение);
	КонецЦикла;
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("стомДеревоПараметровЗК.Параметр");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Параметр;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Формат", Параметр.ФорматПредставления);
			
КонецПроцедуры

&НаСервере
Процедура ОбновитьОбозначенияКолонокПараметровЗубов(ОбозначенияЗубов = Неопределено)
	
	Если ОбозначенияЗубов = Неопределено Тогда
		ОбозначенияЗубов = стомЗубнаяКартаМетоды.ПолучитьСписокВыбораЗубов(стомДанныеЗубныхКарт.Адрес, Ложь);
	КонецЕсли;
	
	Для Каждого элЗуб Из ОбозначенияЗубов Цикл
		Попытка
			УидРеквизита = ОбщегоНазначенияКлиентСерверПереопределяемый.УИДВСтроку(элЗуб.Значение.УникальныйИдентификатор());
			КолонкаЗуб = Элементы["стомДеревоПараметровЗКЗначение" + УидРеквизита];
			КолонкаЗуб.Заголовок = элЗуб.Представление;
			КолонкаЗуб.ТекстПодвала = элЗуб.Представление;
			КолонкаЗуб.Подсказка = элЗуб.Представление;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура стомДеревоПараметровЗКПередРазворачиванием(Элемент, Строка, Отказ)
	
	Если стомДанныеЗубныхКарт.ПараметрыЗубов.НеВызыватьОбработчикСворачиванияРазворачивания Тогда
		стомДанныеЗубныхКарт.ПараметрыЗубов.НеВызыватьОбработчикСворачиванияРазворачивания = Ложь;
		Возврат;
	КонецЕсли;
	
	Если стомДеревоПараметровЗК.НайтиПоИдентификатору(Строка) = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	стомДанныеЗубныхКарт.ПараметрыЗубов.НеВызыватьОбработчикСворачиванияРазворачивания = Истина;
	
	Если Элемент = Элементы.стомДеревоПараметровЗКНиз Тогда
		Элементы.стомДеревоПараметровЗКВерх.Развернуть(Строка, Ложь);
	ИначеЕсли Элемент = Элементы.стомДеревоПараметровЗКВерх Тогда 
		Элементы.стомДеревоПараметровЗКНиз.Развернуть(Строка, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура стомДеревоПараметровЗКПередСворачиванием(Элемент, Строка, Отказ)
	
	Если стомДанныеЗубныхКарт.ПараметрыЗубов.НеВызыватьОбработчикСворачиванияРазворачивания Тогда
		стомДанныеЗубныхКарт.ПараметрыЗубов.НеВызыватьОбработчикСворачиванияРазворачивания = Ложь;
		Возврат;
	КонецЕсли;

	Если стомДеревоПараметровЗК.НайтиПоИдентификатору(Строка) = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	стомДанныеЗубныхКарт.ПараметрыЗубов.НеВызыватьОбработчикСворачиванияРазворачивания = Истина;
	
	Если Элемент = Элементы.стомДеревоПараметровЗКНиз Тогда  
		Элементы.стомДеревоПараметровЗКВерх.Свернуть(Строка);
	ИначеЕсли Элемент = Элементы.стомДеревоПараметровЗКВерх Тогда 
		Элементы.стомДеревоПараметровЗКНиз.Свернуть(Строка);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура стомДеревоПараметровЗКЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЭлементТаблица = ОбщегоНазначенияКлиентСерверПереопределяемый.НайтиТаблицуПоляФормы(Элемент);
	ТекДанные = ЭлементТаблица.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	УидПараметра = СтрЗаменить(Элемент.Имя, "стомДеревоПараметровЗКЗначение", "");
	ТаблицаСегментов = ТекДанные["Сегменты" + УидПараметра];
	
	Если ТаблицаСегментов.Количество() > 1 Тогда 
		
		СтандартнаяОбработка = Ложь;
		
		Контекст = Новый Структура("ТаблицаСегментов, Элемент, УидПараметра, ТекДанные", ТаблицаСегментов, Элемент, УидПараметра, ТекДанные);
		ПараметрыФормы = Новый Структура("Параметр, СписокСегментов, ОбозначениеЗуба", ТекДанные.Параметр, ТаблицаСегментов, Элемент.Заголовок);
		Оповещение = Новый ОписаниеОповещения("стомДеревоПараметровЗКЗначениеПослеВыбора", ЭтаФорма, Контекст);
		ОткрытьФорму("Документ.Прием.Форма.стомФормаЗаполненияПараметраЗуба", ПараметрыФормы, , , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура стомДеревоПараметровЗКЗначениеПослеВыбора(ЗначенияПараметра, ДополнительныеПараметры) Экспорт 
	
	Если ЗначенияПараметра = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ТаблицаСегментов = ДополнительныеПараметры.ТаблицаСегментов;
	Элемент = ДополнительныеПараметры.Элемент;
	УидПараметра = ДополнительныеПараметры.УидПараметра;
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	
	СписокЗначенийПараметра = Новый СписокЗначений;
	ТаблицаСегментов.Очистить();
	Для Каждого СтрокаСегмент Из ЗначенияПараметра Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаСегментов.Добавить(), СтрокаСегмент);
		СписокЗначенийПараметра.Добавить(СтрокаСегмент.Значение, Формат(СтрокаСегмент.Значение, Элемент.Формат));
	КонецЦикла;
	
	ТекДанные["Значение" + УидПараметра] = СписокЗначенийПараметра;
	стомДеревоПараметровЗКЗначениеПриИзменении(Элемент);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура стомДеревоПараметровЗКЗначениеПриИзменении(Элемент)
	
	ЭлементТаблица = ОбщегоНазначенияКлиентСерверПереопределяемый.НайтиТаблицуПоляФормы(Элемент);
	ТекДанные = ЭлементТаблица.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	УидПараметра = СтрЗаменить(Элемент.Имя, "стомДеревоПараметровЗКЗначение", "");
	ТаблицаСегментов = ТекДанные["Сегменты" + УидПараметра];
	
	ОтборСтрок = Новый Структура("ЗубВКарте, Параметр", ТекДанные["ЗубВКарте" + УидПараметра], ТекДанные.Параметр);
	Если ТаблицаСегментов.Количество() = 1 Тогда // Если только один сегмент, то его значение заполняется из поля 
		ТаблицаСегментов[0].Значение = ТекДанные["Значение" + УидПараметра];
	КонецЕсли;
	
	Для Каждого СтрокаСегмент Из ТаблицаСегментов Цикл 
		
		ОтборСтрок.Вставить("СегментВЗубе", СтрокаСегмент.СегментВЗубе);
		СтрокиПараметры = Объект.стомПараметрыЗубнойФормулы.НайтиСтроки(ОтборСтрок);
		Если СтрокиПараметры.Количество() = 0 Тогда
			СтрокаПараметр = Объект.стомПараметрыЗубнойФормулы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПараметр, ОтборСтрок);
			СтрокаПараметр.Значение = СтрокаСегмент.Значение;
			СтрокаПараметр.ИзмененоВТекущемПриеме = Истина;
		Иначе
			СтрокиПараметры[0].Значение = СтрокаСегмент.Значение;
			СтрокиПараметры[0].ИзмененоВТекущемПриеме = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура стомДеревоПараметровЗКПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтоГруппа = (ТекДанные.НомерКартинки = 0);
	//Элемент.ТолькоПросмотр = ЭтоГруппа;
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	СписокРеквизитов = "МинимальноеЗначение, МаксимальноеЗначение, ЗапретРучногоРедактирования, Регулирование, ФорматРедактирования, ФорматПредставления";
	РеквизитыПараметра = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ТекДанные.Параметр, СписокРеквизитов);
		
	Для Каждого ИмяКолонкиЗуб Из ТекДанные.СписокПолейДляУсловногоОформления Цикл
		
		КолонкаЗуб = Элементы[ИмяКолонкиЗуб.Значение];
		
		УидПараметра = СтрЗаменить(КолонкаЗуб.Имя, "стомДеревоПараметровЗКЗначение", "");
	    ТаблицаСегментов = ТекДанные["Сегменты" + УидПараметра];
		
		НесколькоСегментов = (ТаблицаСегментов.Количество() > 1);
		
		КолонкаЗуб.РедактированиеТекста = Не РеквизитыПараметра.ЗапретРучногоРедактирования;
		Если НесколькоСегментов Тогда 
			КолонкаЗуб.КнопкаВыбора = Истина;
		Иначе
			КолонкаЗуб.КнопкаВыбора = ?(РеквизитыПараметра.ЗапретРучногоРедактирования, Ложь, Неопределено);
		КонецЕсли;
		КолонкаЗуб.МинимальноеЗначение = РеквизитыПараметра.МинимальноеЗначение;
		КолонкаЗуб.МаксимальноеЗначение = РеквизитыПараметра.МаксимальноеЗначение;
		КолонкаЗуб.КнопкаРегулирования = ?(РеквизитыПараметра.Регулирование > 0, Не НесколькоСегментов, Неопределено);
		КолонкаЗуб.ФорматРедактирования = РеквизитыПараметра.ФорматРедактирования;
		КолонкаЗуб.Формат = РеквизитыПараметра.ФорматПредставления;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура стомДеревоПараметровЗКЗначениеРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ЭлементТаблица = ОбщегоНазначенияКлиентСерверПереопределяемый.НайтиТаблицуПоляФормы(Элемент);
	ТекДанные = ЭлементТаблица.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
		
	УидПараметра = СтрЗаменить(Элемент.Имя, "стомДеревоПараметровЗКЗначение", "");
	ИмяКолонки = "Значение" + УидПараметра;
	НовоеЗначение = ТекДанные[ИмяКолонки] + Направление * ТекДанные.Регулирование;
	
	// Проверка выхода за диапазон
	Если Элемент.МинимальноеЗначение <> 0 Или Элемент.МаксимальноеЗначение <> 0 Тогда
		НовоеЗначение = Макс(НовоеЗначение, Элемент.МинимальноеЗначение);
		НовоеЗначение = Мин(НовоеЗначение, Элемент.МаксимальноеЗначение);
	КонецЕсли;
	
	ТекДанные[ИмяКолонки] = НовоеЗначение;		
	стомДеревоПараметровЗКЗначениеПриИзменении(Элемент);
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ВводЗубаПоПодстроке // Платформа не дает ввод по подстроке для составных типов даже в Режиме выбора из списка. Обходим ограничение.

&НаКлиенте
Процедура РаботыЗубВКартеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ЗубВКартеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка, Элементы.Работы);

КонецПроцедуры

&НаКлиенте
Процедура ДиагнозыЗубВКартеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ЗубВКартеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка, Элементы.Диагнозы);

КонецПроцедуры

&НаКлиенте
Процедура ЗубВКартеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка, ТаблицаФормы)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение)
		И Не ЗначениеЗаполнено(Элемент.ОграничениеТипа.ПривестиЗначение(ВыбранноеЗначение))
	Тогда
		ТаблицаФормы.ТекущиеДанные.ЗубВКарте = ВыбранноеЗначение;
		Типы = Новый Массив;
		Типы.Добавить(ТипЗнч(ВыбранноеЗначение));

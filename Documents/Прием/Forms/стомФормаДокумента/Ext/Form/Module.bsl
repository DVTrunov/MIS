&НаКлиентеНаСервереБезКонтекста
Функция ДобавитьЗубВПланЛечения(Форма, ЗубВКарте = Неопределено, СписокНазначенийДляКопирования = Неопределено)
	
	Если ЗубВКарте = Неопределено Тогда
		ЗубВКарте = ПредопределенноеЗначение("Справочник.стомЗубыКарты.ПустаяСсылка");
	КонецЕсли;
	
	СтрокаЗуб = НайтиГруппуПланаЛечения(Форма, ЗубВКарте.УникальныйИдентификатор());    	
	Если СтрокаЗуб = Неопределено Тогда
		НоваяСтрока = Форма.СписокНазначений.ПолучитьЭлементы().Добавить();
		НоваяСтрока.Назначение = ЗубВКарте;
		НоваяСтрока.ЗубВКарте = ЗубВКарте;
		НоваяСтрока.ИдентификаторНазначения = Строка(ЗубВКарте.УникальныйИдентификатор());
		СтрокаЗуб = НоваяСтрока;
	КонецЕсли;

	// Копирование назначений из другого зуба
	Если СписокНазначенийДляКопирования <> Неопределено Тогда
		СписокНазначений = СтрокаЗуб.ПолучитьЭлементы();
		Если СписокНазначений <> СписокНазначенийДляКопирования Тогда 
			Для Каждого СтрокаНазначение Из СписокНазначенийДляКопирования Цикл
				НоваяСтрокаНазначение = СписокНазначений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаНазначение, СтрокаНазначение);
				ЗаполнитьЗначенияСвойств(НоваяСтрокаНазначение, СтрокаЗуб, "ЗубВКарте, Факт");
				НоваяСтрокаНазначение.ИдентификаторНазначения = Новый УникальныйИдентификатор;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрокаЗуб.ПолучитьИдентификатор();
	
КонецФункции

&НаКлиенте
Функция ДобавитьНазначениеВПланЛечения(Знач ДанныеЗуба, Назначение = Неопределено, СегментВЗубе = Неопределено)
	
	Если ТипЗнч(ДанныеЗуба) = Тип("СправочникСсылка.стомЗубыКарты") Тогда
		ДанныеЗуба = СписокНазначений.НайтиПоИдентификатору(ДобавитьЗубВПланЛечения(ЭтаФорма, ДанныеЗуба));
	КонецЕсли;
	
	Если Назначение = Неопределено Тогда
		Назначение = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	КонецЕсли;
	
	НоваяСтрока = ДанныеЗуба.ПолучитьЭлементы().Добавить();
	НоваяСтрока.Назначение	= Назначение;
	НоваяСтрока.ЗубВКарте	= ДанныеЗуба.ЗубВКарте;
	НоваяСтрока.СегментВЗубе = СегментВЗубе;
	НоваяСтрока.ИдентификаторНазначения = Новый УникальныйИдентификатор;
	НоваяСтрока.Количество = 1;
	
	Возврат НоваяСтрока.ПолучитьИдентификатор();
	
КонецФункции

&НаКлиенте
Процедура НазначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ТекДанные = Элементы.Назначения.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтоЗуб = ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.стомКонструкцииЗубовКлиентов")
		Или ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.стомЗубыКарты");
	
	Если ЭтоЗуб	Тогда
		
		ТекДанные.ЗубВКарте = ВыбранноеЗначение;
		ТекДанные.Назначение = ВыбранноеЗначение;
		ТекДанные.ИдентификаторНазначения = ВыбранноеЗначение.УникальныйИдентификатор();	
	
	КонецЕсли;
	
	ЗубВКартеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка, Элементы.Назначения);
	
	Если ЭтоЗуб	Тогда
		НазначенияЗуба = СписокНазначений.НайтиПоИдентификатору(Элементы.Назначения.ТекущаяСтрока).ПолучитьЭлементы();
		Если НазначенияЗуба.Количество() = 0 Тогда
			Элементы.Назначения.ТекущаяСтрока = ДобавитьНазначениеВПланЛечения(ТекДанные);
			Элементы.Назначения.ИзменитьСтроку();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПодборПланаЛеченияПослеВыбораНазначений(СписокНазначений, ДополнительныеПараметры) Экспорт
	
	Если СписокНазначений <> Неопределено Тогда
		Для Каждого ЭлементСписка Из СписокНазначений Цикл
			ДобавитьНазначениеВыделеннымЗубамСегментам(ЭлементСписка.Назначение);
		КонецЦикла;
		ПересчитатьСуммыПланаЛечения(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыПланаЛечения(Форма, ИзмененнаяСтрокаНазначения = Неопределено)
	
	Если ИзмененнаяСтрокаНазначения = Неопределено Тогда 
		Форма.СуммаПланаЛечения = ПересчитатьСуммыПланаЛеченияРекурсивно(Форма.СписокНазначений);
	Иначе
		СтрокаЗуб = ИзмененнаяСтрокаНазначения.ПолучитьРодителя();
		ПредСумма = СтрокаЗуб.Сумма;
		НоваяСумма = ПересчитатьСуммыПланаЛеченияРекурсивно(СтрокаЗуб);
		Форма.СуммаПланаЛечения = Форма.СуммаПланаЛечения - (ПредСумма - НоваяСумма);
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьСуммыПланаЛеченияРекурсивно(УзелДерева)
	
	ВетвиДерева = УзелДерева.ПолучитьЭлементы();
	Если ВетвиДерева.Количество() = 0 Тогда
		Если ТипЗнч(УзелДерева) = Тип("ДанныеФормыДерево") Тогда
			Возврат 0;
		Иначе
			УзелДерева.Сумма = УзелДерева.Цена * УзелДерева.Количество;
			Возврат УзелДерева.Сумма;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураУзла = Новый Структура("Сумма", 0);
	Для Каждого ВетвьДерева Из ВетвиДерева Цикл
		СтруктураУзла.Сумма = СтруктураУзла.Сумма + ПересчитатьСуммыПланаЛеченияРекурсивно(ВетвьДерева);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(УзелДерева, СтруктураУзла);
	
	Возврат СтруктураУзла.Сумма;
	
КонецФункции

#Область Стоматология

&НаКлиенте
Процедура ОчиститьПустуюТаблицуДиагнозов(ПриЗаписи = Ложь)

	Если (Объект.Диагнозы.Количество() = 1) 
			И Не ЗначениеЗаполнено(Объект.Диагнозы[0].Диагноз) 
			И Не ЗначениеЗаполнено(Объект.Диагнозы[0].Детализация)
			И (ПриЗаписи
				Или (Не ЗначениеЗаполнено(Объект.Диагнозы[0].ЗубВКарте)
					И Не ЗначениеЗаполнено(Объект.Диагнозы[0].СегментВЗубе)))
	Тогда
		Объект.Диагнозы.Очистить();	
	КонецЕсли; 	

КонецПроцедуры

#Область Инициализация

&НаКлиенте
Процедура ИнициализироватьЗубнуюКарту(ПеревыбратьКартуВариант = Ложь)
	
	ИнициализироватьЗубнуюКартуСервер();
	
	стомКомпонентыКлиент.ОбработатьЗагрузкуПриложения(ЭтаФорма, Элементы[стомДанныеЗубныхКарт.ИмяЭлемента], стомДанныеЗубныхКарт);
	ВыделитьЗубыУпрощеннойЗубнойКарты();
	Элементы.ГруппаСтраницыЗубнойКарты.ТекущаяСтраница = Элементы.СтраницаРедактированиеЗубнойКарты;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьЗубнуюКартуСервер()
	
	стомЗубнаяКартаHTML = ПараметрыСеанса.стомКешированныеДанныеЗК.ПриложениеHTML;
	стомЗубнаяКартаМетоды.ИнициализироватьЗубнуюКарту(ЭтаФорма);
	стомДанныеЗубныхКарт.ИмяЭлемента = Элементы.стомЗубнаяКартаHTML.Имя;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПараметрыПриложения(Элемент, ВыделенныеЗубыСегменты) Экспорт
	
	Если Элемент = Элементы.стомЗубнаяКартаHTML Тогда
		ПриВыделенииЗубовСегментов(ВыделенныеЗубыСегменты);
	ИначеЕсли Элемент = Элементы.стомЗубнаяКартаHTMLИстория Тогда
		СформироватьИсториюЗубов(ВыделенныеЗубыСегменты);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьУсловноеОформлениеСпискиВыбораЗубов()
	
	стомЗубнаяКартаМетоды.УстановитьУсловноеОформлениеЗубов(ЭтаФорма);
	
КонецПроцедуры


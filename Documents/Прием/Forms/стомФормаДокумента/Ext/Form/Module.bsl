&НаКлиенте
Процедура стомЗубнаяКартаHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	стомКомпонентыКлиент.ОбработатьСобытиеПриложения(ЭтаФорма, Элемент, ДанныеСобытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыделенииЗубовСегментов(ВыделенныеЗубыСегментыJS, ОбновлятьВарианты = Истина, ОбновлятьСостояния = Истина, ОбновлятьДиагнозы = Истина)
	
	Если Не стомДанныеЗубныхКарт.СтруктураЗагружена Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеОВыделении = стомЗубнаяКартаМетоды.ПолучитьДанныеОВыделенныхЗубахСегментах(
		стомДанныеЗубныхКарт.Адрес, ВыделенныеЗубыСегментыJS, ОбновлятьВарианты, ОбновлятьСостояния, ?(ОбновлятьДиагнозы, Объект.Диагнозы, Неопределено));
	
	стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты = ДанныеОВыделении.ВыделенныеЗубыСегменты;
	
	Элементы.стомДиагнозы.ТолькоПросмотр = (стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() = 0);
	
	// Перезаполнение списков
	Если ОбновлятьВарианты Тогда
		ОтборСтроки = стомЗубнаяКартаМетодыКлиентСервер.СохранитьТекщуюСтрокуТаблицыФормы(Элементы.стомДоступныеВарианты, "Вариант, Область, ЗубВКарте");
		стомДоступныеВарианты.ПолучитьЭлементы().Очистить();
		стомЗубнаяКартаМетодыКлиентСервер.ЗаполнитьДеревоДоступныхВариантов(ДанныеОВыделении.ВариантыЗубов.Варианты, стомДоступныеВарианты);
		стомЗубнаяКартаМетодыКлиентСервер.ВосстановитьТекущуюСтрокуТаблицыФормы(Элементы.стомДоступныеВарианты, стомДоступныеВарианты, ОтборСтроки);
	КонецЕсли;	
	Если ОбновлятьСостояния Тогда 	
		ОтборСтроки = стомЗубнаяКартаМетодыКлиентСервер.СохранитьТекщуюСтрокуТаблицыФормы(Элементы.стомДоступныеСостояния, "Состояние, СегментВЗубе, ЗубВКарте");
		стомДоступныеСостояния.ПолучитьЭлементы().Очистить();
		стомЗубнаяКартаМетодыКлиентСервер.ЗаполнитьДеревоДоступныхСостояний(ДанныеОВыделении.СостоянияЗубов.Состояния, стомДоступныеСостояния);
		стомЗубнаяКартаМетодыКлиентСервер.ВосстановитьТекущуюСтрокуТаблицыФормы(Элементы.стомДоступныеСостояния, стомДоступныеСостояния, ОтборСтроки);
	КонецЕсли;
	Если ОбновлятьДиагнозы Тогда
		ОтборСтроки = стомЗубнаяКартаМетодыКлиентСервер.СохранитьТекщуюСтрокуТаблицыФормы(Элементы.стомДиагнозы, "Диагноз");
		стомДиагнозы.Очистить();
		Для Каждого СтрокаДиагноз Из ДанныеОВыделении.Диагнозы Цикл
			ЗаполнитьЗначенияСвойств(стомДиагнозы.Добавить(), СтрокаДиагноз);
		КонецЦикла;
		стомЗубнаяКартаМетодыКлиентСервер.ВосстановитьТекущуюСтрокуТаблицыФормы(Элементы.стомДиагнозы, стомДиагнозы, ОтборСтроки);
	КонецЕсли;
	
	ВыделитьЗубыУпрощеннойЗубнойКарты();
	
КонецПроцедуры

&НаКлиенте
Процедура стомДоступныеСостоянияСостояниеУстановленоПриИзменении(Элемент)

	ТекДанные = Элементы.стомДоступныеСостояния.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	// Установка состояний
	стомЗубнаяКартаМетодыКлиентСервер.УстановкаСнятиеСостоянияВДереве(ЭтаФорма, стомДоступныеСостояния, ТекДанные); 	

	// Обновление диагнозов, в связи с установкой состояния
	ПриВыделенииЗубовСегментов(стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты, Ложь, Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура стомДоступныеВариантыВариантУстановленПриИзменении(Элемент)
	
	ТекДанные = Элементы.стомДоступныеВарианты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	стомЗубнаяКартаМетодыКлиентСервер.УстановкаСнятиеВариантаВДереве(ЭтаФорма, стомДоступныеВарианты, ТекДанные);
	ПриВыделенииЗубовСегментов(стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты);
	ОбновитьУсловноеОформлениеСпискиВыбораЗубов();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьКонструкцииПередЗаписью(ТекущийОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Документ проводится задним числом и это не перепроведение
	Если (НЕ Объект.Проведен) И (стомУстановленныеКонструкции.Количество() > 0) И (НачалоДня(Объект.Дата) < НачалоДня(ТекущаяДата())) Тогда
		// Ищем есть ли хоть один документ приёма более позднего времени
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	стомВариантыЗубовСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.стомВариантыЗубов.СрезПоследних(&ТекущаяДата, Клиент = &ТекущийКлиент) КАК стомВариантыЗубовСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("ТекущийКлиент", Объект.Клиент);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.Период > Объект.Дата Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Проведение этого документа нарушает последовательность документов.
				| Откройте и Перепроведите последний по дате документ у данного пользователя'"));
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицыСКонструкциями = Новый Массив;
	ТаблицыСКонструкциями.Добавить(ТекущийОбъект.Диагнозы);
	ТаблицыСКонструкциями.Добавить(ТекущийОбъект.Работы);
	
	мсКонструкцииНаУдаление = Новый Массив;
	Для Каждого СтрокаКонструкция Из стомУстановленныеКонструкции Цикл 
		Если СтрокаКонструкция.НеСоздана И СтрокаКонструкция.Удалена Тогда 
			мсКонструкцииНаУдаление.Добавить(СтрокаКонструкция);
		Иначе
			КонструкцияОбъект = СтрокаКонструкция.Конструкция.ПолучитьОбъект();
			КонструкцияОбъект.ПометкаУдаления = СтрокаКонструкция.Удалена;
			Если Не ЗначениеЗаполнено(КонструкцияОбъект.ДатаУстановки) Тогда 
				КонструкцияОбъект.ДатаУстановки = ТекущийОбъект.Дата;
			КонецЕсли;
			Если СтрокаКонструкция.Удалена И Не ЗначениеЗаполнено(КонструкцияОбъект.ДатаУдаления) Тогда 
				КонструкцияОбъект.ДатаУдаления = ТекущийОбъект.Дата;
			КонецЕсли;
			Если СтрокаКонструкция.ОбозначениеИзменено Или КонструкцияОбъект.Предварительная Тогда 
				КонструкцияОбъект.Наименование = СтрокаКонструкция.Обозначение;
				КонструкцияОбъект.Комментарий = СтрокаКонструкция.Комментарий;
			КонецЕсли;
			КонструкцияОбъект.Предварительная = Ложь;
			КонструкцияОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
	// Удаляем строки, содержащие удаленную конструкцию
	Если мсКонструкцииНаУдаление.Количество() > 0 Тогда 
		
		Для Каждого Таблица Из ТаблицыСКонструкциями Цикл
			Для Каждого Конструкция Из мсКонструкцииНаУдаление Цикл
				СтрокиТаблицы = Таблица.НайтиСтроки(Новый Структура("ЗубВКарте", Конструкция));
				Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
					Таблица.Удалить(СтрокаТаблицы);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
		// План лечения
		мсСтрокиПланаЛеченияНаУдаление = Новый Массив;
		ЭлементыПлана = СписокНазначений.ПолучитьЭлементы();
		Для Каждого СтрокаПлан Из ЭлементыПлана Цикл
			Если мсКонструкцииНаУдаление.Найти(СтрокаПлан.Назначение) <> Неопределено Тогда 
				мсСтрокиПланаЛеченияНаУдаление.Добавить(СтрокаПлан);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаПлан Из мсСтрокиПланаЛеченияНаУдаление Цикл 
			ЭлементыПлана.Удалить(СтрокаПлан);
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого СтрокаКонструкция Из мсКонструкцииНаУдаление Цикл 
		СтрокаКонструкция.Конструкция.ПолучитьОбъект().Удалить();
		стомУстановленныеКонструкции.Удалить(СтрокаКонструкция);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура стомУстановленныеКонструкцииОбозначениеКомментарийКонструкцииПриИзменении(Элемент)
	
	ТекДанные = Элементы.стомУстановленныеКонструкции.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	ТекДанные.ОбозначениеИзменено = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура стомУстановленныеКонструкцииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.стомУстановленныеКонструкцииОбозначениеКонструкции Или 
		Поле = Элементы.стомУстановленныеКонструкцииКомментарий 
	Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	СтрокаКонструкция = стомУстановленныеКонструкции.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Не СтрокаКонструкция.НеСоздана Тогда 
		ОткрытьЗначение(СтрокаКонструкция.Конструкция);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура стомДиагнозыДиагнозУстановленПриИзменении(Элемент)
	
	ТекДанные = Элементы.стомДиагнозы.ТекущиеДанные;
	
	// Для снижения нагрузки мы сначала получим значение искомого состояния по диагнозу
	// Он используется при проверке сегментов выделенного одного элемента
	// (выделен зуб, проверяем есть ли состояние диагноза у каналов)
    СостояниеСегментаПоДиагнозу = стомЗубнаяКартаМетоды.ВернутьСостояниеЗубнойКартыПоДиагнозу(стомДанныеЗубныхКарт.Адрес,ТекДанные.Диагноз);	
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	// Поиск установленных диагнозов зуба
	Для Каждого ВыделенныйЗуб Из стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты Цикл 
		
		УстановленныеДиагнозы = Объект.Диагнозы.НайтиСтроки(Новый Структура("ЗубВКарте, Диагноз", ВыделенныйЗуб.ЗубВКарте, ТекДанные.Диагноз));
		
		// Удаляем существующие диагнозы на зубе
		Если УстановленныеДиагнозы.Количество() > 0 Тогда 
			Для Каждого СтрокаДиагноз Из УстановленныеДиагнозы Цикл
				Если ВыделенныйЗуб.Сегменты.Количество() = 0 
					Или ВыделенныйЗуб.Сегменты.Найти(СтрокаДиагноз.СегментВЗубе) <> Неопределено
				Тогда
					Объект.Диагнозы.Удалить(СтрокаДиагноз);	
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
		
		Если ТекДанные.Установлено Тогда
			Если ВыделенныйЗуб.Сегменты.Количество() > 0 Тогда 
				Для Каждого СегментВЗубе Из ВыделенныйЗуб.Сегменты Цикл 
					НоваяСтрока = Объект.Диагнозы.Добавить();
					НоваяСтрока.ЗубВКарте = ВыделенныйЗуб.ЗубВКарте;
					НоваяСтрока.СегментВЗубе  = СегментВЗубе;
					НоваяСтрока.Диагноз = ТекДанные.Диагноз;
				КонецЦикла;
			Иначе
				// При выделении всего зуба, мы проверяем - есть ли связанная болезнь с сегментом (не выделенным)
				// Если есть - то мы присваиваем только этому сегменту
				// Если ничего нет, то оставляем как диагноз на сам зуб
				МассивСегментовЗуба = стомЗубнаяКартаМетоды.ПолучитьСегментыЗубаИмеющиеСостояниенаМоментПоиска(стомЗубнаяКартаМетоды.НайтиЗубВКарте(стомДанныеЗубныхКарт.Адрес, ВыделенныйЗуб.ЗубВКарте),СостояниеСегментаПоДиагнозу);
          		
				Если МассивСегментовЗуба.Количество() = 0 Тогда
					НоваяСтрока = Объект.Диагнозы.Добавить();
					НоваяСтрока.ЗубВКарте = ВыделенныйЗуб.ЗубВКарте;
					НоваяСтрока.Диагноз = ТекДанные.Диагноз;		
				Иначе
				    Для каждого СегментЗуба Из МассивСегментовЗуба Цикл
						НоваяСтрока = Объект.Диагнозы.Добавить();
						НоваяСтрока.ЗубВКарте = ВыделенныйЗуб.ЗубВКарте;
						НоваяСтрока.СегментВЗубе  = СегментЗуба;
						НоваяСтрока.Диагноз = ТекДанные.Диагноз;	
					КонецЦикла;
				КонецЕсли;																			
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура стомТаблицаПриАктивизацииЯчейки(Элемент)
	
	ПоляСегмента = Новый Массив;
	ПоляСегмента.Добавить(Элементы.ДиагнозыСегментВЗубе);
	ПоляСегмента.Добавить(Элементы.РаботыСегментВЗубе);
	ПоляСегмента.Добавить(Элементы.НазначенияСегментВЗубе);
	
	Если ПоляСегмента.Найти(Элемент.ТекущийЭлемент) = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Элемент.ТекущийЭлемент.СписокВыбора.Очистить();
	СписокВыбораСегментов = стомЗубнаяКартаМетоды.ПолучитьСписокВыбораСегментов(стомДанныеЗубныхКарт.Адрес, ТекДанные.ЗубВКарте);
	Для Каждого ЭлементСегмент Из СписокВыбораСегментов Цикл
		Элемент.ТекущийЭлемент.СписокВыбора.Добавить(ЭлементСегмент.Значение, ЭлементСегмент.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура стомТаблицаЗубВКартеПриИзменении(Элемент)
	
	ЭлементТаблица = ОбщегоНазначенияКлиентСерверПереопределяемый.НайтиТаблицуПоляФормы(Элемент);	
	ТекДанные = ЭлементТаблица.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ТекДанные.СегментВЗубе = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыЗубнойКартыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаИсторияЗубнойКарты Тогда 
		Если Не стомДанныеЗубныхКарт.ИсторияЗубов.Загружена Тогда
			Попытка
				ИнициализироватьИсториюЗубов();
			Исключение
				Сообщить(ОписаниеОшибки());
				стомДанныеЗубныхКарт.ИсторияЗубов.Загружена = Ложь;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаПараметрыЗубов Тогда 
		Если Не стомДанныеЗубныхКарт.ПараметрыЗубов.Загружены Тогда
			Попытка
				ЗагрузитьПараметрыЗубнойФормулы();
				ИнициализироватьПараметрыЗубнойФормулы();
			Исключение
				Сообщить(ОписаниеОшибки());
				стомДанныеЗубныхКарт.ПараметрыЗубов.Загружены = Ложь;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура стомЗубнаяКартаУпрощеннаяПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	
	Если Не стомДанныеЗубныхКарт.СтруктураЗагружена Тогда 
		Возврат;
	КонецЕсли;
	
	Если ДанныеСобытия = Неопределено Или ДанныеСобытия.Element = Неопределено Или
		НРег(ДанныеСобытия.Element.TagName) <> "a" Или Не ЗначениеЗаполнено(ДанныеСобытия.Element.id)	
	Тогда 
		Возврат;
	КонецЕсли;
	
	ДокументHTML = Элементы.стомЗубнаяКартаУпрощенная.Документ;
	СписокСсылок = РаботаСHTMLКлиентСервер.ПолучитьЭлементыПоИмени(ДокументHTML, "A", Истина);
	
	ОбластьКвадрантНомер = ДанныеСобытия.Element.id;
	ЭтоЗуб = (СтрДлина(ОбластьКвадрантНомер) = 36);
	
	ВыделениеНескольких = ДанныеСобытия.Event.ctrlKey;
	
	Если ЭтоЗуб Тогда 
		ВыделенныеЗубы = Новый Соответствие;
		ДанныеСобытия.Element.parentNode.className = ?(Не ЗначениеЗаполнено(ДанныеСобытия.Element.parentNode.className), "focus", "");
		Если ВыделениеНескольких Тогда 
			Для Каждого ЭлементСсылка Из СписокСсылок Цикл
				Если ЗначениеЗаполнено(ЭлементСсылка.id) И ЭлементСсылка.parentNode.className = "focus" Тогда
					ВыделенныеЗубы.Вставить(ЭлементСсылка.id);
				КонецЕсли;
			КонецЦикла;
		Иначе
			ЭлементСсылка = ДанныеСобытия.Element;
			Если ЗначениеЗаполнено(ЭлементСсылка.id) И ЭлементСсылка.parentNode.className = "focus" Тогда
				ВыделенныеЗубы.Вставить(ЭлементСсылка.id);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ВыделенныеЗубы = стомЗубнаяКартаМетоды.ПолучитьЗубыПоЧелюстиКвадрантуНомеру(стомДанныеЗубныхКарт.Адрес, ОбластьКвадрантНомер, Истина);
	КонецЕсли;
	
	ВыделенныеЗубыСегментыJSON = стомЗубнаяКартаМетоды.ВыделитьЗубыСегменты(стомДанныеЗубныхКарт.Адрес, ВыделенныеЗубы);
	Если стомДанныеЗубныхКарт.ПриложениеЗагружено Тогда
		стомКомпонентыКлиент.ОбновитьПриложениеЗубнойКарты(Элементы[стомДанныеЗубныхКарт.ИмяЭлемента], ВыделенныеЗубыСегментыJSON); 
	КонецЕсли;
	ПриВыделенииЗубовСегментов(ВыделенныеЗубы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьЗубыУпрощеннойЗубнойКарты()
	
	ДокументHTML = Элементы.стомЗубнаяКартаУпрощенная.Документ;
	Если ДокументHTML = Неопределено Тогда 
		ДокументHTML = РаботаСDOMКлиентСервер.СоздатьДокументDOM(стомЗубнаяКартаУпрощенная);
	КонецЕсли;
	СписокСсылок = РаботаСHTMLКлиентСервер.ПолучитьЭлементыПоИмени(ДокументHTML, "A", Истина);
	
	// Убираем выделение со всех зубов
	Для Каждого ЭлементСсылка Из СписокСсылок Цикл
		Если ЗначениеЗаполнено(ЭлементСсылка.id) Тогда
			ЭлементСсылка.parentNode.className = "";
		КонецЕсли;
	КонецЦикла;
	
	// Устанавливаем выделение выбранным
	Для Каждого ВыделенныйЗуб Из стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты Цикл
		ИдЗуба = ВыделенныйЗуб;
		Если ТипЗнч(ВыделенныйЗуб) = Тип("Структура") Тогда 
			Если ВыделенныйЗуб.Свойство("ЗубВКарте") Тогда 
				ИдЗуба = ВыделенныйЗуб.ЗубВКарте.УникальныйИдентификатор();
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ЭлементЗуб = ДокументHTML.getElementById(Строка(ИдЗуба));
		Если ЭлементЗуб <> Неопределено Тогда 
			ЭлементЗуб.parentNode.className = "focus";
		КонецЕсли;
	КонецЦикла;
	
	Если РаботаСHTMLКлиентСервер.ЭтоДокументDOM(ДокументHTML) Тогда 
		стомЗубнаяКартаУпрощенная = РаботаСDOMКлиентСервер.ПолучитьТекстHTMLДокументаDOM(ДокументHTML);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияВыделенныеЗубыСегментыНажатие(Элемент)
	
	Элементы.ГруппаВыделениеОбластейЗубов.Видимость = Не Элементы.ГруппаВыделениеОбластейЗубов.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ДиагнозыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		
		ТекДанные = Элемент.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		Если стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты.Количество() = 1 Тогда
			Для Каждого ВыделенныйЗуб Из стомДанныеЗубныхКарт.ВыделенныеЗубыСегменты Цикл 
				ТекДанные.ЗубВКарте = ВыделенныйЗуб.ЗубВКарте;
				Если ВыделенныйЗуб.Сегменты.Количество() = 1 Тогда
					ТекДанные.СегментВЗубе = ВыделенныйЗуб.Сегменты[0];
					Элемент.ТекущийЭлемент = Элементы.ДиагнозыДиагноз;
				КонецЕсли;
				Элемент.ТекущийЭлемент = Элементы.ДиагнозыДиагноз;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура стомЗубнаяКартаHTMLДокументСформирован(Элемент)
	
	стомКомпонентыКлиент.ОбработатьЗагрузкуПриложения(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура стомЗубнаяКартаHTMLИсторияДокументСформирован(Элемент)
	
	стомКомпонентыКлиент.ОбработатьЗагрузкуПриложения(ЭтаФорма, Элемент, стомДанныеЗубныхКарт.ИсторияЗубов);
	
КонецПроцедуры


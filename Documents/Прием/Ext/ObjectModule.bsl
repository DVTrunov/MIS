				ЭтотОбъект.Врач = Основание.Врач;
			КонецЕсли;
			РаботаСДокументамиСервер.ОбработкаЗаполнения(ЭтотОбъект, Основание.ДокументОснование);
		ИначеЕсли Основание.Свойство("Заявка") Тогда
			ЭтотОбъект.ДокументОснование = Основание.Заявка;
			Основание.Свойство("Филиал", Филиал); 
			///////////////////////////////////////////////////////////////////////////
			// ОМГ    
			Если Основание.Свойство("омг_ЭтоОперация") Тогда
				
				ЭтотОбъект.омг_ЭтоОперация = Основание.омг_ЭтоОперация
				
			КонецЕсли;   
			
			Если Основание.Свойство("Заявка") Тогда
				Если Основание.Заявка <> Неопределено Тогда	
					Если ЗначениеЗаполнено(Основание.Заявка.омг_СтраховаяПрограмма) Тогда
						ЭтотОбъект.омг_СтраховаяПрограмма = Основание.Заявка.омг_СтраховаяПрограмма;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			// ОМГ  
			///////////////////////////////////////////////////////////////////////////
			
		ИначеЕсли Основание.Свойство("ПервичныйПрием")
			И ТипЗнч(Основание.ПервичныйПрием) = Тип("ДокументСсылка.ПрохождениеМедосмотра") 
			Тогда 
			РаботаСДокументамиСервер.ОбработкаЗаполнения(ЭтотОбъект, Основание.ПервичныйПрием);
			Основание.Свойство("Специализация", Специализация);
		Иначе
			РаботаСДокументамиСервер.ОбработкаЗаполнения(ЭтотОбъект, Основание);
		КонецЕсли;
	Иначе
		РаботаСДокументамиСервер.ОбработкаЗаполнения(ЭтотОбъект, Основание);
	КонецЕсли;
	
	#Область Стоматология
	Если ЗначениеЗаполнено(Клиент) И Не ЗначениеЗаполнено(ЗубнаяКарта) Тогда 
		КартаВариант = стомСтоматология.ПолучитьВидВариантЗубнойКарты(Клиент);
		ЗубнаяКарта = КартаВариант.ЗубнаяКарта;
		ВариантЗубнойКарты = КартаВариант.ВариантЗубнойКарты;
	КонецЕсли;
	#КонецОбласти
	
	///////////////////////////////////////////////////////////
	// ОМГ 
	Заявка = Неопределено;
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.Заявка") Тогда
		Заявка = Основание; 
	ИначеЕсли ТипЗнч(Основание) = Тип("Структура") Тогда
		Если Основание.Свойство("ДокументОснование") Тогда	
			Если ТипЗнч(Основание.ДокументОснование) = Тип("ДокументСсылка.Заявка") Тогда	
				 Заявка = Основание.ДокументОснование 
			КонецЕсли;	 
		КонецЕсли;
	КонецЕсли;	
	// Добавлено Макеев (
	омг_МедицинскаяДеятельность.ЗаполнитьМедПерсонал(ЭтотОбъект,Заявка);
	МедицинскаяКарта = "";
	// )
	ПервичныйПриемНайден = омг_МедицинскаяДеятельность.ПроверитьПервичныйПрием(ЭтотОбъект);
	Если не ПервичныйПриемНайден = Неопределено Тогда 
		ЭтотОбъект.ЭтоПервичный = Ложь; 
		Если не ЗначениеЗаполнено(ЭтотОбъект.ПервичныйПрием) Тогда 
		ЭтотОбъект.ПервичныйПрием = ПервичныйПриемНайден	
		КонецЕсли;	
	КонецЕсли;
	// ОМГ
	///////////////////////////////////////////////////////////
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	мУчетнаяПолитика = УправлениеНастройками.ПолучитьУчетнуюПолитику();
	Если ПодписанЭП Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не СтоматологическийПрием Тогда
		Инд = ПроверяемыеРеквизиты.Найти("ЗубнаяКарта"); 
		Если Инд <> 0 Тогда
			ПроверяемыеРеквизиты.Удалить(Инд);
		КонецЕсли;
		
		Инд = ПроверяемыеРеквизиты.Найти("ВариантЗубнойКарты"); 
		Если Инд <> 0 Тогда
			ПроверяемыеРеквизиты.Удалить(Инд);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Если ЭтотОбъект.ЭтоПервичный
		И ЭтотОбъект.ПервичныйПрием = ОбъектКопирования.Ссылка
	Тогда
		ЭтотОбъект.ЭтоПервичный = Ложь;
	КонецЕсли;
	
	ПодписанЭП = Ложь;
	
	// РЭМД: очистим ключевые данные интеграции с сервисом ЕГИСЗ.
	РолиИПодписиЭМД.Очистить();
	ЭМД.Очистить();	
	Для Каждого СтрокаШаблона Из ШаблоныПриема Цикл
		СтрокаШаблона.УИД = "";		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

Функция омг_ПроверкаНаДублиСотрудников()

	ВозЗначение = "";
	МассивСотрудников = омг_МедПерсонал.ВыгрузитьКолонку("Сотрудник");	
	МассивСотрудников.Добавить(Врач);
	
	УникальныеЗначения = Новый Массив;
	
	Для Каждого Значение Из МассивСотрудников Цикл
		Если УникальныеЗначения.Найти(Значение) = неопределено Тогда
			УникальныеЗначения.Добавить(Значение)
		иначе
			ВозЗначение = ""+ВозЗначение + Значение + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВозЗначение;
	
КонецФункции	


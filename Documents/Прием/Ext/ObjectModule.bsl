		|	омг_ОказаниеУслугДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	омг_НоменклатураОказанийДляПриемовОстатки.Номенклатура КАК Номенклатура,
		|	СУММА(омг_НоменклатураОказанийДляПриемовОстатки.КоличествоОстаток) КАК КоличествоОстаток,
		|	омг_НоменклатураОказанийДляПриемовОстатки.омг_ОказаниеУслуг КАК омг_ОказаниеУслуг,
		|	омг_НоменклатураОказанийДляПриемовОстатки.омг_ОказаниеУслуг.Дата КАК омг_ОказаниеУслугДата,
		|	омг_НоменклатураОказанийДляПриемовОстатки.омг_ОказаниеУслуг.ДокументОснование КАК омг_ОказаниеУслугДокументОснование,
		|	омг_НоменклатураОказанийДляПриемовОстатки.Заявка КАК Заявка
		|ИЗ
		|	РегистрНакопления.омг_НоменклатураОказанийДляПриемов.Остатки(
		|			,
		|			Заявка В (&Заявки)
		|				И омг_ОказаниеУслуг.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ВозвратКлиенту)) КАК омг_НоменклатураОказанийДляПриемовОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	омг_НоменклатураОказанийДляПриемовОстатки.Номенклатура,
		|	омг_НоменклатураОказанийДляПриемовОстатки.омг_ОказаниеУслуг,
		|	омг_НоменклатураОказанийДляПриемовОстатки.омг_ОказаниеУслуг.Дата,
		|	омг_НоменклатураОказанийДляПриемовОстатки.омг_ОказаниеУслуг.ДокументОснование,
		|	омг_НоменклатураОказанийДляПриемовОстатки.Заявка
		|
		|УПОРЯДОЧИТЬ ПО
		|	омг_ОказаниеУслугДата";
		
		ДокументыОснования = Новый Массив;
		ДокументыОснования.Добавить(ДокументОснование);
		Для каждого стрДокументыОснования из омг_Заявки Цикл
			ДокументыОснования.Добавить(стрДокументыОснования.Заявка);	
		КонецЦикла;	
		
		Запрос.УстановитьПараметр("ПериодПроведения", Дата);
		Запрос.УстановитьПараметр("Прейскурант", Прейскурант);		
		Запрос.УстановитьПараметр("Филиал", Филиал);	
		Запрос.УстановитьПараметр("Заявки", ДокументыОснования);
		Запрос.УстановитьПараметр("МассивНоменклатур", МассивНоменклатур);
		
		РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
		
		ВыборкаЦен = РезультатЗапросаПакет[3].Выбрать();
		ВыборкаЦенСоСкидкой = РезультатЗапросаПакет[4].Выбрать();   
		ВыборкаОказаний = РезультатЗапросаПакет[5].Выбрать();
		ВыборкаВозвраты = РезультатЗапросаПакет[6].Выбрать();
		ВыборкаОстатки = РезультатЗапросаПакет[7].Выгрузить();
		ВыборкаОстаткиВозвраты = РезультатЗапросаПакет[8].Выгрузить(); 
		Движения.ВыработкаСотрудников.Записывать = Истина; 
		омг_МедПерсоналТаб = омг_МедПерсонал.Выгрузить(,"Сотрудник,Роль"); 
		омг_МедПерсоналТаб.Свернуть("Сотрудник,Роль",); 
		
		Если омг_МедицинскаяДеятельность.омг_ВыработкаВПриеме(Дата) Тогда
			
			Стромг_МедПерсоналТаб = омг_МедПерсоналТаб.Добавить(); 
			Стромг_МедПерсоналТаб.Сотрудник = Врач;
			
		КонецЕсли;
		
		УчитыватьВыработуВЗП = омг_РасчетЗаработнойПлатыСервер.омг_УчетВыработки(Дата);
		
        РаботыТаблица = Работы.Выгрузить(,"Номенклатура,КлючСтроки,ХарактеристикаНоменклатуры,Количество,Продолжительность,омг_Набор");
		//РаботыТаблица.Свернуть("Номенклатура,КлючСтроки,ХарактеристикаНоменклатуры,Продолжительность","Количество");
		
		
		Если омг_КонтрольУслугПоЗаявкам Тогда
			
			ТабДляВыработки = РаботыТаблица.СкопироватьКолонки();
			ТабДляВыработки.Колонки.Добавить("омг_ОказаниеУслуг",Новый ОписаниеТипов("ДокументСсылка.ОказаниеУслуг"));
			ТабДляВыработки.Колонки.Добавить("Заявка",Новый ОписаниеТипов("ДокументСсылка.Заявка"));
			ТабДляВыработки.Колонки.Добавить("омг_ОказаниеУслугДата",Новый ОписаниеТипов("Дата"));
			
			Для каждого строкаРаботы из РаботыТаблица Цикл
				
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура", строкаРаботы.Номенклатура);
				
				НайденныеСтроки = ВыборкаОстатки.НайтиСтроки(Отбор);
				ОсталосьСписать = строкаРаботы.Количество;
				                                           
				Для Каждого Строка Из НайденныеСтроки Цикл
					
					Отбор = Новый Структура;
					Отбор.Вставить("омг_ОказаниеУслугДокументОснование", Строка.омг_ОказаниеУслуг);
				
					НайденныеСтрокиВозврата = ВыборкаОстаткиВозвраты.НайтиСтроки(Отбор);
					
					ОстатокСВозвратами = Строка.КоличествоОстаток;
					
					Если Строка.КоличествоОстаток >= ОсталосьСписать Тогда	
						Строка.КоличествоОстаток = Строка.КоличествоОстаток - ОсталосьСписать;
						Если не ОсталосьСписать = 0 Тогда 
						СтрокаТабДляВыработки = ТабДляВыработки.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаТабДляВыработки,строкаРаботы); 
						ЗаполнитьЗначенияСвойств(СтрокаТабДляВыработки,Строка);
						СтрокаТабДляВыработки.Количество = ОсталосьСписать;
						СтрокаТабДляВыработки.Заявка = Строка.Заявка;
						ОсталосьСписать = 0; 
						КонецЕсли;
					иначе
						СтрокаТабДляВыработки = ТабДляВыработки.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаТабДляВыработки,строкаРаботы); 
						ЗаполнитьЗначенияСвойств(СтрокаТабДляВыработки,Строка); 
						СтрокаТабДляВыработки.Заявка = Строка.Заявка;
						СтрокаТабДляВыработки.Количество = Строка.КоличествоОстаток;
						ОсталосьСписать = ОсталосьСписать - Строка.КоличествоОстаток;
						Строка.КоличествоОстаток = 0;
						
					КонецЕсли;
					
					
					Для Каждого СтрокаВозврата Из НайденныеСтрокиВозврата Цикл
						
					ОстатокСВозвратами = ОстатокСВозвратами + СтрокаВозврата.КоличествоОстаток; 	
						
					Если ОстатокСВозвратами < СтрокаТабДляВыработки.Количество Тогда
						Если не (0 - (СтрокаТабДляВыработки.Количество - ОстатокСВозвратами)) = 0 Тогда

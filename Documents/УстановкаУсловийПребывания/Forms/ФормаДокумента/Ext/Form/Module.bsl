&НаКлиенте
Процедура ЗаполнитьТарифыПоВидуПалатыНаКлиенте(Объект)
	
	ОбъектКопия = Объект;
	ЗаполнитьТарифыПоВидуПалаты(ОбъектКопия);
	КопироватьДанныеФормы(ОбъектКопия, Объект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьТарифыПоВидуПалаты(Объект)
	
	Документы.УстановкаУсловийПребывания.ЗаполнитьТарифыПоВидуПалаты(Объект); // Неприменимо ОбщегоНазначенияСервер.ПроцедураМенеджера() - Знач.
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьПолисаПрейскуранта()
	Элементы.Прейкурант.Доступность = Объект.Полис.Пустая();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоПредыдущемуНаСервере()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	УстановкаУсловийПребывания.Палата КАК Палата,
	                      |	УстановкаУсловийПребывания.Полис КАК Полис,
	                      |	УстановкаУсловийПребывания.КойкоМесто КАК КойкоМесто,
	                      |	УстановкаУсловийПребывания.ДатаНачала КАК ДатаНачала,
	                      |	УстановкаУсловийПребывания.ДатаОкончания КАК ДатаОкончания,
	                      |	УстановкаУсловийПребывания.Номенклатура.(
	                      |		Ссылка КАК Ссылка,
	                      |		НомерСтроки КАК НомерСтроки,
	                      |		Номенклатура КАК Номенклатура
	                      |	) КАК Номенклатура,
	                      |	УстановкаУсловийПребывания.Подразделение КАК Подразделение
	                      |ИЗ
	                      |	Документ.УстановкаУсловийПребывания КАК УстановкаУсловийПребывания
	                      |ГДЕ
	                      |	УстановкаУсловийПребывания.Ссылка <> &Ссылка
	                      |	И УстановкаУсловийПребывания.Проведен
	                      |	И УстановкаУсловийПребывания.ВидОперации <> &ВидОперации
	                      |	И УстановкаУсловийПребывания.Филиал = &Филиал
	                      |	И УстановкаУсловийПребывания.Клиент = &Клиент
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	УстановкаУсловийПребывания.МоментВремени УБЫВ");
						  
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыДвиженияВСтационаре.Выписка);
	Запрос.УстановитьПараметр("Филиал",Объект.Филиал);
	Запрос.УстановитьПараметр("Клиент",Объект.Клиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		Объект.Подразделение	= Выборка.Подразделение;
		Объект.Палата			= Выборка.Палата;
		Объект.КойкоМесто	    = Выборка.КойкоМесто;
		Объект.ДатаНачала 		=  Выборка.ДатаНачала;
		Объект.ДатаОкончания	=  Выборка.ДатаОкончания;
		Объект.Полис			=  Выборка.Полис;
		
		ВыборкаДетали = Выборка.Номенклатура.Выбрать();
		
		Если ВыборкаДетали.Следующий() Тогда 
			Объект.Номенклатура.Очистить();
		КонецЕсли;
		ВыборкаДетали.Сбросить();
		
		Пока ВыборкаДетали.Следующий() Цикл 
			ЗаполнитьЗначенияСвойств(Объект.Номенклатура.Добавить(), ВыборкаДетали);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьДатуНачалаДействия(ТекущаяДатаНачала, ДатаДокумента, ДокументОбращения)
	
	Если ЗначениеЗаполнено(ТекущаяДатаНачала) Тогда
		Возврат ТекущаяДатаНачала;
	ИначеЕсли ЗначениеЗаполнено(ДокументОбращения) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбращения, "ДатаВремяПоступления");
	Иначе
		Возврат ДатаДокумента;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущийДокументОбращенияКлиента(Клиент)
	
	МедКарта = Стационар.ПолучитьМедКартуСтационара(Клиент);
	Возврат Стационар.ОбращениеПоМедкарте(Медкарта);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВладельцевКойки(Койка)
	
	СтруктураВозврата = Новый Структура;
	
	СтруктураВозврата.Вставить("Владелец", Койка.Владелец);
	СтруктураВозврата.Вставить("Подразделение", Койка.Владелец.Подразделение);
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПодразделениеКлиента(Клиент, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлиентыСтационараСрезПоследних.Клиент КАК Клиент,
	               |	КлиентыСтационараСрезПоследних.Подразделение КАК Подразделение
	               |ИЗ
	               |	РегистрСведений.КлиентыСтационара.СрезПоследних(&Период, Клиент = &Клиент) КАК КлиентыСтационараСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Период", Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Подразделение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура НастроитьПодразделениеПоВидуДокумента(Перезаписывать = Ложь)

	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.Поступление") Тогда
		Если Перезаписывать Тогда
			Если ЗначениеЗаполнено(Объект.ДокументОбращения) Тогда
				Объект.Подразделение = Объект.ДокументОбращения.Подразделение;
			ИначеЕсли ЗначениеЗаполнено(Объект.Палата) Тогда
				Объект.Подразделение = Объект.Палата.Подразделение;
			КонецЕсли;
		КонецЕсли;
		Элементы.Подразделение.Доступность = Не ЗначениеЗаполнено(Объект.ДокументОбращения) И Не ЗначениеЗаполнено(Объект.Палата);
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.ИзменениеУсловий") Тогда
		Если ЗначениеЗаполнено(Объект.Клиент) Тогда
			Объект.Подразделение = ПолучитьПодразделениеКлиента(Объект.Клиент, Объект.ДатаНачала);	
		КонецЕсли;
		Элементы.Подразделение.Доступность = Ложь;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.ПереводМеждуПодразделениями") Тогда
		Элементы.Подразделение.Доступность = Истина;	
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаВремяПриИзменении()
	
	Объект.ДатаНачала = ДатаС + (ВремяС - Дата(1,1,1));
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.ИзменениеУсловий") Тогда
		Объект.Подразделение = ПолучитьПодразделениеКлиента(Объект.Клиент, Объект.ДатаНачала);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
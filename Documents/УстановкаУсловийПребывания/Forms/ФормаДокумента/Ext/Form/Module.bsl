#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормамиСервер.ФормаДокументаПриОткрытииСервер(ЭтаФорма, Ложь);
	УстановитьПодменюВыбораОпераций();
	
	НастроитьВидимостьЭлементов();
	НастроитьПодразделениеПоВидуДокумента();
	
	Если Объект.Ссылка.Пустая() Тогда 
		КалендарьПланирования.ОкруглитьВремяДоПериодаПланирования(Объект.ДатаНачала);
	КонецЕсли;
	
	Объект.ДатаНачала = ОпределитьДатуНачалаДействия(Объект.ДатаНачала, Объект.Дата, Объект.ДокументОбращения);
	
	ДатаС = Объект.ДатаНачала;
	ВремяС = Объект.ДатаНачала;
	ДатаПо = Объект.ДатаОкончания;
	ВремяПо = Объект.ДатаОкончания;
	
	ВремяОкончанияПоУмолчанию = УправлениеНастройкамиМедицинскогоУчета.ПолучитьПараметрУчетнойПолитики("ВремяВыпискиДляБронированияПоУмолчанию");
	
	Элементы.КойкоМесто.СписокВыбора.ЗагрузитьЗначения(Стационар.КойкиПалаты(Объект.Палата));
	
	Элементы.ФормаЗаполнитьПоПредыдущему.Доступность = Объект.ВидОперации <> Перечисления.ВидыДвиженияВСтационаре.Выписка;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьПолисаПрейскуранта();
	ПечатьДокументовКлиент.УстановитьЗаголовокПечатнойФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.Выписка") Тогда
		Объект.Подразделение 	= ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка");
		Объект.Палата 			= ПредопределенноеЗначение("Справочник.Палаты.ПустаяСсылка");
		Объект.КойкоМесто	 	= ПредопределенноеЗначение("Справочник.КойкоМеста.ПустаяСсылка");
		Объект.ДатаОкончания	= Дата(1,1,1);
		Объект.Полис			= ПредопределенноеЗначение("Справочник.СтраховыеПолисы.ПустаяСсылка");
	КонецЕсли;
	
	Объект.ДатаНачала = ДатаС + (ВремяС - Дата(1,1,1));
	Объект.ДатаОкончания = ДатаПо + (ВремяПо - Дата(1,1,1));
	
	Для Каждого эл Из Объект.Номенклатура Цикл 
		
		СтруктураПоиска = Новый Структура("Номенклатура");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, эл);
		
		Если Объект.Номенклатура.НайтиСтроки(СтруктураПоиска).Количество() > 1 Тогда
			Предупреждение("В документе есть дублирующаяся номенклатура!");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) И  Объект.ДатаНачала >= Объект.ДатаОкончания Тогда 
		Предупреждение("Дата начала периода пребывания не может быть больше или равна дате окончания периода!");
		Отказ = Истина;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	РаботаСФормамиСервер.ВывестиЗаголовокФормыДокумента(ТекущийОбъект,,ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПараметрыОповещения = Новый Структура("УстановкаУсловийПребывания, Обращение", Объект.Ссылка, Объект.ДокументОбращения);
	Оповестить("УстановкаУсловийПребывания", ПараметрыОповещения);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПоискКлиентов(Команда)
	
	ОткрытьФорму("ОбщаяФорма.ФормаПоискаКлиентаУпр",,Элементы.Клиент);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ДИНАМИЧЕСКИ СОЗДАВАЕМЫХ КОМАНД.

&НаКлиенте
Процедура Подключаемый_КнопкаФилиалПриНажатии(Команда)
	РаботаСДиалогамиКлиент.ДиалогКнопкаФилиалПриНажатии(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВывестиДвиженияДокумента(Команда)
	РаботаСДиалогамиКлиент.ВывестиДвиженияДокумента(Объект.Ссылка, Команда);
КонецПроцедуры

///////////////////////////////////////////////
// ЗАПОЛНЕНИЕ СПИСКА ОПЕРАЦИЙ

&НаСервере
Процедура УстановитьПодменюВыбораОпераций()
	
	МассивТипов = Перечисления.ВидыДвиженияВСтационаре.ПустаяСсылка().Метаданные().ЗначенияПеречисления;
	РаботаСДиалогамиСервер.УстановитьПодменюОперации(МассивТипов, ЭтаФорма);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ДЕЙСТВИЯ КОМАНДНЫХ ПАНЕЛЕЙ ФОРМЫ

&НаКлиенте
Процедура ДействияФормыДействиеУстановитьОперацию(Команда)
	Если Команда <> Неопределено ТОгда
		ДействияФормыДействиеУстановитьОперациюСервер(Команда.Имя);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ДействияФормыДействиеУстановитьОперациюСервер(КомандаИмя)
	
	Если ЗначениеЗаполнено(КомандаИмя) Тогда 
		Объект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре[КомандаИмя];
	КонецЕсли;
	
	РаботаСФормамиСервер.ВывестиЗаголовокФормыДокумента(Объект, Истина, ЭтаФорма);
	
	НастроитьВидимостьЭлементов();
	НастроитьПодразделениеПоВидуДокумента(Истина);
	
КонецПроцедуры

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоВидуПалаты(Команда)
	
	Ответ = КодВозвратаДиалога.ОК;
	
	Если Объект.Номенклатура.Количество() > 0 Тогда 
		Ответ = Вопрос("Табличная часть будет очищена. Продолжить? ",РежимДиалогаВопрос.ОКОтмена, ,КодВозвратаДиалога.Отмена,"Заполнение услуг");
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		ЗаполнитьТарифыПоВидуПалатыНаКлиенте(Объект);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПредыдущему(Команда)
	
	Ответ = КодВозвратаДиалога.ОК;
	
	Если Не Объект.Ссылка.Пустая() Тогда 
		Ответ = Вопрос("Данные документа будут изменены! Продолжить? ",РежимДиалогаВопрос.ОКОтмена, ,КодВозвратаДиалога.Отмена,"Заполнение по предыдущему");
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		ЗаполнитьПоПредыдущемуНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПалатаПолучательПриИзменении(Элемент)
	
	Элементы.КойкоМесто.СписокВыбора.ЗагрузитьЗначения(Стационар.КойкиПалаты(Объект.Палата));
	
	Элементы.Подразделение.Доступность = Не ЗначениеЗаполнено(Объект.ДокументОбращения) И Не ЗначениеЗаполнено(Объект.Палата);
	
	Если Не Объект.Палата.Пустая()
		И Объект.Ссылка.Пустая()
	Тогда
		ЗаполнитьТарифыПоВидуПалатыНаКлиенте(Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КойкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник.КойкоМеста.ФормаВыбора",Новый Структура("Дата, Подразделение, Регистратор, БлокироватьВыборЗанятых, Клиент", 
					Объект.ДатаНачала, Объект.Подразделение, Объект.Ссылка, Истина, Объект.Клиент),Элементы.КойкоМесто,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура КойкаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ПодключитьОбработчикОжидания("КойкаОбработкаВыбораОбновитьПалату", 0.01, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КойкаОбработкаВыбораОбновитьПалату()
	
	Если ЗначениеЗаполнено(Объект.КойкоМесто) Тогда
		ВладельцыКойки = ПолучитьВладельцевКойки(Объект.КойкоМесто);
		
		ПалатаИзменилась = Объект.Палата <> ВладельцыКойки.Владелец;
		Объект.Палата = ВладельцыКойки.Владелец;
		Объект.Подразделение = ВладельцыКойки.Подразделение;
		
		Если ПалатаИзменилась Тогда
			ПалатаПолучательПриИзменении(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолисПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.Полис) Тогда
		Объект.Прейскурант = Неопределено;
	КонецЕсли;
	УстановитьДоступностьПолисаПрейскуранта();
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	
	Если Объект.ДокументОбращения.Пустая() Тогда
		Объект.ДокументОбращения = ПолучитьТекущийДокументОбращенияКлиента(Объект.Клиент);
		ДокументОснованиеПриИзменении(Неопределено);
		Если Не Объект.ДокументОбращения.Пустая()
			И Не ЗначениеЗаполнено(Объект.ДатаНачала)
		Тогда
			Объект.ДатаНачала = ОпределитьДатуНачалаДействия(Объект.ДатаНачала, Объект.Дата, Объект.ДокументОбращения)
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.ИзменениеУсловий") Тогда
		Объект.Подразделение = ПолучитьПодразделениеКлиента(Объект.Клиент, Объект.ДатаНачала);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПоПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(ВремяПо) Тогда
		ВремяПо = ВремяОкончанияПоУмолчанию;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВремяПоПриИзменении(Элемент)
	КалендарьПланирования.ОкруглитьВремяДоПериодаПланирования(ВремяПо);
КонецПроцедуры

&НаКлиенте
Процедура ВремяРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Имя элемента и имя реквизита должны совпадать.
	НовоеВремя = ЭтотОбъект[Элемент.Имя] + Направление * 3600;
	ЭтотОбъект[Элемент.Имя] = ?(Направление < 0 Или Час(НовоеВремя) > Час(ЭтотОбъект[Элемент.Имя]), НовоеВремя, ЭтотОбъект[Элемент.Имя]);
	
	Если Элемент.Имя = "ВремяС" Тогда
		ДатаВремяПриИзменении();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВремяСПриИзменении(Элемент)
	
	КалендарьПланирования.ОкруглитьВремяДоПериодаПланирования(ВремяС);
	ДатаВремяПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСПриИзменении(Элемент)
	
	ДатаВремяПриИзменении()
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Подразделение)
		И ЗначениеЗаполнено(Объект.ДокументОбращения) 
	Тогда
		Объект.Подразделение = ДопСерверныеФункции.ПолучитьРеквизит(Объект.ДокументОбращения, "Подразделение");		
	КонецЕсли;
	Элементы.Подразделение.Доступность = Не ЗначениеЗаполнено(Объект.Подразделение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	Объект.КойкоМесто = Неопределено;
	Объект.Палата = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&НаСервере
Процедура НастроитьВидимостьЭлементов()
	
	Если Объект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.Выписка Тогда 
		Элементы.ГруппаПраво.Видимость	= Ложь;
		Элементы.ГруппаПалаты.Видимость = Ложь;
		Элементы.Номенклатура.Видимость = Ложь;
		Элементы.ВремяПо.Видимость = Ложь;
		Элементы.ДатаПо.Видимость = Ложь;
		
		Объект.Палата = Справочники.Палаты.ПустаяСсылка();
		Объект.КойкоМесто = Справочники.КойкоМеста.ПустаяСсылка();
		Объект.Подразделение = Справочники.Подразделения.ПустаяСсылка();
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.Поступление 
		Или Объект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.ИзменениеУсловий 
		Или Объект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.ПереводМеждуПодразделениями
	Тогда 
		Элементы.ГруппаПраво.Видимость	= Истина;
		Элементы.Полис.Видимость		= Истина;
		Элементы.ГруппаПалаты.Видимость = Истина;
		Элементы.Номенклатура.Видимость = Истина;
		Элементы.ВремяПо.Видимость = Истина;
		Элементы.ДатаПо.Видимость = Истина;
	КонецЕсли;
	
	Элементы.ДокументОснование.Видимость = Объект.ВидОперации = Перечисления.ВидыДвиженияВСтационаре.Поступление;
	Элементы.ФормаЗаполнитьПоПредыдущему.Доступность = Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыДвиженияВСтационаре.Выписка");

КонецПроцедуры


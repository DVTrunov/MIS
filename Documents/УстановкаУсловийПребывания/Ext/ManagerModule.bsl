#Область ПрограммныйИнтерфейс

// Заполняет в документе тарифы по виду палаты
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъектУстановкаУсловийПребывания - заполняемый документ.
//
Процедура ЗаполнитьТарифыПоВидуПалаты(ДокументОбъект) Экспорт 
	
	ВидПалаты = ДокументОбъект.Палата.ВидПалаты;
	
	Если ЗначениеЗаполнено(ВидПалаты)
		И ЗначениеЗаполнено(ВидПалаты.Прейскурант)
	Тогда
		ДокументОбъект.Прейскурант = ВидПалаты.Прейскурант;
	Иначе
		ДокументОбъект.Прейскурант = УправлениеНастройками.ПолучитьПрейскурантФилиала(РаботаСДокументамиСервер.ФилиалДокумента(ДокументОбъект));
	КонецЕсли;
	
	СписокОсновныхУслуг = ВидПалаты.ОсновныеУслуги.Выгрузить();
	
	ДокументОбъект.Номенклатура.Очистить();
	
	Для Каждого СтрокаУслуг Из СписокОсновныхУслуг Цикл
		ЗаполнитьЗначенияСвойств(ДокументОбъект.Номенклатура.Добавить(),СтрокаУслуг);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
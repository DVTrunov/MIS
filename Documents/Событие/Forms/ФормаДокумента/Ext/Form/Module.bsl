&НаСервере
Функция ОбработкаВводаНоменклатуры(Номенклатура, Количество = 1, ПозицияВводаСтроки = Неопределено, РучноеРедактирование = Ложь)
	
	// Изменения Макеев 07-12-2025 (
	Если Номенклатура.ЭтоГруппа Тогда
		Возврат "";
	КонецЕсли;
	
	Если Номенклатура.Пустая() Или Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга Тогда
		ОбработкаВнесенияРаботы(Номенклатура, Количество, ПозицияВводаСтроки, Объект, РучноеРедактирование);
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор Тогда
		СоставНабора = ОбщегоНазначенияСервер.ПолучитьСоставНабора(Номенклатура);
		МассивНаборов = Новый Массив;
		МассивКомплектующих = Новый Массив; 
		МассивНаборов.Добавить(Номенклатура);
		омг_ПолучитьВсеНаборы(СоставНабора,МассивНаборов,МассивКомплектующих);
		Для Каждого СтрокаСостава Из МассивКомплектующих Цикл
			// Изменено Макеев ( 
			Если не СтрокаСостава.омг_Набор = Номенклатура Тогда
			омг_НаборУровень = СтрокаСостава.омг_Набор
			иначе
			омг_НаборУровень = Неопределено
			КонецЕсли;
			ОбработкаВнесенияРаботы(СтрокаСостава.Комплектующая, СтрокаСостава.Количество*Количество, ПозицияВводаСтроки, Объект,, Номенклатура,омг_НаборУровень, СтрокаСостава.ЭтоНаборЛИС);
			// )
			Если ПозицияВводаСтроки <> Неопределено Тогда
				ПозицияВводаСтроки = ПозицияВводаСтроки + 1;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Возврат Строка("Номенклатура "+Строка(Номенклатура)+" не является работой. Допускается только подбор работ.");
	КонецЕсли; 
	
	Возврат "";
	
КонецФункции       

 &НаСервере
Процедура омг_ПолучитьВсеНаборы(СоставИсходногоНабора,МассивНаборов,МассивКомплектующих)
		
	Для каждого строка из СоставИсходногоНабора Цикл
		Если строка.Комплектующая.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор Тогда
			МассивНаборов.добавить(строка.Комплектующая);
			СоставНабора = ОбщегоНазначенияСервер.ПолучитьСоставНабора(строка.Комплектующая);
			омг_ПолучитьВсеНаборы(СоставНабора,МассивНаборов,МассивКомплектующих);
		иначе
			МассивКомплектующих.добавить(строка)
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	      

&НаСервере
Процедура ОбработкаВнесенияРаботы(Номенклатура, Количество, ПозицияВводаСтроки, ДокументОбъект, 
	РучноеРедактирование = Ложь, Набор = Неопределено,омг_НаборУровень= Неопределено, ЭтоНаборЛИС = Ложь)

	Если Количество = 0 Тогда
		Количество = 1;
	КонецЕсли;
	
	Если ПозицияВводаСтроки <> Неопределено
		И ПозицияВводаСтроки < (ДокументОбъект.Работы.Количество() - 1)
		Тогда
		СтрокаРаботы = ДокументОбъект.Работы[ПозицияВводаСтроки];
	Иначе
		СтруктураПоиска = Новый Структура("Номенклатура", Номенклатура);
		Если Набор = Неопределено Тогда 
			СтруктураПоиска.Вставить("омг_Набор", Справочники.Номенклатура.ПустаяСсылка());
		Иначе
			СтруктураПоиска.Вставить("омг_Набор", Набор);
		КонецЕсли;
		СуществующиеСтрокиРабот = ДокументОбъект.Работы.НайтиСтроки(СтруктураПоиска);
		Если СуществующиеСтрокиРабот.Количество() > 0 Тогда
		Иначе
			СтрокаРаботы = ДокументОбъект.Работы.Добавить(); 
			СтрокаРаботы.Номенклатура = Номенклатура;
			
			ЭтаФорма.Элементы.Работы.ТекущаяСтрока = СтрокаРаботы.ПолучитьИдентификатор();
			
			СтрокаРаботы.омг_Набор = Набор;
			Если не омг_НаборУровень = Неопределено Тогда
				СтрокаРаботы.омг_НаборУровень = омг_НаборУровень;
			КонецЕсли;
			Если ЭтоНаборЛИС Тогда
				СтрокаРаботы.омг_НаборЛИС = омг_НаборУровень;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры


&НаСервере
Процедура омг_ОбновитьЗаявки() 
	
	УстановитьПривилегированныйРежим(Истина); 
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ДокументОснование) и ТипЗнч(ЭтотОбъект.ДокументОснование) = Тип("ДокументСсылка.Заявка") Тогда
		
		Если не ЭтотОбъект.ДокументОснование.омг_ОказаниеУслуг = ЭтотОбъект.Ссылка	Тогда
			ЗаявкаОбъект = ЭтотОбъект.ДокументОснование.ПолучитьОбъект();
			ЗаявкаОбъект.омг_ОказаниеУслуг = ЭтотОбъект.Ссылка; 
			ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
			ЗаявкаОбъект.Записать();
		КонецЕсли;
		
	КонецЕсли;	  
	
	 
	ДокОснованиеВТаблице = Ложь;
	Для каждого строка из Заявки Цикл
		
		Если не строка.Заявка.омг_ОказаниеУслуг = ЭтотОбъект.Ссылка	Тогда
			ЗаявкаОбъект = строка.Заявка.ПолучитьОбъект();
			ЗаявкаОбъект.омг_ОказаниеУслуг = ЭтотОбъект.Ссылка;
			ЗаявкаОбъект.Записать();
		КонецЕсли;
		Если строка.Заявка = ЭтотОбъект.ДокументОснование	Тогда
		ДокОснованиеВТаблице = Истина;	
		КонецЕсли;	
	КонецЦикла;
	
	Если ДокОснованиеВТаблице = Ложь и ЗначениеЗаполнено(ЭтотОбъект.ДокументОснование) и ТипЗнч(ЭтотОбъект.ДокументОснование) = Тип("ДокументСсылка.Заявка")  Тогда
		 СтрЗавка = Заявки.Добавить(); 
		 СтрЗавка.Заявка = ЭтотОбъект.ДокументОснование;
	КонецЕсли;	 
	
	УстановитьПривилегированныйРежим(Ложь); 
	
КонецПроцедуры		

&НаСервере
Функция омг_ПроверитьПустыеЦены()

	ВозЗначение = Ложь;
	СтрПоиска = Новый Структура("Цена",0);
	НайдСтроки = Работы.НайтиСтроки(СтрПоиска);
	Если НайдСтроки.Количество() > 0 Тогда
		ВозЗначение = Истина	
	КонецЕсли;	

	Возврат ВозЗначение;
	
КонецФункции


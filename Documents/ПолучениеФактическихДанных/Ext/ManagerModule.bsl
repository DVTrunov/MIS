Процедура ОчиститьНеактуальныеИзмеренияФакта(Показатель, ТаблицаФакт)
	
	Если ТаблицаФакт.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Измерения = Новый ТаблицаЗначений;
	Измерения.Колонки.Добавить("ИмяКолонки");
	Измерения.Колонки.Добавить("ИмяФлагаУчета");
	Измерения.Колонки.Добавить("ПустоеЗначение");
	
	НоваяСтрока = Измерения.Добавить();
	НоваяСтрока.ИмяКолонки = "Сотрудник";
	НоваяСтрока.ИмяФлагаУчета = "Учет_Сотрудник";
	НоваяСтрока.ПустоеЗначение = Справочники.Сотрудники.ПустаяСсылка();
	
	НоваяСтрока = Измерения.Добавить();
	НоваяСтрока.ИмяКолонки = "Специализация";
	НоваяСтрока.ИмяФлагаУчета = "Учет_Специализация";
	НоваяСтрока.ПустоеЗначение = Справочники.КатегорииВыработки.ПустаяСсылка();
	
	НоваяСтрока = Измерения.Добавить();
	НоваяСтрока.ИмяКолонки = "Номенклатура";
	НоваяСтрока.ИмяФлагаУчета = "Учет_Номенклатура";
	НоваяСтрока.ПустоеЗначение = Справочники.Номенклатура.ПустаяСсылка();
	
	Для Каждого Измерение Из Измерения Цикл
		
		Если ТаблицаФакт.Колонки.Найти(Измерение.ИмяКолонки) <> Неопределено
			И Не Показатель[Измерение.ИмяФлагаУчета]
		Тогда
			
			Отбор = Новый Структура(Измерение.ИмяКолонки, Измерение.ПустоеЗначение);
			
			// Если есть не пустые значения в очередной колонке измерения, очищаем их.
			Если ТаблицаФакт.Количество() <> ТаблицаФакт.НайтиСтроки(Отбор).Количество() Тогда
				ТаблицаФакт.ЗаполнитьЗначения(Измерение.ПустоеЗначение, Измерение.ИмяКолонки);
				ДопСерверныеФункции.СвернутьТаблицуЗначений(ТаблицаФакт, "Значение");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
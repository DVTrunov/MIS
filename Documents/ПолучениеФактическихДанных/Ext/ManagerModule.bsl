
#Область СлужебныеПроцедурыИФункции

// Проверяет заполнение необходимых аналитик для показателей планирования в табличной части документа.
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъект.План, ДокументОбъект.ПолучениеФактическихДанных - проверяемый документ.
//  ИмяТЧ			 - Строка - имя табличной части документа. 
//  Отказ			 - Булево - признак отказа.
//
Процедура ПроверитьЗаполнениеАналитик(ДокументОбъект, ИмяТЧ, Отказ) Экспорт

	МетаданныеТЧ = ДокументОбъект.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ);
	
	Если МетаданныеТЧ <> Неопределено Тогда 
		Для Каждого СтрокаТЧ Из ДокументОбъект[ИмяТЧ] Цикл
			МассивАналитики = Справочники.ПоказателиПланирования.ПолучитьНаименованияАналитик();
			Для Каждого Аналитика Из МассивАналитики Цикл 
				Если СтрокаТЧ.Показатель["Обязательный_" + Аналитика]
					И Не ЗначениеЗаполнено(СтрокаТЧ[Аналитика])	Тогда
					
					Отказ = Истина;
					Сообщение = НСтр("ru = 'В табличной части документа для показателя ""'") + Строка(СтрокаТЧ.Показатель) 
								+ НСтр("ru = '"" не заполнен реквизит ""'") + Аналитика
								+ НСтр("ru = '""!'");
				
					ОбщегоНазначения.СообщитьОбОшибке(Сообщение, Отказ);
				КонецЕсли;
			КонецЦикла;								 
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Заполняет фактические данные показателей планирования в табличной части документа. 
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъект.ПолучениеФактическихДанных - заполняемый документ.
//
Процедура ЗаполнитьФактическиеДанные(ДокументОбъект) Экспорт 
	
	МассивСтрокДляУдаления = Новый Массив;
	
	ТаблицаПоказатели = ПолучитьПоказателиПланированияЗаПериод(ДокументОбъект.Период);
	
	Если ТаблицаПоказатели.Количество() <> 0 Тогда
		Для Каждого СтрокаПоказатель Из ТаблицаПоказатели Цикл
			
			Если Не СтрокаПоказатель.Показатель.Предопределенный Тогда
				Продолжить;
			КонецЕсли;
			
			ТаблицаРезультат = ПолучитьФактПоказателяЗаПериод(СтрокаПоказатель);
			ОчиститьНеактуальныеИзмеренияФакта(СтрокаПоказатель.Показатель, ТаблицаРезультат);
			
			ОтборСтрок = Новый Структура("Показатель, ЦФО", СтрокаПоказатель.Показатель);
			Если СтрокаПоказатель.Показатель.Учет_Сотрудник Тогда
				ОтборСтрок.Вставить("Сотрудник");
			КонецЕсли;
			Если СтрокаПоказатель.Показатель.Учет_Специализация Тогда
				ОтборСтрок.Вставить("Специализация");
			КонецЕсли;
			Если СтрокаПоказатель.Показатель.Учет_Номенклатура Тогда
				ОтборСтрок.Вставить("Номенклатура");
			КонецЕсли;
			
			Для Каждого СтрокаРезультат Из ТаблицаРезультат Цикл
				// При совпадении измерений перезаполняем существующие строки, чтобы они сохранили позицию в документе.
				ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаРезультат);
				Если СтрокаРезультат.Значение <> 0 Тогда
					НайденныеСтроки = ДокументОбъект.ФактическиеДанные.НайтиСтроки(ОтборСтрок);
					Если НайденныеСтроки.Количество() <> 0 Тогда
						СтрокаФактическиеДанные = НайденныеСтроки[0];
						СтрокаФактическиеДанные.Значение = СтрокаРезультат.Значение;
					Иначе
						СтрокаФактическиеДанные = ДокументОбъект.ФактическиеДанные.Добавить();
						СтрокаФактическиеДанные.Показатель = СтрокаПоказатель.Показатель;
						ЗаполнитьЗначенияСвойств(СтрокаФактическиеДанные, СтрокаРезультат);
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
			
			// Удаление старых строк этого показателя, для которых не было получено значение в ТаблицаРезультат.
			ОтборСтрок.Удалить("Показатель");
			СтрокиФактическиеДанные = ДокументОбъект.ФактическиеДанные.НайтиСтроки(Новый Структура("Показатель, ЦФО", СтрокаПоказатель.Показатель, СтрокаПоказатель.ЦФО));
			Для Каждого СтрокаФактическиеДанные Из СтрокиФактическиеДанные Цикл
				ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаФактическиеДанные);
				Если ТаблицаРезультат.НайтиСтроки(ОтборСтрок).Количество() = 0 Тогда
					МассивСтрокДляУдаления.Добавить(СтрокаФактическиеДанные);			
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// Удаление строк, предопределенные показатели которых не планируются.
	Для Каждого Строка Из ДокументОбъект.ФактическиеДанные Цикл		
		Если Строка.Показатель.Предопределенный 
			И (Строка.Значение = 0
				Или ТаблицаПоказатели.НайтиСтроки(Новый Структура("Показатель, ЦФО", Строка.Показатель, Строка.ЦФО)).Количество() = 0)
		Тогда 			
			МассивСтрокДляУдаления.Добавить(Строка);			
		КонецЕсли;		
	КонецЦикла;
	
	Для Каждого Строка Из МассивСтрокДляУдаления Цикл		
		ДокументОбъект.ФактическиеДанные.Удалить(Строка);		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПоказателиПланированияЗаПериод(Знач Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОборотыПоПланированию.Период КАК Период,
	               |	ОборотыПоПланированию.Показатель КАК Показатель,
	               |	ОборотыПоПланированию.ЦФО КАК ЦФО
	               |ИЗ
	               |	РегистрНакопления.ОборотыПоПланированию КАК ОборотыПоПланированию
	               |ГДЕ
	               |	ОборотыПоПланированию.Период = &Период
	               |	И ОборотыПоПланированию.Сценарий";
	
	Запрос.УстановитьПараметр("Период", Период);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьФактПоказателяЗаПериод(СтрокаПоказатель)
	
	Результат = Новый ТаблицаЗначений;
	
	Показатель = СтрокаПоказатель.Показатель;
	Период = СтрокаПоказатель.Период;
	ЦФО = СтрокаПоказатель.ЦФО;
	
	Если Показатель = Справочники.ПоказателиПланирования.СуммаПродаж Тогда 
		
		Результат = РассчитатьСуммуПродажЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.КоличествоУслуг Тогда 
		
		Результат = РассчитатьКоличествоУслугЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.СуммаОплат Тогда 
		
		Результат = РассчитатьСуммуОплатЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.СреднийЧекОбщий Тогда 
		
		Результат = РассчитатьСреднийЧекОбщийЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.СредняяСуммаПродажНаСотрудника Тогда 
		
		Результат = РассчитатьСреднююСуммуПродажНаСотрудникаЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.КоличествоПациентовОбщее Тогда 
		
		Результат = РассчитатьКоличествоПациентовОбщееЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.КоличествоНовыхПациентовПоСотруднику Тогда 
		
		Результат = РассчитатьКоличествоНовыхПациентовПоСотрудникуЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.КоличествоПосещений Тогда 
		
		Результат = РассчитатьКоличествоПосещенийЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.СреднийЧекПоСотруднику Тогда 
		
		Результат = РассчитатьСреднийЧекПоСотрудникуЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.КоличествоОтработанныхЧасовПоТабелю Тогда 
		
		Результат = РассчитатьКоличествоОтработанныхЧасовПоТабелюЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.КоличествоНовыхПациентовПоНаправлению Тогда 
		
		Результат = РассчитатьКоличествоНовыхПациентовПоНаправлениюЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.КоличествоПациентовПоНаправлению Тогда 
		
		Результат = РассчитатьКоличествоПациентовПоНаправлениюЗаПериод(Период, ЦФО);		
		
	ИначеЕсли Показатель = Справочники.ПоказателиПланирования.СреднийЧекПоНаправлению Тогда 
		
		Результат = РассчитатьСреднийЧекПоНаправлениюЗаПериод(Период, ЦФО);		
		
	КонецЕсли;
	
	ОчиститьНеактуальныеИзмеренияФакта(Показатель, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция РассчитатьСуммуПродажЗаПериод(Период, ЦФО)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.Номенклатура КАК Номенклатура,
	               |	ПродажиОбороты.Номенклатура.КатегорияВыработки КАК Специализация,
	               |	ПродажиОбороты.Сотрудник КАК Сотрудник,
	               |	ПродажиОбороты.Филиал КАК ЦФО,
	               |	СУММА(ПродажиОбороты.СуммаОборот) КАК Значение
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , Филиал = &Филиал) КАК ПродажиОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПродажиОбороты.Номенклатура,
	               |	ПродажиОбороты.Филиал,
	               |	ПродажиОбороты.Сотрудник,
	               |	ПродажиОбороты.Номенклатура.КатегорияВыработки";
	
	Запрос.УстановитьПараметр("НачалоПериода", Период);
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Период));
	Запрос.УстановитьПараметр("Филиал", ЦФО);
	 	
 	Результат = Запрос.Выполнить().Выгрузить();
 	Возврат Результат;
	
КонецФункции

Функция РассчитатьКоличествоУслугЗаПериод(Период, ЦФО)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.Номенклатура КАК Номенклатура,
	               |	ПродажиОбороты.Номенклатура.КатегорияВыработки КАК Специализация,
	               |	ПродажиОбороты.Сотрудник КАК Сотрудник,
	               |	ПродажиОбороты.Филиал КАК ЦФО,
	               |	СУММА(ПродажиОбороты.КоличествоОборот) КАК Значение
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			,
	               |			Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
	               |				И Филиал = &Филиал) КАК ПродажиОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПродажиОбороты.Филиал,
	               |	ПродажиОбороты.Номенклатура,
	               |	ПродажиОбороты.Сотрудник,
	               |	ПродажиОбороты.Номенклатура.КатегорияВыработки";
	
	Запрос.УстановитьПараметр("НачалоПериода", Период);
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Период));
	Запрос.УстановитьПараметр("Филиал", ЦФО);
	
 	Результат = Запрос.Выполнить().Выгрузить();
 	Возврат Результат;
	
КонецФункции

Функция РассчитатьСуммуОплатЗаПериод(Период, ЦФО)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ОплатыОбороты.СуммаОборот) КАК Значение,
	               |	ОплатыОбороты.Филиал КАК ЦФО
	               |ИЗ
	               |	РегистрНакопления.Оплаты.Обороты(&НачалоПериода, &КонецПериода, , Филиал = &Филиал) КАК ОплатыОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОплатыОбороты.Филиал";
	
	Запрос.УстановитьПараметр("НачалоПериода", Период);
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Период));
	Запрос.УстановитьПараметр("Филиал", ЦФО);
	
 	Результат = Запрос.Выполнить().Выгрузить();
 	Возврат Результат;
	
КонецФункции

Функция РассчитатьСреднийЧекОбщийЗаПериод(Период, ЦФО)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.СуммаОборот КАК СуммаОборот,
	               |	ПродажиОбороты.Регистратор КАК Регистратор,
	               |	ПродажиОбороты.ПериодДень КАК ПериодДень,
	               |	ПродажиОбороты.Номенклатура КАК Номенклатура,
	               |	ПродажиОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ПродажиОбороты.Клиент КАК Клиент,
	               |	ПродажиОбороты.Филиал КАК Филиал,
	               |	ПродажиОбороты.КоличествоОборот КАК КоличествоОборот
	               |ПОМЕСТИТЬ Продажи
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Авто, Филиал = &Филиал) КАК ПродажиОбороты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(Продажи.СуммаОборот) КАК Сумма,
	               |	Продажи.Филиал КАК Филиал
	               |ПОМЕСТИТЬ СуммаПродаж
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Продажи.Филиал
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Продажи.ПериодДень) КАК Количество,
	               |	Продажи.Филиал КАК Филиал,
	               |	Продажи.Клиент КАК Клиент
	               |ПОМЕСТИТЬ КоличествоЧековПоКлиентам
	               |ИЗ
	               |	Продажи КАК Продажи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Авто, ) КАК ВозвратыОбороты
	               |		ПО Продажи.Регистратор = ВозвратыОбороты.Регистратор.ДокументОснование
	               |			И Продажи.Номенклатура = ВозвратыОбороты.Номенклатура
	               |			И Продажи.ХарактеристикаНоменклатуры = ВозвратыОбороты.ХарактеристикаНоменклатуры
	               |			И (Продажи.КоличествоОборот = -ВозвратыОбороты.КоличествоОборот)
	               |			И Продажи.ПериодДень = ВозвратыОбороты.ПериодДень
	               |			И (ВозвратыОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ВозвратКлиенту))
	               |ГДЕ
	               |	Продажи.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ПродажаКлиенту)
	               |	И НЕ Продажи.Регистратор.Коррекция
	               |	И ВозвратыОбороты.Регистратор ЕСТЬ NULL
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Продажи.Филиал,
	               |	Продажи.Клиент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(КоличествоЧековПоКлиентам.Количество) КАК СуммаЧеков,
	               |	КоличествоЧековПоКлиентам.Филиал КАК Филиал
	               |ПОМЕСТИТЬ СуммаВсехЧеков
	               |ИЗ
	               |	КоличествоЧековПоКлиентам КАК КоличествоЧековПоКлиентам
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КоличествоЧековПоКлиентам.Филиал
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ Продажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////

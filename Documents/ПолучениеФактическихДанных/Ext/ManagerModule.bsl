Функция РассчитатьКоличествоНовыхПациентовПоНаправлениюЗаПериод(Период, ЦФО)
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МИНИМУМ(ПродажиОбороты.ПериодСекунда) КАК Период,
	               |	ПродажиОбороты.Номенклатура.КатегорияВыработки КАК Специализация,
	               |	ПродажиОбороты.Клиент КАК Клиент,
	               |	ПродажиОбороты.Филиал КАК Филиал
	               |ПОМЕСТИТЬ КлиентыПоНаправлениям
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Авто, Филиал = &Филиал) КАК ПродажиОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Авто, ) КАК ВозвратыОбороты
	               |		ПО ПродажиОбороты.Регистратор = ВозвратыОбороты.Регистратор.ДокументОснование
	               |			И ПродажиОбороты.Номенклатура = ВозвратыОбороты.Номенклатура
	               |			И ПродажиОбороты.ХарактеристикаНоменклатуры = ВозвратыОбороты.ХарактеристикаНоменклатуры
	               |			И (ПродажиОбороты.КоличествоОборот = -ВозвратыОбороты.КоличествоОборот)
	               |			И ПродажиОбороты.ПериодДень = ВозвратыОбороты.ПериодДень
	               |			И (ВозвратыОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ВозвратКлиенту))
	               |ГДЕ
	               |	ПродажиОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ПродажаКлиенту)
	               |	И НЕ ПродажиОбороты.Регистратор.Коррекция
	               |	И ВозвратыОбороты.Регистратор ЕСТЬ NULL
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПродажиОбороты.Номенклатура.КатегорияВыработки,
	               |	ПродажиОбороты.Клиент,
	               |	ПродажиОбороты.Филиал
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КлиентыПоНаправлениям.Клиент КАК Клиент,
	               |	КлиентыПоНаправлениям.Специализация КАК Специализация,
	               |	КлиентыПоНаправлениям.Филиал КАК Филиал
	               |ПОМЕСТИТЬ НовыеКлиентыПоНаправлениям
	               |ИЗ
	               |	КлиентыПоНаправлениям КАК КлиентыПоНаправлениям
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(, &КонецПериода, Авто, ) КАК ПродажиОбороты
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(, &КонецПериода, Авто, ) КАК ВозвратыОбороты
	               |			ПО ПродажиОбороты.Регистратор = ВозвратыОбороты.Регистратор.ДокументОснование
	               |				И ПродажиОбороты.ПериодДень = ВозвратыОбороты.ПериодДень
	               |				И ПродажиОбороты.Номенклатура = ВозвратыОбороты.Номенклатура
	               |				И ПродажиОбороты.ХарактеристикаНоменклатуры = ВозвратыОбороты.ХарактеристикаНоменклатуры
	               |				И (ПродажиОбороты.КоличествоОборот = -ВозвратыОбороты.КоличествоОборот)
	               |				И (ВозвратыОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ВозвратКлиенту))
	               |		ПО КлиентыПоНаправлениям.Клиент = ПродажиОбороты.Клиент
	               |			И КлиентыПоНаправлениям.Период > ПродажиОбороты.ПериодСекунда
	               |			И (ПродажиОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОказанияУслуг.ПродажаКлиенту))
	               |			И (НЕ ПродажиОбороты.Регистратор.Коррекция)
	               |			И (ВозвратыОбороты.Клиент ЕСТЬ NULL)
	               |ГДЕ
	               |	ПродажиОбороты.Клиент ЕСТЬ NULL
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КлиентыПоНаправлениям.Клиент) КАК Значение,
	               |	КлиентыПоНаправлениям.Филиал КАК ЦФО,
	               |	КлиентыПоНаправлениям.Специализация КАК Специализация,
	               |	ПродажиОбороты.Регистратор.Сотрудник КАК Сотрудник
	               |ИЗ
	               |	КлиентыПоНаправлениям КАК КлиентыПоНаправлениям
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Авто, Филиал = &Филиал) КАК ПродажиОбороты
	               |		ПО КлиентыПоНаправлениям.Клиент = ПродажиОбороты.Клиент
	               |			И КлиентыПоНаправлениям.Период = ПродажиОбороты.ПериодСекунда
	               |			И КлиентыПоНаправлениям.Филиал = ПродажиОбороты.Филиал
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НовыеКлиентыПоНаправлениям КАК НовыеКлиентыПоНаправлениям
	               |		ПО КлиентыПоНаправлениям.Клиент = НовыеКлиентыПоНаправлениям.Клиент
	               |			И КлиентыПоНаправлениям.Специализация = НовыеКлиентыПоНаправлениям.Специализация
	               |			И КлиентыПоНаправлениям.Филиал = НовыеКлиентыПоНаправлениям.Филиал
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КлиентыПоНаправлениям.Филиал,
	               |	КлиентыПоНаправлениям.Специализация,
	               |	ПродажиОбороты.Регистратор.Сотрудник";
	
	Запрос.УстановитьПараметр("НачалоПериода", Период);
	Запрос.УстановитьПараметр("КонецПериода",  КонецМесяца(Период));
	Запрос.УстановитьПараметр("Филиал", ЦФО);
	
 	Результат = Запрос.Выполнить().Выгрузить();
 	Возврат Результат;
	

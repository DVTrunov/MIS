Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 1. Ручные статусы.
	Движения.СтатусыПозицийМаршрута.Записывать = Истина;
	Для Каждого СтрокаПозиции Из Позиции Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПозиции.НовыйСтатус)
			ИЛИ Не ЗначениеЗаполнено(СтрокаПозиции.ИдентификаторНазначения) Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.СтатусыПозицийМаршрута.Добавить();
		Движение.ПервичныйПрием			= ПервичныйПрием;
		Движение.ИдентификаторНазначения	= СтрокаПозиции.ИдентификаторНазначения;
		Движение.Статус					= СтрокаПозиции.НовыйСтатус;
		Движение.Комментарий			= СтрокаПозиции.Комментарий;
		Движение.ДатаУстановки			= Дата;
		Движение.Врач					= Врач;
		
	КонецЦикла;
	
	// 2. Корректировки плана (только строки с заполненным Действием).
	Движения.КорректировкиПланаЛечения.Записывать = Истина;
	Для Каждого СтрокаПозиции Из Позиции Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПозиции.Действие)
			ИЛИ Не ЗначениеЗаполнено(СтрокаПозиции.ИдентификаторНазначения) Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.КорректировкиПланаЛечения.Добавить();
		Движение.Период					= Дата;
		Движение.ПервичныйПрием			= ПервичныйПрием;
		Движение.ИдентификаторНазначения	= СтрокаПозиции.ИдентификаторНазначения;
		Движение.ВидКорректировки		= СтрокаПозиции.Действие;
		Движение.СтандартЛечения		= СтандартЛечения;
		Движение.Номенклатура			= СтрокаПозиции.Номенклатура;
		Движение.Этап					= СтрокаПозиции.Этап;
		Движение.ДатаНачала				= СтрокаПозиции.ДатаНачала;
		Движение.ДатаОкончания			= СтрокаПозиции.ДатаОкончания;
		Движение.Количество				= СтрокаПозиции.Количество;
		Движение.ВидНазначения		= СтрокаПозиции.ВидНазначения;
		Движение.Дозировка			= СтрокаПозиции.Дозировка;
		Движение.ПриемовВДень		= СтрокаПозиции.ПриемовВДень;
		Движение.ЕдиницаИзмерения	= СтрокаПозиции.ЕдиницаИзмерения;
		
	КонецЦикла;	
КонецПроцедуры     

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		Если ЗначениеЗаполнено(ПервичныйПрием) Тогда
			Пациент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервичныйПрием, "МедицинскаяКарта"),
				"Клиент");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
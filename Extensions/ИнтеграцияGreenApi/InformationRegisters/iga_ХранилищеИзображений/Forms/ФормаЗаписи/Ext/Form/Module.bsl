#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    
    // 1. Автоматическое заполнение Идентификатора перед записью новой строки
    // Если тип измерения Строка(36), используем: Строка(Новый УникальныйИдентификатор)
    // Если тип УникальныйИдентификатор, то просто: Новый УникальныйИдентификатор
    Если Не ЗначениеЗаполнено(ТекущийОбъект.Идентификатор) Тогда
        ТекущийОбъект.Идентификатор = Новый УникальныйИдентификатор; 
    КонецЕсли;
    
    // 2. Сохраняем картинку в базу, если она была изменена или добавлена
    // Проверяем, что адрес указывает на временное хранилище (то есть картинку только что загрузили)
    Если ЗначениеЗаполнено(АдресКартинки) И ЭтоАдресВременногоХранилища(АдресКартинки) Тогда
        ДвоичныеДанныеКартинки = ПолучитьИзВременногоХранилища(АдресКартинки);
        // Упаковываем двоичные данные в Хранилище значения со сжатием для экономии места
        ТекущийОбъект.Данные = Новый ХранилищеЗначения(ДвоичныеДанныеКартинки, Новый СжатиеДанных(9));
    КонецЕсли;
    
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьИзображение(Команда)
    
    // Настраиваем диалог выбора файлов (только картинки)
    ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
    ПараметрыДиалога.МножественныйВыбор = Ложь;
    ПараметрыДиалога.Фильтр = "Изображения (*.png;*.jpg;*.jpeg;*.gif)|*.png;*.jpg;*.jpeg;*.gif";
    
    // Описываем процедуру, которая сработает ПОСЛЕ того, как пользователь выберет файл
    Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзображения", ЭтотОбъект);
    
    // Асинхронный вызов выбора файла (рекомендуемый метод для современных версий платформы)
    НачатьПомещениеФайлаНаСервер(Оповещение,,,, ПараметрыДиалога, УникальныйИдентификатор);
    
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Метод-колбэк, который вызывается после закрытия диалога выбора файла
&НаКлиенте
Процедура ПослеВыбораИзображения(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
    
    Если ОписаниеПомещенногоФайла <> Неопределено Тогда
        // Файл успешно загружен во временное хранилище. 
        // Присваиваем адрес реквизиту формы, и картинка сразу появится на экране.
        АдресКартинки = ОписаниеПомещенногоФайла.Адрес;
        
        // Принудительно устанавливаем признак модифицированности, 
        // чтобы стала активна кнопка "Записать и закрыть"
        Модифицированность = Истина;
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДвоичныеДанные = ТекущийОбъект.Данные.Получить();
	Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Или ТипЗнч(ДвоичныеДанные) = Тип("Картинка") Тогда
		// Помещаем во временное хранилище, чтобы элемент формы смог её отобразить
		АдресКартинки = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСсылку(Команда)
	
    Если Не ЗначениеЗаполнено(Запись.Идентификатор) Тогда
        Запись.Идентификатор = Новый УникальныйИдентификатор; 
    КонецЕсли;
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	// Ищем фрагмент Ref="ИмяБазы"
	НачалоИмени = Найти(СтрокаСоединения, "Ref=""") + 5;
	КонецИмени = Найти(Сред(СтрокаСоединения, НачалоИмени), """");
	ИмяБазы = Сред(СтрокаСоединения, НачалоИмени, КонецИмени - 1);

	
	Ссылка = "https://1c.divera.kz/" + ИмяБазы + "/hs/int-services/med/image?id=" + Запись.Идентификатор;
	
КонецПроцедуры

#КонецОбласти
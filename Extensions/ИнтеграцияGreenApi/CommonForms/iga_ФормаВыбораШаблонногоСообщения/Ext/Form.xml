				<Field>СписокШаблонов.ТекстСообщения</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	iga_ШаблоныСообщенийПодразделения.Ссылка.Наименование КАК Наименование,
	iga_ШаблоныСообщенийПодразделения.Ссылка.Идентификатор КАК Идентификатор,
	iga_ШаблоныСообщенийПодразделения.Ссылка.ТекстСообщения КАК ТекстСообщения
ИЗ
	Справочник.iga_ШаблоныСообщений.Подразделения КАК iga_ШаблоныСообщенийПодразделения
ГДЕ
	iga_ШаблоныСообщенийПодразделения.Ссылка.ДоступенДляВыбора
	И НЕ iga_ШаблоныСообщенийПодразделения.Ссылка.ПометкаУдаления
	И (ВЫБОР
				КОГДА &amp;ВыбПодразделение = НЕОПРЕДЕЛЕНО
					ТОГДА iga_ШаблоныСообщенийПодразделения.Подразделение В
							(ВЫБРАТЬ
								iga_НастройкиОператоров.Подразделение КАК Подразделение
							ИЗ
								РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
							ГДЕ
								iga_НастройкиОператоров.Оператор = &amp;Оператор)
				ИНАЧЕ iga_ШаблоныСообщенийПодразделения.Подразделение = &amp;ВыбПодразделение
			КОНЕЦ
			ИЛИ iga_ШаблоныСообщенийПодразделения.Подразделение = ЗНАЧЕНИЕ(Справочник.iga_ПодразделенияОператоров.ПустаяСсылка))</QueryText>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Идентификатор</dcssch:dataPath>
					<dcssch:field>Идентификатор</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ТекстСообщения</dcssch:dataPath>
					<dcssch:field>ТекстСообщения</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Наименование</dcssch:dataPath>
					<dcssch:field>Наименование</dcssch:field>
				</Field>
				<Parameter>
					<dcssch:name>Оператор</dcssch:name>
					<dcssch:title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Оператор</v8:content>
						</v8:item>
					</dcssch:title>
					<dcssch:valueType>
						<v8:Type>cfg:CatalogRef.Пользователи</v8:Type>
					</dcssch:valueType>
					<dcssch:value xsi:nil="true"/>
					<dcssch:useRestriction>true</dcssch:useRestriction>
				</Parameter>
				<Parameter>
					<dcssch:name>ВыбПодразделение</dcssch:name>
					<dcssch:title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Выб подразделение</v8:content>
						</v8:item>
					</dcssch:title>
					<dcssch:valueType>
						<v8:Type>cfg:CatalogRef.iga_ПодразделенияОператоров</v8:Type>
					</dcssch:valueType>
					<dcssch:value xsi:nil="true"/>
					<dcssch:useRestriction>true</dcssch:useRestriction>
				</Parameter>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>

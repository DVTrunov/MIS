&НаКлиенте
Процедура ОК(Команда)
	
	ОчищенныйНомер = ОчиститьНомерОтМаски(НомерТелефона);
	
	Если СтрДлина(ОчищенныйНомер) = 11 Тогда
		// Закрываем форму и передаем очищенный номер в форму-владелец
		Закрыть(ОчищенныйНомер);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Пожалуйста, введите номер телефона полностью.");
		// Если БСП не используется, можно использовать обычное Сообщить()
		// Сообщить("Пожалуйста, введите номер телефона полностью.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ОчиститьНомерОтМаски(Знач ИсходнаяСтрока)
	
	Результат = "";
	ДопустимыеСимволы = "0123456789";
	
	Для Индекс = 1 По СтрДлина(ИсходнаяСтрока) Цикл
		ТекущийСимвол = Сред(ИсходнаяСтрока, Индекс, 1);
		Если Найти(ДопустимыеСимволы, ТекущийСимвол) > 0 Тогда
			Результат = Результат + ТекущийСимвол;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Асинх Процедура Отмена(Команда)
	
	Ответ = Ждать ВопросАсинх("Отменить отправку?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет, "Отмена отправки", КодВозвратаДиалога.Да);
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимПроверки = Параметры.Свойство("НомерТелефона", НомерТелефона);
	
	Если НомерТелефона = "" Тогда
		НомерТелефона = "7";
	КонецЕсли;
	
	Если РежимПроверки Тогда
		Элементы.НомерТелефона.Заголовок = "Проверьте правильность номера";
	КонецЕсли;
	
КонецПроцедуры

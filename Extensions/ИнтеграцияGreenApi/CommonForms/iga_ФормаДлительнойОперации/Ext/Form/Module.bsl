
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы И Не ЗакрытьФорму Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПутьКФайлу = Параметры.ПутьКФайлу;
	ИмяФайла = Параметры.ИмяФайла;
	Расширение = Параметры.Расширение;
	ИдЧата = Параметры.ИдЧата;
	Сообщение = Параметры.Сообщение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОтправитьФайл();
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОтправитьФайл()
    
	ОписаниеПомещенногоФайла = Ждать ПоместитьФайлНаСерверАсинх(,,, ПутьКФайлу, УникальныйИдентификатор);
	
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		ЗакрытьФорму = Истина;
		ТекстОшибки = "Не удалось поместить файл для отправки. Попробуйте снова";
		Элементы.ГруппаПроцесс.Видимость = Ложь;
		Элементы.ГруппаРезультат.Видимость = Истина;
		Возврат;
	КонецЕсли;
	
    ЗапуститьОтправкуФайлаФоном(ОписаниеПомещенногоФайла.Адрес);
    
    ПодключитьОбработчикОжидания("ПроверитьЗавершениеОтправки", 2);
    
КонецПроцедуры

&НаСервере
Процедура ЗапуститьОтправкуФайлаФоном(АдресФайла)
    
    АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
    
    ПараметрыЗадания = Новый Массив;
	
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	СтруктураПараметров = Новый Структура("ПутьКФайлу, ИмяФайла, Расширение",ИмяВременногоФайла, ИмяФайла, Расширение);
	СтруктураПараметров.Вставить("Сообщение", Сообщение);
	СтруктураПараметров.Вставить("ИдЧата", ИдЧата);

	ПараметрыЗадания.Добавить(СтруктураПараметров);
    ПараметрыЗадания.Добавить(АдресРезультата);
    
    Задание = ФоновыеЗадания.Выполнить("iga_МетодыРаботыСБотом.ВыполнитьОтправкуФайла", ПараметрыЗадания);
    
    ИдентификаторЗадания = Задание.УникальныйИдентификатор;
    
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеОтправки()
    
    СостояниеЗадания = ПроверитьСтатусЗаданияНаСервере();
    
    Если СостояниеЗадания = "Активно" Тогда
        // Задание еще выполняется, ждем дальше
        Возврат;
    КонецЕсли;
    
    // Задание завершено (успешно или с ошибкой).
    // 1. Отключаем обработчик
    ОтключитьОбработчикОжидания("ПроверитьЗавершениеОтправки");
    
    // 2. Закрываем форму с анимацией
    // (Здесь должен быть ваш код закрытия формы-заглушки)
    
    // 3. Обрабатываем результат
    СтруктураРезультата = ПолучитьРезультатЗаданияНаСервере();
	
	ЗакрытьФорму = Истина;
	Если СтруктураРезультата.Успех Тогда
        ПоказатьОповещениеПользователя("Успех",, "Файл успешно отправлен!");
		Закрыть(Истина);
	Иначе
		
		ТекстОшибки = "Ошибка при отправке: " + СтруктураРезультата.ТекстОшибки;
		Элементы.ГруппаПроцесс.Видимость = Ложь;
		Элементы.ГруппаРезультат.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьСтатусЗаданияНаСервере()
    
    Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
    
    Если Задание = Неопределено Тогда
        Возврат "НеНайдено";
    КонецЕсли;
    
    Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
        Возврат "Активно";
    ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
        Возврат "Завершено";
    ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
        Возврат "Отменено";
    Иначе
        Возврат "Ошибка"; // Завершено с ошибкой
    КонецЕсли;

КонецФункции

&НаСервере
Функция ПолучитьРезультатЗаданияНаСервере()
    
    // Получаем данные, которые фоновое задание положило по нашему адресу
    Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
    
    // Если по какой-то причине задание упало до записи результата
    Если ТипЗнч(Результат) <> Тип("Структура") Тогда
        Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "Не удалось получить результат фонового задания (возможно, критическая ошибка).");
        
        // Попытаемся достать системную ошибку фонового задания
        Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
        Если Задание <> Неопределено И Задание.ИнформацияОбОшибке <> Неопределено Тогда
            Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
        КонецЕсли;
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции


			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ЗаявкаДок.Ссылка КАК Заявка,
	iga_ОповещенияПоВремени.ДатаЗаписи КАК ДатаЗаписиОповещения,
	ЗаявкаДок.ДатаНачала КАК ДатаЗаписиВЗаявке,
	МАКСИМУМ(ЗаявкаРаботы.Номенклатура) КАК Работа,
	МИНИМУМ(iga_ОповещенияПоВремени.ДатаОповещения) КАК ДатаОповещения
ИЗ
	РегистрСведений.iga_ОповещенияПоВремени КАК iga_ОповещенияПоВремени
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка КАК ЗаявкаДок
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.Работы КАК ЗаявкаРаботы
			ПО (ЗаявкаРаботы.Ссылка = ЗаявкаДок.Ссылка)
		ПО iga_ОповещенияПоВремени.Заявка = ЗаявкаДок.Ссылка
			И (iga_ОповещенияПоВремени.ДатаЗаписи &lt;&gt; ЗаявкаДок.ДатаНачала
				И НЕ iga_ОповещенияПоВремени.Выполнено)
ГДЕ
	iga_ОповещенияПоВремени.ДатаЗаписи &gt;= &amp;ТекущаяДата

СГРУППИРОВАТЬ ПО
	ЗаявкаДок.Ссылка,
	iga_ОповещенияПоВремени.ДатаЗаписи,
	ЗаявкаДок.ДатаНачала

УПОРЯДОЧИТЬ ПО
	iga_ОповещенияПоВремени.ДатаЗаписи</query>
	</dataSet>
	<parameter>
		<name>ТекущаяДата</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Текущая дата</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>ТекущаяДата()</expression>
		<availableAsField>false</availableAsField>
	</parameter>

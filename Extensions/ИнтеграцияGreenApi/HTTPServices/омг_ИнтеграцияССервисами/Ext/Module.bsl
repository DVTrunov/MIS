
Функция ПолучитьИзображениеДляОтправки(Запрос)
    
    // 1. По умолчанию готовим ответ 404 (Не найдено)
    Ответ = Новый HTTPСервисОтвет(404);
    
    // 2. Получаем параметр "id" из строки запроса (?id=...)
    СтрокаИД = Запрос.ПараметрыЗапроса.Получить("id");
    
    Если ПустаяСтрока(СтрокаИД) Тогда
        // Если параметр не передан, возвращаем 400 Bad Request
        Возврат Новый HTTPСервисОтвет(400);
    КонецЕсли;
    
    // 3. Преобразуем строку в УникальныйИдентификатор (оборачиваем в Попытку на случай кривого id)
    Попытка
        ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор(СтрокаИД));
    Исключение
        Возврат Новый HTTPСервисОтвет(400); 
    КонецПопытки;
    
    // 4. Ищем картинку в базе с помощью запроса
    ЗапросБД = Новый Запрос;
    ЗапросБД.Текст = 
        "ВЫБРАТЬ
        |	iga_ХранилищеИзображений.Данные КАК Данные
        |ИЗ
        |	РегистрСведений.iga_ХранилищеИзображений КАК iga_ХранилищеИзображений
        |ГДЕ
        |	iga_ХранилищеИзображений.Идентификатор = &Идентификатор";
        
    ЗапросБД.УстановитьПараметр("Идентификатор", ИдентификаторЗаписи);
    Результат = ЗапросБД.Выполнить();
    
    // 5. Если запись найдена, формируем успешный ответ
    Если Не Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        
        Если Выборка.Данные <> Неопределено Тогда
            // Достаем двоичные данные из хранилища
            ДвоичныеДанныеКартинки = Выборка.Данные.Получить();
            
            Если ТипЗнч(ДвоичныеДанныеКартинки) = Тип("ДвоичныеДанные") Тогда
                // Меняем статус на 200 ОК
                Ответ = Новый HTTPСервисОтвет(200);
                
                // Устанавливаем заголовок Content-Type, чтобы браузер понял, что это картинка.
                // В идеале тип нужно определять динамически, но для старта можно указать универсальный или jpeg
                Ответ.Заголовки.Вставить("Content-Type", "image/jpeg"); 
                
                // Помещаем двоичные данные картинки прямо в тело ответа
                Ответ.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеКартинки);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    
    Возврат Ответ;
    
КонецФункции

Функция СтраницаОповещенияОЗаписиПолучить(Запрос)
    
    // Получаем ID записи из URL
    IDЗаписи = Запрос.ПараметрыЗапроса.Получить("id");
	
	Попытка
		СсылкаЗаявки = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(IDЗаписи));
		
	Исключение
		Возврат Новый HTTPСервисОтвет(404);
	КонецПопытки;
	
	Запись = РегистрыСведений.iga_ЗаписиКОповещению.СоздатьМенеджерЗаписи();
	Запись.Заявка = СсылкаЗаявки;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		
		
		// --- ОТДАЕМ СТРАНИЦУ ОШИБКИ ---
		МакетОшибка = ПолучитьОбщийМакет("iga_ШаблонЗаписьНеНайдена");
		ТекстHTML_Ошибка = МакетОшибка.ПолучитьТекст();
		
		СсылкаWhatsApp = "https://wa.me/77710882357"; // Ссылка на WhatsApp клиники
		
		ТекстHTML_Ошибка = СтрЗаменить(ТекстHTML_Ошибка, "%СсылкаWhatsApp%", СсылкаWhatsApp);
		
		// Возвращаем статус 404 (Not Found) - это хорошая практика для веб-сервисов,
		// хотя визуально пациент увидит красивую страницу
		Ответ = Новый HTTPСервисОтвет(404);
		Ответ.Заголовки.Вставить("Content-Type", "text/html; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ТекстHTML_Ошибка, КодировкаТекста.UTF8);
		Возврат Ответ;
		
	КонецЕсли;
		

	
	ОбработчикЭтапов = Обработки.iga_ОбработчикЭтапов.Создать();
	ОбработчикЭтапов.ВходящиеПараметры = Новый Структура;
	ОбработчикЭтапов.ВходящиеПараметры.Вставить("Заявка", СсылкаЗаявки);
	
    // Подготовка общих данных
    ИмяКлиники = "Divera";
    АдресКлиникиRU = ОбработчикЭтапов.Алгоритм(Справочники.iga_Алгоритмы.АдресФилиалаНаРусском);
    АдресКлиникиKK = ОбработчикЭтапов.Алгоритм(Справочники.iga_Алгоритмы.АдресФилиалаНаКазахском);
    
    // Новые ссылки для кнопок
    СсылкаИнстаграм = ОбработчикЭтапов.Алгоритм(Справочники.iga_Алгоритмы.СсылкаИнстаграм);
    Ссылка2GIS = ОбработчикЭтапов.Алгоритм(Справочники.iga_Алгоритмы.Ссылка2гис);
    
    СписокУслугHTML_RU = "";
    СписокУслугHTML_KK = "";
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ГруппаЛИС
	               |ИЗ
	               |	РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	iga_ПозицииИсключенияИзОповещений.Номенклатура
	               |ИЗ
	               |	РегистрСведений.iga_ПозицииИсключенияИзОповещений КАК iga_ПозицииИсключенияИзОповещений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаявкаРаботы.Номенклатура КАК Номенклатура,
	               |	ЗаявкаРаботы.ДатаНачала КАК ДатаНачала,
	               |	ЕСТЬNULL(ЗаявкаРаботы.Сотрудник.Ссылка, ЗаявкаРаботы.Ссылка.Сотрудник) КАК Сотрудник,
	               |	ЗаявкаРаботы.НомерСтроки КАК НомерСтроки,
	               |	ЗаявкаРаботы.Продолжительность КАК Продолжительность,
	               |	ЗаявкаРаботы.омг_БезЗаписиНесколькоВрачей КАК омг_БезЗаписиНесколькоВрачей,
	               |	ЗаявкаРаботы.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_ВсеРаботы
	               |ИЗ
	               |	Документ.Заявка.Работы КАК ЗаявкаРаботы
	               |ГДЕ
	               |	ЗаявкаРаботы.Ссылка = &Ссылка
	               |	И НЕ ЗаявкаРаботы.Номенклатура В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					ВТ_ГруппаЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |				ИЗ
	               |					ВТ_ГруппаЛИС КАК ВТ_ГруппаЛИС)
	               |	И ЗаявкаРаботы.Ссылка.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Заявка.Сотрудник КАК Сотрудник,
	               |	Заявка.Сотрудник.Наименование КАК СотрудникНаименование,
	               |	Заявка.ДатаНачала КАК ДатаНачала,
	               |	Заявка.ВремяНачала КАК ВремяНачала,
	               |	Заявка.НесколькоСотрудников КАК НесколькоСотрудников
	               |ИЗ
	               |	Документ.Заявка КАК Заявка
	               |ГДЕ
	               |	Заявка.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаявкаРаботы.НомерСтроки КАК НомерСтроки,
	               |	ЗаявкаРаботы.Номенклатура КАК Номенклатура,
	               |	"""" КАК НаименованиеПроцедуры,
	               |	ЗаявкаРаботы.Сотрудник КАК Врач,
	               |	ЗаявкаРаботы.ДатаНачала КАК ДатаНачала,
	               |	ЗаявкаРаботы.Продолжительность КАК Продолжительность,
	               |	ЕстьNull(iga_РаботыСФиксированнымВременемЗаписи.Время, ЗаявкаРаботы.Ссылка.ВремяНачала) КАК ВремяНачала
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_ВсеРаботы.Ссылка КАК Ссылка,
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ВсеРаботы.НомерСтроки) КАК ВсегоСтрок
	               |	ИЗ
	               |		ВТ_ВсеРаботы КАК ВТ_ВсеРаботы
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_ВсеРаботы.Ссылка) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВсеРаботы КАК ЗаявкаРаботы
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_РаботыСФиксированнымВременемЗаписи КАК iga_РаботыСФиксированнымВременемЗаписи
	               |			ПО (ЗаявкаРаботы.Номенклатура = iga_РаботыСФиксированнымВременемЗаписи.Работа
	               |						И НЕ iga_РаботыСФиксированнымВременемЗаписи.Работа = ЗНАЧЕНИЕ(Справочник.НОменклатура.ПустаяСсылка)
	               |					ИЛИ iga_РаботыСФиксированнымВременемЗаписи.Врач = ЗаявкаРаботы.Сотрудник)
	               |		ПО (ИСТИНА)
	               |ГДЕ
	               |	ЗаявкаРаботы.Ссылка = &Ссылка
	               |	И НЕ ЗаявкаРаботы.Ссылка.НесколькоСотрудников
	               |	И ВложенныйЗапрос.ВсегоСтрок = 1
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаявкаРаботы.НомерСтроки,
	               |	ЗаявкаРаботы.Номенклатура,
	               |	ЕСТЬNULL(ЗаявкаРаботы.Номенклатура.НаименованиеПолное, """"),
	               |	ЗаявкаРаботы.Сотрудник,
	               |	ЗаявкаРаботы.ДатаНачала,
	               |	ЗаявкаРаботы.Продолжительность,
	               |	ЕстьNull(iga_РаботыСФиксированнымВременемЗаписи.Время, ЗаявкаРаботы.Ссылка.ВремяНачала)
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_ВсеРаботы.Ссылка КАК Ссылка,
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ВсеРаботы.НомерСтроки) КАК ВсегоСтрок
	               |	ИЗ
	               |		ВТ_ВсеРаботы КАК ВТ_ВсеРаботы
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_ВсеРаботы.Ссылка) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВсеРаботы КАК ЗаявкаРаботы
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_РаботыСФиксированнымВременемЗаписи КАК iga_РаботыСФиксированнымВременемЗаписи
	               |			ПО (ЗаявкаРаботы.Номенклатура = iga_РаботыСФиксированнымВременемЗаписи.Работа
	               |						И НЕ iga_РаботыСФиксированнымВременемЗаписи.Работа = ЗНАЧЕНИЕ(Справочник.НОменклатура.ПустаяСсылка)
	               |					ИЛИ iga_РаботыСФиксированнымВременемЗаписи.Врач = ЗаявкаРаботы.Сотрудник)
	               |		ПО (ИСТИНА)
	               |ГДЕ
	               |	ЗаявкаРаботы.Ссылка = &Ссылка
	               |	И НЕ ЗаявкаРаботы.Ссылка.НесколькоСотрудников
	               |	И НЕ ЗаявкаРаботы.Номенклатура = &ПустаяНоменклатура
	               |	И ВложенныйЗапрос.ВсегоСтрок > 1
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаявкаРаботы.НомерСтроки,
	               |	ЗаявкаРаботы.Номенклатура,
	               |	ЕСТЬNULL(ЗаявкаРаботы.Номенклатура.НаименованиеПолное, """"),
	               |	ЗаявкаРаботы.Сотрудник,
	               |	ЗаявкаРаботы.ДатаНачала,
	               |	ЗаявкаРаботы.Продолжительность,
	               |	ЕстьNull(iga_РаботыСФиксированнымВременемЗаписи.Время, ЗаявкаРаботы.Ссылка.ВремяНачала)
	               |ИЗ
	               |	ВТ_ВсеРаботы КАК ЗаявкаРаботы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_РаботыСФиксированнымВременемЗаписи КАК iga_РаботыСФиксированнымВременемЗаписи
	               |		ПО (ЗаявкаРаботы.Номенклатура = iga_РаботыСФиксированнымВременемЗаписи.Работа
	               |					И НЕ iga_РаботыСФиксированнымВременемЗаписи.Работа = ЗНАЧЕНИЕ(Справочник.НОменклатура.ПустаяСсылка)
	               |				ИЛИ iga_РаботыСФиксированнымВременемЗаписи.Врач = ЗаявкаРаботы.Сотрудник)
	               |ГДЕ
	               |	ЗаявкаРаботы.Ссылка = &Ссылка
	               |	И ЗаявкаРаботы.Ссылка.НесколькоСотрудников
	               |	И НЕ ЗаявкаРаботы.омг_БезЗаписиНесколькоВрачей
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", СсылкаЗаявки);
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаРаботы = ПакетРезультатов.Получить(3).Выбрать();
	
    
    // Перебираем услуги
	Нумератор = 0;
    Пока ВыборкаРаботы.Следующий() Цикл
		
		Нумератор = Нумератор + 1;
		
        ИмяВрача = Строка(ВыборкаРаботы.Врач);
        ДатаПриема = Формат(ВыборкаРаботы.ДатаНачала, "ДФ=dd.MM.yyyy");
        ВремяПриема = Формат(ВыборкаРаботы.ВремяНачала, "ДФ=ЧЧ:мм");
        
        // --- ДАННЫЕ НА РУССКОМ ---
        НазваниеУслугиRU = ВыборкаРаботы.НаименованиеПроцедуры;
        ТекстКалендарьRU = "Добавить в календарь";
		
		Если Не НазваниеУслугиRU = "" Тогда
			НазваниеУслугиRU = НазваниеУслугиRU + ",<br> ";
		КонецЕсли;
		
		КарточкаRU = "
		| <div class=""appointment-card"">
		|     <div class=""appointment-details"">
		|         <div class=""appointment-title"">" + Строка(Нумератор) + ") " + НазваниеУслугиRU + "⚕️ " + ИмяВрача + "</div>
		|         <div class=""appointment-info"">
		|             Дата: " + ДатаПриема + "<br>
		|             Время: " + ВремяПриема + "
		|         </div>
		|     </div>
		|     <div class=""calendar-action"" onclick=""addToCalendar('" + НазваниеУслугиRU + "', '" + ДатаПриема + "', '" + ВремяПриема + "', '" + ИмяВрача + "', '" + АдресКлиникиRU + "')"">
		|         <div class=""calendar-icon""></div>
		|         <div class=""calendar-text"">" + ТекстКалендарьRU + "</div>
		|     </div>
		| </div>";
		СписокУслугHTML_RU = СписокУслугHTML_RU + КарточкаRU;
		
		// --- ДАННЫЕ НА КАЗАХСКОМ ---
		НазваниеУслугиKK = ВыборкаРаботы.НаименованиеПроцедуры;
		ТекстКалендарьKK = "Күнтізбеге қосу";
		
		Если Не НазваниеУслугиKK = "" Тогда
			НазваниеУслугиKK = НазваниеУслугиKK + ",<br> ";
		КонецЕсли;

		КарточкаKK = "
		| <div class=""appointment-card"">
		|     <div class=""appointment-details"">
		|         <div class=""appointment-title"">" + Строка(Нумератор) + ") " + НазваниеУслугиKK + "⚕️ " + ИмяВрача + "</div>
		|         <div class=""appointment-info"">
		|             Күні: " + ДатаПриема + "<br>
		|             Уақыты: " + ВремяПриема + "
		|         </div>
		|     </div>
		|     <div class=""calendar-action"" onclick=""addToCalendar('" + НазваниеУслугиKK + "', '" + ДатаПриема + "', '" + ВремяПриема + "', '" + ИмяВрача + "', '" + АдресКлиникиKK + "')"">
		|         <div class=""calendar-icon""></div>
		|         <div class=""calendar-text"">" + ТекстКалендарьKK + "</div>
		|     </div>
		| </div>";
		СписокУслугHTML_KK = СписокУслугHTML_KK + КарточкаKK;
        
    КонецЦикла;
    
    // Получаем основной макет страницы
    Макет = ПолучитьОбщийМакет("омг_ИнтерфейсЗаписи");
    ТекстHTML = Макет.ПолучитьТекст();
    
    // Подставляем новые данные
    ТекстHTML = СтрЗаменить(ТекстHTML, "%НазваниеКлиники%", ИмяКлиники);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%АдресКлиникиRU%", АдресКлиникиRU);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%АдресКлиникиKK%", АдресКлиникиKK);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%СписокУслугHTML_RU%", СписокУслугHTML_RU);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%СписокУслугHTML_KK%", СписокУслугHTML_KK);
    
    // Заменяем ссылки на соцсети
    ТекстHTML = СтрЗаменить(ТекстHTML, "%СсылкаИнстаграм%", СсылкаИнстаграм);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%Ссылка2GIS%", Ссылка2GIS);
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "text/html; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(ТекстHTML, КодировкаТекста.UTF8);
    
    Возврат Ответ;
    
КонецФункции

Функция СтраницаПодтвержденияЗаписиПолучить(Запрос)
    
    // Получаем ID записи из URL

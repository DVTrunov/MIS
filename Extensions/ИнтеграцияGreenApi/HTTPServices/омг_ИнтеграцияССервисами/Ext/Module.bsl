		КонецЕсли;
		
		ВсплывашкаПодтвердитьKK = "Сіз " + НазваниеУслугиKK + " жазбасын растайтыныңызға сенімдісіз бе?";
	    ВсплывашкаОтменитьKK    = "Сіз " + НазваниеУслугиKK + " жазбасынан бас тартатыныңызға сенімдісіз бе?";
		ВсплывашкаПеренестиKK   = "" + НазваниеУслугиKK + " үшін уақытты ауыстыруды сұрайсыз ба? Менеджер сізге хабарласады.";
	    
	    БлокДействийKK = "";
	    Если ТекущийСтатус = Перечисления.iga_СтатусыПодтвержденияЗаявок.Подтверждено Тогда
	        БлокДействийKK = "<div class=""status-msg success"">✅ Расталды</div>";
	    ИначеЕсли ТекущийСтатус = Перечисления.iga_СтатусыПодтвержденияЗаявок.Отменено Тогда
	        БлокДействийKK = "<div class=""status-msg cancel"">❌ Күшін жою сұралды</div>";
		ИначеЕсли ТекущийСтатус = Перечисления.iga_СтатусыПодтвержденияЗаявок.ТребуетсяПеренос Тогда
			БлокДействийKK = "<div class=""status-msg reschedule"">⏎ Ауыстыру сұралды</div>";
	    Иначе
	        БлокДействийKK = "
	        | <div class=""action-buttons"" id=""actions-kk-" + ИдентификаторУслуги + """>
	        |     <button class=""btn-action btn-confirm"" onclick=""sendDecision(this, 'confirm', '" + IDЗаписи + "', '" + ИдентификаторУслуги + "', '" + ВсплывашкаПодтвердитьKK + "')"">Растау</button>
      		|     <button class=""btn-action btn-reschedule"" onclick=""sendDecision(this, 'reschedule', '" + IDЗаписи + "', '" + ИдентификаторУслуги + "', '" + ВсплывашкаПеренестиKK + "')"">Ауыстыру</button>
	        |     <button class=""btn-action btn-cancel"" onclick=""sendDecision(this, 'cancel', '" + IDЗаписи + "', '" + ИдентификаторУслуги + "', '" + ВсплывашкаОтменитьKK + "')"">Күшін жоюды сұрау</button>
	        | </div>
	        | <div class=""status-msg success"" id=""status-success-kk-" + ИдентификаторУслуги + """ style=""display:none;"">✅ Расталды</div>
	        | <div class=""status-msg cancel"" id=""status-cancel-kk-" + ИдентификаторУслуги + """ style=""display:none;"">❌ Күшін жою сұралды</div>
      		| <div class=""status-msg reschedule"" id=""status-reschedule-kk-" + ИдентификаторУслуги + """ style=""display:none;"">⏎ Ауыстыру сұралды</div>";
  	    КонецЕсли;

	    КарточкаKK = "
	    | <div class=""appointment-card"">
	    |     <div class=""appointment-details"">
	    |         <div class=""appointment-title"">" + НомерСтр + ") " + НазваниеУслугиKK + "⚕️ " + ИмяВрача + "</div>
	    |         <div class=""appointment-info"">Күні: " + ДатаПриема + "<br>Уақыты: " + ВремяПриема + "</div>
	    |     </div>
	    |     " + БлокДействийKK + "
	    | </div>";
	    СписокУслугHTML_KK = СписокУслугHTML_KK + КарточкаKK;
	        
    КонецЦикла;
    
    // Получаем основной макет страницы
    Макет = ПолучитьОбщийМакет("iga_ШаблонПодвержденияЗаписи");
    ТекстHTML = Макет.ПолучитьТекст();
	
	ТекстHTML = СтрЗаменить(ТекстHTML, "/ИмяВашейБазы/hs/api/appointments", Константы.iga_АдресСайтаПодтвержденияЗаявки.Получить() + "/hs/int-services/med/confirm");
    
    // Подставляем новые данные
    ТекстHTML = СтрЗаменить(ТекстHTML, "%НазваниеКлиники%", ИмяКлиники);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%АдресКлиникиRU%", АдресКлиникиRU);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%АдресКлиникиKK%", АдресКлиникиKK);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%СписокУслугHTML_RU%", СписокУслугHTML_RU);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%СписокУслугHTML_KK%", СписокУслугHTML_KK);
    
    // Заменяем ссылки на соцсети
    ТекстHTML = СтрЗаменить(ТекстHTML, "%СсылкаИнстаграм%", СсылкаИнстаграм);
    ТекстHTML = СтрЗаменить(ТекстHTML, "%Ссылка2GIS%", Ссылка2GIS);
	
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "text/html; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(ТекстHTML, КодировкаТекста.UTF8);
    
    Возврат Ответ;
    
КонецФункции

Функция ИзменениеСтатусаПодтвержденияЗаявкиPOST(Запрос)
    
    // 1. Получаем тело запроса от браузера
    ТелоЗапросаСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
    
    Если ПустаяСтрока(ТелоЗапросаСтрока) Тогда
        Возврат Новый HTTPСервисОтвет(400); // Bad Request (Пустой запрос)
    КонецЕсли;
    
    Попытка
        // 2. Читаем JSON в структуру
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапросаСтрока);
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
        // Получаем наши данные (как мы назвали их в JS)
        МетодДействия = Данные.metod; // "confirm" или "cancel" или "reschedule"
        IDЗаписи = Данные.id;
        НомерСтроки = Данные.num; // Это будет Число
        
        // 3. --- ЗДЕСЬ ВАША ЛОГИКА ---
        // Ищем документ по IDЗаписи
        // Меняем статус нужной строки (НомерСтроки) на "Подтвержден" или "Отменен"
        // Записываем документ
		
		СсылкаЗаявки = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(IDЗаписи));
		СсылкаУслуги = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(НомерСтроки));
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	iga_СтатусыПодтвержденияСтрокЗаявок.Заявка КАК Заявка,
		               |	iga_СтатусыПодтвержденияСтрокЗаявок.Работа КАК Работа,
		               |	iga_СтатусыПодтвержденияСтрокЗаявок.ДатаЗаписи КАК ДатаЗаписи,
		               |	iga_СтатусыПодтвержденияСтрокЗаявок.Статус КАК Статус,
		               |	iga_СтатусыПодтвержденияСтрокЗаявок.Обработано КАК Обработано
		               |ИЗ
		               |	РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
		               |ГДЕ
		               |	iga_СтатусыПодтвержденияСтрокЗаявок.Заявка = &Заявка
		               |	И iga_СтатусыПодтвержденияСтрокЗаявок.Работа = &Работа";
		Запрос.УстановитьПараметр("Заявка", СсылкаЗаявки);
		Запрос.УстановитьПараметр("Работа", СсылкаУслуги);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Запись = РегистрыСведений.iga_СтатусыПодтвержденияСтрокЗаявок.СоздатьМенеджерЗаписи();
		Запись.Заявка = СсылкаЗаявки;
		Запись.Работа = СсылкаУслуги;
		Если Выборка.Следующий() Тогда
			Запись.ДатаЗаписи = Выборка.ДатаЗаписи;
		КонецЕсли;
		
		СтатусПодтверждено = Ложь;
		СтатусОтменено = Ложь;
		
		Если МетодДействия = "confirm" Тогда		
			СтатусСтроки = Перечисления.iga_СтатусыПодтвержденияЗаявок.Подтверждено;
			СтатусПодтверждено = Истина;
		ИначеЕсли МетодДействия = "reschedule" Тогда
			СтатусСтроки = Перечисления.iga_СтатусыПодтвержденияЗаявок.ТребуетсяПеренос;
		Иначе
			СтатусСтроки = Перечисления.iga_СтатусыПодтвержденияЗаявок.Отменено;
			СтатусОтменено = Истина;
		КонецЕсли;
		Запись.Статус = СтатусСтроки;
		Запись.Записать();  
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗаявкаРаботы.Ссылка КАК Ссылка,
		               |	ЗаявкаРаботы.НомерСтроки КАК НомерСтроки,
		               |	ЗаявкаРаботы.Номенклатура КАК Номенклатура
		               |ПОМЕСТИТЬ ВТ_ПозицииЗаявки
		               |ИЗ
		               |	Документ.Заявка.Работы КАК ЗаявкаРаботы
		               |ГДЕ
		               |	ЗаявкаРаботы.Ссылка = &Заявка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ ПЕРВЫЕ 1
		               |	iga_СтатусыПодтвержденияСтрокЗаявок.Заявка КАК Заявка
		               |ИЗ
		               |	ВТ_ПозицииЗаявки КАК ВТ_ПозицииЗаявки
		               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		               |			ВТ_ПозицииЗаявки.Ссылка КАК Ссылка,
		               |			МАКСИМУМ(ВТ_ПозицииЗаявки.НомерСтроки) КАК КоличествоСтрок
		               |		ИЗ
		               |			ВТ_ПозицииЗаявки КАК ВТ_ПозицииЗаявки
		               |		
		               |		СГРУППИРОВАТЬ ПО
		               |			ВТ_ПозицииЗаявки.Ссылка) КАК ВложенныйЗапрос
		               |		ПО ВТ_ПозицииЗаявки.Ссылка = ВложенныйЗапрос.Ссылка
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
		               |		ПО ВТ_ПозицииЗаявки.Ссылка = iga_СтатусыПодтвержденияСтрокЗаявок.Заявка
		               |			И ВТ_ПозицииЗаявки.Номенклатура = iga_СтатусыПодтвержденияСтрокЗаявок.Работа
		               |ГДЕ
		               |	ВЫБОР
		               |			КОГДА ВложенныйЗапрос.КоличествоСтрок = 1
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ НЕ ВТ_ПозицииЗаявки.Номенклатура = &ПустаяНоменклатура
		               |		КОНЕЦ
		               |	И НЕ ЕСТЬNULL(iga_СтатусыПодтвержденияСтрокЗаявок.Статус, НЕОПРЕДЕЛЕНО) = &СтатусОтменено";
		Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
		Запрос.УстановитьПараметр("СтатусОтменено", СтатусСтроки);
		ИзменениеСостояния = Запрос.Выполнить().Пустой();
		
		Если ИзменениеСостояния И (СтатусПодтверждено Или СтатусОтменено) Тогда
			Если СтатусПодтверждено Тогда   
				ЗаявкаОбъект = СсылкаЗаявки.ПолучитьОбъект();
				Состояние = Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Подтверждена");
				Если Состояние.Пустая() Тогда
					Состояние = Справочники.ВидыСостоянийЗаявок.СоздатьЭлемент();
					Состояние.Наименование = "Подтверждена";
					Состояние.Записать();
					Состояние = Состояние.Ссылка;
				КонецЕсли;
				
				ЗаявкаОбъект.Состояние = Состояние;
				
				Если ЗаявкаОбъект.Проведен Тогда
					ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Иначе
					ЗаявкаОбъект.Записать();
				КонецЕсли;
			
			Иначе
				ЗаписьПричины = РегистрыСведений.ПричиныОтменыЗаявок.СоздатьМенеджерЗаписи();
				ЗаписьПричины.Заявка = СсылкаЗаявки;
				ЗаписьПричины.ПричинаОтменыЗаявки = "Отменена пациентом при подтверждении онлайн";
				ЗаписьПричины.Период = ТекущаяДата();
				ЗаписьПричины.Записать(); 
			КонецЕсли;
			
		КонецЕсли;
		
        // Для примера выведем в журнал регистрации
        ЗаписьЖурналаРегистрации("HTTP_ЗаписьНаПрием", УровеньЖурналаРегистрации.Информация,,, 
            "Действие: " + МетодДействия + ", ID: " + IDЗаписи + ", Строка: " + Строка(НомерСтроки));
            
    Исключение
        ЗаписьЖурналаРегистрации("HTTP_ЗаписьНаПрием", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
        Возврат Новый HTTPСервисОтвет(500); // Ошибка на сервере
    КонецПопытки;

    // 4. Отвечаем браузеру, что все прошло отлично
    Ответ = Новый HTTPСервисОтвет(200);
    Возврат Ответ;
    
КонецФункции

&Вместо("ИнтерфейсПациентаПолучить")
Функция iga_ИнтерфейсПациентаПолучить(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Метод = Запрос.ПараметрыURL.Получить("metod");
	
	Если Метод = "image" Тогда
		
		Ответ = ПолучитьИзображениеДляОтправки(Запрос);
		
	ИначеЕсли Метод = "appointments"  Тогда
		Ответ = СтраницаОповещенияОЗаписиПолучить(Запрос);
	ИначеЕсли Метод = "confirm" Тогда
		Ответ = СтраницаПодтвержденияЗаписиПолучить(Запрос);
	Иначе
		Ответ = ПродолжитьВызов(Запрос);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Ответ;

КонецФункции

&Вместо("ИнтерфейсПациентаОтправить")
Функция iga_ИнтерфейсПациентаОтправить(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Метод = Запрос.ПараметрыURL.Получить("metod");
	
	Если Метод = "confirm" Тогда
		
		Ответ = ИзменениеСтатусаПодтвержденияЗаявкиPOST(Запрос);
		
	Иначе
		Ответ = ПродолжитьВызов(Запрос);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Ответ;
КонецФункции

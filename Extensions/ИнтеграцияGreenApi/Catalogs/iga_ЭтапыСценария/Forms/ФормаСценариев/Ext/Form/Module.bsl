&НаКлиенте
Процедура ОбновитьСхему(Команда)
	ОбновитьСхемуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСхемуНаСервере()
	
	МакетHTML = Справочники.iga_ЭтапыСценария.ПолучитьМакет("МакетСхемыHTML"); 
	МакетБиблиотеки = Справочники.iga_ЭтапыСценария.ПолучитьМакет("МакетVisJS"); 
	
	ТекстШаблона = МакетHTML.ПолучитьТекст();
	ТекстШаблона = СтрЗаменить(ТекстШаблона, "[ССЫЛКА_НА_БИБЛИОТЕКУ_VIS]", ПоместитьВоВременноеХранилище(МакетБиблиотеки, УникальныйИдентификатор));
	
	// 1. Получаем абсолютно все этапы ОДНИМ запросом в таблицу значений
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	iga_ЭтапыСценария.Ссылка КАК Ссылка,
		|	iga_ЭтапыСценария.Наименование КАК Наименование,
		|	iga_ЭтапыСценария.ВариантыОтветов.(
		|		Команда.Наименование КАК ВариантОтвета,
		|		СледующийЭтап КАК СледующийЭтап
		|	) КАК ВариантыОтветов
		|ИЗ
		|	Справочник.iga_ЭтапыСценария КАК iga_ЭтапыСценария
		|ГДЕ
		|	НЕ iga_ЭтапыСценария.ПометкаУдаления";
		
	ТаблицаВсехЭтапов = Запрос.Выполнить().Выгрузить();
	
	// 2. Кэшируем данные в Соответствие для мгновенного поиска по Ссылке
	КэшЭтапов = Новый Соответствие;
	Для Каждого СтрокаЭтапа Из ТаблицаВсехЭтапов Цикл
		КэшЭтапов.Вставить(СтрокаЭтапа.Ссылка, СтрокаЭтапа);
	КонецЦикла;
	
	// 3. Подготавливаем структуры для графа
	МассивУзлов = Новый Массив;
	МассивСвязей = Новый Массив;
	ПосещенныеЭтапы = Новый Соответствие; // Журнал для защиты от бесконечных циклов
	
	// 4. ЗАПУСКАЕМ ОБХОД
	Если ЗначениеЗаполнено(ВыбранныйЭтап) Тогда
		// Отрисовываем только ветку от выбранного этапа
		ОбойтиВетку(ВыбранныйЭтап, КэшЭтапов, МассивУзлов, МассивСвязей, ПосещенныеЭтапы);
	Иначе
		// Если этап не выбран, обходим все этапы (старое поведение)
		Для Каждого ЭлементКэша Из КэшЭтапов Цикл
			ОбойтиВетку(ЭлементКэша.Ключ, КэшЭтапов, МассивУзлов, МассивСвязей, ПосещенныеЭтапы);
		КонецЦикла;
	КонецЕсли;
	
	// 5. ФОРМИРУЕМ JSON
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("nodes", МассивУзлов);
	СтруктураДанных.Вставить("edges", МассивСвязей);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ИтоговыйHTML = СтрЗаменить(ТекстШаблона, "[ДАННЫЕ_ГРАФА]", СтрокаJSON);
	ЭтаФорма.ТекстHTML = ИтоговыйHTML;
	
КонецПроцедуры

&НаСервере
Процедура ОбойтиВетку(СсылкаНаЭтап, КэшЭтапов, МассивУзлов, МассивСвязей, ПосещенныеЭтапы)
	
	// БАЗОВАЯ ЗАЩИТА: Если мы здесь уже были, прерываем рекурсию!
	Если ПосещенныеЭтапы.Получить(СсылкаНаЭтап) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Достаем данные этапа из кэша (чтобы не делать запросы к БД)
	СтрокаДанных = КэшЭтапов.Получить(СсылкаНаЭтап);
	Если СтрокаДанных = Неопределено Тогда
		Возврат; // Защита от битых ссылок (если указан удаленный этап)
	КонецЕсли;
	
	// Отмечаем этап как посещенный
	ПосещенныеЭтапы.Вставить(СсылкаНаЭтап, Истина);
	
	УИД_Этапа = Строка(СсылкаНаЭтап.УникальныйИдентификатор());
	
	// --- СОЗДАЕМ БЛОК ЭТАПА ---
	УзелЭтапа = Новый Структура("id, label, group", УИД_Этапа, СтрокаДанных.Наименование, "stages");
	
	// Красивая фишка: выделим зелёным цветом тот этап, с которого мы начали поиск
	Если ВыбранныйЭтап = СсылкаНаЭтап Тогда
		ЦветСтарта = Новый Структура("background, border", "#A2D9CE", "#1E8449"); 
		УзелЭтапа.Вставить("color", ЦветСтарта);
	КонецЕсли;
	
	МассивУзлов.Добавить(УзелЭтапа);
	
	// --- ОБРАБАТЫВАЕМ ВАРИАНТЫ ОТВЕТОВ ---
	СчетчикКнопок = 0;
	Для Каждого СтрокаОтвета Из СтрокаДанных.ВариантыОтветов Цикл
		СчетчикКнопок = СчетчикКнопок + 1;
		УИД_Кнопки = УИД_Этапа + "_btn" + СчетчикКнопок; 
		
		// Создаем блок кнопки
		УзелКнопки = Новый Структура("id, label, group", УИД_Кнопки, СтрокаОтвета.ВариантОтвета, "buttons");
		МассивУзлов.Добавить(УзелКнопки);
		
		// Связь 1: От Этапа к Кнопке
		МассивСвязей.Добавить(Новый Структура("from, to", УИД_Этапа, УИД_Кнопки));
		
		// Связь 2: От Кнопки к Следующему этапу
		Если ЗначениеЗаполнено(СтрокаОтвета.СледующийЭтап) Тогда
			
			УИД_Следующего = Строка(СтрокаОтвета.СледующийЭтап.УникальныйИдентификатор());
			МассивСвязей.Добавить(Новый Структура("from, to", УИД_Кнопки, УИД_Следующего));
			
			// МАГИЯ РЕКУРСИИ: Проваливаемся в следующий этап
			ОбойтиВетку(СтрокаОтвета.СледующийЭтап, КэшЭтапов, МассивУзлов, МассивСвязей, ПосещенныеЭтапы);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуЭтапа(ГУИД)
	
	Возврат Справочники.iga_ЭтапыСценария.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИД));
	
КонецФункции

&НаКлиенте
Процедура ТекстHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	// Заголовок — это строка, которую мы отправили из JS: "v8:open_stage:GUID:TIMESTAMP"
	Префикс = "v8:open_stage:";
	
	ЗаголовокДокумента = ДанныеСобытия.Document.title;
	
	Если СтрНачинаетсяС(ЗаголовокДокумента, Префикс) Тогда
		
		// 1. Убираем префикс
		ДанныеКоманды = СтрЗаменить(ЗаголовокДокумента, Префикс, "");
		
		// 2. Разрезаем строку, чтобы забрать только GUID (первая часть до двоеточия)
		Части = СтрРазделить(ДанныеКоманды, ":");
		Если Части.Количество() > 0 Тогда
			ГуидСтрокой = Части[0];
			
			// 3. Открываем карточку
			
			ОткрытьФорму("Справочник.iga_ЭтапыСценария.Форма.ФормаЭлемента", 
				Новый Структура("Ключ", ПолучитьСсылкуЭтапа(ГуидСтрокой)), ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеСобытия.Document.title = "";
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ВыбранныйЭтап", ВыбранныйЭтап);

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьСхемуНаСервере();

КонецПроцедуры


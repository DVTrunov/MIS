&НаСервере
Функция ОтправитьНаПодтверждениеНаСервере()
	
	ЭтоИзображение = Объект.ТипСодержимого = Перечисления.iga_ТипыСодержимогоШаблона.Изображение;
	
	НовыйШаблон = Объект.Идентификатор = "";
	
	СтруктураШаблона = Новый Структура;
	Если НовыйШаблон Тогда
		СтруктураШаблона.Вставить("elementName", Объект.ИмяШаблона);
		СтруктураШаблона.Вставить("languageCode", ?(Объект.Язык = Справочники.iga_ЯзыкиЧатов.Казахский, "kk", "ru"));
		СтруктураШаблона.Вставить("category", ?(Объект.Категория = Перечисления.iga_КатегорииШаблонов.Маркетинг, "MARKETING", "UTILITY"));
		СтруктураШаблона.Вставить("templateType", ?(ЭтоИзображение, "IMAGE","TEXT"));
		СтруктураШаблона.Вставить("vertical", Объект.КраткоеОписание);
	КонецЕсли;
	
	Если ЭтоИзображение Тогда
		СтруктураШаблона.Вставить("mediaUrl", Объект.СсылкаНаИзображение);
	КонецЕсли;
	
	ОтправляемыйТекст = Объект.ТекстСообщения;
	СчетчикПараметров = 0;
	Пока Истина Цикл
		
		НайденноеЗначение = СтрНайтиПоРегулярномуВыражению(ОтправляемыйТекст, "(?<!\{)\{[^{}]+\}(?!\})");
		Если НайденноеЗначение.НачальнаяПозиция = 0 Тогда
			Прервать;
		КонецЕсли;
		СчетчикПараметров = СчетчикПараметров + 1;
		
		ДлинаПараметра =  НайденноеЗначение.Длина;
		ЛеваяЧасть = Лев(ОтправляемыйТекст, НайденноеЗначение.НачальнаяПозиция - 1);
		
		Центр = "{{" + СчетчикПараметров + "}}";
		
		ПраваяЧасть = Прав(ОтправляемыйТекст, СтрДлина(ОтправляемыйТекст) - (НайденноеЗначение.НачальнаяПозиция + ДлинаПараметра - 1));
		
		ОтправляемыйТекст = ЛеваяЧасть +  Центр + ПраваяЧасть;
	КонецЦикла;
	СтруктураШаблона.Вставить("content", ОтправляемыйТекст);
	Если Не Объект.ЗаголовокСообщения = "" Тогда
		СтруктураШаблона.Вставить("header", Объект.ЗаголовокСообщения);
		СтруктураШаблона.Вставить("exampleHeader", Объект.ЗаголовокСообщения);
	КонецЕсли;
	
	ТекстПримера = Объект.ТекстСообщения;
	Для Каждого СтрокаПараметра Из Объект.ПараметрыШаблона Цикл
		ТекстПримера = СтрЗаменить(ТекстПримера, "{" + СтрокаПараметра.ИмяПараметра + "}", СтрокаПараметра.ЗначениеПримера);
	КонецЦикла;
	СтруктураШаблона.Вставить("example", ТекстПримера);
	Если Объект.Кнопки.Количество() > 0 Тогда
		МассивКнопок = Новый Массив;
		Для Каждого ДанныеКнопки Из Объект.Кнопки Цикл
			СтруктураКнопки = Новый Структура;
			МассивКнопок.Добавить(СтруктураКнопки);
			
			Если ДанныеКнопки.Тип = Перечисления.iga_ТипыКнопокСообщения.Ответ Тогда
				СтруктураКнопки.Вставить("type", "QUICK_REPLY");
			ИначеЕсли ДанныеКнопки.Тип = Перечисления.iga_ТипыКнопокСообщения.ПереходПоСсылке Тогда
				СтруктураКнопки.Вставить("type", "URL");
				СтруктураКнопки.Вставить("url", ДанныеКнопки.Значение);
			ИначеЕсли ДанныеКнопки.Тип = Перечисления.iga_ТипыКнопокСообщения.НомерТелефона Тогда
				СтруктураКнопки.Вставить("type", "PHONE_NUMBER");
				СтруктураКнопки.Вставить("phone_number", ДанныеКнопки.Значение);
			КонецЕсли;
			Найдено = СтрНайтиВсеПоРегулярномуВыражению(ДанныеКнопки.Значение, "\{\{([^}]+)\}\}", Истина, Истина);
			
			Если Найдено.Количество() > 0 Тогда
				СтруктураКнопки.Вставить("example", ДанныеКнопки.ЗначениеПримера);
			КонецЕсли;
			
			СтруктураКнопки.Вставить("text", ДанныеКнопки.Заголовок);
		КонецЦикла;
		
	КонецЕсли;
	СтруктураШаблона.Вставить("buttons", ЗаписатьЗначениеJSON(МассивКнопок)); 
	
	Бот = Обработки.iga_ChatBot.Создать();
	Бот.ИнициализацияОсновныхПараметров();
	
	Если НовыйШаблон Тогда
		ТелоЗапроса = ЗаписатьЗначениеJSON(СтруктураШаблона);
		Результат = Бот.СоздатьШаблонСообщения(СтруктураШаблона);
	Иначе
		СтруктураИзменение = Новый Структура;
		СтруктураИзменение.Вставить("templateId", Объект.Идентификатор);
		СтруктураИзменение.Вставить("templateParams", СтруктураШаблона);
		СтруктураИзменение.Вставить("enableSample", Истина);
		СтруктураИзменение.Вставить("allowTemplateCategoryChange", Истина);
		ТелоЗапроса = ЗаписатьЗначениеJSON(СтруктураИзменение);
		Результат = Бот.ИзменитьШаблонСообщения(СтруктураШаблона);
	КонецЕсли;
		
	Если Результат = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось создать/изменить шаблон.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Объект.Идентификатор = Результат.template.templateId;
	
	
	Объект.Статус = Перечисления.iga_СтатусыПодтвержденияШаблонов.ПолучитьПеречислениеПоСтатусу(Результат.template.status);
	Если Результат.template.status = "FAILED" И Результат.template.Свойство("reason") Тогда 
		Объект.ОшибкаШаблона = Результат.template.reason;
	КонецЕсли;
	
	Записать();
	
	УстановитьВидимостьОшибки();
	
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ОтправитьНаПодтверждение(Команда)
	
	Успех = ОтправитьНаПодтверждениеНаСервере();
	Если Успех Тогда
		ПоказатьПредупреждение(, "Шаблон успешно создан/изменен!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УдалитьШаблонНаСервере()
	
	Бот = Обработки.iga_ChatBot.Создать();
	Бот.ИнициализацияОсновныхПараметров();
	Результат = Бот.УдалитьШаблонСообщения(Объект.ИмяШаблона);
	
	Если Не ТипЗнч(Результат) = Тип("Структура")
		Или Не Результат.status = "success" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось удалить шаблон.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Объект.Идентификатор = "";
	Объект.Статус = Перечисления.iga_СтатусыПодтвержденияШаблонов.Создан;
	Записать();
	
	УстановитьВидимостьОшибки();
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура УдалитьШаблон(Команда)
	
	Если Объект.ИмяШаблона = "" Тогда
		Возврат;
	КонецЕсли;
	
	Успешно = УдалитьШаблонНаСервере();
	
	Если Успешно Тогда
		ПоказатьПредупреждение(, "Шаблон успешно удален");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьОшибки()

	Если Объект.Статус = Перечисления.iga_СтатусыПодтвержденияШаблонов.ОшибкаШаблона Тогда
		Элементы.ОшибкаШаблона.Видимость = Истина;
	Иначе
		ЭЛементы.ОшибкаШаблона.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьВидимостьОшибки();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПараметрыШаблонаЗначениеПримераНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ПараметрыШаблона.ТекущиеДанные;
	
	Значение = Ждать ВвестиСтрокуАсинх(ТекущаяСтрока.ЗначениеПримера, "Введите значение", 100, Истина);
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.ЗначениеПримера = Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСПримером(Команда)
	
	ТекстРедактора = Объект.ТекстСообщения;
	
	Для Каждого СтрокаПараметров Из Объект.ПараметрыШаблона Цикл
		ТекстРедактора = СтрЗаменить(ТекстРедактора, "{" + СтрокаПараметров.ИмяПараметра + "}", 
			СтрокаПараметров.ЗначениеПримера);
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура("ТекстДляРедактирования, Просмотр", ТекстРедактора, Истина);
	
	ОткрытьФорму("Обработка.iga_РедакторТекстаHTML.Форма.Форма", ПараметрыОткрытия, ЭтаФорма,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


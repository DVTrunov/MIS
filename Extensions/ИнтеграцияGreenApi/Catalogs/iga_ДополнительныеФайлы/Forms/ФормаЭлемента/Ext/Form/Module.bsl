&НаКлиенте
Асинх Процедура ВыбратьФайл(Команда)
	
	// Настраиваем диалог выбора
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = "Выберите файл для загрузки на FTP";
	
	// Ждем, пока пользователь выберет файл
	ВыбранныеФайлы = Ждать Диалог.ВыбратьАсинх();
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат; // Пользователь передумал и закрыл окно
	КонецЕсли;
	
	ПутьКЛокальномуФайлу = ВыбранныеФайлы[0];
	
	// Получаем расширение файла (например, ".pdf")
	ОбъектФайл = Новый Файл(ПутьКЛокальномуФайлу);
	РасширениеВыбранногоФайла = ОбъектФайл.Расширение;
	
	// Помещаем файл во временное хранилище сервера
	РезультатПомещения = Ждать ПоместитьФайлНаСерверАсинх(,,, ПутьКЛокальномуФайлу, УникальныйИдентификатор);
	Если РезультатПомещения.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	
	// Запоминаем адрес в реквизите формы и взводим флаг модифицированности
	АдресВременногоХранилища = РезультатПомещения.Адрес;
	Модифицированность = Истина;
	
	Сообщить("Файл подготовлен к загрузке. Нажмите ""Записать"", чтобы отправить его на сервер.");
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Проверяем, был ли выбран новый файл
	Если ЗначениеЗаполнено(АдресВременногоХранилища) Тогда
		
		ДанныеФайла = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		
		Если ДанныеФайла <> Неопределено Тогда
			
			// Получаем доступы из констант
			СерверФТП = Константы.iga_СерверХранилищаФайлов.Получить();
			ЛогинФТП  = Константы.iga_ПользовательХранилищаФайлов.Получить();
			ПарольФТП = Константы.iga_ПарольХранилищаФайлов.Получить();
			
			// Очищаем адрес сервера от префиксов (ftp://), чтобы корректно собрать https-ссылку
			ЧистыйДомен = СтрЗаменить(СтрЗаменить(СерверФТП, "ftp://", ""), "ftps://", "");
			КаталогНаФТП = "wa_imgs"; 
			
			ИмяФайлаНаФТП = "";
			СтароеИмяФайла = "";
			ТребуетсяНовоеИмя = Истина; // По умолчанию считаем, что нужно генерировать УИД
			
			// Шаг 1: Проверяем старую ссылку, чтобы понять, менялось ли расширение
			Если ЗначениеЗаполнено(ТекущийОбъект.СсылкаНаФайл) Тогда
				
				// Ищем последний слэш в ссылке, чтобы отсечь домен и папку
				ПозицияСлеша = СтрНайти(ТекущийОбъект.СсылкаНаФайл, "/", НаправлениеПоиска.СКонца);
				Если ПозицияСлеша > 0 Тогда
					СтароеИмяФайла = Сред(ТекущийОбъект.СсылкаНаФайл, ПозицияСлеша + 1);
					
					// Используем платформенный объект "Файл", чтобы безопасно вытащить расширение из строки
					ФайлИнфо = Новый Файл(СтароеИмяФайла);
					СтароеРасширение = ФайлИнфо.Расширение;
					
					// Если расширения совпадают (без учета регистра) - оставляем старое имя
					Если НРег(СтароеРасширение) = НРег(РасширениеВыбранногоФайла) Тогда
						ИмяФайлаНаФТП = СтароеИмяФайла;
						ТребуетсяНовоеИмя = Ложь;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			// Шаг 2: Если файла не было или расширение изменилось - создаем новое имя
			Если ТребуетсяНовоеИмя Тогда
				ИмяФайлаНаФТП = Строка(Новый УникальныйИдентификатор) + РасширениеВыбранногоФайла;
				// Формируем и записываем в реквизит итоговую HTTPS-ссылку
				ТекущийОбъект.СсылкаНаФайл = "https://" + ЧистыйДомен + "/" + КаталогНаФТП + "/" + ИмяФайлаНаФТП;
			КонецЕсли;
			
			// Формируем полный путь для записи на самом FTP (от корня сервера)
			ПолныйПутьНаФТП = ИмяФайлаНаФТП;
			
			Попытка
				// Соединяемся с FTP в пассивном режиме (5-й параметр Истина)
				ФТПСоединение = Новый FTPСоединение(СерверФТП, , ЛогинФТП, ПарольФТП, ,Истина);
				
				// Шаг 3 (Опционально): Если имя сменилось и старый файл существовал - удаляем его с FTP
				Если ТребуетсяНовоеИмя И ЗначениеЗаполнено(СтароеИмяФайла) Тогда
					Попытка
						ФТПСоединение.Удалить("/" + КаталогНаФТП + "/" + СтароеИмяФайла);
					Исключение
						// Игнорируем ошибку (например, если файл уже был кем-то удален вручную)
					КонецПопытки;
				КонецЕсли;
				
				// Шаг 4: Сохраняем файл из 1С на FTP
				ВременныйФайлСервера = ПолучитьИмяВременногоФайла(РасширениеВыбранногоФайла);
				ДанныеФайла.Записать(ВременныйФайлСервера);
				
				ФТПСоединение.Записать(ВременныйФайлСервера, ПолныйПутьНаФТП);
				
				// Убираем за собой временный файл на сервере 1С
				УдалитьФайлы(ВременныйФайлСервера);
				
			Исключение
				Отказ = Истина; // Прерываем запись справочника
				Сообщить("Ошибка при загрузке файла на FTP. Объект не записан!");
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
		// Очищаем реквизиты формы, чтобы избежать повторной отправки
		АдресВременногоХранилища = "";
		РасширениеВыбранногоФайла = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура УдалитьФайл(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.СсылкаНаФайл) Тогда
		ПоказатьПредупреждение(, "Файл еще не загружен или ссылка пуста.");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодтвержденияУдаления", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Вы уверены, что хотите удалить файл с FTP-сервера?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияУдаления(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если УдалитьФайлНаСервере() Тогда
			ПоказатьОповещениеПользователя("Успешно", , "Файл удален с сервера и ссылка очищена.");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УдалитьФайлНаСервере()
	
	// Получаем данные для подключения
	СерверФТП = Константы.iga_СерверХранилищаФайлов.Получить();
	ЛогинФТП  = Константы.iga_ПользовательХранилищаФайлов.Получить();
	ПарольФТП = Константы.iga_ПарольХранилищаФайлов.Получить();
	КаталогНаФТП = "wa_imgs";
	
	// Извлекаем имя файла из сохраненной ссылки
	ПозицияСлеша = СтрНайти(Объект.СсылкаНаФайл, "/", НаправлениеПоиска.СКонца);
	Если ПозицияСлеша = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяФайла = Сред(Объект.СсылкаНаФайл, ПозицияСлеша + 1);
	ПолныйПутьНаФТП = "/" + КаталогНаФТП + "/" + ИмяФайла;
	
	Попытка
		// Подключаемся в пассивном режиме
		ФТПСоединение = Новый FTPСоединение(СерверФТП, , ЛогинФТП, ПарольФТП, ,Истина);
		
		// Удаляем файл, передавая ТОЛЬКО имя (так как мы уже в нужной директории)
		ФТПСоединение.Удалить(ИмяФайла);
		
		Объект.СсылкаНаФайл = "";
		Записать();
		Возврат Истина;
	Исключение
		Сообщить("Не удалось удалить файл с FTP: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

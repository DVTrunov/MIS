
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьДеревоМетаданных();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоМетаданных()
    
    Дерево = РеквизитФормыВЗначение("ДеревоМетаданных");
    Дерево.Строки.Очистить();
    
    // --- СПРАВОЧНИКИ ---
    ВеткаСправочники = Дерево.Строки.Добавить();
    ВеткаСправочники.Представление = "Справочники";
    ВеткаСправочники.ПутьВставки = "Справочники"; // Можно оставить пустым, если не хотим вставлять корень
    
    Для Каждого МетаСправочник Из Метаданные.Справочники Цикл
        УзелСправочника = ВеткаСправочники.Строки.Добавить();
        УзелСправочника.Представление = МетаСправочник.Имя;
        УзелСправочника.ПутьВставки   = "Справочники." + МетаСправочник.Имя;
        
        // 1. Стандартные реквизиты (Ссылка, Код, Наименование, ПометкаУдаления и т.д.)
        Для Каждого СтРеквизит Из МетаСправочник.СтандартныеРеквизиты Цикл
            УзелРеквизита = УзелСправочника.Строки.Добавить();
            УзелРеквизита.Представление = СтРеквизит.Имя;
            // Формируем путь по твоему примеру: "Подразделения.Наименование"
            УзелРеквизита.ПутьВставки   = МетаСправочник.Имя + "." + СтРеквизит.Имя; 
        КонецЦикла;
        
        // 2. Пользовательские реквизиты
        Для Каждого Реквизит Из МетаСправочник.Реквизиты Цикл
            УзелРеквизита = УзелСправочника.Строки.Добавить();
            УзелРеквизита.Представление = Реквизит.Имя;
            УзелРеквизита.ПутьВставки   = МетаСправочник.Имя + "." + Реквизит.Имя;
        КонецЦикла;
        
        // 3. Табличные части (по желанию)
        Для Каждого ТабЧасть Из МетаСправочник.ТабличныеЧасти Цикл
            УзелТЧ = УзелСправочника.Строки.Добавить();
            УзелТЧ.Представление = ТабЧасть.Имя;
            УзелТЧ.ПутьВставки   = МетаСправочник.Имя + "." + ТабЧасть.Имя;
            
            // Реквизиты табличной части
            Для Каждого РеквизитТЧ Из ТабЧасть.Реквизиты Цикл
                УзелРеквизитаТЧ = УзелТЧ.Строки.Добавить();
                УзелРеквизитаТЧ.Представление = РеквизитТЧ.Имя;
                УзелРеквизитаТЧ.ПутьВставки   = МетаСправочник.Имя + "." + ТабЧасть.Имя + "." + РеквизитТЧ.Имя;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    
    // --- ДОКУМЕНТЫ (аналогичный блок) ---
    // Здесь можно добавить такой же обход для Метаданные.Документы, Метаданные.РегистрыСведений и т.д.
    ВеткаСправочники = Дерево.Строки.Добавить();
    ВеткаСправочники.Представление = "Документы";
    ВеткаСправочники.ПутьВставки = "Документы"; // Можно оставить пустым, если не хотим вставлять корень
    
    Для Каждого МетаСправочник Из Метаданные.ДОКУМЕНТЫ Цикл
        УзелСправочника = ВеткаСправочники.Строки.Добавить();
        УзелСправочника.Представление = МетаСправочник.Имя;
        УзелСправочника.ПутьВставки   = "Документы." + МетаСправочник.Имя;
        
        // 1. Стандартные реквизиты (Ссылка, Код, Наименование, ПометкаУдаления и т.д.)
        Для Каждого СтРеквизит Из МетаСправочник.СтандартныеРеквизиты Цикл
            УзелРеквизита = УзелСправочника.Строки.Добавить();
            УзелРеквизита.Представление = СтРеквизит.Имя;
            // Формируем путь по твоему примеру: "Подразделения.Наименование"
            УзелРеквизита.ПутьВставки   = МетаСправочник.Имя + "." + СтРеквизит.Имя; 
        КонецЦикла;
        
        // 2. Пользовательские реквизиты
        Для Каждого Реквизит Из МетаСправочник.Реквизиты Цикл
            УзелРеквизита = УзелСправочника.Строки.Добавить();
            УзелРеквизита.Представление = Реквизит.Имя;
            УзелРеквизита.ПутьВставки   = МетаСправочник.Имя + "." + Реквизит.Имя;
        КонецЦикла;
        
        // 3. Табличные части (по желанию)
        Для Каждого ТабЧасть Из МетаСправочник.ТабличныеЧасти Цикл
            УзелТЧ = УзелСправочника.Строки.Добавить();
            УзелТЧ.Представление = ТабЧасть.Имя;
            УзелТЧ.ПутьВставки   = МетаСправочник.Имя + "." + ТабЧасть.Имя;
            
            // Реквизиты табличной части
            Для Каждого РеквизитТЧ Из ТабЧасть.Реквизиты Цикл
                УзелРеквизитаТЧ = УзелТЧ.Строки.Добавить();
                УзелРеквизитаТЧ.Представление = РеквизитТЧ.Имя;
                УзелРеквизитаТЧ.ПутьВставки   = МетаСправочник.Имя + "." + ТабЧасть.Имя + "." + РеквизитТЧ.Имя;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    
    ЗначениеВРеквизитФормы(Дерево, "ДеревоМетаданных");
    
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    
    // Отключаем стандартное поведение (чтобы двойной клик не входил в режим редактирования ячейки)
    СтандартнаяОбработка = Ложь;
    
    ТекущиеДанные = Элемент.ТекущиеДанные;
    
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ТекстДляВставки = ТекущиеДанные.ПутьВставки;
    
    // Если путь пустой (например, кликнули по корню, где мы его не задали) - ничего не делаем
    Если ПустаяСтрока(ТекстДляВставки) Тогда
        Возврат;
    КонецЕсли;
    
    // Достукиваемся до окна браузера и вызываем нашу JS-функцию
    Закрыть(ТекстДляВставки)
    
КонецПроцедуры




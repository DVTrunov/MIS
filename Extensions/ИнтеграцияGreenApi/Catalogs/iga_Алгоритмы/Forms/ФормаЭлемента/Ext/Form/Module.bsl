
&НаКлиенте
Процедура ОбновитьСписокПараметров(ТекстАлгоритма)
	
	Если ПустаяСтрока(ТекстАлгоритма) Тогда
		Возврат;
	КонецЕсли;
	
	// 1. Используем регулярное выражение для поиска текста в фигурных скобках
	// Шаблон \{([^}]+)\} означает: найти "{", захватить всё, что не является "}", и найти "}"
	RegExp = Новый COMОбъект("VBScript.RegExp");
	RegExp.IgnoreCase = Истина; // Игнорировать регистр
	RegExp.Global     = Истина; // Искать все вхождения
	RegExp.MultiLine  = Истина;
	RegExp.Pattern    = "\{([^}]+)\}";
	
	Попытка
		Matches = RegExp.Execute(ТекстАлгоритма);
	Исключение
		Сообщить("Ошибка при разборе текста алгоритма: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// 2. Проходим по всем найденным совпадениям
	Для Каждого Match Из Matches Цикл
		
		// Получаем имя параметра без скобок (это первая подгруппа в регулярке)
		ИмяИзТекста = Match.SubMatches(0);
		
		// 3. Проверяем, есть ли уже такой параметр в таблице
		// Используем НайтиСтроки, чтобы не плодить дубли
		ПараметрыОтбора = Новый Структура("ИмяПараметра", ИмяИзТекста);
		НайденныеСтроки = Объект.ПараметрыАлгоритма.НайтиСтроки(ПараметрыОтбора);
		
		// Если строк не найдено — добавляем новую
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.ПараметрыАлгоритма.Добавить();
			НоваяСтрока.ИмяПараметра = ИмяИзТекста;
		КонецЕсли;
		
	КонецЦикла;
	
	// Параметры, которых нет в алгоритме, но есть в таблице, 
	// по твоему условию остаются без изменений, поэтому мы их не трогаем.

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметры(Команда)
	ОкноБраузера = Элементы.Алгоритм.Документ.defaultView;
	
	КодОбработки = ОкноБраузера.get1CCode();
	ОбновитьСписокПараметров(КодОбработки);
КонецПроцедуры


&НаСервере
Функция ПроверитьНаСервере(КодОбработки)
    // Массив для хранения стека вызовов (нужен для защиты от бесконечного цикла)
    СтекВызовов = Новый Массив;
    
	
	Обработчик = Обработки.iga_ОбработчикЭтапов.Создать();
	
    Возврат Обработчик.ВычислитьАлгоритм(КодОбработки, Объект.ПараметрыАлгоритма, СтекВызовов, Объект.Ссылка);
КонецФункции

&НаКлиенте
Процедура Проверить(Команда)
	
	Попытка
		
		ОкноБраузера = Элементы.Алгоритм.Документ.defaultView;
		
		КодОбработки = ОкноБраузера.get1CCode();
		
		КодОбработки = Объект.ПроверочныйКод + Символы.ПС + КодОбработки;
		
        РезультатВыполнения = ПроверитьНаСервере(КодОбработки);
		ВвестиСтрокуАсинх(Строка(РезультатВыполнения), "Алгоритм выполнен успешно!", 1000, Истина);
    Исключение
        Сообщить("Ошибка при выполнении: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Вставить(Команда)
	
	ТекущаяСтрока = Элементы.ПараметрыАлгоритма.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВставляемыйТекст = "{" + Элементы.ПараметрыАлгоритма.ТекущиеДанные.ИмяПараметра + "}";
	
	ОкноБраузера = Элементы.Алгоритм.Документ.defaultView;
	
	Если ОкноБраузера <> Неопределено Тогда
		// Вызываем нашу новую JS-функцию и передаем туда текст
		ОкноБраузера.insert1CCodeAtCursor(ВставляемыйТекст);
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Объект.ИмяАлгоритма = НРег(СформироватьИмяПеременной(Объект.Наименование));
КонецПроцедуры

// Преобразует произвольную строку в строку, пригодную для имени переменной/реквизита.
//
// Параметры:
//  ИсходнаяСтрока - Строка - Например, "Наименование клиента (полное)"
//
// Возвращаемое значение:
//  Строка - Валидный идентификатор (н-р, "НаименованиеКлиентаПолное")
//
Функция СформироватьИмяПеременной(Знач ИсходнаяСтрока) Экспорт
	
	// 1. Убираем лишние пробелы по краям
	Результат = СокрЛП(ИсходнаяСтрока);
	
	// 2. Определяем алфавит допустимых символов (буквы, цифры и подчеркивание)
	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZабвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789_";
	
	ОчищеннаяСтрока = "";
	СледующаяЗаглавная = Ложь;
	
	Для Поз = 1 По СтрДлина(Результат) Цикл
		
		Символ = Сред(Результат, Поз, 1);
		
		Если СтрНайти(ДопустимыеСимволы, Символ) > 0 Тогда
			// Если прошлый символ был разделителем, делаем текущую букву заглавной (CamelCase)
			Если СледующаяЗаглавная Тогда
				ОчищеннаяСтрока = ОчищеннаяСтрока + ВРег(Символ);
				СледующаяЗаглавная = Ложь;
			Иначе
				ОчищеннаяСтрока = ОчищеннаяСтрока + Символ;
			КонецЕсли;
		Иначе
			// Спецсимволы и пробелы считаем разделителями слов
			СледующаяЗаглавная = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	// 3. Имя переменной не может начинаться с цифры
	Если СтрДлина(ОчищеннаяСтрока) > 0 Тогда
		ПервыйСимвол = Лев(ОчищеннаяСтрока, 1);
		Если СтрНайти("0123456789", ПервыйСимвол) > 0 Тогда
			ОчищеннаяСтрока = "_" + ОчищеннаяСтрока;
		КонецЕсли;
	КонецЕсли;
	
	// 4. Если в итоге получилась пустая строка, даем стандартное имя
	Если ПустаяСтрока(ОчищеннаяСтрока) Тогда
		ОчищеннаяСтрока = "ИмяПеременной";
	КонецЕсли;
	
	Возврат ОчищеннаяСтрока;
	
КонецФункции

&НаКлиенте
Процедура ИмяАлгоритмаПриИзменении(Элемент)
	Объект.ИмяАлгоритма = СокрЛП(НРег(Объект.ИмяАлгоритма));

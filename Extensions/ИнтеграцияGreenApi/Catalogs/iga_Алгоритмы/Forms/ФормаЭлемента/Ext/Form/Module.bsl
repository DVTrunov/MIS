&НаКлиенте
Процедура ВставитьПоле(Команда)
	ОткрытьФорму("Справочник.iga_Алгоритмы.Форма.ФормаДереваМетаданных",, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ФорматнаяСтрока(Команда)
	
	КФС = Новый КонструкторФорматнойСтроки;
	Результат = Ждать КФС.ОткрытьАсинх();
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОкноБраузера = Элементы.Алгоритм.Документ.defaultView;
	
	Если ОкноБраузера <> Неопределено Тогда
		// Вызываем нашу новую JS-функцию и передаем туда текст
		ОкноБраузера.insert1CCodeAtCursor("""" + Результат + """");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеЗаданияПроверочногоКода(ПроверочныйКод, ДопПараметры) Экспорт
	
	Если ПроверочныйКод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ПроверочныйКод = ПроверочныйКод;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьПроверочныйКод(Команда)
	
	ОкноБраузера = Элементы.Алгоритм.Документ.defaultView;
	
	КодОбработки = ОкноБраузера.get1CCode();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеЗаданияПроверочногоКода", ЭтаФорма);
	ОткрытьФорму("Справочник.iga_Алгоритмы.Форма.ФормаПроверкиАлгоритма", 
		Новый Структура("ПроверочныйКод, ИсходныйТекст", Объект.ПроверочныйКод, КодОбработки),
		ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


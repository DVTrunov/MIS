
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИсходныйТекст = Параметры.ИсходныйТекст;
	ПроверочныйКод = Параметры.ПроверочныйКод;
	
	ТекстHTML = Обработки.iga_ОбработчикЭтапов.ПолучитьТекстПоляРедактораКода();
	
КонецПроцедуры

&НаСервере
Функция СгенерироватьКодЗаглушекУниверсальный(ТекстАлгоритма) Экспорт
    
    // --- 1. ОЧИСТКА ОТ СТРОК И КОММЕНТАРИЕВ ---
    RegExpОчистка = Новый COMОбъект("VBScript.RegExp");
    RegExpОчистка.Global = Истина;
    RegExpОчистка.Multiline = Истина;
    RegExpОчистка.Pattern = """(?:[^""]|"""")*""|//.*";
    ТекстБезСтрокИКомментариев = RegExpОчистка.Replace(ТекстАлгоритма, "");
    
    // --- 2. БАЗОВЫЙ СЛОВАРЬ ИСКЛЮЧЕНИЙ ---
    Исключения = Новый Соответствие;
    СтрокаИсключений = "Справочники,Документы,Отчеты,Обработки,РегистрыСведений,РегистрыНакопления,РегистрыБухгалтерии,"
                     + "РегистрыРасчета,Перечисления,ПланыВидовХарактеристик,ПланыСчетов,ПланыОбмена,Константы,"
                     + "БизнесПроцессы,Задачи,Метаданные,Символы,WebЦвета,StyleColors,WindowsColors,Элементы,ЭтаФорма,ЭтотОбъект,"
                     + "Если,Тогда,Иначе,ИначеЕсли,КонецЕсли,Для,Каждого,Из,Пока,Цикл,КонецЦикла,Процедура,Функция,КонецПроцедуры,"
                     + "КонецФункции,Перем,Экспорт,Знач,Возврат,Попытка,Исключение,КонецПопытки,Новый,Выполнить,И,Или,Не,В,То,Далее,Перейти,"
                     + "Истина,Ложь,Неопределено,Null,Формат,Сообщить,СтрЗаменить,СтрДлина,Лев,Прав,Сред,СтрНайти,ТекущаяДата,ЗначениеЗаполнено,ТипЗнч,Тип";
                     
    Для Каждого ИмяИсключения Из СтрРазделить(СтрокаИсключений, ",") Цикл
        Исключения.Вставить(ВРег(СокрЛП(ИмяИсключения)), Истина);
    КонецЦикла;
    
    // --- 3. ИЩЕМ ЛОКАЛЬНЫЕ ПЕРЕМЕННЫЕ (Динамические исключения) ---
    // Ищем присвоения вида: начало строки/оператор -> пробелы -> ИмяПеременной -> пробелы -> "="
    RegExpЛокальные = Новый COMОбъект("VBScript.RegExp");
    RegExpЛокальные.Global = Истина;
    RegExpЛокальные.IgnoreCase = Истина;
    RegExpЛокальные.Multiline = Истина;
    RegExpЛокальные.Pattern = "(?:^|;|Тогда|Иначе|ИначеЕсли|Цикл|Попытка|Исключение)\s*([a-zA-Zа-яА-Я_][a-zA-Zа-яА-Я0-9_]*)\s*=";
    
    НаходкиЛокальные = RegExpЛокальные.Execute(ТекстБезСтрокИКомментариев);
    Для Каждого Находка Из НаходкиЛокальные Цикл
        ИмяЛокальной = Находка.SubMatches(0); // Забираем только имя переменной
        Исключения.Вставить(ВРег(ИмяЛокальной), Истина);
    КонецЦикла;
    
    // --- 4. ПОИСК ВНЕШНИХ ПЕРЕМЕННЫХ И МЕТОДОВ ---
    RegExp = Новый COMОбъект("VBScript.RegExp");
    RegExp.IgnoreCase = Истина;
    RegExp.Global = Истина;
    RegExp.Pattern = "([a-zA-Zа-яА-Я_][a-zA-Zа-яА-Я0-9_]*(?:\.[a-zA-Zа-яА-Я_][a-zA-Zа-яА-Я0-9_]*)*)";
    
    НайденныеСовпадения = RegExp.Execute(ТекстБезСтрокИКомментариев);
    
    Если НайденныеСовпадения.Count = 0 Тогда Возврат "// Переменные не найдены."; КонецЕсли;
    
    Дерево = Новый ДеревоЗначений;
    Дерево.Колонки.Добавить("Имя");
    
    Для Каждого Совпадение Из НайденныеСовпадения Цикл
        
        ТекстПути = Совпадение.Value;
        
        // УМНАЯ ПРОВЕРКА НА МЕТОД: Смотрим следующий символ после найденного слова
        ИндексСледСимвола = Совпадение.FirstIndex + Совпадение.Length + 1; // 1С работает с 1-индексами, VBScript с 0
        СледСимвол = "";
        Если ИндексСледСимвола <= СтрДлина(ТекстБезСтрокИКомментариев) Тогда
            СледСимвол = Сред(ТекстБезСтрокИКомментариев, ИндексСледСимвола, 1);
        КонецЕсли;
        
        ЧастиПути = СтрРазделить(ТекстПути, ".");
        
        Если СледСимвол = "(" Тогда
            // Это вызов метода. Мы отбрасываем последнее слово (имя метода)
            ЧастиПути.Удалить(ЧастиПути.ВГраница());
        КонецЕсли;
        
        // Если после удаления метода ничего не осталось (например, была просто функция "Выбрать()")
        Если ЧастиПути.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        
        ИмяКорня = ЧастиПути[0];
        
        // Проверяем, не является ли это системной функцией или нашей локальной переменной
        Если Исключения.Получить(ВРег(ИмяКорня)) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        
        Если СтрДлина(ИмяКорня) < 2 И Найти("=+-*/<>", ИмяКорня) > 0 Тогда Продолжить; КонецЕсли;
        
        // --- Построение дерева ---
        ТекущиеУзлы = Дерево.Строки;
        Для Каждого Часть Из ЧастиПути Цикл
            НайденныйУзел = Неопределено;
            Для Каждого Узел Из ТекущиеУзлы Цикл
                Если Узел.Имя = Часть Тогда
                    НайденныйУзел = Узел; Прервать;
                КонецЕсли;
            КонецЦикла;
            
            Если НайденныйУзел = Неопределено Тогда
                НайденныйУзел = ТекущиеУзлы.Добавить();
                НайденныйУзел.Имя = Часть;
            КонецЕсли;
            
            ТекущиеУзлы = НайденныйУзел.Строки;
        КонецЦикла;
        
    КонецЦикла;
    
    // --- 5. ГЕНЕРАЦИЯ КОДА (Процедуру ГенерироватьКодПоДереву менять не нужно!) ---
    Если Дерево.Строки.Количество() = 0 Тогда Возврат "// Внешние переменные не обнаружены."; КонецЕсли;
    
    МассивКода = Новый Массив;
    Для Каждого КорневойУзел Из Дерево.Строки Цикл
        ГенерироватьКодПоДереву(КорневойУзел, КорневойУзел.Имя, МассивКода);
    КонецЦикла;
    
    Возврат СтрСоединить(МассивКода, Символы.ПС);
    
КонецФункции

&НаСервере
Процедура ГенерироватьКодПоДереву(Узел, ТекущийПуть, МассивКода)
    
    // Проверка корневого узла
    Если ТекущийПуть = Узел.Имя Тогда
        Если Узел.Строки.Количество() = 0 Тогда
            // Это одиночная переменная (без свойств)
            МассивКода.Добавить(ТекущийПуть + " = Неопределено; // Заполните значение");
        Иначе
            // Это переменная со свойствами
            МассивКода.Добавить(ТекущийПуть + " = Новый Структура;");
        КонецЕсли;
    КонецЕсли;
    
    Для Каждого ПодчиненныйУзел Из Узел.Строки Цикл
        
        МассивКода.Добавить(ТекущийПуть + ".Вставить(""" + ПодчиненныйУзел.Имя + """);");
        НовыйПуть = ТекущийПуть + "." + ПодчиненныйУзел.Имя;
        
        Если ПодчиненныйУзел.Строки.Количество() > 0 Тогда
            МассивКода.Добавить(НовыйПуть + " = Новый Структура;");
            ГенерироватьКодПоДереву(ПодчиненныйУзел, НовыйПуть, МассивКода);
        Иначе
            МассивКода.Добавить(НовыйПуть + " = Неопределено;");
        КонецЕсли;
        
    КонецЦикла;
    
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	ПроверочныйКод = СгенерироватьКодЗаглушекУниверсальный(ИсходныйТекст);
    
    ОкноБраузера = Элементы.ТекстHTML.Документ.defaultView;
    
    Если ОкноБраузера <> Неопределено Тогда
        ОкноБраузера.set1CCode(ПроверочныйКод);
    КонецЕсли;
    
КонецПроцедуры


&НаКлиенте
Процедура ТекстHTMLДокументСформирован(Элемент)
    
    ОкноБраузера = Элементы.ТекстHTML.Документ.defaultView;
    
    Если ОкноБраузера <> Неопределено Тогда
        ОкноБраузера.set1CCode(ПроверочныйКод);
    КонецЕсли;
    
КонецПроцедуры


&НаКлиенте
Процедура ОК(Команда)
    
    ОкноБраузера = Элементы.ТекстHTML.Документ.defaultView;
    
    Если ОкноБраузера <> Неопределено Тогда
		Закрыть(ОкноБраузера.get1CCode());
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ВставитьСсылку(Команда)
    
    iga_УниверсальныеОбработчикиНаКлиенте.ВставитьСсылку(ЭтаФорма, Элементы.ТекстHTML);
    
КонецПроцедуры



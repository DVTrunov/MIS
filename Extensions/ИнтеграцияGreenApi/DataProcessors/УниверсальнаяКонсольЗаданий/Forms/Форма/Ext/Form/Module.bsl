&НаКлиенте
Асинх Процедура ИсторияЗапусковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВвестиСтрокуАсинх(Элементы.ИсторияЗапусков.ТекущиеДанные.ОписаниеОшибки, "Ошибка задания", 1000, Истина);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьФоновые(Команда)
	ОбновитьИсториюЗапусков();
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьЗадание(Команда)
	
	ТекущиеДанные = Элементы.ИсторияЗапусков.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем статус. Смысл есть останавливать только "Активные" задания.
	// Статус "Выполняется" в 1С соответствует состоянию фонового задания.
	Если ТекущиеДанные.Состояние <> "Выполняется" Тогда
		ПоказатьПредупреждение(, "Можно остановить только те задания, которые имеют статус 'Выполняется'!");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодтвержденияОстановки", ЭтотОбъект, ТекущиеДанные.Идентификатор);
	ПоказатьВопрос(ОписаниеОповещения, "Вы уверены, что хотите принудительно прервать выполнение этого задания?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияОстановки(Результат, ИдентификаторФЗ) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ОстановитьФоновоеЗаданиеНаСервере(ИдентификаторФЗ) Тогда
			ПоказатьОповещениеПользователя("Успех", , "Задание остановлено.");
			ОбновитьИсториюЗапусков(); // Обновляем список, чтобы увидеть статус "Отменено"
		Иначе
			ПоказатьПредупреждение(, "Не удалось остановить задание. Возможно, оно уже завершилось.");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОстановитьФоновоеЗаданиеНаСервере(ИдентификаторТекстом)
	
	Попытка
		ID = Новый УникальныйИдентификатор(ИдентификаторТекстом);
		ФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ID);
		
		Если ФЗ <> Неопределено И ФЗ.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			ФЗ.Отменить(); // Метод принудительного завершения
			Возврат Истина;
		КонецЕсли;
	Исключение
		// Если задание уже завершилось к этому моменту, возникнет исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ОбновитьСписокЗаданийНаСервере()
	
	СписокЗаданий.Очистить();
	
	// Получаем все регламентные задания
	МассивЗаданий = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	
	Для Каждого Задание Из МассивЗаданий Цикл
		
		НоваяСтрока = СписокЗаданий.Добавить();
		
		// ИСПРАВЛЕНО: Вместо .Представление используем .Наименование
		НоваяСтрока.Имя = ?(ЗначениеЗаполнено(Задание.Наименование), Задание.Наименование, Задание.Метаданные.Синоним);
		
		НоваяСтрока.Метаданные = Задание.Метаданные.Имя;
		НоваяСтрока.Использование = Задание.Использование;
		НоваяСтрока.Идентификатор = Строка(Задание.УникальныйИдентификатор);
		
		// Получаем состояние последнего фонового задания
		ПоследнееЗадание = Задание.ПоследнееЗадание;
		Если ПоследнееЗадание <> Неопределено Тогда
			НоваяСтрока.Состояние = Строка(ПоследнееЗадание.Состояние);
			НоваяСтрока.ДатаПоследнегоЗапуска = ПоследнееЗадание.Конец;
		Иначе
			НоваяСтрока.Состояние = "Не запускалось";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьСписокЗаданийНаСервере();
КонецПроцедуры

// Команда для ручного обновления списка
&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьСписокЗаданийНаСервере();
КонецПроцедуры

// Команда для немедленного запуска задания
&НаКлиенте
Процедура ВыполнитьСейчас(Команда)
	
	ТекущиеДанные = Элементы.СписокЗаданий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗаданиеНаСервере(ТекущиеДанные.Идентификатор);
	
	ПоказатьОповещениеПользователя("Задание запущено", , ТекущиеДанные.Имя);
	ОбновитьСписокЗаданийНаСервере();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыполнитьЗаданиеНаСервере(ИдентификаторТекстом)
	
	ID = Новый УникальныйИдентификатор(ИдентификаторТекстом);
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ID);
	
	Если Задание <> Неопределено Тогда
		
		// Для запуска "сейчас" мы создаем ФоновоеЗадание.
		// Параметры:
		// 1. Имя метода (берем напрямую из метаданных задания)
		// 2. Массив параметров задания
		// 3. Ключ (используем ID, чтобы не плодить дубли)
		// 4. Наименование для отображения в списке фоновых заданий
		
		ФоновыеЗадания.Выполнить(
			Задание.Метаданные.ИмяМетода, 
			Задание.Параметры, 
			ИдентификаторТекстом, 
			"Запуск вручную: " + Задание.Наименование
		);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьАктивностьНаСервере(ИдентификаторТекстом, НовоеСостояние)
	
	ID = Новый УникальныйИдентификатор(ИдентификаторТекстом);
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ID);
	
	Если Задание <> Неопределено Тогда
		Задание.Использование = НовоеСостояние;
		Задание.Записать(); // Важно: изменения в регламентных заданиях нужно записывать!
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаданийИспользованиеПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СписокЗаданий.ТекущиеДанные;
	УстановитьАктивностьНаСервере(ТекущиеДанные.Идентификатор, ТекущиеДанные.Использование);
КонецПроцедуры


// Универсальный обработчик для обеих команд
&НаКлиенте
Процедура УстановитьАктивностьДляВыделенных(Активность)
	
	ВыделенныеСтроки = Элементы.СписокЗаданий.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала выделите одно или несколько заданий!");
		Возврат;
	КонецЕсли;
	
	МассивID = Новый Массив;
	
	// Собираем идентификаторы выделенных строк
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.СписокЗаданий.ДанныеСтроки(ИдентификаторСтроки);
		МассивID.Добавить(ДанныеСтроки.Идентификатор);
		
		// Сразу визуально обновляем флажок в таблице для красоты
		ДанныеСтроки.Использование = Активность;
	КонецЦикла;
	
	// Отправляем массив на сервер для записи в БД
	УстановитьАктивностьНаСервереМассово(МассивID, Активность);
	
	Текст = ?(Активность, "включено", "выключено");
	ПоказатьОповещениеПользователя("Готово", , "Заданий " + Текст + ": " + МассивID.Количество());
	
КонецПроцедуры

// Обработчики кнопок
&НаКлиенте
Процедура ВключитьВыбранные(Команда)
	УстановитьАктивностьДляВыделенных(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВыключитьВыбранные(Команда)
	УстановитьАктивностьДляВыделенных(Ложь);

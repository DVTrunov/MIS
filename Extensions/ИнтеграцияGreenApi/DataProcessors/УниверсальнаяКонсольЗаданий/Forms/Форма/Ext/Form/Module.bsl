Процедура СписокЗаданийПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРасписание(Команда)
	
	ТекущиеДанные = Элементы.СписокЗаданий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// 1. Получаем текущее расписание с сервера
	ТекущееРасписание = ПолучитьРасписаниеНаСервере(ТекущиеДанные.Идентификатор);
	
	// 2. Инициализируем диалог расписания
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(ТекущееРасписание);
	
	// 3. Описываем оповещение, которое сработает после закрытия окна расписания
	Оповещение = Новый ОписаниеОповещения("ПослеРедактированияРасписания", ЭтотОбъект, ТекущиеДанные.Идентификатор);
	
	// 4. Открываем диалог (асинхронно)
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРасписаниеНаСервере(ИдентификаторТекстом)
	
	ID = Новый УникальныйИдентификатор(ИдентификаторТекстом);
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ID);
	
	Если Задание <> Неопределено Тогда
		Возврат Задание.Расписание;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ПослеРедактированияРасписания(НовоеРасписание, ИдентификаторЗадания) Экспорт
	
	// Если пользователь нажал "ОК" (расписание не Неопределено)
	Если НовоеРасписание <> Неопределено Тогда
		
		УстановитьРасписаниеНаСервере(ИдентификаторЗадания, НовоеРасписание);
		ПоказатьОповещениеПользователя("Расписание обновлено", , "Новые настройки вступят в силу немедленно.");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьРасписаниеНаСервере(ИдентификаторТекстом, НовоеРасписание)
	
	ID = Новый УникальныйИдентификатор(ИдентификаторТекстом);
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ID);
	
	Если Задание <> Неопределено Тогда
		Задание.Расписание = НовоеРасписание;
		Задание.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаданийПриАктивизацииСтроки(Элемент)
	
	// Подключаем "ленивую" загрузку, чтобы не перегружать сервер при быстром пролистывании
	ПодключитьОбработчикОжидания("ОбновитьИсториюЗапусков", 0.2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИсториюЗапусков()
	
	ТекущиеДанные = Элементы.СписокЗаданий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ИсторияЗапусков.Очистить();
		Возврат;
	КонецЕсли;
	
	ОбновитьИсториюНаСервере(ТекущиеДанные.Идентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИсториюНаСервере(ИдентификаторТекстом)
	
	ИсторияЗапусков.Очистить();
	
	ID = Новый УникальныйИдентификатор(ИдентификаторТекстом);
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ID);
	
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем фоновые задания, связанные с этим регламентным
	// Ограничим выборку последними 50-ю записями, чтобы не тормозить
	Отбор = Новый Структура;
	Отбор.Вставить("РегламентноеЗадание", Задание);
	
	МассивФоновых = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	
	// Сортируем: сначала новые (по дате начала, убывание)
	// К сожалению, ПолучитьФоновыеЗадания не всегда гарантирует порядок, 
	// поэтому пройдемся по массиву.
	
	Для Каждого ФЗ Из МассивФоновых Цикл
		
		НоваяСтрока = ИсторияЗапусков.Добавить();
		НоваяСтрока.Состояние = Строка(ФЗ.Состояние);
		НоваяСтрока.Начало = ФЗ.Начало;
		НоваяСтрока.Конец = ФЗ.Конец;
		НоваяСтрока.Идентификатор = ФЗ.УникальныйИдентификатор;
		
		Если ЗначениеЗаполнено(ФЗ.Конец) Тогда
			НоваяСтрока.Длительность = ФЗ.Конец - ФЗ.Начало;
		КонецЕсли;
		
		// Если была ошибка, вытаскиваем её текст
		Если ФЗ.ИнформацияОбОшибке <> Неопределено Тогда
			НоваяСтрока.ОписаниеОшибки = ФЗ.ИнформацияОбОшибке.Описание;
		КонецЕсли;
		
	КонецЦикла;
	
	// Сортировка таблицы на сервере
	ИсторияЗапусков.Сортировать("Начало Убыв");
	
КонецПроцедуры


&НаКлиенте
Процедура ИсторияЗапусковПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры



&НаКлиенте
Процедура ПослеВводаПричиныОтказа(Результат, ДопПарамеры) Экспорт
	Если Результат = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ПричиныБезОповещения = Новый Массив;
	ПричиныБезОповещения.Добавить(ПредопределенноеЗначение("Справочник.iga_ПричиныОтклоненияОжидающихЧатов.ТребуетсяВмешательствоРуководства"));
	ПричиныБезОповещения.Добавить(ПредопределенноеЗначение("Справочник.iga_ПричиныОтклоненияОжидающихЧатов.ПереводНаДругойФилиал"));
	
	Если ПричиныБезОповещения.Найти(ДопПарамеры.Причина) = Неопределено Тогда
	
		//ТекстСообщения = ПолучитьТекстСообщения(ПредопределенноеЗначение("Перечисление.iga_ТипыТекстовСообщений.ТекстПриОтказеОтПриемаДиалога"), ДопПарамеры.ЧатСсылка);
		
		//ОтправитьПростоеСообщение(ТекущийОператор, ДопПарамеры.ЧатСсылка, ДопПарамеры.ИдЧата, ТекстСообщения);
		
	КонецЕсли;
	
	ТекстПричины = СокрЛП(Результат);
	
	РезультатОтказа = ВыполнитьОтклонениеНаСервере(ДопПарамеры, ТекстПричины);
	
	Если РезультатОтказа Тогда
		Элементы.СписокЧатов.Обновить();
		ОбновитьОкноДиалога();
	Иначе
		ПоказатьПредупреждение(, "Чат уже ушел в просрочку или был принят другим оператором и не может быть отклонен вручную!");
		Элементы.СписокЧатов.Обновить();
	КонецЕсли;
	УстановитьДоступностьЭлементов();  
	ЗаполнитьКоличествоЧатов();
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФилиалаПеревода(ВыбранноеПодразделение, ДопПараметры) Экспорт
	
	Если ВыбранноеПодразделение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Вставить("ВыбранноеПодразделение", ВыбранноеПодразделение);
	
	ПослеВводаПричиныОтказа("", ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеВыбораПричиныОтлонения(ВыбЗначение, ДопПарамеры) Экспорт
	
	Если ВыбЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПарамеры.Вставить("Причина", ВыбЗначение.Значение.Причина);
	ДопПарамеры.Вставить("СвойстваПричины", ВыбЗначение.Значение);
	
	Если ДопПарамеры.Причина = ПредопределенноеЗначение("Справочник.iga_ПричиныОтклоненияОжидающихЧатов.ТребуетсяВмешательствоРуководства") Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаПричиныОтказа", ЭтотОбъект, ДопПарамеры);
		ПоказатьВводСтроки(ОписаниеОповещения, "", "Подробности (необязательно):", 1000, Истина);
	ИначеЕсли ДопПарамеры.Причина = ПредопределенноеЗначение("Справочник.iga_ПричиныОтклоненияОжидающихЧатов.ПереводНаДругойФилиал") Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораФилиалаПеревода", ЭтотОбъект, ДопПарамеры);
		СтруктураОтбора = Новый Структура("ПометкаУдаления", Ложь);
		ПараметрыОткрытия = Новый Структура("Отбор", СтруктураОтбора);
		ОткрытьФорму("Справочник.iga_ПодразделенияОператоров.ФормаВыбора", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор,,,
			ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ПослеВводаПричиныОтказа("", ДопПарамеры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокПричинОтлонения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ПричиныОтклоненияОжидающихЧатов.Ссылка КАК Причина, ЗавершитьЧат
	               |ИЗ
	               |	Справочник.iga_ПричиныОтклоненияОжидающихЧатов КАК iga_ПричиныОтклоненияОжидающихЧатов
	               |ГДЕ
	               |	НЕ iga_ПричиныОтклоненияОжидающихЧатов.Ссылка = ЗНАЧЕНИЕ(Справочник.iga_ПричиныОтклоненияОжидающихЧатов.Просрочено)
				   | И НЕ ПричинаЗавершения И Не ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	СписокПричин = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		
		СтруктураПричины = Новый Структура("Причина, БезОповещения, ЗавершитьЧат");
		
		ЗаполнитьЗначенияСвойств(СтруктураПричины, Выборка);
		
		СписокПричин.Добавить(СтруктураПричины, Выборка.Причина);
	КонецЦикла;
	
	Возврат СписокПричин;
	
КонецФункции

&НаКлиенте
Процедура ОтклонитьДиалог(Команда)
	ТекущиеДанные = Элементы.СписокЧатов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("ЧатСсылка, ИдЧата", ТекущиеДанные.Чат, ТекущиеДанные.ИдЧата);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеВыбораПричиныОтлонения", ЭтаФорма, СтруктураПараметров);
	
	СписокПричин = ПолучитьСписокПричинОтлонения();
	
	ПоказатьВыборИзМеню(ОписаниеОповещения, СписокПричин, Элементы.ОтклонитьДиалог);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	УточняющийЧат = ТекущаяСтраницаЧатов = СтраницаУточнение();
	ОтменаПеренос = ТекущаяСтраницаЧатов = СтраницаЗаписи();
	
	АктивныеЧаты = ТекущаяСтраницаЧатов = СтраницаАктивные();
	
	Ожидающие = ТекущаяСтраницаЧатов = СтраницаОжидающие();
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	ОператорОнлайн = ТекущийСтатусОператора = ПредопределенноеЗначение("Перечисление.iga_СтатусыОператоров.Онлайн");
	
	Если Не ОператорОнлайн Или ТекущиеДанные = Неопределено Тогда
		Элементы.ГруппаКоманды.Доступность = Ложь;
		Элементы.ТекстовоеСообщение.Доступность = Ложь;
		Элементы.Отправить.Доступность = Ложь;
		Элементы.ПрикрепитьФайл.Доступность      = Ложь;
		Возврат;
	Иначе
		Элементы.ГруппаКоманды.Доступность = Истина;
		Элементы.ТекстовоеСообщение.Доступность = Истина;
	КонецЕсли;
	
	ТекущийСтатусОчереди = ПолучитьТекущийСтатусЧата(ТекущиеДанные.Чат);;
	Если ОтменаПеренос Тогда
		ТекущийСтатусОчереди = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.Завершен");
	КонецЕсли;
	
	Если Не ОтменаПеренос Тогда
		ПрошлоБолее24Часа = iga_ОбщегоНазначенияКлиентСервер.РазностьДат(ТекущиеДанные.ДатаСообщения, ТекущаяДата(), "ЧАС") >= 24;
	Иначе
		ПрошлоБолее24Часа = Ложь;
	КонецЕсли;
	
	Если АктивныеЧаты И iga_ОбщегоНазначенияКлиентСервер.РазностьДат(ТекущиеДанные.ДатаСообщения, ТекущаяДата(), "ЧАС") >= 24 Тогда
		ОжиданиеОтвета = Истина;
	Иначе
		ОжиданиеОтвета = Ложь;
	КонецЕсли;
	
	Элементы.НачатьДиалог.Видимость = ((ТекущийСтатусОчереди = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.Подключение") И (АктивныеЧаты)) 
	                                ИЛИ ТекущийСтатусОчереди = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.Завершен"))
									Или ПрошлоБолее24Часа Или Ожидающие;
	
	Элементы.ЗавершитьДиалог.Видимость = (ТекущийСтатусОчереди = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.ВРаботе")) И (АктивныеЧаты или УточняющийЧат);
	
	Элементы.ОтклонитьДиалог.Видимость = (ТекущийСтатусОчереди = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.Подключение")
									ИЛИ ТекущийСтатусОчереди = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.ВРаботе")) И АктивныеЧаты;
	Элементы.ПродлитьБронь.Видимость   = (ТекущийСтатусОчереди = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.Подключение")) И (АктивныеЧаты или УточняющийЧат);
	
	Элементы.ПродлитьБронь.Доступность = Не ТекущиеДанные.ВремяПродлено И (АктивныеЧаты);
	
	ДоступностьВвода = (ТекущийСтатусОчереди = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.ВРаботе") И Не ПрошлоБолее24Часа И Не ОжиданиеОтвета 
		и АктивныеЧаты) или (УточняющийЧат И Не ОжиданиеОтвета И Не ПрошлоБолее24Часа);
	Элементы.Отправить.Доступность      = ДоступностьВвода;
	Элементы.ПрикрепитьФайл.Доступность      = ДоступностьВвода;
	Элементы.НеподтвержденныеЗаписи.Доступность = ДоступностьВвода;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьСтатусОператораНаСервере(Оператор, Статус, ПриниматьНовыеЧаты, ИзменитьПринятиеНовых)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_НастройкиОператоров.Оператор КАК Оператор,
	               |	iga_НастройкиОператоров.Статус КАК Статус,
	               |	iga_НастройкиОператоров.ЛимитЧатов КАК ЛимитЧатов,
	               |	iga_НастройкиОператоров.ПростойОператор КАК ПростойОператор
	               |ИЗ
	               |	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |ГДЕ
	               |	iga_НастройкиОператоров.Оператор = &Оператор";
	Запрос.УстановитьПараметр("Оператор", Оператор);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ЗаписьНастроек = РегистрыСведений.iga_НастройкиОператоров.СоздатьМенеджерЗаписи();
	ЗаписьНастроек.Оператор = Оператор;
	ЗаписьНастроек.Прочитать();
	
	ЗаписьНастроек.Статус = Статус;
	
	Выборка.Следующий();
	
	Если ИзменитьПринятиеНовых И Статус = Перечисления.iga_СтатусыОператоров.Онлайн Тогда
		ЗаписьНастроек.ПриниматьНовыеЧаты = Истина;
		ПриниматьНовыеЧаты = Истина;
	КонецЕсли;
	ЗаписьНастроек.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьПриниматьНовыеЧаты(Оператор, ПриниматьНовыеЧаты)
	
	ЗаписьНастроек = РегистрыСведений.iga_НастройкиОператоров.СоздатьМенеджерЗаписи();
	ЗаписьНастроек.Оператор = Оператор;
	ЗаписьНастроек.Прочитать();
	
	ЗаписьНастроек.ПриниматьНовыеЧаты = ПриниматьНовыеЧаты;
	ЗаписьНастроек.Записать();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ТекущийСтатусОператораПриИзменении(Элемент)
	
	НовыйСтатус = ТекущийСтатусОператора;
	
	ТекущийСтатусОператора = ПредыдущийСтатусОператора;
	
	Если Не Ждать ПодтверждениеОперации("Изменение статуса") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не НовыйСтатус = ПредопределенноеЗначение("Перечисление.iga_СтатусыОператоров.Оффлайн") Тогда	
		ИзменитьПринятиеНовых = Ждать ПодтверждениеОперации("Принимать новые чаты?");
	Иначе
		ИзменитьПринятиеНовых = Истина;
	КонецЕсли;
	
	ТекущийСтатусОператора = НовыйСтатус;
	ПредыдущийСтатусОператора = ТекущийСтатусОператора;
	
	ИзменитьСтатусОператораНаСервере(ТекущийОператор, ТекущийСтатусОператора, ПриниматьНовыеЧаты, ИзменитьПринятиеНовых); 
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры


&НаСервереБезКонтекста
Процедура ОтработатьЗаписьНаСервере(Чат, Оператор, Заявка, Работа)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ОчередьРаспределения.Чат КАК Чат
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |ГДЕ
	               |	iga_ОчередьРаспределения.Оператор = &Оператор
	               |	И iga_ОчередьРаспределения.Чат = &Чат
	               |	И iga_ОчередьРаспределения.Статус = &Статус";
	Запрос.УстановитьПараметр("Чат", Чат);
	Запрос.УстановитьПараметр("Оператор", Оператор);
	Запрос.УстановитьПараметр("Статус", Перечисления.iga_СтатусыОчереди.ВРаботе);
	Если Запрос.Выполнить().Пустой() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Перед отработкой необходимо взять чат в работу!";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Запись = РегистрыСведений.iga_СтатусыПодтвержденияСтрокЗаявок.СоздатьМенеджерЗаписи();
	Запись.Заявка = Заявка;
	Запись.Работа = Работа;
	Запись.Прочитать();
	Запись.Обработано = Истина;
	Запись.Записать();
	
КонецПроцедуры


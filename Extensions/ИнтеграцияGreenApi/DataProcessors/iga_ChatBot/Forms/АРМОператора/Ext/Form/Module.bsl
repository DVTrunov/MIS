&НаСервереБезКонтекста
Функция ПолучитьЧатПоНомеруТелефона(НомерТелефона)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_Чаты.Ссылка КАК Ссылка,
	               |	ЕСТЬNULL(iga_ОчередьРаспределения.Статус, &СтатусЗавершен) КАК Статус
	               |ИЗ
	               |	Справочник.iga_Чаты КАК iga_Чаты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |		ПО (iga_ОчередьРаспределения.Чат = iga_Чаты.Ссылка)
	               |ГДЕ
	               |	iga_Чаты.Идентификатор ПОДОБНО ""%"" + &Идентификатор + ""%""";
	Запрос.УстановитьПараметр("Идентификатор", НомерТелефона);
	Запрос.УстановитьПараметр("СтатусЗавершен", Перечисления.iga_СтатусыОчереди.Завершен);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Не Выборка.Статус = Перечисления.iga_СтатусыОчереди.Завершен Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Чат в работе!";
			Сообщение.Сообщить();
			Возврат Неопределено;
		КонецЕсли;
		
		ЧатСсылка = Выборка.Ссылка;
	Иначе
		УстановитьПривилегированныйРежим(Истина);
		Чат = Справочники.iga_Чаты.СоздатьЭлемент();
		Чат.Идентификатор = НомерТелефона + "@c.us";
		Чат.Наименование = Чат.Идентификатор;
		Чат.Записать();
		УстановитьПривилегированныйРежим(Ложь);
		ЧатСсылка = Чат.Ссылка;
	КонецЕсли;
	
	Возврат ЧатСсылка;
	
КонецФункции

&НаКлиенте
Процедура СоздатьЧатИИнициализироватьНовыйДиалог(НомерТелефона)
	
	ЧатСсылка = ПолучитьЧатПоНомеруТелефона(НомерТелефона);
	
	Если ЧатСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Новый Структура("ИдЧата, Чат, Статус", 
		НомерТелефона + "@c.us", ЧатСсылка, ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.Завершен"));
		
	ИнициализацияВыбораПосле24Часа(ТекущиеДанные, ЧатСсылка);
	
КонецПроцедуры


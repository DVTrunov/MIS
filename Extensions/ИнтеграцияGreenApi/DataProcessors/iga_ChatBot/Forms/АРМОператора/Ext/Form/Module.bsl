&НаКлиенте
Процедура ПроверитьНовыеСообщения()
	
	СчетчикСекунд = СчетчикСекунд + 5;

	Если ТекущаяСтраницаЧатов = СтраницаАктивные() Тогда
		
		СписокЧатов.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
		Элементы.СписокЧатов.Обновить();
		
	ИначеЕсли ТекущаяСтраницаЧатов = СтраницаОжидающие() Тогда
		Элементы.СписокОжидающих.Обновить();
	КонецЕсли;
	
	Если (ТекущаяСтраницаЧатов = СтраницаЗаписи() 
		Или ТекущаяСтраницаЧатов = СтраницаИстория()
		Или ТекущаяСтраницаЧатов = СтраницаУточнение())
		И СчетчикСекунд >= 60 Тогда
		
		Элементы.СписокЧатовОтмененныхПереносовЗаписей.Обновить();
		Элементы.СписокЧатовИстория.Обновить();
		Элементы.СписокЧатовТребуютУточнения.Обновить();
		
	КонецЕсли;
	
	ЗаполнитьКоличествоЧатов();
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	Если ЕстьНовыеСообщенияНаСервере(ОбщаяВременнаяМетка) И Не ТекущиеДанные = Неопределено Тогда
		
		НовыеСообщения = ПолучитьНовыеСообщенияДляИнтерфейса(ТекущиеДанные.Чат, ТекущаяВременнаяМетка);
		
		Для Каждого Сообщение Из НовыеСообщения Цикл
			
			ДобавитьСообщениеВИнтерфейс(Сообщение);
			
			ТекущаяВременнаяМетка = Макс(ТекущаяВременнаяМетка, Сообщение.ВременнаяМетка);
			Если ПерваяВременнаяМетка = 0 Тогда
				ПерваяВременнаяМетка = ТекущаяВременнаяМетка;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
	
	КоличествоМинутПослеОчисткиКэша = iga_ОбщегоНазначенияКлиентСервер.РазностьДат(ДатаОчисткиКэша, ТекущаяДата(), "МИНУТА");
	
	Если КоличествоМинутПослеОчисткиКэша > 30 Тогда
		ПочиститьКэшКонтента()
	КонецЕсли;
	
	Если СчетчикСекунд >= 60 Тогда
		СчетчикСекунд = 0;
	КонецЕсли;
	
	Если ВключеноОповещениеОбОтмененных() Тогда
		Если Не ЕстьОповещение И Не ТекущаяСтраницаЧатов = СтраницаЗаписи() И (Не ЗначениеЗаполнено(ДатаОповещенияОбОтмене) 
			Или ТекущаяДата() > ДатаОповещенияОбОтмене) Тогда           
			Если ЕстьОтмененныеБрони(ТекущийОператор) Тогда
				ЕстьОповещение = Истина;
				ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеОповещенияОбОтмене", ЭтаФорма);
				СписокКнопок = Новый СписокЗначений;
				СписокКнопок.Добавить(0, "Напомнить позже");
				СписокКнопок.Добавить(1, "Взять в работу");
				ПоказатьВопрос(ОписаниеОповещения, "Есть отмененные записи!", СписокКнопок,, 0);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеОповещенияОбОтмене(Ответ, ДопПараметры) Экспорт
	
	Если Не Ответ = 1 Тогда
		ЕстьОповещение = Ложь;
		ДатаОповещенияОбОтмене = iga_ОбщегоНазначенияКлиентСервер.ДобавитьКДате(ТекущаяДата(),
			"МИНУТА", 10);
		
		Возврат;
	КонецЕсли;
	
	Элементы.СтраницыСпискиЧатов.ТекущаяСтраница = Элементы.СтраницаЗаписиЧатов;
	ТекущаяСтраницаЧатов = СтраницаЗаписи();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВИнтерфейс(Сообщение, История = Ложь)
	
    ТекстЦитаты = "";
    АвторЦитаты = "";
    
	Если ЗначениеЗаполнено(Сообщение.IDЦитируемогоСообщения) Тогда
        ДанныеЦитаты = КэшСообщений.Получить(Сообщение.IDЦитируемогоСообщения);
        Если ДанныеЦитаты <> Неопределено Тогда
            ТекстЦитаты = ДанныеЦитаты.Текст;
            АвторЦитаты = ДанныеЦитаты.Автор;
        КонецЕсли;
    КонецЕсли;
    
    ДанныеТекущего = Новый Структура("ID, Текст, Автор", Сообщение.IDСообщения, Сообщение.Текст, ?(Сообщение.ЭтоВходящее, "Клиент", "Вы"));
    КэшСообщений.Вставить(Сообщение.IDСообщения, ДанныеТекущего);
	
	
	ТекстСообщения = Сообщение.Текст;
    ПараметрыJS = Новый Структура;
    ПараметрыJS.Вставить("id",           Сообщение.IDСообщения);
    ПараметрыJS.Вставить("isIncoming",   Сообщение.ЭтоВходящее);
    ПараметрыJS.Вставить("time",         Формат(Сообщение.Дата, "ДЛФ=DT"));
    ПараметрыJS.Вставить("quoteText",    ТекстЦитаты);
	ПараметрыJS.Вставить("quoteAuthor",  АвторЦитаты);
	ПараметрыJS.Вставить("operatorName", Сообщение.ОператорИмя);
	Если Сообщение.Свойство("ЕстьФайл") И Сообщение.ЕстьФайл Тогда
		ПараметрыJS.Вставить("hasFile",      Сообщение.ЕстьФайл);
		ПараметрыJS.Вставить("fileStatus",   Строка(Сообщение.Статус));
		ПараметрыJS.Вставить("fileName",     Сообщение.ИмяФайла);
		ПараметрыJS.Вставить("fileSize",     Сообщение.РазмерФайла);
		ПараметрыJS.Вставить("thumbnail",    Сообщение.КартинкаФайла);
		КлассИконки = "icon-save";
		Если Сообщение.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Картинка") Тогда
			КлассИконки = "icon-zoom";
			ТекстСообщения = ?(ТекстСообщения = "", "Изображение", ТекстСообщения);
		ИначеЕсли Сообщение.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Видео") 
			ИЛИ Сообщение.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Аудио") Тогда
			КлассИконки = "icon-play";
			Если Сообщение.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Видео") Тогда 
				ТекстСообщения = ?(ТекстСообщения = "", "Видеозапись", ТекстСообщения);
			Иначе
				ТекстСообщения = ?(ТекстСообщения = "", "Аудиозапись", ТекстСообщения);
			КонецЕсли;
		Иначе
			ТекстСообщения = ?(ТекстСообщения = "", "Документ", ТекстСообщения);
		КонецЕсли;
		ПараметрыJS.Вставить("iconClass",    КлассИконки);
	Иначе
		ПараметрыJS.Вставить("hasFile",      Ложь);
	КонецЕсли;
    ПараметрыJS.Вставить("text",         ТекстСообщения);
    
    СтрJSON = ЗаписатьЗначениеJSON(ПараметрыJS);
    
    ДокументHTML = Элементы.ТекстДиалогаHTML.Документ;
	Если ДокументHTML <> Неопределено Тогда
		Если История Тогда
			ДокументHTML.defaultView.appendMessage(СтрJSON, Истина);
		Иначе
			ДокументHTML.defaultView.appendMessage(СтрJSON);
		КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПрочитатьСообщенияНаСервере(ЧатСсылка, КэшСообщений, ИДЧата, АктивныйЧат)
	
	ЕстьНепрочитанные = Ложь;
	Для Каждого ДанныеСообщения Из КэшСообщений Цикл
		Если Не ДанныеСообщения.Значение.ПрочитаноОператором Тогда
			ЕстьНепрочитанные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьНепрочитанные Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	               |ГДЕ
	               |	iga_ИсторияСообщений.Чат = &Чат
	               |	И iga_ИсторияСообщений.IDСообщения В(&IDСообщений)";
	Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	IDСообщений = Новый Массив;
	Для Каждого ДанныеСообщения Из КэшСообщений Цикл
		Если Не ДанныеСообщения.Значение.ПрочитаноОператором Тогда
			IDСообщений.Добавить(ДанныеСообщения.Значение.IDСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("IDСообщений", IDСообщений);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.iga_ИсторияСообщений.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.ПрочитаноОператором = Истина;
		Запись.Записать();
	КонецЦикла;
	
	Если АктивныйЧат Тогда
		Бот = Обработки.iga_ChatBot.Создать();
		Бот.ИнициализацияОсновныхПараметров();
		Бот.ОтметитьЧатПрочитанным(ИДЧата);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНовыеСообщенияДляИнтерфейса(ЧатСсылка, ТекущаяВременнаяМетка)
    СписокНовых = Новый Массив;
    
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |	История.Текст КАК Текст,
                   |	История.ДатаСообщения КАК Дата,
                   |	История.ЭтоВходящее КАК ЭтоВходящее,
                   |	ЕСТЬNULL(История.Оператор.Наименование, """") КАК ОператорИмя,
                   |	История.ТекстЦитирования КАК ТекстЦитирования,
                   |	История.АвторЦитирования КАК АвторЦитирования,
                   |	История.IDСообщения КАК IDСообщения,
                   |	История.IDЦитируемогоСообщения КАК IDЦитируемогоСообщения,
                   |	История.ВременнаяМетка КАК ВременнаяМетка,
                   |	История.ЕстьФайл КАК ЕстьФайл,
                   |	iga_ПрикрепленныеФайлы.ДанныеФайла КАК ДанныеФайла,
                   |	iga_ПрикрепленныеФайлы.ПутьКФайлу КАК ПутьКФайлу,
                   |	iga_ПрикрепленныеФайлы.ТипМедиа КАК ТипМедиа,
                   |	iga_ПрикрепленныеФайлы.Статус КАК Статус,
                   |	iga_ПрикрепленныеФайлы.ТекстОшибки КАК ТекстОшибки,
                   |	iga_ПрикрепленныеФайлы.URLЗагрузки КАК URLЗагрузки,
                   |	iga_ПрикрепленныеФайлы.КартинкаФайла КАК КартинкаФайла,
                   |	iga_ПрикрепленныеФайлы.РазмерФайла КАК РазмерФайла,
                   |	iga_ПрикрепленныеФайлы.ИмяФайла КАК ИмяФайла
                   |ИЗ
                   |	РегистрСведений.iga_ИсторияСообщений КАК История
                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПрикрепленныеФайлы КАК iga_ПрикрепленныеФайлы
                   |		ПО История.IDСообщения = iga_ПрикрепленныеФайлы.IDСообщения
                   |ГДЕ
                   |	История.Чат = &Чат
                   |	И История.ВременнаяМетка > &ТекущаяВременнаяМетка
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |	ВременнаяМетка";
    Запрос.УстановитьПараметр("ТекущаяВременнаяМетка", ТекущаяВременнаяМетка);
    Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл
        Стр = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Стр.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
        СписокНовых.Добавить(Стр);
    КонецЦикла;
    
    Возврат СписокНовых;
КонецФункции


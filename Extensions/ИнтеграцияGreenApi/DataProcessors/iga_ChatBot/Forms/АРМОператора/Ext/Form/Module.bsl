КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьHTMLДиалогаНаСервере(ЧатСсылка, КэшКонтента, УникальныйИдентификаторФормы)
    Возврат iga_РаспределениеСервер.СформироватьHTMLДиалога(ЧатСсылка, КэшКонтента, УникальныйИдентификаторФормы);
КонецФункции

&НаКлиенте
Процедура ОбновитьОкноДиалога()
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	ПерваяВременнаяМетка = 0;
	
	Если ТекущиеДанные <> Неопределено Тогда
        Результат = СформироватьHTMLДиалогаНаСервере(ТекущиеДанные.Чат, КэшКонтента, УникальныйИдентификатор);
        ТекстДиалогаHTML = Результат.HTML;
        ТекущаяВременнаяМетка = Макс(ТекущаяВременнаяМетка, Результат.ТекущаяВременнаяМетка);
		
		Элементы.ТекстДиалогаHTML.Документ.defaultView.clearMessages();
		
		
		ВывестиСообщенияПриОткрытии(Результат.МассивДанных);
		

		
        КэшСообщений = Новый Соответствие;
		Для Каждого СтрИзМассива Из Результат.МассивДанных Цикл
			Если ПерваяВременнаяМетка = 0 Тогда
				ПерваяВременнаяМетка = СтрИзМассива.ВременнаяМетка;
			КонецЕсли;
            КэшСообщений.Вставить(СтрИзМассива.IDСообщения, СтрИзМассива);
			Если ЗначениеЗаполнено(СтрИзМассива.IDЦитируемогоСообщения) Тогда
				СтруктураЦитируемогоСообщения = iga_ОбщегоНазначенияКлиентСервер.СкопироватьПоляСтруктуры(СтрИзМассива);
				СтруктураЦитируемогоСообщения.Текст = СтрИзМассива.ТекстЦитирования;
				СтруктураЦитируемогоСообщения.Автор = СтрИзМассива.АвторЦитирования;
				СтруктураЦитируемогоСообщения.ПрочитаноОператором = СтрИзМассива.ПрочитаноОператором;
				КэшСообщений.Вставить(СтрИзМассива.IDЦитируемогоСообщения, СтруктураЦитируемогоСообщения);
			КонецЕсли;
        КонецЦикла;
		
		ОтправкаДоступна = Элементы.Отправить.Доступность;
		
        ПрочитатьСообщенияНаСервере(ТекущиеДанные.Чат, КэшСообщений, ТекущиеДанные.ИДЧата, ОтправкаДоступна);
	Иначе
		
		Элементы.ТекстДиалогаHTML.Документ.defaultView.clearMessages();
	
	КонецЕсли;
	
	ЦитируемоеСообщениеИд = "";
	
	Элементы.ТекстДиалогаHTML.Документ.defaultView.scrollEnd();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущийПользователь()
	
	Возврат Пользователи.ТекущийПользователь();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущиеНастройкиОператора(ТекущийОператор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_НастройкиОператоров.Оператор КАК Оператор,
	               |	iga_НастройкиОператоров.Статус КАК Статус,
	               |	iga_НастройкиОператоров.ПриниматьНовыеЧаты КАК ПриниматьНовыеЧаты,
	               |	iga_НастройкиОператоров.ПростойОператор КАК ПростойОператор
	               |ИЗ
	               |	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |ГДЕ
	               |	iga_НастройкиОператоров.Оператор = &Оператор";
	Запрос.УстановитьПараметр("Оператор", ТекущийОператор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураНастроек = Новый Структура("Статус, ПриниматьНовыеЧаты, ПростойОператор");
		ЗаполнитьЗначенияСвойств(СтруктураНастроек, Выборка);
		Возврат СтруктураНастроек;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УстановитьПараметрыОператора(Форма)
	
	СтруктураНастроек = ПолучитьТекущиеНастройкиОператора(Форма.ТекущийОператор);;
	
	Если СтруктураНастроек = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Форма.ОператорСписков = Форма.ТекущийОператор;

	Форма.ТекущийСтатусОператора = СтруктураНастроек.Статус;
	Форма.ПредыдущийСтатусОператора = СтруктураНастроек.Статус;
	Форма.ПриниматьНовыеЧаты = СтруктураНастроек.ПриниматьНовыеЧаты;
	
	Форма.СписокЧатов.Параметры.УстановитьЗначениеПараметра("ТекущийОператор", Форма.ТекущийОператор);
	Форма.СписокЧатовТребуютУточнения.Параметры.УстановитьЗначениеПараметра("ТекущийОператор", Форма.ТекущийОператор);
	Форма.СписокОжидающих.Параметры.УстановитьЗначениеПараметра("ТекущийОператор", Форма.ТекущийОператор);
	Форма.Элементы.ОператорСписков.Видимость = Не СтруктураНастроек.ПростойОператор;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийОператор = ТекущийПользователь();
	ПредыдущийОператор = ТекущийОператор;
	
	Отказ = Не УстановитьПараметрыОператора(ЭтаФорма);
	Если Отказ Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Данный пользователь не настроен для работы с АРМ оператора.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Не РольДоступна("iga_ПолныеПрава") Тогда
		Элементы.ТекущийОператор.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	СписокЧатов.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	
	ВремяАктивности = Константы.iga_ВремяМаксимальнойАктивностиЧата.Получить();
	СписокЧатов.Параметры.УстановитьЗначениеПараметра("ВремяАктивностиМин", ?(ЗначениеЗаполнено(ВремяАктивности), ВремяАктивности, 60));
	ВремяОжиданияСоединения = Константы.iga_ВремяОжиданияПодтвержденияСоединения.Получить();
	СписокЧатов.Параметры.УстановитьЗначениеПараметра("ВремяОжиданияСоединения", ?(ЗначениеЗаполнено(ВремяОжиданияСоединения), ВремяОжиданияСоединения, 10));
	СписокЧатовОтмененныхПереносовЗаписей.Параметры.УстановитьЗначениеПараметра("ТекущийОператор", ТекущийОператор);
	
	ДатаОчисткиКэша = ТекущаяДата();
	
	Если Не Константы.iga_ЧатБотИспользуется.Получить() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Чат бот не запущен. Проверьте запуск чат бота.";
		Сообщение.Сообщить();
	КонецЕсли;
	
	Если РольДоступна("iga_ОператорВацап") Тогда
		Элементы.ТекущийОператор.Видимость = Ложь;
	КонецЕсли;
	
	Если Не Константы.iga_ВключеноОповещениеОЗаписи.Получить() Тогда
		Элементы.СтраницаЗаписиЧатов.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьНаСервере(ТекущийЧат, ИдЧата, ТекстовоеСообщение, ТекущийОператор, КэшСообщений, ЦитируемоеСообщениеИд = "")

	Бот = Обработки.iga_ChatBot.Создать();
    Бот.ИнициализацияОсновныхПараметров();
    Результат = Бот.ОтправитьТекст(ИдЧата, ТекстовоеСообщение, ЦитируемоеСообщениеИд);
	
	РезультатСервера = Новый Структура("ТекущаяВременнаяМетка, IDСообщения");
	
	Если Результат <> Неопределено Тогда
		РезультатСервера.IDСообщения = Результат.idMessage;
		
		ТекстЦитирования = "";
		АвторЦитирования = "";
		Если Не ЦитируемоеСообщениеИд = "" Тогда
			ДанныеСообщения = КэшСообщений.Получить(ЦитируемоеСообщениеИд);
			ТекстЦитирования = ДанныеСообщения.Текст;
			АвторЦитирования = ДанныеСообщения.Автор;
		КонецЕсли;
		
		Попытка
			ДанныеСообщения = Бот.ПолучитьИнформациюОСообщении(ИдЧата, РезультатСервера.IDСообщения);
			ВременнаяМетка = ДанныеСообщения.timestamp;
		Исключение
			ВременнаяМетка = ПолучитьПоследнююВременнуюМетку(ТекущийЧат); 
		КонецПопытки;
		
		СтруктураСообщения = Новый Структура;
		СтруктураСообщения.Вставить("ЧатСсылка", ТекущийЧат);
		СтруктураСообщения.Вставить("ИДЧата", ИДЧата);
		СтруктураСообщения.Вставить("IDСообщения", Результат.idMessage);
		СтруктураСообщения.Вставить("Текст", ТекстовоеСообщение);
		СтруктураСообщения.Вставить("Тип", "textMessage");
		СтруктураСообщения.Вставить("ВходящееСообщение", Ложь);
		СтруктураСообщения.Вставить("IDЦитируемогоСобщения", ЦитируемоеСообщениеИд);
		СтруктураСообщения.Вставить("ТекстЦитирования", ТекстЦитирования);
		СтруктураСообщения.Вставить("АвторЦитирования", АвторЦитирования);
		СтруктураСообщения.Вставить("СсылкаОператор", ТекущийОператор);
		СтруктураСообщения.Вставить("Прочитано", Истина);
		
        РезультатСервера.ТекущаяВременнаяМетка = Бот.ЗаписатьВИсторию(СтруктураСообщения);
	КонецЕсли;
	
	Возврат РезультатСервера;
КонецФункции

&НаКлиенте
Процедура Обработчик_ПослеОтправкиФайла(Результат, ДопПараметры) Экспорт
	
	Если Результат = Истина Тогда
		ОбновитьОкноДиалога();
		ПутьКПрикрепленномуФайлу = "";
		Элементы.ОткрепитьФайл.Видимость = Ложь;
		ТекстовоеСообщение = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщениеСПрикрепленнымФайлом(ИдЧата)
	
	ПараметрыОткрытия = Новый Структура("ПутьКФайлу, ИмяФайла, Расширение, Сообщение", 
		ПутьКПрикрепленномуФайлу, ИмяПрикрепляемогоФайла, РасширениеПрикрепляемогоФайла, ТекстовоеСообщение);
		
	ПараметрыОткрытия.Вставить("ИдЧата", ИдЧата);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеОтправкиФайла", ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.iga_ФормаДлительнойОперации", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	
	ПолеОтправкиСообщения = Элементы.ТекстовоеСообщение.Документ;
	Если ПолеОтправкиСообщения <> Неопределено Тогда
		ТекстовоеСообщение = ПолеОтправкиСообщения.defaultView.getText();
	Иначе
		Возврат;
	КонецЕсли;
	
	ТекстовоеСообщение = СокрЛП(ТекстовоеСообщение);
	
	Если ПустаяСтрока(ТекстовоеСообщение) И ПутьКПрикрепленномуФайлу = "" Тогда 
		Возврат; 
	КонецЕсли;
	
    
	ТекущиеДанные = ПолучитьТекущиеДанные();

	ДатаОтправки = ТекущаяДата();
	
	ДатаПоследнегоСообщения = ПолучитьДатуПоследнегоСообщения(ТекущиеДанные.Чат);
	
	Если iga_ОбщегоНазначенияКлиентСервер.РазностьДат(ДатаПоследнегоСообщения, ДатаОтправки, "ЧАС") >= 24 Тогда
		ПоказатьПредупреждение(, "Прошло более чем 24 часа с момента последнего сообщений. Отправьте шаблон через ""Начать диалог""", 60, "ВНИМАНИЕ!");
		УстановитьДоступностьЭлементов();
		Возврат;
	КонецЕсли;
	
	Если ПутьКПрикрепленномуФайлу = "" Тогда
		
		РезультатСервера = ОтправитьНаСервере(ТекущиеДанные.Чат, ТекущиеДанные.ИдЧата, ТекстовоеСообщение, ТекущийОператор, КэшСообщений, ЦитируемоеСообщениеИд);
		ТекущаяВременнаяМетка = Макс(ТекущаяВременнаяМетка, РезультатСервера.ТекущаяВременнаяМетка);
		
	Иначе
		ОтправитьСообщениеСПрикрепленнымФайлом(ТекущиеДанные.ИдЧата);
		Возврат;
	КонецЕсли;
	
    ИмяОператора = Строка(ТекущийОператор); 
	
	Сообщение = Новый Структура;
	Сообщение.Вставить("IDСообщения",   РезультатСервера.IDСообщения);
	Сообщение.Вставить("Текст",         ТекстовоеСообщение);
	Сообщение.Вставить("ЭтоВходящее",   Ложь);
	Сообщение.Вставить("Дата",         	ТекущаяДата());
	Сообщение.Вставить("IDЦитируемогоСообщения",    ЦитируемоеСообщениеИд);
	Сообщение.Вставить("ОператорИмя",  	Строка(ТекущийОператор));
	
    ДобавитьСообщениеВИнтерфейс(Сообщение);
	
    ЦитируемоеСообщениеИд = "";
    
    ДокументHTML = Элементы.ТекстДиалогаHTML.Документ;
    Если ДокументHTML <> Неопределено Тогда
        ДокументHTML.defaultView.clearQuote();
    КонецЕсли;
	
    ТекстовоеСообщение = "";
	
	ПолеОтправкиСообщения.defaultView.setText("");
	
	Элементы.СписокЧатов.Обновить();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоследнююВременнуюМетку(ЧатСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	iga_ИсторияСообщений.IDСообщения КАК IDСообщения,
	               |	iga_ИсторияСообщений.ВременнаяМетка КАК ВременнаяМетка
	               |ИЗ
	               |	РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	               |ГДЕ
	               |	iga_ИсторияСообщений.Чат = &Чат
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВременнаяМетка УБЫВ,
	               |	iga_ИсторияСообщений.ВременнаяМетка УБЫВ";
	Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВременнаяМетка;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Асинх Процедура ПродлитьБронь(Команда)
	
	Если Не Ждать ПодтверждениеОперации("Продлить бронь") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СписокЧатов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	Результат = ПродлитьБроньНаСервере(ТекущиеДанные.Чат, ТекущийОператор);
	Если Результат Тогда
		Элементы.СписокЧатов.Обновить();
	Иначе
		ПоказатьПредупреждение(, "Продление невозможно (уже продлевалось или чат не в статусе подключения).");
	КонецЕсли;
	УстановитьДоступностьЭлементов();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПродлитьБроньНаСервере(ЧатСсылка, ТекущийОператор)
	Возврат iga_РаспределениеСервер.ПродлитьВремяОжидания(ЧатСсылка, ТекущийОператор);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекстШаблона(Идентификатор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ШаблоныСообщений.ТекстСообщения КАК ТекстСообщения
	               |ИЗ
	               |	Справочник.iga_ШаблоныСообщений КАК iga_ШаблоныСообщений
	               |ГДЕ
	               |	iga_ШаблоныСообщений.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ТекстСообщения;
	
КонецФункции

&НаСервереБезКонтекста
Функция НачатьДиалогНаСервере(ЧатСсылка, ТекущийСтатус, ТекущийОператор, ИДЧата, ПрошлоБолее24Часа, ИдентификаторШаблона, УточняющийЧат)
	
	НачатьТранзакцию();
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.iga_ОчередьРаспределения");
	ЭлементБлокировки.УстановитьЗначение("Чат", ЧатСсылка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаДанных.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	iga_ОчередьРаспределения.Чат КАК Чат,
	               |	iga_ОчередьРаспределения.Оператор КАК Оператор,
	               |	iga_ОчередьРаспределения.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |ГДЕ
	               |	(iga_ОчередьРаспределения.Статус = ЗНАЧЕНИЕ(Перечисление.iga_СтатусыОчереди.ЗапросСоединения)
	               |			ИЛИ iga_ОчередьРаспределения.Статус = ЗНАЧЕНИЕ(Перечисление.iga_СтатусыОчереди.ВРаботе)
	               |			ИЛИ iga_ОчередьРаспределения.Статус = ЗНАЧЕНИЕ(Перечисление.iga_СтатусыОчереди.ВнеОчереди))
	               |	И НЕ iga_ОчередьРаспределения.Оператор = &ТекущийОператор
	               |	И iga_ОчередьРаспределения.Чат = &ЧатСсылка";
	Запрос.УстановитьПараметр("ТекущийОператор", ТекущийОператор);
	Запрос.УстановитьПараметр("ЧатСсылка", ЧатСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	ЕстьСуществующиеЗапросы = Не РезультатЗапроса.Пустой();
	
	Если ЕстьСуществующиеЗапросы И Не УточняющийЧат Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Новый Структура("СтатусДругихОператоров", Выборка.Статус);
	КонецЕсли;
	
	РезультатИнфо = Новый Структура("IDСообщения, Текст, Дата, ТекущаяВременнаяМетка", "", "", ТекущаяДата(), 0);
	
	ДатаПоступления = ТекущаяДата();
	Если ТекущийСтатус = Перечисления.iga_СтатусыОчереди.Ожидание Тогда
		Менеджер = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		Менеджер.Чат = ЧатСсылка;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() Тогда
			ДатаПоступления = Менеджер.ДатаПоступления;
			Менеджер.Удалить();
		КонецЕсли;

	Иначе
		Менеджер = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		Менеджер.Чат = ЧатСсылка;
		Менеджер.Оператор = ТекущийОператор;
		Менеджер.Прочитать();
		ДатаПоступления = Менеджер.ДатаПоступления;
	КонецЕсли;
	
	БезОповещения = iga_МетодыРаботыСБотом.ПолучитьЗначениеПараметраОбщения(ЧатСсылка, "БезОповещения");
	
	Если ТекущийСтатус = Перечисления.iga_СтатусыОчереди.Подключение
		Или ТекущийСтатус = Перечисления.iga_СтатусыОчереди.Ожидание Тогда
		Если Не Менеджер.Выбран() Тогда
			Менеджер = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
			Менеджер.Чат = ЧатСсылка;
			Менеджер.Оператор = ТекущийОператор;
		КонецЕсли;
		Менеджер.Статус = Перечисления.iga_СтатусыОчереди.ВРаботе;
		Менеджер.ДатаПоступления = ДатаПоступления;
		Менеджер.ДатаПоследнейАктивности = ТекущаяДата();
		Менеджер.Записать();
		
		Если Не Менеджер.ОсобыйЧат И Не БезОповещения = Истина Тогда
			
			ПредставлениеОператора = ПолучитьПредставлениеОператора(ТекущийОператор);
			
			КодЯзыка = iga_МетодыРаботыСБотом.ПолучитьЗначениеПараметраОбщения(ЧатСсылка, "Язык");
			
			ТекстПриветствия = iga_ШаблоныСообщений.ПолучитьТекстСообщения(Перечисления.iga_ТипыТекстовСообщений.ТекстПриветствияОператора, КодЯзыка);
			
			Данные = Новый Структура("ИмяОператора", ПредставлениеОператора);
			ТекстПриветствия = iga_ОбщегоНазначенияКлиентСервер.СтрШаблонПоСтруктуре(ТекстПриветствия, Данные);
			
			РезультатИнфо = ОтправитьПростоеСообщение(ТекущийОператор, ЧатСсылка, ИДЧата, ТекстПриветствия);
		КонецЕсли;
		
		МенеджерПоследнийСтатус = РегистрыСведений.iga_ПоследниеСтатусыЧатов.СоздатьМенеджерЗаписи();
		МенеджерПоследнийСтатус.Чат = ЧатСсылка;
		МенеджерПоследнийСтатус.СтатусОчереди = Перечисления.iga_СтатусыОчереди.ВРаботе;
		МенеджерПоследнийСтатус.Записать();

	Иначе
		
		Если ПрошлоБолее24Часа Тогда
			
			Если Менеджер.Выбран() И Не УточняющийЧат Тогда
				
				Менеджер.Статус = Перечисления.iga_СтатусыОчереди.ВРаботе;
				Менеджер.Чат = ЧатСсылка;
				Менеджер.Оператор = ТекущийОператор;
				Менеджер.ДатаПоступления = ТекущаяДата();
				Менеджер.ДатаПоследнейАктивности = ТекущаяДата();
				Менеджер.Записать();
				
				МенеджерПоследнийСтатус = РегистрыСведений.iga_ПоследниеСтатусыЧатов.СоздатьМенеджерЗаписи();
				МенеджерПоследнийСтатус.Чат = ЧатСсылка;
				МенеджерПоследнийСтатус.СтатусОчереди = Перечисления.iga_СтатусыОчереди.ВРаботе;
				МенеджерПоследнийСтатус.Записать();
				
			ИначеЕсли Не УточняющийЧат Тогда
				
				Менеджер = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
				Менеджер.Чат = ЧатСсылка;
				Менеджер.Оператор = ТекущийОператор; 
				Менеджер.Статус = Перечисления.iga_СтатусыОчереди.ВРаботе;
				Менеджер.ДатаПоступления = ТекущаяДата();
				Менеджер.ДатаПоследнейАктивности = ТекущаяДата();
				Менеджер.Записать();
				
				МенеджерПоследнийСтатус = РегистрыСведений.iga_ПоследниеСтатусыЧатов.СоздатьМенеджерЗаписи();
				МенеджерПоследнийСтатус.Чат = ЧатСсылка;
				МенеджерПоследнийСтатус.СтатусОчереди = Перечисления.iga_СтатусыОчереди.ВРаботе;
				МенеджерПоследнийСтатус.Записать();
				
			КонецЕсли;
			
			РезультатИнфо = Справочники.iga_ШаблоныСообщений.ОтправитьСообщение(ЧатСсылка, ИДЧата, ИдентификаторШаблона);
			
		Иначе
			Менеджер.Статус = Перечисления.iga_СтатусыОчереди.ВРаботе;
			Менеджер.Чат = ЧатСсылка;
			Менеджер.Оператор = ТекущийОператор;
			Менеджер.ДатаПоступления = ТекущаяДата();
			Менеджер.ДатаПоследнейАктивности = ТекущаяДата();
			Менеджер.Записать();
			
			ЗаписьОжидания = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
			ЗаписьОжидания.Чат = ЧатСсылка;
			ЗаписьОжидания.Прочитать();
			Если ЗаписьОжидания.Выбран() Тогда
				ЗаписьОжидания.Удалить();
			КонецЕсли;
			
			МенеджерПоследнийСтатус = РегистрыСведений.iga_ПоследниеСтатусыЧатов.СоздатьМенеджерЗаписи();
			МенеджерПоследнийСтатус.Чат = ЧатСсылка;
			МенеджерПоследнийСтатус.СтатусОчереди = Перечисления.iga_СтатусыОчереди.ЗапросСоединения;
			МенеджерПоследнийСтатус.Записать();

		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ОчередьРаспределения.Чат КАК Чат,
	               |	iga_ОчередьРаспределения.Оператор КАК Оператор
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |ГДЕ
	               |	iga_ОчередьРаспределения.Чат = &Чат
	               |	И iga_ОчередьРаспределения.Оператор <> &Оператор
	               |	И iga_ОчередьРаспределения.Статус = ЗНАЧЕНИЕ(Перечисление.iga_СтатусыОчереди.Подключение)";
	Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	Запрос.УстановитьПараметр("Оператор", ТекущийОператор);
	ВыборкаПодключений = Запрос.Выполнить().Выбрать();
	Пока ВыборкаПодключений.Следующий() Цикл
		ЗаписьПодключения = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		ЗаписьПодключения.Чат = ЧатСсылка;
		ЗаписьПодключения.Оператор = ВыборкаПодключений.Оператор;
		ЗаписьПодключения.Прочитать();
		Если ЗаписьПодключения.Выбран() Тогда
			ЗаписьПодключения.Удалить();
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(РезультатИнфо) И Не РезультатИнфо.IDСообщения = "" Тогда
		iga_МетодыРаботыСБотом.УстановитьПараметрОбщения(ЧатСсылка, "БезОповещения", Истина);
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
    Возврат РезультатИнфо;
КонецФункции

&НаКлиенте
Процедура ИнициализироватьДобавлениеСообщения(ДанныеСообщения)
	
	Если ДанныеСообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяВременнаяМетка = Макс(ДанныеСообщения.ТекущаяВременнаяМетка, ТекущаяВременнаяМетка);
	
	ИмяОператора = Строка(ТекущийОператор);
	
	Если Не ДанныеСообщения.IDСообщения = "" Тогда
		Сообщение = Новый Структура;
		Сообщение.Вставить("IDСообщения",   ДанныеСообщения.IDСообщения);
		Сообщение.Вставить("Текст",         ДанныеСообщения.Текст);
		Сообщение.Вставить("ЭтоВходящее",   Ложь);
		Сообщение.Вставить("Дата",         	ДанныеСообщения.Дата);
		Сообщение.Вставить("IDЦитируемогоСообщения",    "");
		Сообщение.Вставить("ОператорИмя",  	ИмяОператора);
		
		ДобавитьСообщениеВИнтерфейс(Сообщение);
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьНачалоДиалога(ЧатСсылка, Статус, ИДЧата, ПрошлоБолее24Часа, ИдентификаторШаблона)
	
	УточняющийЧат = Элементы.СтраницыСпискиЧатов.ТекущаяСтраница = Элементы.СтраницаУточняющиеЧаты;
	
	ДанныеСообщения = НачатьДиалогНаСервере(ЧатСсылка, Статус, ТекущийОператор, ИДЧата, ПрошлоБолее24Часа, ИдентификаторШаблона, УточняющийЧат);
	
	Элементы.СписокЧатов.Обновить();
	
	Если ДанныеСообщения = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось отправить шаблонное сообщение!";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если ДанныеСообщения.Свойство("СтатусДругихОператоров") Тогда
		
		ТекстПредупреждения = "";
		
		Если ДанныеСообщения.СтатусДругихОператоров = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.ЗапросСоединения") Тогда
			ТекстПредупреждения = "В данный момент уже подан запрос соединения другим оператором.";
		ИначеЕсли ДанныеСообщения.СтатусДругихОператоров = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.ВнеОчереди") Тогда
			ТекстПредупреждения = "Чат находится в статусе уточнения!";
		ИначеЕсли ДанныеСообщения.СтатусДругихОператоров = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.ВРаботе") Тогда
			ТекстПредупреждения = "Данный пользователь уже в работе с другим оператором.";
		ИначеЕсли ДанныеСообщения.СтатусДругихОператоров = ПредопределенноеЗначение("Перечисление.iga_СтатусыОчереди.Подключение") Тогда
			ТекстПредупреждения = "Для данного пользователя уже подобран оператор, ожидание принятия заявки оператором.";
		КонецЕсли;
		ПоказатьПредупреждение(, "Не удалось начать диалог. " + ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
    ИнициализироватьДобавлениеСообщения(ДанныеСообщения);
	
	Если Не ТекущаяСтраницаЧатов = СтраницаУточнение() Тогда
		Элементы.СтраницыСпискиЧатов.ТекущаяСтраница = Элементы.СтраницаАктивныеОбщая;
		Элементы.СтраницыАктивные.ТекущаяСтраница = Элементы.СтраницаАктивныеЧаты;
		Элементы.СписокЧатов.ТекущаяСтрока = ЧатСсылка;
		ТекущаяСтраницаЧатов = СтраницаАктивные();
	КонецЕсли;

	УстановитьДоступностьЭлементов(); 
	
	ЗаполнитьКоличествоЧатов();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаШаблонногоСообщения(ДанныеОтправки, ИдентификаторШаблона)
	
	Возврат Справочники.iga_ШаблоныСообщений.ОтправитьСообщение(ДанныеОтправки.ЧатСсылка, ДанныеОтправки.ИДЧата, ИдентификаторШаблона);
	
КонецФункции

&НаКлиенте
Процедура Обработчик_ПослеВыбораШаблона(ИдентификаторШаблона, ДопПараметры) Экспорт
	
	Если ИдентификаторШаблона = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопПараметры.ПростаяОтправкаШаблона Тогда
		
		ДанныеСообщения = ОтправкаШаблонногоСообщения(ДопПараметры, ИдентификаторШаблона);
		
		ИнициализироватьДобавлениеСообщения(ДанныеСообщения);

	Иначе
		ПродолжитьНачалоДиалога(ДопПараметры.ЧатСсылка, ДопПараметры.Статус, ДопПараметры.ИДЧата, ДопПараметры.ПрошлоБолее24Часа, ИдентификаторШаблона);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокШаблоновСообщений(Оператор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ШаблоныСообщенийПодразделения.Ссылка.Наименование КАК Наименование,
	               |	iga_ШаблоныСообщенийПодразделения.Ссылка.Идентификатор КАК Идентификатор
	               |ИЗ
	               |	Справочник.iga_ШаблоныСообщений.Подразделения КАК iga_ШаблоныСообщенийПодразделения
	               |ГДЕ
	               |	iga_ШаблоныСообщенийПодразделения.Ссылка.ДоступенДляВыбора
	               |	И НЕ iga_ШаблоныСообщенийПодразделения.Ссылка.ПометкаУдаления
	               |	И (iga_ШаблоныСообщенийПодразделения.Подразделение В
	               |				(ВЫБРАТЬ
	               |					iga_НастройкиОператоров.Подразделение КАК Подразделение
	               |				ИЗ
	               |					РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |				ГДЕ
	               |					iga_НастройкиОператоров.Оператор = &Оператор)
	               |			ИЛИ iga_ШаблоныСообщенийПодразделения.Подразделение = ЗНАЧЕНИЕ(Справочник.iga_ПодразделенияОператоров.КоллЦентр)
				   |			ИЛИ iga_ШаблоныСообщенийПодразделения.Подразделение = ЗНАЧЕНИЕ(Справочник.iga_ПодразделенияОператоров.ПустаяСсылка))";
	Запрос.УстановитьПараметр("Оператор", Оператор);
	Выборка = Запрос.Выполнить().Выбрать();
	СписокВыбора = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.Идентификатор, Выборка.Наименование);
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеДляОбработкиЧатовЧерез24Часа(ТекущийОператор, ТребуетсяВыборПодразделения)
	
	СписокШаблонов = ПолучитьСписокШаблоновСообщений(ТекущийОператор);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ПодразделенияОператоров.Ссылка КАК Ссылка,
	               |	iga_ПодразделенияОператоров.Наименование КАК Наименование
	               |ИЗ
	               |	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров,
	               |	Справочник.iga_ПодразделенияОператоров КАК iga_ПодразделенияОператоров
	               |ГДЕ
	               |	iga_НастройкиОператоров.Оператор = &Оператор
	               |	И (НЕ iga_НастройкиОператоров.ПростойОператор
	               |			ИЛИ iga_НастройкиОператоров.Подразделение = ЗНАЧЕНИЕ(Справочник.iga_ПОдразделенияОператоров.КоллЦентр) 
				   |			ИЛИ &ТребуетсяВыборПодразделения)
	               |	И НЕ iga_ПодразделенияОператоров.ПометкаУдаления
	               |	И iga_ПодразделенияОператоров.Активное";
	Запрос.УстановитьПараметр("Оператор", ТекущийОператор);
	Запрос.УстановитьПараметр("ТребуетсяВыборПодразделения", ТребуетсяВыборПодразделения);
	Выборка = Запрос.Выполнить().Выбрать();
	СписокПодразделений = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		СписокПодразделений.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("СписокШаблонов", СписокШаблонов);
	СтруктураДанных.Вставить("СписокПодразделений", СписокПодразделений);
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьВыборШаблонногоСообщения(СтруктураДанных, ЧатСсылка, ТекущиеДанные, ПрошлоБолее24Часа, ВыбПодразделение, ПростаяОтправкаШаблона = Ложь)
	
	СписокШаблонов = СтруктураДанных.СписокШаблонов;
	
	Если СписокШаблонов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет доступных шаблонов инициации диалога!");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗакрытия = Новый Структура("ЧатСсылка, Статус, ИДЧата, ПрошлоБолее24Часа, ПростаяОтправкаШаблона", 
		ЧатСсылка, ТекущиеДанные.Статус, ТекущиеДанные.ИДЧата, ПрошлоБолее24Часа, ПростаяОтправкаШаблона);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеВыбораШаблона", ЭтаФорма, ПараметрыЗакрытия);
	
	ПараметрыОткрытия = Новый Структура("Оператор, ВыбПодразделение", ТекущийОператор, ВыбПодразделение);
	
	ОткрытьФорму("ОбщаяФорма.iga_ФормаВыбораШаблонногоСообщения", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьПодразделениеЧата(ЧатСсылка, Подразделение)
	
	iga_МетодыРаботыСБотом.УстановитьПараметрОбщения(ЧатСсылка, "ВыбранноеПодразделение", Подразделение);
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеВыбораПодразделения(ВыбПодразделение, ДопПараметры) Экспорт
	
	Если ВыбПодразделение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПодразделениеЧата(ДопПараметры.ЧатСсылка, ВыбПодразделение);
	
	ОткрытьВыборШаблонногоСообщения(ДопПараметры.СтруктураДанных, ДопПараметры.ЧатСсылка, 
		ДопПараметры.ТекущиеДанные, ДопПараметры.ПрошлоБолее24Часа, ВыбПодразделение)
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТребуетсяВыборПодразделения(ЧатСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_Чаты.Ссылка КАК Ссылка,
	               |	iga_ПараметрыОбщенияСБотом.Значение КАК Значение
	               |ИЗ
	               |	Справочник.iga_Чаты КАК iga_Чаты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.iga_ПараметрыОбщения КАК iga_ПараметрыОбщения
	               |		ПО (iga_ПараметрыОбщения.ИмяПараметра = ""ВыбранноеПодразделение"")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПараметрыОбщенияСБотом КАК iga_ПараметрыОбщенияСБотом
	               |		ПО (iga_ПараметрыОбщенияСБотом.Чат = iga_Чаты.Ссылка
	               |				И iga_ПараметрыОбщения.Ссылка = iga_ПараметрыОбщенияСБотом.Параметр)
	               |ГДЕ
	               |	iga_Чаты.Ссылка = &ЧатСсылка
	               |	И НЕ iga_ПараметрыОбщенияСБотом.Значение ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ЧатСсылка", ЧатСсылка);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

&НаКлиенте
Процедура ИнициализацияВыбораПосле24Часа(ТекущиеДанные, ЧатСсылка, ПростаяОтправкаШаблона = Ложь)
	
	ТребуетсяВыборПодразделения = ТребуетсяВыборПодразделения(ЧатСсылка);
	
	СтруктураДанных = ПолучитьДанныеДляОбработкиЧатовЧерез24Часа(ТекущийОператор, ТребуетсяВыборПодразделения);
	
	СписокПодразделений = СтруктураДанных.СписокПодразделений;

	Если Не СписокПодразделений.Количество() = 0 Тогда
		
		
		ПараметрыЗакрытия = Новый Структура("СтруктураДанных, ЧатСсылка, ТекущиеДанные, ПрошлоБолее24Часа", 
			СтруктураДанных, ЧатСсылка, ТекущиеДанные, Истина);
			
		ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеВыбораПодразделения", ЭтаФорма, ПараметрыЗакрытия);
		ПараметрыОткрытия = Новый Структура("Отбор", Новый Структура("ПометкаУдаления, Активное", Ложь, Истина));
		ОткрытьФорму("Справочник.iga_ПодразделенияОператоров.ФормаВыбора", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор,,, 
			ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
	КонецЕсли;
	
	
	
	ОткрытьВыборШаблонногоСообщения(СтруктураДанных, ЧатСсылка, ТекущиеДанные, Истина, Неопределено, ПростаяОтправкаШаблона);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущийСтатусЧата(ЧатСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ОчередьРаспределения.Чат КАК Чат,
	               |	iga_ОчередьРаспределения.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |ГДЕ
	               |	iga_ОчередьРаспределения.Статус <> &СтатусЗавершен
	               |	И iga_ОчередьРаспределения.Чат = &ЧатСсылка";
	Запрос.УстановитьПараметр("ЧатСсылка", ЧатСсылка);
	Запрос.УстановитьПараметр("СтатусЗавершен", Перечисления.iga_СтатусыОчереди.Завершен);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус;
	Иначе
		Возврат Перечисления.iga_СтатусыОчереди.Завершен;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Асинх Процедура НачатьДиалог(Команда)

	Если Не Ждать ПодтверждениеОперации("Начать диалог") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли; 
	
	ЧатСсылка = ТекущиеДанные.Чат;
	
	
	ДатаПоследнегоСообщения = ПолучитьДатуПоследнегоСообщения(ЧатСсылка);
	
	ПрошлоБолее24Часа = iga_ОбщегоНазначенияКлиентСервер.РазностьДат(ДатаПоследнегоСообщения, ТекущаяДата(), "ЧАС") > 24;
	
	
	Если ТекущаяСтраницаЧатов = СтраницаАктивные() Тогда
		ПрошлоБолее24Часа = ПрошлоБолее24Часа И Не ТекущиеДанные.ОсобыйЧат;
	КонецЕсли;
	
	Если ПрошлоБолее24Часа Тогда
		
		ИнициализацияВыбораПосле24Часа(ТекущиеДанные, ЧатСсылка);
		
		Возврат;
	Иначе
		ИдентификаторШаблона = Неопределено;
	КонецЕсли;
	
	ТекущийСтатус = ПолучитьТекущийСтатусЧата(ЧатСсылка);
	
	ПродолжитьНачалоДиалога(ЧатСсылка, ТекущийСтатус, ТекущиеДанные.ИДЧата, ПрошлоБолее24Часа, ИдентификаторШаблона);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗавершитьДиалогНаСервере(ЧатСсылка, ТекущийОператор, ИДЧата, ВыбраныйРежимЗавершение)

    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ОчередьРаспределения.Чат КАК Чат,
	               |	iga_ОчередьРаспределения.Оператор КАК Оператор,
	               |	iga_ОчередьРаспределения.Статус КАК Статус,
	               |	iga_ОчередьРаспределения.ДатаПоступления КАК ДатаПоступления,
	               |	iga_ОчередьРаспределения.ДатаКонцаБронирования КАК ДатаКонцаБронирования,
	               |	iga_ОчередьРаспределения.ВремяПродлено КАК ВремяПродлено,
	               |	iga_ОчередьРаспределения.ДатаПоследнейАктивности КАК ДатаПоследнейАктивности,
	               |	iga_ОчередьРаспределения.БезОповещения КАК БезОповещения,
	               |	iga_ОчередьРаспределения.ПоследнимПисалОператор КАК ПоследнимПисалОператор,
	               |	iga_ОчередьРаспределения.ОсобыйЧат КАК ОсобыйЧат
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |ГДЕ
	               |	(iga_ОчередьРаспределения.Оператор = &Оператор
	               |			ИЛИ iga_ОчередьРаспределения.Оператор = &ПустойОператор
	               |				И iga_ОчередьРаспределения.Статус = &СтатусВнеОчереди)
	               |	И iga_ОчередьРаспределения.Чат = &ЧатСсылка";
	Запрос.УстановитьПараметр("ЧатСсылка", ЧатСсылка);
	Запрос.УстановитьПараметр("Оператор", ТекущийОператор);
	Запрос.УстановитьПараметр("ПустойОператор", Справочники.Пользователи.ПустаяСсылка());
	Запрос.УстановитьПараметр("СтатусВнеОчереди", Перечисления.iga_СтатусыОчереди.ВнеОчереди);
	Выборка = Запрос.Выполнить().Выбрать();
    
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.Оператор.Пустая() Тогда
			МенеджерОчереди = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерОчереди, Выборка);
			МенеджерОчереди.Статус = Перечисления.iga_СтатусыОчереди.Завершен;
			МенеджерОчереди.БезОповещения = Ложь;
			МенеджерОчереди.Записать();   
		Иначе
			МенеджерОчереди = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
			МенеджерОчереди.Чат = ЧатСсылка;
			МенеджерОчереди.Удалить();   
		КонецЕсли;
	КонецЦикла;
	
	Менеджер = РегистрыСведений.iga_ПоследниеСтатусыЧатов.СоздатьМенеджерЗаписи();
	Менеджер.Чат = ЧатСсылка;                                         
	
	Если ВыбраныйРежимЗавершение = "Завершить" Или ВыбраныйРежимЗавершение = "БезОтвета" Тогда
		Менеджер.СтатусОчереди = Перечисления.iga_СтатусыОчереди.Завершен;
	Иначе
		Менеджер.СтатусОчереди = Перечисления.iga_СтатусыОчереди.ВнеОчереди;
	КонецЕсли;
	Менеджер.Записать();
	
	Если ВыбраныйРежимЗавершение = "Завершить" Тогда 
		iga_МетодыРаботыСБотом.УстановитьПараметрОбщения(ЧатСсылка, "БезОповещения", Ложь);
	Иначе
		iga_МетодыРаботыСБотом.УстановитьПараметрОбщения(ЧатСсылка, "БезОповещения", Истина);
	КонецЕсли;
	
	Если ВыбраныйРежимЗавершение = "БезОтвета" Тогда
		iga_РаспределениеСервер.ЗафиксироватьОтказОператора(ЧатСсылка, ТекущийОператор, Справочники.iga_ПричиныОтклоненияОжидающихЧатов.НетОтвета, 
			"Нет ответа от пользователя");
	КонецЕсли;
	
	СтруктураВозврата = Неопределено;

	Если ВыбраныйРежимЗавершение = "ТребуетсяУточнение" Тогда
		
		МенеджерОчереди = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		МенеджерОчереди.Чат = ЧатСсылка;
		МенеджерОчереди.Оператор = Неопределено;
		МенеджерОчереди.Статус = Перечисления.iga_СтатусыОчереди.ВнеОчереди;
		МенеджерОчереди.БезОповещения = Ложь;
		МенеджерОчереди.ДатаПоступления = ТекущаяДата();
		МенеджерОчереди.ДатаПоследнейАктивности = ТекущаяДата();
		МенеджерОчереди.Записать(); 
		
	ИначеЕсли Не ВыбраныйРежимЗавершение = "БезОтвета" Тогда 
		
		КодЯзыка = iga_МетодыРаботыСБотом.ПолучитьЗначениеПараметраОбщения(ЧатСсылка, "Язык");
		
		ТекстПрощания = iga_ШаблоныСообщений.ПолучитьТекстСообщения(Перечисления.iga_ТипыТекстовСообщений.ТекстПослеЗавершенияДиалогаОператором, КодЯзыка);
		
		СтруктураВозврата = ОтправитьПростоеСообщение(ТекущийОператор, ЧатСсылка, ИДЧата, ТекстПрощания);
		
	КонецЕсли;
	
    Возврат СтруктураВозврата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверкаНаОтработкуНеподтвержденныхЗаявок(Чат)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_Чаты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.iga_Чаты КАК iga_Чаты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
	               |		ПО iga_Чаты.Клиент = iga_СтатусыПодтвержденияСтрокЗаявок.Заявка.Клиент
	               |ГДЕ
	               |	iga_Чаты.Ссылка = &Ссылка
	               |	И НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Обработано
	               |	И НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Статус = &СтатусПодтверждено
	               |			И НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Статус = &СтатусПусто";
	Запрос.УстановитьПараметр("Ссылка", Чат);
	Запрос.УстановитьПараметр("СтатусПодтверждено", Перечисления.iga_СтатусыПодтвержденияЗаявок.Подтверждено);
	Запрос.УстановитьПараметр("СтатусПусто", Перечисления.iga_СтатусыПодтвержденияЗаявок.ПустаяСсылка());
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаКлиенте
Асинх Процедура ПродолжитьЗавершитьДиалог(ВыбЗначение)
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ДанныеСообщения = ЗавершитьДиалогНаСервере(ТекущиеДанные.Чат, ТекущийОператор, ТекущиеДанные.ИДЧата, ВыбЗначение.Значение);
	
	Если Не ДанныеСообщения = Неопределено Тогда
		
		ТекущаяВременнаяМетка = Макс(ДанныеСообщения.ТекущаяВременнаяМетка, ТекущаяВременнаяМетка);
		
		ИмяОператора = Строка(ТекущийОператор);
		
		Сообщение = Новый Структура;
		Сообщение.Вставить("IDСообщения",   ДанныеСообщения.IDСообщения);
		Сообщение.Вставить("Текст",         ДанныеСообщения.Текст);
		Сообщение.Вставить("ЭтоВходящее",   Ложь);
		Сообщение.Вставить("Дата",         	ДанныеСообщения.Дата);
		Сообщение.Вставить("IDЦитируемогоСообщения",    "");
		Сообщение.Вставить("ОператорИмя",  	ИмяОператора);
		
		ДобавитьСообщениеВИнтерфейс(Сообщение); 
		
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();

	Если ТекущаяСтраницаЧатов = СтраницаАктивные() Тогда
		Элементы.СписокЧатов.Обновить();
	Иначе
		Элементы.СписокЧатовТребуютУточнения.Обновить();
	КонецЕсли;
	
	ЗаполнитьКоличествоЧатов();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗавершитьДиалог(Команда)
	
	Если ТекущаяСтраницаЧатов = СтраницаАктивные() Тогда
		СписокВыбораЗавершения = Новый СписокЗначений;
		СписокВыбораЗавершения.Добавить("Завершить", "Вопрос решен");
		СписокВыбораЗавершения.Добавить("БезОтвета", "Пациент не отвечает");
		СписокВыбораЗавершения.Добавить("ТребуетсяУточнение", "Требуется уточнение информации");
		
		ВыбЗначение = Ждать ВыбратьИзМеню(СписокВыбораЗавершения, Элементы.ЗавершитьДиалог);
		
		Если ВыбЗначение = Неопределено Тогда
			Возврат;
		КонецЕсли;
	Иначе
		ВыбЗначение = Новый Структура("Значение", "Завершить");
	КонецЕсли;
	
	Если ВыбЗначение.Значение = "ТребуетсяУточнение" Тогда
		ТекстПодсказки = "Перевести в уточняющие";
	ИНачеЕсли ВыбЗначение.Значение = "Завершить" Тогда
		ТекстПодсказки = "Завершить диалог";
	КонецЕсли;
	
	ЕстьНеотработанные = ПроверкаНаОтработкуНеподтвержденныхЗаявок(Элементы.СписокЧатов.ТекущиеДанные.Чат);
	
	Если ЕстьНеотработанные Тогда
		Ответ = Ждать ВопросАсинх("Есть неотработанные просроченные/отмененные/требующие перенос заявки. 
		|Продолжить завершение диалога?",
			РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет, ВыбЗначение.Значение, КодВозвратаДиалога.Нет);
			
		Если Не Ответ = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Не Ждать ПодтверждениеОперации(ТекстПодсказки) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВключеныСобытия() Тогда
		СоздатьНовоеСобытие(ВыбЗначение);
	ИНаче
		ПродолжитьЗавершитьДиалог(ВыбЗначение);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура Обработчик_ПослеЗакрытияСобытия(Результат, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ПолучитьИзВременногоХранилища(ДопПараметры.ХранилищеСсылки)) Тогда
		ПродолжитьЗавершитьДиалог(ДопПараметры.ВыбЗначение);
	Иначе
		ПоказатьПредупреждение(, "Событие не создано. Операция отменена.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовоеСобытие(ВыбЗначение)
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	ХранилищеСсылки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыОткрытия = Новый Структура("Основание", 
		Новый Структура("Клиент, СобытиеЧата, ХранилищеСсылки", 
		iga_ОбработкаДанныхПоЧатамСервер.ПолучитьКлиентаПоЧату(ТекущиеДанные.Чат), ,ХранилищеСсылки));
		
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеЗакрытияСобытия", ЭтаФорма, 
		Новый Структура("ХранилищеСсылки, ВыбЗначение", ХранилищеСсылки, ВыбЗначение));
		
	ОткрытьФорму("Документ.Событие.ФормаОбъекта", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеОператора(Оператор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА iga_НастройкиОператоров.ПредставлениеОператора = """"
	|			ТОГДА iga_НастройкиОператоров.Оператор.Наименование
	|		ИНАЧЕ iga_НастройкиОператоров.ПредставлениеОператора
	|	КОНЕЦ КАК ПредставлениеОператора
	|ИЗ
	|	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	|ГДЕ
	|	iga_НастройкиОператоров.Оператор = &Оператор";
	Запрос.УстановитьПараметр("Оператор", Оператор);
	ВыборкаПредставлениеОператора = Запрос.Выполнить().Выбрать();
	ВыборкаПредставлениеОператора.Следующий();

	Возврат ВыборкаПредставлениеОператора.ПредставлениеОператора;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДатуПоследнегоСообщения(ЧатСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ПоследниеСообщенияЧатов.Чат КАК Чат,
	               |	МАКСИМУМ(iga_ПоследниеСообщенияЧатов.ДатаСообщения) КАК ДатаСообщения
	               |ИЗ
	               |	РегистрСведений.iga_ПоследниеСообщенияЧатов КАК iga_ПоследниеСообщенияЧатов
	               |ГДЕ
	               |	iga_ПоследниеСообщенияЧатов.Чат = &Чат
	               |	И iga_ПоследниеСообщенияЧатов.ЭтоВходящее
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	iga_ПоследниеСообщенияЧатов.Чат";
	Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаСообщения;
	Иначе
		Возврат Дата(1,1,1);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьПростоеСообщение(ТекущийОператор, ЧатСсылка, ИдЧата, ТекстСообщения, Результат = Неопределено)
	
	Бот = Обработки.iga_ChatBot.Создать();
	
	Если Результат = Неопределено Тогда
		Бот.ИнициализацияОсновныхПараметров();
		
		Результат = Бот.ОтправитьТекст(ИдЧата, ТекстСообщения);
		
		Бот.ОтметитьЧатПрочитанным(ИДЧата);
	КонецЕсли;
	
	СтруктураСообщения = Новый Структура;
	СтруктураСообщения.Вставить("ЧатСсылка", ЧатСсылка);
	СтруктураСообщения.Вставить("ИДЧата", ИДЧата);
	СтруктураСообщения.Вставить("IDСообщения", Результат.idMessage);
	СтруктураСообщения.Вставить("Текст", ТекстСообщения);
	СтруктураСообщения.Вставить("Тип", "textMessage");
	СтруктураСообщения.Вставить("ВходящееСообщение", Ложь);
	СтруктураСообщения.Вставить("IDЦитируемогоСобщения", "");
	СтруктураСообщения.Вставить("ТекстЦитирования", "");
	СтруктураСообщения.Вставить("АвторЦитирования", "");
	СтруктураСообщения.Вставить("СсылкаОператор", ТекущийОператор);
	СтруктураСообщения.Вставить("Прочитано", Истина);
	
	ТекущаяВременнаяМетка = Бот.ЗаписатьВИсторию(СтруктураСообщения);
	
	
	СтруктураВозврата = Новый Структура("IDСообщения, Текст, Дата, ТекущаяВременнаяМетка",
		Результат.idMessage, ТекстСообщения, ТекущаяДата(), ТекущаяВременнаяМетка);
	
	Возврат СтруктураВозврата;
	
КонецФункции


Функция ВоспроизведениеКонтентаВнутри()
	
	Возврат Константы.iga_ВоспроизведениеКонтентаВнутри.Получить();
	
КонецФункции

&НаКлиенте
Асинх Процедура ОбработатьОткрытиеФайла(ИдСообщения)
	
	#Если ВебКлиент Тогда
	Подключено = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
	
	Если Не Подключено Тогда
		Установлено = Ждать УстановитьРасширениеРаботыСФайламиАсинх();
		Если Не Установлено Тогда
			Возврат;
		КонецЕсли;           
		Подключено = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
		Если Не Подключено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	#КонецЕсли
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	ИдЧата = ТекущиеДанные.ИдЧата;
	ЧатСсылка = ТекущиеДанные.Чат;
	
    ДанныеФайла = ПолучитьДанныеФайлаДляОткрытия(ЧатСсылка, ИдЧата, ИдСообщения, КэшКонтента, УникальныйИдентификатор);
    
    Если ДанныеФайла = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
    Если ДанныеФайла.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Документ") Тогда
        ПараметрыФайла = Новый ОписаниеПередаваемогоФайла(ДанныеФайла.ИмяФайла, ДанныеФайла.АдресХранилища);
        МассивФайлов = Новый Массив;
        МассивФайлов.Добавить(ПараметрыФайла);
		
        НачатьПолучениеФайловССервера(МассивФайлов);
    Иначе
		КаталогВременных = Ждать КаталогВременныхФайловАсинх();
		ПутьКПапке = iga_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(КаталогВременных, "iga_Bot_Media");
		
		Ждать СоздатьКаталогАсинх(ПутьКПапке); 
		
		ЧистоеИмя = iga_ОбщегоНазначенияКлиентСервер.ИдеальноеИмяФайла(ДанныеФайла.ИмяФайла);
		ИмяДляСохранения = ИдСообщения + "_" + ЧистоеИмя;
		
		ПутьКФайлу = iga_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(ПутьКПапке, ИмяДляСохранения);
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.АдресХранилища);
		
		Попытка
			Ждать ДвоичныеДанные.ЗаписатьАсинх(ПутьКФайлу);
			
			Если ВоспроизведениеКонтентаВнутри() Тогда
		        ПараметрыФормы = Новый Структура;
		        ПараметрыФормы.Вставить("АдресМедиа", ДанныеФайла.АдресХранилища);
		        ПараметрыФормы.Вставить("ТипМедиа",   ДанныеФайла.ТипМедиа);
		        ПараметрыФормы.Вставить("ИмяФайла",   ДанныеФайла.ИмяФайла);
		        
		        ОткрытьФорму("Обработка.iga_ChatBot.Форма.ПросмотрМедиа", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе
				ЗапуститьПриложениеАсинх(ПутьКФайлу, КаталогВременных);
			КонецЕсли;
			
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось открыть файл: " + ОписаниеОшибки();
			Сообщение.Сообщить();
		КонецПопытки;    
	КонецЕсли;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеФайлаДляОткрытия(ЧатСсылка, ИдЧата, ИдСообщения, КэшКонтента, УникальныйИдентификаторФормы)
	
	КэшЧата = КэшКонтента.Получить(ЧатСсылка);
	Если КэшЧата = Неопределено Тогда
		КэшЧата = Новый Соответствие;
		КэшКонтента.Вставить(ЧатСсылка, КэшЧата);
	КонецЕсли;
	
	ДанныеКонтента = КэшЧата.Получить(ИдСообщения);
	
	Если ДанныеКонтента = Неопределено Или ДанныеКонтента.Адрес = "" Тогда
		
		Бот = Обработки.iga_ChatBot.Создать();
		Бот.ИнициализацияОсновныхПараметров();
		
		Бот.ВыполнитьПервичнуюЗагрузкуФайла(ИдЧата, ИдСообщения);
		
		ДанныеФайла = iga_РаспределениеСервер.ПолучитьДвоичныеДанныеФайла(ИдСообщения);
		
		Если ДанныеФайла = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ДвоичныеДанные = ДанныеФайла.ДвоичныеДанные;
		
		ДанныеРегистра = РегистрыСведений.iga_ПрикрепленныеФайлы.Получить(Новый Структура("IDСообщения", ИдСообщения));
		
		АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторФормы);
		Инфо = Новый Структура("ТипМедиа, ИмяФайла, URLЗагрузки");
		ЗаполнитьЗначенияСвойств(Инфо, ДанныеРегистра);
		КэшЧата.Вставить(ИдСообщения, Новый Структура("Адрес, Инфо, ДатаКэша, URLЗагрузки", 
			АдресХранилища, Инфо, ТекущаяДата(), ДанныеРегистра.URLЗагрузки));
		
	Иначе
		АдресХранилища = ДанныеКонтента.Адрес;
		Инфо = ДанныеКонтента.Инфо;		
	КонецЕсли;
    Результат = Новый Структура;
    Результат.Вставить("АдресХранилища", АдресХранилища);
    Результат.Вставить("ТипМедиа",      Инфо.ТипМедиа);
    Результат.Вставить("ИмяФайла",      Инфо.ИмяФайла);
    Результат.Вставить("URLЗагрузки",      Инфо.URLЗагрузки);
    
    Возврат Результат;
    
КонецФункции

&НаКлиенте
Асинх Процедура ОчиститьВременнуюПапкуМедиа()
	
	КаталогФайлов = Ждать КаталогВременныхФайловАсинх();
	
	ПутьКПапке = iga_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(КаталогФайлов, "iga_Bot_Media");
	МассивФайлов = Ждать НайтиФайлыАсинх(ПутьКПапке, "*.*");
	
	Для Каждого Файл Из МассивФайлов Цикл
		Попытка
			УдалитьФайлыАсинх(Файл.ПолноеИмя);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры


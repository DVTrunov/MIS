Процедура ОткрытьКарточкуПациента(Команда)
	
	ТекущиеДанные =  ПолучитьТекущиеДанные();
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлиентСсылка = ПолучитьКлиента(ТекущиеДанные.Чат);
	
	Если КлиентСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Клиенты.ФормаОбъекта", Новый Структура("Ключ", КлиентСсылка));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиЧатПоСообщениямНаСервере(Знач СтрокаПоиска)
	
	// 1. Очищаем строку от спецсимволов
	СимволыДляУдаления = "()[]{}\/|<>,.:;?!+-=""'*~_";
	Для Индекс = 1 По СтрДлина(СимволыДляУдаления) Цикл
		СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Сред(СимволыДляУдаления, Индекс, 1), " ");
	КонецЦикла;
	
	СтрокаПоиска = СокрЛП(СтрокаПоиска);
	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// 2. Разбиваем на слова и отбираем только ЗНАЧИМЫЕ (> 2 символов)
	МассивСлов = СтрРазделить(СтрокаПоиска, " ", Ложь);
	МассивЗначимыхСлов = Новый Массив;
	
	Для Каждого Слово Из МассивСлов Цикл
		Если СтрДлина(Слово) > 2 Тогда
			МассивЗначимыхСлов.Добавить(Слово);
		КонецЕсли;
		
		// Нам хватит 7 длинных слов для точного поиска, остальное отбрасываем
		Если МассивЗначимыхСлов.Количество() = 7 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если пользователь ввел только предлоги или цифры (например, "в 2")
	Если МассивЗначимыхСлов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// 3. Формируем чистую строку для точного поиска
	// Получится: "Маммография проекциях снимка Ажибаев"
	СтрокаПоискаОчищенная = СтрСоединить(МассивЗначимыхСлов, " ");
	
	Попытка
		СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоискаОчищенная, 100);
		СписокПоиска.ОбластьПоиска.Добавить(Метаданные.РегистрыСведений.iga_ИсторияСообщений);
		СписокПоиска.ПерваяЧасть();
		
		// 4. Если точный поиск ничего не дал, ищем по маске (со звездочками)
		Если СписокПоиска.Количество() = 0 Тогда
			// Так как коротких слов в массиве больше нет, смело лепим звездочки ко всем!
			// Получится: "Маммография* проекциях* снимка* Ажибаев*"
			СтрокаПоискаСЗвездочкой = СтрСоединить(МассивЗначимыхСлов, "* ") + "*";
			
			СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоискаСЗвездочкой, 100);
			СписокПоиска.ОбластьПоиска.Добавить(Метаданные.РегистрыСведений.iga_ИсторияСообщений);
			СписокПоиска.ПерваяЧасть();
		КонецЕсли;
		
		НайденныеЧаты = Новый СписокЗначений;
		
		Для Каждого Результат Из СписокПоиска Цикл
			НайденныеЧаты.Добавить(Результат.Значение.Чат);
		КонецЦикла;                                       
		
		Возврат НайденныеЧаты;
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Асинх Процедура НайтиЧатПоСообщениям(Команда)
	
	СтрокаПоиска = Ждать ВвестиСтрокуАсинх(, "Введите слово для поиска", 100);
	
	Если Не ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеЧаты = НайтиЧатПоСообщениямНаСервере(СтрокаПоиска);
	
	Если НайденныеЧаты = Неопределено Или НайденныеЧаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Чаты с таким содержанием не найдены.");
	Иначе
		СписокЧатовИстория.Отбор.Элементы.Очистить();
		ЭлементОтбора = СписокЧатовИстория.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Чат");
		ЭлементОтбора.ПравоеЗначение = НайденныеЧаты;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СбросПоиска(Команда)
	СписокЧатовИстория.Отбор.Элементы.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСобытие(Команда)
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	ПараметрыОткрытия = Новый Структура("Основание", 
		Новый Структура("Клиент", 
		iga_ОбработкаДанныхПоЧатамСервер.ПолучитьКлиентаПоЧату(ТекущиеДанные.Чат)));
		
	ОткрытьФорму("Документ.Событие.ФормаОбъекта", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор,,,
		, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
	
КонецПроцедуры




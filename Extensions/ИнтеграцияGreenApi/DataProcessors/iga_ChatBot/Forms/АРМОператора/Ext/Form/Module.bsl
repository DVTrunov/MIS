&НаКлиенте
Процедура ПриСменеСтраницыЧатов()
	
	ТекущаяСтраницаОбщие = Элементы.СтраницыСпискиЧатов.ТекущаяСтраница;
	ТекущаяСтраницаАктивные = Элементы.СтраницыАктивные.ТекущаяСтраница;
	
	СчетчикСекунд = 0;
	
	Если ТекущаяСтраницаОбщие = Элементы.СтраницаАктивныеОбщая Тогда
		
		Если ТекущаяСтраницаАктивные = Элементы.СтраницаАктивныеЧаты Тогда
			ТекущаяСтраницаЧатов = СтраницаАктивные();
			Элементы.СписокЧатов.Обновить();
		Иначе
			ТекущаяСтраницаЧатов = СтраницаОжидающие();
			Элементы.СписокОжидающих.Обновить();
		КонецЕсли;
	ИначеЕсли ТекущаяСтраницаОбщие = Элементы.СтраницаИсторияЧатов Тогда
		ТекущаяСтраницаЧатов = СтраницаИстория();
		Элементы.СписокЧатовИстория.Обновить();
	ИначеЕсли ТекущаяСтраницаОбщие = Элементы.СтраницаУточняющиеЧаты Тогда
		ТекущаяСтраницаЧатов = СтраницаУточнение();
		Элементы.СписокЧатовТребуютУточнения.Обновить();
	Иначе
		ТекущаяСтраницаЧатов = СтраницаЗаписи();
		Элементы.СписокЧатовОтмененныхПереносовЗаписей.Обновить();
		ЕстьОповещение = Ложь;
	КонецЕсли; 
	
	Если Не ТекущаяСтраницаЧатов = СтраницаЗаписи() Тогда
		ЕстьОповещение = Ложь;
	КонецЕсли;
	
	Элементы.ТекстДиалогаHTML.Документ.defaultView.clearMessages();
	ОбновитьОкноДиалога();
	УстановитьДоступностьЭлементов();

КонецПроцедуры


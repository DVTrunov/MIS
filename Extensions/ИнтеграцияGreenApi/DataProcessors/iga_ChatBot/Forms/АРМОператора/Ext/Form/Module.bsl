&НаКлиенте
Функция ПолучитьТекущиеДанные()
	
	Если ТекущаяСтраницаЧатов = СтраницаАктивные() Тогда
		ТекущаяСтрока = Элементы.СписокЧатов.ТекущиеДанные;
	ИначеЕсли ТекущаяСтраницаЧатов = СтраницаИстория() Тогда
		ТекущаяСтрока = Элементы.СписокЧатовИстория.ТекущиеДанные;
	ИначеЕсли ТекущаяСтраницаЧатов = СтраницаОжидающие() Тогда
		ТекущаяСтрока = Элементы.СписокОжидающих.ТекущиеДанные;
	ИначеЕсли ТекущаяСтраницаЧатов = СтраницаУточнение() Тогда
		ТекущаяСтрока = Элементы.СписокЧатовТребуютУточнения.ТекущиеДанные;
	Иначе
		ТекущаяСтрока = Элементы.СписокЧатовОтмененныхПереносовЗаписей.ТекущиеДанные;
	КонецЕсли;	
	
	Возврат ТекущаяСтрока;
	
КонецФункции

&НаКлиенте
Процедура СменитьЯзыкДиалога(Команда)
	
	ТекущаяСтрока = ПолучитьТекущиеДанные();
	
	Если ТекущаяСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЧатСсылка = ТекущаяСтрока.Чат;
	
	ЯзыкЧата = ПолучитьЯзыкЧата(ЧатСсылка);
	
	ПараметрыЗакрытия = Новый Структура("ЧатСсылка",
		ЧатСсылка);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Обработчик_ПослеВыбораЯзыка", ЭтаФорма, ПараметрыЗакрытия);
	
	ОткрытьФорму("ОбщаяФорма.iga_ФормаВыбораЯзыка", Новый Структура("ТекущийЯзык", ЯзыкЧата), ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);


&НаСервереБезКонтекста
Процедура ПочиститьКэшКонтентаНаСервере(АдресаУдаляемыхДанных)
	
	Для Каждого Адрес Из АдресаУдаляемыхДанных Цикл
		УдалитьИзВременногоХранилища(Адрес);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПочиститьКэшКонтента()
	
	АдресаУдаляемыхДанных = Новый Массив;
	
	ЕстьУдаляемыеДанные = Ложь;
	
	УдаляемыеКлючи = Новый Массив;
	
	ПустыеЧаты = Новый Массив;
	
	Для Каждого КэшЧата Из КэшКонтента Цикл
		
		Если Не ТипЗнч(КэшЧата.Значение) = Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		УдаляемыеКлючи.Очистить();
		
		Для Каждого КэшСообщения Из КэшЧата.Значение Цикл
			КоличествоМинут = iga_ОбщегоНазначенияКлиентСервер.РазностьДат(КэшСообщения.Значение.ДатаКэша, ТекущаяДата(), "МИНУТА");
			Если КоличествоМинут > 30 Тогда
				АдресаУдаляемыхДанных.Добавить(КэшСообщения.Значение.Адрес);
				УдаляемыеКлючи.Добавить(КэшСообщения.Ключ);
				ЕстьУдаляемыеДанные = Истина;
			КонецЕсли;
		КонецЦикла;
		Для Каждого КлючКэша Из УдаляемыеКлючи Цикл
			КэшЧата.Значение.Удалить(КлючКэша)
		КонецЦикла;
		
		Если КэшЧата.Значение.Количество() = 0 Тогда
			ПустыеЧаты.Добавить(КэшЧата.Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючЧата Из ПустыеЧаты Цикл
		КэшКонтента.Удалить(КлючЧата);
	КонецЦикла;
	
	Если ЕстьУдаляемыеДанные Тогда
		ПочиститьКэшКонтентаНаСервере(АдресаУдаляемыхДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоЧатов(Оператор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_НастройкиОператоров.Оператор КАК Оператор
	               |ПОМЕСТИТЬ ВТ_ПропускОператоров
	               |ИЗ
	               |	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |ГДЕ
	               |	(НЕ iga_НастройкиОператоров.ПростойОператор
	               |			ИЛИ iga_НастройкиОператоров.Подразделение = &ПодразделениеКоллЦентр)
	               |	И iga_НастройкиОператоров.Оператор = &Оператор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	iga_НастройкиОператоров.Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ ВТ_ПодразделенияОператора
	               |ИЗ
	               |	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |ГДЕ
	               |	iga_НастройкиОператоров.Оператор = &Оператор
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	iga_СвязиПодразделенийСОператорами.Подразделение
	               |ИЗ
	               |	РегистрСведений.iga_СвязиПодразделенийСОператорами КАК iga_СвязиПодразделенийСОператорами
	               |ГДЕ
	               |	iga_СвязиПодразделенийСОператорами.Оператор = &Оператор
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	&ПодразделениеКоллЦентр
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	iga_ОчередьРаспределения.Чат КАК Чат,
	               |	iga_ОчередьРаспределения.Статус КАК Статус
	               |ПОМЕСТИТЬ ВТ_ВсеЧатыОператора
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |ГДЕ
	               |	iga_ОчередьРаспределения.Оператор = &Оператор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВложенныйЗапрос.КоличествоИстория) КАК КоличествоИстория,
	               |	СУММА(ВложенныйЗапрос.КоличествоАктивные) КАК КоличествоАктивные,
	               |	СУММА(ВложенныйЗапрос.КоличествоУточнение) КАК КоличествоУточнение,
	               |	СУММА(ВложенныйЗапрос.КоличествоНеподтвержденных) КАК КоличествоНеподтвержденных,
	               |	СУММА(ВложенныйЗапрос.КоличествоОжидающих) КАК КоличествоОжидающих
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ВсеЧатыОператора.Чат) КАК КоличествоИстория,
	               |		0 КАК КоличествоАктивные,
	               |		0 КАК КоличествоУточнение,
	               |		0 КАК КоличествоНеподтвержденных,
	               |		0 КАК КоличествоОжидающих
	               |	ИЗ
	               |		ВТ_ВсеЧатыОператора КАК ВТ_ВсеЧатыОператора
	               |	ГДЕ
	               |		ВТ_ВсеЧатыОператора.Статус = &СтатусЗавершен
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		0,
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ВсеЧатыОператора.Чат),
	               |		0,
	               |		0,
	               |		0
	               |	ИЗ
	               |		ВТ_ВсеЧатыОператора КАК ВТ_ВсеЧатыОператора
	               |	ГДЕ
	               |		ВТ_ВсеЧатыОператора.Статус <> &СтатусЗавершен
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СУММА(0),
	               |		СУММА(0),
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ iga_ОчередьРаспределения.Чат),
	               |		0,
	               |		0
	               |	ИЗ
	               |		РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПараметрыОбщенияСБотом КАК iga_ПараметрыОбщенияСБотом
	               |			ПО iga_ОчередьРаспределения.Чат = iga_ПараметрыОбщенияСБотом.Чат
	               |				И (iga_ПараметрыОбщенияСБотом.Параметр.ИмяПараметра = ""ВыбранноеПодразделение"")
	               |	ГДЕ
	               |		iga_ОчередьРаспределения.Статус = &СтатусВнеОчереди
	               |		И (iga_ПараметрыОбщенияСБотом.Значение В
	               |					(ВЫБРАТЬ
	               |						iga_НастройкиОператоров.Подразделение КАК Подразделение
	               |					ИЗ
	               |						РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |					ГДЕ
	               |						iga_НастройкиОператоров.Оператор = &Оператор)
	               |				ИЛИ 1 В
	               |					(ВЫБРАТЬ
	               |						1
	               |					ИЗ
	               |						РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |					ГДЕ
	               |						iga_НастройкиОператоров.Оператор = &Оператор
	               |						И НЕ iga_НастройкиОператоров.ПростойОператор)
	               |				ИЛИ iga_ПараметрыОбщенияСБотом.Значение В
	               |					(ВЫБРАТЬ
	               |						ВТ_ПодразделенияОператора.Подразделение КАК Подразделение
	               |					ИЗ
	               |						ВТ_ПодразделенияОператора КАК ВТ_ПодразделенияОператора))
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		0,
	               |		0,
	               |		0,
	               |		1,
	               |		0
	               |	ИЗ
	               |		РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.iga_ЧатыКлиентов КАК iga_ЧатыКлиентов
	               |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПараметрыОбщенияСБотом КАК iga_ПараметрыОбщенияСБотом
	               |				ПО (iga_ПараметрыОбщенияСБотом.Чат = iga_ЧатыКлиентов.Чат)
	               |					И (iga_ПараметрыОбщенияСБотом.Параметр.ИмяПараметра = ""ВыбранноеПодразделение"")
	               |			ПО iga_СтатусыПодтвержденияСтрокЗаявок.Заявка.Клиент = iga_ЧатыКлиентов.Клиент
	               |	ГДЕ
	               |		iga_СтатусыПодтвержденияСтрокЗаявок.Заявка.Проведен
	               |		И НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Обработано
	               |		И iga_СтатусыПодтвержденияСтрокЗаявок.Статус В(&СтатусыОтмены)
	               |		И (ЕСТЬNULL(iga_ПараметрыОбщенияСБотом.Значение, НЕОПРЕДЕЛЕНО) В
	               |					(ВЫБРАТЬ
	               |						iga_НастройкиОператоров.Подразделение КАК Подразделение
	               |					ИЗ
	               |						РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |					ГДЕ
	               |						iga_НастройкиОператоров.Оператор = &Оператор
	               |			
	               |					ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |					ВЫБРАТЬ
	               |						iga_СвязиПодразделенийСОператорами.Подразделение
	               |					ИЗ
	               |						РегистрСведений.iga_СвязиПодразделенийСОператорами КАК iga_СвязиПодразделенийСОператорами
	               |					ГДЕ
	               |						iga_СвязиПодразделенийСОператорами.Оператор = &Оператор)
	               |				ИЛИ &Оператор В
	               |					(ВЫБРАТЬ
	               |						iga_НастройкиОператоров.Оператор КАК Оператор
	               |					ИЗ
	               |						РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |					ГДЕ
	               |						(iga_НастройкиОператоров.Подразделение = &ПодразделениеКоллЦентр
	               |							ИЛИ НЕ iga_НастройкиОператоров.ПростойОператор)))
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		0,
	               |		0,
	               |		0,
	               |		0,
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ iga_ОчередьРаспределения.Чат)
	               |	ИЗ
	               |		РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.iga_ПараметрыОбщения КАК iga_ПараметрыОбщения
	               |			ПО (iga_ПараметрыОбщения.ИмяПараметра = ""ВыбранноеПодразделение"")
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПараметрыОбщенияСБотом КАК iga_ПараметрыОбщенияСБотом
	               |			ПО iga_ОчередьРаспределения.Чат = iga_ПараметрыОбщенияСБотом.Чат
	               |				И (iga_ПараметрыОбщения.Ссылка = iga_ПараметрыОбщенияСБотом.Параметр)
	               |	ГДЕ
	               |		iga_ОчередьРаспределения.Оператор = &ПустойОператор
	               |		И iga_ОчередьРаспределения.Статус = &СтатусОжидание
	               |		И НЕ iga_ОчередьРаспределения.ОсобыйЧат
	               |		И (&Оператор В
	               |					(ВЫБРАТЬ
	               |						ВТ_ПропускОператоров.Оператор КАК Оператор
	               |					ИЗ
	               |						ВТ_ПропускОператоров КАК ВТ_ПропускОператоров)
	               |				ИЛИ iga_ПараметрыОбщенияСБотом.Значение В
	               |					(ВЫБРАТЬ
	               |						ВТ_ПодразделенияОператора.Подразделение КАК Подразделение
	               |					ИЗ
	               |						ВТ_ПодразделенияОператора КАК ВТ_ПодразделенияОператора))) КАК ВложенныйЗапрос";
	Запрос.УстановитьПараметр("Оператор", Оператор);
	Запрос.УстановитьПараметр("СтатусЗавершен", Перечисления.iga_СтатусыОчереди.Завершен);
	Запрос.УстановитьПараметр("СтатусВнеОчереди", Перечисления.iga_СтатусыОчереди.ВнеОчереди);
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.iga_СтатусыПодтвержденияЗаявок.Отменено);
	МассивСтатусов.Добавить(Перечисления.iga_СтатусыПодтвержденияЗаявок.Просрочено);
	МассивСтатусов.Добавить(Перечисления.iga_СтатусыПодтвержденияЗаявок.ТребуетсяПеренос);
	Запрос.УстановитьПараметр("ПустойОператор", Справочники.Пользователи.ПустаяСсылка());
	Запрос.УстановитьПараметр("СостояниеЗапланирована", Справочники.ВидыСостоянийЗаявок.Запланирована);
	Запрос.УстановитьПараметр("СтатусОжидание", Перечисления.iga_СтатусыОчереди.Ожидание);
	Запрос.УстановитьПараметр("СтатусыОтмены", МассивСтатусов);
	Запрос.УстановитьПараметр("ПодразделениеКоллЦентр", Справочники.iga_ПодразделенияОператоров.КоллЦентр);
	Выборка = Запрос.Выполнить().Выбрать();
	СтруктураВозврата = Новый Структура("КоличествоИстория, КоличествоАктивные, КоличествоУточнение, КоличествоНеподтвержденных, КоличествоОжидающих", 0, 0, 0, 0, 0);
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции


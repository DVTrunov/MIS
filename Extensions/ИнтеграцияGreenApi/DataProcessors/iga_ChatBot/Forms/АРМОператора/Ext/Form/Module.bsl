&НаКлиенте
Функция ПолучитьТекстИзБуфераОбмена()
	Текст = "";
	Попытка
		// Используем системный COM-объект Windows для доступа к буферу
		ОбъектHTML = Новый COMОбъект("htmlfile");
		Текст = ОбъектHTML.parentWindow.clipboardData.getData("text");
	Исключение
		// Если что-то пошло не так (например, запуск на Linux или Mac), 
		// молча возвращаем пустоту, чтобы не вызывать ошибку
		Текст = "";
	КонецПопытки;
	
	Возврат Текст;
КонецФункции

&НаКлиенте
Процедура ВставитьТекст(Команда)
	
	// 1. Читаем текст из буфера ОС
	ТекстБуфера = ПолучитьТекстИзБуфераОбмена();
	
	// 2. Если в буфере действительно есть текст, прокидываем его в наш HTML
	Если ЗначениеЗаполнено(ТекстБуфера) Тогда
		ДокументHTML = Элементы.ТекстовоеСообщение.Документ;
		
		Если ДокументHTML <> Неопределено Тогда
			// Функция insertTextAtCaret сама вернет фокус редактору и вставит текст куда нужно
			ДокументHTML.defaultView.insertTextAtCaret(ТекстБуфера);
		КонецЕсли;
	КонецЕсли;
	

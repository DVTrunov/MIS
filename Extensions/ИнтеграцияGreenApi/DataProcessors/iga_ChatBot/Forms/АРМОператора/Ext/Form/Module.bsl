&НаСервереБезКонтекста
Функция ПолучитьИсториюСообщений(ЧатСсылка, ТекущаяВременнаяМетка)
    СписокНовых = Новый Массив;
    
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 20
                   |	История.Текст КАК Текст,
                   |	История.ДатаСообщения КАК Дата,
                   |	История.ЭтоВходящее КАК ЭтоВходящее,
                   |	ЕСТЬNULL(История.Оператор.Наименование, """") КАК ОператорИмя,
                   |	История.ТекстЦитирования КАК ТекстЦитирования,
                   |	История.АвторЦитирования КАК АвторЦитирования,
                   |	История.IDСообщения КАК IDСообщения,
                   |	История.IDЦитируемогоСообщения КАК IDЦитируемогоСообщения,
                   |	История.ВременнаяМетка КАК ВременнаяМетка,
                   |	История.ЕстьФайл КАК ЕстьФайл,
                   |	iga_ПрикрепленныеФайлы.ДанныеФайла КАК ДанныеФайла,
                   |	iga_ПрикрепленныеФайлы.ПутьКФайлу КАК ПутьКФайлу,
                   |	iga_ПрикрепленныеФайлы.ТипМедиа КАК ТипМедиа,
                   |	iga_ПрикрепленныеФайлы.Статус КАК Статус,
                   |	iga_ПрикрепленныеФайлы.ТекстОшибки КАК ТекстОшибки,
                   |	iga_ПрикрепленныеФайлы.URLЗагрузки КАК URLЗагрузки,
                   |	iga_ПрикрепленныеФайлы.КартинкаФайла КАК КартинкаФайла,
                   |	iga_ПрикрепленныеФайлы.РазмерФайла КАК РазмерФайла,
                   |	iga_ПрикрепленныеФайлы.ИмяФайла КАК ИмяФайла
                   |ИЗ
                   |	РегистрСведений.iga_ИсторияСообщений КАК История
                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПрикрепленныеФайлы КАК iga_ПрикрепленныеФайлы
                   |		ПО История.IDСообщения = iga_ПрикрепленныеФайлы.IDСообщения
                   |ГДЕ
                   |	История.Чат = &Чат
                   |	И История.ВременнаяМетка < &ТекущаяВременнаяМетка
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |	ВременнаяМетка УБЫВ";
    Запрос.УстановитьПараметр("ТекущаяВременнаяМетка", ТекущаяВременнаяМетка);
    Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл
        Стр = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Стр.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
        СписокНовых.Добавить(Стр);
    КонецЦикла;
    
    Возврат СписокНовых;
КонецФункции

&НаКлиенте
Процедура ВывестиИсториюСообщений()
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИсторияСообщений = ПолучитьИсториюСообщений(ТекущиеДанные.Чат, ПерваяВременнаяМетка);

	Для Каждого Сообщение Из ИсторияСообщений Цикл
		
		ДобавитьСообщениеВИнтерфейс(Сообщение, Истина);
		
		ПерваяВременнаяМетка = Сообщение.ВременнаяМетка;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТекстДиалогаHTMLПриНажатии(Элемент)
	
	Если Не ВводДоступен() Тогда
		Возврат;
	КонецЕсли;
	
	НовыйЗаголовок = Элементы.ТекстДиалогаHTML.Документ.title;
	
	Если ПустаяСтрока(НовыйЗаголовок) ИЛИ НовыйЗаголовок = "about:blank" Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(НовыйЗаголовок, "v8:setQuoteId:") > 0 Тогда
		
		ЦитируемоеСообщениеИд = СтрЗаменить(НовыйЗаголовок, "v8:setQuoteId:", "");
		
	ИначеЕсли НовыйЗаголовок = "v8:cancelQuote" Тогда
		
		ЦитируемоеСообщениеИд = "";
		
	ИначеЕсли СтрНайти(НовыйЗаголовок, "v8:viewMedia:") > 0 Тогда
		
		ИдСообщения = СтрЗаменить(НовыйЗаголовок, "v8:viewMedia:", "");
        ОбработатьОткрытиеФайла(ИдСообщения);
        
	ИначеЕсли СтрНайти(НовыйЗаголовок, "v8:loadMoreHistory:") > 0 Тогда
		
		ВывестиИсториюСообщений();
	        
    КонецЕсли;
	
	Элементы.ТекстДиалогаHTML.Документ.title = "";
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ЕстьОтмененныеБрони(Оператор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_НастройкиОператоров.Подразделение КАК Подразделение,
	               |	iga_НастройкиОператоров.Оператор КАК Оператор
	               |ПОМЕСТИТЬ ВТ_НастройкиОператора
	               |ИЗ
	               |	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |ГДЕ
	               |	iga_НастройкиОператоров.Оператор = &Оператор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Заявка КАК Заявка,
	               |	iga_ЧатыКлиентов.Чат КАК Чат
	               |ПОМЕСТИТЬ ВТ_ОтмененныеЗаявки
	               |ИЗ
	               |	РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка КАК ЗаявкаДок
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ЧатыКлиентов КАК iga_ЧатыКлиентов
	               |			ПО ЗаявкаДок.Клиент = iga_ЧатыКлиентов.Клиент
	               |		ПО iga_СтатусыПодтвержденияСтрокЗаявок.Заявка = ЗаявкаДок.Ссылка
	               |ГДЕ
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Статус В(&СтатусыОтмены)
	               |	И iga_СтатусыПодтвержденияСтрокЗаявок.ДатаЗаписи >= &ТекущаяДата
	               |	И iga_СтатусыПодтвержденияСтрокЗаявок.Заявка.Филиал В
	               |			(ВЫБРАТЬ
	               |				iga_ПодразделенияОператоровФилиалы.Филиал КАК Филиал
	               |			ИЗ
	               |				ВТ_НастройкиОператора КАК ВТ_НастройкиОператора
	               |					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.iga_ПодразделенияОператоров.Филиалы КАК iga_ПодразделенияОператоровФилиалы
	               |					ПО
	               |						ВТ_НастройкиОператора.Подразделение = iga_ПодразделенияОператоровФилиалы.Ссылка
	               |		
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |			ВЫБРАТЬ
	               |				iga_ПодразделенияОператоровФилиалы.Филиал
	               |			ИЗ
	               |				ВТ_НастройкиОператора КАК ВТ_НастройкиОператора
	               |					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.iga_СвязиПодразделенийСОператорами КАК iga_СвязиПодразделенийСОператорами
	               |						ЛЕВОЕ СОЕДИНЕНИЕ Справочник.iga_ПодразделенияОператоров.Филиалы КАК iga_ПодразделенияОператоровФилиалы
	               |						ПО
	               |							iga_СвязиПодразделенийСОператорами.Подразделение = iga_ПодразделенияОператоровФилиалы.Ссылка
	               |					ПО
	               |						ВТ_НастройкиОператора.Оператор = iga_СвязиПодразделенийСОператорами.Оператор)
	               |	И НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Обработано
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОтмененныеЗаявки.Заявка КАК Заявка,
	               |	iga_ОчередьРаспределения.Оператор КАК Оператор,
	               |	iga_ОчередьРаспределения.Статус КАК Статус
	               |ПОМЕСТИТЬ ВТ_ВсеОчередиЗаявок
	               |ИЗ
	               |	ВТ_ОтмененныеЗаявки КАК ВТ_ОтмененныеЗаявки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |		ПО ВТ_ОтмененныеЗаявки.Чат = iga_ОчередьРаспределения.Чат
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОтмененныеЗаявки.Заявка КАК Заявка
	               |ИЗ
	               |	ВТ_ОтмененныеЗаявки КАК ВТ_ОтмененныеЗаявки
	               |ГДЕ
	               |	НЕ ВТ_ОтмененныеЗаявки.Заявка В
	               |				(ВЫБРАТЬ
	               |					ВТ_ВсеОчередиЗаявок.Заявка КАК Заявка
	               |				ИЗ
	               |					ВТ_ВсеОчередиЗаявок КАК ВТ_ВсеОчередиЗаявок
	               |				ГДЕ
	               |					ВТ_ВсеОчередиЗаявок.Статус В (&СтатусыОчереди))";
	СтатусыОтмены = Новый Массив;
	СтатусыОтмены.Добавить(Перечисления.iga_СтатусыПодтвержденияЗаявок.Отменено);
	СтатусыОтмены.Добавить(Перечисления.iga_СтатусыПодтвержденияЗаявок.ТребуетсяПеренос);
	Запрос.УстановитьПараметр("СтатусыОтмены", СтатусыОтмены);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Оператор", Оператор);
	СтатусыОчереди = Новый Массив;
	СтатусыОчереди.Добавить(Перечисления.iga_СтатусыОчереди.ВРаботе);
	СтатусыОчереди.Добавить(Перечисления.iga_СтатусыОчереди.ВнеОчереди);
	СтатусыОчереди.Добавить(Перечисления.iga_СтатусыОчереди.Подключение);
	Запрос.УстановитьПараметр("СтатусыОчереди", СтатусыОчереди);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции


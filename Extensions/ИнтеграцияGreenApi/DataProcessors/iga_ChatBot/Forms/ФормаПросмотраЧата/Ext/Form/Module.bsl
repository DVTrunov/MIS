&НаСервереБезКонтекста
Функция ПолучитьПродолжительностьСтрокой(Знач ДатаНачала, Знач ДатаОкончания, Знач Разница = Ложь) Экспорт
    
    // Проверка на заполненность дат и на то, что ДатаНачала > ДатаОкончания
    Если (Не ЗначениеЗаполнено(ДатаНачала) 
        Или Не ЗначениеЗаполнено(ДатаОкончания) 
        Или ДатаНачала >= ДатаОкончания) И Не Разница Тогда
        Возврат "0 м.";
	КонецЕсли;
	
	Если Разница Тогда
		Если ДатаНачала > ДатаОкончания Тогда
			Дата = ДатаОкончания;
			ДатаОкончания = ДатаНачала;
			ДатаНачала = Дата;
		КонецЕсли;
	КонецЕсли;
    
    // В 1С разница дат возвращается в секундах
    РазницаВСекундах = ДатаОкончания - ДатаНачала;
    
    // Вычисляем составляющие времени
    Дни     = Цел(РазницаВСекундах / 86400);
    Остаток = РазницаВСекундах % 86400;
    
    Часы    = Цел(Остаток / 3600);
    Остаток = Остаток % 3600;
    
    Минуты  = Цел(Остаток / 60);
    Секунды = Остаток % 60;
    
    // Формируем результирующую строку
    МассивСтрок = Новый Массив;
    
    Если Дни > 0 Тогда
        МассивСтрок.Добавить(Формат(Дни, "ЧГ=") + " д.");
    КонецЕсли;
    
    Если Часы > 0 Тогда
        МассивСтрок.Добавить(Формат(Часы, "ЧГ=") + " ч.");
    КонецЕсли;
    
    Если Минуты > 0 Тогда
        МассивСтрок.Добавить(Формат(Минуты, "ЧГ=") + " м.");
    КонецЕсли;
    
    Если Секунды > 0 Тогда
        МассивСтрок.Добавить(Формат(Секунды, "ЧГ=") + " с.");
    КонецЕсли;
    
    // Если разница составила меньше секунды (что в рамках 1С маловероятно при обычных датах, 
    // но возможно при работе с миллисекундами) или что-то пошло не так
    Если МассивСтрок.Количество() = 0 Тогда
        Возврат "0 м.";
    КонецЕсли;
    
    // Соединяем элементы массива через пробел
    Возврат СтрСоединить(МассивСтрок, " ");
    
КонецФункции

&НаСервереБезКонтекста
Процедура СписокНаПодключениеПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
    Для Каждого КлючИЗначение Из Строки Цикл
        
        ДанныеСтроки = КлючИЗначение.Значение.Данные;
        
        ДанныеСтроки.ВремениСПоследнегоОтветаОператора = ПолучитьПродолжительностьСтрокой(ДанныеСтроки.ДатаПоследнегоИсходящего, ТекущаяДата());
        ДанныеСтроки.ВремяСПоследнегоСообщенияПользователя = ПолучитьПродолжительностьСтрокой(ДанныеСтроки.ДатаПоследнегоВходящего, ТекущаяДата());
        ДанныеСтроки.РазницаМеждуСообщениями = ПолучитьПродолжительностьСтрокой(ДанныеСтроки.ДатаПоследнегоИсходящего, ДанныеСтроки.ДатаПоследнегоВходящего, Истина);
        
	КонецЦикла;
	
КонецПроцедуры


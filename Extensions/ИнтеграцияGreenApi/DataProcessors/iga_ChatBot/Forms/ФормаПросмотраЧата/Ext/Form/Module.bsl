&НаКлиенте
Перем КэшСообщений;

&НаКлиенте
Перем КэшКонтента;

&НаСервереБезКонтекста
Функция СформироватьHTMLДиалогаНаСервере(ЧатСсылка, КэшКонтента, УникальныйИдентификаторФормы)
    Возврат iga_РаспределениеСервер.СформироватьHTMLДиалога(ЧатСсылка, КэшКонтента, УникальныйИдентификаторФормы, "");
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	КэшСообщений = Новый Соответствие;
	КэшКонтента = Новый Соответствие;
	
	Результат = СформироватьHTMLДиалогаНаСервере(Неопределено, КэшКонтента, УникальныйИдентификатор);
	ТекстДиалогаHTML = Результат.HTML;
	ТекущаяВременнаяМетка = Результат.ТекущаяВременнаяМетка;
	
	ПодключитьОбработчикОжидания("ОбновитьОкноДиалога", 0.2, Истина);
	
    ПодключитьОбработчикОжидания("ПроверитьНовыеСообщения", 5);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНовыеСообщенияДляИнтерфейса(ЧатСсылка, ТекущаяВременнаяМетка)
    СписокНовых = Новый Массив;
    
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |	История.Текст КАК Текст,
                   |	История.ДатаСообщения КАК Дата,
                   |	История.ЭтоВходящее КАК ЭтоВходящее,
                   |	ЕСТЬNULL(История.Оператор.Наименование, """") КАК ОператорИмя,
                   |	История.ТекстЦитирования КАК ТекстЦитирования,
                   |	История.АвторЦитирования КАК АвторЦитирования,
                   |	История.IDСообщения КАК IDСообщения,
                   |	История.IDЦитируемогоСообщения КАК IDЦитируемогоСообщения,
                   |	История.ВременнаяМетка КАК ВременнаяМетка,
                   |	История.ЕстьФайл КАК ЕстьФайл,
                   |	iga_ПрикрепленныеФайлы.ДанныеФайла КАК ДанныеФайла,
                   |	iga_ПрикрепленныеФайлы.ПутьКФайлу КАК ПутьКФайлу,
                   |	iga_ПрикрепленныеФайлы.ТипМедиа КАК ТипМедиа,
                   |	iga_ПрикрепленныеФайлы.Статус КАК Статус,
                   |	iga_ПрикрепленныеФайлы.ТекстОшибки КАК ТекстОшибки,
                   |	iga_ПрикрепленныеФайлы.URLЗагрузки КАК URLЗагрузки,
                   |	iga_ПрикрепленныеФайлы.КартинкаФайла КАК КартинкаФайла,
                   |	iga_ПрикрепленныеФайлы.РазмерФайла КАК РазмерФайла,
                   |	iga_ПрикрепленныеФайлы.ИмяФайла КАК ИмяФайла
                   |ИЗ
                   |	РегистрСведений.iga_ИсторияСообщений КАК История
                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПрикрепленныеФайлы КАК iga_ПрикрепленныеФайлы
                   |		ПО История.IDСообщения = iga_ПрикрепленныеФайлы.IDСообщения
                   |ГДЕ
                   |	История.Чат = &Чат
                   |	И История.ВременнаяМетка > &ТекущаяВременнаяМетка
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |	ВременнаяМетка";
    Запрос.УстановитьПараметр("ТекущаяВременнаяМетка", ТекущаяВременнаяМетка);
    Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл
        Стр = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Стр.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
        СписокНовых.Добавить(Стр);
    КонецЦикла;
    
    Возврат СписокНовых;
КонецФункции

&НаСервереБезКонтекста
Процедура ПочиститьКэшКонтентаНаСервере(АдресаУдаляемыхДанных)
	
	Для Каждого Адрес Из АдресаУдаляемыхДанных Цикл
		УдалитьИзВременногоХранилища(Адрес);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПочиститьКэшКонтента()
	
	АдресаУдаляемыхДанных = Новый Массив;
	
	ЕстьУдаляемыеДанные = Ложь;
	
	УдаляемыеКлючи = Новый Массив;
	
	ПустыеЧаты = Новый Массив;
	
	Для Каждого КэшЧата Из КэшКонтента Цикл
		
		Если Не ТипЗнч(КэшЧата.Значение) = Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		УдаляемыеКлючи.Очистить();
		
		Для Каждого КэшСообщения Из КэшЧата.Значение Цикл
			КоличествоМинут = iga_ОбщегоНазначенияКлиентСервер.РазностьДат(КэшСообщения.Значение.ДатаКэша, ТекущаяДата(), "МИНУТА");
			Если КоличествоМинут > 30 Тогда
				АдресаУдаляемыхДанных.Добавить(КэшСообщения.Значение.Адрес);
				УдаляемыеКлючи.Добавить(КэшСообщения.Ключ);
				ЕстьУдаляемыеДанные = Истина;
			КонецЕсли;
		КонецЦикла;
		Для Каждого КлючКэша Из УдаляемыеКлючи Цикл
			КэшЧата.Значение.Удалить(КлючКэша)
		КонецЦикла;
		
		Если КэшЧата.Значение.Количество() = 0 Тогда
			ПустыеЧаты.Добавить(КэшЧата.Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючЧата Из ПустыеЧаты Цикл
		КэшКонтента.Удалить(КлючЧата);
	КонецЦикла;
	
	Если ЕстьУдаляемыеДанные Тогда
		ПочиститьКэшКонтентаНаСервере(АдресаУдаляемыхДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВИнтерфейс(Сообщение)
	
    ТекстЦитаты = "";
    АвторЦитаты = "";
    
	Если ЗначениеЗаполнено(Сообщение.IDЦитируемогоСообщения) Тогда
        ДанныеЦитаты = КэшСообщений.Получить(Сообщение.IDЦитируемогоСообщения);
        Если ДанныеЦитаты <> Неопределено Тогда
            ТекстЦитаты = ДанныеЦитаты.Текст;
            АвторЦитаты = ДанныеЦитаты.Автор;
        КонецЕсли;
    КонецЕсли;
    
    ДанныеТекущего = Новый Структура("ID, Текст, Автор", Сообщение.IDСообщения, Сообщение.Текст, ?(Сообщение.ЭтоВходящее, "Клиент", "Вы"));
    КэшСообщений.Вставить(Сообщение.IDСообщения, ДанныеТекущего);
	
	
	ТекстСообщения = Сообщение.Текст;
    ПараметрыJS = Новый Структура;
    ПараметрыJS.Вставить("id",           Сообщение.IDСообщения);
    ПараметрыJS.Вставить("isIncoming",   Сообщение.ЭтоВходящее);
    ПараметрыJS.Вставить("time",         Формат(Сообщение.Дата, "ДЛФ=DT"));
    ПараметрыJS.Вставить("quoteText",    ТекстЦитаты);
	ПараметрыJS.Вставить("quoteAuthor",  АвторЦитаты);
	ПараметрыJS.Вставить("operatorName", Сообщение.ОператорИмя);
	Если Сообщение.Свойство("ЕстьФайл") И Сообщение.ЕстьФайл Тогда
		ПараметрыJS.Вставить("hasFile",      Сообщение.ЕстьФайл);
		ПараметрыJS.Вставить("fileStatus",   Строка(Сообщение.Статус));
		ПараметрыJS.Вставить("fileName",     Сообщение.ИмяФайла);
		ПараметрыJS.Вставить("fileSize",     Сообщение.РазмерФайла);
		ПараметрыJS.Вставить("thumbnail",    Сообщение.КартинкаФайла);
		КлассИконки = "icon-save";
		Если Сообщение.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Картинка") Тогда
			КлассИконки = "icon-zoom";
			ТекстСообщения = ?(ТекстСообщения = "", "Изображение", ТекстСообщения);
		ИначеЕсли Сообщение.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Видео") 
			ИЛИ Сообщение.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Аудио") Тогда
			КлассИконки = "icon-play";
			Если Сообщение.ТипМедиа = ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Видео") Тогда 
				ТекстСообщения = ?(ТекстСообщения = "", "Видеозапись", ТекстСообщения);
			Иначе
				ТекстСообщения = ?(ТекстСообщения = "", "Аудиозапись", ТекстСообщения);
			КонецЕсли;
		Иначе
			ТекстСообщения = ?(ТекстСообщения = "", "Документ", ТекстСообщения);
		КонецЕсли;
		ПараметрыJS.Вставить("iconClass",    КлассИконки);
	Иначе
		ПараметрыJS.Вставить("hasFile",      Ложь);
	КонецЕсли;
    ПараметрыJS.Вставить("text",         ТекстСообщения);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ПараметрыJS);
    СтрJSON = ЗаписьJSON.Закрыть();
    
    ДокументHTML = Элементы.ТекстДиалогаHTML.Документ;
    Если ДокументHTML <> Неопределено Тогда
        ДокументHTML.defaultView.appendMessage(СтрJSON);
    КонецЕсли;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьНовыеСообщенияНаСервере(ОбщаяВременнаяМетка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_КонтрольНовыхСообщений.ВременнаяМеткаНовыхСообщений КАК ВременнаяМеткаНовыхСообщений
	               |ИЗ
	               |	РегистрСведений.iga_КонтрольНовыхСообщений КАК iga_КонтрольНовыхСообщений
	               |ГДЕ
	               |	iga_КонтрольНовыхСообщений.ВременнаяМеткаНовыхСообщений > &ОбщаяВременнаяМетка";
	Запрос.УстановитьПараметр("ОбщаяВременнаяМетка", ОбщаяВременнаяМетка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОбщаяВременнаяМетка = Выборка.ВременнаяМеткаНовыхСообщений;
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьНовыеСообщения()
	
	ТекущиеДанные = Элементы.СписокНаПодключение.ТекущиеДанные;

	Если ЕстьНовыеСообщенияНаСервере(ОбщаяВременнаяМетка) И Не ТекущиеДанные = Неопределено И Не ТекущиеДанные.Свойство("ГруппировкаСтроки") Тогда
		
		НовыеСообщения = ПолучитьНовыеСообщенияДляИнтерфейса(ТекущиеДанные.Чат, ТекущаяВременнаяМетка);
		
		Для Каждого Сообщение Из НовыеСообщения Цикл
			
			ДобавитьСообщениеВИнтерфейс(Сообщение);
			
			ТекущаяВременнаяМетка = Макс(ТекущаяВременнаяМетка, Сообщение.ВременнаяМетка);
		КонецЦикла;
		
	КонецЕсли;
	
	КоличествоМинутПослеОчисткиКэша = iga_ОбщегоНазначенияКлиентСервер.РазностьДат(ДатаОчисткиКэша, ТекущаяДата(), "МИНУТА");
	
	Если КоличествоМинутПослеОчисткиКэша > 30 Тогда
		ПочиститьКэшКонтента()
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщенияПриОткрытии(МассивСообщений)
	
	ДокументHTML = Элементы.ТекстДиалогаHTML.Документ;
	
	Счетчик = 0;
	Для Каждого Сообщение Из МассивСообщений Цикл
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Сообщение.ПараметрыJS);
        СтрJSON = ЗаписьJSON.Закрыть();

		ДокументHTML.defaultView.appendMessage(СтрJSON);
	КонецЦикла;
	ДокументHTML.defaultView.scrollEnd();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПрочитатьСообщенияНаСервере(ЧатСсылка, КэшСообщений, ИДЧата, АктивныйЧат)
	
	ЕстьНепрочитанные = Ложь;
	Для Каждого ДанныеСообщения Из КэшСообщений Цикл
		Если Не ДанныеСообщения.Значение.ПрочитаноОператором Тогда
			ЕстьНепрочитанные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьНепрочитанные Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	               |ГДЕ
	               |	iga_ИсторияСообщений.Чат = &Чат
	               |	И iga_ИсторияСообщений.IDСообщения В(&IDСообщений)";
	Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	IDСообщений = Новый Массив;
	Для Каждого ДанныеСообщения Из КэшСообщений Цикл
		Если Не ДанныеСообщения.Значение.ПрочитаноОператором Тогда
			IDСообщений.Добавить(ДанныеСообщения.Значение.IDСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("IDСообщений", IDСообщений);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.iga_ИсторияСообщений.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.ПрочитаноОператором = Истина;
		Запись.Записать();
	КонецЦикла;
	
	Если АктивныйЧат Тогда
		Бот = Обработки.iga_ChatBot.Создать();
		Бот.ИнициализацияОсновныхПараметров();
		Бот.ОтметитьЧатПрочитанным(ИДЧата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОкноДиалога()
	
	Результат = СформироватьHTMLДиалогаНаСервере(ТекущийЧат, КэшКонтента, УникальныйИдентификатор);
	ТекстДиалогаHTML = Результат.HTML;
	ТекущаяВременнаяМетка = Макс(ТекущаяВременнаяМетка, Результат.ТекущаяВременнаяМетка);
	
	Элементы.ТекстДиалогаHTML.Документ.defaultView.clearMessages();
	
	
	ВывестиСообщенияПриОткрытии(Результат.МассивДанных);
	
	
	
	КэшСообщений = Новый Соответствие;
	Для Каждого СтрИзМассива Из Результат.МассивДанных Цикл
		КэшСообщений.Вставить(СтрИзМассива.IDСообщения, СтрИзМассива);
		Если ЗначениеЗаполнено(СтрИзМассива.IDЦитируемогоСообщения) Тогда
			СтруктураЦитируемогоСообщения = iga_ОбщегоНазначенияКлиентСервер.СкопироватьПоляСтруктуры(СтрИзМассива);
			СтруктураЦитируемогоСообщения.Текст = СтрИзМассива.ТекстЦитирования;
			СтруктураЦитируемогоСообщения.Автор = СтрИзМассива.АвторЦитирования;
			СтруктураЦитируемогоСообщения.ПрочитаноОператором = СтрИзМассива.ПрочитаноОператором;
			КэшСообщений.Вставить(СтрИзМассива.IDЦитируемогоСообщения, СтруктураЦитируемогоСообщения);
		КонецЕсли;
	КонецЦикла;
	
	ПрочитатьСообщенияНаСервере(ТекущийЧат, КэшСообщений, ИдЧата, Ложь);
	
	ЦитируемоеСообщениеИд = "";
	
	Элементы.ТекстДиалогаHTML.Документ.defaultView.scrollEnd();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНаПодключениеПриАктивизацииСтроки(Элемент)
	
    ОтключитьОбработчикОжидания("ОбновитьОкноДиалога");
    ПодключитьОбработчикОжидания("ОбновитьОкноДиалога", 0.2, Истина);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПеревестиНаОператораНаСервере(Оператор, Чат)
	
	ЗаписьОжидания = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
	ЗаписьОжидания.Чат = Чат;
	ЗаписьОжидания.Оператор = Оператор;
	ЗаписьОжидания.Прочитать();
	ДатаПоступления = ТекущаяДата();
	Если ЗаписьОжидания.Выбран() Тогда 
		ЗаписьОжидания.Удалить();
		ДатаПоступления = ЗаписьОжидания.ДатаПоследнейАктивности;
	КонецЕсли;
	
	БезОповещения = iga_МетодыРаботыСБотом.ПолучитьЗначениеПараметраОбщения(Чат, "БезОповещения");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ПоследниеСообщенияЧатов.ЭтоВходящее КАК ЭтоВходящее
	               |ИЗ
	               |	РегистрСведений.iga_ПоследниеСообщенияЧатов КАК iga_ПоследниеСообщенияЧатов
	               |ГДЕ
	               |	iga_ПоследниеСообщенияЧатов.Чат = &Чат
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	iga_ПоследниеСообщенияЧатов.ДатаСообщения УБЫВ";
	Запрос.УстановитьПараметр("Чат", Чат);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ВходящееСобщение = Выборка.ЭтоВходящее;
	
	ЗаписьОжидания.Оператор = Оператор;
	ЗаписьОжидания.Чат = Чат;
	ЗаписьОжидания.БезОповещения = БезОповещения;

&НаСервере
Процедура ОбновитьСписокЧатовНаСервере()
	
	СписокЧатов.Очистить();
	
	Бот = Обработки.iga_ChatBot.Создать();
	Бот.ИнициализацияОсновныхПараметров();
	// Получаем массив структур через API
	МассивЧатов = Бот.ПолучитьЧатыБота(); 
	
	Для Каждого СтрЧат Из МассивЧатов Цикл
		НоваяСтрока = СписокЧатов.Добавить();
		НоваяСтрока.Пометка      = Ложь;
		
		Если СтрДлина(Лев(СтрЧат.id, СтрНайти(СтрЧат.id, "@") - 1)) = 10 Тогда
			НоваяСтрока.ИдЧата       = "7" + СтрЧат.id;
		Иначе
			НоваяСтрока.ИдЧата       = СтрЧат.id;
		КонецЕсли;
		НоваяСтрока.Наименование = ?(СтрЧат.Свойство("name"), СтрЧат.name, СтрЧат.id);
	КонецЦикла;
	
	Сообщить("Список чатов обновлен. Всего найдено: " + СписокЧатов.Количество());
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИсториюНаСервере()
	
	КолвоЗагружено = 0;
	Бот = Обработки.iga_ChatBot.Создать();
	Бот.ИнициализацияОсновныхПараметров();
	
	Для Каждого СтрокаЧата Из СписокЧатов Цикл
		
		Если Не СтрокаЧата.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		// 1. Ищем чат в базе или создаем новый
		ЧатСсылка = НайтиИлиСоздатьЧат(СтрокаЧата.ИдЧата, СтрокаЧата.Наименование);
		
		Попытка
			// 2. Получаем историю через API сервиса
			МассивИстории = Бот.ПолучитьИсториюЧатаИзСервиса(СтрокаЧата.ИдЧата, КоличествоСообщений);
			
			// 3. Загружаем историю в регистры/документы 1С
			// Последний параметр Ложь (не уведомлять операторов о старых сообщениях)
			Бот.ЗагрузитьИсториюВБазу(ЧатСсылка, СтрокаЧата.ИдЧата, МассивИстории, Ложь);
			
			КолвоЗагружено = КолвоЗагружено + 1;
		Исключение
			ЗаписьЖурналаРегистрации("WhatsApp.ЗагрузкаИстории", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка загрузки чата " + СтрокаЧата.ИдЧата + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщить("Загрузка завершена. Обработано чатов: " + КолвоЗагружено);
	
КонецПроцедуры

&НаСервере
Функция НайтиИлиСоздатьЧат(ИдЧата, Наименование)
	
	ЧатСсылка = Справочники.iga_Чаты.НайтиПоРеквизиту("Идентификатор", ИдЧата);
	
	Если ЧатСсылка.Пустая() Тогда
		ОбъектЧат = Справочники.iga_Чаты.СоздатьЭлемент();
		ОбъектЧат.Идентификатор       = ИдЧата;
		ОбъектЧат.Наименование = Наименование;
		ОбъектЧат.Записать();
		Возврат ОбъектЧат.Ссылка;
	КонецЕсли;
	
	Возврат ЧатСсылка;
	
КонецФункции

// --- Обработчики команд ---

&НаКлиенте
Процедура ОбновитьСписокЧатов(Команда)
	ОбновитьСписокЧатовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИсторию(Команда)
	Если КоличествоСообщений = 0 Тогда
		Сообщить("Укажите количество сообщений для загрузки!");
		Возврат;
	КонецЕсли;
	
	ЗагрузитьИсториюНаСервере();
КонецПроцедуры
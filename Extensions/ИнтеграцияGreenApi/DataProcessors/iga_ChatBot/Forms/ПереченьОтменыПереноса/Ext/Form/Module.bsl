
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Чат = Параметры.Чат;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_Чаты.Ссылка КАК Чат,
	               |	iga_Чаты.Идентификатор КАК ИдЧата,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Заявка КАК Заявка,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Работа КАК Работа,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Статус КАК Статус,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.ДатаЗаписи КАК ДатаЗаписи
	               |ИЗ
	               |	Справочник.iga_Чаты КАК iga_Чаты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
	               |		ПО iga_Чаты.Клиент = iga_СтатусыПодтвержденияСтрокЗаявок.Заявка.Клиент
	               |ГДЕ
	               |	НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Обработано
	               |	И НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Статус = &СтатусПодтверждена
	               |	И НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Статус = &СтатусПусто
	               |	И НЕ iga_СтатусыПодтвержденияСтрокЗаявок.Статус = &СтатусНеОтвечает
	               |	И iga_Чаты.Ссылка = &Чат";
	Запрос.УстановитьПараметр("СтатусПодтверждена", Перечисления.iga_СтатусыПодтвержденияЗаявок.Подтверждено);
	Запрос.УстановитьПараметр("СтатусПусто", Перечисления.iga_СтатусыПодтвержденияЗаявок.ПустаяСсылка());
	Запрос.УстановитьПараметр("СтатусНеОтвечает", Перечисления.iga_СтатусыПодтвержденияЗаявок.ПустаяСсылка());
	Запрос.УстановитьПараметр("Чат", Чат);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СписокПозиций.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры


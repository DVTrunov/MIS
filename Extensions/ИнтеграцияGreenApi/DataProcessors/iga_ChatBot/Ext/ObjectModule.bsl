Функция ПолучитьЧатСсылка(ДанныеОтправителя) Экспорт
	Идентификатор = ДанныеОтправителя.chatId;
	Если ДанныеОтправителя.chatName = "" Тогда
		Имя = ДанныеОтправителя.chatId;
	Иначе
		Имя = ДанныеОтправителя.chatName + " (" + Идентификатор + ")";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_Чаты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.iga_Чаты КАК iga_Чаты
	               |ГДЕ
	               |	iga_Чаты.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		НовыйЧат = Справочники.iga_Чаты.СоздатьЭлемент();
		НовыйЧат.Идентификатор = Идентификатор;
		НовыйЧат.Наименование = Имя;
		НовыйЧат.Записать();
		Возврат НовыйЧат.Ссылка;
	КонецЕсли;
КонецФункции

Функция ПроверитьМеткуНаУникальность(ЧатСсылка, ВременнаяМетка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ИсторияСообщений.IDСообщения КАК IDСообщения,
	               |	МАКСИМУМ(iga_ИсторияСообщений1.ВременнаяМетка) КАК ВременнаяМетка
	               |ИЗ
	               |	РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений1
	               |		ПО iga_ИсторияСообщений.Чат = iga_ИсторияСообщений1.Чат
	               |			И (iga_ИсторияСообщений.ВременнаяМетка <= iga_ИсторияСообщений1.ВременнаяМетка)
	               |ГДЕ
	               |	iga_ИсторияСообщений.ВременнаяМетка = &ВременнаяМетка
	               |	И iga_ИсторияСообщений.Чат = &ЧатСсылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	iga_ИсторияСообщений.IDСообщения";
	Запрос.УстановитьПараметр("ЧатСсылка", ЧатСсылка);
	Запрос.УстановитьПараметр("ВременнаяМетка", ВременнаяМетка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ВременнаяМетка;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.ВременнаяМетка + 1;
	КонецЕсли;
	
КонецФункции

Функция ЗаписатьВИсторию(СтруктураСообщения) Экспорт
	
	Если СтруктураСообщения.IDСообщения = "" Тогда
		Возврат iga_ОбщегоНазначенияКлиентСервер.ПолучитьУникальнуюВременнуюМетку(); 
	КонецЕсли;
	
	Менеджер = РегистрыСведений.iga_ИсторияСообщений.СоздатьМенеджерЗаписи();
	Менеджер.Чат = СтруктураСообщения.ЧатСсылка;
	Менеджер.IDСообщения = СтруктураСообщения.IDСообщения;
	
	Менеджер.Текст = СтруктураСообщения.Текст;
	Менеджер.ТипСообщения = СтруктураСообщения.Тип;
	Менеджер.ЭтоВходящее = СтруктураСообщения.ВходящееСообщение;
	Менеджер.Оператор = СтруктураСообщения.СсылкаОператор;
	Менеджер.ПрочитаноОператором = СтруктураСообщения.Прочитано;
	Менеджер.IDЦитируемогоСообщения = СтруктураСообщения.IDЦитируемогоСобщения;
	Менеджер.ТекстЦитирования = СтруктураСообщения.ТекстЦитирования;
	Менеджер.АвторЦитирования = СтруктураСообщения.АвторЦитирования;
	Если СтруктураСообщения.Свойство("ВременнаяМетка") Тогда
		
		ТекущаяДатаЮникс = iga_ОбщегоНазначенияКлиентСервер.ПолучитьUnixTimestamp(ТекущаяДата());
		
		Если СтрДлина(ТекущаяДатаЮникс) = СтрДлина(СтруктураСообщения.ВременнаяМетка) Тогда
			НоваяВременнаяМетка = ПроверитьМеткуНаУникальность(СтруктураСообщения.ЧатСсылка, СтруктураСообщения.ВременнаяМетка*1000);
		Иначе
			НоваяВременнаяМетка = СтруктураСообщения.ВременнаяМетка;
		КонецЕсли;
		
		Менеджер.ВременнаяМетка = НоваяВременнаяМетка;
		Если СтруктураСообщения.Свойство("ВременнаяМеткаСообщения") Тогда
			Менеджер.ДатаСообщения = iga_ОбщегоНазначенияКлиентСервер.ПолучитьДатуИзUnix(СтруктураСообщения.ВременнаяМеткаСообщения);
		Иначе
			Менеджер.ДатаСообщения = iga_ОбщегоНазначенияКлиентСервер.ПолучитьДатуИзUnix(Менеджер.ВременнаяМетка); 
		КонецЕсли;
	Иначе
		НоваяВременнаяМетка = iga_ОбщегоНазначенияКлиентСервер.ПолучитьУникальнуюВременнуюМетку();
		Менеджер.ВременнаяМетка = НоваяВременнаяМетка;
		Менеджер.ДатаСообщения = ТекущаяДата();
	КонецЕсли;
	
	ЗаписьКонтроля = РегистрыСведений.iga_КонтрольНовыхСообщений.СоздатьМенеджерЗаписи();
	ЗаписьКонтроля.ВременнаяМеткаНовыхСообщений = НоваяВременнаяМетка;
	ЗаписьКонтроля.Записать();
	
	Если СтруктураСообщения.Свойство("ЕстьФайл") Тогда
		Менеджер.ЕстьФайл = СтруктураСообщения.ЕстьФайл;
		
		РегФайлы = РегистрыСведений.iga_ПрикрепленныеФайлы.СоздатьМенеджерЗаписи();
        РегФайлы.IDСообщения = СтруктураСообщения.IDСообщения;
        
        РегФайлы.Статус      = ПредопределенноеЗначение("Перечисление.iga_СтатусыОбработкиФайлов.Ожидает");
        РегФайлы.ТипМедиа    = ПолучитьТипМедиаПоТипуСообщения(СтруктураСообщения.Тип);
        РегФайлы.URLЗагрузки = СтруктураСообщения.СсылкаНаФайл;
        РегФайлы.ИмяФайла    = СтруктураСообщения.ИмяФайла;
        
        РегФайлы.КартинкаФайла = СтруктураСообщения.КартинкаФайла;
        
        РегФайлы.РазмерФайла = СтруктураСообщения.РазмерФайла;
        
        РегФайлы.Записать();
		
	КонецЕсли;
	Менеджер.Записать();
	
	
    Если Не ЗначениеЗаполнено(СтруктураСообщения.СсылкаОператор) Тогда
        Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	iga_ОчередьРаспределения.Оператор КАК Оператор
		               |ИЗ
		               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
		               |ГДЕ
		               |	iga_ОчередьРаспределения.Чат = &Чат
		               |	И iga_ОчередьРаспределения.Статус = &Статус";
		Запрос.УстановитьПараметр("Чат", СтруктураСообщения.ЧатСсылка);
		Запрос.УстановитьПараметр("Статус", Перечисления.iga_СтатусыОчереди.ВРаботе);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтруктураСообщения.СсылкаОператор = Выборка.Оператор;
		КонецЕсли;
    КонецЕсли;

	МенеджерОчереди = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
    МенеджерОчереди.Чат = СтруктураСообщения.ЧатСсылка;
    МенеджерОчереди.Оператор = СтруктураСообщения.СсылкаОператор;
    
    МенеджерОчереди.Прочитать();
    Если МенеджерОчереди.Выбран() Тогда
        МенеджерОчереди.ДатаПоследнейАктивности = ТекущаяДата();
		МенеджерОчереди.ПоследнимПисалОператор = Не СтруктураСообщения.ВходящееСообщение;
        МенеджерОчереди.Записать();
	КонецЕсли;
	
	Возврат НоваяВременнаяМетка;
	
КонецФункции

Функция ЕстьОнлайнОператоры()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	iga_НастройкиОператоров.Оператор КАК Оператор
	               |ИЗ
	               |	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |ГДЕ
	               |	iga_НастройкиОператоров.Статус = ЗНАЧЕНИЕ(Перечисление.iga_СтатусыОператоров.Онлайн)";
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ПоставитьВОчередь(ЧатСсылка, БезСообщения = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Статус
		|ИЗ
		|	РегистрСведений.iga_ОчередьРаспределения
		|ГДЕ
		|	Чат = &Чат
		|	И Статус <> ЗНАЧЕНИЕ(Перечисление.iga_СтатусыОчереди.Завершен) И Статус <> ЗНАЧЕНИЕ(Перечисление.iga_СтатусыОчереди.ОбщениеСБотом) ";
	
	Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Менеджер = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		Менеджер.Чат = ЧатСсылка;
		Менеджер.Оператор = Неопределено;
		Менеджер.Статус = Перечисления.iga_СтатусыОчереди.Ожидание;
		Менеджер.ДатаПоступления = ТекущаяДата();
		Менеджер.Записать();
		
		Менеджер = РегистрыСведений.iga_ПоследниеСтатусыЧатов.СоздатьМенеджерЗаписи();
		Менеджер.Чат = ЧатСсылка;
		Менеджер.СтатусОчереди = Перечисления.iga_СтатусыОчереди.Ожидание;
		Менеджер.Записать(); 

		
		iga_МетодыРаботыСБотом.УстановитьПараметрОбщения(ЧатСсылка, "ОтправленоОповещение", Ложь);
		
		ИдЧата = iga_ОбщегоНазначенияСервер.ПолучитьЗначенияРеквизитов(ЧатСсылка, "Идентификатор");
		
		БезОповещения = iga_МетодыРаботыСБотом.ПолучитьЗначениеПараметраОбщения(ЧатСсылка, "БезОповещения");
		
		Если Не БезСообщения И Не БезОповещения = Истина Тогда
			
			КодЯзыка = iga_МетодыРаботыСБотом.ПолучитьЗначениеПараметраОбщения(ЧатСсылка, "Язык");
			
			ТекстПриветствия = iga_ШаблоныСообщений.ПолучитьТекстСообщения(Перечисления.iga_ТипыТекстовСообщений.ТекстПросьбыОжиданияОператора, КодЯзыка);
			
			ТекущееВремя = Дата(1,1,1) + (ТекущаяДата() - НачалоДня(ТекущаяДата()));
			
			Если ЗначениеЗаполнено(Константы.iga_ВремяНачалаРабочегоДня.Получить()) 
				И Не (ТекущееВремя >= Константы.iga_ВремяНачалаРабочегоДня.Получить() И ТекущееВремя <= Константы.iga_ВремяОкончанияРабочегоДня.Получить()) Тогда
				
				ТекстПриветствия = iga_ШаблоныСообщений.ПолучитьТекстСообщения(Перечисления.iga_ТипыТекстовСообщений.ТекстПросьбыОжидатьОператораВРабочееВремя, КодЯзыка);
			КонецЕсли;
			
			РезультатБот = ОтправитьТекст(ИдЧата, ТекстПриветствия);
			
			СтруктураСообщения = Новый Структура;
			СтруктураСообщения.Вставить("ЧатСсылка", ЧатСсылка);
			СтруктураСообщения.Вставить("ИдЧата", ИдЧата);
			СтруктураСообщения.Вставить("IDСообщения", РезультатБот.idMessage);
			СтруктураСообщения.Вставить("Текст", ТекстПриветствия);
			СтруктураСообщения.Вставить("Тип", "textMessage");
			СтруктураСообщения.Вставить("ВходящееСообщение", Ложь);
			СтруктураСообщения.Вставить("IDЦитируемогоСобщения", "");
			СтруктураСообщения.Вставить("ТекстЦитирования", "");
			СтруктураСообщения.Вставить("АвторЦитирования", "");
			СтруктураСообщения.Вставить("СсылкаОператор");
			СтруктураСообщения.Вставить("Прочитано", Ложь);
			
			ЗаписатьВИсторию(СтруктураСообщения);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Процедура ПолучитьИОбработатьСообщенияИзОчереди() Экспорт
	
	Инстанс = IdInstance;
	Токен = ApiToken;
	
	ТипыУведомлений = Новый Структура;
	ТипыУведомлений.Вставить("ВходящееСообщение", "incomingMessageReceived");
	ТипыУведомлений.Вставить("ИсходящееСообщениеAPI", "outgoingAPIMessageReceived");
	ТипыУведомлений.Вставить("ИсходящееСообщение", "outgoingMessageReceived");
	ТипыУведомлений.Вставить("СтатусОтправленногоСообщения", "outgoingMessageStatus");
	ТипыУведомлений.Вставить("СостояниеАккаунта", "stateInstanceChanged");
	ТипыУведомлений.Вставить("СостояниеТелефона", "deviceInfo");
	
	СтруктураУведомлений = ПолучитьУведомления();
	
	УдаляемыеСообщения = Новый Массив;
	
	Для Каждого ДанныеЧата Из СтруктураУведомлений.chats Цикл
		
		ПолнаяОбработкаСообщения = Истина;
		Для Каждого ДанныеСообщения Из ДанныеЧата.messages Цикл
			
			
			Если ПолучатьВходящиеУведомления Тогда
				ТегСообщения = Формат(ДанныеСообщения.receiptId, "ЧГ=0");
			Иначе
				ТегСообщения = ДанныеСообщения.receiptId; 
			КонецЕсли;
			
			Если ДанныеСообщения.body.typeWebhook = ТипыУведомлений.ВходящееСообщение  Тогда
				
				ОбработатьВходящееУведомление(ДанныеСообщения, ПолнаяОбработкаСообщения);
				
				ПолнаяОбработкаСообщения = Ложь;
			ИначеЕсли ДанныеСообщения.body.typeWebhook = ТипыУведомлений.ИсходящееСообщение 
				Или ДанныеСообщения.body.typeWebhook = ТипыУведомлений.ИсходящееСообщениеAPI Тогда
				
				ОбработатьИсходящееУведомление(ДанныеСообщения);
				
			КонецЕсли;
			
			УдаляемыеСообщения.Добавить(Новый Структура("ИдЧата, ВременнаяМетка", ДанныеЧата.chatId, ДанныеСообщения.receiptId));
			
		КонецЦикла;
		
	КонецЦикла;
	
	УдалитьУведомления(УдаляемыеСообщения);
	
	

//  ЧтениеJSON  - Ответ сервера
//
Функция ОтправитьВыборИзКнопок(ИдЧата, Заголовок, ТелоСообщения, Подвал, Кнопки) Экспорт
	
	//"buttons": [ 
	//{"type":"copy", "buttonId":"1", "buttonText":"Копировать", "copyCode":"123"}, 
	//{"type":"url", "buttonId":"2", "buttonText":"Перейти по ссылке", "url":"Ссылка"}, 
	//{"type":"reply", "buttonId":"3", "buttonText":"Цитировать"}  ]
	//}'
	
	
	Инстанс = IdInstance;
	Токен = ApiToken;
	
	Структура = Новый Структура;
	Структура.Вставить("chatId", ИдЧата);
	Структура.Вставить("body", ТелоСообщения);
	Если ЗначениеЗаполнено(Заголовок) Тогда
		Структура.Вставить("header", Заголовок);
	КонецЕсли;
	МассивКнопок = Новый Массив;
	Структура.Вставить("buttons", МассивКнопок);
	Для Каждого Кнопка Из Кнопки Цикл
		
		СтруктураКнопки = Новый Структура;
		Если Кнопка.ТипКнопки = Перечисления.iga_ТипыКнопокСообщения.Копирование Тогда
			СтруктураКнопки.Вставить("type", "copy");
			СтруктураКнопки.Вставить("copyCode", Кнопка.ЗначениеКнопки);
		ИначеЕсли Кнопка.ТипКнопки = Перечисления.iga_ТипыКнопокСообщения.ПереходПоСсылке Тогда
			СтруктураКнопки.Вставить("type", "url");
			СтруктураКнопки.Вставить("url", Кнопка.ЗначениеКнопки);
		ИначеЕсли Кнопка.ТипКнопки = Перечисления.iga_ТипыКнопокСообщения.Ответ Тогда
			СтруктураКнопки.Вставить("type", "reply");
		КонецЕсли;
		
		СтруктураКнопки.Вставить("buttonId", Кнопка.Идентификатор);
		СтруктураКнопки.Вставить("buttonText", Кнопка.ТекстКнопки);
		МассивКнопок.Добавить(СтруктураКнопки);
		
	КонецЦикла;
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Структура);
	Тело = Запись.Закрыть();
	
	Возврат ОтправитьPOSTЗапрос(ХостПоУмолчанию(), URLМетодаСервиса(Инстанс, Токен, "SendInteractiveButtons"), Тело);
	
КонецФункции

// Метод предназначен для отправки файла, загружаемого через форму (form-data). 
// Сообщение будет добавлено в очередь на отправку. Скорость отправки сообщений из
// очереди регулирует параметр Интервал отправки сообщений.
// Подробнее https://green-api.com/docs/api/sending/SendFileByUpload/
//
// Параметры:
//  Телефон - Строка - Номер мобильного телефона
//  ПутьКФайлу- -  Полный путь к файлу на диске
//  Сообщение - Строка - Текст сообщения. Поддерживаются символы emoji 
// 
// Возвращаемое значение:
//  ЧтениеJSON  - Ответ сервера
//
Функция ОтправитьВидеоАудиоИзображениеДокумент(ИдЧата = "", ПутьКФайлу, Сообщение, ИмяФайла = "") Экспорт
	
	Инстанс = IdInstance;
	Токен = ApiToken;
	Хост = ХостПоУмолчанию();
	
	ОтправляемыйФайл = Новый Файл(ПутьКФайлу);
	
	// подготовим файлы с данными для отправки
	массивФайлов = Новый Массив;
	Boundary = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	имяФайлаСПараметрами = ПолучитьимяВременногоФайла("txt"); // первый файл, содержащий параметры
	ЗаписьТекста = Новый ЗаписьТекста(имяФайлаСПараметрами);
	
    ФайлНаДиске = Новый Файл(ПутьКФайлу);
    // 4. Добавление файла
	Если ИмяФайла = "" Тогда
    	ИмяФайла = ФайлНаДиске.Имя;
	КонецЕсли;
	// параметр "chatId"
	ЗаписьТекста.ЗаписатьСтроку("--"+boundary);
    // 1. Поле chatId
    ЗаписатьПолеМультипарт(ЗаписьТекста, Boundary, "chatId", ИдЧата);
    
    // 2. Поле caption
    ЗаписатьПолеМультипарт(ЗаписьТекста, Boundary, "caption", Сообщение);
    
    // 3. Поле fileName
    ЗаписатьПолеМультипарт(ЗаписьТекста, Boundary, "fileName", ИмяФайла);
    
    ЗаписьТекста.ЗаписатьСтроку("--" + Boundary);
    ЗаписьТекста.ЗаписатьСтроку("Content-Disposition: form-data; name=""file""; filename=""" + ИмяФайла + """");
	
	ТипКонтента = СоответствиеMimeTypes().Получить(ФайлНаДиске.Расширение);
	
	Если ТипКонтента = Неопределено Тогда
		ТипКонтента = "text/plain";
	КонецЕсли;
	
    ЗаписьТекста.ЗаписатьСтроку("Content-Type: " + ТипКонтента); // Тип можно уточнять динамически
    ЗаписьТекста.ЗаписатьСтроку(""); // Пустая строка перед данными
	ЗаписьТекста.Закрыть(); // заканчиваем работу с файлом 1
	
	массивФайлов.Добавить(имяФайлаСПараметрами); // добавляем 1-ый файл для объединения
	массивФайлов.Добавить(ПутьКФайлу); // добавляем фото для объединения
	
	// третий файл, закрывающий параметры
	имяФайлаСПараметрами = ПолучитьимяВременногоФайла("txt");
	
	ЗаписьТекста = Новый ЗаписьТекста(имяФайлаСПараметрами);
	
	ЗаписьТекста.ЗаписатьСтроку("");
	ЗаписьТекста.ЗаписатьСтроку("--"+boundary+"--");
	
	ЗаписьТекста.Закрыть(); // заканчиваем работу с файлом
	
	массивФайлов.Добавить(имяФайлаСПараметрами); // добавляем файл, закрывающий параметры
	
	// результирующий файл, который и будет отправлен
	имяФайлаОтправки = ПолучитьИмяВременногоФайла("out");
	
	// объединим все файлы
	ОбъединитьФайлы(массивФайлов, имяФайлаОтправки);
	
	ФайлОтправки = Новый Файл(имяФайлаОтправки);
	РазмерФайлаОтправки = XMLСтрока(ФайлОтправки.Размер());
	
	// передадим данные на сервер 
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary="+boundary);
	Заголовки.Вставить("Content-Lenght", РазмерФайлаОтправки);
	
	Ответ = ОтправитьФайлPOSTЗапрос(Хост, URLМетодаСервиса(Инстанс, Токен, "sendFileByUpload"), Заголовки, ФайлОтправки);
	
	Возврат Ответ;
	
КонецФункции

// Метод предназначен для отправки файла, загружаемого по ссылке.
// Сообщение будет добавлено в очередь на отправку. Скорость отправки сообщений из 
// очереди регулирует параметр Интервал отправки сообщений.
// Подробнее https://green-api.com/docs/api/sending/SendFileByUrl/
//
// Параметры:
//  Телефон - Строка - Номер мобильного телефона
//  УРЛФайла - Строка - Интернет-ссылка на файл
//  ИмяФайла - Строка - Название файла обязательно с расширением. Например: readme.txt
//  Заголовок - Строка - Представление файла для whatsapp-а

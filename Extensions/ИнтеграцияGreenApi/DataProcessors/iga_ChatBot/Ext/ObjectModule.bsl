
Перем ДатаОкончанияХолодногоЗапуска Экспорт;
Перем ДатаНачалаХолодногоЗапуска Экспорт;
Перем ВремяРаботыОператоров Экспорт;
Перем ДатаНачалаОбработкиСообщений Экспорт;
Перем ХешТекущейБазы Экспорт;
Перем СтартовыйСценарий Экспорт;

Процедура ОбновитьСтатусСервиса() Экспорт
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СтатусСервиса = ПолучитьСтатусСервиса();
	
	Если СтатусСервиса Тогда
		НастройкиСервиса = ПолучитьНастройкиАккаунта();

		ПолучатьВходящиеУведомления = ЗначениеЗаполнено(НастройкиСервиса.webhookUrl) И НастройкиСервиса.webhookUrl = ХостВебхуковПоУмолчанию();
		webhookUrl = НастройкиСервиса.webhookUrl;
		ПолучатьВходящиеСообщенияИФайлы = НастройкиСервиса.incomingWebhook = "yes";
		ПолучатьСтатусыОтправленныхСообщений = НастройкиСервиса.outgoingWebhook = "yes";
		ПолучатьУведомленииОСостоянииТелефона = НастройкиСервиса.deviceWebhook = "yes";
		ПолучатьУведомленияОСостоянииАккаунта = НастройкиСервиса.stateWebhook = "yes";
		ОтмечатьВходящиеСообщенияПрочитанными = НастройкиСервиса.markIncomingMessagesReaded = "yes";
		ИнтервалОтправкиСообщений = Макс(НастройкиСервиса.delaySendMessagesMilliseconds, ИнтервалОтправкиСообщений);
		
		ЕстьНестадантныенастройки = Не (ЗначениеЗаполнено(НастройкиСервиса.webhookUrl) И НастройкиСервиса.webhookUrl = ХостВебхуковПоУмолчанию());
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализацияОсновныхПараметров() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_НастройкиИнстансов.iga_apiUrl КАК iga_apiUrl,
	               |	iga_НастройкиИнстансов.iga_mediaUrl КАК iga_mediaUrl,
	               |	iga_НастройкиИнстансов.iga_IdInstance КАК iga_IdInstance,
	               |	iga_НастройкиИнстансов.iga_ApiToken КАК iga_ApiToken,
	               |	iga_НастройкиИнстансов.iga_webhookUrl КАК iga_webhookUrl,
	               |	iga_НастройкиИнстансов.iga_ПользовательВебХука КАК iga_ПользовательВебХука,
	               |	iga_НастройкиИнстансов.iga_ПарольВебхука КАК iga_ПарольВебхука,
	               |	iga_НастройкиИнстансов.iga_ПортВебХука КАК iga_ПортВебХука
	               |ИЗ
	               |	Справочник.iga_НастройкиИнстансов КАК iga_НастройкиИнстансов
	               |ГДЕ
	               |	iga_НастройкиИнстансов.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Константы.iga_ТекущийИнстанс.Получить());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ApiToken = Выборка.iga_ApiToken;
		apiUrl = Выборка.iga_apiUrl;
		IdInstance = Выборка.iga_IdInstance;
		mediaUrl = Выборка.iga_mediaUrl;
		webhookUrl = Выборка.iga_webhookUrl;
		ПользовательВебХука = Выборка.iga_ПользовательВебХука;
		ПарольВебХука = Выборка.iga_ПарольВебхука;
		ПортВебХука = Выборка.iga_ПортВебХука;
		ИнтервалОтправкиСообщений = 500;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТипМедиаПоТипуСообщения(ТипСообщения)
    
    Если ТипСообщения = "imageMessage" Тогда
        Возврат ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Картинка");
    ИначеЕсли ТипСообщения = "videoMessage" Тогда
        Возврат ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Видео");
    ИначеЕсли ТипСообщения = "audioMessage" Тогда
        Возврат ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Аудио");
    ИначеЕсли ТипСообщения = "documentMessage" Тогда
        Возврат ПредопределенноеЗначение("Перечисление.iga_ТипыМедиаФайлов.Документ");
    КонецЕсли;
    
    Возврат Неопределено;
    
КонецФункции

Функция ОтправитьПростоеСообщение(ЧатСсылка, ИдЧата, ТекстСообщения) Экспорт
	
	РезультатБот = ОтправитьТекст(ИдЧата, ТекстСообщения);
	
	СтруктураСообщения = Новый Структура;
	СтруктураСообщения.Вставить("ЧатСсылка", ЧатСсылка);
	СтруктураСообщения.Вставить("ИдЧата", ИдЧата);
	СтруктураСообщения.Вставить("IDСообщения", РезультатБот.idMessage);
	СтруктураСообщения.Вставить("Текст", ТекстСообщения);
	СтруктураСообщения.Вставить("Тип", "textMessage");
	СтруктураСообщения.Вставить("ВходящееСообщение", Ложь);
	СтруктураСообщения.Вставить("IDЦитируемогоСобщения", "");
	СтруктураСообщения.Вставить("ТекстЦитирования", "");
	СтруктураСообщения.Вставить("АвторЦитирования", "");
	СтруктураСообщения.Вставить("СсылкаОператор", Неопределено);
	СтруктураСообщения.Вставить("Прочитано", Ложь);
	
	ТекущаяВременнаяМетка = ЗаписатьВИсторию(СтруктураСообщения);
	
	СтруктураВозврата = Новый Структура("IDСообщения, Текст, Дата, ТекущаяВременнаяМетка",
		РезультатБот.idMessage, ТекстСообщения, ТекущаяДата(), ТекущаяВременнаяМетка);
			
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПропускШаблона(ИдШаблона)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ПропускаемыеОтветыШаблонов.Шаблон КАК Шаблон
	               |ИЗ
	               |	РегистрСведений.iga_ПропускаемыеОтветыШаблонов КАК iga_ПропускаемыеОтветыШаблонов
	               |ГДЕ
	               |	iga_ПропускаемыеОтветыШаблонов.Шаблон.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдШаблона);
	ПропуститьСообщение = Не Запрос.Выполнить().Пустой();
	
	Возврат ПропуститьСообщение;
	
КонецФункции

Процедура ОбработатьВходящееУведомление(ДанныеУведомления, ПолнаяОбработкаСообщения = Истина) Экспорт
	
	Тело = ДанныеУведомления.body;
	ТипУведомления = Тело.typeWebhook;
	
	ВременнаяМеткаСообщения = ДанныеУведомления.receiptId;
	
	ДанныеСообщения = Тело.messageData;
	ТипСообщения = ДанныеСообщения.typeMessage;
	ДанныеОтправителя = Тело.senderData;
	
	ЧатСсылка = ПолучитьЧатСсылка(ДанныеОтправителя);
	
	ИдЧата = ДанныеОтправителя.chatId;
	
	ТекстСообщения = "";
	ТекстЦитаты = "";
	АвторЦитаты = "";
	ВыборКнопки = "";
	IDЦитируемогоСообщения = "";
	ИдШаблона = "";
	
	СтруктураСообщения = Новый Структура;
	
	Если ТипСообщения = "textMessage" Тогда 
		ТекстСообщения = ДанныеСообщения.textMessageData.textMessage;
		
	ИначеЕсли ТипСообщения = "quotedMessage" Тогда
		ТекстСообщения = ДанныеСообщения.extendedTextMessageData.text;
		
		ДанныеЦитаты = ДанныеСообщения.quotedMessage;
		ТекстЦитаты = ДанныеЦитаты.textMessage; 
		АвторЦитаты = ДанныеЦитаты.participant; 
		
	ИначеЕсли ТипСообщения = "imageMessage" ИЛИ ТипСообщения = "videoMessage" ИЛИ ТипСообщения = "documentMessage" ИЛИ ТипСообщения = "audioMessage" Тогда
		
		ДанныеМедиа = ДанныеСообщения.fileMessageData;
		
		ИмяФайла = ДанныеМедиа.fileName;
		
		РасширениеИзТипа = ПолучитьРасширениеПоMimeType(ДанныеМедиа.mimeType);
		
		Если Не РасширениеИзТипа = Неопределено Тогда 
			Если СтрНайти(ИмяФайла, РасширениеИзТипа) = 0 Тогда
				ИмяФайла = ИмяФайла + РасширениеИзТипа;
			КонецЕсли;
		КонецЕсли;
		
		ТекстСообщения = ?(ДанныеМедиа.Свойство("caption") И Не ДанныеМедиа.caption = "", ДанныеМедиа.caption, "Файл: " + ИмяФайла);
		
		СтруктураСообщения.Вставить("ЕстьФайл", Истина);
		СтруктураСообщения.Вставить("СсылкаНаФайл", ДанныеМедиа.downloadUrl);
		СтруктураСообщения.Вставить("КартинкаФайла", ДанныеМедиа.jpegThumbnail);
		СтруктураСообщения.Вставить("ИмяФайла", ИмяФайла);
		СтруктураСообщения.Вставить("РазмерФайла", 0);
		
	ИначеЕсли ТипСообщения = "interactiveButtonsResponse" Тогда 
		ТекстСообщения = ДанныеСообщения.interactiveButtonsResponse.selectedDisplayText;
		
		ТекстЦитаты = ДанныеСообщения.quotedMessage.interactiveButtons.contentText;
		АвторЦитаты = ДанныеСообщения.quotedMessage.participant;
		ВыборКнопки = ДанныеСообщения.interactiveButtonsResponse.selectedId;
		
		IDЦитируемогоСообщения = ?(ТекстЦитаты = "", "", ДанныеСообщения.quotedMessage.stanzaId);
		
	ИначеЕсли ТипСообщения = "templateButtonsReplyMessage" Тогда 
		ТекстСообщения = ДанныеСообщения.templateButtonReplyMessage.selectedDisplayText;
		
		Если ДанныеСообщения.Свойство("quotedMessageData") Тогда
			ДанныеШаблона = ДанныеСообщения.quotedMessageData.journalMessage.data.templateMessage;
			ИдШаблона = ДанныеШаблона.templateId;
			ПараметрыШаблона = ДанныеШаблона.params;
			
			Если ПропускШаблона(ИдШаблона) Тогда
				ПолнаяОбработкаСообщения = Ложь;
			КонецЕсли;
			
			ТекстЦитаты = Справочники.iga_ШаблоныСообщений.ПолучитьТекстШаблонаПоПараметрам(ИдШаблона, ПараметрыШаблона);;
			АвторЦитаты = ДанныеСообщения.quotedMessageData.participant;
			ВыборКнопки = Справочники.iga_ШаблоныСообщений.ПолучитьНомерКнопки(ИдШаблона, ТекстСообщения);//ДанныеСообщения.templateButtonReplyMessage.selectedIndex; (Временно недоступно, сервис присылает пусто)
			
			IDЦитируемогоСообщения = ?(ТекстЦитаты = "", "", Тело.messageData.quotedMessageData.journalMessage.idMessage);
		КонецЕсли;

	Иначе
		ТекстСообщения = "Обработка данного сообщения в разработке (" + ТипСообщения + ")"; 
		
	КонецЕсли;

	
	ДатаПоследнегоСообщения = iga_МетодыРаботыСБотом.ПолучитьДатуПоследнегоСообщения(ЧатСсылка);
	
	
	СтруктураСообщения.Вставить("ЧатСсылка", ЧатСсылка);
	СтруктураСообщения.Вставить("ИдЧата", ИдЧата);
	СтруктураСообщения.Вставить("IDСообщения", Тело.idMessage);
	СтруктураСообщения.Вставить("Текст", ТекстСообщения);
	СтруктураСообщения.Вставить("Тип", ТипСообщения);
	СтруктураСообщения.Вставить("ВходящееСообщение", Истина);
	СтруктураСообщения.Вставить("IDЦитируемогоСобщения", IDЦитируемогоСообщения);
	СтруктураСообщения.Вставить("ТекстЦитирования", ТекстЦитаты);
	СтруктураСообщения.Вставить("АвторЦитирования", АвторЦитаты);
	СтруктураСообщения.Вставить("СсылкаОператор");
	СтруктураСообщения.Вставить("Прочитано", Ложь);
	СтруктураСообщения.Вставить("ВременнаяМеткаСообщения", Тело.timestamp);
	СтруктураСообщения.Вставить("ВременнаяМетка", ВременнаяМеткаСообщения);
	
	ЗаписатьВИсторию(СтруктураСообщения);
	
	Если СтрНайти(ЧатСсылка.НаименованиеКлиента, "(БЛОК)") > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолнаяОбработкаСообщения Тогда
		Возврат;
	КонецЕсли;

	ДатаСообщенияКакЕсть = iga_ОбщегоНазначенияКлиентСервер.ПолучитьДатуИзUnix(Тело.timestamp);
	
	Если ДатаНачалаОбработкиСообщений > ДатаСообщенияКакЕсть Тогда
		Возврат;
	КонецЕсли;

	//ДанныеПоследнего = ПолучитьПоследнееУведомление(ИдЧата);
	//
	//Если Не ДанныеПоследнего.body.typeWebhook = "incomingMessageReceived" Или ДанныеПоследнего.receiptId > ДанныеУведомления.receiptId Тогда
	//	Возврат;
	//КонецЕсли;
	
	
	Если ДатаСообщенияКакЕсть >= ДатаНачалаХолодногоЗапуска И ДатаСообщенияКакЕсть <= ДатаОкончанияХолодногоЗапуска Тогда
		
		КодЯзыка = iga_МетодыРаботыСБотом.ПолучитьЗначениеПараметраОбщения(ЧатСсылка, "Язык");
		
		ТекстПриветствия = iga_ШаблоныСообщений.ПолучитьТекстСообщения(Перечисления.iga_ТипыТекстовСообщений.ТекстВопросаРешенВопросИлиНет, КодЯзыка);
		РезультатБот = ОтправитьТекст(ЧатСсылка.Идентификатор, ТекстПриветствия);
		
		СтруктураСообщения = Новый Структура;
		СтруктураСообщения.Вставить("ЧатСсылка", ЧатСсылка);
		СтруктураСообщения.Вставить("ИдЧата", ИдЧата);
		СтруктураСообщения.Вставить("IDСообщения", РезультатБот.idMessage);
		СтруктураСообщения.Вставить("Текст", ТекстПриветствия);
		СтруктураСообщения.Вставить("Тип", "textMessage");
		СтруктураСообщения.Вставить("ВходящееСообщение", Ложь);
		СтруктураСообщения.Вставить("IDЦитируемогоСобщения", "");
		СтруктураСообщения.Вставить("ТекстЦитирования", "");
		СтруктураСообщения.Вставить("АвторЦитирования", "");
		СтруктураСообщения.Вставить("СсылкаОператор");
		СтруктураСообщения.Вставить("Прочитано", Ложь);
		СтруктураСообщения.Вставить("ВременнаяМетка", РезультатБот.timestamp);
		
		ЗаписатьВИсторию(СтруктураСообщения);

		
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ОчередьРаспределения.Статус КАК Статус,
	               |	iga_ОчередьРаспределения.Чат КАК Чат
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПараметрыОбщенияСБотом КАК iga_ПараметрыОбщенияСБотом
	               |		ПО iga_ОчередьРаспределения.Чат = iga_ПараметрыОбщенияСБотом.Чат
	               |			И (iga_ПараметрыОбщенияСБотом.Параметр.ИмяПараметра = ""ВыбранноеПодразделение"")
	               |			И (РАЗНОСТЬДАТ(iga_ОчередьРаспределения.ДатаПоследнейАктивности, &ТекущаяДата, ЧАС) < 24)
	               |ГДЕ
	               |	iga_ОчередьРаспределения.Чат = &Чат
	               |	И (НЕ iga_ОчередьРаспределения.Статус = &СтатусЗавершен
	               |			ИЛИ НЕ iga_ПараметрыОбщенияСБотом.Значение ЕСТЬ NULL)
	               |	";
	Запрос.УстановитьПараметр("СтатусЗавершен", Перечисления.iga_СтатусыОчереди.Завершен);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Чат", ЧатСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	ТекущийСтатус = Неопределено;
	ОтправленоОповещение = Ложь;
	Если Выборка.Следующий() Тогда
		ТекущийСтатус = Выборка.Статус;
	Иначе
		ОтправленоОповещение = iga_МетодыРаботыСБотом.ПолучитьЗначениеПараметраОбщения(ЧатСсылка, "ОтправленоОповещение", Ложь);
	КонецЕсли;
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ЧатСсылка", ЧатСсылка);
	ПараметрыПроверки.Вставить("ИдЧата", ИдЧата);
	ПараметрыПроверки.Вставить("ТекстСообщения", ТекстСообщения);
	ПараметрыПроверки.Вставить("ВыборКнопки", ВыборКнопки);
	ПараметрыПроверки.Вставить("ТипСообщения", ТипСообщения);
	ПараметрыПроверки.Вставить("ИдШаблона", ИдШаблона);
	ПараметрыПроверки.Вставить("ИдСообщения", Тело.idMessage);
	ПараметрыПроверки.Вставить("ИдЦитаты", IDЦитируемогоСообщения);
	
	ЗапущенСценарийПоТриггеру = iga_МетодыРаботыСБотом.ЗапускСценарияПоТриггеру(ПараметрыПроверки, Истина);
	
	Если Не ЗапущенСценарийПоТриггеру И (ТекущийСтатус = Неопределено Или ТекущийСтатус = Перечисления.iga_СтатусыОчереди.Завершен 
		Или ТекущийСтатус = Перечисления.iga_СтатусыОчереди.ОбщениеСБотом) Тогда
		
		
		ЗапущенСценарийПоТриггеру = iga_МетодыРаботыСБотом.ЗапускСценарияПоТриггеру(ПараметрыПроверки);
	КонецЕсли;
	
	Если ЗапущенСценарийПоТриггеру Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОтправленоОповещение И (ТекущийСтатус = Неопределено Или ТекущийСтатус = Перечисления.iga_СтатусыОчереди.ОбщениеСБотом) Тогда
		
		iga_БотСценарииСервер.ОбработатьВходящееСообщение(ЧатСсылка, ИдЧата, ТекстСообщения, ВыборКнопки, Ложь, );
		
		Возврат;
	КонецЕсли;
	
	ПоставитьВОчередь(ЧатСсылка);

КонецПроцедуры

Процедура ОбработатьИсходящееУведомление(ДанныеУведомления) Экспорт
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ИсторияСообщений.IDСообщения КАК IDСообщения
	               |ИЗ
	               |	РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	               |ГДЕ
	               |	iga_ИсторияСообщений.IDСообщения = &IDСообщения";
	Запрос.УстановитьПараметр("IDСообщения", ДанныеУведомления.body.idMessage);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Тело = ДанныеУведомления.body;
	ТипУведомления = Тело.typeWebhook;
	
	ДанныеСообщения = Тело.messageData;
	ТипСообщения = ДанныеСообщения.typeMessage;
	ДанныеОтправителя = Тело.senderData;
	
	ЧатСсылка = ПолучитьЧатСсылка(ДанныеОтправителя);
	
	ИдЧата = ДанныеОтправителя.chatId;
	
	ТекстСообщения = "";
	ТекстЦитаты = "";
	АвторЦитаты = "";
	
	IDЦитируемогоСообщения = ?(ТекстЦитаты = "", "", ДанныеСообщения.quotedMessage.stanzaId);
	
	СтруктураСообщения = Новый Структура;
	
	Если ТипСообщения = "textMessage" Тогда 
		ТекстСообщения = ДанныеСообщения.textMessageData.textMessage;
		
	ИначеЕсли ТипСообщения = "extendedTextMessage" Тогда
		ТекстСообщения = ДанныеСообщения.extendedTextMessageData.text;

	ИначеЕсли ТипСообщения = "quotedMessage" Тогда
		ТекстСообщения = ДанныеСообщения.extendedTextMessageData.text;
		
		ДанныеЦитаты = ДанныеСообщения.quotedMessage;
		ТекстЦитаты = ДанныеЦитаты.textMessage; 
		АвторЦитаты = ДанныеЦитаты.participant; 
		
	ИначеЕсли ТипСообщения = "imageMessage" ИЛИ ТипСообщения = "videoMessage" ИЛИ ТипСообщения = "documentMessage" ИЛИ ТипСообщения = "audioMessage" Тогда
		
		ДанныеМедиа = ДанныеСообщения.fileMessageData;
		
		ТекстСообщения = ?(ДанныеМедиа.Свойство("caption"), ДанныеМедиа.caption, "Файл: " + ДанныеМедиа.fileName);
		
		СтруктураСообщения.Вставить("ЕстьФайл", Истина);
		СтруктураСообщения.Вставить("СсылкаНаФайл", ДанныеМедиа.downloadUrl);
		СтруктураСообщения.Вставить("КартинкаФайла", ДанныеМедиа.jpegThumbnail);
		СтруктураСообщения.Вставить("ИмяФайла", ДанныеМедиа.fileName);
		СтруктураСообщения.Вставить("РазмерФайла", 0);
		
	ИначеЕсли ТипСообщения = "templateMessage" И ДанныеСообщения.messageData.Свойство("templateId") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	iga_ШаблоныСообщений.ТекстСообщения КАК ТекстСообщения
		               |ИЗ
		               |	Справочник.iga_ШаблоныСообщений КАК iga_ШаблоныСообщений
		               |ГДЕ
		               |	iga_ШаблоныСообщений.Идентификатор = &Идентификатор";
		Запрос.УстановитьПараметр("Идентификатор", ДанныеСообщения.messageData.templateId);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ТекстСообщения = Выборка.ТекстСообщения;
		Иначе
			ТекстСообщения = "Шаблон сообщения не найден в базе. Чтобы прочитать сообщение, перейдите в веб-чат.";
		КонецЕсли;
	ИначеЕсли ТипСообщения = "interactiveButtons" Тогда 
		ТекстСообщения = ДанныеСообщения.interactiveButtons.contentText;
		ТекстСообщения = ТекстСообщения + "
		|" + ДанныеСообщения.interactiveButtons.titleText;
		Счетчик = 0;
		Для Каждого Кнопка Из ДанныеСообщения.interactiveButtons.buttons Цикл
			Счетчик = Счетчик + 1;
			ТекстСообщения = ТекстСообщения + Символы.ПС + Счетчик + ". " + Кнопка.buttonText;
		КонецЦикла;
		
		
	Иначе
		ТекстСообщения = "Обработка данного сообщения в разработке (" + ТипСообщения + ")"; 
		
	КонецЕсли;
	
	СтруктураСообщения.Вставить("ЧатСсылка", ЧатСсылка);
	СтруктураСообщения.Вставить("ИдЧата", ИдЧата);
	СтруктураСообщения.Вставить("IDСообщения", Тело.idMessage);
	СтруктураСообщения.Вставить("Текст", ТекстСообщения);
	СтруктураСообщения.Вставить("Тип", ТипСообщения);
	СтруктураСообщения.Вставить("ВходящееСообщение", Ложь);
	СтруктураСообщения.Вставить("IDЦитируемогоСобщения", IDЦитируемогоСообщения);
	СтруктураСообщения.Вставить("ТекстЦитирования", ТекстЦитаты);
	СтруктураСообщения.Вставить("АвторЦитирования", АвторЦитаты);
	СтруктураСообщения.Вставить("СсылкаОператор");
	СтруктураСообщения.Вставить("Прочитано", Ложь);
	СтруктураСообщения.Вставить("ВременнаяМетка", Тело.timestamp);
	
	ЗаписатьВИсторию(СтруктураСообщения);

КонецПроцедуры


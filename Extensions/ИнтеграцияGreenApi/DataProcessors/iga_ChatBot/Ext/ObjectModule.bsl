	ТипыУведомлений.Вставить("СостояниеТелефона", "deviceInfo");
	
	Ответ = ПолучитьУведомление();
	Если Ответ <> Неопределено Тогда
		
		Отказ = Ложь;
		ТекстСообщения = Неопределено;
		Если ПолучатьВходящиеУведомления Тогда
			ТегСообщения = Формат(Ответ.receiptId, "ЧГ=0");
		Иначе
			ТегСообщения = Ответ.receiptId; 
		КонецЕсли;
		
		Если Ответ.body.typeWebhook = ТипыУведомлений.ВходящееСообщение  Тогда
			
			ОбработатьВходящееУведомление(Ответ);
			
		ИначеЕсли Ответ.body.typeWebhook = ТипыУведомлений.ИсходящееСообщение 
			Или Ответ.body.typeWebhook = ТипыУведомлений.ИсходящееСообщениеAPI Тогда
			
			ОбработатьИсходящееУведомление(Ответ);
			
		КонецЕсли;
		
		Если Не Отказ Тогда
			УдалитьУведомление(ТегСообщения);
		КонецЕсли;
		
	КонецЕсли;
	

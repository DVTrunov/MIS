Функция ОтправитьТекст(ИдЧатаТелефон, Сообщение, ЦитируемоеСообщениеИд = "") Экспорт
	

	Инстанс = IdInstance;
	Токен = ApiToken;
	
	СтрокаЧисел = "0123456789";
	
	ЭтоНомерТелефона = Истина;
	Для НСтроки = 1 По СтрДлина(ИдЧатаТелефон) Цикл
		Если СтрНайти(СтрокаЧисел, Сред(ИдЧатаТелефон, НСтроки, 1)) = 0 Тогда
			ЭтоНомерТелефона = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Структура = Новый Структура;
	Если Не ЭтоНомерТелефона Тогда
		Структура.Вставить("chatId", ИдЧатаТелефон);
	Иначе
		Структура.Вставить("phoneNumber", ИдЧатаТелефон);
	КонецЕсли;
	Структура.Вставить("message", Сообщение);
	Если ЗначениеЗаполнено(ЦитируемоеСообщениеИд) Тогда
        Структура.Вставить("quotedMessageId", ЦитируемоеСообщениеИд);
    КонецЕсли;
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Структура);
	Тело = Запись.Закрыть();
	
	Попытка
		СтруктураОтвета = ОтправитьPOSTЗапрос(ХостПоУмолчанию(), URLМетодаСервиса(Инстанс, Токен, "sendMessage"), Тело);
	Исключение
		ЗаписьЖурналаРегистрации("WhatsApp. Green API", УровеньЖурналаРегистрации.Ошибка, , , 
			ОписаниеОшибки());
		СтруктураОтвета = Новый Структура("idMessage", "");
	КонецПопытки;
	
	Возврат СтруктураОтвета;
	
КонецФункции


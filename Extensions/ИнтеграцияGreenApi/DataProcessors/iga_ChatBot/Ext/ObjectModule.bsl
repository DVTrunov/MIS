// Метод предназначен для отметки сообщений в чате прочитанными.
// Могут быть отмечены прочитанными все сообщения в чате или только одно заданное сообщение.
// Подробнее https://green-api.com/docs/api/marks/ReadChat/
//
// Параметры:
//  ИдЧата - Строка - Идентификатор группового чата
//  ИдСообщения - Строка - Необязательный. Идентификатор входящего сообщения, которое необходимо отметить прочитанным. 
//    Если не указан, то все непрочитанные сообщения в чате будут отмечены прочитанными.
//
// Возвращаемое значение:
//  ЧтениеJSON  - Ответ сервера
//
Функция ОтметитьЧатПрочитанным(ИдЧата, ИдСообщения = Неопределено) Экспорт
	
	// Временно отключено
	Возврат Неопределено;
	
	Инстанс = IdInstance;
	Токен = ApiToken;
	
	Структура = Новый Структура;
	Структура.Вставить("chatId", ИдЧата);
	Если ЗначениеЗаполнено(ИдСообщения) Тогда
		Структура.Вставить("idMessage", ИдСообщения);
	КонецЕсли;
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Структура);
	Тело = Запись.Закрыть();
	
	Попытка
		Ответ = ОтправитьPOSTЗапрос(ХостПоУмолчанию(), URLМетодаСервиса(Инстанс, Токен, "readChat"), Тело);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось пометить чат прочитанным.";
		Сообщение.Сообщить();
		Ответ = Неопределено;
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

Функция ОтправитьШаблонноеСообщениеПользоватлю(ИдЧата, ИдШаблона, ВходящиеПараметры = Неопределено) Экспорт
	
	Инстанс = IdInstance;
	Токен = ApiToken;
	
	Структура = Новый Структура;
	Структура.Вставить("chatId", ИдЧата);
	Структура.Вставить("templateId", ИдШаблона);
	Если Не ВходящиеПараметры = Неопределено  Тогда
		Если ВходящиеПараметры.Свойство("ПереченьПараметров") Тогда
			Структура.Вставить("params", ВходящиеПараметры.ПереченьПараметров);
		КонецЕсли;
		Если ВходящиеПараметры.Свойство("СсылкаНаИзображение") Тогда
			
			Ссылка = Новый Структура("link", ВходящиеПараметры.СсылкаНаИзображение);
			Сообщение = Новый Структура("type, image", "image", Ссылка);
			Структура.Вставить("message", Сообщение);
		КонецЕсли;
	КонецЕсли;


	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Структура);
	Тело = Запись.Закрыть();
	
	Попытка
		Ответ = ОтправитьPOSTЗапрос(ХостПоУмолчанию(), URLМетодаСервиса(Инстанс, Токен, "SendTemplate"), Тело);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
		Ответ = Сообщение.Текст;
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции


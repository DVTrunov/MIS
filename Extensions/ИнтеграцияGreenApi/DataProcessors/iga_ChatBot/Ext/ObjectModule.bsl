Процедура ЗагрузитьИсториюВБазу(ЧатСсылка, ИдЧата, МассивСообщений, ТолькоНовые = Истина) Экспорт
	
	МассивИДСообщений = Новый Массив;
	Для Каждого Данные Из МассивСообщений Цикл
		МассивИДСообщений.Добавить(Данные.idMessage);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ИсторияСообщений.IDСообщения КАК IDСообщения,
	               |	iga_ИсторияСообщений.Чат КАК Чат,
	               |	iga_ИсторияСообщений.ДатаСообщения КАК Дата
	               |ИЗ
	               |	РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	               |ГДЕ
	               |	iga_ИсторияСообщений.IDСообщения В(&МассивИДСообщений)";
	Запрос.УстановитьПараметр("МассивИДСообщений", МассивИДСообщений);
	ВыборкаСуществующих = Запрос.Выполнить().Выбрать();
	
	Для Индекс = -МассивСообщений.Количество()+1 По 0 Цикл
		
		Данные = МассивСообщений.Получить(-Индекс);
		
		Если ТолькоНовые Тогда
			
			ВыборкаСуществующих.Сбросить();
			Если ВыборкаСуществующих.НайтиСледующий(Данные.idMessage, "IDСообщения") Тогда
				Продолжить;
			КонецЕсли;			
			
		Иначе
			ВыборкаСуществующих.Сбросить();
			Пока ВыборкаСуществующих.НайтиСледующий(Данные.idMessage, "IDСообщения") Цикл
				ЗаписьИстории = РегистрыСведений.iga_ИсторияСообщений.СоздатьМенеджерЗаписи();
				ЗаписьИстории.Прочитать();
				Если ЗаписьИстории.Выбран() Тогда
					ЗаписьИстории.Удалить();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ТекстСообщения = "";
		Если Данные.Свойство("textMessage") Тогда
			ТекстСообщения = Данные.textMessage;
		ИначеЕсли Данные.Свойство("caption") Тогда
			ТекстСообщения = Данные.caption;
		ИначеЕсли Данные.Свойство("extendedTextMessage") Тогда
			ТекстСообщения = Данные.extendedTextMessage.text;
		КонецЕсли;
		
		IDЦитаты = ""; ТекстЦитаты = ""; АвторЦитаты = "";
		Если Данные.Свойство("quotedMessage") И Данные.quotedMessage.Свойство("stanzaId") Тогда
			IDЦитаты     = Данные.quotedMessage.stanzaId;
			ТекстЦитаты  = Данные.quotedMessage.textMessage;
			АвторЦитаты  = Данные.quotedMessage.participant;
		КонецЕсли;
		
		ЭтоВходящее = (Данные.type = "incoming");
		
		СтруктураСообщения = Новый Структура;
		СтруктураСообщения.Вставить("ЧатСсылка", ЧатСсылка);
		СтруктураСообщения.Вставить("ИдЧата", ИдЧата);
		СтруктураСообщения.Вставить("IDСообщения", Данные.idMessage);
		СтруктураСообщения.Вставить("Текст", ТекстСообщения);
		СтруктураСообщения.Вставить("Тип", Данные.typeMessage);
		СтруктураСообщения.Вставить("ВходящееСообщение", ЭтоВходящее);
		СтруктураСообщения.Вставить("IDЦитируемогоСобщения", IDЦитаты);
		СтруктураСообщения.Вставить("ТекстЦитирования", ТекстЦитаты);
		СтруктураСообщения.Вставить("АвторЦитирования", АвторЦитаты);
		СтруктураСообщения.Вставить("СсылкаОператор");
		СтруктураСообщения.Вставить("ВременнаяМетка", Данные.timestamp);
		СтруктураСообщения.Вставить("Прочитано", Истина);
		Если Не ПолучитьТипМедиаПоТипуСообщения(СтруктураСообщения.Тип) = Неопределено Тогда
			СтруктураСообщения.Вставить("ЕстьФайл", Истина);
			СтруктураСообщения.Вставить("СсылкаНаФайл", Данные.downloadUrl);
			СтруктураСообщения.Вставить("КартинкаФайла", Данные.jpegThumbnail);
			СтруктураСообщения.Вставить("ИмяФайла", Данные.fileName);
			СтруктураСообщения.Вставить("РазмерФайла", 0);
		КонецЕсли;
		
		ЗаписатьВИсторию(СтруктураСообщения);
		
	КонецЦикла;
	
КонецПроцедуры

// Метод возвращает крайние входящие сообщения аккаунта.
// Срок хранения входящих сообщений на сервере составляет 24 часа.
// Подробнее https://green-api.com/docs/api/journals/LastIncomingMessages/
// 
// Возвращаемое значение:
//  ЧтениеJSON  - Ответ сервера
//
Функция ПолучитьЖурналВходящихСообщений(КоличествоМинут = Неопределено) Экспорт
	
	Инстанс = IdInstance;
	Токен = ApiToken;
	
	Адрес = URLМетодаСервиса(Инстанс, Токен, "lastIncomingMessages");
	
	Если Не КоличествоМинут = Неопределено Тогда
		Адрес = Адрес + "?minutes=" + Формат(КоличествоМинут, "ЧГ=");
	КонецЕсли;
	
	Ответ = ОтправитьGETЗапрос(ХостПоУмолчанию(), Адрес, Истина);
	Возврат Ответ;
	
КонецФункции


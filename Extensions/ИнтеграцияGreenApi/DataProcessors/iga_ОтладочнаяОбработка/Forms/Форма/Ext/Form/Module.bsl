
&НаСервере
Процедура ЗаполнитьПоследниеСообщенияНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_Чаты.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_ЧатыБезПоследнихВходящих
	               |ИЗ
	               |	Справочник.iga_Чаты КАК iga_Чаты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПоследниеСообщенияЧатов КАК iga_ПоследниеСообщенияЧатов
	               |		ПО (iga_ПоследниеСообщенияЧатов.Чат = iga_Чаты.Ссылка
	               |				И iga_ПоследниеСообщенияЧатов.ЭтоВходящее)
	               |ГДЕ
	               |	iga_ПоследниеСообщенияЧатов.Чат ЕСТЬ NULL
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	iga_ИсторияСообщений.Чат КАК Чат,
	               |	МАКСИМУМ(iga_ИсторияСообщений.ДатаСообщения) КАК ДатаСообщения
	               |ИЗ
	               |	ВТ_ЧатыБезПоследнихВходящих КАК ВТ_ЧатыБезПоследнихВходящих
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	               |		ПО ВТ_ЧатыБезПоследнихВходящих.Ссылка = iga_ИсторияСообщений.Чат
	               |ГДЕ
	               |	iga_ИсторияСообщений.ЭтоВходящее
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	iga_ИсторияСообщений.Чат";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.iga_ПоследниеСообщенияЧатов.СоздатьМенеджерЗаписи();
		Запись.Чат = Выборка.Чат;
		Запись.ДатаСообщения = Выборка.ДатаСообщения;
		Запись.ЭтоВходящее = Истина;
		Запись.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоследниеСообщения(Команда)
	ЗаполнитьПоследниеСообщенияНаСервере();
	ПоказатьПредупреждение(, "ОК");
КонецПроцедуры

&НаСервере
Функция ВыполнитьПервичнуюЗагрузкуФайла(Бот, ИдЧата, ИдСообщения) Экспорт
	
	Менеджер = РегистрыСведений.iga_ПрикрепленныеФайлы.СоздатьМенеджерЗаписи();
	Менеджер.IDСообщения = ИдСообщения;
	Менеджер.Прочитать();
	
	ВоспроизведениеКонтентаВнутри = Константы.iga_ВоспроизведениеКонтентаВнутри.Получить();
	
	СтатусОжидает = ПредопределенноеЗначение("Перечисление.iga_СтатусыОбработкиФайлов.Ожидает");
	СтатусОшибка  = ПредопределенноеЗначение("Перечисление.iga_СтатусыОбработкиФайлов.Ошибка");
	
	ПерезагрузитьДанные = Ложь;
	
	Если (СтрНайти(Менеджер.ИмяФайла, ".oga") > 0
		Или СтрНайти(Менеджер.ИмяФайла, ".ogg") > 0) 
		И ВоспроизведениеКонтентаВнутри Тогда
		ПерезагрузитьДанные = Истина;
		Менеджер.Статус = СтатусОжидает;
	КонецЕсли;
	
	Если Не Менеджер.Выбран() И Не ПерезагрузитьДанные Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Менеджер.Статус <> СтатусОжидает И Менеджер.Статус <> СтатусОшибка Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		РезультатAPI = Бот.СкачатьФайлИзСообщения(ИдЧата, ИдСообщения);
	Исключение
		РезультатAPI = Новый Структура("downloadUrl", Менеджер.URLЗагрузки);
	КонецПопытки;
	
	Если ТипЗнч(РезультатAPI) <> Тип("Структура") ИЛИ Не РезультатAPI.Свойство("downloadUrl") Тогда
		Менеджер.Статус = СтатусОшибка;
		Менеджер.ТекстОшибки = "Сервис не вернул ссылку на скачивание (downloadUrl)";
		Менеджер.Записать();
		Возврат Ложь;
	КонецЕсли;
	
	
	
	Попытка
		ДвоичныеДанные = Новый ДвоичныеДанные(Бот.СкачатьФайлПоСсылке(РезультатAPI.downloadUrl));
		
		Расширение = НРег(Сред(Менеджер.ИмяФайла, СтрНайти(Менеджер.ИмяФайла, ".", НаправлениеПоиска.СКонца) + 1));
		
		Если ВоспроизведениеКонтентаВнутри И (Расширение = "oga" ИЛИ Расширение = "ogg") Тогда
			
			ДанныеMp3 = КонвертироватьOgaВMp3(ДвоичныеДанные);
			
			Если ДанныеMp3 <> Неопределено Тогда
				ДвоичныеДанные = ДанныеMp3;
				Менеджер.ИмяФайла = СтрЗаменить(НРег(Менеджер.ИмяФайла), "." + Расширение, ".mp3");
			КонецЕсли;
			
		КонецЕсли;
		
		Менеджер.ДанныеФайла = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
		Менеджер.Статус      = ПредопределенноеЗначение("Перечисление.iga_СтатусыОбработкиФайлов.Загружен");
		Менеджер.ТекстОшибки = "";
		Менеджер.Записать();
		
		Возврат Истина;
		
	Исключение
		Менеджер.Статус = СтатусОшибка;
		Менеджер.ТекстОшибки = "Ошибка при загрузке тела файла: " + ОписаниеОшибки();
		Менеджер.Записать();
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПолучитьПутьКFfmpeg() Экспорт
	
	ПутьККаталогу = КаталогВременныхФайлов() + "1c_ffmpeg\";
	СоздатьКаталог(ПутьККаталогу);
	
	ПутьКФайлу = ПутьККаталогу + "ffmpeg.exe";
	
	ФайлНаДиске = Новый Файл(ПутьКФайлу);
	
	Если Не ФайлНаДиске.Существует() Тогда
		Попытка
			Макет = ПолучитьОбщийМакет("ffmpeg_exe");
			Макет.Записать(ПутьКФайлу);
		Исключение
			ЗаписьЖурналаРегистрации("WhatsApp.Медиа", УровеньЖурналаРегистрации.Ошибка, , , 
				"Не удалось извлечь ffmpeg.exe: " + ОписаниеОшибки());
			Возврат "";
		КонецПопытки;
	КонецЕсли;
	
	Возврат ПутьКФайлу;
	
КонецФункции

&НаСервере
Функция КонвертироватьOgaВMp3(ДанныеOga) Экспорт
	
	ПутьКFfmpeg = ПолучитьПутьКFfmpeg();
	Если ПустаяСтрока(ПутьКFfmpeg) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяВходящего = ПолучитьИмяВременногоФайла("oga");
	ИмяИсходящего = ПолучитьИмяВременногоФайла("mp3");
	
	ДанныеOga.Записать(ИмяВходящего);
	
	СтрокаЗапуска = """" + ПутьКFfmpeg + """ -i """ + ИмяВходящего + """ -y """ + ИмяИсходящего + """";
	
	Попытка
		ЗапуститьПриложение(СтрокаЗапуска, , Истина);
		
		ФайлРезультат = Новый Файл(ИмяИсходящего);
		Если ФайлРезультат.Существует() И ФайлРезультат.Размер() > 0 Тогда
			ДанныеMp3 = Новый ДвоичныеДанные(ИмяИсходящего);
		Иначе
			ДанныеMp3 = Неопределено;
		КонецЕсли;
	Исключение
		ДанныеMp3 = Неопределено;
		ЗаписьЖурналаРегистрации("WhatsApp.Медиа", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при запуске конвертации: " + ОписаниеОшибки());
	КонецПопытки;
	
	УдалитьФайлы(ИмяВходящего);
	УдалитьФайлы(ИмяИсходящего);
	
	Возврат ДанныеMp3;
	
КонецФункции


&НаСервере
Процедура ПроверитьИПерезагрузитьОгаНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ИсторияСообщений.Чат.Идентификатор КАК ЧатИдентификатор,
	               |	iga_ИсторияСообщений.IDСообщения КАК IDСообщения
	               |ИЗ
	               |	РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПрикрепленныеФайлы КАК iga_ПрикрепленныеФайлы
	               |		ПО iga_ИсторияСообщений.IDСообщения = iga_ПрикрепленныеФайлы.IDСообщения
	               |ГДЕ
	               |	iga_ИсторияСообщений.ДатаСообщения МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И iga_ИсторияСообщений.ЕстьФайл
	               |	И (iga_ПрикрепленныеФайлы.ПутьКФайлу ПОДОБНО ""%"" + "".oga""
	               |			ИЛИ iga_ПрикрепленныеФайлы.ПутьКФайлу ПОДОБНО ""%"" + "".ogg"")";
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Бот = Обработки.iga_ChatBot.Создать();
	Бот.ИнициализацияОсновныхПараметров();
	Пока Выборка.Следующий() Цикл
		ВыполнитьПервичнуюЗагрузкуФайла(Бот, Выборка.ЧатИдентификатор, Выборка.IDСообщения);
	КонецЦикла;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Обработано " + Выборка.Количество();
	Сообщение.Сообщить();
	
КонецПроцедуры


&НаСервере
Процедура СброситьЧатыОператораНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ОчередьРаспределения.Чат КАК Чат
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |ГДЕ
	               |	iga_ОчередьРаспределения.Оператор = &Оператор
	               |	И НЕ iga_ОчередьРаспределения.Статус = &СтатусЗавершен";
	Запрос.УстановитьПараметр("СтатусЗавершен", Перечисления.iga_СтатусыОчереди.Завершен);
	Запрос.УстановитьПараметр("Оператор", Оператор);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		Запись.Чат = Выборка.Чат;
		Запись.Оператор = Оператор;
		Запись.Прочитать();
		Запись.Статус = Перечисления.iga_СтатусыОчереди.Завершен;
		Запись.Записать();
		
		Запись = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		Запись.Чат = Выборка.Чат;
		Запись.БезОповещения = Истина;
		Запись.ДатаПоступления = НачалоДня(ТекущаяДата());
		Запись.ДатаПоследнейАктивности = ТекущаяДата();
		Запись.Статус = Перечисления.iga_СтатусыОчереди.Ожидание;
		Запись.Записать();
		
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура УдалитьИзОжиданияСтарыеЧатыНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ОчередьРаспределения.Чат КАК Чат,
	               |	iga_ОчередьРаспределения.Оператор КАК Оператор
	               |ИЗ
	               |	РегистрСведений.iga_ОчередьРаспределения КАК iga_ОчередьРаспределения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.iga_ПоследниеСообщенияЧатов КАК iga_ПоследниеСообщенияЧатов
	               |		ПО (РАЗНОСТЬДАТ(iga_ПоследниеСообщенияЧатов.ДатаСообщения, &ТекущаяДата, ЧАС) > 24)
	               |			И (iga_ПоследниеСообщенияЧатов.ЭтоВходящее)
	               |			И iga_ОчередьРаспределения.Чат = iga_ПоследниеСообщенияЧатов.Чат
	               |ГДЕ
	               |	iga_ОчередьРаспределения.Статус = &Статус";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Статус", Перечисления.iga_СтатусыОчереди.Ожидание);
	Выборка = Запрос.Выполнить().Выбрать();
	ПОка Выборка.Следующий() Цикл
		Запись = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		Запись.Чат = Выборка.Чат;
		Запись.Оператор = Выборка.Оператор;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Статус = Перечисления.iga_СтатусыОчереди.Завершен;
			Запись.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ОчиститьИсториюОтказовНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1000
	               |	iga_ИсторияОтказовЧатов.Чат КАК Чат,
	               |	iga_ИсторияОтказовЧатов.Оператор КАК Оператор,
	               |	iga_ИсторияОтказовЧатов.Дата КАК Дата
	               |ИЗ
	               |	РегистрСведений.iga_ИсторияОтказовЧатов КАК iga_ИсторияОтказовЧатов
	               |ГДЕ
	               |	iga_ИсторияОтказовЧатов.Дата <= &Дата";
	Запрос.УстановитьПараметр("Дата", ДатаОчистки);
	
	Пока Истина Цикл
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() ТОгда
			Прервать;
		КонецЕсли;
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = РегистрыСведений.iga_ИсторияОтказовЧатов.СоздатьМенеджерЗаписи();
			Запись.Чат = Выборка.Чат;
			Запись.Оператор = Выборка.Оператор;
			Запись.Дата = Выборка.Дата;
			Запись.Удалить();
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры


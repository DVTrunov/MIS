Процедура СоздатьОповещенияОЗаписиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	iga_ОповещенияПоВремени.Заявка КАК Заявка,
	               |	КОЛИЧЕСТВО(iga_ОповещенияПоВремени.Заявка) КАК КоличествоОповещений,
	               |	iga_ОповещенияПоВремени.Чат КАК Чат,
	               |	МАКСИМУМ(iga_ОповещенияПоВремени.ДатаОповещения) КАК ДатаОповещения
	               |ИЗ
	               |	РегистрСведений.iga_ОповещенияПоВремени КАК iga_ОповещенияПоВремени
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ОповещенияПоВремени КАК iga_ОповещенияПоВремени1
	               |		ПО iga_ОповещенияПоВремени.Заявка = iga_ОповещенияПоВремени1.Заявка
	               |			И (iga_ОповещенияПоВремени1.ТребуетсяПодтверждение)
	               |ГДЕ
	               |	iga_ОповещенияПоВремени.ДатаЗаписи > &ТекущаяДата
	               |	И (iga_ОповещенияПоВремени.Заявка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |			ИЛИ &Заявка = iga_ОповещенияПоВремени.Заявка)
	               |	И iga_ОповещенияПоВремени1.Заявка ЕСТЬ NULL
	               |	И iga_ОповещенияПоВремени.Выполнено
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	iga_ОповещенияПоВремени.Заявка,
	               |	iga_ОповещенияПоВремени.Чат";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьОповещенияПоВремени = РегистрыСведений.iga_ОповещенияПоВремени.СоздатьМенеджерЗаписи();
		ЗаписьОповещенияПоВремени.Заявка = Выборка.Заявка;
		ЗаписьОповещенияПоВремени.ДатаОповещения = Выборка.ДатаОповещения;
		ЗаписьОповещенияПоВремени.Прочитать();
		
		ЗафиксироватьНапоминанияВРегистре(Выборка.Заявка, Выборка.Чат);
		ЗаписьОповещенияПоВремени.Записать(Ложь);
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОповещенияОЗаписи(Команда)
	СоздатьОповещенияОЗаписиНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиЧатПоСообщениямНаСервере(Знач СтрокаПоиска)
	
	// 1. Очищаем строку от спецсимволов и знаков препинания, которые ломают ПТП
	СимволыДляУдаления = "()[]{}\/|<>,.:;?!+-=""'*~_";
	Для Индекс = 1 По СтрДлина(СимволыДляУдаления) Цикл
		СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Сред(СимволыДляУдаления, Индекс, 1), " ");
	КонецЦикла;
	
	СтрокаПоиска = СокрЛП(СтрокаПоиска);
	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// 2. Разбиваем на массив, удаляя двойные пробелы
	МассивСлов = СтрРазделить(СтрокаПоиска, " ", Ложь);
	
	МаксимумСловДляПоиска = 7;
	Пока МассивСлов.Количество() > МаксимумСловДляПоиска Цикл
		МассивСлов.Удалить(МассивСлов.ВГраница());
	КонецЦикла;
	
	// 3. Формируем чистую строку для первого (точного) поиска
	СтрокаПоискаОчищенная = СтрСоединить(МассивСлов, " ");
	
	Попытка
		СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоискаОчищенная, 100);
		СписокПоиска.ОбластьПоиска.Добавить(Метаданные.РегистрыСведений.iga_ИсторияСообщений);
		СписокПоиска.ПерваяЧасть();
		
		// 4. Если точный поиск ничего не дал, ищем по маске (со звездочками)
		Если СписокПоиска.Количество() = 0 Тогда
			МассивСловСМаской = Новый Массив;
			
			Для Каждого Слово Из МассивСлов Цикл
				// ЗВЕЗДОЧКУ СТАВИМ ТОЛЬКО НА ДЛИННЫЕ СЛОВА (> 2 символов)!
				// Короткие слова вроде "в", "к", "с", "2", "4" оставляем как есть
				Если СтрДлина(Слово) > 2 Тогда
					МассивСловСМаской.Добавить(Слово + "*");
				Иначе
					МассивСловСМаской.Добавить(Слово);
				КонецЕсли;
			КонецЦикла;
			
			СтрокаПоискаСЗвездочкой = СтрСоединить(МассивСловСМаской, " ");
			
			СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоискаСЗвездочкой, 100);
			СписокПоиска.ОбластьПоиска.Добавить(Метаданные.РегистрыСведений.iga_ИсторияСообщений);
			СписокПоиска.ПерваяЧасть();
		КонецЕсли;
		
		Для Каждого Результат Из СписокПоиска Цикл
			Возврат Результат.Значение.Чат;
		КонецЦикла;
		
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Асинх Процедура ПоискПоПТП(Команда)
	
	СтрокаПоиска = Ждать ВвестиСтрокуАсинх(, "Введите слово для поиска", 100);
	
	Если Не ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	Чат = НайтиЧатПоСообщениямНаСервере(СтрокаПоиска);
	
	Если Не Чат = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Чат найден";
		Сообщение.Сообщить();
	Иначе 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Чат не найден";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРаботуПТП(Команда)
	ПроверитьРаботуПТПНаСервере("йцу1й2цу");
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьРаботуПТПНаСервере(Знач СтрокаПоиска)
	
	Сообщить("--- Начинаем тест ПТП по строке: """ + СтрокаПоиска + """ ---");
	
	Попытка
		// Ищем "как есть", без очистки, звездочек и разбивки на массивы
		СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоиска, 20);
		
		// Ограничиваем область поиска нашим регистром
		СписокПоиска.ОбластьПоиска.Добавить(Метаданные.РегистрыСведений.iga_ИсторияСообщений);
		
		// Выполняем поиск
		СписокПоиска.ПерваяЧасть();
		
		Если СписокПоиска.Количество() = 0 Тогда
			Сообщить("❌ ПТП отработал без ошибок, но ничего не нашел.");
			Сообщить("Вывод: Текста физически нет в индексе платформы.");
		Иначе
			Сообщить("✅ Успех! Найдено записей: " + СписокПоиска.Количество());
			
			// Выводим результаты для наглядности
			Для Каждого Результат Из СписокПоиска Цикл
				// Замените .Чат на имя вашего измерения/реквизита, если оно отличается
				Сообщить(" -> Чат: " + Строка(Результат.Значение.Чат)); 
			КонецЦикла;
		КонецЕсли;
		
	Исключение
		Сообщить(" Ошибка при выполнении ПТП: " + ОписаниеОшибки());
	КонецПопытки;
	
	Сообщить("--- Тест завершен ---");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьОповещениеПоВремени(НаборЗаписей, ЗанятыеДаты, ЧатСсылка, Заявка, ДатаНачала, ТекущаяДата) Экспорт
	
		ДатаДокумента = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Заявка, "Дата");
		
		КоличествоЧасов = iga_ОбщегоНазначенияКлиентСервер.РазностьДат(ТекущаяДата, ДатаНачала, "ЧАС");
				
		Более24 = Ложь;
		Более12 = Ложь;
		Более3 = Ложь;
		МинусЧасов = 0;
		
		Если КоличествоЧасов > 3 Тогда
			Более3 = Истина
		КонецЕсли;
		Если КоличествоЧасов > 12 Тогда
			МинусЧасов = -12;
			Более12 = Истина;
		КонецЕсли;

		//Если КоличествоЧасов > 24 Тогда
		//	МинусЧасов = -24;
		//	Более24 = Истина;
		//КонецЕсли;
		
		
		Если (Более24 Или Более12) 
			И ?(День(ДатаДокумента) + 1 = День(ДатаНачала), Час(ДатаДокумента) < 17, Истина) Тогда

			ДатаОповещения = iga_ОбщегоНазначенияКлиентСервер.ДобавитьКДате(ДатаНачала, "ЧАС", МинусЧасов);
			
			Если Час(ДатаОповещения) >= 0 И Час(ДатаОповещения) < 7 Тогда
				ДатаОповещения = iga_ОбщегоНазначенияКлиентСервер.ДобавитьКДате(НачалоДня(НачалоДня(ДатаОповещения)-1), "ЧАС", 17);
			ИначеЕсли Час(ДатаОповещения) > 17 И Час(ДатаОповещения) <= 23 Тогда
				ДатаОповещения = iga_ОбщегоНазначенияКлиентСервер.ДобавитьКДате(НачалоДня(ДатаОповещения), "ЧАС", 17);
			КонецЕсли;       
			
			Если ЗанятыеДаты.Найти(ДатаОповещения) = Неопределено Тогда
				Запись = НаборЗаписей.Добавить();
				Запись.Заявка = Заявка;
				Запись.ДатаОповещения = ДатаОповещения;
				Запись.ТребуетсяПодтверждение = Истина;
				Запись.ДатаЗаписи = ДатаНачала;
				Запись.Чат = ЧатСсылка; 
				ЗанятыеДаты.Добавить(ДатаОповещения);
				Запись.ШаблонОповещения = Справочники.iga_ШаблоныСообщений.Предопределенный(Перечисления.iga_ВидыПредопределенныхШаблонов.ПодтверждениеЗаписи);
			КонецЕсли;
			
		КонецЕсли;
		
		Если Более3 Тогда

			ДатаОповещения = iga_ОбщегоНазначенияКлиентСервер.ДобавитьКДате(ДатаНачала, "ЧАС", -3);

			Если Час(ДатаОповещения) >= 0 И Час(ДатаОповещения) < 6 Тогда
				ДатаОповещения = iga_ОбщегоНазначенияКлиентСервер.ДобавитьКДате(НачалоДня(ДатаОповещения), "ЧАС", 6);
			ИначеЕсли Час(ДатаОповещения) > 20 И Час(ДатаОповещения) <=23 Тогда
				ДатаОповещения = iga_ОбщегоНазначенияКлиентСервер.ДобавитьКДате(НачалоДня(ДатаОповещения), "ЧАС", 20);
			КонецЕсли;
			
			Если ЗанятыеДаты.Найти(ДатаОповещения) = Неопределено Тогда
				Запись = НаборЗаписей.Добавить();
				Запись.Заявка = Заявка;
				Запись.ДатаОповещения = ДатаОповещения;
				Запись.ДатаЗаписи = ДатаНачала;
				Запись.Чат = ЧатСсылка;
				ЗанятыеДаты.Добавить(ДатаОповещения);
				Запись.ШаблонОповещения = Справочники.iga_ШаблоныСообщений.Предопределенный(Перечисления.iga_ВидыПредопределенныхШаблонов.ОповещениеОЗаписи);
			КонецЕсли;
			
		КонецЕсли;
	
	КонецПроцедуры
	
&НаСервереБезКонтекста
Процедура ЗафиксироватьНапоминанияВРегистре(Заявка, ЧатСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	омг_НастройкиИнтеграцииСЛИС.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ПропускаемыеПозиции
	               |ИЗ
	               |	РегистрСведений.омг_НастройкиИнтеграцииСЛИС КАК омг_НастройкиИнтеграцииСЛИС
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	iga_ПозицииИсключенияИзОповещений.Номенклатура
	               |ИЗ
	               |	РегистрСведений.iga_ПозицииИсключенияИзОповещений КАК iga_ПозицииИсключенияИзОповещений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаявкаРаботы.Ссылка КАК Ссылка,
	               |	ЗаявкаРаботы.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(ЗаявкаРаботы.Номенклатура.Наименование, ""Прием"") КАК НоменклатураНаименование,
	               |	ВЫБОР
	               |		КОГДА ЗаявкаРаботы.Ссылка.НесколькоСотрудников
	               |			ТОГДА ЗаявкаРаботы.ДатаНачала
	               |		ИНАЧЕ ЗаявкаРаботы.Ссылка.ДатаНачала
	               |	КОНЕЦ КАК ДатаНачала,
	               |	ЕСТЬNULL(ЗаявкаРаботы.Сотрудник.Ссылка, ЗаявкаРаботы.Ссылка.Сотрудник) КАК Сотрудник
	               |ПОМЕСТИТЬ ВТ_ВсеБудущиеЗаписи
	               |ИЗ
	               |	Документ.Заявка.Работы КАК ЗаявкаРаботы
	               |ГДЕ
	               |	(НЕ ЗаявкаРаботы.Ссылка.омг_БезЗаписи
	               |				И НЕ ЗаявкаРаботы.Ссылка.НесколькоСотрудников
	               |			ИЛИ НЕ ЗаявкаРаботы.омг_БезЗаписиНесколькоВрачей
	               |				И ЗаявкаРаботы.Ссылка.НесколькоСотрудников)
	               |	И ЗаявкаРаботы.Ссылка.ДатаНачала >= &Дата
	               |	И НЕ ЗаявкаРаботы.Номенклатура В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					ВТ_ПропускаемыеПозиции.ГруппаНоменклатуры КАК ГруппаНоменклатуры
	               |				ИЗ
	               |					ВТ_ПропускаемыеПозиции КАК ВТ_ПропускаемыеПозиции)
	               |	И ЗаявкаРаботы.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.Ссылка КАК Ссылка,
	               |	ВложенныйЗапрос.ДатаНачала КАК ДатаНачала,
	               |	ВложенныйЗапрос.Сотрудник КАК Сотрудник,
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_ВсеБудущиеЗаписи.Ссылка КАК Ссылка,
	               |		МИНИМУМ(ВТ_ВсеБудущиеЗаписи.ДатаНачала) КАК ДатаНачала,
	               |		ВТ_ВсеБудущиеЗаписи.Сотрудник КАК Сотрудник,
	               |		ВТ_ВсеБудущиеЗаписи.Номенклатура КАК Номенклатура
	               |	ИЗ
	               |		ВТ_ВсеБудущиеЗаписи КАК ВТ_ВсеБудущиеЗаписи
	               |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				ВТ_ВсеБудущиеЗаписи.Ссылка КАК Ссылка,
	               |				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ВсеБудущиеЗаписи.Номенклатура) КАК КоличествоСтрок
	               |			ИЗ
	               |				ВТ_ВсеБудущиеЗаписи КАК ВТ_ВсеБудущиеЗаписи
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				ВТ_ВсеБудущиеЗаписи.Ссылка) КАК ВложенныйЗапрос
	               |			ПО ВТ_ВсеБудущиеЗаписи.Ссылка = ВложенныйЗапрос.Ссылка
	               |	ГДЕ
	               |		(ВТ_ВсеБудущиеЗаписи.Номенклатура.Ссылка ЕСТЬ NULL
	               |					И ВложенныйЗапрос.КоличествоСтрок = 1
	               |				ИЛИ НЕ ВТ_ВсеБудущиеЗаписи.Номенклатура.Ссылка ЕСТЬ NULL
	               |					И ВложенныйЗапрос.КоличествоСтрок >= 1)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_ВсеБудущиеЗаписи.Сотрудник,
	               |		ВТ_ВсеБудущиеЗаписи.Ссылка,
	               |		ВТ_ВсеБудущиеЗаписи.Номенклатура) КАК ВложенныйЗапрос
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаНачала
	               |ИТОГИ
	               |	МАКСИМУМ(Ссылка),
	               |	МАКСИМУМ(Сотрудник)
	               |ПО
	               |	ДатаНачала";
	ТекущаяДата = ТекущаяДата();
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата);
	ВыборкаДат = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НаборЗаписей = РегистрыСведений.iga_ОповещенияПоВремени.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заявка.Установить(Заявка);
	ЗаписиРабот = РегистрыСведений.iga_СтатусыПодтвержденияСтрокЗаявок.СоздатьНаборЗаписей();
	ЗаписиРабот.Отбор.Заявка.Установить(Заявка);
	ЗанятыеДаты = Новый Массив;
	
	
	Пока ВыборкаДат.Следующий() Цикл
		
		ДатаНачала = ВыборкаДат.ДатаНачала;
		
		ЗаписатьОповещениеПоВремени(НаборЗаписей, ЗанятыеДаты, ЧатСсылка, Заявка, ДатаНачала, ТекущаяДата);
		
		iga_МетодыРаботыСБотом.УстановитьПараметрОбщения(ЧатСсылка, "ОтправленоОповещение", Истина);
		
		ВыборкаРаботы = ВыборкаДат.Выбрать();
		
		ТребуетсяПодтверждение = Ложь;
		
		Для Каждого ЗаписьОповещения Из НаборЗаписей Цикл
			Если ЗаписьОповещения.ТребуетсяПодтверждение Тогда
				ТребуетсяПодтверждение = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ТребуетсяПодтверждение  Тогда
			Пока ВыборкаРаботы.Следующий() Цикл
				Запись = ЗаписиРабот.Добавить();
				Запись.Заявка = Заявка;
				Запись.Работа = ВыборкаРаботы.Номенклатура;
				Запись.ДатаЗаписи = ДатаНачала;
			КонецЦикла;
		КонецЕсли;
		
		
	КонецЦикла;
	
	ЗаписиРабот.Записать();
	НаборЗаписей.Записать();
	
КонецПроцедуры


&НаСервере
Процедура ТестСозданияОповещенийНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст =    "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                  |	iga_ИсторияСообщений.Чат КАК Чат,
	                  |	ЗаявкаДок.Ссылка КАК Ссылка,
	                  |	ЗаявкаДок.ДатаНачала КАК ДатаНачала
	                  |ИЗ
	                  |	РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
	                  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ОповещенияПоВремени КАК iga_ОповещенияПоВремени
	                  |		ПО iga_ИсторияСообщений.Чат = iga_ОповещенияПоВремени.Чат
	                  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ЧатыКлиентов КАК iga_ЧатыКлиентов
	                  |		ПО iga_ИсторияСообщений.Чат = iga_ЧатыКлиентов.Чат
	                  |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка КАК ЗаявкаДок
	                  |		ПО (НАЧАЛОПЕРИОДА(iga_ИсторияСообщений.ДатаСообщения, ДЕНЬ) = НАЧАЛОПЕРИОДА(ЗаявкаДок.Дата, ДЕНЬ))
	                  |			И (ЗаявкаДок.Клиент = iga_ЧатыКлиентов.Клиент)
	                  |ГДЕ
	                  |	iga_ИсторияСообщений.ДатаСообщения МЕЖДУ &ДатаНачала И &ДатаОкончания
	                  |	И iga_ИсторияСообщений.Текст ПОДОБНО ""%"" + ""Вы успешно записаны"" + ""%""
	                  |	И iga_ОповещенияПоВремени.Заявка ЕСТЬ NULL
	                  |	И ЗаявкаДок.ДатаНачала >= &ТекущаяДата
	                  |	И ВЫБОР
	                  |			КОГДА &Заявка = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
	                  |				ТОГДА ИСТИНА
	                  |			ИНАЧЕ ЗаявкаДок.Ссылка = &Заявка
	                  |		КОНЕЦ";
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДата()) + 1);
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьНапоминанияВРегистре(Выборка.Ссылка, Выборка.Чат);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТестСозданияОповещений(Команда)
	ТестСозданияОповещенийНаСервере();
КонецПроцедуры

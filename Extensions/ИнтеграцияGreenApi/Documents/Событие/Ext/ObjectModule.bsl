
&После("ОбработкаЗаполнения")
Процедура iga_ОбработкаЗаполнения(Знач ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("СобытиеЧата") Тогда
		ВидСобытия = Перечисления.ВидыСобытий.iga_ДиалогWhatsApp;
		ТипЗвонка = Справочники.ТипыЗвонков.ЗаписьНаПрием;
		ДополнительныеСвойства.Вставить("ХранилищеСсылки", ДанныеЗаполнения.ХранилищеСсылки);
		Основание = ДанныеЗаполнения.Клиент;
		
	КонецЕсли;
	
КонецПроцедуры


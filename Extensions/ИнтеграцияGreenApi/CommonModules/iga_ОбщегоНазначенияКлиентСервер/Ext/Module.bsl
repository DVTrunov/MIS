
// Функция имитирует работу одноименной функции языка запросов 1С.
//
// Параметры:
//  ИсходнаяДата - Дата - дата, к которой прибавляем интервал
//  ТипПериода   - Строка - "СЕКУНДА", "МИНУТА", "ЧАС", "ДЕНЬ", "НЕДЕЛЯ", "МЕСЯЦ", "КВАРТАЛ", "ГОД"
//  Количество   - Число - величина прибавляемого интервала (может быть отрицательной)
//
// Возврат:
//  Дата - результат вычисления
//
Функция ДобавитьКДате(ИсходнаяДата, ТипПериода, Количество) Экспорт
	
	ТипПериодаВВерхнемРегистре = ВРег(СокрЛП(ТипПериода));
	
	Если ТипПериодаВВерхнемРегистре = "СЕКУНДА" Тогда
		Возврат ИсходнаяДата + Количество;
		
	ИначеЕсли ТипПериодаВВерхнемРегистре = "МИНУТА" Тогда
		Возврат ИсходнаяДата + (Количество * 60);
		
	ИначеЕсли ТипПериодаВВерхнемРегистре = "ЧАС" Тогда
		Возврат ИсходнаяДата + (Количество * 3600);
		
	ИначеЕсли ТипПериодаВВерхнемРегистре = "ДЕНЬ" Тогда
		Возврат ИсходнаяДата + (Количество * 86400);
		
	ИначеЕсли ТипПериодаВВерхнемРегистре = "НЕДЕЛЯ" Тогда
		Возврат ИсходнаяДата + (Количество * 604800);
		
	ИначеЕсли ТипПериодаВВерхнемРегистре = "МЕСЯЦ" Тогда
		Возврат ДобавитьМесяц(ИсходнаяДата, Количество);
		
	ИначеЕсли ТипПериодаВВерхнемРегистре = "КВАРТАЛ" Тогда
		Возврат ДобавитьМесяц(ИсходнаяДата, Количество * 3);
		
	ИначеЕсли ТипПериодаВВерхнемРегистре = "ГОД" Тогда
		Возврат ДобавитьМесяц(ИсходнаяДата, Количество * 12);
		
	КонецЕсли;
	
	// Если тип не распознан, возвращаем исходную дату
	Возврат ИсходнаяДата;
	
КонецФункции

Функция ПолучитьУникальнуюВременнуюМетку() Экспорт
	
	ТекущаяВременнаяМетка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Пока Истина Цикл
		Если Не ТекущаяВременнаяМетка = ТекущаяУниверсальнаяДатаВМиллисекундах() Тогда
			ТекущаяВременнаяМетка = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ТекущаяВременнаяМетка = ПолучитьUnixTimestamp(ТекущаяВременнаяМетка);
	
	Возврат ТекущаяВременнаяМетка;
	
КонецФункции

// Функция выполняет полное (глубокое) копирование Структур, Массивов и Соответствий.
// Примитивные типы и ссылки возвращаются "как есть".
//
// Параметры:
//  Источник - Произвольный - исходный объект (Структура, Массив или значение).
//
// Возвращаемое значение:
//  Произвольный - полная копия объекта.
//
Функция СкопироватьРекурсивно(Знач Источник) Экспорт
	
	ТипИсточника = ТипЗнч(Источник);
	
	// 1. Если это Структура
	Если ТипИсточника = Тип("Структура") Тогда
		НоваяСтруктура = Новый Структура;
		
		Для Каждого Элемент Из Источник Цикл
			// Рекурсивный вызов для значения, чтобы скопировать вложенные объекты
			ЗначениеКопии = СкопироватьРекурсивно(Элемент.Значение);
			НоваяСтруктура.Вставить(Элемент.Ключ, ЗначениеКопии);
		КонецЦикла;
		
		Возврат НоваяСтруктура;
		
	// 2. Если это Массив
	ИначеЕсли ТипИсточника = Тип("Массив") Тогда
		НовыйМассив = Новый Массив;
		
		Для Каждого Элемент Из Источник Цикл
			// Рекурсивный вызов для элементов массива
			ЭлементКопии = СкопироватьРекурсивно(Элемент);
			НовыйМассив.Добавить(ЭлементКопии);
		КонецЦикла;
		
		Возврат НовыйМассив;
		
	// 3. Если это Соответствие (часто используется вместе со структурами)
	ИначеЕсли ТипИсточника = Тип("Соответствие") Тогда
		НовоеСоответствие = Новый Соответствие;
		
		Для Каждого Элемент Из Источник Цикл
			// Копируем и значение, и ключ (если ключ вдруг тоже объектный)
			КлючКопии     = СкопироватьРекурсивно(Элемент.Ключ);
			ЗначениеКопии = СкопироватьРекурсивно(Элемент.Значение);
			НовоеСоответствие.Вставить(КлючКопии, ЗначениеКопии);
		КонецЦикла;
		
		Возврат НовоеСоответствие;
		
	// 4. Примитивные типы (Число, Строка, Дата, Булево) и Ссылки (СправочникСсылка и т.д.)
	// Они неизменяемы или передаются значением, их копировать не нужно.
	Иначе
		Возврат Источник;
	КонецЕсли;
	
КонецФункции

Функция СкопироватьПоляСтруктуры(Знач Источник) Экспорт
	
	Структура = Новый Структура;
	Для Каждого ЭлементСтруктуры ИЗ Источник Цикл
		Структура.Вставить(ЭлементСтруктуры.Ключ);
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

Функция РазностьДат(ДатаНачала, ДатаОкончания, ТипПериода = "ДЕНЬ") Экспорт
	
	_Тип = ВРег(СокрЛП(ТипПериода));
	
	// В 1С разность дат всегда возвращает количество секунд (Число)
	Если _Тип = "СЕКУНДА" Тогда
		Возврат (ДатаОкончания - ДатаНачала);
		
	ИначеЕсли _Тип = "МИНУТА" Тогда
		// Сначала приводим к началу периода, вычитаем (получаем секунды) и делим на 60
		Возврат (НачалоМинуты(ДатаОкончания) - НачалоМинуты(ДатаНачала)) / 60;
		
	ИначеЕсли _Тип = "ЧАС" Тогда
		Возврат (НачалоЧаса(ДатаОкончания) - НачалоЧаса(ДатаНачала)) / 3600;
		
	ИначеЕсли _Тип = "ДЕНЬ" Тогда
		Возврат (НачалоДня(ДатаОкончания) - НачалоДня(ДатаНачала)) / 86400;
		
	ИначеЕсли _Тип = "МЕСЯЦ" Тогда
		// Для месяцев и лет деление на секунды не подходит из-за разной длины месяцев
		Возврат (Год(ДатаОкончания) - Год(ДатаНачала)) * 12 + (Месяц(ДатаОкончания) - Месяц(ДатаНачала));
		
	ИначеЕсли _Тип = "КВАРТАЛ" Тогда
		КварталКон = Цел((Месяц(ДатаОкончания) - 1) / 3);
		КварталНач = Цел((Месяц(ДатаНачала) - 1) / 3);
		Возврат (Год(ДатаОкончания) - Год(ДатаНачала)) * 4 + (КварталКон - КварталНач);
		
	ИначеЕсли _Тип = "ГОД" Тогда
		Возврат Год(ДатаОкончания) - Год(ДатаНачала);
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Функция преобразует дату 1С или миллисекунды 1С в Unix формат
// Параметр ВходноеЗначение: может быть типом Дата или Число (мс)
// Возвращает: Число (10 знаков для секунд, 13 знаков для миллисекунд)
Функция ПолучитьUnixTimestamp(Знач ВходноеЗначение) Экспорт
	
	НачалоЭпохиUnix = '19700101000000';
	
	// Смещение 0001 -> 1970 в секундах: 62 135 596 800
	СмещениеСекунды = НачалоЭпохиUnix - '00010101000000'; 
	
	Если ТипЗнч(ВходноеЗначение) = Тип("Дата") Тогда
		
		// Возвращаем 10 знаков (секунды)
		Возврат ВходноеЗначение - НачалоЭпохиUnix;
		
	ИначеЕсли ТипЗнч(ВходноеЗначение) = Тип("Число") Тогда
		
		// ВходноеЗначение — это миллисекунды от 0001 года
		// Вычитаем смещение, переведенное в миллисекунды
		UnixМс = ВходноеЗначение - (СмещениеСекунды * 1000);
		
		// Возвращаем 13 знаков (миллисекунды)
		Возврат UnixМс;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Функция преобразует Unix Timestamp (10 знаков) в тип Дата 1С
// Параметр UnixTimestamp: Число — количество секунд, прошедших с 01.01.1970
// Возвращает: Дата (стандартный тип 1С)
Функция ПолучитьДатуИзUnix(Знач UnixTimestamp) Экспорт
	
	// Начало эпохи Unix
	НачалоЭпохиUnix = '19700101000000';
	
	Если СтрДлина(UnixTimestamp) = 17 Тогда
		UnixTimestamp = Цел(UnixTimestamp / 1000);
	КонецЕсли;
	
	// Прибавляем секунды к дате начала эпохи
	ДатаUTC = НачалоЭпохиUnix + UnixTimestamp;
	
	ДатаЛокальная = МестноеВремя(ДатаUTC);
	
	Возврат ДатаЛокальная;
	
КонецФункции


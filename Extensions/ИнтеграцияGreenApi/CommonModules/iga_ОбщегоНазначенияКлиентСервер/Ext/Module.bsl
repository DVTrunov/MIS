// Приводит произвольную строку к безопасному имени файла.
// Убирает запрещенные символы, заменяет пробелы и, опционально, транслитерирует.
//
// Параметры:
//  ИмяФайла  - Строка - исходное имя файла (с расширением или без).
// 
// Возвращаемое значение:
//  Строка - "чистое" имя файла.
//
Функция ИдеальноеИмяФайла(Знач ИмяФайла, ЭтоКириллица = Ложь, БазовоеИмя = "file_") Экспорт
	
	ИмяФайла = СокрЛП(ИмяФайла);
	
	// 1. Отделяем расширение
	ТочкаПозиция = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если ТочкаПозиция > 0 Тогда
		Расширение = Сред(ИмяФайла, ТочкаПозиция);
		ИмяБезРасширения = Лев(ИмяФайла, ТочкаПозиция - 1);
	Иначе
		Расширение = "";
		ИмяБезРасширения = ИмяФайла;
	КонецЕсли;
	
	// 2. ТРАНСЛИТЕРАЦИЯ
	// Сопоставление кириллицы и латиницы
	Кириллица = "а,б,в,г,д,е,ё,ж,з,и,й,к,л,м,н,о,п,р,с,т,у,ф,х,ц,ч,ш,щ,ъ,ы,ь,э,ю,я";
	Латиница  = "a,b,v,g,d,e,yo,zh,z,i,y,k,l,m,n,o,p,r,s,t,u,f,kh,ts,ch,sh,sch,,y,,e,yu,ya";
	
	МассивКир = СтрРазделить(Кириллица, ",");
	МассивЛат = СтрРазделить(Латиница, ",");
	
	Если Не ЭтоКириллица Тогда
		РезультатТранслита = "";
		Для Поз = 1 По СтрДлина(ИмяБезРасширения) Цикл
			Символ = НРег(Сред(ИмяБезРасширения, Поз, 1));
			Индекс = МассивКир.Найти(Символ);
			
			Если Индекс <> Неопределено Тогда
				РезультатТранслита = РезультатТранслита + МассивЛат[Индекс];
			Иначе
				РезультатТранслита = РезультатТранслита + Символ;
			КонецЕсли;
		КонецЦикла;
		ИмяБезРасширения = РезультатТранслита;
	КонецЕсли;
	
	// 3. Чистим тело имени от запрещенных символов ОС
	ЗапрещенныеСимволы = "/\:*?""<>|+#%&";
	Для Индекс = 1 По СтрДлина(ЗапрещенныеСимволы) Цикл
		СимволЗамены = Сред(ЗапрещенныеСимволы, Индекс, 1);
		ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, СимволЗамены, "");
	КонецЦикла;
	
	// 4. Убираем пробелы и лишнее
	ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, " ", "_");
	ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, Символы.ПС, "");
	ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, Символы.ВК, "");
	
	Пока СтрНайти(ИмяБезРасширения, "__") > 0 Цикл
		ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, "__", "_");
	КонецЦикла;
	
	// 5. Финальные проверки
	Если СтрДлина(ИмяБезРасширения) > 150 Тогда
		ИмяБезРасширения = Лев(ИмяБезРасширения, 150);
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяБезРасширения) Тогда
		ИмяБезРасширения = БазовоеИмя + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss");
	КонецЕсли;
	
	Возврат ИмяБезРасширения + НРег(Расширение);
	
КонецФункции

// Соединяет две части пути, обеспечивая наличие ровно одного разделителя между ними.
//
// Параметры:
//  Путь1 - Строка - базовая папка
//  Путь2 - Строка - имя файла или подпапка
//
// Возврат:
//  Строка - объединенный путь
//
Функция ОбъединитьПути(Знач Путь1, Знач Путь2) Экспорт
	
	Путь1 = СокрЛП(Путь1);
	Путь2 = СокрЛП(Путь2);
	
	Если ПустаяСтрока(Путь1) Тогда Возврат Путь2; КонецЕсли;
	Если ПустаяСтрока(Путь2) Тогда Возврат Путь1; КонецЕсли;
	
	// Определяем тип слэша, который уже используется в пути (Windows или Linux)
	Разделитель = "\"; 
	Если СтрНайти(Путь1, "/") > 0 Тогда
		Разделитель = "/";
	КонецЕсли;
	
	ПоследнийСимвол1 = Прав(Путь1, 1);
	ПервыйСимвол2    = Лев(Путь2, 1);
	
	СлэшВКонце = (ПоследнийСимвол1 = "\" Или ПоследнийСимвол1 = "/");
	СлэшВНачале = (ПервыйСимвол2 = "\" Или ПервыйСимвол2 = "/");
	
	Если СлэшВКонце И СлэшВНачале Тогда
		// Оба имеют слэш -> убираем один у второй части
		Возврат Путь1 + Сред(Путь2, 2);
	ИначеЕсли Не СлэшВКонце И Не СлэшВНачале Тогда
		// Ни у кого нет слэша -> добавляем разделитель
		Возврат Путь1 + Разделитель + Путь2;
	Иначе
		// Ровно один слэш уже есть на стыке -> просто складываем
		Возврат Путь1 + Путь2;
	КонецЕсли;
	
КонецФункции

// Разбирает URL-строку на составляющие части.
//
// Параметры:
//  URLСтрока - Строка - Например, "https://api.mysite.ru:8443/v1/method?param=1"
//
// Возвращаемое значение:
//  Структура - Части URL:
//      * ЗащищенноеСоединение - Булево
//      * Хост                 - Строка
//      * Порт                 - Число
//      * ПутьРесурса          - Строка
//
Функция РазобратьURL(Знач URLСтрока) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЗащищенноеСоединение", Ложь);
	Результат.Вставить("Хост",                 "");
	Результат.Вставить("Порт",                 0);
	Результат.Вставить("ПутьРесурса",          "/");
	
	// 1. Определяем протокол
	ПозПротокола = СтрНайти(URLСтрока, "://");
	Если ПозПротокола > 0 Тогда
		Протокол = НРег(Лев(URLСтрока, ПозПротокола - 1));
		Результат.ЗащищенноеСоединение = (Протокол = "https");
		ОстатокСтроки = Сред(URLСтрока, ПозПротокола + 3);
	Иначе
		ОстатокСтроки = URLСтрока;
	КонецЕсли;
	
	// 2. Отделяем Хост(+Порт) от Пути ресурса
	ПозСлэша = СтрНайти(ОстатокСтроки, "/");
	Если ПозСлэша > 0 Тогда
		ХостПорт = Лев(ОстатокСтроки, ПозСлэша - 1);
		Результат.ПутьРесурса = Сред(ОстатокСтроки, ПозСлэша);
	Иначе
		ХостПорт = ОстатокСтроки;
		Результат.ПутьРесурса = "/"; // Корень, если путь не указан
	КонецЕсли;
	
	// 3. Выделяем Порт из части ХостПорт
	// Используем НаправлениеПоиска.СКонца на случай IPv6 адресов с двоеточиями
	ПозДвоеточия = СтрНайти(ХостПорт, ":", НаправлениеПоиска.СКонца);
	
	// Проверяем, что двоеточие не является частью IPv6 (упрощенно)
	// Если после двоеточия только цифры - это порт.
	Если ПозДвоеточия > 0 Тогда
		СтрокаПорта = Сред(ХостПорт, ПозДвоеточия + 1);
		
		// Попытка преобразовать порт в число
		Попытка
			Результат.Порт = Число(СтрокаПорта);
			Результат.Хост = Лев(ХостПорт, ПозДвоеточия - 1);
		Исключение
			// Если в порту буквы (например, в IPv6), значит это не порт
			Результат.Хост = ХостПорт;
		КонецПопытки;
	Иначе
		Результат.Хост = ХостПорт;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Вариант функции через Структуру (без ограничения в 9 параметров)
Функция СтрШаблонПоСтруктуре(Знач ТекстШаблона, СтруктураДанных) Экспорт
	
	Результат = ТекстШаблона;
	
	Для Каждого КлючИЗначение Из СтруктураДанных Цикл
		// Благодаря СтрЗаменить, регистр [Ключ] в тексте не важен
		Результат = СтрЗаменить(Результат, "[" + КлючИЗначение.Ключ + "]", Строка(КлючИЗначение.Значение));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КоличествоПараметровВТексте(ТекстСообщения) Экспорт
	
	RegExp = Новый COMОбъект("VBScript.RegExp");
	RegExp.IgnoreCase = Истина; // Игнорировать регистр
	RegExp.Global     = Истина; // Искать все вхождения
	RegExp.MultiLine  = Истина;
	RegExp.Pattern    = "\{\{([^}]+)\}\}";
	
	Matches = RegExp.Execute(ТекстСообщения);
	
	Возврат Matches.Count;
	
КонецФункции

// Оставляет в строке только цифровые символы.
//
// Параметры:
//  ИсходнаяСтрока - Строка - Произвольная строка.
//
// Возвращаемое значение:
//  Строка - Строка, состоящая только из цифр.
//
Функция ТолькоЦифры(Знач ИсходнаяСтрока) Экспорт
	
	Результат = "";
	Цифры = "0123456789";
	
	Для Поз = 1 По СтрДлина(ИсходнаяСтрока) Цикл
		Символ = Сред(ИсходнаяСтрока, Поз, 1);
		Если СтрНайти(Цифры, Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


Процедура ВыполнитьОбработчикПередЭтапом(НовыйЭтап, ЧатСсылка, ИдЧата, ТекущийЭтап, НормТекст, ВыборКнопки, ВходящиеПараметры) Экспорт
	
	Если Не ТекущийЭтап.ПередОбработкойЭтапа = "" Тогда 
		Обработчик = Обработки.iga_ОбработчикЭтапов.Создать();
		Обработчик.ВходящиеПараметры = Новый Структура("Чат, ИдЧата, ТекущийЭтап, НовыйЭтап, ТекстСообщения, ВыборКнопки, НовыеПараметры", 
			ЧатСсылка, ИдЧата, ТекущийЭтап, НовыйЭтап, НормТекст, ВыборКнопки, Новый Структура);
		
		Если Не ВходящиеПараметры = Неопределено Тогда 
			Для Каждого Параметр Из ВходящиеПараметры Цикл
				Обработчик.ВходящиеПараметры.Вставить(Параметр.Ключ, Параметр.Значение);
			КонецЦикла;
		КонецЕсли;
						
		Обработчик.ВыполнитьОбработчикСУчетомАлгоритмов(ТекущийЭтап.ПередОбработкойЭтапа);
		Если Не Обработчик.ВходящиеПараметры.НовыеПараметры.Количество() > 0 Тогда
			Для Каждого НовыйПарметр Из Обработчик.ВходящиеПараметры.НовыеПараметры Цикл
				iga_МетодыРаботыСБотом.УстановитьПараметрОбщения(ЧатСсылка, НовыйПарметр.Ключ, НовыйПарметр.Значение);
			КонецЦикла;
			Обработчик.ВходящиеПараметры.НовыеПараметры.Очистить();
		КонецЕсли;
		
		ВходящиеПараметры = Обработчик.ВходящиеПараметры;
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьВходящееСообщение(ЧатСсылка, ИдЧата, ТекстВходящегоСообщения, ВыборКнопки = 0, БезОбщенияСБотом = Ложь, ВходящиеПараметры = Неопределено) Экспорт
	
	НормТекст = СокрЛП(ТекстВходящегоСообщения);
	
	ЗаписьСостояния = РегистрыСведений.iga_СостояниеБота.СоздатьМенеджерЗаписи();
	ЗаписьСостояния.Чат = ЧатСсылка;
	ЗаписьСостояния.Прочитать();

	ТекущийЭтап = Неопределено;
	
	Если ЗаписьСостояния.Выбран() Тогда

		ТекущийЭтап = ЗаписьСостояния.ТекущийЭтап;
			
		РезультатПоиска = НайтиСледующийЭтапПоКоманде(ЧатСсылка, ИдЧата, ТекущийЭтап, НормТекст, ВыборКнопки);
		НовыйЭтап = РезультатПоиска.Этап;
		
		Если ВходящиеПараметры = Неопределено Тогда
			ВходящиеПараметры = Новый Структура("Чат, ИдЧата, ТекущийЭтап, НовыйЭтап, ТекстСообщения, ВыборКнопки, НовыеПараметры", 
				ЧатСсылка, ИдЧата, ТекущийЭтап, НовыйЭтап, НормТекст, ВыборКнопки, Новый Структура);
		КонецЕсли;
		
		ВыполнитьОбработчикПередЭтапом(НовыйЭтап, ЧатСсылка, ИдЧата, ТекущийЭтап, НормТекст, ВыборКнопки, ВходящиеПараметры);
		
		Если ЗначениеЗаполнено(НовыйЭтап) Тогда

			ВыполнитьЭтап(ЧатСсылка, ИдЧата, ТекущийЭтап, НовыйЭтап, ЗаписьСостояния, БезОбщенияСБотом, ВходящиеПараметры);
			Если Не РезультатПоиска.ПослеОбработкиКоманды = "" Тогда
				ОбработчикАлгоритвом = Обработки.iga_ОбработчикЭтапов.Создать();
				ОбработчикАлгоритвом.ВходящиеПараметры = ВходящиеПараметры;
				ОбработчикАлгоритвом.ВыполнитьОбработчикСУчетомАлгоритмов(РезультатПоиска.ПослеОбработкиКоманды);
			КонецЕсли;
		
		Иначе

			ОтправитьТекстЭтапа(ЧатСсылка, ИдЧата, ТекущийЭтап, ВходящиеПараметры);
		КонецЕсли;
		
		
	Иначе

		ТекущийЭтап = Константы.iga_СтартовыйЭтапБота.Получить();
		
		Если ВходящиеПараметры = Неопределено Тогда
			ВходящиеПараметры = Новый Структура("Чат, ИдЧата, ТекущийЭтап, ПредыдущийЭтап, ТекстСообщения, ВыборКнопки, НовыеПараметры", 
				ЧатСсылка, ИдЧата, ТекущийЭтап, Неопределено, НормТекст, ВыборКнопки, Новый Структура);
		КонецЕсли;

		ВыполнитьОбработчикПередЭтапом(Неопределено, ЧатСсылка, ИдЧата, ТекущийЭтап, НормТекст, ВыборКнопки, ВходящиеПараметры);
		
		ВыполнитьЭтап(ЧатСсылка, ИдЧата, Неопределено, ТекущийЭтап, ЗаписьСостояния, БезОбщенияСБотом, ВходящиеПараметры);

	КонецЕсли;
	
КонецПроцедуры

Функция НайтиСледующийЭтапПоКоманде(ЧатСсылка, ИдЧата, ЭтапСсылка, Команда, ВыборКнопки) Экспорт
	
	Результат = Новый Структура("Этап, ПослеОбработкиКоманды", Справочники.iga_ЭтапыСценария.ПустаяСсылка(), "");
	ЭтапЗвездочка = Справочники.iga_ЭтапыСценария.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Варианты.Команда КАК Команда,
		|	Варианты.СледующийЭтап КАК СледующийЭтап,
		|	Варианты.Команда.АлгоритмПроверки КАК КомандаАлгоритмПроверки,
		|	Варианты.ПослеОбработкиКоманды КАК ПослеОбработкиКоманды
		|ИЗ
		|	Справочник.iga_ЭтапыСценария.ВариантыОтветов КАК Варианты
		|ГДЕ
		|	Варианты.Ссылка = &Этап";
	Запрос.УстановитьПараметр("Этап", ЭтапСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВходящиеПараметры = Новый Структура("Чат, ИдЧата, Команда, ВыборКнопки", ЧатСсылка, ИдЧата, Команда, ВыборКнопки);
	
	ОбработчикАлгоритвом = Обработки.iga_ОбработчикЭтапов.Создать();
	ОбработчикАлгоритвом.ВходящиеПараметры = ВходящиеПараметры;
	
	Пока Выборка.Следующий() Цикл
		
		
		РезультатОбработкиКоманды = ОбработчикАлгоритвом.ВыполнитьОбработчикСУчетомАлгоритмов(Выборка.КомандаАлгоритмПроверки);
		
		Если РезультатОбработкиКоманды = Истина Тогда
			Результат.Этап = Выборка.СледующийЭтап;
			Результат.ПослеОбработкиКоманды = Выборка.ПослеОбработкиКоманды;
			
			Возврат Результат; 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьЭтап(ЧатСсылка, ИдЧата, ПредыдущийЭтап, ЭтапСсылка, ЗаписьСостояния = Неопределено, БезОбщенияСБотом = Ложь, ВходящиеПараметры = Неопределено) Экспорт
	
	ТипЭтапа = ЭтапСсылка.ТипЭтапа;
	
	Если ЗаписьСостояния = Неопределено Тогда
		ЗаписьСостояния = РегистрыСведений.iga_СостояниеБота.СоздатьМенеджерЗаписи();
	КонецЕсли;

	ОтправитьТекстЭтапа(ЧатСсылка, ИдЧата, ЭтапСсылка, ВходящиеПараметры);
	
	
	Если Не ПредыдущийЭтап = Неопределено Тогда
		ОбработчикАлгоритвом = Обработки.iga_ОбработчикЭтапов.Создать();
		ОбработчикАлгоритвом.ВходящиеПараметры = ВходящиеПараметры;
		ОбработчикАлгоритвом.ВыполнитьОбработчикСУчетомАлгоритмов(ПредыдущийЭтап.ПослеОбработкиЭтапа);
	КонецЕсли;
	
	Если ТипЭтапа = Перечисления.iga_ТипыЭтапов.ОжиданиеВвода Тогда
		
		ЗаписьСостояния.Чат = ЧатСсылка;
		ЗаписьСостояния.ТекущийЭтап = ЭтапСсылка;
		ЗаписьСостояния.ДатаАктивности = ТекущаяДата();
		ЗаписьСостояния.Записать();
		
		Если Не БезОбщенияСБотом Тогда
			ЗаписьОчереди = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
			ЗаписьОчереди.Чат = ЧатСсылка;
			ЗаписьОчереди.Статус = Перечисления.iga_СтатусыОчереди.ОбщениеСБотом;
			ЗаписьОчереди.ДатаПоследнейАктивности = ТекущаяДата();
			ЗаписьОчереди.Записать();
			
			Менеджер = РегистрыСведений.iga_ПоследниеСтатусыЧатов.СоздатьМенеджерЗаписи();
			Менеджер.Чат = ЧатСсылка;
			Менеджер.СтатусОчереди = Перечисления.iga_СтатусыОчереди.ОбщениеСБотом;
			Менеджер.Записать();
			
		КонецЕсли;
		
	ИначеЕсли ТипЭтапа = Перечисления.iga_ТипыЭтапов.Информационный Тогда
		

		Следующий = Справочники.iga_ЭтапыСценария.ПустаяСсылка();
		Если ЭтапСсылка.ВариантыОтветов.Количество() > 0 Тогда
			Следующий = ЭтапСсылка.ВариантыОтветов[0].СледующийЭтап;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Следующий) Тогда

			ВыполнитьЭтап(ЧатСсылка, ИдЧата, ЭтапСсылка, Следующий, ЗаписьСостояния,, ВходящиеПараметры);
		Иначе
			Если ЗаписьСостояния.Выбран() Тогда
				ЗаписьСостояния.Удалить();
			КонецЕсли;
			
			ЗаписьОчереди = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
			ЗаписьОчереди.Чат = ЧатСсылка;
			ЗаписьОчереди.Прочитать();
			ЗаписьОчереди.Удалить();
		КонецЕсли;
		
	ИначеЕсли ТипЭтапа = Перечисления.iga_ТипыЭтапов.ПереводНаОператора Тогда
		

		Если ЗаписьСостояния.Выбран() Тогда
			ЗаписьСостояния.Удалить();
		КонецЕсли;
		
		ЗаписьОчереди = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		ЗаписьОчереди.Чат = ЧатСсылка;
		ЗаписьОчереди.Прочитать();
		ЗаписьОчереди.Удалить();
		
		Бот = Обработки.iga_ChatBot.Создать();
		Бот.ИнициализацияОсновныхПараметров();
		
		Бот.ПоставитьВОчередь(ЧатСсылка, Истина);
		
	ИначеЕсли ТипЭтапа = Перечисления.iga_ТипыЭтапов.Завершение Тогда
		

		Если ЗаписьСостояния.Выбран() Тогда
			ЗаписьСостояния.Удалить();
		КонецЕсли;
		
		ЗаписьОчереди = РегистрыСведений.iga_ОчередьРаспределения.СоздатьМенеджерЗаписи();
		ЗаписьОчереди.Чат = ЧатСсылка;
		ЗаписьОчереди.Прочитать();
		ЗаписьОчереди.Удалить();

	КонецЕсли;

КонецПроцедуры

Процедура ОтправитьТекстЭтапа(ЧатСсылка, ИдЧата, ЭтапСсылка, ВходящиеПараметры = Неопределено)
	             
	Текст = ЭтапСсылка.ТекстСообщения;
	Обработчик = Обработки.iga_ОбработчикЭтапов.Создать();
	
	Обработчик.ВходящиеПараметры = Новый Структура("Чат, ИдЧата, Этап, ТекстЭтапа", ЧатСсылка, ИдЧата, ЭтапСсылка, Текст);
	
	Если Не ВходящиеПараметры = Неопределено Тогда 
		Для Каждого Параметр Из ВходящиеПараметры Цикл
			Обработчик.ВходящиеПараметры.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтапСсылка.ТипСообщения = Перечисления.iga_ТипыТекстаЭтапа.Шаблон 
		И ЗначениеЗаполнено(ЭтапСсылка.ШаблонСообщения) Тогда
		
		СтруктураСообщения = Справочники.iga_ШаблоныСообщений.ОтправитьСообщение(ЧатСсылка, ИдЧата, ЭтапСсылка.ШаблонСообщения, ВходящиеПараметры);
		
	ИначеЕсли ЗначениеЗаполнено(Текст) Тогда
		
		Бот = Обработки.iga_ChatBot.Создать();
		Бот.ИнициализацияОсновныхПараметров();  
		
		ИтоговыйТекст = Текст;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	iga_ЭтапыСценарияПараметрыПроизвольногоТекста.ИмяПараметра КАК ИмяПараметра,
		               |	iga_ЭтапыСценарияПараметрыПроизвольногоТекста.ЗначениеИсточник КАК ЗначениеИсточник
		               |ИЗ
		               |	Справочник.iga_ЭтапыСценария.ПараметрыПроизвольногоТекста КАК iga_ЭтапыСценарияПараметрыПроизвольногоТекста
		               |ГДЕ
		               |	iga_ЭтапыСценарияПараметрыПроизвольногоТекста.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ЭтапСсылка);
		ВыборкаПараметры = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаПараметры.Следующий() Цикл
			
			Если ТипЗнч(ВыборкаПараметры.ЗначениеИсточник) = Тип("СправочникСсылка.iga_Алгоритмы") Тогда
				Попытка
					РезультатВычисления = Обработчик.ВычислитьАлгоритм(ВыборкаПараметры.ЗначениеИсточник.Алгоритм, 
						ВыборкаПараметры.ЗначениеИсточник.ПараметрыАлгоритма, Новый Массив, 
						ВыборкаПараметры.ЗначениеИсточник);
				Исключение
					Инфо = ИнформацияОбОшибке();
					ХешОшибки = iga_ОбщегоНазначенияСервер.ПолучитьКлючОшибки(Инфо);
					
					// Вызов функции записи из предыдущего ответа (с передачей готового Хеша)
					iga_ОбщегоНазначенияСервер.ЗарегистрироватьОшибкуБота(ХешОшибки, "Чат: " + ВходящиеПараметры.Чат + Символы.ПС + ПодробноеПредставлениеОшибки(Инфо));
					ВызватьИсключение("Ошибка алгоритма заполнения текста этапа. Проверьте журнал.");
				КонецПопытки;
					
			Иначе
				РезультатВычисления = Строка(ВыборкаПараметры.ЗначениеИсточник);
			КонецЕсли;

            ИтоговыйТекст = СтрЗаменить(ИтоговыйТекст, "{" + ВыборкаПараметры.ИмяПараметра + "}", РезультатВычисления);
			
		КонецЦикла;
		
		Бот.ОтправитьПростоеСообщение(ЧатСсылка, ИдЧата, ИтоговыйТекст);
	КонецЕсли;
	
КонецПроцедуры

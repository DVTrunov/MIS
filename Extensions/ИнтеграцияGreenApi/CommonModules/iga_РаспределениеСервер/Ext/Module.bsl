Функция ПолучитьДвоичныеДанныеФайла(IDСообщения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Файлы.ДанныеФайла,
	|	Файлы.ПутьКФайлу,
	|	Файлы.ТипМедиа
	|ИЗ
	|	РегистрСведений.iga_ПрикрепленныеФайлы КАК Файлы
	|ГДЕ
	|	Файлы.IDСообщения = &IDСообщения";
	
	Запрос.УстановитьПараметр("IDСообщения", IDСообщения);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДвоичныеДанные = Неопределено;
	
	ДвоичныеДанные = Выборка.ДанныеФайла.Получить();
	
	Если ДвоичныеДанные = Неопределено И ЗначениеЗаполнено(Выборка.ПутьКФайлу) Тогда
		
		ТипХранилища = Константы.iga_ТипХранилищаФайлов.Получить();
		БазовыйПуть  = Константы.iga_ПутьККаталогуФайлов.Получить();
		
		Если ТипХранилища = ПредопределенноеЗначение("Перечисление.iga_ТипыХранилищФайлов.ЛокальныйКаталог") Тогда
			
			ПолныйПуть = БазовыйПуть + ?(Прав(БазовыйПуть, 1) = "\", "", "\") + Выборка.ПутьКФайлу;
			
			ФайлОбъект = Новый Файл(ПолныйПуть);
			Если ФайлОбъект.Существует() Тогда
				ДвоичныеДанные = Новый ДвоичныеДанные(ПолныйПуть);
			КонецЕсли;
			
		ИначеЕсли ТипХранилища = ПредопределенноеЗначение("Перечисление.iga_ТипыХранилищФайлов.FTP") Тогда
			
			ДвоичныеДанные = ПолучитьДвоичныеДанныеСФТП(БазовыйПуть, Выборка.ПутьКФайлу);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	Результат.Вставить("ТипМедиа",       Выборка.ТипМедиа);
	
	Возврат Результат;

КонецФункции

Функция ПолучитьДвоичныеДанныеСФТП(Сервер, ПутьКФайлу)
	
	Попытка
		Соединение = Новый FTPСоединение(
			Сервер, 
			Константы.iga_ПортFTP.Получить(), 
			Константы.iga_ПользовательFTP.Получить(), 
			Константы.iga_ПарольFTP.Получить(), , 
			Константы.iga_ИспользоватьБезопасноеСоединениеFTP.Получить()
		);
		
		ВременныйФайл = ПолучитьИмяВременногоФайла();
		Соединение.Получить(ПутьКФайлу, ВременныйФайл);
		
		Данные = Новый ДвоичныеДанные(ВременныйФайл);
		УдалитьФайлы(ВременныйФайл);
		
		Возврат Данные;
	Исключение
		ЗаписьЖурналаРегистрации("WhatsApp.Медиа", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка получения файла с FTP: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура ПеренестиФайлыВХранилище() Экспорт
    
    ТипХранилища = Константы.iga_ТипХранилищаФайлов.Получить();
    БазовыйПуть  = Константы.iga_ПутьККаталогуФайлов.Получить();
    
    Если ПустаяСтрока(БазовыйПуть) И ТипХранилища <> Перечисления.iga_ТипыХранилищФайлов.FTP Тогда
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 20
    |	Файлы.IDСообщения КАК IDСообщения,
    |	Файлы.ДанныеФайла КАК ДанныеФайла,
    |	Файлы.ИмяФайла КАК ИмяФайла,
    |	ЕСТЬNULL(iga_ИсторияСообщений.ДатаСообщения, НЕОПРЕДЕЛЕНО) КАК ДатаСообщения
    |ИЗ
    |	РегистрСведений.iga_ПрикрепленныеФайлы КАК Файлы
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ИсторияСообщений КАК iga_ИсторияСообщений
    |		ПО Файлы.IDСообщения = iga_ИсторияСообщений.IDСообщения
    |ГДЕ
    |	Файлы.Статус = ЗНАЧЕНИЕ(Перечисление.iga_СтатусыОбработкиФайлов.Загружен)";

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл
        
        ДвоичныеДанные = Выборка.ДанныеФайла.Получить(); 
        Если ДвоичныеДанные = Неопределено Тогда 
            Продолжить; 
        КонецЕсли;

        Успешно = Ложь;
		
		ДатаЗаписи = ?(Выборка.ДатаСообщения = Неопределено, ТекущаяДата(), Выборка.ДатаСообщения);
		
		ИмяФайла = iga_ОбщегоНазначенияКлиентСервер.ИдеальноеИмяФайла(Выборка.ИмяФайла);
		
        ОтносительныйПуть = Формат(ДатаЗаписи, "ДФ=yyyy\\MM\\dd") + "\" + Выборка.IDСообщения + "_" + ИмяФайла;

        Если ТипХранилища = Перечисления.iga_ТипыХранилищФайлов.FTP Тогда
            Успешно = СохранитьНаFTP(ДвоичныеДанные, ОтносительныйПуть);
        Иначе 
            Успешно = СохранитьВПапку(ДвоичныеДанные, БазовыйПуть, ОтносительныйПуть);
        КонецЕсли;

        Если Успешно Тогда
            Менеджер = РегистрыСведений.iga_ПрикрепленныеФайлы.СоздатьМенеджерЗаписи();
            Менеджер.IDСообщения = Выборка.IDСообщения;
            Менеджер.Прочитать();
            
            Если Менеджер.Выбран() Тогда
                Менеджер.ПутьКФайлу  = ОтносительныйПуть; 
                Менеджер.ДанныеФайла = Новый ХранилищеЗначения(Неопределено); 
                Менеджер.Статус      = Перечисления.iga_СтатусыОбработкиФайлов.Обработан; 
                Менеджер.Записать();
            КонецЕсли;
        КонецЕсли;
        
    КонецЦикла;

КонецПроцедуры

Функция СохранитьВПапку(Данные, База, Путь)
    ПолныйПуть = База + ?(Прав(База, 1) = "\", "", "\") + Путь;
    Каталог = Лев(ПолныйПуть, СтрНайти(ПолныйПуть, "\", НаправлениеПоиска.СКонца));
    СоздатьКаталог(Каталог);
    
    Попытка
        Данные.Записать(ПолныйПуть);
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция СохранитьНаFTP(Данные, Путь)
	Попытка
		
		Сервер = Константы.iga_ПутьККаталогуФайлов.Получить();
		
		Пользователь = Константы.iga_ПользовательFTP.Получить();
		Пароль = Константы.iga_ПарольFTP.Получить();
		
        Соединение = Новый FTPСоединение(Сервер,, Пользователь, Пароль,, Истина);
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		Данные.Записать(ИмяВременногоФайла);

		Соединение.Записать(ИмяВременногоФайла, Путь);
		
        Возврат Истина;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
        Возврат Ложь;
    КонецПопытки;
КонецФункции



// Получает значения реквизитов объекта по ссылке через запрос.
//
// Параметры:
//  Ссылка          - ЛюбаяСсылка - Ссылка на объект (Справочник, Документ и т.д.).
//  ИменаРеквизитов - Строка, Массив - Имя одного реквизита или массив имен (строк).
//
// Возвращаемое значение:
//  Произвольный, Структура - Значение реквизита или Структура (ключ - имя реквизита).
//                            Если объект не найден, возвращает Неопределено.
//
Функция ПолучитьЗначенияРеквизитов(Ссылка, ИменаРеквизитов) Экспорт
	
	Если Ссылка.Пустая() Или ИменаРеквизитов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭтоМассив = (ТипЗнч(ИменаРеквизитов) = Тип("Массив"));
	
	// Формируем список полей для запроса
	ТекстПолей = "";
	Если ЭтоМассив Тогда
		Для Каждого Имя Из ИменаРеквизитов Цикл
			ТекстПолей = ТекстПолей + ?(ПустаяСтрока(ТекстПолей), "", ", ") + Имя;
		КонецЦикла;
	Иначе
		ТекстПолей = ИменаРеквизитов + " КАК Результат";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	" + ТекстПолей + "
		|ИЗ
		|	" + Ссылка.Метаданные().ПолноеИмя() + " КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Если ЭтоМассив Тогда
		// Собираем структуру из имен реквизитов
		Результат = Новый Структура;
		Для Каждого Имя Из ИменаРеквизитов Цикл
			Результат.Вставить(Имя, Выборка[Имя]);
		КонецЦикла;
		Возврат Результат;
	Иначе
		// Возвращаем одиночное значение
		Возврат Выборка.Результат;
	КонецЕсли;
	
КонецФункции

// Преобразует Ссылки в XML-строку, Даты в ISO
// Преобразует данные в "простые" типы, сохраняя информацию о типах ссылок
Функция АдаптироватьСтруктуруДляЭкспорта(Знач Данные) Экспорт
	
	ТипДанных = ТипЗнч(Данные);
	
	// 1. Коллекции (Рекурсия)
	Если ТипДанных = Тип("Структура") Или ТипДанных = Тип("Соответствие") Тогда
		Результат = Новый (ТипДанных);
		Для Каждого Элемент Из Данные Цикл
			Результат.Вставить(Элемент.Ключ, АдаптироватьСтруктуруДляЭкспорта(Элемент.Значение));
		КонецЦикла;
		Возврат Результат;
		
	ИначеЕсли ТипДанных = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			Результат.Добавить(АдаптироватьСтруктуруДляЭкспорта(Элемент));
		КонецЦикла;
		Возврат Результат;
		
	// 2. Ссылочные типы (Справочники, Документы, Перечисления и т.д.)
	ИначеЕсли ЭтоСсылка(ТипДанных) Тогда // Используем БСП или ручную проверку
		// Если БСП нет, можно проверку: Справочники.ТипВсеСсылки().СодержитТип(ТипДанных) и т.д.
		Мета = Метаданные.НайтиПоТипу(ТипДанных);
		Если Мета <> Неопределено Тогда
			Контейнер = Новый Структура;
			Контейнер.Вставить("__Тип1С",  Мета.ПолноеИмя());
			Контейнер.Вставить("__Значение", XMLСтрока(Данные));
			Возврат Контейнер;
		КонецЕсли;
		
	// 3. Даты (ISO 8601)
	ИначеЕсли ТипДанных = Тип("Дата") Тогда
		Возврат Формат(Данные, "ДФ=yyyy-MM-ddTHH:mm:ss");
		
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// Восстанавливает типы 1С из адаптированной структуры
Функция ВосстановитьДанныеИзАдаптированных(Знач Данные) Экспорт
	
	ТипДанных = ТипЗнч(Данные);
	
	// 1. Обработка структур (ищем наши маркеры ссылок)
	Если ТипДанных = Тип("Структура") Или ТипДанных = Тип("Соответствие") Тогда
		
		// Проверяем, не контейнер ли это ссылки
		Если Данные.Количество() = 2 И Данные.Свойство("__Тип1С") И Данные.Свойство("__Значение") Тогда
			Попытка
				ТипОбъекта = Тип(СтрЗаменить(Данные.__Тип1С, ".", "Ссылка."));
				Возврат XMLЗначение(ТипОбъекта, Данные.__Значение);
			Исключение
				Возврат Данные; // Если не смогли восстановить, вернем как есть
			КонецПопытки;
		КонецЕсли;
		
		// Если обычная структура - идем вглубь
		Результат = Новый (ТипДанных);
		Для Каждого Элемент Из Данные Цикл
			Результат.Вставить(Элемент.Ключ, ВосстановитьДанныеИзАдаптированных(Элемент.Значение));
		КонецЦикла;
		Возврат Результат;
		
	// 2. Массивы
	ИначеЕсли ТипДанных = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			Результат.Добавить(ВосстановитьДанныеИзАдаптированных(Элемент));
		КонецЦикла;
		Возврат Результат;
		
	// 3. Строки (проверка на дату)
	ИначеЕсли ТипДанных = Тип("Строка") Тогда
		// Шаблон ISO: 2023-10-27T14:30:00
		Если СтрДлина(Данные) = 19 И Сред(Данные, 11, 1) = "T" Тогда
			Попытка
				// Убираем T для стандартного приведения к дате в 1С
				Возврат Дата(СтрЗаменить(Данные, "T", ""));
			Исключение
				Возврат Данные;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции


// Проверяет, является ли переданное значение или тип ссылкой 1С
// 
// Параметры:
//  ЗначениеИлиТип - Произвольный - То, что проверяем
//
// Возвращаемое значение:
//  Булево - Истина, если это ссылка
Функция ЭтоСсылка(ЗначениеИлиТип) Экспорт
	
	ТипДляПроверки = ?(ТипЗнч(ЗначениеИлиТип) = Тип("Тип"), ЗначениеИлиТип, ТипЗнч(ЗначениеИлиТип));
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипДляПроверки)
		Или Документы.ТипВсеСсылки().СодержитТип(ТипДляПроверки)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ТипДляПроверки)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипДляПроверки)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипДляПроверки)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипДляПроверки)
		Или Задачи.ТипВсеСсылки().СодержитТип(ТипДляПроверки)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипДляПроверки)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипДляПроверки);
		
КонецФункции
	
// Добавляет GET-параметры из структуры к URL-строке.
//
// Параметры:
//  БазовыйURL - Строка    - Исходный URL (например, "https://api.site.ru/get" или "site.ru?a=1")
//  Параметры  - Структура - Ключ (Имя параметра), Значение (Значение параметра)
//
// Возвращаемое значение:
//  Строка - Готовый URL с параметрами.
//
Функция ДобавитьПараметрыКURL(Знач БазовыйURL, Знач Параметры) Экспорт
	
	Если Параметры = Неопределено Или Параметры.Количество() = 0 Тогда
		Возврат БазовыйURL;
	КонецЕсли;
	
	Результат = СокрЛП(БазовыйURL);
	
	// Проверяем, есть ли уже параметры в ссылке
	ЕстьВопрос = (СтрНайти(Результат, "?") > 0);
	
	Для Каждого КлючИЗначение Из Параметры Цикл
		
		ИмяПараметра = КлючИЗначение.Ключ;
		ЗначениеПараметра = КлючИЗначение.Значение;
		ТипЗначения = ТипЗнч(ЗначениеПараметра);
		
		// Обработка разных типов данных
		Если ТипЗначения = Тип("Число") Тогда
			// ЧГ=0 (или ЧГ=) убирает разделители групп (неразрывные пробелы)
			// ЧРД=. принудительно ставит точку как разделитель дроби (стандарт для веб)
			СтрокаЗначения = Формат(ЗначениеПараметра, "ЧГ=0; ЧРД=.");
			
		ИначеЕсли ТипЗначения = Тип("Булево") Тогда
			// Для веба Булево обычно передается как "true" / "false" или "1" / "0"
			СтрокаЗначения = ?(ЗначениеПараметра, "true", "false");
			
		ИначеЕсли ТипЗначения = Тип("Дата") Тогда
			// Стандартный ISO-формат для дат в вебе
			СтрокаЗначения = Формат(ЗначениеПараметра, "ДФ=yyyy-MM-ddTHH:mm:ss");
			
		Иначе
			СтрокаЗначения = Строка(ЗначениеПараметра);
		КонецЕсли;
		
		// Обязательно кодируем ключи и значения (кириллица, пробелы, спецсимволы)
		ИмяПараметраКод = КодироватьСтроку(ИмяПараметра, СпособКодированияСтроки.КодировкаURL);
		ЗначениеПараметраКод = КодироватьСтроку(СтрокаЗначения, СпособКодированияСтроки.КодировкаURL);
		
		Разделитель = ?(ЕстьВопрос, "&", "?");
		
		Результат = Результат + Разделитель + ИмяПараметраКод + "=" + ЗначениеПараметраКод;
		ЕстьВопрос = Истина; // Для следующих параметров ставим амперсанд
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
	
Функция ПолучитьТекстВставкиДляСсылки(Знач ВыбраннаяСсылка) Экспорт
    
    Если ВыбраннаяСсылка = Неопределено ИЛИ Не ЗначениеЗаполнено(ВыбраннаяСсылка) Тогда 
        Возврат ""; 
    КонецЕсли;
    
    ТипСсылки = ТипЗнч(ВыбраннаяСсылка);
    МетаОбъекта = Метаданные.НайтиПоТипу(ТипСсылки);
    
    Если МетаОбъекта = Неопределено Тогда 
        Возврат "// Выбранное значение не является ссылочным типом"; 
    КонецЕсли;
    
    ПолноеИмя = МетаОбъекта.ПолноеИмя();
    Части = СтрРазделить(ПолноеИмя, ".");
    
    КлассОбъекта = Части[0];
    ИмяОбъекта   = Части[1];
    
    // --- СПЕЦИАЛЬНАЯ ОБРАБОТКА ДЛЯ ПЕРЕЧИСЛЕНИЙ ---
    Если КлассОбъекта = "Перечисление" Тогда
        ИндексЗначения = Перечисления[ИмяОбъекта].Индекс(ВыбраннаяСсылка);
        ИмяЗначения = МетаОбъекта.ЗначенияПеречисления[ИндексЗначения].Имя;
        Возврат "Перечисления." + ИмяОбъекта + "." + ИмяЗначения + ";";
    КонецЕсли;
    
    // --- ПРЕОБРАЗУЕМ КЛАСС В МЕНЕДЖЕР И ОПРЕДЕЛЯЕМ ПОДДЕРЖКУ ПРЕДОПРЕДЕЛЕННЫХ ---
    Менеджер = "";
    ПоддерживаетПредопределенные = Ложь;
    
    Если КлассОбъекта = "Справочник" Тогда
        Менеджер = "Справочники";
        ПоддерживаетПредопределенные = Истина;
    ИначеЕсли КлассОбъекта = "Документ" Тогда
        Менеджер = "Документы";
        // Документы не бывают предопределенными
    ИначеЕсли КлассОбъекта = "ПланВидовХарактеристик" Тогда
        Менеджер = "ПланыВидовХарактеристик";
        ПоддерживаетПредопределенные = Истина;
    ИначеЕсли КлассОбъекта = "ПланСчетов" Тогда
        Менеджер = "ПланыСчетов";
        ПоддерживаетПредопределенные = Истина;
    ИначеЕсли КлассОбъекта = "ПланВидовРасчета" Тогда
        Менеджер = "ПланыВидовРасчета";
        ПоддерживаетПредопределенные = Истина;
    ИначеЕсли КлассОбъекта = "ПланОбмена" Тогда
        Менеджер = "ПланыОбмена";
        ПоддерживаетПредопределенные = Истина;
    ИначеЕсли КлассОбъекта = "БизнесПроцесс" Тогда
        Менеджер = "БизнесПроцессы";
    ИначеЕсли КлассОбъекта = "Задача" Тогда
        Менеджер = "Задачи";
    Иначе
        Возврат "// Тип """ + КлассОбъекта + """ не поддерживает получение по GUID";
    КонецЕсли;
    
    // --- ПРОВЕРКА НА ПРЕДОПРЕДЕЛЕННЫЙ ЭЛЕМЕНТ ---
    Если ПоддерживаетПредопределенные Тогда
        // Если это предопределенный элемент, получаем его красивое имя
        Если ВыбраннаяСсылка.Предопределенный Тогда
            ИмяПредопределенного = ВыбраннаяСсылка.ИмяПредопределенныхДанных;
            Если ЗначениеЗаполнено(ИмяПредопределенного) Тогда
                // Возвращаем строку без GUID: Справочники.Валюты.Рубль;
                Возврат Менеджер + "." + ИмяОбъекта + "." + ИмяПредопределенного + ";";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    
    // --- ГЕНЕРАЦИЯ ПО GUID (ДЛЯ ОБЫЧНЫХ ЭЛЕМЕНТОВ И ДОКУМЕНТОВ) ---
    СтрокаГУИД = Строка(ВыбраннаяСсылка.УникальныйИдентификатор());
    Результат = Менеджер + "." + ИмяОбъекта + ".ПолучитьСсылку(Новый УникальныйИдентификатор(""" + СтрокаГУИД + """))";
    
    Возврат Результат;
    
КонецФункции

Процедура ЗарегистрироватьОшибкуБота(ХешОшибки, Ошибка) Экспорт
	
	Запись = РегистрыСведений.iga_ОшибкиОбработчиков.СоздатьМенеджерЗаписи();
	Запись.ХешОшибки = ХешОшибки;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Запись.ХешОшибки = ХешОшибки;
		Запись.Подробности = Ошибка;
		Запись.ДатаОшибки = ТекущаяДата();
	КонецЕсли;
	Запись.ДатаПоследнейОшибки = ТекущаяДата();
	Запись.Записать();
	
КонецПроцедуры

// Вызывается в блоке Исключение, например: Ключ = ПолучитьКлючОшибки(ИнформацияОбОшибке());
Функция ПолучитьКлючОшибки(ИнфоОбОшибке) Экспорт
    
    // Проваливаемся в самую суть ошибки (ищем первопричину)
    ТекущаяОшибка = ИнфоОбОшибке;
    Пока ТекущаяОшибка.Причина <> Неопределено Цикл
        ТекущаяОшибка = ТекущаяОшибка.Причина;
    КонецЦикла;
    
    // Собираем данные для хеширования
    Модуль = ?(ПустаяСтрока(ТекущаяОшибка.ИмяМодуля), "НеизвестныйМодуль", ТекущаяОшибка.ИмяМодуля);
    СтрокаКода = Формат(ТекущаяОшибка.НомерСтроки, "ЧГ=0");
    ТекстКода = ТекущаяОшибка.ИсходнаяСтрока;
    
    // Формируем уникальную строку (fingerprint)
    УникальнаяСтрока = Модуль + "|" + СтрокаКода + "|" + ТекстКода;
    
    // Возвращаем CRC32
    Хеширование = Новый ХешированиеДанных(ХешФункция.CRC32);
    Хеширование.Добавить(УникальнаяСтрока); 
    
    Возврат Хеширование.ХешСумма;
    
КонецФункции

Функция ПолучитьПродолжительностьСтрокой(ДатаНачала, ДатаОкончания) Экспорт
    
    // Проверка на заполненность дат и на то, что ДатаНачала > ДатаОкончания
    Если Не ЗначениеЗаполнено(ДатаНачала) 
        Или Не ЗначениеЗаполнено(ДатаОкончания) 
        Или ДатаНачала >= ДатаОкончания Тогда
        Возврат "0 м.";
    КонецЕсли;
    
    // В 1С разница дат возвращается в секундах
    РазницаВСекундах = ДатаОкончания - ДатаНачала;
    
    // Вычисляем составляющие времени
    Дни     = Цел(РазницаВСекундах / 86400);
    Остаток = РазницаВСекундах % 86400;
    
    Часы    = Цел(Остаток / 3600);
    Остаток = Остаток % 3600;
    
    Минуты  = Цел(Остаток / 60);
    Секунды = Остаток % 60;
    
    // Формируем результирующую строку
    МассивСтрок = Новый Массив;
    
    Если Дни > 0 Тогда
        МассивСтрок.Добавить(Формат(Дни, "ЧГ=") + " д.");
    КонецЕсли;
    
    Если Часы > 0 Тогда
        МассивСтрок.Добавить(Формат(Часы, "ЧГ=") + " ч.");
    КонецЕсли;
    
    Если Минуты > 0 Тогда
        МассивСтрок.Добавить(Формат(Минуты, "ЧГ=") + " м.");
    КонецЕсли;
    
    Если Секунды > 0 Тогда
        МассивСтрок.Добавить(Формат(Секунды, "ЧГ=") + " с.");
    КонецЕсли;
    
    // Если разница составила меньше секунды (что в рамках 1С маловероятно при обычных датах, 
    // но возможно при работе с миллисекундами) или что-то пошло не так
    Если МассивСтрок.Количество() = 0 Тогда
        Возврат "0 м.";
    КонецЕсли;
    
    // Соединяем элементы массива через пробел
    Возврат СтрСоединить(МассивСтрок, " ");
    
КонецФункции

Функция ПолучитьТекущийХэшБазы() Экспорт
	
	СтрокаСоединения = СтрЗаменить(СтрокаСоединенияИнформационнойБазы(), "localhost", ИмяКомпьютера());
	
	Хеш = Новый ХешированиеДанных(ХешФункция.CRC32);
	Хеш.Добавить(СтрокаСоединения);
	ХешБазы = Хеш.ХешСумма;
	
	Возврат ХешБазы;
	
КонецФункции


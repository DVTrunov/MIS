Процедура iga_ПроверкаОператоровНаОнлайн() Экспорт
	
	Если Не СоответствиеХешаПройдено() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_НастройкиОператоров.Оператор КАК Оператор,
	               |	iga_НастройкиОператоров.Оператор.Код КАК ОператорКод
	               |ИЗ
	               |	РегистрСведений.iga_НастройкиОператоров КАК iga_НастройкиОператоров
	               |ГДЕ
	               |	iga_НастройкиОператоров.Статус = &СтатусОнлайн";
	Запрос.УстановитьПараметр("СтатусОнлайн", Перечисления.iga_СтатусыОператоров.Онлайн);
	Выборка = Запрос.Выполнить().Выбрать();
	АктивныеСоединения = ПолучитьСеансыИнформационнойБазы();
	Пока Выборка.Следующий() Цикл
		
			
		ПользовательВСети = Ложь;
		
		Для Каждого Соединение Из АктивныеСоединения Цикл
			Если Соединение.Пользователь.Имя = Выборка.ОператорКод Тогда
				ПользовательВСети = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПользовательВСети Тогда 
			Продолжить; 
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Событие", "_$Session$_.Finish");
		Отбор.Вставить("Пользователь", Выборка.ОператорКод);
		
		ТаблицаЖурнала = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор, "Дата", , 1); 
		
		Если ТаблицаЖурнала.Количество() > 0 Тогда
			ДатаЗавершения = ТаблицаЖурнала[0].Дата;
			
			ТекущийМомент = ТекущаяДатаСеанса();
			РазницаВСекундах = ТекущийМомент - ДатаЗавершения;
			
			Если РазницаВСекундах > 300 Тогда
				
				
				ЗаписьНастроекОператора = РегистрыСведений.iga_НастройкиОператоров.СоздатьМенеджерЗаписи();
				ЗаписьНастроекОператора.Оператор = Выборка.Оператор;
				ЗаписьНастроекОператора.Прочитать();
				Если ЗаписьНастроекОператора.Выбран() Тогда
					ЗаписьНастроекОператора.Статус = Перечисления.iga_СтатусыОператоров.Оффлайн;
					ЗаписьНастроекОператора.ПриниматьНовыеЧаты = Ложь;
					ЗаписьНастроекОператора.Записать();
				КонецЕсли;
				
			КонецЕсли;
		Иначе
			ЗаписьНастроекОператора = РегистрыСведений.iga_НастройкиОператоров.СоздатьМенеджерЗаписи();
			ЗаписьНастроекОператора.Оператор = Выборка.Оператор;
			ЗаписьНастроекОператора.Прочитать();
			Если ЗаписьНастроекОператора.Выбран() Тогда
				ЗаписьНастроекОператора.Статус = Перечисления.iga_СтатусыОператоров.Оффлайн;
				ЗаписьНастроекОператора.ПриниматьНовыеЧаты = Ложь;
				ЗаписьНастроекОператора.Записать();
			КонецЕсли;
			
		КонецЕсли;
		

		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура iga_ОбработкаПакетныхОповещений() Экспорт
	
	Если Не СоответствиеХешаПройдено() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ПлановыеОповещенияПользователей.Заявка КАК Заявка,
	               |	iga_ПлановыеОповещенияПользователей.ДатаОповещения КАК ДатаОповещения,
	               |	iga_ПлановыеОповещенияПользователей.ШаблонОповещения КАК ШаблонОповещения,
	               |	iga_ПлановыеОповещенияПользователей.АлгоритмОповещения КАК АлгоритмОповещения,
	               |	iga_ПлановыеОповещенияПользователей.Чат КАК Чат,
	               |	iga_ПлановыеОповещенияПользователей.Чат.Идентификатор КАК ИдЧата,
	               |	iga_ПлановыеОповещенияПользователей.АлгоритмПередОповещением КАК АлгоритмПередОповещением,
	               |	iga_ПлановыеОповещенияПользователей.Пакет КАК Пакет
	               |ИЗ
	               |	РегистрСведений.iga_ПлановыеОповещенияПользователей КАК iga_ПлановыеОповещенияПользователей
	               |ГДЕ
	               |	iga_ПлановыеОповещенияПользователей.Заявка.Проведен
	               |	И iga_ПлановыеОповещенияПользователей.ДатаОповещения <= &ТекущаяДата
	               |	И НЕ iga_ПлановыеОповещенияПользователей.Отправлено
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОповещения";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	ВыборкаОповещений = Запрос.Выполнить().Выбрать();
	
	ОбработчикАлгоритмов = Обработки.iga_ОбработчикЭтапов.Создать();
	
	ОбработчикАлгоритмов.ВходящиеПараметры = Новый Структура;

	Пока ВыборкаОповещений.Следующий() Цикл
		
		iga_НапоминанияВызовСервера.ВыполнитьОповещениеПакета(ВыборкаОповещений, ОбработчикАлгоритмов);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура iga_ОбработкаНастраиваемыхАлгоритмов() Экспорт
	
	Если Не СоответствиеХешаПройдено() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_АлгоритмыВРасписании.АлгоритмПроверки КАК АлгоритмПроверки,
	               |	iga_АлгоритмыВРасписании.АлгоритмВыполнения КАК АлгоритмВыполнения
	               |ИЗ
	               |	РегистрСведений.iga_АлгоритмыВРасписании КАК iga_АлгоритмыВРасписании
	               |ГДЕ
	               |	iga_АлгоритмыВРасписании.Активно
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	iga_АлгоритмыВРасписании.Порядок";
	ВыборкаАлгоритмов = Запрос.Выполнить().Выбрать();
	ОбработчикАлгоритмов = Обработки.iga_ОбработчикЭтапов.Создать();
	Пока ВыборкаАлгоритмов.Следующий() Цикл
		ОбработчикАлгоритмов.ВходящиеПараметры = Новый Структура;
		
		РезультатПроверки = ОбработчикАлгоритмов.ВыполнитьАлгоритмВИсключении(ВыборкаАлгоритмов.АлгоритмПроверки);
		Если Не РезультатПроверки = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработчикАлгоритмов.ВыполнитьАлгоритмВИсключении(ВыборкаАлгоритмов.АлгоритмВыполнения);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура iga_ОчисткаОтправленныхОповещений() Экспорт
	
	Если Не СоответствиеХешаПройдено() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ПлановыеОповещенияПользователей.Заявка КАК Заявка,
	               |	iga_ПлановыеОповещенияПользователей.ДатаОповещения КАК ДатаОповещения
	               |ИЗ
	               |	РегистрСведений.iga_ПлановыеОповещенияПользователей КАК iga_ПлановыеОповещенияПользователей
	               |ГДЕ
	               |	iga_ПлановыеОповещенияПользователей.ДатаОповещения < &ТекущаяДата
	               |	И iga_ПлановыеОповещенияПользователей.Отправлено
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОповещения";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	ВыборкаОповещений = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаОповещений.Следующий() Цикл
		Запись = РегистрыСведений.iga_ЗаписиКОповещению.СоздатьМенеджерЗаписи();
		Запись.Заявка = ВыборкаОповещений.Заявка;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда 
			Запись.Удалить();
		КонецЕсли;
		
		Запись = РегистрыСведений.iga_ЗаявкиКОповещениюПоПредоплате.СоздатьМенеджерЗаписи();
		Запись.Заявка = ВыборкаОповещений.Заявка;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда 
			Запись.Удалить();
		КонецЕсли;
		
		Запись = РегистрыСведений.iga_ПлановыеОповещенияПользователей.СоздатьМенеджерЗаписи();
		Запись.Заявка = ВыборкаОповещений.Заявка;
		Запись.ДатаОповещения = ВыборкаОповещений.ДатаОповещения;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда 
			Запись.Удалить();
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

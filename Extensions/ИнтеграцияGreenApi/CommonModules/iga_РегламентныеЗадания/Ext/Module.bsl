Процедура ОтменитьЗаписьПоЗаявке(Заявка, Работа, ДатаЗаписи)
	
	Запись = РегистрыСведений.iga_СтатусыПодтвержденияСтрокЗаявок.СоздатьМенеджерЗаписи();
	Запись.Заявка = Заявка;
	Запись.Работа = Работа;
	Запись.ДатаЗаписи = ДатаЗаписи;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Запись.Статус = Перечисления.iga_СтатусыПодтвержденияЗаявок.ОтмененоАвтоматически;
		Запись.Записать();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Заявка КАК Заявка
	               |ИЗ
	               |	РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
	               |ГДЕ
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Заявка = &Заявка
	               |	И iga_СтатусыПодтвержденияСтрокЗаявок.Статус В(&Статусы)";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.iga_СтатусыПодтвержденияЗаявок.ПустаяСсылка());
	Статусы.Добавить(Перечисления.iga_СтатусыПодтвержденияЗаявок.Подтверждено);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	НетПодтвержденных = Запрос.Выполнить().Пустой();
	
	Если НетПодтвержденных Тогда
		ЗаявкаОбъект = Заявка.ПолучитьОбъект();
		ЗаявкаОбъект.Состояние = Перечисления.ВидыСостоянийЗаявок.Отменена;
		ЗаявкаОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура iga_ОбработкаОповещенийВЧатах() Экспорт
	
	Если Не СоответствиеХешаПройдено() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	iga_ОповещенияПоВремени.Заявка КАК Заявка,
	               |	iga_ОповещенияПоВремени.ДатаОповещения КАК ДатаОповещения,
	               |	iga_ОповещенияПоВремени.ТребуетсяПодтверждение КАК ТребуетсяПодтверждение,
	               |	iga_ОповещенияПоВремени.ДатаЗаписи КАК ДатаЗаписи,
	               |	iga_ОповещенияПоВремени.Чат КАК Чат,
	               |	iga_ОповещенияПоВремени.Чат.Идентификатор КАК ЧатИдентификатор,
	               |	iga_ОповещенияПоВремени.ШаблонОповещения КАК ШаблонОповещения,
	               |	СтатусыСПодтверждением.Статус = &СтатусПодтверждено КАК Подтверждено,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Работа КАК Работа,
	               |	iga_ОповещенияПоВремени.Заявка.Состояние = &СостояниеЗапланирована
	               |		И НЕ iga_ОповещенияПоВремени.Заявка.Состояние = &СостояниеПодтверждена КАК ОтправитьОповещение
	               |ИЗ
	               |	РегистрСведений.iga_ОповещенияПоВремени КАК iga_ОповещенияПоВремени
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
	               |		ПО iga_ОповещенияПоВремени.Заявка = iga_СтатусыПодтвержденияСтрокЗаявок.Заявка
	               |			И iga_ОповещенияПоВремени.ДатаЗаписи = iga_СтатусыПодтвержденияСтрокЗаявок.ДатаЗаписи
	               |			И (ВЫБОР
	               |				КОГДА iga_ОповещенияПоВремени.ТребуетсяПодтверждение
	               |					ТОГДА iga_СтатусыПодтвержденияСтрокЗаявок.Статус = &СтатусПусто
	               |				ИНАЧЕ ИСТИНА
	               |			КОНЕЦ)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК СтатусыСПодтверждением
	               |		ПО iga_ОповещенияПоВремени.Заявка = СтатусыСПодтверждением.Заявка
	               |			И iga_ОповещенияПоВремени.ДатаЗаписи = СтатусыСПодтверждением.ДатаЗаписи
	               |ГДЕ
	               |	НЕ iga_ОповещенияПоВремени.Выполнено
	               |	И iga_ОповещенияПоВремени.ДатаОповещения <= &ТекущаяДата
	               |	И ВЫБОР
	               |			КОГДА iga_ОповещенияПоВремени.ТребуетсяПодтверждение
	               |				ТОГДА iga_СтатусыПодтвержденияСтрокЗаявок.Статус = &СтатусПусто
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И iga_ОповещенияПоВремени.Заявка.Проведен
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОповещения";
	Запрос.УстановитьПараметр("СостояниеЗапланирована", Справочники.ВидыСостоянийЗаявок.Запланирована);
	
	СостояниеПодтверждена = Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Подтверждена");
	
	Запрос.УстановитьПараметр("СостояниеПодтверждена", СостояниеПодтверждена);
	Запрос.УстановитьПараметр("СтатусПусто", Перечисления.iga_СтатусыПодтвержденияЗаявок.ПустаяСсылка());
	Запрос.УстановитьПараметр("СтатусПодтверждено", Перечисления.iga_СтатусыПодтвержденияЗаявок.Подтверждено);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	ВыборкаЗаписей = Запрос.Выполнить().Выбрать();
	ВыполненныеОпвещенияЧатов = Новый Соответствие;
	
	Пока ВыборкаЗаписей.Следующий() Цикл
		
		Если Не ВыполненныеОпвещенияЧатов.Получить(ВыборкаЗаписей.Чат) = Неопределено Или Не ВыборкаЗаписей.ОтправитьОповещение Тогда
			Запись = РегистрыСведений.iga_ОповещенияПоВремени.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗаписей);
			Запись.Выполнено = Истина;
			Запись.Записать();
			Продолжить;
		Иначе
			iga_МетодыРаботыСБотом.УстановитьПараметрОбщения(ВыборкаЗаписей.Чат, "ОтправленоОповещение", Истина);
		КонецЕсли;
		
		ВыполненныеОпвещенияЧатов.Вставить(ВыборкаЗаписей.Чат, Истина);
		
		ВходящиеПараметры = Новый Структура;
		ВходящиеПараметры.Вставить("Заявка", ВыборкаЗаписей.Заявка);
		ВходящиеПараметры.Вставить("ДатаЗаписи", ВыборкаЗаписей.ДатаЗаписи);
		
		ДанныеСообщения = Неопределено;
		
		Если Не ЗначениеЗаполнено(ВыборкаЗаписей.ШаблонОповещения) Тогда
			
			Если ВыборкаЗаписей.ТребуетсяПодтверждение Тогда
				ДанныеСообщения = Справочники.iga_ШаблоныСообщений.ОтправитьСообщение(ВыборкаЗаписей.Чат, ВыборкаЗаписей.ЧатИдентификатор, 
					Перечисления.iga_ВидыПредопределенныхШаблонов.ПодтверждениеЗаписи, ВходящиеПараметры);
			Иначе
					
				ДанныеСообщения = Справочники.iga_ШаблоныСообщений.ОтправитьСообщение(ВыборкаЗаписей.Чат, ВыборкаЗаписей.ЧатИдентификатор, 
					Перечисления.iga_ВидыПредопределенныхШаблонов.ОповещениеОЗаписи, ВходящиеПараметры);
			КонецЕсли; 
		Иначе                       
			Если ВыборкаЗаписей.ТребуетсяПодтверждение Тогда
				ДанныеСообщения = Справочники.iga_ШаблоныСообщений.ОтправитьСообщение(ВыборкаЗаписей.Чат, ВыборкаЗаписей.ЧатИдентификатор, 
					ВыборкаЗаписей.ШаблонОповещения, ВходящиеПараметры);
			Иначе
				ДанныеСообщения = Справочники.iga_ШаблоныСообщений.ОтправитьСообщение(ВыборкаЗаписей.Чат, ВыборкаЗаписей.ЧатИдентификатор, 
					ВыборкаЗаписей.ШаблонОповещения, ВходящиеПараметры);
			КонецЕсли;
		КонецЕсли;

		Запись = РегистрыСведений.iga_ОповещенияПоВремени.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗаписей);
		Запись.Выполнено = Истина;
		Запись.Записать();
		
		Если Не ДанныеСообщения = Неопределено Тогда 
			iga_МетодыРаботыСБотом.УстановитьПараметрСообщения(ВыборкаЗаписей.Чат, 
				ДанныеСообщения.IDСообщения, "ДатаЗаписи", ВыборкаЗаписей.ДатаЗаписи);
				
			iga_МетодыРаботыСБотом.УстановитьПараметрСообщения(ВыборкаЗаписей.Чат, 
				ДанныеСообщения.IDСообщения, "Заявка", ВыборкаЗаписей.Заявка);
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("СтатусПусто", Перечисления.iga_СтатусыПодтвержденияЗаявок.ПустаяСсылка());
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Заявка КАК Заявка,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Работа КАК Работа,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.ДатаЗаписи КАК ДатаЗаписи,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Статус КАК Статус,
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.Обработано КАК Обработано
	               |ИЗ
	               |	РегистрСведений.iga_СтатусыПодтвержденияСтрокЗаявок КАК iga_СтатусыПодтвержденияСтрокЗаявок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.iga_ОповещенияПоВремени КАК iga_ОповещенияПоВремени
	               |		ПО iga_СтатусыПодтвержденияСтрокЗаявок.ДатаЗаписи = iga_ОповещенияПоВремени.ДатаЗаписи
	               |			И iga_СтатусыПодтвержденияСтрокЗаявок.Заявка = iga_ОповещенияПоВремени.Заявка
	               |			И (iga_ОповещенияПоВремени.Выполнено)
	               |			И (iga_ОповещенияПоВремени.ТребуетсяПодтверждение)
	               |ГДЕ
	               |	iga_СтатусыПодтвержденияСтрокЗаявок.ДатаЗаписи >= &ТекущаяДата
	               |	И iga_СтатусыПодтвержденияСтрокЗаявок.Статус = &СтатусПусто
	               |	И РАЗНОСТЬДАТ(iga_ОповещенияПоВремени.ДатаОповещения, &ТекущаяДата, ЧАС) >= 2
	               |	И ЧАС(&ТекущаяДата) >= 7
	               |	И ЧАС(&ТекущаяДата) <= 20";
	ВыборкаЗаписей = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗаписей.Следующий() Цикл
		Запись = РегистрыСведений.iga_СтатусыПодтвержденияСтрокЗаявок.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗаписей);
		Запись.Статус = Перечисления.iga_СтатусыПодтвержденияЗаявок.Просрочено;
		Запись.Записать();
	КонецЦикла;
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	iga_ОповещенияПоВремени.ДатаОповещения КАК ДатаОповещения,
	//               |	iga_ОповещенияПоВремени.Заявка КАК Заявка
	//               |ИЗ
	//               |	РегистрСведений.iga_ОповещенияПоВремени КАК iga_ОповещенияПоВремени
	//               |ГДЕ

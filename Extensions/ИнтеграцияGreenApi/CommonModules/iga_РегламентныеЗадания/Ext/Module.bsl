
Функция ПолучитьДатыХолодногоЗапуска()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	iga_ЖурналХолодногоЗапускаСрезПоследних.Период КАК ДатаОкончания,
	               |	iga_ЖурналХолодногоЗапускаСрезПоследних.ДатаНачала КАК ДатаНачала
	               |ИЗ
	               |	РегистрСведений.iga_ЖурналХолодногоЗапуска.СрезПоследних КАК iga_ЖурналХолодногоЗапускаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("ДатаНачала, ДатаОкончания", Выборка.ДатаНачала, Выборка.ДатаОкончания);
	КонецЕсли;
	
	Возврат Новый Структура("ДатаНачала, ДатаОкончания", Дата(1,1,1), Дата(1,1,1));
	
КонецФункции

Функция СоответствиеХешаПройдено()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ХешБазы = iga_ОбщегоНазначенияСервер.ПолучитьТекущийХэшБазы();
	
	ХешКонтстанты = Константы.iga_ХешБазыДляПроверки.Получить();
	
	УстановитьПривилегированныйРежим(Ложь);                     
	
	Возврат ХешБазы = ХешКонтстанты;
	
КонецФункции

Процедура iga_GreenAPIПроверкаИЗапускБота() Экспорт
	
	Если Не СоответствиеХешаПройдено() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВремяОбработчика = Константы.iga_ВремяЖизниОбработчика.Получить() + 60;
	ВремяОбработчика = Макс(ВремяОбработчика, 3600);
	
	ДатаЗавершения = ТекущаяДата() + ВремяОбработчика;
	
	ОбработкаЧатБота = Обработки.iga_ChatBot.Создать();
	
	ОбработкаЧатБота.ИнициализацияОсновныхПараметров();
	ОбработкаЧатБота.ВремяРаботыОператоров = Новый Структура("Начало, Конец", 
		Константы.iga_ВремяНачалаРабочегоДня.Получить(), Константы.iga_ВремяОкончанияРабочегоДня.Получить());
	
	ДатыХолодногоЗапуска = ПолучитьДатыХолодногоЗапуска();
	
	ОбработкаЧатБота.ДатаНачалаХолодногоЗапуска = ДатыХолодногоЗапуска.ДатаНачала;
	ОбработкаЧатБота.ДатаОкончанияХолодногоЗапуска = ДатыХолодногоЗапуска.ДатаОкончания;
	ОбработкаЧатБота.ДатаНачалаОбработкиСообщений = Константы.iga_ДатаИВремяНачалаОбработкиСообщений.Получить();
	ОбработкаЧатБота.СтартовыйСценарий = Константы.iga_СтартовыйЭтапБота.Получить();
	
	//Пока ТекущаяДата() <= ДатаЗавершения Цикл
		
		ВыполнитьЧтениеСообщений = Константы.iga_ЧатБотИспользуется.Получить();
		
		Если Не ВыполнитьЧтениеСообщений Тогда
			//Прервать;
		КонецЕсли;
		
		ОбработкаЧатБота.ПолучитьИОбработатьСообщенияИзОчереди();
		
		//Задержка = Константы.iga_ЗадержкаМеждуЧтениемСообщений.Получить();
		//Задержка = ?(Задержка = 0, 3, Задержка);
		
		//ПаузаИсполнения(Задержка);
		
	//КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПаузаИсполнения(Секунд) Экспорт 
    
    WshShell = Новый COMОбъект("WScript.Shell");
    WshShell.Run("timeout /T " + XMLСтрока(Цел(Секунд)), 0, Истина);    
    

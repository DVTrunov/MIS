Функция ОбработкаPay(Запрос) Экспорт
	Возврат ОбработатьУведомление(Запрос, Ложь);
КонецФункции

Функция ОбработкаFail(Запрос) Экспорт
	Возврат ОбработатьУведомление(Запрос, Истина);
КонецФункции

Функция ОбработатьУведомление(Запрос, ЭтоFail)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		Попытка
			IPКлиента = Запрос.Заголовки.Получить("X-Forwarded-For");
			Если ЗначениеЗаполнено(IPКлиента) Тогда
				// X-Forwarded-For может содержать цепочку адресов через запятую,
				// если запрос проходит через несколько прокси - берём первый (исходный клиент)
				IPКлиента = СокрЛП(СтрРазделить(IPКлиента, ",")[0]);
			КонецЕсли;
			Если Не омг_Предоплата.омг_IPАдресДоверенный(IPКлиента) Тогда
				ЗаписьЖурналаРегистрации("омг_TipTopWebhook", УровеньЖурналаРегистрации.Предупреждение,,,
					"Уведомление с недоверенного IP: " + IPКлиента);
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		Параметры = омг_РазобратьUrlEncodedТело(Запрос.ПолучитьТелоКакСтроку());
		
		InvoiceId      = ?(Параметры["InvoiceId"] = Неопределено, "", Параметры["InvoiceId"]);
		TransactionId  = ?(Параметры["TransactionId"] = Неопределено, "", Параметры["TransactionId"]);
		СтрокаСуммы    = ?(Параметры["Amount"] = Неопределено, "", Параметры["Amount"]);
		
		Если ПустаяСтрока(InvoiceId) Тогда
			ЗаписьЖурналаРегистрации("омг_TipTopWebhook", УровеньЖурналаРегистрации.Ошибка,,,
				"Не удалось разобрать тело уведомления или отсутствует InvoiceId. Content-Type: "
				+ Запрос.Заголовки.Получить("Content-Type"));
			Ответ.УстановитьТелоИзСтроки("{""code"":0}");
			Возврат Ответ;
		КонецЕсли;
		
		ДанныеПредоплаты = омг_Предоплата.НайтиДанныеПредоплатыПоInvoiceId(InvoiceId);
		
		Если Не ДанныеПредоплаты.Найдено Тогда
			ЗаписьЖурналаРегистрации("омг_TipTopWebhook", УровеньЖурналаРегистрации.Ошибка,,,
				"Не найдена предоплата по InvoiceId=" + InvoiceId);
			Ответ.УстановитьТелоИзСтроки("{""code"":0}");
			Возврат Ответ;
		КонецЕсли;
		
		Если Не омг_Предоплата.омг_ПроверитьПодписьУведомления(Запрос, ДанныеПредоплаты.Пароль) Тогда
			ЗаписьЖурналаРегистрации("омг_TipTopWebhook", УровеньЖурналаРегистрации.Ошибка,,,
				"Не прошла проверка подписи Content-HMAC, InvoiceId=" + InvoiceId);
			Ответ.КодСостояния = 400;
			Ответ.УстановитьТелоИзСтроки("{""code"":1}");
			Возврат Ответ;
		КонецЕсли;
		
		Если Не ЭтоFail Тогда
			ПолученнаяСумма = Число(СтрЗаменить(СтрокаСуммы, ".", ","));
			Если Окр(ПолученнаяСумма, 2) <> Окр(ДанныеПредоплаты.Сумма, 2) Тогда
				ЗаписьЖурналаРегистрации("омг_TipTopWebhook", УровеньЖурналаРегистрации.Ошибка,,,
					"Расхождение суммы: ожидалось " + ДанныеПредоплаты.Сумма + ", получено "
					+ ПолученнаяСумма + ", InvoiceId=" + InvoiceId);
				Ответ.УстановитьТелоИзСтроки("{""code"":0}");
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;
		
		Статус = ?(ЭтоFail, Перечисления.омг_СтатусыПредоплаты.НетОплаты, Перечисления.омг_СтатусыПредоплаты.ОплатаПринята);
		
		омг_Предоплата.омг_ОбновитьСтатусыПредоплатВРегистре(
			ДанныеПредоплаты.Заявка,
			Статус,
			ДанныеПредоплаты.КоличествоПроверок,
			?(ЭтоFail, "", TransactionId),
			ДанныеПредоплаты.ПлатежныйДокумент,
			ДанныеПредоплаты.Организация,
			ДанныеПредоплаты.ИНН,
			ДанныеПредоплаты.Логин,
			ДанныеПредоплаты.Пароль,
			Истина);
		
		Ответ.УстановитьТелоИзСтроки("{""code"":0}");
		
	Исключение
		ЗаписьЖурналаРегистрации("омг_TipTopWebhook", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		Ответ.УстановитьТелоИзСтроки("{""code"":0}");
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

Функция ОбработкаRefund(Запрос) Экспорт
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		Параметры = омг_РазобратьUrlEncodedТело(Запрос.ПолучитьТелоКакСтроку());
		TransactionId = ?(Параметры["TransactionId"] = Неопределено, "", Параметры["TransactionId"]);
		PaymentTransactionId = ?(Параметры["PaymentTransactionId"] = Неопределено, "", Параметры["PaymentTransactionId"]);
		
		Если ЗначениеЗаполнено(PaymentTransactionId) Тогда
			
			ДанныеПредоплаты = омг_Предоплата.НайтиДанныеПредоплатыПоTransactionId(PaymentTransactionId);
			
			Если ДанныеПредоплаты.Найдено Тогда
				Если Не омг_Предоплата.омг_ПроверитьПодписьУведомления(Запрос, ДанныеПредоплаты.Пароль) Тогда
					ЗаписьЖурналаРегистрации("омг_TipTopWebhook", УровеньЖурналаРегистрации.Ошибка,,,
						"Refund: не прошла проверка подписи, PaymentTransactionId=" + PaymentTransactionId);
					Ответ.КодСостояния = 400;
					Ответ.УстановитьТелоИзСтроки("{""code"":1}");
					Возврат Ответ;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		омг_Предоплата.омг_ЗавершитьВозвратПоTransactionId(TransactionId);
		
		Ответ.УстановитьТелоИзСтроки("{""code"":0}");
		
	Исключение
		ЗаписьЖурналаРегистрации("омг_TipTopWebhook", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		Ответ.УстановитьТелоИзСтроки("{""code"":0}");
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// Разбирает тело application/x-www-form-urlencoded в Соответствие.
// Платформенное свойство "ПараметрыФормы" у HTTPСервисЗапрос отсутствует -
// тело нужно разбирать вручную из строки. Декодирование значений выполняется
// штатной функцией платформы (корректно обрабатывает многобайтовые UTF-8
// последовательности - кириллица, спецсимволы и т.п.).
Функция омг_РазобратьUrlEncodedТело(Знач ТекстТела)
	
	Результат = Новый Соответствие;
	
	Если ПустаяСтрока(ТекстТела) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивПар = СтрРазделить(ТекстТела, "&", Ложь);
	
	Для Каждого Пара Из МассивПар Цикл
		
		ПозицияРавно = Найти(Пара, "=");
		Если ПозицияРавно > 0 Тогда
			Ключ     = омг_РаскодироватьUrlEncodedЗначение(Лев(Пара, ПозицияРавно - 1));
			Значение = омг_РаскодироватьUrlEncodedЗначение(Сред(Пара, ПозицияРавно + 1));
		Иначе
			Ключ     = омг_РаскодироватьUrlEncodedЗначение(Пара);
			Значение = "";
		КонецЕсли;
		
		Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция омг_РаскодироватьUrlEncodedЗначение(Знач Строка)
	
	// x-www-form-urlencoded использует "+" как пробел, обычное декодирование URL - нет,
	// поэтому заменяем "+" вручную до вызова штатного декодера.
	Строка = СтрЗаменить(Строка, "+", " ");
	Возврат РаскодироватьСтроку(Строка, СпособКодированияСтроки.КодировкаURL);
	
КонецФункции
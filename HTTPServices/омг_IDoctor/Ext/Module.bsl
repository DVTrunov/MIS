// =====================================================================================
// HTTP-СЕРВИС: адаптер iDoctor (используется в обеих базах: 83 и 85)
//
// Реализует ТОЛЬКО формат, зафиксированный в официальной документации iDoctor
// (раздел "Webhooks: уведомления о записях"): event, bookingId, bookingCode,
// вложенные doctor/medcenter/patient/appointment. Формат НЕ адаптируется под
// внутренние нужды 1С - парсинг приводит его к внутренней структуре Данные,
// которая передаётся в общее ядро омг_Idoctor.ОбработатьБронирование.
//
// iDoctor по своей документации не поддерживает пакетную запись - присылает
// ровно одну услугу/врача/время на бронь. Внутри адаптера это оборачивается
// в массив "Слоты" из одного элемента перед передачей в ядро - вся логика
// множественных слотов (пакетная запись) сосредоточена в ядре и здесь не
// дублируется, снаружи для iDoctor контракт не меняется.
// =====================================================================================

Функция ПолучениеРасписанияПолучитьДанные(Запрос) Экспорт

	Сообщение = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Сообщение);
	ДанныеЗаписи = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	// Обязательные поля по документации iDoctor.
	Если Не ДанныеЗаписи.Свойство("doctor")
		Или Не ДанныеЗаписи.Свойство("medcenter")
		Или Не ДанныеЗаписи.Свойство("patient")
		Или Не ДанныеЗаписи.Свойство("event")
		Или Не ДанныеЗаписи.Свойство("bookingId") Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	Событие = НРЕГ(ДанныеЗаписи.event); // "booking.created" / "booking.cancelled" / "booking.rebooked"

	// Реквизит Заявка.Омг_bookingId имеет тип Число(15) - приводим значение
	// из JSON явно, чтобы не зависеть от того, пришлёт ли iDoctor его как
	// число или как строку в кавычках.
	BookingIdЧисло = омг_Idoctor.ПривестиBookingIdКЧислу(ДанныеЗаписи.bookingId);
	Если BookingIdЧисло = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	// Для cancelled официальный контракт тоже требует appointment/patient в теле,
	// но фактически для отмены нужен только bookingId - остальные поля игнорируем.
	Если СтрНайти(Событие, "cancelled") > 0 Тогда

		Результат = омг_Idoctor.ОбработатьБронирование(Новый Структура(
			"Источник, Событие, BookingId",
			"idoctor", "cancelled", BookingIdЧисло));

		Возврат СформироватьОтвет(Результат);

	КонецЕсли;

	Если Не ДанныеЗаписи.Свойство("appointment") Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	ЧасНачало    = Сред(ДанныеЗаписи.appointment.startAt, 12, 2);
	МинутаНачало = Сред(ДанныеЗаписи.appointment.startAt, 15, 2);
	ЧасКонец     = Сред(ДанныеЗаписи.appointment.endAt, 12, 2);
	МинутаКонец  = Сред(ДанныеЗаписи.appointment.endAt, 15, 2);

	НаДату = Дата(Лев(СтрЗаменить(ДанныеЗаписи.appointment.startAt, "-", ""), 8));

	ВремяНачала    = Дата(1, 1, 1, ЧасНачало, МинутаНачало, 0);
	ВремяОкончания = Дата(1, 1, 1, ЧасКонец, МинутаКонец, 0);

	// Проверка занятости одинакова для created и rebooked, исключает саму
	// заявку (по составному ключу Источник+BookingId) - перенос заявки на
	// смежное время не блокирует сам себя.
	РазрешитьСоздание = омг_Idoctor.ПроверитьРасписаниеНаСервере(
		ДанныеЗаписи.doctor.id, ДанныеЗаписи.medcenter.id,
		ВремяНачала, ВремяОкончания, НаДату,
		"idoctor", BookingIdЧисло);

	Если Не РазрешитьСоздание Тогда
		Возврат Новый HTTPСервисОтвет(409);
	КонецЕсли;

	ДатаРождения = Неопределено;
	Пол = 0;
	// Официальный контракт не описывает birthAt/gender у patient, но мы их
	// принимаем, если iDoctor их всё же пришлёт (необязательное расширение).
	Если ДанныеЗаписи.patient.Свойство("birthAt") И ЗначениеЗаполнено(ДанныеЗаписи.patient.birthAt) Тогда
		ДатаРождения = Дата(Лев(СтрЗаменить(ДанныеЗаписи.patient.birthAt, "-", ""), 8));
	КонецЕсли;
	Если ДанныеЗаписи.patient.Свойство("gender") Тогда
		Пол = ДанныеЗаписи.patient.gender;
	КонецЕсли;

	Комментарий = "";
	Если ДанныеЗаписи.Свойство("comment") И ЗначениеЗаполнено(ДанныеЗаписи.comment) Тогда
		Комментарий = ДанныеЗаписи.comment;
	КонецЕсли;

	ServiceId = "";
	Если ДанныеЗаписи.Свойство("service") И ДанныеЗаписи.service.Свойство("id") Тогда
		ServiceId = ДанныеЗаписи.service.id;
	КонецЕсли;

	// iDoctor всегда присылает ровно один слот - оборачиваем в массив из
	// одного элемента для передачи в общее ядро.
	Слот = Новый Структура;
	Слот.Вставить("DoctorId", ДанныеЗаписи.doctor.id);
	Слот.Вставить("ServiceId", ServiceId);
	Слот.Вставить("ВремяНачала", ВремяНачала);
	Слот.Вставить("ВремяОкончания", ВремяОкончания);
	Слот.Вставить("Дата", НаДату);

	Слоты = Новый Массив;
	Слоты.Добавить(Слот);

	Данные = Новый Структура;
	Данные.Вставить("Источник", "idoctor");
	Данные.Вставить("Событие", ?(СтрНайти(Событие, "rebooked") > 0, "rebooked", "created"));
	Данные.Вставить("BookingId", BookingIdЧисло);
	Данные.Вставить("MedcenterId", ДанныеЗаписи.medcenter.id);
	Данные.Вставить("Иин", ДанныеЗаписи.patient.iin);
	Данные.Вставить("Телефон", ДанныеЗаписи.patient.phone);
	Данные.Вставить("ФИО", ДанныеЗаписи.patient.fullName);
	Данные.Вставить("ДатаРождения", ДатаРождения);
	Данные.Вставить("Пол", Пол);
	Данные.Вставить("Комментарий", Комментарий);
	Данные.Вставить("Слоты", Слоты);

	Результат = омг_Idoctor.ОбработатьБронирование(Данные);

	Возврат СформироватьОтвет(Результат);

КонецФункции

Функция СформироватьОтвет(Результат)

	Если Результат = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(422);
	КонецЕсли;

	// Формат ответа - по официальной документации iDoctor: {"message": null, "code": 0}
	Данные = Новый Структура;
	Данные.Вставить("message", Неопределено);
	Данные.Вставить("code", 0);

	Возврат омг_Idoctor.ОтветJSON(200, Данные);

КонецФункции

// -------------------------------------------------------------------------------
// GET-методы для iDoctor - по официальной документации.
//
// ВАЖНО: в рамках одного шаблона URL 1С не допускает два метода с
// одинаковым HTTP-глаголом (маршрутизация внутри шаблона идёт по
// глаголу). Поэтому GETDOCTORS и GETSCHEDULE обслуживаются ОДНИМ
// GET-методом конфигурации (обработчик ПолучениеРасписанияGetSchedule),
// который сам определяет нужную операцию по параметру "metod" в URL -
// по тому же принципу, что уже применяется в адаптере "наш формат".
// -------------------------------------------------------------------------------

// GET /mis-api/v2/medcenters/{medcenterId}/doctors
//     /mis-api/v2/medcenters/{medcenterId}/doctors/{doctorId}/schedule
Функция ПолучениеРасписанияGetSchedule(Запрос) Экспорт

	Метод = Запрос.Параметрыurl.Получить("metod");
	Метод = НРЕГ(Метод);

	Если Метод = НРЕГ("GETDOCTORS") Тогда

		Врачи = омг_Idoctor.ПолучитьАктивныхВрачей("idoctor");

		Данные = Новый Структура;
		Данные.Вставить("message", Неопределено);
		Данные.Вставить("code", 0);
		Данные.Вставить("data", Новый Структура("doctors", Врачи));

		Возврат омг_Idoctor.ОтветJSON(200, Данные);

	КонецЕсли;

	Сообщение = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Сообщение);
	ДанныеЗаписи = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Если Не ДанныеЗаписи.Свойство("medcenterid") Или Не ЗначениеЗаполнено(ДанныеЗаписи.medcenterid) Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	Филиал = омг_Idoctor.ПолучитьФилиалПоID(ДанныеЗаписи.medcenterid);
	Если Филиал = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	Если ДанныеЗаписи.Свойство("doctorsid") И ДанныеЗаписи.doctorsid.Количество() > 0 Тогда
		МассИД = Новый Массив;
		Для Каждого СтрокаДокторID Из ДанныеЗаписи.doctorsid Цикл
			МассИД.Добавить(СтрокаДокторID.doctorid);
		КонецЦикла;
		МасСотрудников = омг_Idoctor.ПолучитьСотрудниковПоID(МассИД);
		МассивВозврата = омг_Idoctor.ПолучитьРасписание(, Филиал, , МасСотрудников,
			Дата(СтрЗаменить(ДанныеЗаписи.startAt, "-", "")), Дата(СтрЗаменить(ДанныеЗаписи.endAt, "-", "")));
	Иначе
		МассивВозврата = омг_Idoctor.ПолучитьРасписание(, Филиал, , ,
			Дата(СтрЗаменить(ДанныеЗаписи.startAt, "-", "")), Дата(СтрЗаменить(ДанныеЗаписи.endAt, "-", "")));
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("message", Неопределено);
	Данные.Вставить("code", 0);
	Данные.Вставить("data", МассивВозврата);

	Возврат омг_Idoctor.ОтветJSON(200, Данные);

КонецФункции


Функция ПолучениеРасписанияНашФорматПолучитьДанные(Запрос) Экспорт

	Источник = омг_Idoctor.ОпределитьИсточникПоКлючу(Запрос.Заголовки.Получить("X-Partner-Key"));

	Если Источник = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(401); // неверный или отсутствующий ключ партнёра
	КонецЕсли;

	Сообщение = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Сообщение);
	ДанныеЗаписи = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Метод = Запрос.Параметрыurl.Получить("metod");
	Метод = СтрЗаменить(НРЕГ(Метод), " ", "");

	Если Метод <> НРЕГ("created") И Метод <> НРЕГ("rebooked") И Метод <> НРЕГ("cancelled") Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	Если Не ДанныеЗаписи.Свойство("bookingId") Или Не ЗначениеЗаполнено(ДанныеЗаписи.bookingId) Тогда
		Возврат Новый HTTPСервисОтвет(400); // bookingId обязателен - ключ идемпотентности
	КонецЕсли;

	// Реквизит Заявка.Омг_bookingId имеет тип Число(15) - приводим значение
	// из JSON явно (партнёр может прислать его как число или как строку
	// в кавычках - протокол требует число без кавычек, код дополнительно
	// защищается от обоих вариантов).
	BookingId = омг_Idoctor.ПривестиBookingIdКЧислу(ДанныеЗаписи.bookingId);
	Если BookingId = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	Если Метод = НРЕГ("cancelled") Тогда

		Результат = омг_Idoctor.ОбработатьБронирование(Новый Структура(
			"Источник, Событие, BookingId",
			Источник, "cancelled", BookingId));

		Возврат СформироватьОтветНашФормат(BookingId, "отменено", Результат);

	КонецЕсли;

	Если Не ДанныеЗаписи.Свойство("medcenterId") Или Не ДанныеЗаписи.Свойство("slots") Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	ИсходныйМассивСлотов = ДанныеЗаписи.slots;

	Если ИсходныйМассивСлотов.Количество() = 0 Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;

	// Правило обязательности serviceId при количестве слотов от двух -
	// проверяется на уровне адаптера для точного кода 400 до вызова ядра;
	// дублирующая проверка есть и в ядре как защитный уровень.
	Если ИсходныйМассивСлотов.Количество() >= 2 Тогда
		Для Каждого ИсхСлот Из ИсходныйМассивСлотов Цикл
			Если Не ИсхСлот.Свойство("serviceId") Или Не ЗначениеЗаполнено(ИсхСлот.serviceId) Тогда
				Возврат Новый HTTPСервисОтвет(400);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Разбор каждого слота: время обязательно для каждого элемента массива,
	// doctorId - обязателен, serviceId - согласно правилу выше.
	МассивСлотовДляЯдра = Новый Массив;

	Для Каждого ИсхСлот Из ИсходныйМассивСлотов Цикл

		Если Не ИсхСлот.Свойство("doctorId")
			Или Не ИсхСлот.Свойство("startAt") Или Не ЗначениеЗаполнено(ИсхСлот.startAt)
			Или Не ИсхСлот.Свойство("endAt") Или Не ЗначениеЗаполнено(ИсхСлот.endAt) Тогда
			Возврат Новый HTTPСервисОтвет(400);
		КонецЕсли;

		ЧасНачало    = Сред(ИсхСлот.startAt, 12, 2);
		МинутаНачало = Сред(ИсхСлот.startAt, 15, 2);
		ЧасКонец     = Сред(ИсхСлот.endAt, 12, 2);
		МинутаКонец  = Сред(ИсхСлот.endAt, 15, 2);
		ДатаСлота    = Дата(Лев(СтрЗаменить(ИсхСлот.startAt, "-", ""), 8));

		СлотДляЯдра = Новый Структура;
		СлотДляЯдра.Вставить("DoctorId", ИсхСлот.doctorId);
		СлотДляЯдра.Вставить("ServiceId", ?(ИсхСлот.Свойство("serviceId"), ИсхСлот.serviceId, ""));
		СлотДляЯдра.Вставить("ВремяНачала", Дата(1, 1, 1, ЧасНачало, МинутаНачало, 0));
		СлотДляЯдра.Вставить("ВремяОкончания", Дата(1, 1, 1, ЧасКонец, МинутаКонец, 0));
		СлотДляЯдра.Вставить("Дата", ДатаСлота);
		СлотДляЯдра.Вставить("SlotId", ?(ИсхСлот.Свойство("slotId"), ИсхСлот.slotId, ""));

		МассивСлотовДляЯдра.Добавить(СлотДляЯдра);

	КонецЦикла;

	// Проверка занятости каждого слота ПЕРЕД обращением к ядру - правило
	// "всё или ничего": при занятости хотя бы одного слота запрос
	// отклоняется целиком, ядро не вызывается вообще.
	Для Каждого Слот Из МассивСлотовДляЯдра Цикл
		РазрешитьСоздание = омг_Idoctor.ПроверитьРасписаниеНаСервере(
			Слот.DoctorId, ДанныеЗаписи.medcenterId,
			Слот.ВремяНачала, Слот.ВремяОкончания, Слот.Дата,
			Источник, BookingId);
		Если Не РазрешитьСоздание Тогда
			Возврат Новый HTTPСервисОтвет(409);
		КонецЕсли;
	КонецЦикла;

	ДатаРождения = Неопределено;
	Если ДанныеЗаписи.Свойство("patient") И ДанныеЗаписи.patient.Свойство("birthAt")
		И ЗначениеЗаполнено(ДанныеЗаписи.patient.birthAt) Тогда
		ДатаРождения = Дата(Лев(СтрЗаменить(ДанныеЗаписи.patient.birthAt, "-", ""), 8));
	КонецЕсли;

	Пол = 0;
	Если ДанныеЗаписи.Свойство("patient") И ДанныеЗаписи.patient.Свойство("gender") Тогда
		Пол = ДанныеЗаписи.patient.gender;
	КонецЕсли;

	ИИН = "";
	Тел = "";
	ФИО = "";
	Если ДанныеЗаписи.Свойство("patient") Тогда
		ИИН = ?(ДанныеЗаписи.patient.Свойство("iin"), ДанныеЗаписи.patient.iin, "");
		Тел = ?(ДанныеЗаписи.patient.Свойство("phone"), ДанныеЗаписи.patient.phone, "");
		ФИО = ?(ДанныеЗаписи.patient.Свойство("fullName"), ДанныеЗаписи.patient.fullName, "");
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Источник", Источник);
	Данные.Вставить("Событие", Метод);
	Данные.Вставить("BookingId", BookingId);
	Данные.Вставить("MedcenterId", ДанныеЗаписи.medcenterId);
	Данные.Вставить("Иин", ИИН);
	Данные.Вставить("Телефон", Тел);
	Данные.Вставить("ФИО", ФИО);
	Данные.Вставить("ДатаРождения", ДатаРождения);
	Данные.Вставить("Пол", Пол);
	Данные.Вставить("Комментарий", ?(ДанныеЗаписи.Свойство("comment"), ДанныеЗаписи.comment, ""));
	Данные.Вставить("Слоты", МассивСлотовДляЯдра);

	Результат = омг_Idoctor.ОбработатьБронирование(Данные);

	Возврат СформироватьОтветНашФормат(BookingId, "создано/изменено", Результат);

КонецФункции

Функция СформироватьОтветНашФормат(BookingId, Статус, Результат)

	Если Результат = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(422);
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("bookingId", BookingId);
	Данные.Вставить("статус", "Успешно " + Статус);
	Данные.Вставить("дата", ТекущаяДата());
	Данные.Вставить("slots", Результат.Слоты);

	Возврат омг_Idoctor.ОтветJSON(200, Данные);

КонецФункции

// -------------------------------------------------------------------------------
// GET-методы по нашему формату - общие для Жасыл и всех будущих партнёров.
// Партнёр также определяется по X-Partner-Key.
// -------------------------------------------------------------------------------

Функция ПолучениеРасписанияНашФорматGetSchedule(Запрос) Экспорт

	Источник = омг_Idoctor.ОпределитьИсточникПоКлючу(Запрос.Заголовки.Получить("X-Partner-Key"));
	Если Источник = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(401);
	КонецЕсли;

	Сообщение = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Сообщение);
	ДанныеЗаписи = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Метод = Запрос.Параметрыurl.Получить("metod");
	Метод = НРЕГ(Метод);

	Если Метод = НРЕГ("GETDOCTORS") Тогда
		Возврат омг_Idoctor.ОтветJSON(200, омг_Idoctor.ПолучитьАктивныхВрачей(Источник));
	КонецЕсли;

	Если Метод = НРЕГ("GETSERVICES") Тогда
		Если Не ДанныеЗаписи.Свойство("medcenterid") Или Не ЗначениеЗаполнено(ДанныеЗаписи.medcenterid) Тогда
			Возврат Новый HTTPСервисОтвет(400);
		КонецЕсли;
		Возврат омг_Idoctor.ОтветJSON(200, омг_Idoctor.ПолучитьУслуги(ДанныеЗаписи.medcenterid));
	КонецЕсли;

	Если Метод = НРЕГ("GETAPPOINTMENTS") Тогда
		ДатаНачала = Неопределено;
		ДатаОкончания = Неопределено;
		Если ДанныеЗаписи.Свойство("dateFrom") И ЗначениеЗаполнено(ДанныеЗаписи.dateFrom) Тогда
			ДатаНачала = НачалоДня(Дата(СтрЗаменить(ДанныеЗаписи.dateFrom, "-", "")));
		КонецЕсли;
		Если ДанныеЗаписи.Свойство("dateTo") И ЗначениеЗаполнено(ДанныеЗаписи.dateTo) Тогда
			ДатаОкончания = КонецДня(Дата(СтрЗаменить(ДанныеЗаписи.dateTo, "-", "")));
		КонецЕсли;
		Телефон = ?(ДанныеЗаписи.Свойство("phone"), ДанныеЗаписи.phone, "");
		BookingId = ?(ДанныеЗаписи.Свойство("bookingId"), ДанныеЗаписи.bookingId, "");

		Если ДатаНачала = Неопределено И ПустаяСтрока(Телефон) И Не ЗначениеЗаполнено(BookingId) Тогда
			Возврат Новый HTTPСервисОтвет(400);
		КонецЕсли;

		// Источник партнёра, сделавшего запрос, НЕ передаётся фильтром в
		// ПолучитьЗаявки - партнёр должен видеть ВСЕ заявки (в т.ч. записанные
		// регистратурой вручную и через любого другого партнёра), а не только
		// заявки, созданные им самим.
		Возврат омг_Idoctor.ОтветJSON(200, омг_Idoctor.ПолучитьЗаявки(ДатаНачала, ДатаОкончания, Телефон, BookingId));
	КонецЕсли;

	Если Метод = НРЕГ("GETSCHEDULE") Тогда

		Если Не ДанныеЗаписи.Свойство("medcenterid") Или Не ЗначениеЗаполнено(ДанныеЗаписи.medcenterid) Тогда
			Возврат Новый HTTPСервисОтвет(400);
		КонецЕсли;

		Филиал = омг_Idoctor.ПолучитьФилиалПоID(ДанныеЗаписи.medcenterid);
		Если Филиал = Неопределено Тогда
			Возврат Новый HTTPСервисОтвет(400);
		КонецЕсли;

		Если ДанныеЗаписи.Свойство("doctorsid") И ДанныеЗаписи.doctorsid.Количество() > 0 Тогда
			МассИД = Новый Массив;
			Для Каждого СтрокаДокторID Из ДанныеЗаписи.doctorsid Цикл
				МассИД.Добавить(СтрокаДокторID.doctorid);
			КонецЦикла;
			МасСотрудников = омг_Idoctor.ПолучитьСотрудниковПоID(МассИД);
			МассивВозврата = омг_Idoctor.ПолучитьРасписание(, Филиал, , МасСотрудников,
				Дата(СтрЗаменить(ДанныеЗаписи.startAt, "-", "")), Дата(СтрЗаменить(ДанныеЗаписи.endAt, "-", "")));
		Иначе
			МассивВозврата = омг_Idoctor.ПолучитьРасписание(, Филиал, , ,
				Дата(СтрЗаменить(ДанныеЗаписи.startAt, "-", "")), Дата(СтрЗаменить(ДанныеЗаписи.endAt, "-", "")));
		КонецЕсли;

		Возврат омг_Idoctor.ОтветJSON(200, МассивВозврата);

	КонецЕсли;

	Возврат Новый HTTPСервисОтвет(400);

КонецФункции

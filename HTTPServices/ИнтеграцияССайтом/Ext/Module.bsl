#Область СлужебныеПроцедурыИФункции

// аналог 3 веб-сервисов:
// - GetSchedule - Обычное получение расписания на конкретные даты
// - GetSchedule20 - получение расписания с параметрами  
// - GetEnlargementSchedule - Получить укрупненое расписание  
// Ожидаемые параметры запроса:
//	ИмяПеременной	- Полученное значение параметра	- Описание
//	StartDate	- Дата	- дата Начала
// 	FinishDate	- Дата	- дата Окончания 
// 	Key			- УИД	- Ключ достоверности
// 	Clinic		- Массив ссылок Филиала		- ожидается как Строка-перечисления УИД Филиалов Строкой
// 	Employees	- Массив ссылок Сотрудников	- ожидается как Строка-перечисления УИД Сотрудников Строкой
// 	Format		- Строка	- Формат возвращаемого Файла (по умолчанию JSON)
//	Method	- Строка	- Какой вид из 3 вариантов веб-сервиса интересует (GetSchedule, GetSchedule20, GetEnlargementSchedule)
//		Если не заполнен/нет ни одного из проверяемых вариантов, то это будет GetSchedule20
Функция SchedulePost(Запрос)	

	Ответ = Неопределено;
	ПараметрыЗапроса = Новый Структура();
	ОтносительныйURL = "/schedule";
	УстановитьПривилегированныйРежим(Истина);

	// Проверим запрос, при ошибках вернём 400 bad request и в тело поместим описание ошибки		
	HTTPСервисыВызовСервера.ПроверитьИЗаполнитьОжидаемыеПараметрыЗапроса(Запрос, ОтносительныйURL, ПараметрыЗапроса, Ответ);
	Если Ответ <> Неопределено Тогда Возврат Ответ КонецЕсли;
	
	// В зависимости от вида предоставляем расписание
	ОписаниеОшибки = ""; 
	ОписаниеОшибкиParams = ""; 
	
	// Получим XML представление календаря
	Если ПараметрыЗапроса.Method = "GetEnlargementSchedule" Тогда
		СообщениеXML = ВебИнтеграция.ПолучитьУкрупненыеГрафикиРаботыXML(ПараметрыЗапроса.StartDate, ПараметрыЗапроса.FinishDate, ОписаниеОшибки, ПараметрыЗапроса);
	ИначеЕсли ПараметрыЗапроса.Method = "GetSchedule" Тогда
		СообщениеXML = ВебИнтеграция.ПолучитьГрафикиРаботыXML(ПараметрыЗапроса.StartDate, ПараметрыЗапроса.FinishDate, ОписаниеОшибки, Истина, ПараметрыЗапроса);
	Иначе	
		// Все остальные варианты трактуются как GetSchedule20
		Если ПараметрыЗапроса.Clinic <> Неопределено Тогда	
			ПараметрыЗапроса.Вставить("Филиал",ПараметрыЗапроса.Clinic);	
		КонецЕсли;
		Если ПараметрыЗапроса.Employees <> Неопределено Тогда	
			ПараметрыЗапроса.Вставить("Сотрудники",ПараметрыЗапроса.Employees);	
		КонецЕсли;
		СообщениеXML = ВебИнтеграция.ПолучитьГрафикиРаботыXML(ПараметрыЗапроса.StartDate, ПараметрыЗапроса.FinishDate, ОписаниеОшибки, Истина, ПараметрыЗапроса, ОписаниеОшибкиParams);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.КонкатенацияСтрок(ОписаниеОшибки,ОписаниеОшибкиParams,Символы.ПС);
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		Возврат ВернутьОтветСОшибкой(ОписаниеОшибки, 500);	
	КонецЕсли;
	
	// Преобразуем XML под указанный формат или JSON
	Возврат ВернутьУспешныйОтветИзXML(СообщениеXML, ПараметрыЗапроса.Format);

КонецФункции


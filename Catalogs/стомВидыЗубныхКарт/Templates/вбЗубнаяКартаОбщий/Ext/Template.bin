	</Свойство><Свойство Имя="Родитель" Тип="СправочникСсылка.ВычисляемыеЗначенияПараметров">
	<Пусто/>
</Свойство><ТабличнаяЧасть Имя="СвязанныеРеквизиты"/><ТабличнаяЧасть Имя="СписокПеременных"/>

<Объект Нпп="5" Тип="СправочникСсылка.ВычисляемыеЗначенияПараметров" ИмяПравила="ВычисляемыеЗначенияПараметров"><Ссылка Нпп="5">
	<Свойство Имя="{УникальныйИдентификатор}" Тип="Строка">
		<Значение>6867f219-2a7a-11e7-ba36-40f02fefcad1</Значение>
	</Свойство>
	<Свойство Имя="Наименование" Тип="Строка">
		<Значение>Блок HTML: Параметры зубной формулы:Аномалии зубов</Значение>
	</Свойство>
	<Свойство Имя="ЭтоГруппа" Тип="Булево">
		<Значение>false</Значение>
	</Свойство>
</Ссылка>
	<Свойство Имя="АлгоритмВычисления" Тип="Строка">
		<Значение>// Функция - Сформировать параметры зубной формулы таблицей HTML
//
// Параметры:
//  Клиент					 - СправочникСсылка.Клиенты - Клиент приема
//  ЗубнаяКарта				 - СправочникСсылка.стомВидыЗубныхКарт - Зубная карта клиента
//  Прием					 - ДокументСсылка.Прием - Ссылка на прием
//  ОтборПоГруппеПараметров	 - ПланВидовХарактеристикСсылка.стомПараметрыЗубнойФормулы или Массив ссылок - Если указан, будут выведены значения параметров только по указанной группе
//  Оформление				 - Структура - Если не заполнено, будет использоваться оформление по умолчанию, возможные элементы структуры:
//							 			 - АтрибутыЗаголовкаТаблицы
//										 - АтрибутыЯчеекОбозначения
//										 - АтрибутыЯчеекГруппПараметров
//										 - АтрибутыЯчеекПараметров
//										 - АтрибутыТекстаРасшифровки
//										 - АтрибутыКолонкиПараметров
//										 Элементы структуры должы содержать вложенную структуру со списком атрибутов (width, style и т.д.) тегов HTML, задающих оформление
// 
// Возвращаемое значение:
// Строка - HTML-текст для вставки
//
Док = ДокументОбъект;
Результат = стомПараметрыЗубов.СформироватьПараметрыЗубнойФормулыТаблицейHTML(Док.Клиент, Док.ЗубнаяКарта, Док, ПланыВидовХарактеристик.стомПараметрыЗубнойФормулы.АномалииЗубов);</Значение>
	</Свойство><Свойство Имя="ПолучательВычисляемогоЗначения" Тип="ПеречислениеСсылка.ПолучателиВычисляемогоЗначения">
	<Значение>ВычисляемыйБлок</Значение>
</Свойство>

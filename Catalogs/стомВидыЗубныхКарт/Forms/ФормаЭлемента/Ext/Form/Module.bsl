&НаСервере
Процедура ЗаполнитьСписокВариантовИЗубов(ЗначениеКопирования = Неопределено)
	
	СписокЗубов.Очистить();
	ДеревоВариантыКарты = СписокВариантов.ПолучитьЭлементы();
	ДеревоВариантыКарты.Очистить();
	
	Если ЗначениеКопирования = Неопределено Тогда
		ТекОбъект = Объект.Ссылка;
	Иначе
		ТекОбъект = ЗначениеКопирования;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомЗубыКарты.Ссылка КАК ЗубВКарте,
	|	стомЗубыКарты.Зуб,
	|	стомЗубыКарты.TranslateX,
	|	стомЗубыКарты.TranslateY,
	|	стомЗубыКарты.Rotation,
	|	стомЗубыКарты.ScaleX,
	|	стомЗубыКарты.ScaleY,
	|	стомЗубыКарты.ZIndex,
	|	стомЗубыКарты.Наименование
	|ПОМЕСТИТЬ ЗубыКарты
	|ИЗ
	|	Справочник.стомЗубыКарты КАК стомЗубыКарты
	|ГДЕ
	|	стомЗубыКарты.Владелец = &ТекОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗубыКарты.ЗубВКарте,
	|	ЗубыКарты.Зуб,
	|	ЗубыКарты.TranslateX,
	|	ЗубыКарты.TranslateY,
	|	ЗубыКарты.Rotation,
	|	ЗубыКарты.ScaleX,
	|	ЗубыКарты.ScaleY,
	|	ЗубыКарты.ZIndex,
	|	ЗубыКарты.Наименование
	|ИЗ
	|	ЗубыКарты КАК ЗубыКарты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стомВариантыЗубныхКартСписокВариантовЗубов.Ссылка КАК ВариантКарты,
	|	ЗубыКарты.ЗубВКарте,
	|	стомВариантыЗубныхКартСписокВариантовЗубов.ВариантЗуба,
	|	стомВариантыЗубовСписокОбластей.Область
	|ПОМЕСТИТЬ ДеревоВариантов
	|ИЗ
	|	Справочник.стомВариантыЗубныхКарт.СписокВариантовЗубов КАК стомВариантыЗубныхКартСписокВариантовЗубов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.стомВариантыЗубов.СписокОбластей КАК стомВариантыЗубовСписокОбластей
	|		ПО стомВариантыЗубныхКартСписокВариантовЗубов.ВариантЗуба = стомВариантыЗубовСписокОбластей.Ссылка,
	|	ЗубыКарты КАК ЗубыКарты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДеревоВариантов.ВариантКарты КАК ВариантКарты,
	|	ДеревоВариантов.ЗубВКарте КАК ЗубВКарте,
	|	ДеревоВариантов.ВариантЗуба КАК ВариантЗуба,
	|	ДеревоВариантов.Область,
	|	ВЫБОР
	|		КОГДА стомВидыЗубныхКартНастройкаВариантовОбластей.Область ЕСТЬ NULL 
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Установлен
	|ИЗ
	|	ДеревоВариантов КАК ДеревоВариантов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.стомВидыЗубныхКарт.НастройкаВариантовОбластей КАК стомВидыЗубныхКартНастройкаВариантовОбластей
	|		ПО ДеревоВариантов.ВариантКарты = стомВидыЗубныхКартНастройкаВариантовОбластей.ВариантКарты
	|			И ДеревоВариантов.ЗубВКарте = стомВидыЗубныхКартНастройкаВариантовОбластей.ЗубВКарте
	|			И ДеревоВариантов.ВариантЗуба = стомВидыЗубныхКартНастройкаВариантовОбластей.ВариантЗуба
	|			И ДеревоВариантов.Область = стомВидыЗубныхКартНастройкаВариантовОбластей.Область
	|			И (стомВидыЗубныхКартНастройкаВариантовОбластей.Ссылка = &ТекОбъект)
	|ИТОГИ
	|	СУММА(Установлен)
	|ПО
	|	ВариантКарты,
	|	ЗубВКарте,
	|	ВариантЗуба";
	Запрос.УстановитьПараметр("ТекОбъект", ТекОбъект);
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаСписокЗубов = Результат[1].Выбрать();
	Пока ВыборкаСписокЗубов.Следующий() Цикл
		
		НоваяСтрока = СписокЗубов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСписокЗубов);
		НоваяСтрока.ИдентификаторSL = Строка(ВыборкаСписокЗубов.ЗубВКарте.УникальныйИдентификатор());
		НоваяСтрока.ЗубВКарте = ?(ЗначениеКопирования = Неопределено, ВыборкаСписокЗубов.ЗубВКарте, Неопределено);
		НоваяСтрока.Изменен = (ЗначениеКопирования = Неопределено);	
		
	КонецЦикла;
	
	ВыборкаВарианты = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВарианты.Следующий() Цикл
		ВыборкаЗубы = ВыборкаВарианты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ВетвьВариантКарты = ДеревоВариантыКарты.Добавить();
		ВетвьВариантКарты.ВариантОбласть = ВыборкаВарианты.ВариантКарты;
		ВетвьВариантКарты.Установлен = 1;
		ВетвьВариантКарты.УстановленоДетей = ВыборкаВарианты.Установлен;
		ВетвьВариантКарты.Уровень = 0;
		
		ДеревоЗубы = ВетвьВариантКарты.ПолучитьЭлементы();
		Пока ВыборкаЗубы.Следующий() Цикл
			ВыборкаВариантыЗуба = ВыборкаЗубы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			ВетвьЗуб = ДеревоЗубы.Добавить();
			ВетвьЗуб.ВариантОбласть = ВыборкаЗубы.ЗубВКарте;
			ВетвьЗуб.Установлен = 1;
			ВетвьЗуб.УстановленоДетей = ВыборкаЗубы.Установлен;
			ВетвьЗуб.Уровень = 1;
			
			ДеревоВариантыЗуба = ВетвьЗуб.ПолучитьЭлементы();
			Пока ВыборкаВариантыЗуба.Следующий() Цикл
				ВыборкаОбласти = ВыборкаВариантыЗуба.Выбрать();
				
				ВетвьВариантЗуба = ДеревоВариантыЗуба.Добавить();
				ВетвьВариантЗуба.ВариантОбласть = ВыборкаВариантыЗуба.ВариантЗуба;
				Если ВыборкаВариантыЗуба.Установлен = ВыборкаОбласти.Количество() Тогда
					ВетвьВариантЗуба.Установлен = 1;
				ИначеЕсли ВыборкаВариантыЗуба.Установлен = 0 Тогда
					ВетвьВариантЗуба.Установлен = 0;
				Иначе
					ВетвьВариантЗуба.Установлен = 2;
				КонецЕсли;
				ВетвьВариантЗуба.УстановленоДетей = ВыборкаВариантыЗуба.Установлен;
				ВетвьВариантЗуба.Уровень = 2;
				
				ДеревоОбласти = ВетвьВариантЗуба.ПолучитьЭлементы();
				Пока ВыборкаОбласти.Следующий() Цикл
					ВетвьОбласть = ДеревоОбласти.Добавить();
					ВетвьОбласть.ВариантОбласть = ВыборкаОбласти.Область;
					ВетвьОбласть.Установлен = ВыборкаОбласти.Установлен;
					ВетвьОбласть.УстановленоДетей = ВыборкаОбласти.Установлен;
					ВетвьОбласть.Уровень = 3;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСегментов(ЗначениеКопирования = Неопределено)
	
	Если ЗначениеКопирования = Неопределено Тогда
		ТекОбъект = Объект.Ссылка;
	Иначе
		ТекОбъект = ЗначениеКопирования;
	КонецЕсли;
	
	СписокСегментов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	стомСегментыЗубов.Ссылка КАК СегментВЗубе,
	|	стомСегментыЗубов.TranslateX,
	|	стомСегментыЗубов.TranslateY,
	|	стомСегментыЗубов.ScaleX,
	|	стомСегментыЗубов.ScaleY,
	|	стомСегментыЗубов.Rotation,
	|	стомСегментыЗубов.ZIndex КАК ZIndex,
	|	стомСегментыЗубов.Наименование,
	|	стомСегментыЗубов.Сегмент,
	|	стомСегментыЗубов.Сегмент.Область КАК Область
	|ИЗ
	|	Справочник.стомСегментыЗубов КАК стомСегментыЗубов
	|ГДЕ
	|	стомСегментыЗубов.Владелец = &ТекОбъект
	| 	И НЕ стомСегментыЗубов.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ZIndex";
	Запрос.УстановитьПараметр("ТекОбъект", ТекОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = СписокСегментов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторSL = Строка(Выборка.СегментВЗубе.УникальныйИдентификатор());
		НоваяСтрока.СегментВЗубе = ?(ЗначениеКопирования = Неопределено, Выборка.СегментВЗубе, Неопределено);
		НоваяСтрока.Изменен = (ЗначениеКопирования = Неопределено);
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВариантовПриАктивизацииСтроки(Элемент)
	ТекДанные = Элемент.ТекущиеДанные; 
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Если активизировали тот же вариант - перерисовывать зуб не нужно
	Вариант = ОбщегоНазначенияКлиентСерверПереопределяемый.ПолучитьКореньВетвиДерева(ТекДанные);
	Если Вариант = ТекВариантКарты Тогда
		Возврат;
	Иначе
		ТекВариантКарты = Вариант;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СформироватьЗубыСегментыКарты();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьВариантыКарты()
	
	Объект.НастройкаВариантовОбластей.Очистить();
	ДеревоВариантыКарты = СписокВариантов.ПолучитьЭлементы();
	Для Каждого ВетвьВариантКарты Из ДеревоВариантыКарты Цикл
		ДеревоЗубы = ВетвьВариантКарты.ПолучитьЭлементы();
		Для Каждого ВетвьЗуб Из ДеревоЗубы Цикл
			ДеревоВариантыЗуба = ВетвьЗуб.ПолучитьЭлементы();
			Для Каждого ВетвьВариантЗуба Из ДеревоВариантыЗуба Цикл
				ДеревоОбласти = ВетвьВариантЗуба.ПолучитьЭлементы();
				Для Каждого ВетвьОбласть Из ДеревоОбласти Цикл
					Если ВетвьОбласть.Установлен Тогда
						
						НоваяНастройка = Объект.НастройкаВариантовОбластей.Добавить();
						НоваяНастройка.ВариантКарты = ВетвьВариантКарты.ВариантОбласть;
						НоваяНастройка.ЗубВКарте = ВетвьЗуб.ВариантОбласть;
						НоваяНастройка.ВариантЗуба = ВетвьВариантЗуба.ВариантОбласть;
						НоваяНастройка.Область = ВетвьОбласть.ВариантОбласть;
						
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗубыСегментыКарты()
	
	мсЗубыВКарте = Новый Массив;
	
	Для Каждого СтрокаЗуб Из СписокЗубов Цикл
				
		Если ЗначениеЗаполнено(СтрокаЗуб.ЗубВКарте) Тогда //зуб уже существует и заполнен
			Если СтрокаЗуб.Изменен Тогда
				ЗубОбъект = СтрокаЗуб.ЗубВКарте.ПолучитьОбъект();
				ЗаполнитьЗначенияСвойств(ЗубОбъект, СтрокаЗуб);
				ЗубОбъект.Записать();
				ЗубВКарте = ЗубОбъект.Ссылка;
			Иначе
				ЗубВКарте = СтрокаЗуб.ЗубВКарте;
			КонецЕсли;
		Иначе //нужно создать новый
			НовыйЗуб = Справочники.стомЗубыКарты.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НовыйЗуб, СтрокаЗуб);
			НовыйЗуб.Владелец = Объект.Ссылка;	
			НовыйЗуб.Записать();
			ЗубВКарте = НовыйЗуб.Ссылка;
			СтрокаЗуб.ЗубВКарте = ЗубВКарте;
		КонецЕсли;
		СтрокаЗуб.Изменен = Ложь;
		мсЗубыВКарте.Добавить(ЗубВКарте);
		
	КонецЦикла;
	
	мсСегментыВЗубе = Новый Массив;
	
	Для Каждого СтрокаСегмент Из СписокСегментов Цикл
				
		Если ЗначениеЗаполнено(СтрокаСегмент.СегментВЗубе) Тогда //сегмент уже существует и заполнен
			СегментОбъект = СтрокаСегмент.СегментВЗубе.ПолучитьОбъект();
				ЗаполнитьЗначенияСвойств(СегментОбъект, СтрокаСегмент);
				СегментОбъект.Записать();
				СегментВЗубе = СегментОбъект.Ссылка;
		Иначе //нужно создать новый
			НовыйСегмент = Справочники.стомСегментыЗубов.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НовыйСегмент, СтрокаСегмент);
			НовыйСегмент.Владелец = Объект.Ссылка;	
			НовыйСегмент.Записать();
			СегментВЗубе = НовыйСегмент.Ссылка;
			СтрокаСегмент.СегментВЗубе = СегментВЗубе;
		КонецЕсли;
		СтрокаСегмент.Изменен = Ложь;
		мсСегментыВЗубе.Добавить(СегментВЗубе);
	
	КонецЦикла;
	
	СформироватьВариантыКарты();
	
	РеквизитФормыВЗначение("Объект").Записать();
	
	//удаление остальных сегментов
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	стомЗубыКарты.Ссылка
	|ИЗ
	|	Справочник.стомЗубыКарты КАК стомЗубыКарты
	|ГДЕ
	|	стомЗубыКарты.Владелец = &Владелец
	|	И НЕ стомЗубыКарты.Ссылка В (&ЗубыВКарте)";
	Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
	Запрос.УстановитьПараметр("ЗубыВКарте", мсЗубыВКарте);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗубОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЗубОбъект.Удалить();
		
	КонецЦикла;
	
	//удаление остальных сегментов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стомСегментыЗубов.Ссылка
	|ИЗ
	|	Справочник.стомСегментыЗубов КАК стомСегментыЗубов
	|ГДЕ
	|	стомСегментыЗубов.Владелец = &Владелец
	|	И НЕ стомСегментыЗубов.Ссылка В (&СегментыВЗубе)";
	Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
	Запрос.УстановитьПараметр("СегментыВЗубе", мсСегментыВЗубе);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СегментОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СегментОбъект.Удалить();
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СписокСегментовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанныеСегмент = Элемент.ТекущиеДанные;
	Если ТекДанныеСегмент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ТекДанныеСегмент.Изменен = Истина;
		ТекДанныеСегмент.ИдентификаторSL = Строка(Новый УникальныйИдентификатор());
		ТекДанныеСегмент.ZIndex = СписокСегментов.Индекс(ТекДанныеСегмент);		
	КонецЕсли;
	
	//ПерерисоватьЗуб();
	//УстановитьВыделениеЗубов();
	Если ЗначениеЗаполнено(ТекДанныеСегмент.Сегмент) Тогда
		ТекСегментЗуба = ТекДанныеСегмент;		
	Иначе
		ТекСегментЗуба = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

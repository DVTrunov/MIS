&НаСервереБезКонтекста
Процедура УстановитьОтбор(Значение)
	Форма = Справочники.стомВариантыЗубов.ПолучитьФорму("ФормаВыбора");
	Форма.Список.Отбор.Элементы.Сбросить();
	Отбор = Форма.Список.Отбор.Элементы.Добавить("ВариантЗуба");
	Отбор.Использование = Истина;
	Отбор.Значение = Значение;
	Отбор.ВидСравнения = ВидСравнения.НеРавно;	
КонецПроцедуры


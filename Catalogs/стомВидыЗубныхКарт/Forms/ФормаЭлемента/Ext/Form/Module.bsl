&НаКлиенте
Процедура СписокЗубовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанныеЗуб = Элемент.ТекущиеДанные;
	Если ТекДанныеЗуб = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НоваяСтрока Тогда
		ТекДанныеЗуб.Изменен = Истина;
		ТекДанныеЗуб.ИдентификаторSL = Строка(Новый УникальныйИдентификатор());
		ТекДанныеЗуб.ZIndex = СписокЗубов.Индекс(ТекДанныеЗуб);
	КонецЕсли;
	//запоминается идентификатор зуба на случай изменения
	Если ЗначениеЗаполнено(ТекДанныеЗуб.Зуб) Тогда
		ТекЗубКарты = ТекДанныеЗуб.Зуб.УникальныйИдентификатор();
	Иначе
		ТекЗубКарты = Неопределено;
	КонецЕсли;
	
КонецПроцедуры


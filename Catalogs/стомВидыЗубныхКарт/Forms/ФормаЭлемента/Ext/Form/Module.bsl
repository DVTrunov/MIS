Процедура ЗаполнитьСписокЗубов(ЗначениеКопирования = Неопределено)
	
	Если ЗначениеКопирования = Неопределено Тогда
		ТекОбъект = Объект.Ссылка;
	Иначе
		ТекОбъект = ЗначениеКопирования;
	КонецЕсли;
	
	СписокЗубов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	стомЗубыКарты.Ссылка КАК ЗубВКарте,
	|	стомЗубыКарты.TranslateX,
	|	стомЗубыКарты.TranslateY,
	|	стомЗубыКарты.Rotation,
	|	стомЗубыКарты.ScaleX,
	|	стомЗубыКарты.ScaleY,
	|	стомЗубыКарты.ZIndex КАК ZIndex,
	|	стомЗубыКарты.Наименование,
	|	стомЗубыКарты.Зуб,
	|	стомЗубыКарты.ОсновнойВариант
	|ИЗ
	|	Справочник.стомЗубыКарты КАК стомЗубыКарты
	|ГДЕ
	|	стомЗубыКарты.Владелец = &ТекОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	ZIndex";
	Запрос.УстановитьПараметр("ТекОбъект", ТекОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = СписокЗубов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторSL = Строка(Выборка.ЗубВКарте.УникальныйИдентификатор());
		НоваяСтрока.ЗубВКарте = ?(ЗначениеКопирования = Неопределено, Выборка.ЗубВКарте, Неопределено);
		НоваяСтрока.Изменен = (ЗначениеКопирования = Неопределено);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияНового()
	стСвойстваДляЗаполнения = Новый Структура;
	стСвойстваДляЗаполнения.Вставить("TranslateX", 0);
	стСвойстваДляЗаполнения.Вставить("TranslateY", 0);
	стСвойстваДляЗаполнения.Вставить("ScaleX", 1);
	стСвойстваДляЗаполнения.Вставить("ScaleY", 1);
	стСвойстваДляЗаполнения.Вставить("Rotation", 0);
	стСвойстваДляЗаполнения.Вставить("ШиринаКанвы", 800);
	стСвойстваДляЗаполнения.Вставить("ВысотаКанвы", 400);
	
	Для Каждого кзСвойство Из стСвойстваДляЗаполнения Цикл
		Если Объект.Свойство(кзСвойство.Ключ) И Не ЗначениеЗаполнено(Объект[кзСвойство.Ключ]) Тогда
			Объект[кзСвойство.Ключ] = кзСвойство.Значение;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


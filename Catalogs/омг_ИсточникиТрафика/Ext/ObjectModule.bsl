#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Ключ = НРег(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НаправлениеТрафика) Тогда
		НаправлениеТрафика = Перечисления.омг_НаправленияТрафика.Входящий;
	КонецЕсли;
	АдресДляПодключения = омг_ЛидыВходящиеЗаявки.АдресВебхука(ТипИсточника, Ключ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Ключ = "";
	АдресДляПодключения = "";
	
КонецПроцедуры

#КонецОбласти


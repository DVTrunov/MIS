&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите источник трафика.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВводаТокена", ЭтотОбъект, ПараметрКоманды);
	ПоказатьВводСтроки(Оповещение, "",
		НСтр("ru = 'Токен доступа (сохранённый токен не показывается; пустое значение удаляет токен)'"), 0, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаТокена(Токен, Источник) Экспорт
	
	Если Токен = Неопределено Тогда
		Возврат;
	КонецЕсли;
	омг_ЛидыВызовСервера.СохранитьТокенИсточникаТрафика(Источник, СокрЛП(Токен));
	ПоказатьОповещениеПользователя(?(ЗначениеЗаполнено(СокрЛП(Токен)),
		НСтр("ru = 'Токен доступа сохранён'"), НСтр("ru = 'Токен доступа удалён'")));
	
КонецПроцедуры

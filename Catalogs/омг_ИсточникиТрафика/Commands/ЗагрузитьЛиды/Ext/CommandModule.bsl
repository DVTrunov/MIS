&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите источник трафика.'"));
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Загрузка лидов...'"));
	ТекстРезультата = омг_ЛидыВызовСервера.ЗагрузитьЛидыИсточникаТрафика(ПараметрКоманды);
	ПоказатьПредупреждение(, ТекстРезультата);
	
КонецПроцедуры

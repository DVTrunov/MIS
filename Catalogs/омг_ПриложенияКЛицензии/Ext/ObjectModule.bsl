Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
    Бессрочное    = Истина;
    Состояние     = Перечисления.омг_СостоянияМедицинскихЛицензий.Действует;
    Ответственный = Пользователи.ТекущийПользователь();
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

    Если Бессрочное Тогда
        Индекс = ПроверяемыеРеквизиты.Найти("ДатаОкончания");
        Если Индекс <> Неопределено Тогда
            ПроверяемыеРеквизиты.Удалить(Индекс);
        КонецЕсли;
    ИначеЕсли ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания <= ДатаВыдачи Тогда
        ОбщегоНазначения.СообщитьПользователю(
            "Дата окончания должна быть больше даты выдачи",
            ЭтотОбъект, "ДатаОкончания", , Отказ);
    КонецЕсли;

    Если Подвиды.Количество() = 0 Тогда
        ОбщегоНазначения.СообщитьПользователю(
            "Не заполнены подвиды лицензируемой деятельности",
            ЭтотОбъект, "Подвиды", , Отказ);
    КонецЕсли;

    Проверенные = Новый Соответствие;
    Для Каждого СтрокаТЧ Из Подвиды Цикл

        Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ПодвидДеятельности) Тогда
            Продолжить;
        КонецЕсли;

        Если Проверенные[СтрокаТЧ.ПодвидДеятельности] <> Неопределено Тогда
            ОбщегоНазначения.СообщитьПользователю(
                "Подвид """ + Строка(СтрокаТЧ.ПодвидДеятельности) + """ указан несколько раз",
                ЭтотОбъект,
                "Объект.Подвиды[" + Формат(Подвиды.Индекс(СтрокаТЧ), "ЧГ=0") + "].ПодвидДеятельности",
                , Отказ);
        КонецЕсли;

        Проверенные.Вставить(СтрокаТЧ.ПодвидДеятельности, Истина);

    КонецЦикла;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    РегистрыСведений.омг_ЛицензированныеВидыДеятельности.ОтразитьПриложение(ЭтотОбъект);

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	 Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    ПроверитьПравоНаОрганизацию(Отказ);
    Если Отказ Тогда
        Возврат;
    КонецЕсли;
КонецПроцедуры 

Процедура ПроверитьПравоНаОрганизацию(Отказ)

    Если ПравоДоступа("Администрирование", Метаданные) Тогда
        Возврат;
    КонецЕсли;

    ОсновнаяОрганизация = ОсновнаяОрганизацияПользователя();

    Если НЕ ЗначениеЗаполнено(ОсновнаяОрганизация) Тогда
        Возврат;
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(МедицинскийЦентр) Тогда
        Возврат;
    КонецЕсли;

    ОрганизацияМедцентра = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
        МедицинскийЦентр, "Организация");

    Если ОрганизацияМедцентра <> ОсновнаяОрганизация Тогда
        ОбщегоНазначения.СообщитьПользователю(
            "Это приложение относится к другому филиалу. Изменять его нельзя. "
            + "Если считаете это ошибкой — обратитесь в головной офис.",
            ЭтотОбъект, "МедицинскийЦентр", , Отказ);
		КонецЕсли;
	

КонецПроцедуры 
Функция ОсновнаяОрганизацияПользователя()

    Возврат УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(
        ПараметрыСеанса.ТекущийПользователь,
        "омг_ОсновнаяОрганизация");

КонецФункции

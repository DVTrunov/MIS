Перем СтараяОрганизация;
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
    Бессрочная = Истина;
    Состояние  = Перечисления.омг_СостоянияМедицинскихЛицензий.Действует;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты) 
	Индекс = ПроверяемыеРеквизиты.Найти("Наименование");
    Если Индекс <> Неопределено Тогда
        ПроверяемыеРеквизиты.Удалить(Индекс);
    КонецЕсли;

    Если Бессрочная Тогда
        Индекс = ПроверяемыеРеквизиты.Найти("ДатаОкончания");
        Если Индекс <> Неопределено Тогда
            ПроверяемыеРеквизиты.Удалить(Индекс);
        КонецЕсли;
    ИначеЕсли ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания <= ДатаВыдачи Тогда
        ОбщегоНазначения.СообщитьПользователю(
            "Дата окончания должна быть больше даты выдачи",
            ЭтотОбъект, "ДатаОкончания", , Отказ);
    КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Если НЕ ЭтоНовый() Тогда
    СтараяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Организация");
КонецЕсли;

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    Наименование = "№" + СокрЛП(НомерЛицензии)
        + " от " + Формат(ДатаВыдачи, "ДФ=dd.MM.yyyy");

    Если Бессрочная Тогда
        ДатаОкончания = '00010101';
    КонецЕсли;

    ПроверитьУникальностьНомера(Отказ);

КонецПроцедуры

Процедура ПроверитьУникальностьНомера(Отказ)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Лицензии.Ссылка
    |ИЗ
    |   Справочник.омг_МедицинскиеЛицензии КАК Лицензии
    |ГДЕ
    |   Лицензии.НомерЛицензии = &Номер
    |   И Лицензии.Организация = &Организация
    |   И Лицензии.Ссылка <> &Ссылка
    |   И НЕ Лицензии.ПометкаУдаления";

    Запрос.УстановитьПараметр("Номер", НомерЛицензии);
    Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("Ссылка", Ссылка);

    Если НЕ Запрос.Выполнить().Пустой() Тогда
        ОбщегоНазначения.СообщитьПользователю(
            "Лицензия с таким номером уже зарегистрирована для этой организации",
            ЭтотОбъект, "НомерЛицензии", , Отказ);
    КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;
    Если СтараяОрганизация <> Неопределено И СтараяОрганизация <> Организация Тогда
        РегистрыСведений.омг_ЛицензированныеВидыДеятельности.ПерезаполнитьПоЛицензии(Ссылка);
    КонецЕсли;
КонецПроцедуры
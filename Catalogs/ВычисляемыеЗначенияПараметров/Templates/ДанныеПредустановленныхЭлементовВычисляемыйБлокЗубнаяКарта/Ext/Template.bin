<?xml version="1.0" encoding="UTF-8"?>
<ФайлОбмена ВерсияФормата="2.0" ДатаВыгрузки="2014-04-23T20:39:17" НачалоПериодаВыгрузки="0001-01-01T00:00:00" ОкончаниеПериодаВыгрузки="0001-01-01T00:00:00" ИмяКонфигурацииИсточника="БИТУправлениеМедицинскимЦентром" ИмяКонфигурацииПриемника="БИТУправлениеМедицинскимЦентром" ИдПравилКонвертации="e39c5eab-9ab9-477c-929b-78800a32a5f3" Комментарий="">
<ПравилаОбмена>
	<ВерсияФормата>2.01</ВерсияФормата>
	<Ид>e39c5eab-9ab9-477c-929b-78800a32a5f3</Ид>
	<Наименование>БИТУправлениеМедицинскимЦентром --&gt; БИТУправлениеМедицинскимЦентром</Наименование>
	<ДатаВремяСоздания>2014-02-17T14:07:00</ДатаВремяСоздания>
	<Источник>БИТУправлениеМедицинскимЦентром</Источник>
	<Приемник>БИТУправлениеМедицинскимЦентром</Приемник>
	<Параметры/>
	<Обработки/>
	<ПравилаКонвертацииОбъектов>
		<Правило>
			<Код>ВычисляемыеЗначенияПараметров</Код>
			<СинхронизироватьПоИдентификатору>true</СинхронизироватьПоИдентификатору>
			<ПродолжитьПоискПоПолямПоискаЕслиПоИдентификаторуНеНашли>true</ПродолжитьПоискПоПолямПоискаЕслиПоИдентификаторуНеНашли>
			<Источник>СправочникСсылка.ВычисляемыеЗначенияПараметров</Источник>
			<Приемник>СправочникСсылка.ВычисляемыеЗначенияПараметров</Приемник>
		</Правило>
	</ПравилаКонвертацииОбъектов>
	<ПравилаОчисткиДанных/>
	<Алгоритмы/>
	<Запросы/>
</ПравилаОбмена>
<Объект Нпп="1" Тип="СправочникСсылка.ВычисляемыеЗначенияПараметров" ИмяПравила="ВычисляемыеЗначенияПараметров"><Ссылка Нпп="1">
	<Свойство Имя="{УникальныйИдентификатор}" Тип="Строка">
		<Значение>fe40333f-4230-11e4-8253-0cd29229b33b</Значение>
	</Свойство>
	<Свойство Имя="Наименование" Тип="Строка">
		<Значение>Блок HTML: Зубная карта</Значение>
	</Свойство>
</Ссылка>
	<Свойство Имя="АлгоритмВычисления" Тип="Строка">
		<Значение>ТЧСостояния = ДокументОбъект.стомУстановленныеСостояния;
Запрос = Новый Запрос;
Запрос.Текст = 
"ВЫБРАТЬ РАЗЛИЧНЫЕ 
|	стомУстановленныеСостояния.ЗубВКарте КАК ЗубВКарте,
|	стомУстановленныеСостояния.СостояниеСегмента КАК СостояниеСегмента
|ПОМЕСТИТЬ стомУстановленныеСостояния
|ИЗ
|	&amp;ТабСостоянияЗубов КАК стомУстановленныеСостояния
|ГДЕ
|	стомУстановленныеСостояния.ВидРедактирования = ЗНАЧЕНИЕ(Перечисление.стомВидыРедактированияЭлементовКарты.Добавление)
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	стомУстановленныеСостояния.ЗубВКарте КАК ЗубВКарте,
|	стомУстановленныеСостояния.СостояниеСегмента.КраткоеОбозначение КАК Обозначение
|ИЗ
|	стомУстановленныеСостояния КАК стомУстановленныеСостояния
|ИТОГИ ПО
|	ЗубВКарте";
Запрос.УстановитьПараметр("ТабСостоянияЗубов", ТЧСостояния.Выгрузить());
ВыборкаЗубы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

ТекстHTML = Справочники.стомВидыЗубныхКарт.ПолучитьМакет("МакетHTML").ПолучитьТекст();

ДокШаблон = Новый ЧтениеHTML;
ДокШаблон.УстановитьСтроку(ТекстHTML);
ПостроительDOM = Новый ПостроительDOM;
ДокументDOM = ПостроительDOM.Прочитать(ДокШаблон);

Для Каждого ЭлементDOM Из ДокументDOM.ПолучитьЭлементыПоИмени("div") Цикл
	
	Для Каждого АтрибутDOM Из ЭлементDOM.Атрибуты Цикл
		Если АтрибутDOM.ИмяУзла = "id" Тогда
			ЭлементDOM.УстановитьАтрибутИдентификатор("id",Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецЦикла;

Пока ВыборкаЗубы.Следующий() Цикл
	СтрокаСостояния = "";
	ВыборкаСостояния = ВыборкаЗубы.Выбрать();
	Пока ВыборкаСостояния.Следующий() Цикл
		СтрокаСостояния = СтрокаСостояния + ?(ЗначениеЗаполнено(ВыборкаСостояния.Обозначение), ВыборкаСостояния.Обозначение + ", ", "");
	КонецЦикла;
	СтрокаСостояния = Лев(СтрокаСостояния, СтрДлина(СтрокаСостояния) - 2);
	
	ЭлементDOM = ДокументDOM.ПолучитьЭлементПоИдентификатору(Строка(ВыборкаЗубы.ЗубВКарте));
	Если ЭлементDOM = Неопределено Тогда
		Продолжить;
	КонецЕсли;
	ЭлементDOM.ТекстовоеСодержимое = СтрокаСостояния;
КонецЦикла;

ЗаписьDOM = Новый ЗаписьDOM;
ЗаписьHTML = Новый ЗаписьHTML;
ЗаписьHTML.УстановитьСтроку();
ЗаписьDOM.Записать(ДокументDOM, ЗаписьHTML);

Результат = ЗаписьHTML.Закрыть();</Значение>
	</Свойство>
</Объект>
</ФайлОбмена>

			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 19cm"&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="4"&gt;

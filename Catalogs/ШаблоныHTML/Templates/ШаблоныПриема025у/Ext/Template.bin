					&lt;/font&gt;
				&lt;/div&gt;
				&lt;div style="text-align: left;"&gt;
					&lt;font size="2"&gt;
						&lt;span&gt;4.1.3. Изгибы позвоночника в сагиттальной плоскости:&lt;/span&gt;
					&lt;/font&gt;
				&lt;/div&gt;
				&lt;div style="text-align: left;"&gt;
					&lt;span&gt;
						&lt;font size="2"&gt;шейный лордоз: 
							&lt;span&gt;
								&lt;select id="c6ba9f3a-34dc-11ee-a405-40167e631ef0"&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;сохранен&amp;quot;}"&gt;сохранен&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;сглажен&amp;quot;}"&gt;сглажен&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;усилен&amp;quot;}"&gt;усилен&lt;/option&gt;
								&lt;/select&gt;     &lt;/span&gt;
							&lt;span&gt;грудной кифоз: 
								&lt;select id="c6ba9f3b-34dc-11ee-a405-40167e631ef0"&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;сохранен&amp;quot;}"&gt;сохранен&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;сглажен&amp;quot;}"&gt;сглажен&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;усилен&amp;quot;}"&gt;усилен&lt;/option&gt;
								&lt;/select&gt;
							&lt;/span&gt;
							&lt;br/&gt;
							&lt;span&gt;поясничный лордоз: 
								&lt;select id="c6ba9f3c-34dc-11ee-a405-40167e631ef0"&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;сохранен&amp;quot;}"&gt;сохранен&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;сглажен&amp;quot;}"&gt;сглажен&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;усилен&amp;quot;}"&gt;усилен&lt;/option&gt;
								&lt;/select&gt;
							&lt;/span&gt;
						&lt;/font&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;div style="text-align: left;"&gt;
					&lt;font size="2"&gt;4.2. Мышечный тонус: 
						&lt;span&gt;
							&lt;select id="c6ba9f3d-34dc-11ee-a405-40167e631ef0"&gt;
								&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;симметричный&amp;quot;}"&gt;симметричный&lt;/option&gt;
								&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;асимметричный&amp;quot;}"&gt;асимметричный&lt;/option&gt;
							&lt;/select&gt;
						&lt;/span&gt;

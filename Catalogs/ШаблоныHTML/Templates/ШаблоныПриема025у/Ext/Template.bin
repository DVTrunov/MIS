			<Description>025/у, 8. Консультация заведующего отделением</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 19cm"&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;
					&lt;em&gt;
						&lt;font size="4"&gt;Консультация заведующего отделением
							&lt;span style="FONT-SIZE: 10pt; FONT-FAMILY: 'Times New Roman','serif'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: RU; mso-fareast-language: RU; mso-bidi-language: AR-SA"&gt;:&lt;/span&gt;
						&lt;/font&gt;
					&lt;/em&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;span style="FONT-SIZE: 10pt; FONT-FAMILY: 'Times New Roman','serif'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: RU; mso-fareast-language: RU; mso-bidi-language: AR-SA"&gt;
					&lt;div class="FORMAT"&gt;
						&lt;font size="4"&gt;Дата: &lt;/font&gt;
						&lt;font size="4"&gt;
							&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="4"&gt;  в&lt;/font&gt;
						&lt;span style="FONT-SIZE: 10pt; FONT-FAMILY: 'Times New Roman','serif'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: RU; mso-fareast-language: RU; mso-bidi-language: AR-SA"&gt;
							&lt;font size="4"&gt;ременная нетрудоспособность с 
								&lt;a id="edf1c744-22a4-11e2-87b5-002618dcef2c" href="about:"&gt;[...]&lt;/a&gt; (
								&lt;textarea id="6151e99d-afeb-11e7-9bf5-fa1f296fa3e4" style="OVERFLOW: auto; HEIGHT: 25px; WIDTH: 32px" rows="1" cols="1"/&gt; дней).&lt;/font&gt;
						&lt;/span&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;span style="FONT-SIZE: 10pt; FONT-FAMILY: 'Times New Roman','serif'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: RU; mso-fareast-language: RU; mso-bidi-language: AR-SA"&gt;
							&lt;font size="4"&gt;Пациент: &lt;/font&gt;
							&lt;font size="4"&gt;
								&lt;a id="f7bece55-cafa-11e5-9bc7-50af732359f4" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/font&gt;
						&lt;/span&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;font size="4"&gt;Жалобы и динамика состояния: &lt;/font&gt;
						&lt;font size="4"&gt;
							&lt;a id="0f2c1daa-49ee-11e7-80c3-38d54778b16b" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;div class="FORMAT"&gt;
							&lt;font size="4"&gt;Проведенное обследование и лечение: &lt;/font&gt;
							&lt;font size="4"&gt;
								&lt;a id="6151e99c-afeb-11e7-9bf5-fa1f296fa3e4" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/font&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;font size="4"&gt;Диагноз:&lt;/font&gt;
						&lt;/div&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;
							&lt;font size="4" face="Times New Roman"&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/font&gt;
						&lt;/tt&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;div class="FORMAT"&gt;
							&lt;font size="4"/&gt; &lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;font size="4"&gt;Внешняя причина при травмах (отравлениях): &lt;/font&gt;
							&lt;font size="4"&gt;
								&lt;a id="25fb200b-ae5c-11e7-9bf5-fa1f296fa3e4" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/font&gt;
						&lt;/div&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;div class="FORMAT"&gt;
							&lt;font size="4"&gt;Рекомендации: &lt;/font&gt;
							&lt;font size="4"&gt;
								&lt;a id="23c5eacc-5289-11e7-80c7-38d54778b16b" href="about:"&gt;[...]&lt;/a&gt;

															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;в шейном отделе&amp;quot;}"&gt;в шейном отделе&lt;/option&gt;
															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;в грудном отделе&amp;quot;}"&gt;в грудном отделе&lt;/option&gt;
															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;в поясничном отделе&amp;quot;}"&gt;в поясничном отделе&lt;/option&gt;
														&lt;/select&gt;

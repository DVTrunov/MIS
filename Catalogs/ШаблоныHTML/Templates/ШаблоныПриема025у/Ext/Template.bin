						&lt;/font&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;font size="4"&gt;Лечащий врач: &lt;/font&gt;
						&lt;font size="4"&gt;
							&lt;a id="2ade98ad-d52e-11e5-986c-3a893ef5765d" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
					&lt;/div&gt;
				&lt;/span&gt;
			&lt;/div&gt;

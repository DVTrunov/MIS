				&lt;/div&gt;
				&lt;div style="text-align: left;"&gt;
					&lt;font size="2"&gt;
						&lt;span&gt;
							&lt;span&gt;
								&lt;span&gt;
									&lt;span&gt;
										&lt;span&gt;
											&lt;span&gt;
												&lt;span&gt;3.10. Психомоторное развитие (для детей): 
													&lt;span&gt;
														&lt;select id="e7f96db4-328c-11ee-a405-40167e631ef0"&gt;
															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Соответствует возрасту&amp;quot;}"&gt;Соответствует возрасту&lt;/option&gt;
															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Не соответствует возрасту&amp;quot;}"&gt;Не соответствует возрасту&lt;/option&gt;
														&lt;/select&gt;
													&lt;/span&gt;
												&lt;/span&gt;
											&lt;/span&gt;
										&lt;/span&gt;
									&lt;/span&gt;
								&lt;/span&gt;
							&lt;/span&gt;
						&lt;/span&gt;
					&lt;/font&gt;
				&lt;/div&gt;
				&lt;div style="text-align: left;"&gt;
					&lt;font size="2"&gt;Для детей первого года жизни:&lt;/font&gt;
				&lt;/div&gt;
				&lt;div style="text-align: left;"&gt;
					&lt;table border="1" style="border-color: inherit; border-style: solid; border-collapse: collapse; width: 100%;" data-bit-collapse="collapse"&gt;
						&lt;tbody&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96db5-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;удерживает голову&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96db6-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;ходит, держась за одну руку&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96db7-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;лежа на животе, опирается на предплечья&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96db8-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;самостоятельная ходьба&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96db9-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;переворачивается со спины на живот&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dba-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;осознанная улыбка&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dbb-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;переворачивается с живота на спину&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dbc-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;различает "своих" и "чужих"&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dbd-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;берет игрушку в ручку&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dbe-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;отдельные звуки певучие&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dbf-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;присаживается&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc0-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;фиксирует взгляд на предмете и следит за ним&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc1-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;сидит&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc2-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;произносит "агу"&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; width: 45%; vertical-align: middle;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc3-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;встает на четвереньки&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc4-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;слоги певучие&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc5-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;ползает&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; width: 45%; vertical-align: middle;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc6-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;основные слова-определения&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc7-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;берет предметы в ручку и совершает простые действия с ними&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc8-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;знает названия базовых предметов и по просьбе ищет их&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dc9-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;встает у опоры&lt;/font&gt;
								&lt;/td&gt;
								&lt;td rowspan="2" style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; дополнительно: 
										&lt;span&gt;
											&lt;a id="e7f96dcb-328c-11ee-a405-40167e631ef0" href="about:"&gt;[...]&lt;/a&gt;
										&lt;/span&gt;
									&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 45%;"&gt;
									&lt;font size="2"&gt; 
										&lt;span&gt;
											&lt;input type="checkbox" id="e7f96dca-328c-11ee-a405-40167e631ef0" value="False"/&gt;
										&lt;/span&gt;переступает у опоры&lt;/font&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/tbody&gt;
					&lt;/table&gt;
					&lt;div style="text-align: left;"&gt;
						&lt;span&gt;
							&lt;style media="print"&gt;.dontshow {visibility: hidden;color: blue;mso-special-character: line-break;page-break-after: always;}
							&lt;/style&gt;
							&lt;div class="dontshow" align="left"&gt;
								&lt;em&gt;
									&lt;font size="2" color="#888888"&gt;&amp;lt;---Переход на следующую страницу---&amp;gt;&lt;/font&gt;
								&lt;/em&gt;
							&lt;/div&gt;
						&lt;/span&gt;
					&lt;/div&gt;
					&lt;font size="2"&gt;
						&lt;div style="text-align: left;"&gt;4. Остеопатический статус&lt;/div&gt;
					&lt;/font&gt;
				&lt;/div&gt;
				&lt;div style="text-align: left;"&gt;
					&lt;font size="2"&gt;4.1. Общий осмотр&lt;/font&gt;
				&lt;/div&gt;
				&lt;div style="text-align: left;"&gt;
					&lt;table border="1" style="border-color: inherit; border-style: solid; border-collapse: collapse; width: 100%;"&gt;
						&lt;tbody&gt;
							&lt;tr style="height: 0px;"&gt;
								&lt;td style="text-align: center; word-wrap: break-word; vertical-align: middle; width: 62%;"&gt;
									&lt;font size="2"&gt; 4.1.1. Оцениваемые параметры&lt;/font&gt;
								&lt;/td&gt;
								&lt;td style="text-align: center; word-wrap: break-word; vertical-align: middle; width: 50%;"&gt;
									&lt;font size="2"&gt; Симметричность/расположение на одном уровне&lt;/font&gt;
								&lt;/td&gt;

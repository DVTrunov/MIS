			<Description>025/у, 3. Запись врача-специалиста</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 19cm"&gt;
			&lt;font size="4" face="Times New Roman"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;div class="FORMAT"&gt;
						&lt;div class="FORMAT"&gt;Дата: 
							&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, Пациент: 
							&lt;a id="f7bece55-cafa-11e5-9bc7-50af732359f4" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
					&lt;/div&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;div class="FORMAT"&gt;
						&lt;div class="FORMAT"&gt;Осмотр специалиста: 
							&lt;a id="25fb2008-ae5c-11e7-9bf5-fa1f296fa3e4" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;Жалобы пациента: 
						&lt;a id="0f2c1daa-49ee-11e7-80c3-38d54778b16b" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;Анамнез заболевания, жизни: 
						&lt;a id="8beddfe1-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;Объективные данные: 
						&lt;a id="7efd3d72-54dd-11e7-80c8-38d54778b16b" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;div class="FORMAT"&gt;Диагноз: &lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/tt&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;div class="FORMAT"&gt; &lt;/div&gt;
							&lt;div class="FORMAT"&gt;Внешняя причина при травмах (отравлениях): 
								&lt;a id="25fb200b-ae5c-11e7-9bf5-fa1f296fa3e4" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/div&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;div class="FORMAT"&gt;Группа здоровья: 
								&lt;select id="3811737b-aa7e-11e7-9bf5-fa1f296fa3e4"&gt;
									&lt;option selected="selected" value="{&amp;quot;S&amp;quot;,&amp;quot;I&amp;quot;}"&gt;I&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;II&amp;quot;}"&gt;II&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;III&amp;quot;}"&gt;III&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;IV&amp;quot;}"&gt;IV&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;V&amp;quot;}"&gt;V&lt;/option&gt;
								&lt;/select&gt;
							&lt;/div&gt;
							&lt;div class="FORMAT"&gt;Диспансерное наблюдение 
								&lt;a id="a4e6f3d6-b7d1-11e7-9bf5-fa1f296fa3e4" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/div&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT"&gt;Назначения (исследования, консультации): 
							&lt;a id="509c195e-3ead-11e6-82f0-acb57d27613a" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;div class="FORMAT"&gt;Листок нетрудоспособности, справка: 
								&lt;a id="25fb200c-ae5c-11e7-9bf5-fa1f296fa3e4" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/div&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;div class="FORMAT"&gt;
								&lt;div class="FORMAT"&gt;
									&lt;div class="FORMAT"&gt;
										&lt;div class="FORMAT"&gt;Лекарственные препараты, физиотерапия: 
											&lt;a id="6151e991-afeb-11e7-9bf5-fa1f296fa3e4" href="about:"&gt;[...]&lt;/a&gt;
										&lt;/div&gt;
										&lt;div class="FORMAT"&gt;
											&lt;br/&gt;
											&lt;span&gt;
												&lt;tt id="5cb664c3-0a38-11e7-828e-40167e631f2e"&gt;&amp;lt;Блок HTML: План лечения: медикаменты&amp;gt;&lt;/tt&gt;
											&lt;/span&gt;
											&lt;br/&gt;
										&lt;/div&gt;
									&lt;/div&gt;
								&lt;/div&gt;
								&lt;div class="FORMAT" data-bit-hidden="true"&gt;
									&lt;br/&gt;Льготные рецепты: 
									&lt;a id="25fb200d-ae5c-11e7-9bf5-fa1f296fa3e4" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/div&gt;
							&lt;/div&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT" data-bit-hidden="true"&gt;
							&lt;br/&gt;
							&lt;span&gt;
								&lt;select id="3dca3b8d-12d7-11eb-a30c-b42e9995fee4"&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Информированное добровольное согласие на медицинское вмешательство&amp;quot;}"&gt;Информированное добровольное согласие на медицинское вмешательство&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Отказ от медицинского вмешательства&amp;quot;}"&gt;Отказ от медицинского вмешательства&lt;/option&gt;
									&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;&amp;quot;}"&gt;[согласие на вмешательство не указано]&lt;/option&gt;
								&lt;/select&gt;
							&lt;/span&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT"/&gt;
						&lt;div class="FORMAT"&gt;
							&lt;div class="FORMAT"&gt;
								&lt;br/&gt;Врач: 
								&lt;a id="2ade98ad-d52e-11e5-986c-3a893ef5765d" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/div&gt;
						&lt;/div&gt;
					&lt;/div&gt;
				&lt;/div&gt;
			&lt;/font&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

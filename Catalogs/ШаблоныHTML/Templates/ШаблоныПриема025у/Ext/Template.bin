											&lt;/td&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 19%;"&gt;
												&lt;font size="2"&gt; ограничена:&lt;/font&gt;
											&lt;/td&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 25%;"&gt;
												&lt;font size="2"&gt; 
													&lt;span&gt;
														&lt;select id="c6ba9f43-34dc-11ee-a405-40167e631ef0"&gt;
															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;&amp;quot;}"/&gt;
															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;в шейном отделе&amp;quot;}"&gt;в шейном отделе&lt;/option&gt;
															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;в грудном отделе&amp;quot;}"&gt;в грудном отделе&lt;/option&gt;
															&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;в поясничном отделе&amp;quot;}"&gt;в поясничном отделе&lt;/option&gt;
														&lt;/select&gt;
													&lt;/span&gt;
												&lt;/font&gt;
											&lt;/td&gt;
										&lt;/tr&gt;
										&lt;tr style="height: 0px;"&gt;
											&lt;td style="word-wrap: break-word; width: 25%; vertical-align: middle;"&gt;
												&lt;font size="2"&gt; латерофлексия вправо&lt;/font&gt;
											&lt;/td&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 25%;"&gt;
												&lt;font size="2"&gt; 
													&lt;span&gt;
														&lt;input type="checkbox" id="c6ba9f40-34dc-11ee-a405-40167e631ef0" value="False" style="font-size: small;"/&gt;
													&lt;/span&gt;не ограничена&lt;/font&gt;
											&lt;/td&gt;

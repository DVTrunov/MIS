																		&lt;font size="2"&gt;
																			&lt;span&gt; 
																				&lt;input type="checkbox" id="e7f96dae-328c-11ee-a405-40167e631ef0" value="False"/&gt;
																			&lt;/span&gt;ползания по Бауэру&lt;/font&gt;
																	&lt;/td&gt;
																	&lt;td style="word-wrap: break-word; width: 0%; vertical-align: middle;"&gt;
																		&lt;font size="2"&gt; 
																			&lt;span&gt;
																				&lt;input type="checkbox" id="e7f96daf-328c-11ee-a405-40167e631ef0" value="False"/&gt;
																			&lt;/span&gt;Бабинского&lt;/font&gt;
																	&lt;/td&gt;
																&lt;/tr&gt;
																&lt;tr style="height: 0px;"&gt;

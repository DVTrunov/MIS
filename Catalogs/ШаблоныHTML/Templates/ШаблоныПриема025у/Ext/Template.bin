											&lt;td style="word-wrap: break-word; width: 25%; vertical-align: middle;"&gt;
												&lt;font size="2"&gt; общая экстензия&lt;/font&gt;
											&lt;/td&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 25%;"&gt;
												&lt;font size="2"&gt; 
													&lt;span&gt;
														&lt;input type="checkbox" id="c6ba9f3f-34dc-11ee-a405-40167e631ef0" value="False" style="font-size: small;"/&gt;

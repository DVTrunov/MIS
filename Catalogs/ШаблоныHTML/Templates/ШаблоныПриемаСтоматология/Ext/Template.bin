			<Code>000000040</Code>
			<Description>Пародонтит_профгигиена</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div style="WIDTH: 19cm"&gt;&lt;div class="FORMAT"&gt;&lt;div class="FORMAT"&gt;Дата: 
					&lt;a id="629e316c-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;    Время: 
					&lt;a id="629e316d-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;&lt;div class="FORMAT"&gt;Пациент: 
					&lt;a id="99e2a615-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Жалобы:&lt;/strong&gt; 
					&lt;a id="629e316f-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Анамнез:&lt;/strong&gt; 
					&lt;a id="629e3173-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Внешний осмотр&lt;/strong&gt;
				&lt;/div&gt;&lt;div class="FORMAT"&gt;&lt;div class="FORMAT"&gt;Конфигурация лица: 
						&lt;select id="629e318a-93fc-11e9-941c-3c970e84593a"&gt;&lt;option selected="selected" value="{&amp;quot;S&amp;quot;,&amp;quot;не изменена&amp;quot;}"&gt;не изменена&lt;/option&gt;&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;изменена&amp;quot;}"&gt;изменена&lt;/option&gt;&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot; &amp;quot;}"&gt;&lt;/option&gt;&lt;/select&gt;. Кожные покровы: 
						&lt;a id="629e318b-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;Кожные высыпания и припухлости: 
						&lt;select id="629e318e-93fc-11e9-941c-3c970e84593a"&gt;&lt;option selected="selected" value="{&amp;quot;S&amp;quot;,&amp;quot;нет&amp;quot;}"&gt;нет&lt;/option&gt;&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;есть&amp;quot;}"&gt;есть&lt;/option&gt;&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot; &amp;quot;}"&gt;&lt;/option&gt;&lt;/select&gt;. Красная кайма губ: 
						&lt;a id="629e318f-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;Губы: 
						&lt;a id="629e3191-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt;
						&lt;strong&gt;Осмотр полости рта&lt;/strong&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt;Слизистая оболочка губ, щёк, твердого и мягкого нёба: 
						&lt;a id="629e3194-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt;Язык: 
						&lt;a id="629e3199-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Спинка языка: 
						&lt;a id="629e319d-93fc-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Болезненность, жжение языка: 
						&lt;select id="8332c605-9401-11e9-941c-3c970e84593a"&gt;&lt;option selected="selected" value="{&amp;quot;S&amp;quot;,&amp;quot;не наблюдается&amp;quot;}"&gt;не наблюдается&lt;/option&gt;&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;наблюдается&amp;quot;}"&gt;наблюдается&lt;/option&gt;&lt;/select&gt;.&lt;/div&gt;&lt;div class="FORMAT"&gt;Нёбные миндалины: 
						&lt;a id="8332c606-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;Маргинальная часть десны и межзубные сосочки: 
						&lt;a id="8332c60c-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Зубодесневое соединение: 
						&lt;select id="8332c60f-9401-11e9-941c-3c970e84593a"&gt;&lt;option selected="selected" value="{&amp;quot;S&amp;quot;,&amp;quot;не нарушено&amp;quot;}"&gt;не нарушено&lt;/option&gt;&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;нарушено&amp;quot;}"&gt;нарушено&lt;/option&gt;&lt;/select&gt;&lt;/div&gt;&lt;div class="FORMAT"&gt;Патологические пародонтальные карманы: 
						&lt;select id="8332c610-9401-11e9-941c-3c970e84593a"&gt;&lt;option selected="selected" value="{&amp;quot;S&amp;quot;,&amp;quot;нет&amp;quot;}"&gt;нет&lt;/option&gt;&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;есть&amp;quot;}"&gt;есть&lt;/option&gt;&lt;/select&gt;&lt;/div&gt;&lt;div class="FORMAT"&gt;Прикус: 
						&lt;a id="8332c611-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Зубы: 
						&lt;a id="8332c613-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Мягкий зубной налет: 
						&lt;a id="8332c615-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Наддесневой зубной камень: 
						&lt;a id="8332c618-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Поддесневой зубной камень: 
						&lt;a id="8332c61c-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Глубина преддверия: 
						&lt;a id="8332c61e-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt; Аномалии положения и формы зубов: 
						&lt;a id="8332c620-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;
						&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;
							&lt;font size="4" face="Times New Roman"&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/font&gt;
						&lt;/tt&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;
						&lt;strong&gt;План лечения:&lt;/strong&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt;
						&lt;tt id="53cd1b54-05d9-43d4-ad74-bc00949c1b31"&gt;&amp;lt;Блок HTML: План лечения&amp;gt;&lt;/tt&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt;
						&lt;strong&gt;Лечение:&lt;/strong&gt; 
						&lt;a id="8332c623-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt;Даны рекомендации: 
						&lt;a id="8332c635-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;Врач:__________________/ 
						&lt;a id="8332c639-9401-11e9-941c-3c970e84593a" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;
				&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt; &lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;&lt;/html&gt;</ТекстHTML>

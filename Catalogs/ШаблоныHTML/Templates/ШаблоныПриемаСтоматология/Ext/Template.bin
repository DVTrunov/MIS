			<Parent>290be812-49f2-11e8-82ad-40167e631f2e</Parent>
			<Code>000000048</Code>
			<Description>Осмотр врача-ортодонта (функциональные методы обследования)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div style="FONT-SIZE: 12pt; WIDTH: 19cm"&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong style="font-size: 12pt;"&gt;ФУНКЦИОНАЛЬНЫЕ МЕТОДЫ ОБСЛЕДОВАНИЯ&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT" style="font-size: 12pt;"&gt;
					&lt;table width="100%" border="0" style="font-size: 12pt;"&gt;&lt;tbody&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="word-wrap: break-word; vertical-align: middle; width: 354px;"&gt;Пациент: 
									&lt;a id="99e2a615-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt; 
									&lt;br&gt;Врач: 
									&lt;a id="99e2a616-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/td&gt;
								&lt;td style="word-wrap: break-word; width: 354.0625px; vertical-align: middle;"&gt;
									&lt;div align="right"&gt; Дата осмотра: 
										&lt;a id="99e2a614-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/div&gt;
								&lt;/td&gt;
							&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
				&lt;div class="FORMAT" style="font-size: 12pt;"&gt;
					&lt;span style="font-size: 12pt;"&gt;&lt;/span&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;span style="font-size: 12pt;"&gt;
					&lt;span&gt;
						&lt;hr&gt;&lt;/hr&gt;&lt;/span&gt;
					&lt;b&gt;Клинические функциональные пробы:&lt;/b&gt;
				&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Проба Эшлера-Битнера (выдвижение нижней челюсти до смыкания моляров по 1 кл. 
				&lt;span style="font-family: 'PT Serif', 'Times New Roman', serif; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-size: 12pt;"&gt;Энгля&lt;/span&gt;
				&lt;span style="font-size: 12pt;"&gt;).&lt;/span&gt;
			&lt;/div&gt;
			&lt;li&gt;
				&lt;div class="FORMAT"&gt;профиль: 
					&lt;a id="fdd5c8e4-29ad-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
			&lt;/li&gt;
			&lt;div class="FORMAT"&gt;Пробы Ильиной-Маркосян:&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;li&gt;
					&lt;div class="FORMAT"&gt;сдвиг нижней челюсти сзади до краевого смыкания резцов: 
						&lt;a id="fdd5c8e9-29ad-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;/li&gt;
				&lt;li&gt;
					&lt;div class="FORMAT"&gt;при открывании рта линии косметического центра: 
						&lt;a id="fdd5c8ec-29ad-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;/li&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Проба положения губ при сомкнутых зубных рядах: &lt;/div&gt;
			&lt;li&gt;
				&lt;div class="FORMAT"&gt;губы смыкаются: 
					&lt;a id="fdd5c8f0-29ad-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
			&lt;/li&gt;
			&lt;div class="FORMAT"&gt;Измерение вертикальной щели между резцами:&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;li&gt;
					&lt;div class="FORMAT"&gt;при максимальном опускании нижней челюсти:
						&lt;textarea id="b3b7d0b6-2a4a-11e7-9be6-50af7323357f" style="overflow: auto; width: 36px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt;мм.&lt;/div&gt;
				&lt;/li&gt;
			&lt;/div&gt;
			&lt;li&gt;
				&lt;div class="FORMAT"&gt;при относительном физиологическом покое:
					&lt;textarea id="b3b7d0b7-2a4a-11e7-9be6-50af7323357f" style="overflow: auto; width: 36px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt;мм.&lt;/div&gt;
				&lt;div align="center" style="text-align: left; "&gt;
					&lt;div class="FORMAT"&gt;
						&lt;strong&gt;
							&lt;br&gt;&lt;/strong&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;strong&gt;Дополнительные методы обследования:&lt;/strong&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;a id="1250a951-2a3e-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
				&lt;/div&gt;
				&lt;div align="center"&gt;
					&lt;br&gt;&lt;/div&gt;
				&lt;div align="center" style="text-align: left; "&gt;
					&lt;span&gt;

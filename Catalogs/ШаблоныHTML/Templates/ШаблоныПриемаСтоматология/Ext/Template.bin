	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>e8d3efab-6515-4d86-81b5-4eae22186ddd</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Дата документа</Description>
			<АлгоритмВычисления>Результат = Формат(ДокументОбъект.Дата, "ДЛФ=Д");</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Дата</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>258363a1-9714-44ab-b217-e80d20c415f3</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Клиент: Фамилия И.О.</Description>
			<АлгоритмВычисления>Док = ДокументОбъект;
Фамилия = СокрЛП(Док.Клиент.Фамилия);
Имя = Лев(СокрЛП(Док.Клиент.Имя), 1);
Отчество = Лев(СокрЛП(Док.Клиент.Отчество), 1);
Результат = Фамилия + Символы.НПП + Имя + Символы.НПП + Отчество;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Клиент</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>75b80f70-a4be-4cda-97a7-46b5d878be32</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Врач: ФИО полное</Description>
			<АлгоритмВычисления>Док = ДокументОбъект;

Попытка
	Врач = Док.Врач;
Исключение 
	Попытка
		Врач = Док.Сотрудник;
	Исключение КонецПопытки;
КонецПопытки;

Если ЗначениеЗаполнено(Врач) Тогда
	Фамилия = СокрЛП(Врач.Фамилия);
	Имя = СокрЛП(Врач.Имя);
	Отчество = СокрЛП(Врач.Отчество);
	Результат = Фамилия + Символы.НПП + Имя + Символы.НПП + Отчество;
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Врач</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>2ccd1436-0b67-11e6-8289-54ee7507761c</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Блок HTML: Зубная карта (актуальная)</Description>
			<АлгоритмВычисления>СТАНДАРТНЫЕ_АЛГОРИТМЫ_СТОМА_ЗУБНАЯ_КАРТА_АКТУАЛЬНАЯ</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ВычисляемыйБлок</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>00ae9b3a-1383-11e6-828a-54ee7507761c</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Блок HTML: Зубная карта (Ортопедическая)</Description>
			<АлгоритмВычисления>СТАНДАРТНЫЕ_АЛГОРИТМЫ_СТОМА_ЗУБНАЯ_КАРТА_ОРТОПЕДИЧЕСКАЯ</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ВычисляемыйБлок</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>90eb9681-75b7-4170-bec8-542c0d001a04</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Блок HTML: Диагноз</Description>
			<АлгоритмВычисления>НомерДиагноза = 1;
Текст = "";
ТЧ = Объект.Диагнозы;
ОбозначенияЗубов = стомСтоматология.ПолучитьОбозначенияЗубовНаДату(Объект.Клиент, Объект.ЗубнаяКарта, Объект.Дата);
Для Каждого Стр Из ТЧ Цикл
	Если ТЧ.Количество() &gt; 1 Тогда
		Текст = Символы.ПС + Текст + Строка(НомерДиагноза) + ". ";
		НомерДиагноза = НомерДиагноза + 1;
	КонецЕсли;
	
	ЗубСегмент = "";
	ОбозначениеЗуба = ОбозначенияЗубов[Стр.ЗубВКарте];
	Если ЗначениеЗаполнено(ОбозначениеЗуба) Тогда		
		ЗубСегмент = "[" + ОбозначениеЗуба + ?(ЗначениеЗаполнено(Стр.СегментВЗубе), ", " + Строка(Стр.СегментВЗубе), "") + "]";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.Диагноз.КодДиагноза) Тогда
		МКБ = "[" + Стр.Диагноз.КодДиагноза + "] ";
	Иначе
		МКБ = "";
	КонецЕсли;
	
	Диагноз = Стр.Диагноз.Наименование;
	Описание = Стр.Детализация;
	Сопутствующий = Стр.Сопутствующий;
	К1 = Строка(Стр.Классификация1);
	К2 = Строка(Стр.Классификация2);
	К3 = Строка(Стр.Классификация3);
	Травма = Стр.Травма.Наименование;
	Исход = ?(Стр.Исход.ПолноеНаименование &lt;&gt; "", Стр.Исход.ПолноеНаименование, Стр.Исход.Наименование);
	
	Если ЗначениеЗаполнено(МКБ + Диагноз) Тогда 
		Текст = Текст + "Диагноз: " + ЗубСегмент + МКБ + Диагноз + "&lt;br&gt;";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Описание) Тогда
		Текст = Текст + "Описание: " + Описание + "&lt;br&gt;";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сопутствующий) Тогда
		Текст = Текст + "Сопутствующий: " + Сопутствующий + "&lt;br&gt;";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К1 + К2 + К3) Тогда
		Текст = Текст + "Классификация: "; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К1) Тогда
		Текст = Текст + К1 + ", ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К2) Тогда
		Текст = Текст + К2 + ", ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К3) Тогда
		Текст = Текст + К3;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К1 + К2 + К3) Тогда
		Текст = Текст + "&lt;br&gt;"; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Травма) Тогда
		Текст = Текст + "Травма: " + Травма;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Исход) Тогда
		Если Травма &lt;&gt; "" Тогда
			Текст = Текст + ", ";
		КонецЕсли;
		Текст = Текст + "Исход диагноза: " + Исход;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Травма + Исход) Тогда
		Текст = Текст + "&lt;br&gt;"; 
	КонецЕсли;
	
КонецЦикла;

Результат = Текст;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ВычисляемыйБлок</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>

			<Description>Клиент: Фамилия И.О.</Description>
			<АлгоритмВычисления>Док = ДокументОбъект;
Фамилия = СокрЛП(Док.Клиент.Фамилия);
Имя = Лев(СокрЛП(Док.Клиент.Имя), 1);
Отчество = Лев(СокрЛП(Док.Клиент.Отчество), 1);
Результат = Фамилия + Символы.НПП + Имя + Символы.НПП + Отчество;</АлгоритмВычисления>

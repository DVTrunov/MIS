			<Description>Кариес - осмотр стоматолога</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div style="WIDTH: 19cm"&gt;
			&lt;h3 class="FORMAT" align="center"&gt;Осмотр стоматолога&lt;/h3&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;Дата: 
					&lt;a id="423268a1-9251-11e9-9374-d0c905f70b58" href="about:"&gt;[...]&lt;/a&gt;, Пациент: 
					&lt;a id="99e2a615-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt; &lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;tt id="2ccd1436-0b67-11e6-8289-54ee7507761c"&gt;&amp;lt;Блок HTML: Зубная карта (актуальная)&amp;gt;&lt;/tt&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Жалобы: &lt;/strong&gt;
				&lt;a id="423268a2-9251-11e9-9374-d0c905f70b58" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;Перенесенные и сопутствующие заболевания: 
					&lt;a id="3c14ab30-4224-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt"&gt;
					&lt;span style="FONT-SIZE: 12pt"&gt;Наследственные заболевания: 
						&lt;a id="423268b5-9251-11e9-9374-d0c905f70b58" href="about:"&gt;[...]&lt;/a&gt;
						&lt;!--?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /????--&gt;
						&lt;o:p&gt;&lt;/o:p&gt;
					&lt;/span&gt;
				&lt;/p&gt;
				&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt"&gt;
					&lt;span style="FONT-SIZE: 12pt"&gt;Профессиональные вредности: 
						&lt;a id="423268b8-9251-11e9-9374-d0c905f70b58" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;

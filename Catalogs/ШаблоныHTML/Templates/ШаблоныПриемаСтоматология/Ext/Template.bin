								&lt;/tr&gt;&lt;tr&gt;&lt;td style="word-wrap: break-word; width: 40%;" width="40%"&gt;
										&lt;li&gt;
											&lt;div class="FORMAT"&gt;&amp;lt;L1/ML&lt;/div&gt;
										&lt;/li&gt;
									&lt;/td&gt;
									&lt;td style="WORD-WRAP: break-word" width="60%"&gt;
										&lt;textarea id="7b527ffa-297a-11e7-9be6-50af7323357f" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 50px" rows="1" cols="1"&gt;&lt;/textarea&gt; град.&lt;/td&gt;
								&lt;/tr&gt;&lt;tr&gt;&lt;td style="word-wrap: break-word; width: 40%;" width="40%"&gt;
										&lt;li&gt;
											&lt;div class="FORMAT"&gt;&amp;lt;1/1 "alfa"&lt;/div&gt;
										&lt;/li&gt;
									&lt;/td&gt;

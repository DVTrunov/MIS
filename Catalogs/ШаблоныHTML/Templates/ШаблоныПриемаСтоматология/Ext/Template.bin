	<Шаблон>
		<CatalogObject.ШаблоныHTML>
			<Ref>b1c6ec67-2a7a-11e7-ba36-40f02fefcad1</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>290be812-49f2-11e8-82ad-40167e631f2e</Parent>
			<Code>000000050</Code>
			<Description>Осмотр врача-ортодонта (полость рта)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div style="width: 19cm;"&gt;
			&lt;div class="FORMAT" style="font-size: 12pt;"&gt;
				&lt;strong&gt;ОСМОТР ПОЛОСТИ РТА&lt;/strong&gt;
			&lt;/div&gt;
			&lt;table style="font-size: 12pt;" width="100%" border="0"&gt;&lt;tbody&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="word-wrap: break-word; vertical-align: middle; width: 50%;"&gt;Пациент: 
							&lt;a id="99e2a615-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
							&lt;br&gt;Врач: 
							&lt;a id="99e2a616-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; width: 50%; vertical-align: middle;"&gt;
							&lt;div align="right"&gt; Дата осмотра: 
								&lt;a id="99e2a614-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/div&gt;
						&lt;/td&gt;
					&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div class="FORMAT" style="font-size: 12pt;"&gt;
				&lt;span style="font-size: 12pt;"&gt;
					&lt;span&gt;
						&lt;hr&gt;&lt;/hr&gt;&lt;/span&gt;
					&lt;b&gt;Мягкие ткани полости рта:&lt;/b&gt;
				&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Уздечка верхней губы: &lt;/font&gt;
				&lt;a id="2fa8f0de-2a79-11e7-ba36-40f02fefcad1" href="about:" style="font-size: 12pt;"&gt;[...]&lt;/a&gt; 
				&lt;div class="FORMAT" style="font-size: 12pt;"&gt;Уздечка нижней губы: 
					&lt;a id="383c0c44-2a79-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT" style="font-size: 12pt;"&gt;Уздечка языка: 
					&lt;a id="3f0d1903-2a79-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT" style="font-size: 12pt;"&gt;
					&lt;div class="FORMAT"&gt;Язык: 
						&lt;a id="9932e5b0-2b83-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT" style="font-size: 12pt;"&gt;Преддверие полости рта: 
					&lt;a id="4eb568e7-2a79-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt; 
					&lt;div class="FORMAT"&gt;Слизистая оболочка: 
						&lt;a id="6181a90e-2a79-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt; &lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;strong&gt;Зубы:&lt;/strong&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;Прикус: 
						&lt;a id="10260b6f-2a7a-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;Гигиена полости рта: 
						&lt;a id="1f546c03-2a7a-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt; &lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;tt id="6867f219-2a7a-11e7-ba36-40f02fefcad1"&gt;&amp;lt;Блок HTML: Параметры зубной формулы:Аномалии зубов&amp;gt;&lt;/tt&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;  &lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;span&gt;
							&lt;tt id="2ccd1436-0b67-11e6-8289-54ee7507761c"&gt;&amp;lt;Блок HTML: Зубная карта (актуальная)&amp;gt;&lt;/tt&gt;
						&lt;/span&gt;
						&lt;br&gt;&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;br&gt;&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;strong&gt;Зубные ряды:&lt;/strong&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT" style="PAGE-BREAK-INSIDE: avoid"&gt;
						&lt;table style="FONT-SIZE: 12pt; BORDER-COLLAPSE: collapse;height:px" width="100%" border="1"&gt;&lt;tbody&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="word-wrap: break-word; vertical-align: middle; width: 10%;" valign="top" rowspan="12"&gt;
										&lt;div style="PAGE-BREAK-INSIDE: avoid"&gt;Размеры зубных рядов (поз.1-3, 5-6, 9-10, 12-14) и апикальных базисов челюстей (поз. 4, 7, 8, 11)
											&lt;br&gt;&lt;span&gt;
												&lt;img id="8c11e7e3-6c58-4163-9cba-6adf19e01cb0" style="width:342px;height:474px"&gt;&lt;/img&gt;&lt;/span&gt;            
											&lt;br&gt;&lt;/div&gt;
									&lt;/td&gt;
									&lt;td style="word-wrap: break-word; vertical-align: middle; width: 10%;"&gt;1.   
										&lt;textarea id="4de050c1-2b27-11e7-ba36-40f02fefcad1" style="overflow: auto; width: 50px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt;&lt;/td&gt;
									&lt;td style="word-wrap: break-word; vertical-align: middle; width: 50%;" valign="top" rowspan="12"&gt;  
										&lt;div class="FORMAT"&gt;Форма зубных рядов: 
											&lt;a id="b6e93767-2b28-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt; 
											&lt;div class="FORMAT"&gt;
												&lt;div class="FORMAT"&gt;Контакт соседних зубов: 
													&lt;a id="e791c1e1-2b28-11e7-ba36-40f02fefcad1" href="about:"&gt;[...]&lt;/a&gt;
												&lt;/div&gt;
												&lt;div class="FORMAT"&gt;Диастема между 1⏉1 
													&lt;span&gt;

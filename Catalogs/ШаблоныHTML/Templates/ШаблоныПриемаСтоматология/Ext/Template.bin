			<Parent>290be812-49f2-11e8-82ad-40167e631f2e</Parent>
			<Code>000000051</Code>
			<Description>Осмотр врача-ортодонта (жалобы, анамнез)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div style="FONT-SIZE: 12pt; WIDTH: 19cm"&gt;
			&lt;table style="FONT-SIZE: 12pt" width="100%" border="0"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style="WORD-WRAP: break-word" width="50%"&gt;Пациент: 
							&lt;a id="99e2a615-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
							&lt;br&gt;Врач: 
							&lt;a id="99e2a616-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;div align="right"&gt; Дата осмотра: 
								&lt;a id="99e2a614-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/div&gt;
						&lt;/td&gt;
					&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div class="FORMAT"&gt;
				&lt;span&gt;&lt;/span&gt;
				&lt;span&gt;
					&lt;hr&gt;&lt;/hr&gt;&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;ЖАЛОБЫ&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;a id="3c14ab2f-4224-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;АНАМЕЗ &lt;/strong&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Нарушение здоровья матери [триместр беременности: 
					&lt;a id="0a373272-28c6-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;]&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Рожден: 
					&lt;a id="0a373277-28c6-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Вид вскармливания: 
					&lt;a id="0a37327a-28c6-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt; ( искусственное с 
					&lt;span&gt;
						&lt;textarea id="7be1d2fa-2946-11ef-9534-08979885f491" style="width: 30px;height:22px" rows="0"&gt;&lt;/textarea&gt;&lt;/span&gt; мес.)&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Начало прорез.первых зубов:  
					&lt;textarea id="0a373287-28c6-11e7-9be6-50af7323357f" style="overflow: auto; width: 30px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt; мес.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Начало смены первых зубов:  
					&lt;textarea id="4b24ce93-2971-11e7-9be6-50af7323357f" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 30px" rows="1" cols="1"&gt;&lt;/textarea&gt; лет.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Наличие вредных привычек: 
					&lt;a id="0a373291-28c6-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Наличие врожденных аномалий развития челюстно-лицевой области: 
					&lt;a id="0a373297-28c6-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Перенесенные и сопутствующие заболевания: 
					&lt;a id="4b24ce6e-2971-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Проводилось ранее ортодонтическое лечение: 
					&lt;a id="7b527fd6-297a-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;div class="FORMAT"&gt; &lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;ОСМОТР ЛИЦА, КЕФАЛОМЕТРИЯ&lt;/strong&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;span class="Apple-tab-span" style="white-space:pre"&gt;&lt;/span&gt;
					&lt;span class="Apple-tab-span" style="white-space:pre"&gt;&lt;/span&gt;    Лицо анфас:&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Ширина лица: zy-zy 
					&lt;textarea id="7b527fe0-297a-11e7-9be6-50af7323357f" style="overflow: auto; width: 34px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt; мм.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Высота лица: n-me 
					&lt;textarea id="7b527fe1-297a-11e7-9be6-50af7323357f" style="overflow: auto; width: 30px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt; мм, n-sn 
					&lt;textarea id="7b527fe2-297a-11e7-9be6-50af7323357f" style="overflow: auto; width: 30px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt; мм, sn-me 
					&lt;textarea id="7b527fe3-297a-11e7-9be6-50af7323357f" style="overflow: auto; width: 30px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt; мм.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Лицо симметричное: 
					&lt;a id="4b24ce55-2971-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Подбородок смещен: 
					&lt;a id="0a3732a6-28c6-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Выраженность 
					&lt;span style="font-family: 'PT Serif', 'Times New Roman', serif; font-variant-ligatures: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255);"&gt;надподбородочной&lt;/span&gt; складки: 
					&lt;a id="4b24ce58-2971-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Губы сомкнуты: 
					&lt;a id="4b24ce5b-2971-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Симптом "десневой улыбки": 
					&lt;a id="4b24ce5e-2971-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt; &lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;span class="Apple-tab-span" style="white-space:pre"&gt;&lt;/span&gt;
					&lt;span class="Apple-tab-span" style="white-space:pre"&gt;&lt;/span&gt;    Лицо в профиль:&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Тип профиля: 
					&lt;a id="afd0b6d9-28e5-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Положение верхней губы: 
					&lt;a id="afd0b6dd-28e5-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Положение нижней губы: 
					&lt;a id="4b24ce61-2971-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Положение подбородка: 
					&lt;a id="afd0b6e1-28e5-11e7-9be6-50af7323357f" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;&lt;/html&gt;</ТекстHTML>

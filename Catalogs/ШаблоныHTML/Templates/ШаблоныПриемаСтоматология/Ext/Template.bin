			<Code>000000052</Code>
			<Description>Осмотр врача-ортодонта (дневник врача-ортодонта)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div style="FONT-SIZE: 12pt; WIDTH: 19cm"&gt;
			&lt;table style="FONT-SIZE: 12pt" width="100%" border="0"&gt;&lt;tbody&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="word-wrap: break-word; width: 50%; vertical-align: middle;"&gt;Пациент: 
							&lt;a id="99e2a615-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
							&lt;br&gt;Врач: 
							&lt;a id="99e2a616-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;div align="right"&gt; Дата осмотра: 
								&lt;a id="99e2a614-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/div&gt;
						&lt;/td&gt;
					&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div class="FORMAT"&gt;
				&lt;span&gt;&lt;/span&gt;
				&lt;span&gt;
					&lt;hr&gt;&lt;/hr&gt;&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дневник врача-ортодонта&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;span&gt;
					&lt;table border="1" style="border-color: inherit; border-style: solid; border-collapse: collapse; width: 100%;"&gt;&lt;tbody&gt;&lt;tr style="height: 0px;"&gt;&lt;td colspan="4" style="word-wrap: break-word; vertical-align: middle; width: 2%;"&gt;&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 16%;"&gt; До лечения&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 19%;"&gt; В процессе
									&lt;br&gt; лечения&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 19%;"&gt; После лечения&lt;/td&gt;
							&lt;/tr&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="word-wrap: break-word; vertical-align: middle; text-align: center; width: 2%;"&gt;1&lt;/td&gt;
								&lt;td colspan="3" style="word-wrap: break-word; vertical-align: middle; width: 16%;"&gt;Модели зубных рядов&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 19%;"&gt;
									&lt;span&gt; 
										&lt;a id="eeb4d638-23be-11ef-9532-08979885f491" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
									&lt;br&gt;&lt;/td&gt;
								&lt;td style="word-wrap: break-word; vertical-align: middle; width: 19%;"&gt;
									&lt;span&gt; 
										&lt;a id="eeb4d639-23be-11ef-9532-08979885f491" href="about:"&gt;[...]&lt;/a&gt;

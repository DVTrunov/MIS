										&lt;textarea id="7b527ffb-297a-11e7-9be6-50af7323357f" style="overflow: auto; width: 50px;height:22px" rows="0" cols="0"&gt;&lt;/textarea&gt; град.&lt;/td&gt;
								&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div class="FORMAT" style="font-size: 12pt;"&gt;
							&lt;div class="FORMAT"&gt;Положение резцов и моляров&lt;/div&gt;

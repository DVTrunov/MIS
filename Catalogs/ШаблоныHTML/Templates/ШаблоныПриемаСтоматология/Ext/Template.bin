			<Description>Врач: ФИО полное</Description>
			<АлгоритмВычисления>Док = ДокументОбъект;

Попытка
	Врач = Док.Врач;
Исключение 
	Попытка
		Врач = Док.Сотрудник;
	Исключение КонецПопытки;
КонецПопытки;

Если ЗначениеЗаполнено(Врач) Тогда
	Фамилия = СокрЛП(Врач.Фамилия);
	Имя = СокрЛП(Врач.Имя);
	Отчество = СокрЛП(Врач.Отчество);
	Результат = Фамилия + Символы.НПП + Имя + Символы.НПП + Отчество;
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Врач</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>53cd1b54-05d9-43d4-ad74-bc00949c1b31</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Блок HTML: План лечения</Description>
			<АлгоритмВычисления>// Шапка
Текст = "&lt;TABLE border=2&gt;
		|&lt;TBODY&gt;
		|&lt;TR&gt;
		|&lt;TD style='WORD-WRAP: break-word'&gt;
		|&lt;P align=center&gt;Наименование услуги&lt;/P&gt;&lt;/TD&gt;
		|&lt;TD style='WORD-WRAP: break-word'&gt;
		|&lt;P align=center&gt;Дата&lt;/P&gt;&lt;/TD&gt;
		|&lt;TD style='WORD-WRAP: break-word'&gt;
		|&lt;P align=center&gt;Назначено&lt;/P&gt;&lt;/TD&gt;
		|&lt;TD style='WORD-WRAP: break-word'&gt;
		|&lt;P align=center&gt;Комментарий&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;";

Для Каждого Строка Из ПланЛечения Цикл
	
	Текст = Текст + "&lt;TR&gt;";
	
	Если Строка.ВидЭлемента = Перечисления.ВидыНазначений.Прием Тогда
		Услуга = "Консультация врача специализации """ + Строка.Номенклатура.Наименование + """";
	Иначе
		Услуга = Строка.Номенклатура.Наименование;
	КонецЕсли;
	
	Дата = ?(Строка.Дата = НачалоДня(Строка.Дата), Формат(Строка.Дата, "ДФ=dd.MM.yyyy"), Строка(Строка.Дата));
	Если Строка.Дата = Дата(1,1,1) Тогда
		Дата = "&amp;nbsp;";
	КонецЕсли;
	
	Назначено = ?(Строка.Количество = 0, "&amp;nbsp;", Строка(Строка.Количество));
	Комментарий = ?(ПустаяСтрока(Строка.Комментарий), "&amp;nbsp;", Строка.Комментарий);
	
	Текст = Текст + "&lt;TD style='WORD-WRAP: break-word'&gt;&lt;P&gt;" + Услуга + "&lt;/TD&gt;";
	Текст = Текст + "&lt;TD align=center&gt;" + Дата + "&lt;/TD&gt;";
	Текст = Текст + "&lt;TD style='WORD-WRAP: break-word' align=center&gt;" + Назначено + "&lt;/TD&gt;";
	Текст = Текст + "&lt;TD style='WORD-WRAP: break-word' align=center&gt;" + Комментарий + "&lt;/TD&gt;&lt;/TR&gt;";
	
	Результат = Текст;
	
КонецЦикла;

Текст = Текст + "&lt;/TBODY&gt;&lt;/TABLE&gt;";</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ВычисляемыйБлок</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>

			<Description>31. Коагуллограмма</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Коагулограмма&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt; 
				&lt;div class="FORMAT"&gt;
					&lt;div class="FORMAT"&gt;
						&lt;div class="FORMAT"&gt;
							&lt;strong&gt;Пациент: &lt;/strong&gt;
							&lt;strong&gt;
								&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/strong&gt;, дата рождения: 
							&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, пол: 
							&lt;a id="d196e985-a7f6-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
						&lt;div class="FORMAT"&gt;Последняя менструация с 
							&lt;a id="a7b3906b-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; по 
							&lt;a id="a7b3906c-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/tt&gt;
						&lt;/div&gt;
					&lt;/div&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;table width="100%" border="3"&gt;
				&lt;tbody/&gt;
			&lt;/table&gt;
			&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Тромбиновое время&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="744a08c0-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 10-13 сек&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Протромбиновое время&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae82ff-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 13-18 сек&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Фибриноген&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae8303-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 0,9-6,0 г/л&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; АЧТВ&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae8305-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 24-38 сек&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ПТИ&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="07d04f4f-1038-11e5-bb44-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;%&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 80%-100%&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; АВР&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae8300-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 60-120 сек.&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ТПГ&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae8301-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 3-7 мин&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Вр.обр.сгустка&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae8302-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; до 15 мин&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Тромботест&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae8304-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 4-5 ст&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; РФМК&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae8306-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; менее 3мл/100г&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
			&lt;p/&gt;
			&lt;p&gt;Врач: 
				&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

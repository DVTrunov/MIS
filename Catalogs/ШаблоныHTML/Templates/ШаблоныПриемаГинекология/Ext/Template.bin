			<Code>000000101</Code>
			<Description>77. Осмотр дерматовенеролога (мужчина)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 8.931cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Осмотр дерматовенеролога&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Прием: &lt;/strong&gt;
				&lt;a id="a4d8d18a-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Пациент:&lt;/strong&gt; 
				&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;возраст&lt;/strong&gt; (полных лет) 
				&lt;a id="9a640545-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Жалобы:&lt;/strong&gt;  
				&lt;a id="83017dcb-6e6a-11e1-9f34-e9a901c6eef1" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong/&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Anamnesis Morbi: &lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Считает себя больным: &lt;/strong&gt;
				&lt;a id="a4d8d18d-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Когда впервые отметил появление: &lt;/strong&gt;
				&lt;a id="a4d8d18e-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Появление заболевания связывает с : &lt;/strong&gt;
				&lt;a id="a4d8d18f-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Самостоятельно &lt;/strong&gt;
				&lt;a id="a4d8d190-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;a id="a4d8d193-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong/&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Объективно:&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;общее состояние &lt;/strong&gt;
				&lt;a id="9e874c74-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong&gt;, сознание &lt;/strong&gt;
				&lt;a id="4bacb648-a8e4-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;питание: &lt;/strong&gt; 
				&lt;a id="9e874c6d-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;кожные покровы и видимые слизистые &lt;/strong&gt;
				&lt;a id="9f128635-6274-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;дерматологический процесс &lt;/strong&gt;
				&lt;a id="a4d8d19a-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;процесс представлен &lt;/strong&gt;
				&lt;a id="a4d8d1a2-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Периферические лимфоузлы &lt;/strong&gt;
				&lt;a id="a4d8d1a4-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, пальпаторно 
				&lt;a id="a4d8d1ab-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Ногтевые пластинки: &lt;/strong&gt;
				&lt;a id="a4d8d1ae-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Половые органы:&lt;/strong&gt; сформированы правильно, по мужскому типу. На коже половых органов высыпания 
				&lt;a id="a4d8d1b2-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, губки уретры 
				&lt;a id="a4d8d1b4-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, выделения 
				&lt;a id="1c8a570d-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;. Органы мошонки 
				&lt;a id="a4d8d1ba-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;. Паховые лимфоузлы 
				&lt;a id="a4d8d1bc-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Перианальная область: &lt;/strong&gt;
				&lt;a id="a4d8d1c5-ac42-11e4-a21e-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
			&lt;div class="FORMAT"&gt;  &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Диагноз:&lt;/strong&gt; 
				&lt;a id="21632637-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Назначено обследование:&lt;/strong&gt; 
				&lt;a id="ad6ebe61-8c94-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Назначено лечение: &lt;/strong&gt;
				&lt;a id="ad6ebe62-8c94-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong/&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата осмотра:&lt;/strong&gt; 
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;     
				&lt;strong&gt;Врач:&lt;/strong&gt; 
				&lt;a id="a22aecf7-e701-11e1-8205-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

			<Description>Диагноз</Description>
			<АлгоритмВычисления>Результат = "Код";
Для Каждого СтрокаДиагноз Из ДокументОбъект.Диагнозы Цикл

	Результат = Результат + ?(ПустаяСтрока(Результат), "", ". ") 
			  +	"(" + СокрЛП(СокрЛП(СтрокаДиагноз.Диагноз.КодДиагноза) + ") "
			   + СтрокаДиагноз.Детализация);

КонецЦикла;</АлгоритмВычисления>

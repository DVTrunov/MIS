			<Description>09. Диатермопунктура шейки матки.</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="BORDER-TOP: 0px solid; BORDER-RIGHT: 0px solid; WIDTH: 21cm; BORDER-BOTTOM: 0px solid; BORDER-LEFT: 0px solid"&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="2"&gt;
					&lt;strong&gt;Дата: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;
					&lt;strong&gt;. Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;
					&lt;strong&gt;, возраст: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="afb41360-0837-11e5-b1b3-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;font size="2"&gt;
						&lt;strong&gt;Жалобы:&lt;/strong&gt;  &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="83017dcb-6e6a-11e1-9f34-e9a901c6eef1" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;font size="2"&gt;Последняя менструация с &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="a7b3906b-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt; по &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="a7b3906c-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. &lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;font size="2"&gt;
						&lt;strong&gt;Объективный статус:&lt;/strong&gt; &lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;div class="FORMAT" align="left"&gt;
						&lt;div class="FORMAT"&gt;
							&lt;font size="2"&gt;Состояние &lt;/font&gt;
							&lt;font size="2"&gt;
								&lt;a id="55e30361-d23e-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/font&gt;
							&lt;font size="2"&gt;. Кожные покровы и видимые слизистые оболочки &lt;/font&gt;
							&lt;font size="2"&gt;
								&lt;a id="a7b39070-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/font&gt;
							&lt;font size="2"&gt;. Живот &lt;/font&gt;
							&lt;font size="2"&gt;
								&lt;a id="c3a3969e-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/font&gt;
							&lt;font size="2"&gt;.  &lt;/font&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT"&gt;
							&lt;font size="2"&gt;Физиологические отправления &lt;/font&gt;
							&lt;font size="2"&gt;
								&lt;a id="815d81b2-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b2-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
							&lt;/font&gt;
							&lt;font size="2"&gt;. &lt;/font&gt;
						&lt;/div&gt;
					&lt;/div&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;font size="2"&gt;
						&lt;strong&gt;Status genitalis:&lt;/strong&gt; &lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;font size="2"&gt;Ано-генитальная область &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81b3-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b3-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. Паховые лимфоузлы &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81b4-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b4-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. &lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;font size="2"&gt;Влагалище &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81b7-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b7-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;, слизистая &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81ce-ca64-11e1-bd7f-906f442be8ad" href="about:815d81ce-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. &lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;font size="2"&gt;Шейка матки: &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81b8-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b8-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;, &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="7ce99a22-d9f9-11e1-81fd-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;, &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="7ce99a24-d9f9-11e1-81fd-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. Матка &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81b9-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b9-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;, &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="5e11a0cd-ca6b-11e1-bd7f-906f442be8ad" href="about:5e11a0cd-ca6b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;, &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="5e11a0d1-ca6b-11e1-bd7f-906f442be8ad" href="about:5e11a0d1-ca6b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;, &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="5e11a0d2-ca6b-11e1-bd7f-906f442be8ad" href="about:5e11a0d2-ca6b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. &lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;font size="2"&gt;Придатки &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81ba-ca64-11e1-bd7f-906f442be8ad" href="about:815d81ba-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. Своды &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81bb-ca64-11e1-bd7f-906f442be8ad" href="about:815d81bb-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. Выделения &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81bc-ca64-11e1-bd7f-906f442be8ad" href="about:815d81bc-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. &lt;/font&gt;
				&lt;/div&gt;
				&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;
					&lt;strong&gt;
						&lt;font size="2"&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/font&gt;
					&lt;/strong&gt;
				&lt;/tt&gt; &lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="center"&gt;
				&lt;strong&gt;Операция: Диатермопунктура шейки матки&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="center"&gt;
				&lt;strong/&gt; &lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt;        
				&lt;font face="Arial"&gt;  &lt;/font&gt;С соблюдением правил асептики и антисептики, после соответствующей подготовки шейка матки обнажена в зеркалах. Обезболивание 
				&lt;a id="9ac8b15f-ede9-11e2-b68c-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.Типично произведена диатермопунктура шейки матки 
				&lt;a id="0aa2e843-8b98-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;. Выделения из цервикального канала 
				&lt;a id="5e11a0e4-ca6b-11e1-bd7f-906f442be8ad" href="about:5e11a0e4-ca6b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. Состояние женщины 
				&lt;a id="5e11a0ec-ca6b-11e1-bd7f-906f442be8ad" href="about:5e11a0ec-ca6b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. 
				&lt;br/&gt;
				&lt;br/&gt;
				&lt;strong&gt;Рекомендации:&lt;/strong&gt;
				&lt;br/&gt;1. Половой покой 2 недели.
				&lt;br/&gt;2. Не поднимать тяжести 2 недели.
				&lt;br/&gt;3. Исключить бани, сауны, горячие ванны 2 недели.
				&lt;br/&gt;4. АБ терапия 
				&lt;a id="aa75951e-cb0b-11e1-bd7f-906f442be8ad" href="about:aa75951e-cb0b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;.
				&lt;br/&gt;5. Местная санация 
				&lt;a id="7a5c7d05-b895-11e3-8fa2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt;
				&lt;strong&gt;Врач&lt;/strong&gt; 
				&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt;  
				&lt;hr/&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt;
				&lt;strong&gt;Дата&lt;/strong&gt;  
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt;
				&lt;div class="FORMAT" dir="ltr" align="center"&gt;
					&lt;strong&gt;Операция: Диатермопунктура шейки матки.&lt;/strong&gt;
				&lt;/div&gt;
				&lt;br/&gt;
				&lt;strong&gt;Рекомендации:&lt;/strong&gt; 
				&lt;br/&gt;1. Половой покой 2 недели.
				&lt;br/&gt;2. Не поднимать тяжести 2 недели.
				&lt;br/&gt;3. Исключить бани, сауны, горячие ванны 2 недели.&lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt;4. Явка за результатами гистологического исследования через 2 недели.
				&lt;br/&gt;5. АБ терапия 
				&lt;a id="aa75951e-cb0b-11e1-bd7f-906f442be8ad" href="about:aa75951e-cb0b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;.
				&lt;br/&gt;6. Местная санация 
				&lt;a id="7a5c7d05-b895-11e3-8fa2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" dir="ltr" align="left"&gt;
				&lt;div class="FORMAT" dir="ltr" align="left"&gt;
					&lt;strong&gt;Врач&lt;/strong&gt; 
					&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

			<Description>08. Осмотр терапевта</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 21cm; line-height: 1.5;"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;Осмотр терапевта&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;br/&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Пациент:&lt;/strong&gt; 
				&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;возраст:&lt;/strong&gt; 
				&lt;a id="afb41360-0837-11e5-b1b3-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Жалобы:  
				&lt;a id="83017dcb-6e6a-11e1-9f34-e9a901c6eef1" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Анамнез заболевания: 
				&lt;a id="ac5e9704-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Анамнез жизни: развитие в соответствии с возрастом и полом
				&lt;a id="ac5e9705-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;Профвредности: 
				&lt;a id="d433ad36-6134-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Курение: 
				&lt;a id="20d44e42-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Перенесенные заболевания:  
				&lt;a id="a7b3905c-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Семейный анамнез: 
				&lt;a id="35f6f512-6270-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Аллергоанамнез: 
				&lt;a id="20d44e3e-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Гемотрансфузионный анамнез
				&lt;strong&gt;:&lt;/strong&gt; 
				&lt;a id="ac5e9710-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Кожные покровы: 
				&lt;a id="a7b39070-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Лимфаденопатия: 
				&lt;a id="9f128636-6274-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Грудная клетка: 
				&lt;a id="9f128639-6274-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Данные аускультации: дыхание 
				&lt;a id="1d696e7d-ab0e-11e4-a1cc-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, хрипы 
				&lt;a id="41abbaa9-d249-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Тоны сердца 
				&lt;a id="41abbab9-d249-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, ЧСС 
				&lt;input id="41abbabe-d249-11e1-b361-1803736d59cd" style="overflow: auto; width: 64px; height: 22px;" rows="0" cols="0"/&gt;, &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;div class="FORMAT"&gt;АД на правой руке: 
						&lt;input id="21632636-d7c9-11e1-bab2-1803736d59cd" style="overflow: auto; width: 56px; height: 22px;" rows="0" cols="0"/&gt; / 
						&lt;input id="41abbabf-d249-11e1-b361-1803736d59cd" style="overflow: auto; width: 57px; height: 22px;" rows="0" cols="0"/&gt; мм рт.ст.;&lt;/div&gt;
					&lt;div class="FORMAT"&gt;АД на левой руке: 
						&lt;input id="c075f5a5-eebb-11e2-b68c-d43d7e553e20" style="overflow: auto; width: 65px; height: 22px;" rows="0" cols="0"/&gt; / 
						&lt;input id="c075f5a6-eebb-11e2-b68c-d43d7e553e20" style="overflow: auto; width: 57px; height: 22px;" rows="0" cols="0"/&gt; мм рт.ст.;&lt;/div&gt;Печень: 
					&lt;a id="ce660a85-ab29-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; Отеки: 
					&lt;a id="a7b39087-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;
					&lt;strong&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/strong&gt;
				&lt;/tt&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Обследование:&lt;/strong&gt; 
				&lt;a id="ad6ebe61-8c94-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Рекомендации:&lt;/strong&gt; 
				&lt;a id="c6a1722c-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата осмотра:&lt;/strong&gt; 
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;     
				&lt;strong&gt;Врач:&lt;/strong&gt; 
				&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

							&lt;a id="bf87a744-3226-11e2-9c4b-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
			&lt;hr/&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Заключение: 

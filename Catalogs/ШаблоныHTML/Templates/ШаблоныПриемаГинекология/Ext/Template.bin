			<Parent>5439321d-f70c-11e5-91be-1078d2d69bb4</Parent>
			<Code>000000107</Code>
			<Description>51_2. Исследование методом ИФА (аскариды, лямблии..)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 8.987cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;font size="4"&gt;
					&lt;strong&gt;Анализ крови на аскариды, лямблии, токсокароз и др. &lt;/strong&gt;
					&lt;strong&gt;методом ИФА &lt;/strong&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;Пациент :  
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;p/&gt;
			&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Возбудитель&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt; Ig M&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt; Ig G&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt; Ig A&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt; Суммарные&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt;
							&lt;p align="left"&gt; 
								&lt;strong&gt;Аскариды&lt;/strong&gt;

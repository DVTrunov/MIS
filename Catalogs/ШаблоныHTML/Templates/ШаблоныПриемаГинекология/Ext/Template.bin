	<Шаблон>
		<CatalogObject.ШаблоныHTML>
			<Ref>9a640551-e752-11e1-8206-00242cd5bb52</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>5439321d-f70c-11e5-91be-1078d2d69bb4</Parent>
			<Code>000000077</Code>
			<Description>03.Осмотр гемостазиолога первичный (при беременности)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;Консультация акушера-гинеколога по результатам исследования системы гемостаза&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT" align="left"&gt;
					&lt;strong&gt;Дата осмотра: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT" align="left"&gt;
					&lt;strong&gt;Пациент:&lt;/strong&gt; 
					&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, 
					&lt;strong&gt;возраст:&lt;/strong&gt; 
					&lt;a id="afb41360-0837-11e5-b1b3-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;p&gt;Беременность: 
				&lt;a id="9a640547-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Акушерский анамнез: 
				&lt;a id="9a640548-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Гинекологический анамнез: 
				&lt;a id="9a640549-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p&gt;Течение беременности: 
				&lt;a id="9a64054a-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;УЗИ 1 скрининг: 
				&lt;a id="9a64054b-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;УЗИ 2 скрининг: 
				&lt;a id="9a64054c-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;УЗИ 3 скрининг: 
				&lt;a id="9a64054d-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Прием КОК: длительность 
				&lt;a id="9a64054e-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; отмена 
				&lt;a id="9a64054f-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Наследственность: 
				&lt;a id="9a640550-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Рост: 
				&lt;a id="20d44e39-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; Исх. вес: 
				&lt;a id="20d44e3a-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; ИМТ: 
				&lt;a id="20d44e3b-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Соматические заболевания, ДСТБ: 
				&lt;a id="20d44e3c-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Урогенитальные инфекции: 
				&lt;a id="20d44e3d-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Аллергический анамнез: 
				&lt;a id="20d44e3e-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Вирусинфицирование: 
				&lt;a id="20d44e3f-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Геморрагический анамнез: 
				&lt;a id="20d44e40-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; тромбозы в анамнезе: 
				&lt;a id="20d44e41-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Курение: 
				&lt;a id="20d44e42-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; стаж 
				&lt;a id="20d44e43-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; сигарет в день 
				&lt;a id="20d44e44-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; отказ 
				&lt;a id="20d44e45-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Генетические тромбофилии: 
				&lt;a id="20d44e46-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Гомоцистеин: 
				&lt;input id="20d44e47-0794-11e2-824b-00242cd5bb52" style="overflow: auto; height: 22px;" rows="0"/&gt; (норма до 12,44 мкмоль/л. медиана 7,7) 
				&lt;br/&gt;Д-димер:
				&lt;a id="a1439949-eca7-11e3-9026-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;АФС: 
				&lt;a id="20d44e49-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Получает препараты: 
				&lt;a id="20d44e4a-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Факторы тромбогенного риска:  
				&lt;a id="20d44e4b-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Результат ГСГ: 
				&lt;a id="20d44e4c-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;br/&gt;Заключение: 

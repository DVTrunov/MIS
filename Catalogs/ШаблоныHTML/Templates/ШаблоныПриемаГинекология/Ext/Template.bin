			<Code>000000102</Code>
			<Description>98. Протокол исследования ЭКГ</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 13.719cm; WIDTH: 21cm"&gt;&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;
						&lt;u&gt;Протокол исследования ЭКГ&lt;/u&gt;
					&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;№   
				&lt;a id="0245de9d-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;                                     
				&lt;a id="d196e9c1-a7f6-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;&lt;p&gt;ФИО: 
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;&lt;p&gt;Возраст:  
				&lt;a id="9a640545-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt; Адрес:
				&lt;a id="6339a98d-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;&lt;p&gt;Эл.ось сердца: 
				&lt;select id="0245de9e-b61b-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245de9f}"&gt;не отклонена&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dea0}"&gt;влево&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dea1}"&gt;вправо&lt;/option&gt;
				&lt;/select&gt;.&lt;/p&gt;&lt;p&gt;Эл.позиция: 
				&lt;select id="0245dea2-b61b-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dea3}"&gt;основная&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dea4}"&gt;горизонтальная&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dea5}"&gt;вертикальная&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dea6}"&gt;неопределенная&lt;/option&gt;
				&lt;/select&gt;.&lt;/p&gt;&lt;p&gt;Переходная зона: 
				&lt;a id="0245dea7-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;&lt;p&gt;з.Р 
				&lt;a id="0245deae-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;select id="0245dea8-b61b-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dea9}"&gt;обычный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deaa}"&gt;снижен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deab}"&gt;Р – pulmonale&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deac}"&gt;P – mitrale&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dead}"&gt;отсутствует&lt;/option&gt;
				&lt;/select&gt;
			&lt;/p&gt;&lt;p&gt;PQ: 
				&lt;a id="0245deaf-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;  
				&lt;select id="0245deb0-b61b-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deb1}"&gt;нормальный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deb3}"&gt;удлинен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deb2}"&gt;укорочен&lt;/option&gt;
				&lt;/select&gt;.  &lt;/p&gt;&lt;p&gt;QRS: 
				&lt;a id="0245deb4-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;select id="0245deb5-b61b-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deb6}"&gt;обычный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deb7}"&gt;уширен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deb8}"&gt;деформирован&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deb9}"&gt;зазубрен&lt;/option&gt;
				&lt;/select&gt;.&lt;/p&gt;&lt;p&gt;ST  
				&lt;select id="0245deba-b61b-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245debb}"&gt;обычный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245debc}"&gt;ниже изолинии&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245debd}"&gt;выше изолинии&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245debe}"&gt;гориз.&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245debf}"&gt;косонисх.&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dec0}"&gt;косовосх&lt;/option&gt;
				&lt;/select&gt;.
				&lt;a id="0245dec1-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;        &lt;/p&gt;&lt;p&gt;з.Т 
				&lt;a id="0245dec2-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;select id="0245dec3-b61b-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dec4}"&gt;обычный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dec5}"&gt;снижен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dec6}"&gt;изоэлектричен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dec7}"&gt;отрицательный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dec8}"&gt;2 – фазный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dec9}"&gt;высокий&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245deca}"&gt;симметричный&lt;/option&gt;
				&lt;/select&gt;           &lt;/p&gt;&lt;p&gt;QT 
				&lt;a id="0245decb-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;select id="0245decc-b61b-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245decd}"&gt;обычный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2b61b0245dece}"&gt;удлинен&lt;/option&gt;
				&lt;/select&gt;.              &lt;/p&gt;&lt;p&gt;R-R 
				&lt;a id="0245decf-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; Угол а 
				&lt;a id="0245ded0-b61b-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;                &lt;/p&gt;&lt;p&gt;Заключение:
				&lt;a id="be35187b-a752-11e2-90c8-bb602a0e91c9" href="about:"&gt;[...]&lt;/a&gt; &lt;/p&gt;&lt;p&gt;Врач 
				&lt;a id="a22aecf7-e701-11e1-8205-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

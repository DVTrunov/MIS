			<Description>23. УЗИ мочевого пузыря</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 9.438cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;УЗИ мочевого пузыря&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;span style="FONT-SIZE: 12pt"/&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Дата проведения осмотра: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, аппарат: 
					&lt;a id="c6a17208-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, дата рождения: 
					&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt; &lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Визуализация 
				&lt;a id="904f7cc7-108f-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Форма 
				&lt;a id="904f7cc9-108f-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Наполнение при осмотре 
				&lt;a id="904f7ccb-108f-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Размеры 
				&lt;input id="904f7ccd-108f-11e3-b820-d43d7e553e20" style="overflow: auto; height: 22px; width: 48px;" rows="0" cols="0"/&gt; х 
				&lt;input id="904f7cce-108f-11e3-b820-d43d7e553e20" style="overflow: auto; width: 48px; height: 22px;" rows="0" cols="0"/&gt; х 
				&lt;input id="904f7ccf-108f-11e3-b820-d43d7e553e20" style="overflow: auto; width: 48px; height: 22px;" rows="0" cols="0"/&gt; мм., объем 
				&lt;input id="904f7cd0-108f-11e3-b820-d43d7e553e20" style="overflow: auto; height: 22px; width: 88px;" rows="0"/&gt; см
				&lt;sup&gt;3&lt;/sup&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Контуры 
				&lt;a id="904f7cd1-108f-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Стенки 
				&lt;a id="edcbfae0-1095-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, толщиной 
				&lt;input id="edcbfae3-1095-11e3-b820-d43d7e553e20" style="overflow: auto; height: 22px; width: 64px;" rows="0" cols="0"/&gt; мм.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;a id="edcbfae4-1095-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Объем остаточной мочи 
				&lt;input id="edcbfae7-1095-11e3-b820-d43d7e553e20" style="overflow: auto; height: 22px; width: 64px;" rows="0" cols="0"/&gt; см
				&lt;sup&gt;3&lt;/sup&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Содержимое 
				&lt;a id="edcbfae8-1095-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Образования в полости, в проекции стенок и паравезикальном канале 
				&lt;a id="edcbfaea-1095-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt; &lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;font size="3"&gt;
					&lt;b style="mso-bidi-font-weight: normal"&gt;
						&lt;span style="FONT-SIZE: 11pt; mso-bidi-font-family: Arial; mso-font-kerning: 16.0pt"&gt;Заключение:
							&lt;span style="mso-spacerun: yes"&gt; &lt;/span&gt;
						&lt;/span&gt;
					&lt;/b&gt;.&lt;/font&gt;
				&lt;a id="904f7cc3-108f-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;b style="mso-bidi-font-weight: normal"&gt;
					&lt;span style="FONT-SIZE: 11pt; mso-bidi-font-family: Arial; mso-font-kerning: 16.0pt"&gt;
						&lt;!--?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /?????--&gt;
						&lt;o:p/&gt;
					&lt;/span&gt;
				&lt;/b&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;b style="mso-bidi-font-weight: normal"&gt;
					&lt;span style="FONT-SIZE: 11pt; mso-bidi-font-family: Arial; mso-font-kerning: 16.0pt"&gt;
						&lt;o:p/&gt;
					&lt;/span&gt;
				&lt;/b&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;b style="mso-bidi-font-weight: normal"&gt;
					&lt;span style="FONT-SIZE: 11pt; mso-bidi-font-family: Arial; mso-font-kerning: 16.0pt"&gt;
						&lt;o:p/&gt;
					&lt;/span&gt;
				&lt;/b&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;b style="mso-bidi-font-weight: normal"&gt;
					&lt;span style="FONT-SIZE: 11pt; mso-bidi-font-family: Arial; mso-font-kerning: 16.0pt"&gt;
						&lt;span style="mso-spacerun: yes"/&gt;
						&lt;o:p/&gt;
					&lt;/span&gt;
				&lt;/b&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;b style="mso-bidi-font-weight: normal"&gt;
					&lt;span style="FONT-SIZE: 11pt"/&gt;
				&lt;/b&gt; &lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;font size="3"&gt;
					&lt;b style="mso-bidi-font-weight: normal"&gt;
						&lt;span style="FONT-SIZE: 11pt"&gt;Врач:&lt;/span&gt;
					&lt;/b&gt; &lt;/font&gt;
				&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
		&lt;/div&gt;
	&lt;/body&gt;

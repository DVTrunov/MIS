			<Description>19. УЗИ шейки матки</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 0.164cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;УЗИ шейки матки (трансвагинальное)&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата проведения осмотра: 
					&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;, аппарат: 
				&lt;a id="c6a17208-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Пациент: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;, дата рождения: 
				&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Дата начала последних менструаций: 
				&lt;a id="a7b3906b-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;    
				&lt;a id="0aa2e844-8b98-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; день цикла.&lt;/div&gt;
			&lt;div class="FORMAT"&gt;  &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Длина шейки матки: 
				&lt;input id="5e11a0e3-ca6b-11e1-bd7f-906f442be8ad" style="overflow: auto; width: 73px; height: 22px;" rows="0" cols="0"/&gt; мм (норма: более 40 мм); &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;div class="FORMAT" align="left"&gt;Внутренний зев 
					&lt;select id="dd554392-e942-11e2-9029-d43d7e553e20"&gt;
						&lt;option selected="selected" value="{&amp;quot;S&amp;quot;,&amp;quot;закрыт&amp;quot;}"&gt;закрыт&lt;/option&gt;
						&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;открыт&amp;quot;}"&gt;открыт&lt;/option&gt;
					&lt;/select&gt; 
					&lt;a id="78f2f42b-04a1-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; мм.&lt;/div&gt;
				&lt;div class="FORMAT" align="left"&gt; &lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Заключение: &lt;/strong&gt;
				&lt;a id="78f2f42c-04a1-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Врач: 
					&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

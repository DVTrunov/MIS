			<Description>26. Бактериологическое исследование</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;Направление в бактериологическую лабораторию&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt; 
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, дата рождения: 
					&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, пол: 
					&lt;a id="d196e985-a7f6-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;
						&lt;strong&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/strong&gt;
					&lt;/tt&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Дата 
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; час
				&lt;select id="c7a34d9b-e2f7-11e2-abc6-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;N&amp;quot;,1}"&gt;1&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,2}"&gt;2&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,3}"&gt;3&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,4}"&gt;4&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,5}"&gt;5&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,6}"&gt;6&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,7}"&gt;7&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,8}"&gt;8&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,9}"&gt;9&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,10}"&gt;10&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,11}"&gt;11&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,12}"&gt;12&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,13}"&gt;13&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,14}"&gt;14&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,15}"&gt;15&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,16}"&gt;16&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,17}"&gt;17&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,18}"&gt;18&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,19}"&gt;19&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,20}"&gt;20&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,21}"&gt;21&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,22}"&gt;22&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,23}"&gt;23&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,24}"&gt;24&lt;/option&gt;
				&lt;/select&gt; минут 
				&lt;input id="d196e9a4-a7f6-11e2-93e2-d43d7e553e20" style="overflow: auto; width: 31px; height: 22px;" rows="0" cols="0"/&gt; взятия материала&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Характеристика материала:  
				&lt;select id="d196e9a5-a7f6-11e2-93e2-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9a8}"&gt;аспират&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9ae}"&gt;желчь&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9a9}"&gt;кал&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9ad}"&gt;кровь&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9ab}"&gt;ликвор&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9a6}"&gt;мазок&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9ac}"&gt;мокрота&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9a7}"&gt;моча&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9aa}"&gt;пунктат&lt;/option&gt;
				&lt;/select&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Анатомическая область 
				&lt;a id="d196e9af-a7f6-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Требуемое исследование: 
				&lt;select id="d196e9b0-a7f6-11e2-93e2-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9b1}"&gt;микроскопия&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9b2}"&gt;культурные св-ва антибиотикограмма&lt;/option&gt;
				&lt;/select&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Забор материала сделан
				&lt;select id="d196e9b3-a7f6-11e2-93e2-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9b4}"&gt;до&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a7f6d196e9b5}"&gt;после&lt;/option&gt;
				&lt;/select&gt;  назначения и приема антибиотика&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Название антибиотика при его приеме 
				&lt;a id="d196e9b6-a7f6-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;span lang="RU"&gt;
					&lt;span lang="RU"/&gt;
				&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Леч. врач 
				&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;hr/&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;Результат бактериологического исследования&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;span lang="RU"&gt;Результат: 
					&lt;a id="a4ae8339-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;span lang="RU"&gt;
					&lt;a id="d196e9bd-a7f6-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;span lang="RU"&gt;Врач-бактериолог: 
					&lt;a id="4af7a3e5-bfae-11e3-8fa2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;div class="FORMAT"&gt;Дата выдачи ответа 
						&lt;a id="d01bc7dd-5ca5-11e3-8fdb-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;
				&lt;/div&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;

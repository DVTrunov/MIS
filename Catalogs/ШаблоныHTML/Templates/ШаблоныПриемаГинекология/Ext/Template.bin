			<Description>17. УЗИ в первом триместре беременности (с эмбрионом)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 21cm; line-height: 1.5;"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;УЗИ в первом триместре беременности&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Д&lt;/strong&gt;
				&lt;strong&gt;ата проведения осмотра: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;, аппарат: 
				&lt;a id="c6a17208-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Пациент: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;, дата рождения: 
				&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Дата начала последних менструаций: 
				&lt;a id="a7b3906b-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;     &lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Матка 
				&lt;a id="815d81b9-ca64-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;В полости матки плодное яйцо с эмбрионом. 
				&lt;a id="a7b3907e-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Контуры  
				&lt;a id="904f7cd1-108f-11e3-b820-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Срок по менструации: 
				&lt;input id="57b4af0a-be1f-11e3-8fa2-d43d7e553e20" style="overflow: auto; width: 52px; height: 22px;" rows="0" cols="0"/&gt; недель 
				&lt;input id="8263c72c-3c6b-11e3-9e1f-d43d7e553e20" style="overflow: auto; width: 66px; height: 22px;" rows="0" cols="0"/&gt; дн.&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Срок по УЗИ: 
				&lt;input id="44677780-4058-11e3-9e1f-d43d7e553e20" style="overflow: auto; width: 54px; height: 22px;" rows="0" cols="0"/&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;СВД: 
				&lt;input id="c6a1721b-2c73-11e2-9496-1803736d59cd" style="overflow: auto; height: 22px; width: 71px;" rows="0" cols="0"/&gt; мм - 
				&lt;input id="c6a1721c-2c73-11e2-9496-1803736d59cd" style="overflow: auto; height: 22px; width: 56px;" rows="0" cols="0"/&gt; недель 
				&lt;input id="8263c72d-3c6b-11e3-9e1f-d43d7e553e20" style="overflow: auto; height: 22px; width: 56px;" rows="0" cols="0"/&gt; дн.&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;КТР: 
				&lt;input id="c6a1720d-2c73-11e2-9496-1803736d59cd" style="overflow: auto; width: 74px; height: 22px;" rows="0" cols="0"/&gt; мм - 
				&lt;input id="c6a1720e-2c73-11e2-9496-1803736d59cd" style="overflow: auto; height: 22px; width: 56px;" rows="0" cols="0"/&gt; недель 
				&lt;input id="8263c72e-3c6b-11e3-9e1f-d43d7e553e20" style="overflow: auto; height: 22px; width: 56px;" rows="0" cols="0"/&gt; дн.&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Сердцебиение: 
				&lt;select id="c6a1720f-2c73-11e2-9496-1803736d59cd"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a17210}"&gt;определяется&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a17211}"&gt;не определяется&lt;/option&gt;
				&lt;/select&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Желточный мешок: 
				&lt;input id="c6a17212-2c73-11e2-9496-1803736d59cd" style="overflow: auto; width: 97px; height: 22px;" rows="0" cols="0"/&gt; мм.&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Хорион: 
				&lt;a id="8263c72f-3c6b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, толщина: 
				&lt;input id="c6a1721a-2c73-11e2-9496-1803736d59cd" style="overflow: auto; width: 75px; height: 22px;" rows="0" cols="0"/&gt; мм.&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Длина шейки матки: 
				&lt;input id="bf87a728-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; width: 88px; height: 22px;" rows="0" cols="0"/&gt; мм, внутренний зев 
				&lt;a id="dd554392-e942-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Стойкий локальный гипертонус на момент осмотра 
				&lt;select id="8263c725-3c6b-11e3-9e1f-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9e1fd43d7e553e2011e33c6b8263c726}"&gt;определяется&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9e1fd43d7e553e2011e33c6b8263c727}"&gt;не определяется&lt;/option&gt;
				&lt;/select&gt; 
				&lt;a id="821bbb90-91dc-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Патологические объемные образования в проекции придатков матки: 
				&lt;select id="c6a1721d-2c73-11e2-9496-1803736d59cd"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a1721f}"&gt;не выявлены&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a17220}"&gt;выявлены&lt;/option&gt;
				&lt;/select&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;a id="c6a17221-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Заключение: 
					&lt;a id="c6a17222-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Рекомендации: &lt;/strong&gt;
				&lt;a id="821bbb7d-91dc-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong/&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;
					&lt;br/&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Врач: &lt;/strong&gt;
				&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong/&gt;
			&lt;/div&gt;
		&lt;/div&gt;
		&lt;div/&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

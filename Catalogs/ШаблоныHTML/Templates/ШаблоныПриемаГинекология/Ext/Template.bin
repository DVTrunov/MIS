			<Description>67_5. Диагностика ВИЧ (отдельно)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 7.597cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;Н А П Р А В Л Е Н И Е&lt;/strong&gt;
			&lt;/div&gt;
			&lt;p&gt;                                                      
				&lt;strong&gt;в лабораторию для диагностики ВИЧ-инфекции.
					&lt;br/&gt;
				&lt;/strong&gt;
			&lt;/p&gt;
			&lt;br/&gt;Ф.И.О. 
			&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;

			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Гемотрансфузионный анамнез: &lt;/strong&gt;
				&lt;a id="35f6f513-6270-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;

							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;
								&lt;p&gt;12,4-78,4 нМ/л&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Эстрадиол&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e020-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 11-71 пг/мл &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ХГЧ&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e027-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;не более 10 МЕ/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; АФП&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e028-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;не более 16 МЕ/л&lt;/td&gt;

			<Description>13. Кольпоскопия шейки матки.</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Протокол кольпоскопии&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;
				&lt;strong&gt;. Пациент: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;
				&lt;strong&gt;, возраст: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="afb41360-0837-11e5-b1b3-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt; 
				&lt;div class="FORMAT" align="left"&gt;Последняя менструация с 
					&lt;a id="a7b3906b-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; по 
					&lt;a id="a7b3906c-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
				&lt;div class="FORMAT" align="left"&gt;
					&lt;strong&gt;Жалобы: &lt;/strong&gt;
					&lt;a id="83017dcb-6e6a-11e1-9f34-e9a901c6eef1" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Вредные привычки: 
				&lt;a id="783c14a3-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; прием препаратов: 
				&lt;a id="783c14ad-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; ИППП в анамнезе: 
				&lt;a id="821bbb74-91dc-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;патология ШМ в анамнезе: 
				&lt;a id="783c14b6-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; обследование в анамнезе: 
				&lt;a id="783c14ba-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; контрацепция: 
				&lt;a id="a7b39069-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;лечение ШМ: 
				&lt;a id="783c14c4-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;половая жизнь с: 
				&lt;a id="a7b39065-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; лет; беременностей всего: 
				&lt;a id="0aa2e83a-8b98-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; роды: 
				&lt;a id="6339a999-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; аборты: 
				&lt;a id="6339a99b-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; выкидыши: 
				&lt;a id="6339a99c-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Описание кольпоскопии&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;шейка матки:&lt;/strong&gt; 
				&lt;a id="815d81b8-ca64-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;a id="7ce99a22-d9f9-11e1-81fd-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;кольпоскопия:&lt;/strong&gt; 
				&lt;a id="783c14cc-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; 
				&lt;strong&gt;стык:&lt;/strong&gt; 
				&lt;a id="783c14cf-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;открытые железы (ОЖ):&lt;/strong&gt; 
				&lt;input id="783c14d2-8bc9-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="783c14d3-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;ретенционные кисты (ЗЖ):&lt;/strong&gt; 
				&lt;input id="783c14d6-8bc9-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="783c14d7-8bc9-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;сосуды (С, АС):&lt;/strong&gt; 
				&lt;input id="783c14da-8bc9-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="6339a95f-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;кератоз (К) - лейкоплакия (Л):&lt;/strong&gt; 
				&lt;input id="6339a963-8c5e-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="6339a964-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;мозаика (М):&lt;/strong&gt; 
				&lt;input id="6339a967-8c5e-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="6339a968-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;пунктация (П):&lt;/strong&gt; 
				&lt;input id="6339a96b-8c5e-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="6339a96c-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;ацетобелый эпителий (АБЭ):&lt;/strong&gt; 
				&lt;input id="6339a96f-8c5e-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="6339a970-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;эктопия (Эк):&lt;/strong&gt; 
				&lt;input id="6339a973-8c5e-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="6339a974-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;границы аномального эпителия:&lt;/strong&gt; 
				&lt;input id="6339a977-8c5e-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="6339a978-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;йод-негативная зона (ЙНЗ):&lt;/strong&gt; 
				&lt;input id="6339a984-8c5e-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt; 
				&lt;a id="6339a97c-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;эндометриоз:&lt;/strong&gt; 
				&lt;input id="6339a97b-8c5e-11e2-a02c-1803736d59cd" type="checkbox" value="Ложь"/&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Диагноз кольпоскопический: &lt;/strong&gt;
				&lt;a id="6339a981-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/tt&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Рекомендации: &lt;/strong&gt;
				&lt;a id="6339a983-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;Врач: 
					&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

			<Code>000000085</Code>
			<Description>51_11. Исследование методом ИФА. Кровь на гормоны Ж</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 26.569cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Гормональное исследование крови женщины&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;Дата: 
				&lt;a id="d8fb4cff-ca61-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;Пациент: 
				&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;Диагноз: 
				&lt;a id="6339a99d-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;table width="100%" border="3"&gt;
					&lt;tbody&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ТТГ&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e018-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;0,23-3,4 мМЕ/мл&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr/&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Т3&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e019-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;1,0-2,8 нмоль/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Т3своб.&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="c06df5a2-2cf2-11e4-8730-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;2,5-7,5 нмоль/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Т4своб.&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e01a-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;10,0-23,2 пмоль/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ФСГ&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e01b-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;            I ф:             1,8-11,3 мМЕ/л 
								&lt;br/&gt;           II ф:             1,1-9,5 мМЕ/л 
								&lt;br/&gt;Середина цикла:  5,8-2,1 мМЕ/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ЛГ&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e01c-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;            I ф:              1,1-8,7 мМЕ/л 
								&lt;br/&gt;           II ф:              0,9-14,4 мМЕ/л 
								&lt;br/&gt;Середина цикла:   17-77 мМЕ/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Пролактин&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e01d-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;40-530 мМЕ/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Прогестерон&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e01e-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;            I ф:              0,0-6,0 нМ/л 
								&lt;br/&gt;           II ф:              10,0-89 нМ/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Тестостерон&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e01f-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;0,5-4,3 нМ/л &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Эстрадиол&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e020-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;            I ф:              30-120 нг/мл 
								&lt;br/&gt;           II ф:              70-250 нг/мл&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ХГЧел&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e027-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Не более 10 МЕ/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; АФП&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e028-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; АКТГ&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e029-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 7,2-63,3 пг/мл&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ДЭА&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e021-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;
								&lt;p&gt;Женщины:            0,8-3,9 мг/мл
									&lt;br/&gt;Беременные:         0,2-1,2 мг/мл
									&lt;br/&gt;Постменопауза:    0,1-0,6 мг/мл&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Кортизол&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e022-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;150-660 (378 - среднее знач.) нМ/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Свободный эстриол&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e026-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; РАРР - А&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="b5b9e025-a7e0-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;мМЕ/мл &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; аТГ&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="34f3028f-d44e-11e4-9df9-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;менее 65 ЕД/мл &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; Инсулин&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="69bd0d41-13e5-11e5-bb44-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;
								&lt;p&gt;0,7-9,0 мкМЕ/мл;                           дети до 12 лет &amp;lt;10 мкМЕ/мл;   диабетики II гр. 0,7-25 мкМЕ/мл&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; аТПО&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="34f30290-d44e-11e4-9df9-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;менее 30 ЕД/мл &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; ГСПГ&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="5e532c49-5ff3-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;14,1-129 нМоль/л&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; АМГ&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="78adf85a-73bb-11e5-b8e1-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;
								&lt;p&gt; девочки - до 8,9 нг/мл
									&lt;br/&gt; женщины - до 12,6 нг/мл&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 17-ОП&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
								&lt;a id="e3ce7f95-cce7-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;              I ф:            0,3-2,06 нМ/л
								&lt;br/&gt;             II ф:            1,42-6,91 нМ/л&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/tbody&gt;
				&lt;/table&gt;
			&lt;/div&gt;
			&lt;p&gt;Врач: 
				&lt;a id="4af7a3e5-bfae-11e3-8fa2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
		&lt;/div&gt;
	&lt;/body&gt;

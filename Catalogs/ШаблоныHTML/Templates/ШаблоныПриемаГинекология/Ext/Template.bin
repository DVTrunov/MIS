			<Code>000000114</Code>
			<Description>56_1. Анализ выделений</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 9.014cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Анализ выделений &lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;p&gt;Пациент: 
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;    
				&lt;br/&gt;Дата:
				&lt;a id="d8fb4cff-ca61-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p/&gt;
			&lt;table style="HEIGHT: 202px; WIDTH: 668px" width="668" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt; Гонококки Нейсера&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="75%"&gt; 
							&lt;a id="744a08a0-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt; Лейкоциты&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="75%"&gt; 
							&lt;a id="744a08a1-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt; Диплококки&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="75%"&gt; 
							&lt;a id="744a08a2-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt; Клетки эпит.&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="75%"&gt; 
							&lt;a id="744a08a3-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt; Флора&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="75%"&gt; 
							&lt;a id="744a08a4-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;a id="3860785e-d7f9-11e2-a6f6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt; Слизь&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="75%"&gt; 
							&lt;a id="744a08a5-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt; Степень чистоты&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="75%"&gt; 
							&lt;a id="744a08a6-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="25%"&gt; Трихомонады&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="75%"&gt; 
							&lt;a id="744a08a7-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
			&lt;p&gt; &lt;/p&gt;
			&lt;p&gt;Врач 
				&lt;a id="4af7a3e5-bfae-11e3-8fa2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;

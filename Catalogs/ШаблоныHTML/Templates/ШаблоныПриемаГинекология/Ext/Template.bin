	<Шаблон>
		<CatalogObject.ШаблоныHTML>
			<Ref>4bacb60d-a8e4-11e2-93e2-d43d7e553e20</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>5439321d-f70c-11e5-91be-1078d2d69bb4</Parent>
			<Code>000000089</Code>
			<Description>53_8. Исследование методом ПЦР на флороценоз</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 16.487cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Анализ на флороценоз методом ПЦР&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;Дата: 
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;p&gt;Пациент: 
				&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p&gt;Материал из 
				&lt;a id="4bacb60f-a8e4-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p&gt;Количество Gardnerella vaginalis 
				&lt;a id="4bacb60a-a8e4-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p&gt;Количество Atopobium vaginae 
				&lt;a id="4bacb60b-a8e4-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p&gt;Количество Lactobacillus spp. 
				&lt;a id="4bacb60c-a8e4-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p&gt;Общее количество бактерий — 
				&lt;a id="4bacb610-a8e4-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p&gt;Заключение: 
				&lt;select id="4bacb611-a8e4-11e2-93e2-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a8e44bacb615}"&gt;ДИСБИОЗ АНАЭРОБНЫЙ&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a8e44bacb614}"&gt;ДИСБИОЗ НЕЯСНОГО ГЕНЕЗА&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a8e44bacb613}"&gt;МЕЗОЦЕНОЗ&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:93e2d43d7e553e2011e2a8e44bacb612}"&gt;НОРМОЦЕНОЗ&lt;/option&gt;
				&lt;/select&gt;
			&lt;/p&gt;
			&lt;p&gt;Врач: 
				&lt;a id="4af7a3e5-bfae-11e3-8fa2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; &lt;/p&gt;
			&lt;p&gt;
				&lt;strong&gt;расшифровка:&lt;/strong&gt;
			&lt;/p&gt;
			&lt;p&gt;
				&lt;font size="2"&gt;
					&lt;strong&gt;НОРМОЦЕНОЗ&lt;/strong&gt; - количество &lt;/font&gt;Lactobacillus соответствует количеству Bacteria, Gardnerella и/или Atopobium отсутствуют или значительно ниже Lactobacillus&lt;/p&gt;
			&lt;p&gt;
				&lt;font size="2"&gt;
					&lt;strong&gt;МЕЗОЦЕНОЗ&lt;/strong&gt; - количество &lt;/font&gt;Lactobacillus ниже или соответствует количеству Bacteria, количество Gardnerella и /или Atopobium выше количества Lactobacillus&lt;/p&gt;
			&lt;p&gt;
				&lt;font size="2"&gt;
					&lt;strong&gt;ДИСБИОЗ НЕЯСНОГО ГЕНЕЗА&lt;/strong&gt; - количество &lt;/font&gt;Lactobacillus ниже количества Bacteria, количество Gardnerella/Atopobium отсутствуют или значительно ниже Lactobacillus&lt;/p&gt;
			&lt;p&gt;
				&lt;font size="2"&gt;
					&lt;strong&gt;ДИСБИОЗ АНАЭРОБНЫЙ&lt;/strong&gt; - количество &lt;/font&gt;Lactobacillus значительно ниже количества Bacteria, количество Gardnerella и/или Atopobium значительно выше Lactobacillus &lt;/p&gt;
		&lt;/div&gt;
		&lt;div/&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>
			<ВидШаблона>HTMLШаблон</ВидШаблона>

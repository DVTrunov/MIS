			<Parent>5439321d-f70c-11e5-91be-1078d2d69bb4</Parent>
			<Code>000000120</Code>
			<Description>58_2. Общий анализ эякулята</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 20.513cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Общий анализ эякулята&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;Ф.И.О.: 
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt; Возраст: 
				&lt;a id="9a640545-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;p/&gt;
			&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Дата&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Значения нормы&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Воздержание (дней)&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661262b-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 2-7&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Объем эякулята&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661262c-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 2 мл и более&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Цвет и консистенция&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661262d-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;a id="f661262e-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; нормальные&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; рН&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661262f-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 7,2-8,0&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Концентрация "круглых клеток"&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612630-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; -&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Концентрация лейкоцитов&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612631-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; менее 1 млн/мл&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Концентрация сперматозоидов&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612632-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;15 млн/мл и более&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; 
							&lt;strong&gt;Подвижность:&lt;/strong&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; А) Быстрые прогрессивные&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612633-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 50% и более&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Б) медленные прогрессивные&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612634-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; категории(А+Б)&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; В) не прогрессивно подвижные&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612635-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; или 25% и более&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Г) не подвижные&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612636-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; категории (А)&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Живые формы (% живых)&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612637-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 75% и более&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Морфология (% нормальных)&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612638-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 14% и более&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Тест на антитела (MAR Yg G)&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612639-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; менее 50%&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Агглютинация сперматозоидов&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661263a-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Отсутствует&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; 
							&lt;strong&gt;Заключение:&lt;/strong&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Нормальный эякулят&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661263b-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Связанные антителами сперматозоиды&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661263c-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Норм. с агглютинацией или патологией семенной жидкости&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661263d-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Тератозооспермия&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661263e-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Астенозооспермия&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f661263f-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Олигозооспермия&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612640-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Криптозооспермия&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612641-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Азоспермия&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612642-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="60%"&gt; Аспермия&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 
							&lt;a id="f6612643-d4cd-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;

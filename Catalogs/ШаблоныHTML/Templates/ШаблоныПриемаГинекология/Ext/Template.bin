							&lt;td style="WORD-WRAP: break-word" width="33%"&gt;12,1-38,3 нМ/л &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="WORD-WRAP: break-word" width="33%"&gt; СССГ&lt;/td&gt;

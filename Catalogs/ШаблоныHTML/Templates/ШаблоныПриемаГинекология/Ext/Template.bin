					&lt;/tt&gt; &lt;/div&gt;
				&lt;div class="FORMAT" dir="ltr"&gt; &lt;/div&gt;
				&lt;div class="FORMAT" dir="ltr"&gt;
					&lt;strong&gt;Назначение: &lt;/strong&gt;
					&lt;a id="c3a396a1-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong/&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Врач:&lt;/strong&gt; 

							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="02298095-ce74-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="52499273-fb72-11e3-9026-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
			&lt;p&gt; &lt;/p&gt;
			&lt;p&gt;Дата: 
				&lt;a id="d8fb4cff-ca61-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;         Врач: 
				&lt;a id="4af7a3e5-bfae-11e3-8fa2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
		&lt;/div&gt;

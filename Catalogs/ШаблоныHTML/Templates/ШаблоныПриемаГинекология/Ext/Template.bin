			<Description>25. Эхокардиоскопия.</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 24.907cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Эхокардиоскопия&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Дата проведения осмотра: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, дата рождения: 
					&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;span lang="RU"&gt;
					&lt;font size="4"&gt;
						&lt;font size="4"/&gt;
					&lt;/font&gt;
				&lt;/span&gt;
			&lt;/div&gt;
			&lt;p style="MARGIN-RIGHT: 0px" dir="ltr"&gt;
				&lt;font size="3"&gt;Стенки аорты &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a5710-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;. Диаметр клапанного кольца &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a5711-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;. &lt;/font&gt;
				&lt;font size="3"&gt;Восходящий отдел &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a5712-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;. Нисходящий отдел &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a5713-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;. &lt;/font&gt;
				&lt;font size="3"&gt;Створки аортального&lt;/font&gt;
				&lt;span lang="EN"&gt; &lt;/span&gt;
				&lt;span lang="RU"&gt;клапана 
					&lt;a id="1c8a5714-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;. Р&lt;/span&gt;
				&lt;font size="4"&gt;
					&lt;font size="4"&gt;
						&lt;span lang="RU"&gt;
							&lt;font size="3"&gt;аскрытие створок &lt;/font&gt;
							&lt;font size="3"&gt;
								&lt;a id="1c8a5715-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/font&gt;
						&lt;/span&gt;
					&lt;/font&gt;
				&lt;/font&gt;
			&lt;/p&gt;
			&lt;p style="MARGIN-RIGHT: 0px" dir="ltr"&gt;
				&lt;font size="3"&gt;
					&lt;strong&gt;Левое предсердие:&lt;/strong&gt; &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a5716-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/p&gt;
			&lt;p style="MARGIN-RIGHT: 0px" dir="ltr"&gt;
				&lt;font size="3"&gt;
					&lt;strong&gt;Левый желудочек:&lt;/strong&gt; КДР &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a5717-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, &lt;/font&gt;
				&lt;font size="3"&gt;КСР &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a5718-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, ТЗСЛЖ &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a5719-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, &lt;/font&gt;
				&lt;font size="3"&gt;ТМЖП &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1c8a571a-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, &lt;/font&gt;

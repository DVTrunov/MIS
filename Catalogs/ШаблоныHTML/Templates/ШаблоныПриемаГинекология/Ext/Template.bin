			<Description>28. Пробная обработка эякулята</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;Пробная обработка эякулята&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата проведения осмотра: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt; 
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, дата рождения: 
					&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;p class="FORMAT"&gt;Лечащий врач 
				&lt;font face="Arial"&gt;
					&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt; &lt;/p&gt;
			&lt;table dir="ltr" cellspacing="1" width="751" border="1"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td bgcolor="#ffffff" height="24" valign="top" width="44%"&gt;
							&lt;span lang="RU"&gt;
								&lt;p&gt;Продолжительность воздержания (дней)&lt;/p&gt;
							&lt;/span&gt;
						&lt;/td&gt;
						&lt;td bgcolor="#ffffff" height="24" valign="top" width="56%" colspan="2"&gt;
							&lt;textarea id="b5b9e041-a7e0-11e2-93e2-d43d7e553e20" style="OVERFLOW: auto" rows="1"/&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td bgcolor="#ffffff" height="23" valign="top" width="44%"&gt;
							&lt;span lang="RU"&gt;
								&lt;p&gt;Объем эякулята (мл)&lt;/p&gt;
							&lt;/span&gt;
						&lt;/td&gt;
						&lt;td bgcolor="#ffffff" height="23" valign="top" width="27%"&gt;
							&lt;p&gt;
								&lt;textarea id="b5b9e042-a7e0-11e2-93e2-d43d7e553e20" style="OVERFLOW: auto" rows="1"/&gt; &lt;/p&gt;
						&lt;/td&gt;
						&lt;td bgcolor="#ffffff" height="23" valign="top" width="29%"&gt;
							&lt;p&gt;
								&lt;textarea id="b5b9e043-a7e0-11e2-93e2-d43d7e553e20" style="OVERFLOW: auto" rows="1"/&gt; &lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td bgcolor="#ffffff" height="19" valign="top" width="44%"&gt;
							&lt;p/&gt;
						&lt;/td&gt;
						&lt;td bgcolor="#ffffff" height="19" valign="top" width="27%"&gt;
							&lt;b&gt;
								&lt;span lang="RU"&gt;
									&lt;p&gt;                 Нативный&lt;/p&gt;
								&lt;/span&gt;
							&lt;/b&gt;
						&lt;/td&gt;
						&lt;td bgcolor="#ffffff" height="19" valign="top" width="29%"&gt;
							&lt;b&gt;
								&lt;span lang="RU"&gt;

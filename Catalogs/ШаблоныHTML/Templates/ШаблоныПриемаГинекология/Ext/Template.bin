			<Parent>5439321d-f70c-11e5-91be-1078d2d69bb4</Parent>
			<Code>000000084</Code>
			<Description>14. Соногидрогистеросальпингоскопия</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 13.288cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;font size="2"&gt;
					&lt;strong&gt;Дата: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;
					&lt;strong&gt;. Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;
					&lt;strong&gt;, возраст: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="afb41360-0837-11e5-b1b3-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;font size="2"&gt;
					&lt;strong&gt;Жалобы:&lt;/strong&gt;  &lt;/font&gt;
				&lt;font size="2"&gt;
					&lt;a id="83017dcb-6e6a-11e1-9f34-e9a901c6eef1" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;font size="2"&gt;Последняя менструация с &lt;/font&gt;
				&lt;font size="2"&gt;
					&lt;a id="a7b3906b-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="2"&gt; по &lt;/font&gt;
				&lt;font size="2"&gt;
					&lt;a id="a7b3906c-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="2"&gt;. &lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;font size="2"&gt;
					&lt;strong&gt;Объективный статус:&lt;/strong&gt; &lt;/font&gt;
				&lt;div class="FORMAT" align="left"&gt;
					&lt;div class="FORMAT"&gt;
						&lt;font size="2"&gt;АД на правой руке: &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="41abbabf-d249-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt; / &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="21632636-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt; мм рт.ст.; АД на левой руке: &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="c075f5a5-eebb-11e2-b68c-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt; / &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="c075f5a6-eebb-11e2-b68c-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt; мм рт.ст.&lt;/font&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;font size="2"&gt;Температура тела &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="c3a39698-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt;.&lt;/font&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;font size="2"&gt;Состояние &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="55e30361-d23e-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt;. Кожные покровы и видимые слизистые оболочки &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="a7b39070-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt;. Периферические лимфатические узлы &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="c3a39697-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt;. Молочные железы &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="c3a3969c-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt;. Живот &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="c3a3969e-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt;.  Физиологические отправления &lt;/font&gt;
						&lt;font size="2"&gt;
							&lt;a id="815d81b2-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b2-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
						&lt;/font&gt;
						&lt;font size="2"&gt;. &lt;/font&gt;
					&lt;/div&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;div class="FORMAT" align="left"&gt;
					&lt;font size="2"&gt;
						&lt;strong&gt;Status genitalis:&lt;/strong&gt; &lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT" align="left"&gt;
					&lt;font size="2"&gt;Ано-генитальная область &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81b3-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b3-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. Паховые лимфоузлы &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="815d81b4-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b4-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
					&lt;font size="2"&gt;. &lt;/font&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT" align="left"&gt;
					&lt;font size="2"&gt;УЗИ: &lt;/font&gt;
					&lt;font size="2"&gt;
						&lt;a id="e2186fc6-e304-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/font&gt;
				&lt;/div&gt;
				&lt;div/&gt;
				&lt;p class="FORMAT" align="center"&gt;
					&lt;b&gt;Операция: соногидрогистеросальпингоскопия&lt;/b&gt;
				&lt;/p&gt;
				&lt;p class="FORMAT" align="left"&gt;
					&lt;b&gt;Премедикация: 
						&lt;a id="b011ed35-f184-11e5-87d5-201a06d0f905" href="about:"&gt;[...]&lt;/a&gt;. &lt;/b&gt;
				&lt;/p&gt;
				&lt;p class="FORMAT" align="left"&gt;В асептических условиях шейка матки обнажена в зеркалах. Наконечником Брауна в полость матки введено 
					&lt;a id="be35187a-a752-11e2-90c8-bb602a0e91c9" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
				&lt;p class="FORMAT" align="left"&gt;Осложнения: 
					&lt;a id="b011ed36-f184-11e5-87d5-201a06d0f905" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
				&lt;p class="FORMAT" align="left"&gt;
					&lt;b&gt;Заключение: 

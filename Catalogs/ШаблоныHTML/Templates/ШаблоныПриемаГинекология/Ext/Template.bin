			<Code>000000088</Code>
			<Description>27. Кровь на исследование резус - фактора</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 8.425cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;В РЕЗУС - ЛАБОРАТОРИЮ&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="center"&gt;н
				&lt;span lang="RU"&gt;
					&lt;font size="3"&gt;
						&lt;b&gt;аправляется кровь на исследование резус - фактора&lt;/b&gt;
					&lt;/font&gt;
				&lt;/span&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt; 
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, дата рождения: 
					&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, пол: 
					&lt;a id="d196e985-a7f6-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;
						&lt;strong&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/strong&gt;
					&lt;/tt&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Показание к исследованию 
				&lt;a id="b05ca540-2ac6-11e5-bbab-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;a id="1c8a573f-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Трансфузионный анамнез&lt;/strong&gt; (были ли переливания крови, реакции или осложнения после переливаний): 
				&lt;a id="ac5e9710-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Акушерский анамнез&lt;/strong&gt; (беременности, аборты, выкидыши, преждевременные роды, мертворождения,&lt;/div&gt;
			&lt;div class="FORMAT"&gt;рождение детей с врожденной гемолитической болезнью и т.д.): 
				&lt;a id="9a640548-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата и время взятия крови:&lt;/strong&gt; 
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;    
				&lt;input id="1c8a5743-a8b1-11e2-93e2-d43d7e553e20" style="overflow: auto; width: 44px; height: 22px;" rows="0" cols="0"/&gt;:
				&lt;input id="1c8a5744-a8b1-11e2-93e2-d43d7e553e20" style="overflow: auto; width: 43px; height: 22px;" rows="0" cols="0"/&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Группа крови и резус-принадлежность &lt;/strong&gt;(указать, когда проводилось определение резус-фактора): 
				&lt;a id="1c8a5745-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Врач: &lt;/strong&gt;
				&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;hr/&gt;
				&lt;strong&gt;Дата: &lt;/strong&gt;
				&lt;strong&gt;
					&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt; 
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Группа крови:&lt;/strong&gt; 
					&lt;a id="744a089c-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
					&lt;a id="ef64f42b-d261-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Резус фактор:&lt;/strong&gt; 
					&lt;a id="744a089d-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Антитела:&lt;/strong&gt; 
					&lt;a id="744a089e-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
					&lt;a id="ef64f422-d261-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;

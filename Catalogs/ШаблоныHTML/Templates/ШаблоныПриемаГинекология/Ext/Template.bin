			<Description>07. Осмотр гинеколога повторный.</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;Повторный осмотр гинеколога&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата: &lt;/strong&gt;
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Пациент&lt;/strong&gt;: 
					&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;; 
					&lt;strong&gt;возраст&lt;/strong&gt;: 
					&lt;a id="afb41360-0837-11e5-b1b3-c46e1f050a55" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Жалобы:&lt;/strong&gt;  
				&lt;a id="83017dcb-6e6a-11e1-9f34-e9a901c6eef1" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;Последняя менструация с 
				&lt;a id="a7b3906b-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; по 
				&lt;a id="a7b3906c-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;. Контрацепция: 
				&lt;a id="aa75952b-cb0b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Объективный статус:&lt;/strong&gt; 
				&lt;div class="FORMAT" align="left"&gt;
					&lt;div class="FORMAT"&gt;Состояние 
						&lt;a id="55e30361-d23e-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;div class="FORMAT" align="left"&gt;
							&lt;div class="FORMAT" align="left"&gt;
								&lt;div class="FORMAT"&gt;
									&lt;div class="FORMAT" align="left"&gt;
										&lt;div class="FORMAT" align="left"&gt;
											&lt;div class="FORMAT"&gt;
												&lt;div class="FORMAT"&gt;АД на правой руке: 
													&lt;textarea id="21632636-d7c9-11e1-bab2-1803736d59cd" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 56px" rows="1" cols="1"/&gt; / 
													&lt;textarea id="41abbabf-d249-11e1-b361-1803736d59cd" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 57px" rows="1" cols="1"/&gt; мм рт.ст.;&lt;/div&gt;
												&lt;div class="FORMAT"&gt;АД на левой руке: 
													&lt;textarea id="c075f5a5-eebb-11e2-b68c-d43d7e553e20" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 65px" rows="1" cols="1"/&gt; / 
													&lt;textarea id="c075f5a6-eebb-11e2-b68c-d43d7e553e20" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 57px" rows="1" cols="1"/&gt; мм рт.ст.;&lt;/div&gt;Температура тела 
												&lt;textarea id="c3a39698-07a5-11e2-824b-00242cd5bb52" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 67px" rows="1" cols="1"/&gt; ЧД 
												&lt;textarea id="c3a39699-07a5-11e2-824b-00242cd5bb52" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 56px" rows="1" cols="1"/&gt; в мин. Пульс: 
												&lt;textarea id="c3a3969a-07a5-11e2-824b-00242cd5bb52" style="OVERFLOW: auto; HEIGHT: 22px; WIDTH: 84px" rows="1" cols="1"/&gt;;&lt;/div&gt;
										&lt;/div&gt;
									&lt;/div&gt;
									&lt;div class="FORMAT" align="left"&gt;Рост: 
										&lt;input id="20d44e39-0794-11e2-824b-00242cd5bb52" style="overflow: auto; width: 62px; height: 22px;" rows="0" cols="0"/&gt; см; Масса тела: 
										&lt;input id="8263c70d-3c6b-11e3-9e1f-d43d7e553e20" style="overflow: auto; width: 71px; height: 22px;" rows="0" cols="0"/&gt; кг; ИМТ: 
										&lt;a id="20d44e3b-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;.  &lt;/div&gt;
								&lt;/div&gt;
							&lt;/div&gt;
						&lt;/div&gt;
						&lt;div class="FORMAT" align="left"&gt;Кожные покровы и видимые слизистые оболочки 
							&lt;a id="a7b39070-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
					&lt;/div&gt;
					&lt;div class="FORMAT"&gt;Периферические лимфатические узлы 
						&lt;a id="c3a39697-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;.&lt;/div&gt;
					&lt;div class="FORMAT"&gt;Молочные железы 
						&lt;a id="c3a3969c-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;.Живот 
						&lt;a id="c3a3969e-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;.  &lt;/div&gt;
					&lt;div class="FORMAT"&gt;Физиологические отправления 
						&lt;a id="815d81b2-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b2-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;strong&gt;
							&lt;u/&gt;
						&lt;/strong&gt; &lt;/div&gt;
					&lt;div class="FORMAT"&gt;
						&lt;strong&gt;Status genitalis:&lt;/strong&gt; &lt;/div&gt;
					&lt;div class="FORMAT"&gt;Ано-генитальная область 
						&lt;a id="815d81b3-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b3-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. Паховые лимфоузлы 
						&lt;a id="815d81b4-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b4-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
					&lt;div class="FORMAT"&gt;Наружные половые органы 
						&lt;a id="815d81b5-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b5-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. Оволосенение 
						&lt;a id="815d81b6-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b6-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
					&lt;div class="FORMAT"&gt;Влагалище 
						&lt;a id="815d81b7-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b7-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;, слизистая 
						&lt;a id="815d81ce-ca64-11e1-bd7f-906f442be8ad" href="about:815d81ce-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
					&lt;div class="FORMAT"&gt;Шейка матки: 
						&lt;a id="815d81b8-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b8-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;, 
						&lt;a id="7ce99a22-d9f9-11e1-81fd-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;, 
						&lt;a id="7ce99a24-d9f9-11e1-81fd-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;. Матка 
						&lt;a id="815d81b9-ca64-11e1-bd7f-906f442be8ad" href="about:815d81b9-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;, 
						&lt;a id="5e11a0cd-ca6b-11e1-bd7f-906f442be8ad" href="about:5e11a0cd-ca6b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;, 
						&lt;a id="5e11a0d1-ca6b-11e1-bd7f-906f442be8ad" href="about:5e11a0d1-ca6b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;, 
						&lt;a id="5e11a0d2-ca6b-11e1-bd7f-906f442be8ad" href="about:5e11a0d2-ca6b-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
					&lt;div class="FORMAT"&gt;Придатки 
						&lt;a id="815d81ba-ca64-11e1-bd7f-906f442be8ad" href="about:815d81ba-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. Своды 
						&lt;a id="815d81bb-ca64-11e1-bd7f-906f442be8ad" href="about:815d81bb-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. Выделения 
						&lt;a id="815d81bc-ca64-11e1-bd7f-906f442be8ad" href="about:815d81bc-ca64-11e1-bd7f-906f442be8ad"&gt;[...]&lt;/a&gt;. &lt;/div&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT" dir="ltr"&gt;
					&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;

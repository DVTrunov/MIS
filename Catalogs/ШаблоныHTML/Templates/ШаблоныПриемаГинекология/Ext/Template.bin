			<Code>000000105</Code>
			<Description>94. Определение опухолевых маркёров</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 14.416cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Определение опухолевых маркёров&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt; &lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Ф.И.О.пациента: 
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Возраст: 
				&lt;a id="9a640545-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Диагноз: 
				&lt;a id="21632637-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Место работы: 
				&lt;a id="6339a993-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;p/&gt;
			&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; Опухолевый маркёр                          Норматив&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt; Значение пациента&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; РЭА                                                     до 5Нг/мл&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd406a-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    нг/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; АФП                                                    до 16МЕ/мл&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd406b-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;   МЕ/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; ПСА общий                                        до 4 Нг/мл&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="c309c35c-b8da-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    нг/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; ПСА свободный&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd406c-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;   %       &lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; СА 15-3                                              до 35 Ед/мл&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd406d-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    Ед/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; СА 19-9                                              до 35 Ед/мл&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd406e-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    Ед/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; СА 125                                                до 35 Ед/мл&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="c309c35d-b8da-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    Ед/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; СА 242                                                до 20 Ед/мл&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd406f-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    Ед/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; НСЕ&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;   
								&lt;a id="e3dd4070-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    Мкг/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; с-ХГЧ                                                  до 10 МЕ/л&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd4071-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    МЕ/л&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; Кальцитонин&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd4072-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    Пг/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;2-микроглобулин&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;   
								&lt;a id="e3dd4073-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    Мкг/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="left"&gt; Ферритин                               от 20 до 150 нг/мл (Ж)
								&lt;br/&gt;                                                 от 20 до 350 нг/мл (М)&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd4074-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    нг/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt; Тиреоглобулин&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="e3dd4075-cc3e-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    нг/мл&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
			&lt;p&gt;Дата: 
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;                                   Врач: 
				&lt;a id="83529ec7-fbc4-11e1-9f7a-f280ea475eec" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;

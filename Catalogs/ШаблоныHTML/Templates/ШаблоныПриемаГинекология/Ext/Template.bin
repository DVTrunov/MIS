			<Code>000000112</Code>
			<Description>60. Общий анализ крови (ОАК)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 18.306cm; WIDTH: 21cm"&gt;&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Общий анализ крови&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;Пациент: 
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;&lt;p&gt;Врач: 
				&lt;a id="a22aecf7-e701-11e1-8205-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;&lt;p/&gt;&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="13%"&gt; Эритроциты&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; Гемоглобин&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; Цветной показатель&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; Толстая&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; капля&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; Ретикулоциты&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; Тромбоциты&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; Паразиты&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="13%"&gt; &lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; &lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; &lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; полихром&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; Базоф.&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; &lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; &lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; В 1 куб мм 4,5-5 мм&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 80-100&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 0,8-1,0&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; +&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; -&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 0,6-0,8&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 250-400 тыс&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt; &lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 
								&lt;a id="3d5ea027-d260-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; х 10
								&lt;sup&gt;12&lt;/sup&gt;/л&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 
								&lt;a id="e3ce7f97-cce7-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d77-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d79-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d7c-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d7d-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d7e-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="13%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d7f-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
			&lt;p/&gt;&lt;table width="100%" align="center" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; Лейко циты&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; Базофилы&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; Эозино филы&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; миэ лоц&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt; юные&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt; палоч&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt; сегмент&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; Лимфо циты&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; Моно циты&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; Индекс сдвига&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; норма 6-8 тыс&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 0-0,5%&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 3-4%&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; -&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt;-&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 4%&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 63-67%&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 24-30%&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 6-8%&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 0,6&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt;норма в абсл. числах &lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 30-40&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 180-200&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; -&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; -&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 240-320&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 4020-5040&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 1800-2400&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 360-640&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; &lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt;
								&lt;a id="3d5ea028-d260-11e2-b623-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; х 10
								&lt;sup&gt;9&lt;/sup&gt;/л&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d80-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d81-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d82-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d83-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d84-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d85-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d86-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d87-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="10%"&gt;&lt;p align="center"&gt; 
								&lt;a id="c7a34d88-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
			&lt;p&gt;Ht: 
				&lt;a id="c7a34d89-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;%&lt;/p&gt;&lt;p&gt;Ациноцитоз:     
				&lt;a id="c7a34d8a-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;    Резистивность эритроцитов мин/мак&lt;/p&gt;&lt;p&gt;Пойкилоцитоз: 
				&lt;a id="c7a34d8b-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;             свертываемость крови: 
				&lt;a id="c7a34d92-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;&lt;p&gt;Нормобласты:  
				&lt;a id="c7a34d93-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;                                        Начало 
				&lt;a id="c7a34d98-e2f7-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;

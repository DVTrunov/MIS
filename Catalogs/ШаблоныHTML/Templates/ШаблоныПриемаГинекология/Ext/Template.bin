			<Description>67_1. Диагностика ВИЧ, RW, гепатиты</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 9.727cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;Н А П Р А В Л Е Н И Е&lt;/strong&gt;
			&lt;/div&gt;
			&lt;p&gt;                         
				&lt;strong&gt;в лабораторию для диагностики ВИЧ-инфекции, сифилиса, маркёров ВГВ, ВГС.
					&lt;br/&gt;
				&lt;/strong&gt;
			&lt;/p&gt;
			&lt;p&gt;Ф.И.О. 
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Год рождения: 
				&lt;a id="c6a1720b-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;  Адрес: 
				&lt;a id="6339a98d-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Диагноз: 
				&lt;a id="21632637-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; &lt;/p&gt;
			&lt;p&gt;Дата взятия крови: 
				&lt;a id="1c8a5742-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;  &lt;/p&gt;
			&lt;p align="center"&gt;
				&lt;strong&gt;ЗАКЛЮЧЕНИЕ ЛАБОРАТОРИИ&lt;/strong&gt; &lt;/p&gt;
			&lt;p/&gt;
			&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt; ВГВ&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt;ВГС &lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt;RW&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt;Ифа Вич&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt;Иммуноблот&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt; 
								&lt;a id="744a08c5-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="744a08c8-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt;
							&lt;p align="center"&gt;
								&lt;a id="744a08c9-cc33-11e2-ac12-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;

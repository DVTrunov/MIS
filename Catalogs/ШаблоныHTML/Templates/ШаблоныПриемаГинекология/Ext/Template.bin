					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;a id="bf87a73c-3226-11e2-9c4b-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;

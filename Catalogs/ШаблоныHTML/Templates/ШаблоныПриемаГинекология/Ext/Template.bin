			<Description>Клиент: ИМТ</Description>
			<АлгоритмВычисления>Если ЗначениеЗаполнено(Параметры.Рост) 
	И ТипЗнч(Параметры.Рост) = Тип("Число")
	И ТипЗнч(Параметры.Вес) = Тип("Число")
Тогда

	Результат = Параметры.Вес / (Параметры.Рост*Параметры.Рост / 10000); // Делим на рост в метрах.
	Результат = Окр(Результат, 1);	
Иначе
	Результат = 0;
КонецЕсли;</АлгоритмВычисления>

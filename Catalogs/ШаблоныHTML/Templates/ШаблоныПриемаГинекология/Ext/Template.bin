			<Description>53_1. Исследование методом ПЦР общий (качественный)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 15.151cm; WIDTH: 21cm"&gt;&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Общий анализ методом ПЦР (качаственный) &lt;/font&gt;
				&lt;/strong&gt; &lt;/div&gt;&lt;p&gt;Пациент: 
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Анализ методом ПЦР от: 
				&lt;a id="d196e9c1-a7f6-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Материал: 
				&lt;a id="1c8a5749-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; &lt;/p&gt;&lt;p&gt;Ureaplasma urealyticum: 
				&lt;a id="a95a5de3-c127-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;sup&gt;
					&lt;a id="f4ce6d2b-30ca-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/sup&gt;
				&lt;a id="96218f91-30d4-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Ureaplasma parvum: 
				&lt;a id="a95a5de4-c127-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;sup&gt;
					&lt;a id="f4ce6d2c-30ca-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/sup&gt;
				&lt;a id="96218f8f-30d4-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Micoplasma hominis: 
				&lt;a id="a95a5deb-c127-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;sup&gt;
					&lt;a id="f4ce6d2d-30ca-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/sup&gt;
				&lt;a id="96218f8d-30d4-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;Candida albicans: 
				&lt;select id="ac5e972e-241b-11e3-9e1f-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9e1fd43d7e553e2011e3241bac5e972f}"&gt;Не проводился&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9e1fd43d7e553e2011e3241bac5e9730}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9e1fd43d7e553e2011e3241bac5e9731}"&gt;Обнаружен&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;Trichomonas vaginalis: 
				&lt;select id="a95a5ded-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9e1fd43d7e553e2011e3241bac5e972b}"&gt;Не проводился&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9e1fd43d7e553e2011e3241bac5e972c}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9e1fd43d7e553e2011e3241bac5e972d}"&gt;Обнаружен&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;Chlamidia trachomatis: 
				&lt;select id="a95a5de1-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474364}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474363}"&gt;Обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474362}"&gt;Провести&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474365}"&gt;Не проводился&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;Ureaplasma spp: 
				&lt;select id="a95a5de2-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474367}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474366}"&gt;Обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474368}"&gt;Провести&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474369}"&gt;Не проводился&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;Micoplasma hom: 
				&lt;select id="a95a5de5-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436a}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436b}"&gt;Обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436c}"&gt;Провести&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436d}"&gt;Не проводился&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;Micoplasma genit: 
				&lt;select id="a95a5de6-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436e}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436f}"&gt;Обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474370}"&gt;Провести&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474371}"&gt;Не проводился&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;Gardnerella vaginalis: 
				&lt;select id="a95a5dea-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474372}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474373}"&gt;Обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474374}"&gt;Провести&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474375}"&gt;Не проводился&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;Herpes sympl.- I/II : 
				&lt;select id="a95a5de8-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474372}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474373}"&gt;Обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474374}"&gt;Провести&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474375}"&gt;Не проводился&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;CMV: 
				&lt;select id="a95a5de7-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474372}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436f}"&gt;Обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474370}"&gt;Провести&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474371}"&gt;Не проводился&lt;/option&gt;
				&lt;/select&gt;
				&lt;br/&gt;Neisseria gonor: 
				&lt;select id="a95a5dec-c127-11e2-a73d-d43d7e553e20"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436e}"&gt;Не обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f00047436b}"&gt;Обнаружен&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474368}"&gt;Провести&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:a73dd43d7e553e2011e2c1f000474365}"&gt;Не проводился&lt;/option&gt;
				&lt;/select&gt;
			&lt;/p&gt;&lt;p&gt;
				&lt;strong&gt;HPV 16\18 types&lt;/strong&gt; &lt;/p&gt;&lt;p/&gt;&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; &lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt; Результат&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt;Вирусная нагрузка*  (lg10
								&lt;sup&gt;5&lt;/sup&gt; клеток)&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; HPV 16 type&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt; 
								&lt;a id="a4ae8334-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt; 
								&lt;a id="a4ae8335-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; HPV 18 type&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt; 
								&lt;a id="a4ae8337-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt; 
								&lt;a id="a4ae8336-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;* &amp;lt;3 - малозначимая,   3-5 - значимая,  &amp;gt;5 - повышенная &lt;p&gt;HPV-скрининг&lt;/p&gt;&lt;p/&gt;&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt; Результат&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt; Филогенетическая группа*&lt;/p&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt;&lt;p align="center"&gt; Вирусная нагрузка**  (lg10
								&lt;sup&gt;5&lt;/sup&gt; клеток)&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae833a-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a4ae833b-c119-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="33%"&gt; 
							&lt;a id="a95a5ddf-c127-11e2-a73d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
			&lt;p&gt;*А9– 16,31,33,35,52,58 типы, А7-18,39,45,59 типы, А5/А6-51,56 типы
				&lt;br/&gt;** &amp;lt;3 - малозначимая,   3-5 - значимая,  &amp;gt;5 - повышенная &lt;/p&gt;&lt;p&gt;Дата: 
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, Врач: 
				&lt;a id="a22aecf7-e701-11e1-8205-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
		&lt;/div&gt;
	&lt;/body&gt;

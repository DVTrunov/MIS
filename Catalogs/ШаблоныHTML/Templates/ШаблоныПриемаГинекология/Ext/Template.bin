					<ОбъединяющееПоле xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
				</Row>
				<Row>
					<Наименование/>
					<Параметр>83017dcb-6e6a-11e1-9f34-e9a901c6eef1</Параметр>
					<Представление/>
					<ДействиеМедосмотра>00000000-0000-0000-0000-000000000000</ДействиеМедосмотра>
					<localid/>
					<Заполнять>false</Заполнять>

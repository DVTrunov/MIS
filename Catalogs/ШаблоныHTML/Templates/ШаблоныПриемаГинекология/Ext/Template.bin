			<Description>16. Удаление ВМС</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="BORDER-TOP: 0px solid; HEIGHT: 18.144cm; BORDER-RIGHT: 0px solid; WIDTH: 21cm; BORDER-BOTTOM: 0px solid; BORDER-LEFT: 0px solid"&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;

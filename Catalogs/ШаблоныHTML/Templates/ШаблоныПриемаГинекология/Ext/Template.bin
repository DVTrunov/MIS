			<Description>22. УЗИ органов брюшной полости</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 14.986cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;УЗИ органов брюшной полости&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Дата проведения осмотра: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, аппарат: 
					&lt;a id="c6a17208-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, дата рождения: 
					&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt; &lt;/div&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;span style="FONT-SIZE: 12pt; mso-bidi-font-family: Arial; mso-font-kerning: 16.0pt"&gt;
					&lt;!--?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /?????--&gt;
					&lt;o:p/&gt;
				&lt;/span&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;span style="FONT-SIZE: 12pt; mso-bidi-font-family: Arial; mso-font-kerning: 16.0pt"&gt;
					&lt;o:p/&gt;
				&lt;/span&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;span style="FONT-SIZE: 11pt; mso-bidi-font-family: Arial; mso-font-kerning: 16.0pt"&gt;
					&lt;font size="3"&gt;
						&lt;strong&gt;Печень &lt;/strong&gt;расположена &lt;/font&gt;
				&lt;/span&gt;
				&lt;a id="8daf379a-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; правая доля 
				&lt;input id="8daf379c-ed04-11e2-9029-d43d7e553e20" style="overflow: auto; width: 55px; height: 22px;" rows="0" cols="0"/&gt; мм, левая доля 
				&lt;input id="8daf379d-ed04-11e2-9029-d43d7e553e20" style="overflow: auto; width: 70px; height: 22px;" rows="0" cols="0"/&gt; мм, контуры 
				&lt;a id="8daf379e-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; и 
				&lt;a id="8daf37a1-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Паренхима печени 
				&lt;a id="8daf37a4-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; эхогенности. Звукопроходимость 
				&lt;a id="8daf37a8-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Структура печени 
				&lt;a id="8daf37ab-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Нижняя полая вена 
				&lt;a id="8daf37ad-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;. Портальная вена 
				&lt;a id="c899f71e-cc7e-11e4-97f0-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, диаметром 
				&lt;input id="8daf37af-ed04-11e2-9029-d43d7e553e20" style="overflow: auto; width: 94px; height: 22px;" rows="0" cols="0"/&gt; мм. Печеночные вены 
				&lt;a id="c899f721-cc7e-11e4-97f0-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Гепатикохоледох диаметром 
				&lt;a id="8daf37b0-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; мм. Внутрипеченочные желчные протоки 
				&lt;a id="8daf37b1-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt; &lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;strong&gt;Желчный пузырь &lt;/strong&gt;
				&lt;a id="37296a65-2b22-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; 
				&lt;a id="8daf37b2-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;a id="8daf37b3-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;a id="8daf37ba-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;a id="8daf37b7-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;. 
				&lt;a id="c649baee-ed25-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;мм.
				&lt;a id="8daf37b6-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;strong/&gt; &lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;strong&gt;Поджелудочная железа &lt;/strong&gt;расположена 
				&lt;a id="8daf37bc-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Контуры 
				&lt;a id="8daf37bd-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;a id="8daf37c0-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;. Размеры 
				&lt;a id="8daf37c3-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Структура 
				&lt;a id="8daf37c5-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;a id="8daf37c8-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; эхогенности.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Вирсунгов проток 
				&lt;a id="8daf37c9-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt; &lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;
				&lt;strong&gt;Селезенка &lt;/strong&gt;расположена 
				&lt;a id="8daf37cb-ed04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/p&gt;
			&lt;p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 174.75pt"&gt;Размеры 

			<Description>76_1. Осмотр педиатра</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 6.697cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;
					&lt;font size="4"&gt;Осмотр педиатра&lt;/font&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Пациент:&lt;/strong&gt; 
				&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;возраст&lt;/strong&gt; 
				&lt;a id="9a640545-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Жалобы:&lt;/strong&gt;  
				&lt;a id="83017dcb-6e6a-11e1-9f34-e9a901c6eef1" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Анамнез заболевания:&lt;/strong&gt; 
				&lt;a id="ac5e9704-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Анамнез жизни: &lt;/strong&gt;
				&lt;a id="ac5e9705-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Эпидемиологический анамнез: &lt;/strong&gt;
				&lt;a id="5dfb3990-aaff-11e4-a1cc-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Экспертный анамнез: &lt;/strong&gt;
				&lt;a id="ac5e9713-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Состояние:&lt;/strong&gt; 
				&lt;a id="55e30361-d23e-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;самочувствие: &lt;/strong&gt;
				&lt;a id="ac5e9716-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Кожные покровы: &lt;/strong&gt;
				&lt;a id="9f128635-6274-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;сыпь:&lt;/strong&gt; 
				&lt;a id="5dfb3996-aaff-11e4-a1cc-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;зев: &lt;/strong&gt;
				&lt;a id="31555eae-c2f2-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;язык:&lt;/strong&gt; 
				&lt;a id="9e874c97-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Периферические лимфоузлы:&lt;/strong&gt; 
				&lt;a id="c3a39697-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дыхание:&lt;/strong&gt; 
				&lt;a id="1d696e7d-ab0e-11e4-a1cc-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong&gt;, хрипы: &lt;/strong&gt;
				&lt;a id="41abbaa9-d249-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Тоны сердца&lt;/strong&gt; 
				&lt;a id="41abbab9-d249-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong&gt;, шумы:  &lt;/strong&gt;
				&lt;a id="41abbac0-d249-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Живот: &lt;/strong&gt;
				&lt;a id="c3a3969e-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong&gt;, печень: &lt;/strong&gt;
				&lt;a id="ce660a85-ab29-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong&gt;, селезенка: &lt;/strong&gt;
				&lt;a id="1d696e90-ab0e-11e4-a1cc-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Мочеиспускание:&lt;/strong&gt; 
				&lt;a id="e2186fbe-e304-11e2-abc6-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong/&gt;, 
				&lt;strong&gt;стул:&lt;/strong&gt; 
				&lt;a id="be351876-a752-11e2-90c8-bb602a0e91c9" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong/&gt; 
				&lt;strong&gt;ЧСС &lt;/strong&gt;
				&lt;a id="41abbabe-d249-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;АД&lt;/strong&gt; 
				&lt;a id="21632636-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;/
				&lt;a id="41abbabf-d249-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;strong&gt;, ЧД &lt;/strong&gt;
				&lt;a id="c3a39699-07a5-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;, 
				&lt;strong&gt;Рост: &lt;/strong&gt;
				&lt;a id="20d44e39-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;см, 
				&lt;strong&gt;вес: &lt;/strong&gt;
				&lt;a id="9e874c6a-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;кг.&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong/&gt;  &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Диагноз:&lt;/strong&gt; 
				&lt;a id="21632637-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Рекомендации:&lt;/strong&gt; 
				&lt;a id="821bbb7d-91dc-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Выдан больничный лист №  &lt;/strong&gt;
				&lt;a id="0893760a-9112-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong/&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата повторного осмотра: &lt;/strong&gt;
				&lt;a id="d01bc7dd-5ca5-11e3-8fdb-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong/&gt; &lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;strong&gt;Дата осмотра:&lt;/strong&gt; 
				&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;     
				&lt;strong&gt;Врач:&lt;/strong&gt; 
				&lt;a id="a22aecf7-e701-11e1-8205-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

			<Code>000000080</Code>
			<Description>74_1. Осмотр эндокринолога первичный</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 0.143cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;font size="5"&gt;Осмотр эндокринолога&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt; &lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Пациент: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, возраст (полных лет): &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9a640545-e752-11e1-8206-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;На "Д" учете у эндокринолога &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1e7c73a7-c6e0-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Жалобы: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="83017dcb-6e6a-11e1-9f34-e9a901c6eef1" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Семейный анамнез (по эндокрин. заболеваниям): &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="35f6f50f-6270-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="35f6f512-6270-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Анамнез: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="7ce99a34-d9f9-11e1-81fd-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;  &lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Б-&lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c67-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, А-&lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="6339a99b-8c5e-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, из них: по собственному желанию: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1e7c73aa-c6e0-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, по мед. показаниям: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1e7c73ab-c6e0-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, причина: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1e7c73ac-c6e0-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;В-&lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1e7c73ad-c6e0-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, причина: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="20d44e74-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, Р-&lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c68-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, вес детей при рождении: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1e7c73ae-c6e0-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Лечение на данный момент: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="ad6ebe62-8c94-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Результаты обследования: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1e7c73b1-c6e0-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Рост: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="20d44e39-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;см., вес: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c6a-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;кг., ИМТ: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="20d44e3b-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;, ОТ: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c6b-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;см., ОБ: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c6c-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt;см.&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Питание: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c6d-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Общее состояние: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c74-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Менструальный цикл: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c78-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
				&lt;font size="3"&gt; &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="9e874c7c-803e-11e4-8f7d-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Щитовидная железа: &lt;/font&gt;
				&lt;font size="3"&gt;
					&lt;a id="1e7c73ba-c6e0-11e4-ab9b-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/font&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;font size="3"&gt;Глазные симптомы: &lt;/font&gt;
				&lt;font size="3"&gt;

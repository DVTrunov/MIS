			<Description>51_6. Исследование методом ИФА (хламидии, ВПГ, ЦМВ)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 4.426cm; WIDTH: 21cm"&gt;&lt;div class="FORMAT" align="center"&gt;
				&lt;font size="4"&gt;
					&lt;strong&gt;Анализ крови на хламидии, ВПГ, ЦМВ и др. &lt;/strong&gt;
					&lt;strong&gt;методом ИФА &lt;/strong&gt;
				&lt;/font&gt;
			&lt;/div&gt;&lt;div class="FORMAT"&gt; &lt;/div&gt;&lt;div class="FORMAT"&gt;Пациент: 
				&lt;a id="5e11a0fa-ca6b-11e1-bd7f-906f442be8ad" href="about:"&gt;[...]&lt;/a&gt;
				&lt;br/&gt;
			&lt;/div&gt;&lt;p/&gt;&lt;table width="100%" border="3"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Возбудитель&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Ig M&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Ig G &lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Ig A&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Суммарный&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="20%"&gt; Chlamydia trachomatis&lt;/td&gt;&lt;td style="WORD-WRAP: break-word" width="20%"&gt; 

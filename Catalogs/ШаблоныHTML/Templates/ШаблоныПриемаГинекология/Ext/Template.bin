			<Description>20. УЗИ органов малого таза (трансвагинальное)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="HEIGHT: 0.854cm; WIDTH: 21cm"&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;УЗИ органов малого таза (трансвагинальное)&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT"&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Дата проведения осмотра: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, аппарат: 
					&lt;a id="c6a17208-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;
					&lt;strong&gt;Пациент: &lt;/strong&gt;
					&lt;strong&gt;
						&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/strong&gt;, дата рождения: 
					&lt;a id="ac5e96fd-241b-11e3-9e1f-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/div&gt;
				&lt;div class="FORMAT"&gt;Дата начала последних менструаций: 
					&lt;a id="a7b3906b-8c74-11e2-a02c-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;     Мочевой пузырь: 
					&lt;a id="c6a1722f-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; &lt;/div&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;hr/&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;МАТКА&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;strong&gt;
					&lt;a id="bca5a99c-ea04-11e2-9029-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
				&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Расположена: 
				&lt;select id="bf87a720-3226-11e2-9c4b-1803736d59cd"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a721}"&gt;по средней линии в anteflexio&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a722}"&gt;по средней линии в retroflexio&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a723}"&gt;отклонена влево в anteflexio&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a724}"&gt;отклонена влево в retroflexio&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a725}"&gt;отклонена вправо в anteflexio&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a726}"&gt;отклонена вправо в retroflexio&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a72d}"&gt;ротирована&lt;/option&gt;
				&lt;/select&gt; 
				&lt;a id="bf87a727-3226-11e2-9c4b-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Форма: 
				&lt;select id="c6a17239-2c73-11e2-9496-1803736d59cd"&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a1723a}"&gt;шаровидная&lt;/option&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a1723b}"&gt;грушевидная&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a1723c}"&gt;седловидная&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a1723d}"&gt;неправильной формы&lt;/option&gt;
				&lt;/select&gt; 
				&lt;a id="c6a1723e-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Длина: 
				&lt;input id="5e11a0e3-ca6b-11e1-bd7f-906f442be8ad" style="overflow: auto; width: 55px; height: 22px;" rows="0" cols="0"/&gt;мм (н.- 40-60мм); толщина: 
				&lt;input id="c6a17232-2c73-11e2-9496-1803736d59cd" style="overflow: auto; width: 62px; height: 22px;" rows="0" cols="0"/&gt;мм (н.- 30-45мм); ширина: 
				&lt;input id="c6a17233-2c73-11e2-9496-1803736d59cd" style="overflow: auto; width: 54px; height: 22px;" rows="0" cols="0"/&gt;мм (н.- 40-60мм)&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Миометрий: 
				&lt;select id="c6a17234-2c73-11e2-9496-1803736d59cd"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a17235}"&gt;однородный&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:94961803736d59cd11e22c73c6a17236}"&gt;неоднородный&lt;/option&gt;
				&lt;/select&gt;
				&lt;a id="c6a17238-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Сосуды миометрия
				&lt;strong&gt; &lt;/strong&gt; 
				&lt;select id="07367428-7cee-11e3-9958-d43d7e553e20"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9958d43d7e553e2011e37cee0736742a}"&gt;не расширены&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9958d43d7e553e2011e37cee07367429}"&gt;расширены&lt;/option&gt;
				&lt;/select&gt;
				&lt;a id="0736742b-7cee-11e3-9958-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Шейка матки: 
				&lt;input id="bf87a728-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; width: 55px; height: 22px;" rows="0" cols="0"/&gt; х 
				&lt;input id="bf87a729-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; width: 64px; height: 22px;" rows="0" cols="0"/&gt;мм 
				&lt;a id="bf87a72a-3226-11e2-9c4b-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Цервикальный канал: 
				&lt;a id="c075f5a9-eebb-11e2-b68c-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Свободная жидкость в позадиматочном пространстве: 
				&lt;select id="bf87a72b-3226-11e2-9c4b-1803736d59cd"&gt;
					&lt;option selected="selected" value="{&amp;quot;B&amp;quot;,1}"&gt;да&lt;/option&gt;
					&lt;option value="{&amp;quot;B&amp;quot;,0}"&gt;нет&lt;/option&gt;
				&lt;/select&gt;, до 
				&lt;input id="bf87a72c-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; width: 91px; height: 22px;" rows="0" cols="0"/&gt; мл.&lt;/div&gt;
			&lt;hr/&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;ЭНДОМЕТРИЙ&lt;/strong&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Эндометрий 
				&lt;input id="bf87a72e-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; height: 22px; width: 75px;" rows="0" cols="0"/&gt; мм. Фаза: 
				&lt;select id="bf87a72f-3226-11e2-9c4b-1803736d59cd"&gt;
					&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a730}"&gt;пролиферации&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a731}"&gt;секреции&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a732}"&gt;переходная&lt;/option&gt;
					&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a733}"&gt;не дифференцируется&lt;/option&gt;
				&lt;/select&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Контур 
				&lt;a id="c075f5ac-eebb-11e2-b68c-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;Полость матки 
				&lt;a id="c075f5af-eebb-11e2-b68c-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;div class="FORMAT" align="left"&gt;
				&lt;a id="bf87a734-3226-11e2-9c4b-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/div&gt;
			&lt;hr/&gt;
			&lt;div class="FORMAT" align="center"&gt;
				&lt;strong&gt;ЯИЧНИКИ&lt;/strong&gt;
			&lt;/div&gt;
			&lt;table width="100%" border="0"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;
							&lt;p align="left"&gt;
								&lt;strong&gt;
									&lt;u&gt;Левый&lt;/u&gt;
								&lt;/strong&gt;
							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; width: 50%;" width="50%"&gt;
							&lt;strong&gt;Правый&lt;/strong&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;Размеры: 
							&lt;input id="bf87a735-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; width: 60px; height: 22px;" rows="0" cols="0"/&gt; х 
							&lt;input id="bf87a736-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; width: 61px; height: 22px;" rows="0" cols="0"/&gt; х 
							&lt;input id="bf87a737-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; width: 68px; height: 22px;" rows="0" cols="0"/&gt; мм&lt;/td&gt;
						&lt;td style="word-wrap: break-word; width: 50%; vertical-align: middle;"&gt;Размеры: 
							&lt;input id="bf87a73e-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; height: 22px; width: 56px;" rows="0" cols="0"/&gt; х 
							&lt;input id="bf87a73f-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; height: 22px; width: 56px;" rows="0" cols="0"/&gt; х 
							&lt;input id="bf87a73d-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; height: 22px; width: 56px;" rows="0" cols="0"/&gt; мм&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;Расположение: 
							&lt;select id="bf87a738-3226-11e2-9c4b-1803736d59cd"&gt;
								&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a739}"&gt;типично&lt;/option&gt;
								&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a73a}"&gt;интимно к матке&lt;/option&gt;
							&lt;/select&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; width: 50%;" width="50%"&gt;Расположение: 
							&lt;select id="bf87a741-3226-11e2-9c4b-1803736d59cd"&gt;
								&lt;option selected="selected" value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a742}"&gt;типично&lt;/option&gt;
								&lt;option value="{&amp;quot;#&amp;quot;,ae59bb0d-daed-43b5-8ea8-51f984a6cf0d,0:9c4b1803736d59cd11e23226bf87a743}"&gt;интимно к матке&lt;/option&gt;
							&lt;/select&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;Объем: 
							&lt;input id="bf87a73b-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; width: 65px; height: 22px;" rows="0" cols="0"/&gt; см куб. 
							&lt;p/&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; width: 50%;" width="50%"&gt;Объем: 
							&lt;input id="bf87a740-3226-11e2-9c4b-1803736d59cd" style="overflow: auto; height: 22px; width: 68px;" rows="0" cols="0"/&gt; см куб. 
							&lt;p/&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="WORD-WRAP: break-word" width="50%"&gt;Фолликулы:
							&lt;a id="c075f5b5-eebb-11e2-b68c-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; width: 50%;" width="50%"&gt;Фолликулы:
							&lt;a id="c075f5b4-eebb-11e2-b68c-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;

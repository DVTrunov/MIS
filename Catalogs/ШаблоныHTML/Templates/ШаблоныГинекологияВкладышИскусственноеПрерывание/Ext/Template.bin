			<Code>000000156</Code>
			<Description>Вкладыш прерывание  Первое посещение </Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div class="FORMAT" align="center" style="text-align: left; "&gt;
			&lt;table width="100%" border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
				&lt;tbody&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 50%;"&gt;
							&lt;a id="fea5ac94-130b-11e8-82ac-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
							&lt;br/&gt;
							&lt;span&gt;
								&lt;a id="24131de1-4ae6-11e9-82be-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/span&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 186px;"&gt;
							&lt;table width="90%" border="0" style="text-align: right; border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
								&lt;tbody&gt;
									&lt;tr style="height: 0px;"&gt;
										&lt;td style="word-wrap: break-word; vertical-align: middle; width: 237px;"&gt;
											&lt;div&gt;
												&lt;span style="font-weight: bold; orphans: 2; text-align: -webkit-center; widows: 2; background-color: rgb(255, 255, 255); font-family: Arial;"&gt;
													&lt;font size="1"&gt;Медицинская документация&lt;/font&gt;
												&lt;/span&gt;
											&lt;/div&gt;
											&lt;font face="Arial" size="1"&gt;
												&lt;div&gt;
													&lt;span style="font-weight: bold; orphans: 2; text-align: -webkit-center; widows: 2; background-color: rgb(255, 255, 255);"&gt;Учетная форма N 025/у 003-2/у-20&lt;/span&gt;
												&lt;/div&gt;
											&lt;/font&gt;
											&lt;blockquote style="margin: 0 0 0 40px; border: none; padding: 0px;"&gt;
												&lt;font face="Arial" size="1"&gt;
													&lt;span class="s_10" style="margin: 0px 0px 20px; padding: 0px; font-weight: bold; font-variant-ligatures: normal; orphans: 2; text-align: -webkit-center; widows: 2; background-color: rgb(255, 255, 255);"&gt;
														&lt;div style="text-align: right;"&gt;Утверждена 
															&lt;a href="https://base.garant.ru/74840123/" style="background-color: transparent; margin: 0px; padding: 0px; text-decoration: none;"&gt;приказом&lt;/a&gt; Минздрава России&lt;/div&gt;
													&lt;/span&gt;
												&lt;/font&gt;
											&lt;/blockquote&gt;
											&lt;font face="Arial" size="1"&gt;
												&lt;span class="s_10" style="margin: 0px 0px 20px; padding: 0px; font-weight: bold; font-variant-ligatures: normal; orphans: 2; text-align: -webkit-center; widows: 2; background-color: rgb(255, 255, 255);"&gt;
													&lt;div style="text-align: right;"&gt;от 20 октября 2020 г. N 1130н&lt;/div&gt;
												&lt;/span&gt;
											&lt;/font&gt;
										&lt;/td&gt;
									&lt;/tr&gt;
								&lt;/tbody&gt;
							&lt;/table&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
		&lt;/div&gt;
		&lt;div class="FORMAT" align="center" style="text-align: left; "&gt;
			&lt;p/&gt;
			&lt;div style="text-align: center;"&gt;
				&lt;span style="font-weight: bold; font-family: Arial;"&gt;Карта &lt;/span&gt;
				&lt;span style="font-weight: bold; font-family: Arial;"&gt;пациента при искусственном прерывании беременности медикаментозным &lt;/span&gt;
				&lt;span style="font-weight: bold; font-family: Arial;"&gt;методом
					&lt;br/&gt;
					&lt;font size="2"&gt;(вкладыш в медицинскую карту пациента, получающего &lt;/font&gt;
				&lt;/span&gt;
				&lt;span style="font-weight: bold; font-family: Arial;"&gt;
					&lt;font size="2"&gt;медицинскую помощь в амбулаторных условиях, или в карту &lt;/font&gt;
				&lt;/span&gt;
				&lt;span style="font-weight: bold; font-family: Arial; font-size: small;"&gt;стационарного больного)&lt;/span&gt;
			&lt;/div&gt;
			&lt;font face="Arial" size="2"&gt;
				&lt;div style="text-align: center;"&gt;
					&lt;span style="font-weight: bold;"&gt;
						&lt;br/&gt;
					&lt;/span&gt;
				&lt;/div&gt;
			&lt;/font&gt;
		&lt;/div&gt;
		&lt;div class="FORMAT" align="center"&gt;
			&lt;font size="4"&gt;
				&lt;b&gt;Первое посещение&lt;/b&gt;
			&lt;/font&gt;
		&lt;/div&gt;
		&lt;table border="0" style="border-collapse: collapse;"&gt;
			&lt;tbody&gt;
				&lt;tr style="height: 0px;"&gt;
					&lt;td style="vertical-align: middle;"&gt;Врач:&lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="2ade98ad-d52e-11e5-986c-3a893ef5765d" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;  Дата документа: &lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
				&lt;tr style="height: 0px;"&gt;
					&lt;td style="vertical-align: middle;"&gt;Пациент:&lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="f7bece55-cafa-11e5-9bc7-50af732359f4" href="about:"&gt;[...]&lt;/a&gt; &lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;  Дата рождения: &lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="2561c9fe-cc22-11e2-87cb-002618dcef2c" href="about:"&gt;[...]&lt;/a&gt;  (
						&lt;a id="4d22b3c0-03bd-11e3-943d-1c6f653fefc3" href="about:"&gt;[...]&lt;/a&gt;)
						&lt;br/&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
			&lt;/tbody&gt;
		&lt;/table&gt;
		&lt;div&gt;
			&lt;br/&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;span style="font-family: Arial;"&gt;
				&lt;span&gt;
					&lt;a id="09768b21-9847-11eb-a332-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt;.&lt;/span&gt;
			&lt;/span&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;font face="Arial"&gt;В случае направления из женской консультации психолога / специалиста по социальной работе &lt;/font&gt;
			&lt;a id="dc31cc26-9847-11eb-a332-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt;
			&lt;span style="font-family: Arial;"&gt;. &lt;/span&gt;
		&lt;/div&gt;
		&lt;div data-bit-hidden="true"&gt;
			&lt;span style="font-family: Arial;"&gt;Причина отказа от консультации: 
				&lt;a id="5cd4be4f-7673-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/span&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;span style="font-family: Arial;"&gt;Проведена беседа о причине аборта и его последствиях.
				&lt;br/&gt;
				&lt;span&gt;
					&lt;a id="99e2a614-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt; в 
					&lt;span&gt;
						&lt;a id="8c8b3317-9848-11eb-a332-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt; ч 
						&lt;span&gt;
							&lt;a id="a5b23f59-9848-11eb-a332-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt; мин предоставлено время для обдумывания решения в течении &lt;/span&gt;
					&lt;/span&gt;
				&lt;/span&gt;
			&lt;/span&gt;
			&lt;span style="font-family: Arial;"&gt;
				&lt;a id="1c8a5744-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt; перед искусственным прерыванием беременности.&lt;/span&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;br/&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;span style="font-family: Arial;"&gt;
				&lt;b&gt;Влагалищное исследование:
					&lt;br/&gt;
				&lt;/b&gt;
			&lt;/span&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;span&gt;
				&lt;table width="100%" border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
					&lt;tbody&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;Наружные половые 
									&lt;br/&gt;органы:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;
									&lt;a id="d31846f6-6d46-11e3-87e4-002618dcef2c" href="about:"&gt;[...]&lt;/a&gt;;&lt;/span&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;Шейка матки:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;
									&lt;select id="cdbb1629-904d-11eb-93bb-50af73235947"&gt;
										&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Цилиндрической формы&amp;quot;}"&gt;Цилиндрической формы&lt;/option&gt;
										&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Конической формы&amp;quot;}"&gt;Конической формы&lt;/option&gt;
									&lt;/select&gt;
								&lt;/span&gt;
								&lt;span style="font-family: Arial;"&gt;;&lt;/span&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td colspan="2" style="vertical-align: middle; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;
									&lt;a id="6c042e34-9863-11eb-a332-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt;;&lt;/span&gt;
								&lt;br/&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;Наружный зев:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;
									&lt;a id="8d9f36b0-1186-11e4-ab6c-853297994cb4" href="about:"&gt;[...]&lt;/a&gt;;&lt;/span&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;Тело матки:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;в положении&lt;/span&gt; 
								&lt;span style="font-family: Arial;"&gt;
									&lt;a id="5cd4be54-7673-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;, 
									&lt;select id="5cd4be56-7673-11eb-93b9-50af73235947"&gt;
										&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Увеличено&amp;quot;}"&gt;Увеличено&lt;/option&gt;
										&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Не увеличено &amp;quot;}"&gt;Не увеличено &lt;/option&gt;
									&lt;/select&gt; до 
									&lt;a id="c6a1720e-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; недель беременности, 
									&lt;span&gt;
										&lt;a id="1b3c22d7-9864-11eb-a332-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt;, 
										&lt;span&gt;
											&lt;a id="512b7ad4-9864-11eb-a332-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt;, 
											&lt;span&gt;
												&lt;a id="8889908b-9864-11eb-a332-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt;;&lt;/span&gt;
										&lt;/span&gt;
									&lt;/span&gt;
								&lt;/span&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;Левые придатки:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;
									&lt;a id="8d9f36b4-1186-11e4-ab6c-853297994cb4" href="about:"&gt;[...]&lt;/a&gt;;&lt;/span&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;Правые придатки:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;
									&lt;a id="8d9f36b5-1186-11e4-ab6c-853297994cb4" href="about:"&gt;[...]&lt;/a&gt;;&lt;/span&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;Своды свободны;&lt;/span&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 110pt;"&gt;
								&lt;span style="font-family: Arial;"&gt;Выделения:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;

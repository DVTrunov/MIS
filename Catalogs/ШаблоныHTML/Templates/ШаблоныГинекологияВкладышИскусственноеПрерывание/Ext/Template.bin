						&lt;/tr&gt;
					&lt;/tbody&gt;
				&lt;/table&gt;
			&lt;/span&gt;
		&lt;/div&gt;
		&lt;br/&gt;
		&lt;span style="font-family: Arial;"&gt;
			&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/tt&gt;
		&lt;/span&gt;
		&lt;div&gt;
			&lt;div&gt;
				&lt;span style="font-family: Arial;"&gt;
					&lt;b&gt;
						&lt;br/&gt;Назначено обследование (при отсутствии):&lt;/b&gt;

								&lt;/select&gt;до 
								&lt;a id="c6a1720e-2c73-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt; недель беременности;&lt;/span&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: top; width: 160pt;"&gt;
							&lt;span style="font-family: Arial;"&gt;Левые придатки:&lt;/span&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt; 
							&lt;span style="font-family: Arial;"&gt;

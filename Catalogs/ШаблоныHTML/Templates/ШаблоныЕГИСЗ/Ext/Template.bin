                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='REGIME']/n1:component/n1:section[n1:code/@code='RECTREAT']/n1:entry/n1:observation[n1:code/@code='4113']/n1:value"/&gt;

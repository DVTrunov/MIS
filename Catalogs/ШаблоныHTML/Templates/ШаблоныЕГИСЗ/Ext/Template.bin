				<Row>
					<Реквизит>Клиент</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>80c99b3c-4dad-11ef-b691-1c697a96466f</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Клиент: Место работы</Description>
			<АлгоритмВычисления>МестоРаботы = ДокументОбъект.Клиент.умцМестоРаботы;
Если ТипЗнч(МестоРаботы) = Тип("СправочникСсылка.Контрагенты") Тогда
	Если ЗначениеЗаполнено(МестоРаботы.НаименованиеПолное) Тогда
		Результат = МестоРаботы.НаименованиеПолное;
	Иначе
		Результат = МестоРаботы.Наименование;
	КонецЕсли;
Иначе
	Результат = Строка(МестоРаботы);
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>227c940c-9b4f-11ee-846c-18c04dfa1eeb</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Медицинская услуга документа</Description>
			<АлгоритмВычисления>Док = ДокументОбъект;

ПараметрОперации_Отказ = Истина;

Если Док.Работы.Количество() &lt;&gt; 0 Тогда
	НМУ_СоставаУслуг = Новый Массив;
	Для Каждого СтрокаРабот Из Док.Работы Цикл
		Если ЗначениеЗаполнено(СтрокаРабот.Номенклатура) Тогда
			НМУ_СтрокиРаботы = СтрокаРабот.Номенклатура.НоменклатураМедицинскихУслуг;
			Если ЗначениеЗаполнено(НМУ_СтрокиРаботы)
				И НМУ_СоставаУслуг.Найти(НМУ_СтрокиРаботы) = Неопределено
			Тогда
				НМУ_СоставаУслуг.Добавить(СтрокаРабот.Номенклатура.НоменклатураМедицинскихУслуг);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НМУ_СоставаУслуг.Количество() = 1 Тогда
		Результат = НМУ_СоставаУслуг[0];
		ПараметрОперации_Отказ = Ложь;
	КонецЕсли;
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Работы</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>df34d51a-32eb-11ef-b68f-001a7dda7110</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Дата документа (тип Дата, начало дня)</Description>
			<АлгоритмВычисления>Результат = НачалоДня(ДокументОбъект.Дата);</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Дата</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>ef0c9ef5-c570-11ee-a45e-1c697a9ea640</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>ef0c9ef4-c570-11ee-a45e-1c697a9ea640</Parent>
			<Description>Должность сотрудника, осуществившего забор</Description>
			<АлгоритмВычисления>ДолжностиСотрудника = ИнтеграцияЕГИСЗВызовСервера.ДолжностиМЗ(Параметры.Сотрудник);
Если ДолжностиСотрудника.Количество() &gt; 0 Тогда
	Результат = ДолжностиСотрудника[0];
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных>
				<Row>
					<Параметр>0f23874b-32ab-11ee-a448-1c697a9ea640</Параметр>
					<ИмяПеременной>Сотрудник</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>

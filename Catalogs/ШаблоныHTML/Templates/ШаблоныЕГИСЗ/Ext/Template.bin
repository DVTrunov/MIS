			<Description>Направление на МСЭ ред.6 (мин)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div class="FORMAT" style="word-wrap:break-word;WIDTH:19cm"&gt;
			&lt;div&gt;
				&lt;div style="text-align:center;font-weight:bold"&gt;
					&lt;div&gt;НАПРАВЛЕНИЕ НА МЕДИКО-СОЦИАЛЬНУЮ ЭКСПЕРТИЗУ&lt;/div&gt;
					&lt;div&gt;МЕДИЦИНСКОЙ ОРГАНИЗАЦИЕЙ&lt;/div&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Председатель врачебной комиссии:&lt;/td&gt;
							&lt;td&gt;
								&lt;a id="2ade98ad-d52e-11e5-986c-3a893ef5765d" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="padding-left:10px"&gt;Дата документа:&lt;/td&gt;
							&lt;td&gt;
								&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
						&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Пациент:&lt;/td&gt;
							&lt;td&gt;
								&lt;a id="f7bece55-cafa-11e5-9bc7-50af732359f4" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
							&lt;td style="padding-left:10px"&gt;Дата рождения:&lt;/td&gt;
							&lt;td&gt;
								&lt;a id="2561c9fe-cc22-11e2-87cb-002618dcef2c" href="about:"&gt;[...]&lt;/a&gt;
								&lt;span&gt;(&lt;/span&gt;
								&lt;a id="4d22b3c0-03bd-11e3-943d-1c6f653fefc3" href="about:"&gt;[...]&lt;/a&gt;
								&lt;span&gt;)&lt;/span&gt;
							&lt;/td&gt;
						&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
			&lt;br&gt;&lt;div&gt;
				&lt;div&gt;
					&lt;div style="font-weight:bold"&gt;Направление:&lt;/div&gt;
					&lt;div data-bit-sectionname="SCOPORG"&gt;
						&lt;div&gt;Цели направления:&lt;/div&gt;
						&lt;table style="border-color:inherit;border-collapse:collapse;width:100%" data-bit-dyntable-id="07d9c402-970f-11ed-8319-40167e631f2e"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;
										&lt;a id="80316f77-96ee-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
								&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div&gt;
							&lt;span&gt;Порядок обращения:&lt;/span&gt;
							&lt;a id="addc88ae-5065-11ed-bd1c-000c29c7975e" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Дата протокола врачебной комиссии:&lt;/span&gt;
							&lt;a id="80316f78-96ee-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Номер протокола врачебной комиссии:&lt;/span&gt;
							&lt;a id="38711289-96f8-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Медико-социальная экспертиза проводится на дому:&lt;/span&gt;
							&lt;input type="checkbox" id="3871128a-96f8-11ed-8319-40167e631f2e" value="False"&gt;&lt;/input&gt;&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Нуждается в оказании паллиативной медицинской помощи:&lt;/span&gt;
							&lt;input type="checkbox" id="3871128b-96f8-11ed-8319-40167e631f2e" value="False"&gt;&lt;/input&gt;&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Нуждается в первичном протезировании:&lt;/span&gt;
							&lt;input type="checkbox" id="3871128c-96f8-11ed-8319-40167e631f2e" value="False"&gt;&lt;/input&gt;&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Дата выдачи направления на МСЭ:&lt;/span&gt;
							&lt;a id="3871128d-96f8-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Гражданство:&lt;/span&gt;
							&lt;a id="9a1756f7-96fc-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Местонахождение гражданина для МСЭ:&lt;/span&gt;
							&lt;a id="9a1756f8-96fc-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
						&lt;div&gt;
							&lt;span&gt;Отношение гражданина к воинской обязанности:&lt;/span&gt;
							&lt;a id="9a1756f9-96fc-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;

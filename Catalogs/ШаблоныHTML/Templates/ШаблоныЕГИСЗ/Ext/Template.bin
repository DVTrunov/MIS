            &lt;report test="@nullFlavor"&gt;Main05-1. Элемент ClinicalDocument/informationRecipient не должен иметь атрибут @nullFlavor.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/informationRecipient/intendedRecipient"&gt;

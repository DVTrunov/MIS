								        			        	        		&lt;xsl:text&gt; &lt;/xsl:text&gt;
								        	                	        		&lt;xsl:value-of select="./n1:doseQuantity/n1:translation/@displayName"/&gt;
								        	                	        		&lt;xsl:text&gt; раз в &lt;/xsl:text&gt;
								        	                	        		&lt;xsl:value-of select="./n1:effectiveTime/n1:period/@value"/&gt;
								        			        	        		&lt;xsl:text&gt; &lt;/xsl:text&gt;
								        	                	        		&lt;xsl:value-of select="./n1:effectiveTime/n1:period/n1:translation/@displayName"/&gt;
								        			        	        		&lt;xsl:choose&gt;

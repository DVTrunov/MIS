			                    &lt;tr&gt;
                                    &lt;td colspan="8"&gt;
                                        &lt;h4 class="tablegray"&gt;
                                            &lt;xsl:text&gt;Перечень лекарственных препаратов для медицинского применения&lt;/xsl:text&gt;
                                        &lt;/h4&gt;
										&lt;p class="tableblack"&gt;
										    &lt;table class="table-break"&gt;

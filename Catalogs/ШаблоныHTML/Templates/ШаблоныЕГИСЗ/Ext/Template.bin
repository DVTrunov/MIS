                                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:addr[address:Type/@code='3']/address:stateCode/@displayName"/&gt;
							    				    		&lt;xsl:text&gt;, &lt;/xsl:text&gt;
                                                        &lt;/xsl:when&gt;

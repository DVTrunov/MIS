			<Description>Врач: Должность</Description>
			<АлгоритмВычисления>Док = ДокументОбъект;

Попытка
	Результат = Док.Врач.Должность;
Исключение 
	Попытка
		Если ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.ПрохождениеМедосмотра") Тогда
			Результат = Док.ПредседательМедКомиссии.Должность;
		ИначеЕсли ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.ПрохождениеМедосмотра") Тогда
			Результат = Док.Сотрудник.Должность;
		КонецЕсли;
	Исключение КонецПопытки;
КонецПопытки;
</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>

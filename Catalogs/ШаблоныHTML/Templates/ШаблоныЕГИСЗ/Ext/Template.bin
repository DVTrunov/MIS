						                &lt;tr&gt;
                                            &lt;td colspan="8"&gt;
                                                &lt;p class="tableblack"&gt;
						                		    &lt;xsl:text&gt;Адрес по месту жительства (постоянной регистрации): &lt;/xsl:text&gt;

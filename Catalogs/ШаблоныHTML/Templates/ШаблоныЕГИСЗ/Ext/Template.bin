			<НаименованиеПолное>Протокол лабораторного исследования (CDA) Редакция 5</НаименованиеПолное>
			<Схематрон>&lt;!-- Схематрон для СЭМД "Протокол лабораторного исследования (CDA) Редакция 5" --&gt;
&lt;!-- Разработано в соотвествии с Руководством по реализации: https://portal.egisz.rosminzdrav.ru/materials/____ --&gt;

&lt;!-- Список изменений --&gt;
&lt;!-- 21.03.2023 - v.1.0.0: Схематрон разработан --&gt;
&lt;!-- 28.03.2023 - v.1.1.0: Схематрон обновлен в соответствии с руководством --&gt;
&lt;!-- 11.04.2023 - v.1.1.1: Обновлен модуль Main02, исправления в правилах У3-3, У3-4 --&gt;
&lt;!-- 22.05.2023 - v.1.2.0: Схематрон обновлен в соответствии с руководством --&gt;
&lt;!-- 15.08.2023 - v.1.2.1: Исправление в правилах У3-1, У3-3, У3-4 --&gt;
&lt;!-- 17.08.2023 - v.1.2.2: Исправление в правилах У3-3--&gt;

&lt;schema xmlns="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt2"&gt;
    &lt;ns prefix="xsi" uri="http://www.w3.org/2001/XMLSchema-instance"/&gt;
    &lt;ns prefix="identity" uri="urn:hl7-ru:identity"/&gt;
    &lt;ns prefix="address" uri="urn:hl7-ru:address"/&gt;
    &lt;ns prefix="medService" uri="urn:hl7-ru:medService"/&gt;
    &lt;ns prefix="PII" uri="urn:hl7-ru:PII"/&gt;
    &lt;ns prefix="fias" uri="urn:hl7-ru:fias"/&gt;



    &lt;!-- Core02 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/recordTarget/patientRole/addr[not(@nullFlavor)]"&gt;
            &lt;assert test="count(address:Type)=1"&gt;У1-12. Элемент ClinicalDocument/recordTarget/patientRole/addr должен иметь 1 элемент address:Type.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- Main02 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/recordTarget/patientRole[identity:IdentityDoc[identity:IdentityCardType/@code='24']]"&gt;
            &lt;assert test="count(identity:IdentityDoc/identity:Series)=1"&gt;У1-12. Элемент ClinicalDocument/recordTarget/patientRole/identity: должен иметь 1 элемент identity:Series.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/recordTarget/patientRole/patient/guardian"&gt;
            &lt;assert test="count(PII:birthTime)=1"&gt;У1-12. Элемент ClinicalDocument/recordTarget/patientRole/patient/guardian должен иметь 1 элемент PII:birthTime.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/recordTarget/patientRole/providerOrganization"&gt;
            &lt;assert test="count(addr)=1"&gt;У1-12. Элемент ClinicalDocument/recordTarget/patientRole/providerOrganization должен иметь 1 элемент addr.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- Main08 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument"&gt;
            &lt;assert test="count(documentationOf)=1"&gt;У1-21. Элемент ClinicalDocument должен иметь 1 элемент documentationOf.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/documentationOf/serviceEvent/code"&gt;
            &lt;assert test="@code='4'"&gt;У1-21. Элемент ClinicalDocument/documentationOf/serviceEvent/code должен иметь значение атрибута @code равное '4'.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- Main09 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/componentOf/encompassingEncounter[code/@code='3']"&gt;
            &lt;assert test="count(medService:DocType)=1"&gt;У1-22. Элемент ClinicalDocument/componentOf/encompassingEncounter[code/@code='3'] должен иметь 1 элемент medService:DocType.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/componentOf/encompassingEncounter[code/@code!='3']"&gt;
            &lt;report test="medService:DocType"&gt;У1-22. Элемент ClinicalDocument/componentOf/encompassingEncounter[code/@code!='3'] не должен иметь элемента medService:DocType.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/componentOf/encompassingEncounter"&gt;
            &lt;assert test="count(effectiveTime)=1"&gt;У1-22. Элемент ClinicalDocument/componentOf/encompassingEncounter должен иметь 1 элемент effectiveTime.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;



    &lt;!-- У1-3 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/templateId"&gt;
            &lt;assert test="@root='1.2.643.5.1.13.13.14.7.9.5'"&gt;У1-3. Элемент ClinicalDocument/templateId должен иметь значение атрибута @root равное '1.2.643.5.1.13.13.14.7.9.5'.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У1-5 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/code"&gt;
            &lt;assert test="@code='7'"&gt;У1-5. Элемент ClinicalDocument/code должен иметь значение атрибута @code равное '7'.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-1 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='SPECIMENS'])=1"&gt;У2-1. Элемент ClinicalDocument/component/structuredBody должен иметь 1 элемент component[section/code/@code='SPECIMENS'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='SPECIMENS']"&gt;
            &lt;assert test="count(text)=1"&gt;У2-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECIMENS'] должен иметь 1 элемент text.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-2 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='ANALYSERS'])=1"&gt;У2-2. Элемент ClinicalDocument/component/structuredBody должен иметь 1 элемент component[section/code/@code='ANALYSERS'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='ANALYSERS']"&gt;
            &lt;assert test="count(text)=1"&gt;У2-2. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='ANALYSERS'] должен иметь 1 элемент text.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-3 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='VITALPARAM'])&amp;lt;=1"&gt;У2-3. Элемент ClinicalDocument/component/structuredBody должен иметь не более 1 элемента component[section/code/@code='VITALPARAM'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='VITALPARAM']"&gt;
            &lt;assert test="count(text)=1"&gt;У2-3. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='VITALPARAM'] должен иметь 1 элемент text.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-4 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='RESLAB'])=1"&gt;У2-4. Элемент ClinicalDocument/component/structuredBody должен иметь 1 элемент component[section/code/@code='RESLAB'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='RESLAB']"&gt;
            &lt;assert test="count(text)=1"&gt;У2-4. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='RESLAB'] должен иметь 1 элемент text.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-5 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='SERVICES'])&amp;lt;=1"&gt;У2-5. Элемент ClinicalDocument/component/structuredBody должен иметь не более 1 элемента component[section/code/@code='SERVICES'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-6 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='LINKDOCS'])&amp;lt;=1"&gt;У2-6. Элемент ClinicalDocument/component/structuredBody должен иметь не более 1 элемента component[section/code/@code='LINKDOCS'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У3-1 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='SPECIMENS']"&gt;
            &lt;assert test="count(entry[organizer])&gt;=1"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECIMENS'] должен иметь не более 1 элемента entry.&lt;/assert&gt;
        &lt;/rule&gt;

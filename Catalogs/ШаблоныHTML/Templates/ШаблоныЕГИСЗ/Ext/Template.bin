                                                        &lt;xsl:text&gt;Комментарий&lt;/xsl:text&gt;
                                                    &lt;/h2&gt;
					    	                        &lt;p class="tableblack"&gt;
					    	       	                    &lt;xsl:value-of select="./n1:value"/&gt;
					    	                        &lt;/p&gt;	
                                                &lt;/td&gt;
                                            &lt;/tr&gt;
									    &lt;/xsl:when&gt;
										&lt;xsl:when test="./n1:code/@code='4073'"&gt;
										    &lt;tr&gt;
                                                &lt;td colspan="8"&gt;
                                                    &lt;h2 class="tablegray"&gt;
                                                        &lt;xsl:text&gt;Сведения о месте учебы/работы&lt;/xsl:text&gt;
                                                    &lt;/h2&gt;
					    	                        &lt;p class="tableblack"&gt;
					    	       	                    &lt;xsl:value-of select="./n1:performer/n1:assignedEntity/n1:representedOrganization/n1:name"/&gt;
									            		&lt;xsl:choose&gt;
									            		    &lt;xsl:when test="./n1:performer/n1:assignedEntity/n1:representedOrganization/n1:addr/n1:streetAddressLine"&gt;
									            			    &lt;br/&gt;&lt;xsl:text&gt;Адрес: &lt;/xsl:text&gt;
									            				&lt;xsl:choose&gt;
                                                                    &lt;xsl:when test="./n1:performer/n1:assignedEntity/n1:representedOrganization/n1:addr/n1:postalCode[not(@nullFlavor)]"&gt;
                                                                        &lt;xsl:value-of select="./n1:performer/n1:assignedEntity/n1:representedOrganization/n1:addr/n1:postalCode"/&gt;
									            			        	&lt;xsl:text&gt;, &lt;/xsl:text&gt;
                                                                    &lt;/xsl:when&gt;
                                                                &lt;/xsl:choose&gt;
									            		        &lt;xsl:choose&gt;
                                                                    &lt;xsl:when test="./n1:performer/n1:assignedEntity/n1:representedOrganization/n1:addr/address:stateCode[not(@nullFlavor)]"&gt;
                                                                        &lt;xsl:value-of select="./n1:performer/n1:assignedEntity/n1:representedOrganization/n1:addr/address:stateCode/@displayName"/&gt;
									            		        		&lt;xsl:text&gt;, &lt;/xsl:text&gt;
                                                                    &lt;/xsl:when&gt;
                                                                &lt;/xsl:choose&gt;
									            				&lt;xsl:value-of select="./n1:performer/n1:assignedEntity/n1:representedOrganization/n1:addr/n1:streetAddressLine"/&gt;
									            			&lt;/xsl:when&gt;
									            		&lt;/xsl:choose&gt;
									            		&lt;xsl:choose&gt;

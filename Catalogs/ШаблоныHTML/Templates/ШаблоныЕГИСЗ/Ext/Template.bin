                                                &lt;/h2&gt;
						                		&lt;p class="tableblack"&gt;
								        		    &lt;xsl:choose&gt;
								        				&lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='DRUG']/n1:entry/n1:substanceAdministration[@classCode='SBADM']/n1:text"&gt;
						                		            &lt;table class="table-break"&gt;
					                                            &lt;tr&gt;

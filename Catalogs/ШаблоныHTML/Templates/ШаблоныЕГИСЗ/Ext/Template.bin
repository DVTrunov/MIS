        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference"&gt;
            &lt;assert test="@typeCode='REFR'"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference должен иметь значение атрибута @typeCode равное 'REFR'.&lt;/assert&gt;
            &lt;assert test="count(externalDocument)=1"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act должен иметь 1 элемент externalDocument.&lt;/assert&gt;
            &lt;report test="@nullFlavor"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference не должен иметь атрибут @nullFlavor.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument"&gt;
            &lt;assert test="@classCode='DOCCLIN'"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument должен иметь значение атрибута @classCode равное 'DOCCLIN'.&lt;/assert&gt;
            &lt;assert test="@moodCode='EVN'"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument должен иметь значение атрибута @moodCode равное 'EVN'.&lt;/assert&gt;
            &lt;assert test="count(id)=2"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument должен иметь 2 элемента id.&lt;/assert&gt;
            &lt;report test="@nullFlavor"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument не должен иметь атрибут @nullFlavor.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument/id[1][not(@nullFlavor)]"&gt;
            &lt;assert test="matches(@root,'^[0-2](\.([1-9][0-9]*|0))+\.100([.]([1-9][0-9]*|0))+\.51$')"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument/id[1] должен иметь синтаксически корректное значение атрибута @root, сформированное по правилу формирования идентификаторов документов, т.е. "OID_медицинской_организации.100.НомерМИС.НомерЭкзМИС.51".&lt;/assert&gt;
            &lt;assert test="@extension!=''"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument/id[1] должен иметь не пустое значение атрибута @extension.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument/id[2][not(@nullFlavor)]"&gt;
            &lt;assert test="@root='1.2.643.5.1.13.13.17.1.1'"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument/id[2] должен иметь значение атрибута @root равное '1.2.643.5.1.13.13.17.1.1'.&lt;/assert&gt;
            &lt;assert test="matches(@extension,'(^[0-9]{2}[.][0-9]{2}[.][0-9]{3,4}[.][0-9]{9}$|^[0-9]{1,3}[.][0-9]{2}[.][0-9]{2}[.][0-9]{2}[.][0-9]{9}$)')"&gt;Main12-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']/entry/act/reference/externalDocument/id[2] должен иметь синтаксически корректное значение атрибута @extension, соответствующее формату "^[0-9]{2}[.][0-9]{2}[.][0-9]{3,4}[.][0-9]{9}$" или "^[0-9]{1,3}[.][0-9]{2}[.][0-9]{2}[.][0-9]{2}[.][0-9]{9}$".&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;



&lt;!-- [Extra01]Модуль проверки структуры СНИЛС (//id[@root='1.2.643.100.3']) --&gt;

&lt;!-- Поддерживается следующими видами СЭМД: --&gt;
&lt;!-- 
--&gt;

&lt;!-- Список изменений --&gt;
&lt;!-- 26.07.2022 - v.1.0.0: Модуль разработан --&gt;

    &lt;!-- Extra01-1 --&gt;
    &lt;pattern&gt;
        &lt;rule context="//id[@root='1.2.643.100.3']"&gt;
            &lt;assert test="matches(@extension,'^([0-9]{3}[-\s]{0,1}){3}[0-9]{2}$')"&gt;Extra01-1. Элемент //id[@root='1.2.643.100.3'] должен иметь синтаксически корректное значение атрибута @extension, соответствующее СНИЛС: должно состоять из 11 цифр, цифры могут группироваться по 3+3+3+2, между группами может ставиться пробел или тире.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;



&lt;!-- [Extra02]Модуль проверки структуры почтового индекса (//postalCode) --&gt;

&lt;!-- Поддерживается следующими видами СЭМД: --&gt;
&lt;!-- 
--&gt;

&lt;!-- Список изменений --&gt;
&lt;!-- 12.09.2022 - v.1.0.0: Модуль разработан --&gt;

    &lt;!-- Extra02-1 --&gt;
    &lt;pattern&gt;
        &lt;rule context="//postalCode[not(@nullFlavor)]"&gt;
            &lt;assert test="matches(.,'^[0-9]{6}$')"&gt;Extra02-1. Элемент //postalCode должен иметь синтаксически корректное значение, соответствующее почтовому индексу: должно состоять из 6 цифр без разделителей.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
&lt;/schema&gt;</Схематрон>
			<СхемаВизуализации>&lt;?xml version="1.0"?&gt;
&lt;!-- Данная схема является примером реализации. При необходимости схема может быть скорректирована поставщиками и/или потребителями СЭМД --&gt;
&lt;xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:n1="urn:hl7-org:v3" xmlns:n2="urn:hl7-org:v3/meta/voc" xmlns:voc="urn:hl7-org:v3/voc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:identity="urn:hl7-ru:identity" xmlns:address="urn:hl7-ru:address" xmlns:medService="urn:hl7-ru:medService" xmlns:PII="urn:hl7-ru:PII"&gt;
	&lt;xsl:output method="html" indent="yes" version="4.01" encoding="utf-8" doctype-public="-//W3C//DTD HTML 4.01//EN"/&gt;
	&lt;xsl:variable name="tableWidth"&gt;50%&lt;/xsl:variable&gt;
	&lt;xsl:variable name="title"&gt;
		&lt;!-- Название документа --&gt;
		&lt;xsl:value-of select="/n1:ClinicalDocument/n1:title"/&gt;
		&lt;!-- Дата выдачи --&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high[@value]"&gt;
				&lt;xsl:text&gt; от &lt;/xsl:text&gt;
				&lt;!-- Если документируемое событие продолжительное --&gt;
				&lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high[@value]"&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high/@value,7,2)"/&gt;
					&lt;xsl:text&gt;.&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high/@value,5,2)"/&gt;
					&lt;xsl:text&gt;.&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high/@value,1,4)"/&gt;
				&lt;/xsl:if&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime[@value]"&gt;
				&lt;xsl:text&gt; от &lt;/xsl:text&gt;
				&lt;!-- Если дата начала и окончания документируемого события совпадают --&gt;
				&lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime[@value]"&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/@value,7,2)"/&gt;
					&lt;xsl:text&gt;.&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/@value,5,2)"/&gt;
					&lt;xsl:text&gt;.&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/@value,1,4)"/&gt;
				&lt;/xsl:if&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="/n1:ClinicalDocument/n1:effectiveTime[@value]"&gt;
				&lt;xsl:text&gt; от &lt;/xsl:text&gt;
				&lt;!-- Архаичный вариант --&gt;
				&lt;xsl:if test="/n1:ClinicalDocument/n1:effectiveTime[@value]"&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:effectiveTime/@value,7,2)"/&gt;
					&lt;xsl:text&gt;.&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:effectiveTime/@value,5,2)"/&gt;
					&lt;xsl:text&gt;.&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:effectiveTime/@value,1,4)"/&gt;
				&lt;/xsl:if&gt;
			&lt;/xsl:when&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:variable&gt;
	&lt;xsl:template match="/"&gt;
		&lt;xsl:apply-templates select="n1:ClinicalDocument"/&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:ClinicalDocument"&gt;
		&lt;html&gt;
			&lt;head&gt;
				&lt;title&gt;
					&lt;xsl:value-of select="$title"/&gt;
				&lt;/title&gt;
				&lt;style type="text/css" media="screen"&gt;
        
					table.outer
					{
					width:100%;
					cellspacing:0;
					cellpadding:0;
					border: solid 1px #dcdcdc;
					border-collapse: collapse;  
					} 
					
					td.outer , th.outer 
					{
					font: 14px Arial, Helvetica, sans-serif;
					color: #003366;
					background: #fff;
					border: solid 1px #dcdcdc;
					}   
					
					th.outer
					{
					background: #EEEEEE;
					}
					
					td.outer
					{           
					background: #fff;
					}	
				
					table.Sections
					{
					border: none;
					border-collapse: collapse;  
					width: 100% ;
					margins: 0,0,0,0;
					padding: 0,0,0,0;
					cellspacing:0;
					}
					
					h2
					{
					font: bold 18px Arial, Helvetica, sans-serif;
					color: #003366;
					text-align: left; 
					}
					
					td.SectionTitle
					{
					border-top: solid 1px #dcdcdc;
					font: bold 14px Arial, Helvetica, sans-serif;
					color: #003366;
					background: #EEEEEE;
					text-align: left;
					}
					
					td.SubSectionTitle
					{
					border:none;
					font: bold 14px Helvetica, sans-serif;
					color: #003366;
					text-align: left; 
					vertical-align : top ;
					padding-right: 2px;
					padding-top: 2px;
					}
					
					td.SubSectionTitle2
					{
					border:none;
							   
					font: bold 14px Helvetica, sans-serif;
					color: #003366;
					text-align: left;
					vertical-align : top ;
					padding-right: 2px;
					padding-top: 2px;
					}
					
					td.SubSectionTitle3
					{
					border:none;
							   
					font: bold 14px Helvetica, sans-serif;
					text-align: left;
					vertical-align : top ;
					padding-right: 2px;
					padding-top: 2px;
					}
					
					td.SubSectionTitle4
					{
					border:none;
							   
					font: bold italic 14px Helvetica, sans-serif;
					text-align: left;
					vertical-align : top ;
					padding-right: 2px;
					padding-top: 2px;
					}
					
					td.Rest
					{
					border-top: none;
					border-right: none;
					border-bottom: none;
					border-left: none;
					font: 14px Arial, Helvetica, sans-serif;
					color: #003366;
					text-align: bottom; 
					}
					
					tr
					{
					vertical-align:top;
					}
					
					table.inner
					{
					cellspacing:2;
					cellpadding:2;
					border: solid 1px #dcdcdc; &lt;!-- убрать для отключения видимости границ --&gt;
					border-collapse: collapse;
					} 
					
					table.inner th, table.inner td, table.inner tr
					{
					font: 14px Arial, Helvetica, sans-serif;
					color: #003366;
					border: solid 1px #dcdcdc; &lt;!-- убрать для отключения видимости границ --&gt;
					padding: 2px 2px; 
					}   
					
					th.inner
					{
					background: #EEEEEE;
					}
					
					td.inner
					{    
					background: #fff;
					}
					
					.col1
					{
					width: 15%;
					}
					
					.col2
					{
					width:85%;
					}
					
					.tdCol1
					{
					text-align: left;
					font-weight: bold; 
					}
					
					.tdCol2
					{
					text-align: left;
					}
							
				&lt;/style&gt;
			&lt;/head&gt;
			&lt;body&gt;
				&lt;table class="outer" width="100%"&gt;
					&lt;col width="15%"/&gt;
					&lt;col width="85%"/&gt;
					&lt;tr class="outer"&gt;
						&lt;th class="outer" width="15%"&gt;Медицинская организация&lt;/th&gt;
						&lt;td class="outer"&gt;
							&lt;!-- Наименование медицинской организации --&gt;
							&lt;strong&gt;Наименование: &lt;/strong&gt;
							&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:name"/&gt;
							&lt;!-- Адрес медицинской организации --&gt;
							&lt;xsl:choose&gt;
								&lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:addr and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:addr[@nullFlavor])"&gt;
									&lt;br/&gt;
									&lt;strong&gt;Адрес: &lt;/strong&gt;
									&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:addr"/&gt;
								&lt;/xsl:when&gt;
								&lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:addr[@nullFlavor]"&gt;
									&lt;br/&gt;
									&lt;strong&gt;Адрес: &lt;/strong&gt;
									&lt;xsl:call-template name="translateNullFlavor"&gt;
										&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:addr/@nullFlavor"/&gt;
									&lt;/xsl:call-template&gt;
								&lt;/xsl:when&gt;
							&lt;/xsl:choose&gt;
							&lt;!-- Лицензия медицинской организации --&gt;
							&lt;xsl:call-template name="getLO"&gt;
								&lt;xsl:with-param name="Id" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:id[2]"/&gt;
							&lt;/xsl:call-template&gt;
							&lt;!-- Реквизиты медицинской организации --&gt;
							&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props[@nullFlavor])"&gt;
								&lt;br/&gt;
							&lt;/xsl:if&gt;
							&lt;!-- ОГРН --&gt;
							&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Ogrn"&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Ogrn[@nullFlavor])"&gt;
										&lt;strong&gt;ОГРН: &lt;/strong&gt;
										&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Ogrn"/&gt;
									&lt;/xsl:when&gt;
									&lt;!-- &lt;xsl:otherwise&gt;
										&lt;strong&gt;ОГРН: &lt;/strong&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Ogrn/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:otherwise&gt; --&gt;
								&lt;/xsl:choose&gt;
								&lt;xsl:text&gt; &lt;/xsl:text&gt;
							&lt;/xsl:if&gt;
							&lt;!-- ОГРНИП --&gt;
							&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Ogrnip"&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Ogrnip[@nullFlavor])"&gt;
										&lt;strong&gt;ОГРНИП: &lt;/strong&gt;
										&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Ogrnip"/&gt;
									&lt;/xsl:when&gt;
									&lt;!-- &lt;xsl:otherwise&gt;
										&lt;strong&gt;ОГРНИП: &lt;/strong&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Ogrnip/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:otherwise&gt;  --&gt;
								&lt;/xsl:choose&gt;
								&lt;xsl:text&gt; &lt;/xsl:text&gt;
							&lt;/xsl:if&gt;
							&lt;!-- ОКПО --&gt;
							&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okpo"&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okpo[@nullFlavor])"&gt;
										&lt;strong&gt;ОКПО: &lt;/strong&gt;
										&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okpo"/&gt;
									&lt;/xsl:when&gt;
									&lt;!-- &lt;xsl:otherwise&gt;
										&lt;strong&gt;ОКПО: &lt;/strong&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okpo/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:otherwise&gt;--&gt;
								&lt;/xsl:choose&gt;
								&lt;xsl:text&gt; &lt;/xsl:text&gt;
							&lt;/xsl:if&gt;
							&lt;!-- ОКАТО --&gt;
							&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okato"&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okato[@nullFlavor])"&gt;
									&lt;strong&gt;ОКАТО: &lt;/strong&gt;
										&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okato"/&gt;
									&lt;/xsl:when&gt;
								&lt;!-- 	&lt;xsl:otherwise&gt;
										&lt;strong&gt;ОКАТО: &lt;/strong&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okato/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:otherwise&gt;--&gt;
								&lt;/xsl:choose&gt;
								&lt;xsl:text&gt; &lt;/xsl:text&gt;
							&lt;/xsl:if&gt;
							&lt;!-- Контакты медицинской организации --&gt;
							&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:telecom"&gt;
								&lt;br/&gt;
								&lt;strong&gt;Контакты: &lt;/strong&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:telecom[@nullFlavor])"&gt;
										&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:telecom"/&gt;
									&lt;/xsl:when&gt;
									&lt;xsl:otherwise&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/n1:telecom/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:otherwise&gt;
								&lt;/xsl:choose&gt;
							&lt;/xsl:if&gt;
							&lt;br/&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/table&gt;
				&lt;!-- Заголовок --&gt;
				&lt;h2&gt;
					&lt;xsl:value-of select="$title"/&gt;
				&lt;/h2&gt;
				&lt;!-- Сведения о документируемом событии --&gt;
				&lt;!-- &lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf"&gt;
					&lt;table class="outer" width="100%"&gt;
						&lt;col width="15%"/&gt;
						&lt;col width="85%"/&gt;
						&lt;tr class="outer"&gt;
							&lt;th class="outer" width="15%"&gt;
								&lt;xsl:value-of select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:code/@displayName"/&gt;
							&lt;/th&gt;
							&lt;td class="outer"&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime[@value]"&gt;
										&lt;strong&gt;Дата проведения: &lt;/strong&gt;
										&lt;xsl:call-template name="formatDateNoText"&gt;
											&lt;xsl:with-param name="date" select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/@value"/&gt;
											&lt;xsl:with-param name="presicion" select="12"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:when&gt;
									&lt;xsl:when test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime[@nullFlavor]"&gt;
										&lt;strong&gt;Дата проведения: &lt;/strong&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:when&gt;
									&lt;xsl:when test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:low or /n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high"&gt;
										&lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:low[@value]"&gt;
											&lt;strong&gt;Дата начала: &lt;/strong&gt;
											&lt;xsl:call-template name="formatDateNoText"&gt;
												&lt;xsl:with-param name="date" select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:low/@value"/&gt;
												&lt;xsl:with-param name="presicion" select="12"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:if&gt;
										&lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:low[@nullFlavor]"&gt;
											&lt;strong&gt;Дата начала: &lt;/strong&gt;
											&lt;xsl:call-template name="translateNullFlavor"&gt;
												&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:low/@nullFlavor"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:if&gt;
										&lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high[@value]"&gt;
											&lt;br/&gt;
											&lt;strong&gt;Дата окончания: &lt;/strong&gt;
											&lt;xsl:call-template name="formatDateNoText"&gt;
												&lt;xsl:with-param name="date" select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high/@value"/&gt;
												&lt;xsl:with-param name="presicion" select="12"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:if&gt;
										&lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high[@nullFlavor]"&gt;
											&lt;br/&gt;
											&lt;strong&gt;Дата окончания: &lt;/strong&gt;
											&lt;xsl:call-template name="translateNullFlavor"&gt;
												&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high/@nullFlavor"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:if&gt;
									&lt;/xsl:when&gt;
								&lt;/xsl:choose&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/table&gt;
					&lt;br/&gt;
				&lt;/xsl:if&gt; --&gt;
				&lt;!-- Сведения об участниках документируемого события --&gt;
				&lt;!-- &lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:performer"&gt;
					&lt;table class="outer" width="100%"&gt;
						&lt;col width="15%"/&gt;
						&lt;col width="85%"/&gt;
						&lt;xsl:for-each select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:performer"&gt;
							&lt;tr class="outer"&gt;
								&lt;th class="outer" width="15%"&gt;
									&lt;xsl:value-of select="n1:functionCode/@displayName"/&gt;
								&lt;/th&gt;
								&lt;td class="outer"&gt;
									&lt;strong&gt;Должность, ФИО: &lt;/strong&gt;
									&lt;xsl:call-template name="translateCode"&gt;
										&lt;xsl:with-param name="code" select="n1:assignedEntity/n1:code"/&gt;
									&lt;/xsl:call-template&gt;
									&lt;xsl:text&gt;, &lt;/xsl:text&gt;
									&lt;xsl:call-template name="getName"&gt;
										&lt;xsl:with-param name="name" select="n1:assignedEntity/n1:assignedPerson/n1:name"/&gt;
									&lt;/xsl:call-template&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/xsl:for-each&gt;
					&lt;/table&gt;
					&lt;br/&gt;
				&lt;/xsl:if&gt; --&gt;
				&lt;!-- Сведения о медицинской карте --&gt;
				&lt;!-- &lt;xsl:if test="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2]"&gt;
					&lt;br/&gt;
					&lt;table class="outer" width="100%"&gt;
						&lt;col width="15%"/&gt;
						&lt;col width="85%"/&gt;
						&lt;tr class="outer"&gt;
							&lt;th class="outer" width="15%"&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:code[@nullFlavor])"&gt;
										&lt;xsl:if test="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:code/@code='1'"&gt;
											&lt;xsl:text&gt;Амбулаторная медицинская карта&lt;/xsl:text&gt;
										&lt;/xsl:if&gt;
										&lt;xsl:if test="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:code/@code='2'"&gt;
											&lt;xsl:text&gt;Стационарная медицинская карта&lt;/xsl:text&gt;
										&lt;/xsl:if&gt;
										&lt;xsl:if test="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:code/@code='3' and 
													  not(/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/medService:DocType[@nullFlavor])"&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/medService:DocType/@displayName"/&gt;
										&lt;/xsl:if&gt;
										&lt;xsl:if test="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:code/@code='3' and 
													  /n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/medService:DocType[@nullFlavor]"&gt;
											&lt;xsl:text&gt;Медицинская карта&lt;/xsl:text&gt;
										&lt;/xsl:if&gt;
									&lt;/xsl:when&gt;
								&lt;/xsl:choose&gt;
							&lt;/th&gt;
							&lt;td class="outer"&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2][@nullFlavor])"&gt;
										&lt;strong&gt;Номер: &lt;/strong&gt;
										&lt;xsl:value-of select="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2]/@extension"/&gt;
									&lt;/xsl:when&gt;
									&lt;xsl:otherwise&gt;
										&lt;strong&gt;Номер: &lt;/strong&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2]/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:otherwise&gt;
								&lt;/xsl:choose&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/table&gt;
					&lt;br/&gt;
				&lt;/xsl:if&gt; --&gt;
				&lt;!-- Сведения о пациенте --&gt;
				&lt;table class="outer" width="100%"&gt;
					&lt;col width="15%"/&gt;
					&lt;col width="85%"/&gt;
					&lt;tr class="outer"&gt;
						&lt;th class="outer" width="15%"&gt;
							&lt;xsl:text&gt;Пациент&lt;/xsl:text&gt;
						&lt;/th&gt;
						&lt;td class="outer"&gt;
							&lt;!-- ФИО пациента --&gt;
							&lt;xsl:choose&gt;
								&lt;!-- Для документов, где часть информации может отсутствовать --&gt;
								&lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:family[@nullFlavor] or /n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:given[@nullFlavor]"&gt;
									&lt;strong&gt;Фамилия: &lt;/strong&gt;
									&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:family[@nullFlavor])"&gt;
										&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:family"/&gt;
									&lt;/xsl:if&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:family[@nullFlavor]"&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:family/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:if&gt;
									&lt;br/&gt;
									&lt;strong&gt;Имя: &lt;/strong&gt;
									&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:given[@nullFlavor])"&gt;
										&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:given"/&gt;
									&lt;/xsl:if&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:given[@nullFlavor]"&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name/n1:given/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:if&gt;
								&lt;/xsl:when&gt;
								&lt;!-- В нормальном случае --&gt;
								&lt;xsl:otherwise&gt;
									&lt;strong&gt;ФИО: &lt;/strong&gt;
									&lt;xsl:call-template name="getName"&gt;
										&lt;xsl:with-param name="name" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:name"/&gt;
									&lt;/xsl:call-template&gt;
								&lt;/xsl:otherwise&gt;
							&lt;/xsl:choose&gt;
							&lt;!-- Пол пациента --&gt;
							&lt;xsl:choose&gt;
								&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:administrativeGenderCode[@nullFlavor])"&gt;
									&lt;br/&gt;
									&lt;strong&gt;Пол: &lt;/strong&gt;
									&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:administrativeGenderCode/@displayName"/&gt;
								&lt;/xsl:when&gt;
								&lt;!-- &lt;xsl:otherwise&gt;
									&lt;br/&gt;
									&lt;strong&gt;Пол: &lt;/strong&gt;
									&lt;xsl:call-template name="translateNullFlavor"&gt;
										&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:administrativeGenderCode/@nullFlavor"/&gt;
									&lt;/xsl:call-template&gt;
								&lt;/xsl:otherwise&gt; --&gt;
							&lt;/xsl:choose&gt;
							&lt;!-- Дата рождения пациента --&gt;
							&lt;xsl:choose&gt;
								&lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime[@value] and
												(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high[@value] or /n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime[@value] or 
												 /n1:ClinicalDocument/n1:effectiveTime[@value])"&gt;
									&lt;br/&gt;
									&lt;strong&gt; Дата рождения (возраст): &lt;/strong&gt;
									&lt;xsl:choose&gt;
										&lt;xsl:when test="string-length(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value)&gt;=8"&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value,7,2)"/&gt;
											&lt;xsl:text&gt;.&lt;/xsl:text&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value,5,2)"/&gt;
											&lt;xsl:text&gt;.&lt;/xsl:text&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value,1,4)"/&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:when test="string-length(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value)=4"&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value,1,4)"/&gt;
										&lt;/xsl:when&gt;
									&lt;/xsl:choose&gt;
									&lt;xsl:text&gt; (&lt;/xsl:text&gt;
									&lt;xsl:choose&gt;
										&lt;!-- Если документируемое событие продолжительное --&gt;
										&lt;xsl:when test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high[@value]"&gt;
											&lt;xsl:call-template name="getAge"&gt;
												&lt;xsl:with-param name="Birthday" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value"/&gt;
												&lt;xsl:with-param name='ServiceDate' select="substring(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/n1:high/@value,1,8)"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:when&gt;
										&lt;!-- Если дата начала и окончания документируемого события совпадают --&gt;
										&lt;xsl:when test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime[@value]"&gt;
											&lt;xsl:call-template name="getAge"&gt;
												&lt;xsl:with-param name="Birthday" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value"/&gt;
												&lt;xsl:with-param name='ServiceDate' select="substring(/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:effectiveTime/@value,1,8)"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:when&gt;
										&lt;!-- Архаичный вариант --&gt;
										&lt;xsl:when test="/n1:ClinicalDocument/n1:effectiveTime[@value]"&gt;
											&lt;xsl:call-template name="getAge"&gt;
												&lt;xsl:with-param name="Birthday" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value"/&gt;
												&lt;xsl:with-param name='ServiceDate' select="substring(/n1:ClinicalDocument/n1:effectiveTime/@value,1,8)"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:when&gt;
									&lt;/xsl:choose&gt;
									&lt;xsl:text&gt; лет)&lt;/xsl:text&gt;
								&lt;/xsl:when&gt;
								&lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime[@value]"&gt;
									&lt;br/&gt;
									&lt;strong&gt; Дата рождения: &lt;/strong&gt;
									&lt;xsl:choose&gt;
										&lt;xsl:when test="string-length(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value)&gt;=8"&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value,7,2)"/&gt;
											&lt;xsl:text&gt;.&lt;/xsl:text&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value,5,2)"/&gt;
											&lt;xsl:text&gt;.&lt;/xsl:text&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value,1,4)"/&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:when test="string-length(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value)=4"&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@value,1,4)"/&gt;
										&lt;/xsl:when&gt;
									&lt;/xsl:choose&gt;
								&lt;/xsl:when&gt;
								&lt;!-- &lt;xsl:otherwise&gt;
									&lt;br/&gt;
									&lt;strong&gt; Дата рождения: &lt;/strong&gt;
									&lt;xsl:call-template name="translateNullFlavor"&gt;
										&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthplace/@nullFlavor"/&gt;
									&lt;/xsl:call-template&gt;
								&lt;/xsl:otherwise&gt; --&gt;
							&lt;/xsl:choose&gt;
							&lt;!-- Место рождения --&gt;
							&lt;xsl:choose&gt;
								&lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthplace"&gt;
									&lt;br/&gt;
									&lt;strong&gt;Место рождения: &lt;/strong&gt;
									&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthplace[@nullFlavor])"&gt;
										&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthplace/n1:place/n1:addr/n1:streetAddressLine"/&gt;
									&lt;/xsl:if&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthplace[@nullFlavor]"&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:birthTime/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:if&gt;
								&lt;/xsl:when&gt;
							&lt;/xsl:choose&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;!-- Идентификаторы пациента --&gt;
					&lt;xsl:if test="(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:id[2] and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:id[2][@nullFlavor])) or
								  (/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2] and not(/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2][@nullFlavor])) or
								  (/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:IdentityDocType/@code='1') or
								  (/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:IdentityDocType/@code='2') or 
								  not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy[@nullFlavor])"&gt;
						&lt;tr class="outer"&gt;
							&lt;th class="outer" width="15%"&gt;
								&lt;xsl:text&gt;Идентификаторы пациента&lt;/xsl:text&gt;
							&lt;/th&gt;
							&lt;td class="outer"&gt;
								&lt;!-- СНИЛС --&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:id[2][@nullFlavor])"&gt;
										&lt;xsl:call-template name="getId"&gt;
											&lt;xsl:with-param name="Id" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:id[2]"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:when&gt;
									&lt;xsl:otherwise&gt;
										&lt;strong&gt;СНИЛС: &lt;/strong&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:id[2]/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
										&lt;br/&gt;
									&lt;/xsl:otherwise&gt;
								&lt;/xsl:choose&gt;
								&lt;!-- Номер медицинской карты --&gt;
								&lt;xsl:if test="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2]"&gt;
									&lt;xsl:choose&gt;
										&lt;xsl:when test="not(/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2][@nullFlavor])"&gt;
											&lt;strong&gt;Номер медицинской карты: &lt;/strong&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2]/@extension"/&gt;
											&lt;br/&gt;
										&lt;/xsl:when&gt;
										&lt;!-- &lt;xsl:otherwise&gt;
											&lt;strong&gt;Номер медицинской карты: &lt;/strong&gt;
											&lt;xsl:call-template name="translateNullFlavor"&gt;
												&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:componentOf/n1:encompassingEncounter/n1:id[2]/@nullFlavor"/&gt;
												&lt;br/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:otherwise&gt; --&gt;
									&lt;/xsl:choose&gt;
								&lt;/xsl:if&gt;
								&lt;!-- Страховой полис --&gt;
								&lt;xsl:if test="/n1:ClinicalDocument/n1:participant[@typeCode='IND'] or not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy[@nullFlavor])"&gt;
									&lt;xsl:choose&gt;
										&lt;!-- Из блока "Сведения об источнике оплаты" - Средства обязательного медицинского страхования --&gt;
										&lt;xsl:when test="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:IdentityDocType/@code='1'"&gt;
											&lt;!-- Тип полиса ОМС --&gt;
											&lt;strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:InsurancePolicyType/@displayName"/&gt;: 
											&lt;/strong&gt;
											&lt;!-- Серия --&gt;
											&lt;xsl:if test=" not(/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:Series[@nullFlavor])"&gt;
												&lt;xsl:text&gt;серия: &lt;/xsl:text&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:Series"/&gt;
												&lt;xsl:text&gt;, номер: &lt;/xsl:text&gt;
											&lt;/xsl:if&gt;
											&lt;!-- Номер --&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:Number"/&gt;
											&lt;!-- Страховая организация --&gt;
											&lt;xsl:if test="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/n1:scopingOrganization"&gt;
												&lt;xsl:text&gt; (&lt;/xsl:text&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/n1:scopingOrganization/n1:name"/&gt;
												&lt;xsl:text&gt;)&lt;/xsl:text&gt;
											&lt;/xsl:if&gt;
										&lt;/xsl:when&gt;
										&lt;!-- Из блока "Сведения об источнике оплаты" - Средства добровольного медицинского страхования --&gt;
										&lt;xsl:when test="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:IdentityDocType/@code='2'"&gt;
											&lt;strong&gt;Полис ДМС: &lt;/strong&gt;
											&lt;!-- Серия --&gt;
											&lt;xsl:if test="not(/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:Series[@nullFlavor])"&gt;
												&lt;xsl:text&gt;серия: &lt;/xsl:text&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/identity:Series"/&gt;
												&lt;xsl:text&gt;, номер: &lt;/xsl:text&gt;
											&lt;/xsl:if&gt;
											&lt;!-- Номер --&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:Number"/&gt;
											&lt;!-- Страховая организация --&gt;
											&lt;xsl:if test="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/identity:DocInfo/n1:scopingOrganization"&gt;
												&lt;xsl:text&gt; (&lt;/xsl:text&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/participant[@typeCode='IND']/n1:associatedEntity/n1:scopingOrganization/n1:name"/&gt;
												&lt;xsl:text&gt;)&lt;/xsl:text&gt;
											&lt;/xsl:if&gt;
										&lt;/xsl:when&gt;
										&lt;!-- Из блока "Сведения о пациенте" --&gt;
										&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy[@nullFlavor])"&gt;
											&lt;!-- Тип полиса ОМС --&gt;
											&lt;strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy/identity:InsurancePolicyType/@displayName"/&gt;: 
											&lt;/strong&gt;
											&lt;!-- Серия --&gt;
											&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy/identity:Series[@nullFlavor]) and /n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy/identity:Series"&gt;
												&lt;xsl:text&gt;серия: &lt;/xsl:text&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy/identity:Series"/&gt;
												&lt;xsl:text&gt;, номер: &lt;/xsl:text&gt;
											&lt;/xsl:if&gt;
											&lt;!-- Номер --&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy/identity:Number"/&gt;
										&lt;/xsl:when&gt;
										&lt;!-- Сведения о страховом медицинском полисе не указаны (если на это требуется обратить внимание) (прим.: также убрать обертку xsl:if перед текущим &lt;tr class="outer"&gt;) --&gt;
										&lt;!-- &lt;xsl:otherwise&gt;
											&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy[@nullFlavor]"&gt;
												&lt;strong&gt;Страховой медицинский полис: &lt;/strong&gt;
												&lt;xsl:call-template name="translateNullFlavor"&gt;
													&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:InsurancePolicy/@nullFlavor"/&gt;
												&lt;/xsl:call-template&gt;
											&lt;/xsl:if&gt;
										&lt;/xsl:otherwise&gt; --&gt;
									&lt;/xsl:choose&gt;
								&lt;/xsl:if&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/xsl:if&gt;
					&lt;!-- Документ, удостоверяющий личность --&gt;
					&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc[@nullFlavor])"&gt;
						&lt;tr class="outer"&gt;
							&lt;th class="outer" width="15%"&gt;
								&lt;xsl:text&gt;Документ, удостоверяющий личность&lt;/xsl:text&gt;
							&lt;/th&gt;
							&lt;td class="outer"&gt;
								&lt;strong&gt;Тип документа: &lt;/strong&gt;
								&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:IdentityCardType/@displayName"/&gt;
								&lt;br/&gt;
								&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:Series[@nullFlavor])"&gt;
									&lt;strong&gt;Серия: &lt;/strong&gt;
									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:Series"/&gt;
									&lt;xsl:text&gt; &lt;/xsl:text&gt;
								&lt;/xsl:if&gt;
								&lt;strong&gt;Номер: &lt;/strong&gt;
								&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:Number"/&gt;
								&lt;strong&gt; Дата выдачи: &lt;/strong&gt;
								&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:IssueDate/@value,7,2)"/&gt;
								&lt;xsl:text&gt;.&lt;/xsl:text&gt;
								&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:IssueDate/@value,5,2)"/&gt;
								&lt;xsl:text&gt;.&lt;/xsl:text&gt;
								&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:IssueDate/@value,1,4)"/&gt;
								&lt;br/&gt;
								&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:Series[@nullFlavor])"&gt;
									&lt;strong&gt;Кем выдан: &lt;/strong&gt;
									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:IssueOrgName"/&gt;
								&lt;/xsl:if&gt;
								&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:IssueOrgCode[@nullFlavor])"&gt;
									&lt;xsl:text&gt;, код подразделения &lt;/xsl:text&gt;
									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/identity:IssueOrgCode"/&gt;
								&lt;/xsl:if&gt;
								&lt;br/&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/xsl:if&gt;
					&lt;!-- Документ, удостоверяющий личность (при отсутствии информации, если на это требуется обратить внимание) --&gt;
					&lt;!-- &lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc[@nullFlavor]"&gt;
						&lt;tr class="outer"&gt;
							&lt;th class="outer" width="15%"&gt;
								&lt;xsl:text&gt;Документ, удостоверяющий личность&lt;/xsl:text&gt;
							&lt;/th&gt;
							&lt;td class="outer"&gt;
								&lt;xsl:call-template name="translateNullFlavor"&gt;
									&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/identity:IdentityDoc/@nullFlavor"/&gt;
								&lt;/xsl:call-template&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/xsl:if&gt; --&gt;
					&lt;!-- Контактная информация пациента --&gt;
					&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr[@nullFlavor]) or /n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:telecom"&gt;
						&lt;tr class="outer"&gt;
							&lt;th class="outer" width="15%"&gt;
								&lt;xsl:text&gt;Контактная информация&lt;/xsl:text&gt;
							&lt;/th&gt;
							&lt;td class="outer"&gt;
								&lt;!-- Адрес пациента --&gt;
								&lt;xsl:for-each select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr"&gt;
									&lt;xsl:choose&gt;
										&lt;xsl:when test="@nullFlavor"&gt;
											&lt;strong&gt;Адрес: &lt;/strong&gt;
											&lt;xsl:call-template name="translateNullFlavor"&gt;
												&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr/@nullFlavor"/&gt;
											&lt;/xsl:call-template&gt;
											&lt;br/&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:when test="address:Type[@code='1']"&gt;
											&lt;strong&gt;Адрес постоянной регистрации: &lt;/strong&gt;
											&lt;br/&gt;
											&lt;xsl:apply-templates select="."/&gt;
											&lt;br/&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:when test="address:Type[@code='2']"&gt;
											&lt;strong&gt;Адрес временной регистрации: &lt;/strong&gt;
											&lt;br/&gt;
											&lt;xsl:apply-templates select="."/&gt;
											&lt;br/&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:when test="address:Type[@code='3']"&gt;
											&lt;strong&gt;Адрес фактического проживания: &lt;/strong&gt;
											&lt;br/&gt;
											&lt;xsl:apply-templates select="."/&gt;
											&lt;br/&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:when test="address:Type[@code='4']"&gt;
											&lt;strong&gt;Адрес места работы (учебы): &lt;/strong&gt;
											&lt;br/&gt;
											&lt;xsl:apply-templates select="."/&gt;
											&lt;br/&gt;
										&lt;/xsl:when&gt;
									&lt;/xsl:choose&gt;
								&lt;/xsl:for-each&gt;
								&lt;!-- Вид места жительства (городская или сельская местность) --&gt;
								&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr/address:residentCode"&gt;
									&lt;strong&gt;Вид места жительства: &lt;/strong&gt;
									&lt;xsl:choose&gt;
										&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr/address:residentCode[@nullFlavor])"&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr/address:residentCode/@code"/&gt;
											&lt;text&gt; (&lt;/text&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr/address:residentCode/@displayName"/&gt;
											&lt;text&gt;)&lt;/text&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:otherwise&gt;
											&lt;xsl:call-template name="translateNullFlavor"&gt;
												&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr/address:residentCode/@nullFlavor"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:otherwise&gt;
									&lt;/xsl:choose&gt;
									&lt;br/&gt;
								&lt;/xsl:if&gt;
								&lt;!-- Контакты пациента --&gt;
								&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:telecom"&gt;
									&lt;strong&gt;Контакты: &lt;/strong&gt;
									&lt;xsl:choose&gt;
										&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:telecom[@nullFlavor])"&gt;
											&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:telecom"/&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:otherwise&gt;
											&lt;xsl:call-template name="translateNullFlavor"&gt;
												&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:telecom/@nullFlavor"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:otherwise&gt;
									&lt;/xsl:choose&gt;
								&lt;/xsl:if&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/xsl:if&gt;
					&lt;!-- Сведения об источнике оплаты --&gt;
					&lt;!-- &lt;xsl:if test="/n1:ClinicalDocument/n1:participant[@typeCode='IND']"&gt;
						&lt;tr class="outer"&gt;
							&lt;th class="outer" width="15%"&gt;
								&lt;xsl:text&gt;Сведения об источнике оплаты&lt;/xsl:text&gt;
							&lt;/th&gt;
							&lt;td class="outer"&gt;
								&lt;strong&gt;Вид оплаты: &lt;/strong&gt;
								&lt;xsl:value-of select="/n1:ClinicalDocument/n1:participant[@typeCode='IND']/n1:associatedEntity/n1:code/@displayName"/&gt;
							&lt;/td&gt;
						&lt;/tr&gt; 
					&lt;/xsl:if&gt; --&gt;
				&lt;/table&gt;
				&lt;!-- Сведения о законном (уполномоченном) представителе пациента --&gt;
				&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian[@nullFlavor])"&gt;
					&lt;br/&gt;
					&lt;table class="outer" width="100%"&gt;
						&lt;col width="15%"/&gt;
						&lt;col width="85%"/&gt;
						&lt;!-- Законный (уполномоченный) представитель гражданина --&gt;
						&lt;tr class="outer"&gt;
							&lt;th class="outer" width="15%"&gt;
								&lt;xsl:text&gt;Законный (уполномоченный) представитель гражданина&lt;/xsl:text&gt;
							&lt;/th&gt;
							&lt;td class="outer"&gt;
								&lt;!-- Тип связи между представителем (физическое лицо) и гражданином --&gt;
								&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:code and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:code[@nullFlavor])"&gt;
									&lt;strong&gt;Тип связи с гражданином: &lt;/strong&gt;
									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:code/@displayName"/&gt;
									&lt;br/&gt;
								&lt;/xsl:if&gt;
								&lt;!-- ФИО представителя --&gt;
								&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianPerson/n1:name and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianPerson/n1:name[@nullFlavor])"&gt;
									&lt;strong&gt;ФИО: &lt;/strong&gt;
									&lt;xsl:call-template name="getName"&gt;
										&lt;xsl:with-param name="name" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianPerson/n1:name"/&gt;
									&lt;/xsl:call-template&gt;
									&lt;br/&gt;
								&lt;/xsl:if&gt;
								&lt;!-- СНИЛС --&gt;
								&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:id and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:id[@nullFlavor])"&gt;
									&lt;xsl:call-template name="getId"&gt;
										&lt;xsl:with-param name="Id" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:id"/&gt;
									&lt;/xsl:call-template&gt;
								&lt;/xsl:if&gt;
								&lt;!-- Дата рождения представителя --&gt;
								&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/PII:birthTime and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/PII:birthTime[@nullFlavor])"&gt;
									&lt;strong&gt;Дата рождения: &lt;/strong&gt;
									&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/PII:birthTime/@value,7,2)"/&gt;
									&lt;xsl:text&gt;.&lt;/xsl:text&gt;
									&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/PII:birthTime/@value,5,2)"/&gt;
									&lt;xsl:text&gt;.&lt;/xsl:text&gt;
									&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/PII:birthTime/@value,1,4)"/&gt;
								&lt;/xsl:if&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;!-- Документ, удостоверяющий личность представителя --&gt;
						&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc[@nullFlavor])"&gt;
							&lt;tr class="outer"&gt;
								&lt;th class="outer" width="15%"&gt;
									&lt;xsl:text&gt;Документ, удостоверяющий личность представителя&lt;/xsl:text&gt;
								&lt;/th&gt;
								&lt;td class="outer"&gt;
									&lt;xsl:choose&gt;
										&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc[@nullFlavor])"&gt;
											&lt;strong&gt;Тип документа: &lt;/strong&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IdentityCardType/@displayName"/&gt;
											&lt;br/&gt;
											&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:Series[@nullFlavor])"&gt;
												&lt;strong&gt;Серия: &lt;/strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:Series"/&gt;
												&lt;xsl:text&gt; &lt;/xsl:text&gt;
											&lt;/xsl:if&gt;
											&lt;strong&gt;Номер: &lt;/strong&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:Number"/&gt;
											&lt;xsl:text&gt; &lt;/xsl:text&gt;
											&lt;strong&gt;Дата выдачи: &lt;/strong&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IssueDate/@value,7,2)"/&gt;
											&lt;xsl:text&gt;.&lt;/xsl:text&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IssueDate/@value,5,2)"/&gt;
											&lt;xsl:text&gt;.&lt;/xsl:text&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IssueDate/@value,1,4)"/&gt;
											&lt;br/&gt;
											&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IssueOrgName[@nullFlavor])"&gt;
												&lt;strong&gt;Кем выдан: &lt;/strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IssueOrgName"/&gt;
											&lt;/xsl:if&gt;
											&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IssueOrgCode[@nullFlavor])"&gt;
												&lt;xsl:text&gt;, код подразделения &lt;/xsl:text&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IssueOrgCode"/&gt;
											&lt;/xsl:if&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:otherwise&gt;
											&lt;strong&gt;Документ, удостоверяющий личность представителя: &lt;/strong&gt;
											&lt;xsl:call-template name="translateNullFlavor"&gt;
												&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/@nullFlavor"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:otherwise&gt;
									&lt;/xsl:choose&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/xsl:if&gt;
						&lt;!-- Документ, удостоверяющий полномочия представителя --&gt;
						&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc[@nullFlavor])"&gt;
							&lt;tr class="outer"&gt;
								&lt;th class="outer" width="15%"&gt;
									&lt;xsl:text&gt;Документ, удостоверяющий полномочия представителя&lt;/xsl:text&gt;
								&lt;/th&gt;
								&lt;td class="outer"&gt;
									&lt;xsl:choose&gt;
										&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc[@nullFlavor])"&gt;
											&lt;strong&gt;Тип документа: &lt;/strong&gt;
											&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:IdentityCardType/@displayName"/&gt;
											&lt;br/&gt;
											&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:Series[@nullFlavor])"&gt;
												&lt;strong&gt;Серия: &lt;/strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:Series"/&gt;
												&lt;xsl:text&gt; &lt;/xsl:text&gt;
											&lt;/xsl:if&gt;
											&lt;strong&gt;Номер: &lt;/strong&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:Number"/&gt;
											&lt;xsl:text&gt; &lt;/xsl:text&gt;
											&lt;strong&gt;Дата выдачи: &lt;/strong&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:IssueDate/@value,7,2)"/&gt;
											&lt;xsl:text&gt;.&lt;/xsl:text&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:IssueDate/@value,5,2)"/&gt;
											&lt;xsl:text&gt;.&lt;/xsl:text&gt;
											&lt;xsl:value-of select="substring(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:IssueDate/@value,1,4)"/&gt;
											&lt;br/&gt;
											&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:IssueOrgName[@nullFlavor])"&gt;
												&lt;strong&gt;Кем выдан: &lt;/strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/identity:IssueOrgName"/&gt;
											&lt;/xsl:if&gt;
										&lt;/xsl:when&gt;
										&lt;xsl:otherwise&gt;
											&lt;strong&gt;Документ, удостоверяющий полномочия представителя: &lt;/strong&gt;
											&lt;xsl:call-template name="translateNullFlavor"&gt;
												&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:AuthorityDoc/@nullFlavor"/&gt;
											&lt;/xsl:call-template&gt;
										&lt;/xsl:otherwise&gt;
									&lt;/xsl:choose&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/xsl:if&gt;
						&lt;!-- Контактная информация представителя --&gt;
						&lt;xsl:if test="(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:addr and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:addr[@nullFlavor])) or
									  (/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:telecom and not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:telecom[@nullFlavor]))"&gt;
							&lt;tr class="outer"&gt;
								&lt;th class="outer" width="15%"&gt;
									&lt;xsl:text&gt;Контактная информация&lt;/xsl:text&gt;
								&lt;/th&gt;
								&lt;td class="outer"&gt;
									&lt;!-- Адрес фактического места жительства --&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:addr"&gt;
										&lt;xsl:choose&gt;
											&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:addr[@nullFlavor])"&gt;
												&lt;strong&gt;Адрес фактического места жительства:&lt;/strong&gt;
												&lt;br/&gt;
												&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:addr"/&gt;
											&lt;/xsl:when&gt;
											&lt;xsl:otherwise&gt;
												&lt;strong&gt;Адрес фактического места жительства: &lt;/strong&gt;
												&lt;xsl:call-template name="translateNullFlavor"&gt;
													&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:addr/@nullFlavor"/&gt;
												&lt;/xsl:call-template&gt;
											&lt;/xsl:otherwise&gt;
										&lt;/xsl:choose&gt;
									&lt;/xsl:if&gt;
									&lt;!-- Контакты --&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:telecom"&gt;
										&lt;br/&gt;
										&lt;strong&gt;Контакты: &lt;/strong&gt;
										&lt;xsl:choose&gt;
											&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:telecom[@nullFlavor])"&gt;
												&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:telecom"/&gt;
											&lt;/xsl:when&gt;
											&lt;xsl:otherwise&gt;
												&lt;xsl:call-template name="translateNullFlavor"&gt;
													&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:telecom/@nullFlavor"/&gt;
												&lt;/xsl:call-template&gt;
											&lt;/xsl:otherwise&gt;
										&lt;/xsl:choose&gt;
									&lt;/xsl:if&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/xsl:if&gt;
						&lt;!-- Сведения об организации-представителе --&gt;
						&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization"&gt;
							&lt;tr class="outer"&gt;
								&lt;th class="outer" width="15%"&gt;
									&lt;xsl:text&gt;Сведения о юридической организации&lt;/xsl:text&gt;
								&lt;/th&gt;
								&lt;td class="outer"&gt;
									&lt;strong&gt;Наименование организации: &lt;/strong&gt;
									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/n1:name"/&gt;
									&lt;!-- Адрес --&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/n1:addr"&gt;
										&lt;br/&gt;
										&lt;xsl:choose&gt;
											&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/n1:addr[@nullFlavor])"&gt;
												&lt;strong&gt;Адрес организации:&lt;/strong&gt;
												&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/n1:addr"/&gt;
											&lt;/xsl:when&gt;
											&lt;xsl:otherwise&gt;
												&lt;strong&gt;Адрес организации: &lt;/strong&gt;
												&lt;xsl:call-template name="translateNullFlavor"&gt;
													&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/n1:addr/@nullFlavor"/&gt;
												&lt;/xsl:call-template&gt;
											&lt;/xsl:otherwise&gt;
										&lt;/xsl:choose&gt;
									&lt;/xsl:if&gt;
									&lt;!-- Реквизиты --&gt;
									&lt;xsl:if test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props[@nullFlavor])"&gt;
										&lt;br/&gt;
									&lt;/xsl:if&gt;
									&lt;!-- ОГРН --&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Ogrn"&gt;
										&lt;xsl:choose&gt;
											&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Ogrn[@nullFlavor])"&gt;
												&lt;strong&gt;ОГРН: &lt;/strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Ogrn"/&gt;
											&lt;/xsl:when&gt;
											&lt;!-- &lt;xsl:otherwise&gt;
												&lt;strong&gt;ОГРН: &lt;/strong&gt;
												&lt;xsl:call-template name="translateNullFlavor"&gt;
													&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Ogrn/@nullFlavor"/&gt;
												&lt;/xsl:call-template&gt;
											&lt;/xsl:otherwise&gt; --&gt;
										&lt;/xsl:choose&gt;
										&lt;xsl:text&gt; &lt;/xsl:text&gt;
									&lt;/xsl:if&gt;
									&lt;!-- ОГРНИП --&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Ogrnip"&gt;
										&lt;xsl:choose&gt;
											&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Ogrnip[@nullFlavor])"&gt;
												&lt;strong&gt;ОГРНИП: &lt;/strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Ogrnip"/&gt;
											&lt;/xsl:when&gt;
											&lt;!-- &lt;xsl:otherwise&gt;
												&lt;strong&gt;ОГРНИП: &lt;/strong&gt;
												&lt;xsl:call-template name="translateNullFlavor"&gt;
													&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Ogrnip/@nullFlavor"/&gt;
												&lt;/xsl:call-template&gt;
											&lt;/xsl:otherwise&gt;  --&gt;
										&lt;/xsl:choose&gt;
										&lt;xsl:text&gt; &lt;/xsl:text&gt;
									&lt;/xsl:if&gt;
									&lt;!-- ОКПО --&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Okpo"&gt;
										&lt;xsl:choose&gt;
											&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Okpo[@nullFlavor])"&gt;
												&lt;strong&gt;ОКПО: &lt;/strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Okpo"/&gt;
											&lt;/xsl:when&gt;
											&lt;!-- &lt;xsl:otherwise&gt;
												&lt;strong&gt;ОКПО: &lt;/strong&gt;
												&lt;xsl:call-template name="translateNullFlavor"&gt;
													&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Okpo/@nullFlavor"/&gt;
												&lt;/xsl:call-template&gt;
											&lt;/xsl:otherwise&gt;--&gt;
										&lt;/xsl:choose&gt;
										&lt;xsl:text&gt; &lt;/xsl:text&gt;
									&lt;/xsl:if&gt;
									&lt;!-- ОКАТО --&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Okato"&gt;
										&lt;xsl:choose&gt;
											&lt;xsl:when test="not(/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Okato[@nullFlavor])"&gt;
											&lt;strong&gt;ОКАТО: &lt;/strong&gt;
												&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:providerOrganization/identity:Props/identity:Okato"/&gt;
											&lt;/xsl:when&gt;
										&lt;!-- 	&lt;xsl:otherwise&gt;
												&lt;strong&gt;ОКАТО: &lt;/strong&gt;
												&lt;xsl:call-template name="translateNullFlavor"&gt;
													&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:guardianOrganization/identity:Props/identity:Okato/@nullFlavor"/&gt;
												&lt;/xsl:call-template&gt;
											&lt;/xsl:otherwise&gt;--&gt;
										&lt;/xsl:choose&gt;
										&lt;xsl:text&gt; &lt;/xsl:text&gt;
									&lt;/xsl:if&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/xsl:if&gt;
					&lt;/table&gt;
				&lt;/xsl:if&gt;
				&lt;!-- Сведения из тела документа --&gt;
				&lt;xsl:apply-templates select="n1:component/n1:structuredBody|n1:component/n1:nonXMLBody"/&gt;
				&lt;!-- После последней секции тела будет пустая строка --&gt;
				&lt;!-- Сведения о дополнительном получателе документа (кроме РЭМД) --&gt;
				&lt;!-- &lt;xsl:if test="/n1:ClinicalDocument/n1:informationRecipient[2]"&gt;
					&lt;table class="outer" width="100%"&gt;
						&lt;col width="15%"/&gt;
						&lt;col width="85%"/&gt;
						&lt;xsl:if test="/n1:ClinicalDocument/n1:informationRecipient[2]"&gt;
							&lt;tr class="outer"&gt;
								&lt;th class="outer" width="15%"&gt;
									&lt;xsl:text&gt;Для представления&lt;/xsl:text&gt;
								&lt;/th&gt;
								&lt;td class="outer"&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:informationRecipient[2]/n1:intendedRecipient/n1:receivedOrganization/n1:name/text()"&gt;
										&lt;xsl:text&gt;в &lt;/xsl:text&gt;
										&lt;xsl:value-of select="/n1:ClinicalDocument/n1:informationRecipient[2]/n1:intendedRecipient/n1:receivedOrganization/n1:name/text()"/&gt;
									&lt;/xsl:if&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/xsl:if&gt;
					&lt;/table&gt;
					&lt;br/&gt;
				&lt;/xsl:if&gt; --&gt;
				&lt;!-- Сведения об участниках документируемого события --&gt;
				&lt;xsl:if test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:performer"&gt;
					&lt;table class="outer" width="100%"&gt;
						&lt;col width="15%"/&gt;
						&lt;col width="85%"/&gt;
						&lt;xsl:for-each select="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent/n1:performer"&gt;
							&lt;tr class="outer"&gt;
								&lt;th class="outer" width="15%"&gt;
									&lt;xsl:value-of select="n1:functionCode/@displayName"/&gt;
								&lt;/th&gt;
								&lt;td class="outer"&gt;
									&lt;strong&gt;Должность, ФИО: &lt;/strong&gt;
									&lt;xsl:call-template name="translateCode"&gt;
										&lt;xsl:with-param name="code" select="n1:assignedEntity/n1:code"/&gt;
									&lt;/xsl:call-template&gt;
									&lt;xsl:text&gt;, &lt;/xsl:text&gt;
									&lt;xsl:call-template name="getName"&gt;
										&lt;xsl:with-param name="name" select="n1:assignedEntity/n1:assignedPerson/n1:name"/&gt;
									&lt;/xsl:call-template&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/xsl:for-each&gt;
					&lt;/table&gt;
					&lt;br/&gt;
				&lt;/xsl:if&gt; 
				&lt;!-- Сведения об авторе и заверителе --&gt;
				&lt;table class="outer" width="100%"&gt;
					&lt;col width="15%"/&gt;
					&lt;col width="85%"/&gt;
					&lt;!-- Сведения об авторе документа --&gt;
					&lt;tr class="outer"&gt;
						&lt;th class="outer" width="15%"&gt;
							&lt;xsl:text&gt;Документ составил&lt;/xsl:text&gt;
						&lt;/th&gt;
						&lt;td class="outer"&gt;
							&lt;strong&gt;Должность, ФИО: &lt;/strong&gt;
							&lt;!-- Должность --&gt;
							&lt;xsl:call-template name="translateCode"&gt;
								&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:author/n1:assignedAuthor/n1:code"/&gt;
							&lt;/xsl:call-template&gt;
							&lt;xsl:text&gt;, &lt;/xsl:text&gt;
							&lt;!-- ФИО --&gt;
							&lt;xsl:call-template name="getName"&gt;
								&lt;xsl:with-param name="name" select="/n1:ClinicalDocument/n1:author/n1:assignedAuthor/n1:assignedPerson/n1:name"/&gt;
							&lt;/xsl:call-template&gt;
							&lt;br/&gt;
							&lt;!-- Контакты --&gt;
							&lt;xsl:if test="/n1:ClinicalDocument/n1:author/n1:assignedAuthor/n1:telecom"&gt;
								&lt;strong&gt;Контакты: &lt;/strong&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:author/n1:assignedAuthor/n1:telecom[@nullFlavor])"&gt;
										&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:author/n1:assignedAuthor/n1:telecom"/&gt;
									&lt;/xsl:when&gt;
									&lt;xsl:otherwise&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:author/n1:assignedAuthor/n1:telecom/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:otherwise&gt;
								&lt;/xsl:choose&gt;
							&lt;/xsl:if&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;!-- Сведения о лице, придавшем юридическую значимость документу --&gt;
					&lt;tr class="outer"&gt;
						&lt;th class="outer" width="15%"&gt;
							&lt;xsl:text&gt;Документ заверил&lt;/xsl:text&gt;
						&lt;/th&gt;
						&lt;td class="outer"&gt;
							&lt;strong&gt;Должность, ФИО: &lt;/strong&gt;
							&lt;!-- Должность --&gt;
							&lt;xsl:call-template name="translateCode"&gt;
								&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:legalAuthenticator/n1:assignedEntity/n1:code"/&gt;
							&lt;/xsl:call-template&gt;
							&lt;xsl:text&gt;, &lt;/xsl:text&gt;
							&lt;!-- ФИО --&gt;
							&lt;xsl:call-template name="getName"&gt;
								&lt;xsl:with-param name="name" select="/n1:ClinicalDocument/n1:legalAuthenticator/n1:assignedEntity/n1:assignedPerson/n1:name"/&gt;
							&lt;/xsl:call-template&gt;
							&lt;br/&gt;
							&lt;!-- Контакты --&gt;
							&lt;xsl:if test="/n1:ClinicalDocument/n1:legalAuthenticator/n1:assignedEntity/n1:telecom"&gt;
								&lt;strong&gt;Контакты: &lt;/strong&gt;
								&lt;xsl:choose&gt;
									&lt;xsl:when test="not(/n1:ClinicalDocument/n1:legalAuthenticator/n1:assignedEntity/n1:telecom[@nullFlavor])"&gt;
										&lt;xsl:apply-templates select="/n1:ClinicalDocument/n1:legalAuthenticator/n1:assignedEntity/n1:telecom"/&gt;
									&lt;/xsl:when&gt;
									&lt;xsl:otherwise&gt;
										&lt;xsl:call-template name="translateNullFlavor"&gt;
											&lt;xsl:with-param name="code" select="/n1:ClinicalDocument/n1:legalAuthenticator/n1:assignedEntity/n1:telecom/@nullFlavor"/&gt;
										&lt;/xsl:call-template&gt;
									&lt;/xsl:otherwise&gt;
								&lt;/xsl:choose&gt;
							&lt;/xsl:if&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/table&gt;
			&lt;/body&gt;
		&lt;/html&gt;
	&lt;/xsl:template&gt;
	&lt;!-- Get a Name  --&gt;
	&lt;xsl:template name="getName"&gt;
		&lt;xsl:param name="name"/&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="$name/n1:family"&gt;
				&lt;xsl:if test="$name/n1:prefix"&gt;
					&lt;xsl:value-of select="$name/n1:prefix"/&gt;
					&lt;xsl:text&gt; &lt;/xsl:text&gt;
				&lt;/xsl:if&gt;
				&lt;xsl:value-of select="$name/n1:family"/&gt;
				&lt;xsl:text&gt; &lt;/xsl:text&gt;
				&lt;xsl:value-of select="$name/n1:given[1]"/&gt;
				&lt;xsl:text&gt; &lt;/xsl:text&gt;
				&lt;xsl:value-of select="$name/identity:Patronymic"/&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;xsl:value-of select="$name"/&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!-- Get a Job  --&gt;
	&lt;xsl:template name="getJob"&gt;
		&lt;xsl:param name="assignedEntity"/&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="$assignedEntity/n1:code"&gt;
				&lt;xsl:value-of select="$assignedEntity/n1:code/@displayName"/&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;xsl:value-of select="$assignedEntity/n1:code/@code"/&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!--  Format Date 
    outputs a date in Day Month Year MM:SS form
    --&gt;
	&lt;xsl:template name="formatDate"&gt;
		&lt;xsl:param name="date"/&gt;
		&lt;xsl:param name="presicion"/&gt;
		&lt;xsl:variable name="dateLength" select="string-length(substring($date,1,$presicion))"/&gt;
		&lt;xsl:if test="$dateLength&gt;=8"&gt;
			&lt;xsl:choose&gt;
				&lt;xsl:when test="substring ($date, 7, 1)='0'"&gt;
					&lt;xsl:value-of select="substring ($date, 8, 1)"/&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:otherwise&gt;
					&lt;xsl:value-of select="substring ($date, 7, 2)"/&gt;
				&lt;/xsl:otherwise&gt;
			&lt;/xsl:choose&gt;
			&lt;xsl:text&gt; &lt;/xsl:text&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:if test="$dateLength&gt;=6"&gt;
			&lt;xsl:variable name="month" select="substring ($date, 5, 2)"/&gt;
			&lt;xsl:choose&gt;
				&lt;xsl:when test="$month='01'"&gt;
					&lt;xsl:text&gt;Января &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='02'"&gt;
					&lt;xsl:text&gt;Февраля &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='03'"&gt;
					&lt;xsl:text&gt;Марта&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='04'"&gt;
					&lt;xsl:text&gt;Апреля &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='05'"&gt;
					&lt;xsl:text&gt;Мая&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='06'"&gt;
					&lt;xsl:text&gt;Июня&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='07'"&gt;
					&lt;xsl:text&gt;Июля &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='08'"&gt;
					&lt;xsl:text&gt;Августа &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='09'"&gt;
					&lt;xsl:text&gt;Сентября &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='10'"&gt;
					&lt;xsl:text&gt;Октября &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='11'"&gt;
					&lt;xsl:text&gt;Ноября &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="$month='12'"&gt;
					&lt;xsl:text&gt;Декабря &lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
			&lt;/xsl:choose&gt;
			&lt;xsl:text&gt; &lt;/xsl:text&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:value-of select="substring ($date, 1, 4)"/&gt;
		&lt;xsl:if test="$dateLength&gt;=12"&gt;
			&lt;xsl:text&gt; &lt;/xsl:text&gt;
			&lt;xsl:choose&gt;
				&lt;xsl:when test="substring ($date, 9, 1)='0'"&gt;
					&lt;xsl:value-of select="substring ($date, 10, 1)"/&gt;
					&lt;xsl:text&gt;:&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring ($date, 11, 2)"/&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:otherwise&gt;
					&lt;xsl:value-of select="substring ($date, 9, 2)"/&gt;
					&lt;xsl:text&gt;:&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring ($date, 11, 2)"/&gt;
				&lt;/xsl:otherwise&gt;
			&lt;/xsl:choose&gt;
			&lt;xsl:text&gt; &lt;/xsl:text&gt;
			&lt;!-- &lt;xsl:value-of select="substring ($date, 13, 5)"/&gt; --&gt;
		&lt;/xsl:if&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template name="formatDateNoText"&gt;
		&lt;xsl:param name="date"/&gt;
		&lt;xsl:param name="presicion"/&gt;
		&lt;!-- Интересующее количество символов --&gt;
		&lt;xsl:variable name="dateLength" select="string-length(substring($date,1,$presicion))"/&gt;
		&lt;!-- День --&gt;
		&lt;xsl:if test="$dateLength&gt;=8"&gt;
			&lt;xsl:choose&gt;
				&lt;xsl:when test="substring ($date, 7, 1)='0'"&gt;
					&lt;xsl:value-of select="substring ($date, 8, 1)"/&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:otherwise&gt;
					&lt;xsl:value-of select="substring($date, 7, 2)"/&gt;
				&lt;/xsl:otherwise&gt;
			&lt;/xsl:choose&gt;
		&lt;/xsl:if&gt;
		&lt;!-- Месяц --&gt;
		&lt;xsl:if test="$dateLength&gt;=6"&gt;
			&lt;xsl:text&gt;.&lt;/xsl:text&gt;
			&lt;xsl:variable name="month" select="substring ($date, 5, 2)"/&gt;
			&lt;xsl:value-of select="$month"/&gt;
			&lt;xsl:text&gt;.&lt;/xsl:text&gt;
		&lt;/xsl:if&gt;
		&lt;!-- Год --&gt;
		&lt;xsl:value-of select="substring ($date, 1, 4)"/&gt;
		&lt;!-- Время --&gt;
		&lt;xsl:if test="$dateLength&gt;=12"&gt;
			&lt;xsl:text&gt; &lt;/xsl:text&gt;
			&lt;xsl:choose&gt;
				&lt;xsl:when test="substring ($date, 9, 1)='0'"&gt;
					&lt;xsl:value-of select="substring ($date, 10, 1)"/&gt;
					&lt;xsl:text&gt;:&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring ($date, 11, 2)"/&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:otherwise&gt;
					&lt;xsl:value-of select="substring ($date, 9, 2)"/&gt;
					&lt;xsl:text&gt;:&lt;/xsl:text&gt;
					&lt;xsl:value-of select="substring ($date, 11, 2)"/&gt;
				&lt;/xsl:otherwise&gt;
			&lt;/xsl:choose&gt;
			&lt;xsl:text&gt; &lt;/xsl:text&gt;
			&lt;!-- &lt;xsl:value-of select="substring ($date, 13, 5)"/&gt; --&gt;
		&lt;/xsl:if&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:component/n1:nonXMLBody"&gt;
		&lt;xsl:choose&gt;
			&lt;!-- if there is a reference, use that in an IFRAME --&gt;
			&lt;xsl:when test="n1:text/n1:reference"&gt;
				&lt;IFRAME name="nonXMLBody" id="nonXMLBody" WIDTH="100%" HEIGHT="66%" src="{n1:text/n1:reference/@value}"/&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="n1:text/@mediaType='text/plain'"&gt;
				&lt;pre&gt;
					&lt;xsl:value-of select="n1:text/text()"/&gt;
				&lt;/pre&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;CENTER&gt;Cannot display the text&lt;/CENTER&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!-- StructuredBody --&gt;
	&lt;xsl:template match="n1:component/n1:structuredBody"&gt;
		&lt;br/&gt;
		&lt;table class="Sections" width="100%"&gt;
			&lt;tbody&gt;
				&lt;xsl:for-each select="n1:component/n1:section"&gt;
					&lt;!-- Фильтр секций, которые отображать не требуется (например, Оказанные медицинские услуги) --&gt;
					&lt;xsl:if test="n1:code/@code!='SERVICES'"&gt;
						&lt;!-- Название секции --&gt;
						&lt;tr&gt;&lt;td class="SectionTitle" colspan="10"&gt;
							&lt;xsl:apply-templates select="n1:title"&gt;
								&lt;xsl:with-param name="code" select="n1:code/@code"/&gt;
							&lt;/xsl:apply-templates&gt;
						&lt;/td&gt;&lt;/tr&gt;
						&lt;!-- Содержимое секции --&gt;
						&lt;tr&gt;&lt;td class="Rest"&gt;
							&lt;!-- Человекочитаемое содержимое секции (разметка структурированного содержимого секции) --&gt;
							&lt;xsl:apply-templates select="n1:text"/&gt;
							&lt;!-- Подсекции 1-го уровня вложенности --&gt;
							&lt;xsl:for-each select="n1:component/n1:section"&gt;
								&lt;!-- Название подсекции 1-го уровня вложенности --&gt;
								&lt;tr&gt;&lt;td class="SubSectionTitle" colspan="8"&gt;
									&lt;xsl:apply-templates select="n1:title"&gt;
										&lt;xsl:with-param name="code" select="n1:code/@code"/&gt;
									&lt;/xsl:apply-templates&gt;
								&lt;/td&gt;&lt;/tr&gt;
								&lt;!-- Содержимое подсекции 1-го уровня вложенности --&gt;
								&lt;tr&gt;&lt;td class="Rest"&gt;
									&lt;!-- Человекочитаемое содержимое подсекции 1-го уровня вложенности (разметка структурированного содержимого подсекции) --&gt;
									&lt;xsl:apply-templates select="n1:text"/&gt;
									&lt;!-- Подсекции 2-го уровня вложенности --&gt;
									&lt;xsl:for-each select="n1:component/n1:section"&gt;
										&lt;!-- Название подсекции 2-го уровня вложенности --&gt;
										&lt;tr&gt;&lt;td class="SubSectionTitle2" colspan="6"&gt;
											&lt;xsl:apply-templates select="n1:title"&gt;
												&lt;xsl:with-param name="code" select="n1:code/@code"/&gt;
											&lt;/xsl:apply-templates&gt;
										&lt;/td&gt;&lt;/tr&gt;
										&lt;!-- Содержимое  подсекции 2-го уровня вложенности--&gt;
										&lt;tr&gt;&lt;td class="Rest"&gt;
											&lt;!-- Человекочитаемое содержимое подсекции 2-го уровня вложенности (разметка структурированного содержимого подсекции) --&gt;
											&lt;xsl:apply-templates select="n1:text"/&gt;
											&lt;!-- Подсекции 3-го уровня вложенности --&gt;
											&lt;xsl:for-each select="n1:component/n1:section"&gt;
												&lt;!-- Название подсекции 3-го уровня вложенности --&gt;
												&lt;tr&gt;&lt;td class="SubSectionTitle3" colspan="4"&gt;
													&lt;xsl:apply-templates select="n1:title"&gt;
														&lt;xsl:with-param name="code" select="n1:code/@code"/&gt;
													&lt;/xsl:apply-templates&gt;
												&lt;/td&gt;&lt;/tr&gt;
												&lt;!-- Содержимое подсекции 3-го уровня вложенности --&gt;
												&lt;tr&gt;&lt;td class="Rest"&gt;
													&lt;!-- Человекочитаемое содержимое подсекции 3-го уровня вложенности (разметка структурированного содержимого подсекции) --&gt;
													&lt;xsl:apply-templates select="n1:text"/&gt;
													&lt;!-- Подсекции 4-го уровня вложенности --&gt;
													&lt;xsl:for-each select="n1:component/n1:section"&gt;
														&lt;!-- Название подсекции 4-го уровня вложенности --&gt;
														&lt;tr&gt;&lt;td class="SubSectionTitle4" colspan="2"&gt;
															&lt;xsl:apply-templates select="n1:title"&gt;
																&lt;xsl:with-param name="code" select="n1:code/@code"/&gt;
															&lt;/xsl:apply-templates&gt;
														&lt;/td&gt;&lt;/tr&gt;
														&lt;!-- Содержимое подсекции 4-го уровня вложенности --&gt;
														&lt;tr&gt;&lt;td class="Rest"&gt;
															&lt;!-- Человекочитаемое содержимое подсекции 4-го уровня вложенности (разметка структурированного содержимого подсекции) --&gt;
															&lt;xsl:apply-templates select="n1:text"/&gt;
															&lt;!-- Подсекции 5-го уровня вложенности (продолжить при необходимости) --&gt;
														&lt;/td&gt;&lt;/tr&gt;
													&lt;/xsl:for-each&gt;
												&lt;/td&gt;&lt;/tr&gt;
											&lt;/xsl:for-each&gt;
										&lt;/td&gt;&lt;/tr&gt;
									&lt;/xsl:for-each&gt;
								&lt;/td&gt;&lt;/tr&gt;
							&lt;/xsl:for-each&gt;
						&lt;/td&gt;&lt;/tr&gt;
						&lt;!-- Пустая строка-разделитель между названием и содержимым секции --&gt;
						&lt;tr&gt;&lt;td&gt;&lt;br/&gt;&lt;/td&gt;&lt;/tr&gt;
					&lt;/xsl:if&gt;
				&lt;/xsl:for-each&gt;
			&lt;/tbody&gt;
		&lt;/table&gt;
	&lt;/xsl:template&gt;
	&lt;!--   Title  --&gt;
	&lt;xsl:template match="n1:title"&gt;
		&lt;xsl:param name="code" select="''"/&gt;
		&lt;span style="font-weight:bold;" title="{$code}"&gt;
			&lt;xsl:value-of select="."/&gt;
		&lt;/span&gt;
	&lt;/xsl:template&gt;
	&lt;!--   Text   --&gt;
	&lt;xsl:template match="n1:text"&gt;
		&lt;xsl:apply-templates/&gt;
	&lt;/xsl:template&gt;
	&lt;!--   paragraph  --&gt;
	&lt;xsl:template match="n1:paragraph"&gt;
		&lt;xsl:apply-templates/&gt;
		&lt;p/&gt;
	&lt;/xsl:template&gt;
	&lt;!-- caption --&gt;
	&lt;xsl:template match="n1:caption"&gt;
		&lt;span style="font-weight:bold;"&gt;
			&lt;xsl:value-of select="."/&gt;
			&lt;xsl:text&gt;: &lt;/xsl:text&gt;
		&lt;/span&gt;
		&lt;br/&gt;
	&lt;/xsl:template&gt;
	&lt;!--   line break  --&gt;
	&lt;xsl:template match="n1:br"&gt;
		&lt;xsl:apply-templates/&gt;
		&lt;br/&gt;
	&lt;/xsl:template&gt;
	&lt;!--     Content w/ deleted text is hidden --&gt;
	&lt;xsl:template match="n1:content[@revised='delete']"/&gt;
	&lt;!--   content  --&gt;
	&lt;xsl:template match="n1:content"&gt;
		&lt;xsl:apply-templates/&gt;
	&lt;/xsl:template&gt;
	&lt;!--   list  --&gt;
	&lt;xsl:template match="n1:list"&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="(@ID='invalid')or(@ID='priveleges')"&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;!-- caption --&gt;
				&lt;xsl:if test="n1:caption"&gt;
					&lt;span style="font-weight:bold; "&gt;
						&lt;xsl:apply-templates select="n1:caption"/&gt;
					&lt;/span&gt;
				&lt;/xsl:if&gt;
				&lt;!-- item --&gt;
				&lt;xsl:choose&gt;
					&lt;xsl:when test="@listType='ordered'"&gt;
						&lt;ol&gt;
							&lt;xsl:for-each select="n1:item"&gt;
								&lt;li&gt;
									&lt;!-- list element--&gt;
									&lt;xsl:apply-templates/&gt;
								&lt;/li&gt;
							&lt;/xsl:for-each&gt;
						&lt;/ol&gt;
					&lt;/xsl:when&gt;
					&lt;xsl:otherwise&gt;
						&lt;!-- list is unordered --&gt;
						&lt;ul&gt;
							&lt;xsl:for-each select="n1:item"&gt;
								&lt;li&gt;
									&lt;!-- list element--&gt;
									&lt;xsl:apply-templates/&gt;
								&lt;/li&gt;
							&lt;/xsl:for-each&gt;
						&lt;/ul&gt;
					&lt;/xsl:otherwise&gt;
				&lt;/xsl:choose&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!-- tables --&gt;
	&lt;xsl:template match="n1:table/@*|n1:thead/@*|n1:tfoot/@*|n1:tbody/@*|n1:colgroup/@*|n1:col/@*|n1:tr/@*|n1:th/@*|n1:td/@*"&gt;
		&lt;xsl:copy&gt;
			&lt;xsl:apply-templates select="."/&gt;
		&lt;/xsl:copy&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:table"&gt;
		&lt;xsl:element name="table"&gt;
			&lt;xsl:attribute name="class"&gt;inner&lt;/xsl:attribute&gt;
			&lt;xsl:attribute name="width"&gt;
				&lt;xsl:value-of select="@width"/&gt;
			&lt;/xsl:attribute&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/xsl:element&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:thead"&gt;
		&lt;thead&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/thead&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:tfoot"&gt;
		&lt;tfoot&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/tfoot&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:tbody"&gt;
		&lt;tbody&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/tbody&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:colgroup"&gt;
		&lt;colgroup&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/colgroup&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:col"&gt;
		&lt;xsl:copy-of select="."/&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:tr"&gt;
		&lt;tr&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/tr&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:th"&gt;
		&lt;th class="inner"&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/th&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:td"&gt;
		&lt;xsl:element name="td"&gt;
			&lt;xsl:attribute name="class"&gt;inner&lt;/xsl:attribute&gt;
			&lt;xsl:attribute name="colspan"&gt;
				&lt;xsl:value-of select="@colspan"/&gt;
			&lt;/xsl:attribute&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/xsl:element&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:table/n1:caption"&gt;
		&lt;span style="font-weight:bold; "&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/span&gt;
	&lt;/xsl:template&gt;
	&lt;!--   RenderMultiMedia 
    
    this currently only handles GIF's and JPEG's.  It could, however,
    be extended by including other image MIME types in the predicate
    and/or by generating &lt;object&gt; or &lt;applet&gt; tag with the correct
    params depending on the media type  @ID  =$imageRef  referencedObject
    --&gt;
	&lt;xsl:template match="n1:renderMultiMedia"&gt;
		&lt;xsl:variable name="imageRef" select="@referencedObject"/&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="//n1:regionOfInterest[@ID=$imageRef]"&gt;
				&lt;!-- Here is where the Region of Interest image referencing goes --&gt;
				&lt;xsl:if test="//n1:regionOfInterest[@ID=$imageRef]//n1:observationMedia/n1:value[@mediaType='image/gif'           or
          @mediaType='image/jpeg']"&gt;
					&lt;br clear="all"/&gt;
					&lt;xsl:element name="img"&gt;
						&lt;xsl:attribute name="src"&gt;
							&lt;xsl:value-of select="//n1:regionOfInterest[@ID=$imageRef]//n1:observationMedia/n1:value/n1:reference/@value"/&gt;
						&lt;/xsl:attribute&gt;
					&lt;/xsl:element&gt;
				&lt;/xsl:if&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;!-- Here is where the direct MultiMedia image referencing goes --&gt;
				&lt;xsl:if test="//n1:observationMedia[@ID=$imageRef]/n1:value[@mediaType='image/gif' or @mediaType='image/jpeg']"&gt;
					&lt;br clear="all"/&gt;
					&lt;xsl:element name="img"&gt;
						&lt;xsl:attribute name="src"&gt;
							&lt;xsl:value-of select="//n1:observationMedia[@ID=$imageRef]/n1:value/n1:reference/@value"/&gt;
						&lt;/xsl:attribute&gt;
					&lt;/xsl:element&gt;
				&lt;/xsl:if&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!--    Stylecode processing   
    Supports Bold, Underline and Italics display
    --&gt;
	&lt;xsl:template match="//n1:*[@styleCode]"&gt;
		&lt;xsl:if test="@styleCode='Bold'"&gt;
			&lt;xsl:element name="b"&gt;
				&lt;xsl:apply-templates/&gt;
			&lt;/xsl:element&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:if test="@styleCode='Italics'"&gt;
			&lt;xsl:element name="i"&gt;
				&lt;xsl:apply-templates/&gt;
			&lt;/xsl:element&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:if test="@styleCode='Underline'"&gt;
			&lt;xsl:element name="u"&gt;
				&lt;xsl:apply-templates/&gt;
			&lt;/xsl:element&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:if test="contains(@styleCode,'Bold') and contains(@styleCode,'Italics') and not (contains(@styleCode, 'Underline'))"&gt;
			&lt;xsl:element name="b"&gt;
				&lt;xsl:element name="i"&gt;
					&lt;xsl:apply-templates/&gt;
				&lt;/xsl:element&gt;
			&lt;/xsl:element&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:if test="contains(@styleCode,'Bold') and contains(@styleCode,'Underline') and not (contains(@styleCode, 'Italics'))"&gt;
			&lt;xsl:element name="b"&gt;
				&lt;xsl:element name="u"&gt;
					&lt;xsl:apply-templates/&gt;
				&lt;/xsl:element&gt;
			&lt;/xsl:element&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:if test="contains(@styleCode,'Italics') and contains(@styleCode,'Underline') and not (contains(@styleCode, 'Bold'))"&gt;
			&lt;xsl:element name="i"&gt;
				&lt;xsl:element name="u"&gt;
					&lt;xsl:apply-templates/&gt;
				&lt;/xsl:element&gt;
			&lt;/xsl:element&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:if test="contains(@styleCode,'Italics') and contains(@styleCode,'Underline') and contains(@styleCode, 'Bold')"&gt;
			&lt;xsl:element name="b"&gt;
				&lt;xsl:element name="i"&gt;
					&lt;xsl:element name="u"&gt;
						&lt;xsl:apply-templates/&gt;
					&lt;/xsl:element&gt;
				&lt;/xsl:element&gt;
			&lt;/xsl:element&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:if test="not (contains(@styleCode,'Italics') or contains(@styleCode,'Underline') or contains(@styleCode, 'Bold'))"&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/xsl:if&gt;
	&lt;/xsl:template&gt;
	&lt;!--    Superscript or Subscript   --&gt;
	&lt;xsl:template match="n1:sup"&gt;
		&lt;xsl:element name="sup"&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/xsl:element&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:sub"&gt;
		&lt;xsl:element name="sub"&gt;
			&lt;xsl:apply-templates/&gt;
		&lt;/xsl:element&gt;
	&lt;/xsl:template&gt;
	&lt;!--  Contact Information --&gt;
	&lt;xsl:template name="getContactInfo"&gt;
		&lt;xsl:param name="contact"/&gt;
		&lt;xsl:apply-templates select="$contact/n1:addr"/&gt;
		&lt;xsl:text&gt;, &lt;/xsl:text&gt;
		&lt;xsl:apply-templates select="$contact/n1:telecom"/&gt;
	&lt;/xsl:template&gt;
	&lt;!-- Адрес --&gt;
	&lt;xsl:template match="n1:addr"&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="count(./*)&gt;0"&gt;
				&lt;xsl:text&gt; &lt;/xsl:text&gt;
				&lt;xsl:if test="n1:postalCode"&gt;
					&lt;xsl:choose&gt;
						&lt;xsl:when test="not(n1:postalCode[@nullFlavor])"&gt;
							&lt;xsl:apply-templates select="n1:postalCode"/&gt;
							&lt;xsl:text&gt;, &lt;/xsl:text&gt;
						&lt;/xsl:when&gt;
					&lt;/xsl:choose&gt;
				&lt;/xsl:if&gt;
				&lt;xsl:if test="address:stateCode"&gt;
					&lt;xsl:choose&gt;
						&lt;xsl:when test="not(address:stateCode[@nullFlavor])"&gt;
							&lt;xsl:apply-templates select="address:stateCode/@displayName"/&gt;
							&lt;xsl:text&gt;, &lt;/xsl:text&gt;
						&lt;/xsl:when&gt;
					&lt;/xsl:choose&gt;
				&lt;/xsl:if&gt;
				&lt;xsl:for-each select="n1:streetAddressLine"&gt;
					&lt;xsl:value-of select="."/&gt;
				&lt;/xsl:for-each&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;xsl:value-of select="."/&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!-- Контакты --&gt;
	&lt;xsl:template match="n1:telecom[1]"&gt;
		&lt;xsl:variable name="type" select="substring-before(@value, ':')"/&gt;
		&lt;xsl:variable name="value" select="substring-after(@value, ':')"/&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="$type='tel'"&gt;
				&lt;xsl:text&gt;Телефон&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$type='fax'"&gt;
				&lt;xsl:text&gt;Факс&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$type='mailto'"&gt;
				&lt;xsl:text&gt;Электронная почта&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$type='http'"&gt;
				&lt;xsl:text&gt;Сайт&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;xsl:text&gt; &lt;/xsl:text&gt;
				&lt;xsl:value-of select="$type"/&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
		&lt;xsl:if test="@use"&gt;
			&lt;xsl:choose&gt;
				&lt;xsl:when test="@use='HP'"&gt;
					&lt;xsl:text&gt; (дом.)&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="@use='WP'"&gt;
					&lt;xsl:text&gt; (раб.)&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="@use='MC'"&gt;
					&lt;xsl:text&gt; (моб.)&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:otherwise&gt;
					&lt;xsl:text&gt;(&lt;/xsl:text&gt;
					&lt;xsl:value-of select="@use"/&gt;
					&lt;xsl:text&gt;)&lt;/xsl:text&gt;
				&lt;/xsl:otherwise&gt;
			&lt;/xsl:choose&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:text&gt;: &lt;/xsl:text&gt;
		&lt;xsl:value-of select="$value"/&gt;
	&lt;/xsl:template&gt;
	&lt;xsl:template match="n1:telecom"&gt;
		&lt;xsl:variable name="type" select="substring-before(@value, ':')"/&gt;
		&lt;xsl:variable name="value" select="substring-after(@value, ':')"/&gt;
		&lt;xsl:text&gt;; &lt;/xsl:text&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="$type='tel'"&gt;
				&lt;xsl:text&gt;Телефон&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$type='fax'"&gt;
				&lt;xsl:text&gt;Факс&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$type='mailto'"&gt;
				&lt;xsl:text&gt;Электронная почта&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$type='http'"&gt;
				&lt;xsl:text&gt;Сайт&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;xsl:text&gt; &lt;/xsl:text&gt;
				&lt;xsl:value-of select="$type"/&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
		&lt;xsl:if test="@use"&gt;
			&lt;xsl:choose&gt;
				&lt;xsl:when test="@use='HP'"&gt;
					&lt;xsl:text&gt; (дом.)&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="@use='WP'"&gt;
					&lt;xsl:text&gt; (раб.)&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:when test="@use='MC'"&gt;
					&lt;xsl:text&gt; (моб.)&lt;/xsl:text&gt;
				&lt;/xsl:when&gt;
				&lt;xsl:otherwise&gt;
					&lt;xsl:text&gt;(&lt;/xsl:text&gt;
					&lt;xsl:value-of select="@use"/&gt;
					&lt;xsl:text&gt;)&lt;/xsl:text&gt;
				&lt;/xsl:otherwise&gt;
			&lt;/xsl:choose&gt;
		&lt;/xsl:if&gt;
		&lt;xsl:text&gt;: &lt;/xsl:text&gt;
		&lt;xsl:value-of select="$value"/&gt;
	&lt;/xsl:template&gt;
	&lt;!-- --&gt;
	&lt;xsl:template name="payer"&gt;
		&lt;xsl:for-each select="/n1:ClinicalDocument/n1:participant[@typeCode='HLD']"&gt;

            Полис:&lt;xsl:value-of select="n1:associatedEntity/n1:id/@extension"/&gt;
			&lt;br/&gt;
			Страховая компания: 
				&lt;xsl:call-template name="getName"&gt;
				&lt;xsl:with-param name="name" select="n1:associatedEntity/n1:scopingOrganization/n1:name"/&gt;
			&lt;/xsl:call-template&gt;
		&lt;/xsl:for-each&gt;
	&lt;/xsl:template&gt;
	&lt;!-- --&gt;
	&lt;xsl:template name="support"&gt;
		&lt;table width="100%"&gt;
			&lt;col width="60%"/&gt;
			&lt;col width="40%"/&gt;
			&lt;xsl:for-each select="/n1:ClinicalDocument/n1:participant[@typeCode='IND']"&gt;
				&lt;tr&gt;
					&lt;td&gt;
						&lt;xsl:call-template name="getName"&gt;
							&lt;xsl:with-param name="name" select="n1:associatedEntity/n1:associatedPerson/n1:name"/&gt;
						&lt;/xsl:call-template&gt;
					&lt;/td&gt;
					&lt;td&gt;
						&lt;xsl:call-template name="getContactInfo"&gt;
							&lt;xsl:with-param name="contact" select="n1:associatedEntity"/&gt;
						&lt;/xsl:call-template&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
			&lt;/xsl:for-each&gt;
		&lt;/table&gt;
	&lt;/xsl:template&gt;
	&lt;!-- --&gt;
	&lt;xsl:template name="performer"&gt;
		&lt;table width="100%"&gt;
			&lt;col width="60%"/&gt;
			&lt;col width="40%"/&gt;
			&lt;xsl:for-each select="//n1:serviceEvent/n1:performer"&gt;
				&lt;tr&gt;
					&lt;td&gt;
						&lt;xsl:call-template name="getName"&gt;
							&lt;xsl:with-param name="name" select="n1:assignedEntity/n1:assignedPerson/n1:name"/&gt;
						&lt;/xsl:call-template&gt;
					&lt;/td&gt;
					&lt;td&gt;
						&lt;xsl:call-template name="getContactInfo"&gt;
							&lt;xsl:with-param name="contact" select="n1:assignedEntity"/&gt;
						&lt;/xsl:call-template&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
			&lt;/xsl:for-each&gt;
		&lt;/table&gt;
	&lt;/xsl:template&gt;
	&lt;!-- --&gt;
	&lt;xsl:template name="bottomline"&gt;
		&lt;table class="outer" width="100%"&gt;
			&lt;xsl:for-each select="/n1:ClinicalDocument/n1:informant"&gt;
				&lt;tr class="outer"&gt;
					&lt;td class="outer" width="20%"&gt;
						&lt;b&gt;
							&lt;xsl:text&gt;Информант:&lt;/xsl:text&gt;
						&lt;/b&gt;
					&lt;/td&gt;
					&lt;td class="outer"&gt;
						&lt;table&gt;
							&lt;col width="60%"/&gt;
							&lt;col width="40%"/&gt;
							&lt;tr&gt;
								&lt;td&gt;
									&lt;xsl:if test="n1:assignedEntity/n1:assignedPerson|n1:relatedEntity/n1:relatedPerson"&gt;
										&lt;xsl:call-template name="getName"&gt;
											&lt;xsl:with-param name="name" select="n1:assignedEntity/n1:assignedPerson/n1:name|n1:relatedEntity/n1:relatedPerson/n1:name"/&gt;
										&lt;/xsl:call-template&gt;
										&lt;xsl:if test="n1:relatedEntity/n1:code"&gt;
											&lt;xsl:text&gt; (&lt;/xsl:text&gt;
											&lt;xsl:call-template name="translateCode"&gt;
												&lt;xsl:with-param name="code" select="n1:relatedEntity/n1:code/@code"/&gt;
											&lt;/xsl:call-template&gt;
											&lt;xsl:text&gt;)&lt;/xsl:text&gt;
										&lt;/xsl:if&gt;
									&lt;/xsl:if&gt;
								&lt;/td&gt;
								&lt;td&gt;
									&lt;xsl:call-template name="getContactInfo"&gt;
										&lt;xsl:with-param name="contact" select="n1:assignedEntity|n1:relatedEntity"/&gt;
									&lt;/xsl:call-template&gt;
								&lt;/td&gt;
							&lt;/tr&gt;
						&lt;/table&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
			&lt;/xsl:for-each&gt;
		&lt;/table&gt;
	&lt;/xsl:template&gt;
	&lt;!-- --&gt;
	&lt;xsl:template name='translateCode'&gt;
		&lt;xsl:param name='code'/&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="$code/@displayName"&gt;
				&lt;xsl:value-of select="$code/@displayName"/&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;xsl:value-of select="$code/@code"/&gt;
				&lt;xsl:text&gt; (&lt;/xsl:text&gt;
				&lt;xsl:value-of select="$code/@codeSystem"/&gt;
				&lt;xsl:text&gt;)&lt;/xsl:text&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!-- СНИЛС --&gt;
	&lt;xsl:template name='getId'&gt;
		&lt;xsl:param name='Id'/&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="$Id/@root='1.2.643.100.3'"&gt;
				&lt;strong&gt; СНИЛС: &lt;/strong&gt;
				&lt;xsl:value-of select="$Id/@extension"/&gt;
			&lt;/xsl:when&gt;
		&lt;/xsl:choose&gt;
		&lt;br/&gt;
	&lt;/xsl:template&gt;
	&lt;!-- Возраст --&gt;
	&lt;xsl:template name='getAge'&gt;
		&lt;xsl:param name='Birthday'/&gt;
		&lt;!-- дата рождения --&gt;
		&lt;xsl:param name='ServiceDate'/&gt;
		&lt;!-- дата, относительно которой рассчитывается возраст (обычно дата формирования документа) --&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="substring($ServiceDate,5,2)&gt;substring($Birthday,5,2) or substring($Birthday,5,2) = substring($ServiceDate,5,2) and substring($ServiceDate,7,2) &gt;= substring($Birthday,7,2)"&gt;
				&lt;xsl:value-of select="substring($ServiceDate,1,4) - substring($Birthday,1,4)"/&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;xsl:value-of select="substring($ServiceDate,1,4) - substring($Birthday,1,4) - 1"/&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!-- Лицензия медицинской организации --&gt;
	&lt;xsl:template name='getLO'&gt;
		&lt;xsl:param name='Id'/&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="$Id/@root='1.2.643.5.1.13.2.1.1.1504.101'"&gt;
				&lt;br/&gt;
				&lt;strong&gt;Лицензия: &lt;/strong&gt;
				&lt;!-- номер лицензии --&gt;
				&lt;xsl:value-of select="$Id/@extension"/&gt;
				&lt;xsl:text&gt;, &lt;/xsl:text&gt;
				&lt;!-- наименование выдавшего лицензию органа и дата регистрации) --&gt;
				&lt;xsl:value-of select="$Id/@assigningAuthorityName"/&gt;
			&lt;/xsl:when&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
	&lt;!-- Расшифровка причины отсутствия информации (OID: 1.2.643.5.1.13.13.99.2.286)--&gt;
	&lt;xsl:template name='translateNullFlavor'&gt;
		&lt;xsl:param name='code'/&gt;
		&lt;xsl:choose&gt;
			&lt;xsl:when test="$code='MSK'"&gt;
				&lt;xsl:text&gt;нет информации (скрыто)&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$code='NA'"&gt;
				&lt;xsl:text&gt;нет информации (неприменимо)&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$code='OTH'"&gt;
				&lt;xsl:text&gt;нет информации (другое)&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$code='UNK'"&gt;
				&lt;xsl:text&gt;нет информации (неизвестно)&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$code='ASKU'"&gt;
				&lt;xsl:text&gt;нет информации (запрошено, но неизвестно)&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$code='NAV'"&gt;
				&lt;xsl:text&gt;нет информации (временно недоступно)&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:when test="$code='NASK'"&gt;
				&lt;xsl:text&gt;нет информации (не запрашивалось)&lt;/xsl:text&gt;
			&lt;/xsl:when&gt;
			&lt;xsl:otherwise&gt;
				&lt;!-- в т.ч. "NI"--&gt;
				&lt;xsl:text&gt;нет информации&lt;/xsl:text&gt;
			&lt;/xsl:otherwise&gt;
		&lt;/xsl:choose&gt;
	&lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;
</СхемаВизуализации>
			<Архив>false</Архив>

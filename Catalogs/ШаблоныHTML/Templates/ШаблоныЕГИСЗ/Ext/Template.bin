									&lt;td style="vertical-align:middle;width:33%"&gt;Тип витального параметра&lt;/td&gt;
									&lt;td style="width:33%"&gt;Результат измерения&lt;/td&gt;
								&lt;/tr&gt;&lt;tr&gt;&lt;td style="vertical-align:middle;width:33%"&gt;
										&lt;a id="a90dcfda-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
									&lt;td style="vertical-align:middle;width:33%"&gt;Рост&lt;/td&gt;
									&lt;td style="vertical-align:middle;width:33%"&gt;
										&lt;a id="a90dcfe2-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
								&lt;/tr&gt;&lt;tr&gt;&lt;td style="vertical-align:middle;width:33%"&gt;
										&lt;a id="a90dcfdb-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
									&lt;td style="vertical-align:middle;width:33%"&gt;Вес&lt;/td&gt;
									&lt;td style="vertical-align:middle;width:33%"&gt;
										&lt;a id="a90dcfe3-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
								&lt;/tr&gt;&lt;tr&gt;&lt;td style="vertical-align:middle;width:33%"&gt;
										&lt;a id="a90dcfdc-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
									&lt;td style="vertical-align:middle;width:33%"&gt;ИМТ&lt;/td&gt;
									&lt;td style="vertical-align:middle;width:33%"&gt;
										&lt;a id="a90dcfe4-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
								&lt;/tr&gt;&lt;tr&gt;&lt;td style="width:33%"&gt;
										&lt;a id="a90dcfdd-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
									&lt;td style="width:33%"&gt;
										&lt;a id="a90dcfe1-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
									&lt;td style="width:33%"&gt;
										&lt;a id="a90dcfe5-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/td&gt;
								&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div&gt;
							&lt;span&gt;Тип телосложения:&lt;/span&gt;
							&lt;a id="a90dcfe6-9701-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;

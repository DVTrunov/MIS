						&lt;/div&gt;
						&lt;div data-bit-hidden="true"&gt;
							&lt;br&gt;&lt;table border="1" style="text-align:center;border-color:inherit;border-collapse:collapse;width:100%" data-bit-dyntable-id="07d9c401-970f-11ed-8319-40167e631f2e"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style="width:33%"&gt;Профессия&lt;/td&gt;
										&lt;td style="width:33%"&gt;Специальность&lt;/td&gt;
										&lt;td style="width:33%"&gt;Должность&lt;/td&gt;
									&lt;/tr&gt;&lt;tr&gt;&lt;td style="width:33%"&gt;
											&lt;a id="86d45761-96fd-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
										&lt;/td&gt;
										&lt;td style="width:33%"&gt;
											&lt;a id="86d45762-96fd-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
										&lt;/td&gt;
										&lt;td style="width:33%"&gt;
											&lt;a id="86d45763-96fd-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
										&lt;/td&gt;
									&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
						&lt;div data-bit-hidden="true"&gt;
							&lt;br&gt;&lt;span&gt;Условия и характер выполняемого труда:&lt;/span&gt;
							&lt;a id="86d45764-96fd-11ed-8319-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/div&gt;
					&lt;/div&gt;
				&lt;/div&gt;
				&lt;div data-bit-hidden="true"&gt;
					&lt;br&gt;&lt;div style="font-weight:bold"&gt;Образование:&lt;/div&gt;
					&lt;div data-bit-sectionname="EDU"&gt;
						&lt;div data-bit-hidden="true"&gt;
							&lt;span&gt;Название образовательной организации:&lt;/span&gt;

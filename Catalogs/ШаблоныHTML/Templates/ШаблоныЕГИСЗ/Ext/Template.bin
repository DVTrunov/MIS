                    &lt;/xsl:choose&gt;
                    &lt;table class="block-form"&gt;
					    &lt;tr&gt;
					    	&lt;td colspan="4"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Гражданство&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:observation[n1:code/@codeSystem='1.2.643.5.1.13.13.99.2.315'][not(@nullFlavor)]"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:observation[n1:code/@codeSystem='1.2.643.5.1.13.13.99.2.315']/n1:code/@displayName"/&gt;
                                        &lt;/xsl:when&gt;

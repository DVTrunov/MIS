			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Клиент: Место работы</Description>
			<АлгоритмВычисления>МестоРаботы = ДокументОбъект.Клиент.умцМестоРаботы;
Если ТипЗнч(МестоРаботы) = Тип("СправочникСсылка.Контрагенты") Тогда
	Если ЗначениеЗаполнено(МестоРаботы.НаименованиеПолное) Тогда
		Результат = МестоРаботы.НаименованиеПолное;
	Иначе
		Результат = МестоРаботы.Наименование;
	КонецЕсли;
Иначе
	Результат = Строка(МестоРаботы);
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>7d32da7e-343a-11ef-b692-1c697a9ea640</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>7d32da7d-343a-11ef-b692-1c697a9ea640</Parent>
			<Description>Тип иммунобиологического лекарственного препарата</Description>
			<АлгоритмВычисления>Если ЗначениеЗаполнено(Параметры.ИммунобиологическийЛП)
	И ДопСерверныеФункции.ИмяСсылочногоТипа(Параметры.ИммунобиологическийЛП) = "Справочник.КлассификаторыМинЗдрава"
Тогда
	ИдентификаторТипа = Параметры.ИммунобиологическийЛП.Атрибуты.Найти("PREVENTIVEGROUP", "Ключ");
	Если ЗначениеЗаполнено(ИдентификаторТипа) Тогда
		ИдентификаторТипаЧисло = Неопределено;
		Если ТипЗнч(ИдентификаторТипа.Значение) = Тип("Строка") Тогда
			ЦифрыСтрокиУИДЕГИСЗ = СтроковыеФункцииКлиентСервер.ПолучитьЦифрыСтроки(ИдентификаторТипа.Значение);
			Если ЗначениеЗаполнено(ЦифрыСтрокиУИДЕГИСЗ) Тогда
				ИдентификаторТипаЧисло = Число(ЦифрыСтрокиУИДЕГИСЗ);
			КонецЕсли;
		ИначеЕсли ТипЗнч(ИдентификаторТипа.Значение) = Тип("Число") Тогда
			ИдентификаторТипаЧисло = ИдентификаторТипа.Значение;
		КонецЕсли;
		Если ИдентификаторТипаЧисло &lt;&gt; Неопределено Тогда
			Результат = ИнтеграцияЕГИСЗОбщегоНазначенияПовтИсп.ЭлементКлассификатораПоУИДЕГИСЗ(ИдентификаторТипаЧисло, Перечисления.ВидыКлассификаторовМинЗдрава.ГруппыМИБПДляСертификатаПрофилактическихПрививок);
		КонецЕсли;
	КонецЕсли;
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения/>
			<СписокПеременных>
				<Row>
					<Параметр>76495258-337f-11ef-b692-1c697a9ea640</Параметр>
					<ИмяПеременной>ИммунобиологическийЛП</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
			</СписокПеременных>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>3975ae32-4af3-11e9-82be-40167e631f2e</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Клиент: Пол</Description>
			<АлгоритмВычисления>СТАНДАРТНЫЕ_АЛГОРИТМЫ_КЛИЕНТ_ПОЛ</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>

									&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
						&lt;div data-bit-hidden="true"&gt;
							&lt;br&gt;&lt;div data-bit-hidden="true"&gt;
								&lt;span&gt;Группа инвалидности:&lt;/span&gt;

					            			    	    &lt;tbody&gt;
					            	                        &lt;xsl:for-each select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='VITALPARAM']/n1:entry/n1:organizer[n1:statusCode/@code='completed']/n1:component/n1:observation"&gt;
					            	                            &lt;tr&gt;
                                                                    &lt;td class="param"&gt;
                                                                        &lt;p class="tableresult"&gt;
					            	                                      	&lt;xsl:value-of select="./n1:code/@displayName"/&gt;
						        			    				            &lt;xsl:choose&gt;
                                                                                &lt;xsl:when test="./n1:entryRelationship/n1:observation[n1:code/@code='6034']/n1:value[not(@nullFlavor)]"&gt;
                                                                                    &lt;xsl:text&gt; (&lt;/xsl:text&gt;
						        			    						            &lt;xsl:value-of select="./n1:entryRelationship/n1:observation[n1:code/@code='6034']/n1:value/@displayName"/&gt;
						        			    						            &lt;xsl:text&gt;) &lt;/xsl:text&gt;
                                                                                &lt;/xsl:when&gt;
                                                                            &lt;/xsl:choose&gt;
						        			    				            &lt;xsl:choose&gt;
                                                                                &lt;xsl:when test="./n1:entryRelationship/n1:observation[n1:code/@code='8034']"&gt;
                                                                                    &lt;xsl:text&gt; [&lt;/xsl:text&gt;
						        			    						            &lt;xsl:value-of select="./n1:entryRelationship/n1:observation[n1:code/@code='8034']/n1:value/@value"/&gt;
						        			    						            &lt;xsl:text&gt;]&lt;/xsl:text&gt;
                                                                                &lt;/xsl:when&gt;

						&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
			&lt;br&gt;&lt;div data-bit-sectionname="DOCINFO"&gt;
				&lt;div&gt;
					&lt;b&gt;Общие сведения&lt;/b&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;
						&lt;em align="left"&gt;
							&lt;font size="2" color="#888888"&gt;&amp;lt;Заполняется в случае проведения профилактического медицинского осмотра несовершеннолетних&amp;gt;&lt;/font&gt;
						&lt;/em&gt;
					&lt;/div&gt;
					&lt;span&gt;Наименование медицинской организации, в которой несовершеннолетний получает первичную медико-санитарную помощь:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="ecec5bfd-94cf-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;
						&lt;em align="left"&gt;
							&lt;font size="2" color="#888888"&gt;&amp;lt;Заполняется в случае проведения профилактического медицинского осмотра или диспансеризации взрослого населения&amp;gt;&lt;/font&gt;
						&lt;/em&gt;
					&lt;/div&gt;
					&lt;span&gt;Диспансеризация выполнена мобильной бригадой:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="ecec5bfe-94cf-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;
						&lt;em align="left"&gt;
							&lt;font size="2" color="#888888"&gt;&amp;lt;Заполняется в случае проведения профилактического медицинского осмотра несовершеннолетних&amp;gt;&lt;/font&gt;
						&lt;/em&gt;
					&lt;/div&gt;
					&lt;span&gt;Группа здоровья до текущего ПМО:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="ecec5bff-94cf-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;
						&lt;em align="left"&gt;
							&lt;font size="2" color="#888888"&gt;&amp;lt;Заполняется в случае проведения профилактического медицинского осмотра несовершеннолетних&amp;gt;&lt;/font&gt;
						&lt;/em&gt;
					&lt;/div&gt;
					&lt;span&gt;Группа для занятий физической культурой до текущего ПМО:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="ecec5c00-94cf-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;span&gt;Направлен на второй этап диспансеризации:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="ecec5c01-94cf-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;div&gt;
					&lt;span&gt;ПМО (диспансеризация) проведены в полном объеме:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="18c6754b-94db-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;span&gt;Группа здоровья после текущего ПМО или диспансеризации:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="4789891f-8f51-11ee-a45a-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;
						&lt;em align="left"&gt;
							&lt;font size="2" color="#888888"&gt;&amp;lt;Заполняется в случае проведения профилактического медицинского осмотра несовершеннолетних&amp;gt;&lt;/font&gt;
						&lt;/em&gt;
					&lt;/div&gt;
					&lt;span&gt;Группа для занятий физической культурой после текущего ПМО:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="18c6754d-94db-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;
						&lt;em align="left"&gt;
							&lt;font size="2" color="#888888"&gt;&amp;lt;Заполняется в случае проведения профилактического медицинского осмотра или диспансеризации взрослого населения&amp;gt;&lt;/font&gt;
						&lt;/em&gt;
					&lt;/div&gt;
					&lt;span&gt;Уровень артериального давления ниже 140/90 мм рт.ст. на фоне приема гипотензивных лекарственных препаратов при наличии болезней, характеризующихся повышенным кровяным давлением:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="18c6754e-94db-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;
						&lt;em align="left"&gt;
							&lt;font size="2" color="#888888"&gt;&amp;lt;Заполняется в случае проведения профилактического медицинского осмотра или диспансеризации взрослого населения&amp;gt;&lt;/font&gt;
						&lt;/em&gt;
					&lt;/div&gt;
					&lt;span&gt;Принимает гипотензивные лекарственные вещества:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="18c6754f-94db-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;
						&lt;em align="left"&gt;
							&lt;font size="2" color="#888888"&gt;&amp;lt;Заполняется в случае проведения профилактического медицинского осмотра или диспансеризации взрослого населения&amp;gt;&lt;/font&gt;
						&lt;/em&gt;
					&lt;/div&gt;
					&lt;span&gt;Принимает гипогликемические лекарственные вещества:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="18c67550-94db-11ee-a45b-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;div&gt;
					&lt;div data-bit-hidden="true"&gt;

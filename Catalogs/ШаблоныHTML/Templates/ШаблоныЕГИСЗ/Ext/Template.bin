						&lt;td style="word-wrap:break-word;vertical-align:middle;width:70%"&gt;
							&lt;a id="725adb93-4d7b-11ef-b694-b48c9d003dd0" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="word-wrap:break-word;vertical-align:middle;width:30%"&gt;Заключение:&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 70%;"&gt;
							&lt;a id="725adb99-4d7b-11ef-b694-b48c9d003dd0" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;

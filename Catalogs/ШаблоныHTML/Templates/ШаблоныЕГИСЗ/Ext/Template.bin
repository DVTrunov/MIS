&lt;!-- 14.12.2022 - v.1.0.0: Модуль разработан --&gt;

    &lt;!-- Core08-1 --&gt;
    &lt;pattern&gt;
        &lt;rule context="//assignedEntity[not(ancestor::section[code/@code=['SPECIMENS','RESLAB']])][not(ancestor::documentationOf)][not(id[1]/@nullFlavor)]"&gt;

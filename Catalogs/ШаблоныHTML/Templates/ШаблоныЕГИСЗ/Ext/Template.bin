                                                &lt;/xsl:when&gt;
					            				&lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian /identity:AuthorityDoc/@nullFlavor"&gt;
						                            &lt;xsl:text&gt;Документ, удостоверяющий полномочия: &lt;/xsl:text&gt;

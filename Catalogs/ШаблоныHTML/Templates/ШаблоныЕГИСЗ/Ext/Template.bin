			<Description>Выписка из протокола решения врачебной комиссии (CDA) Редакция 2</Description>
			<ВидДокумента>18fe19d9-4d85-11ef-b691-1c697a96466f</ВидДокумента>
			<НаименованиеПолное>Выписка из протокола решения врачебной комиссии (CDA) Редакция 2</НаименованиеПолное>
			<Схематрон>&lt;!-- Схематрон для СЭМД "Выписка из протокола решения врачебной комиссии (CDA) Редакция 2" --&gt;
&lt;!-- Разработано в соотвествии с Руководством по реализации: https://portal.egisz.rosminzdrav.ru/materials/____ --&gt;

&lt;!-- Список изменений --&gt;
&lt;!-- 23.03.2023 - v.1.0.0: Схематрон разработан --&gt;
&lt;!-- 11.04.2023 - v.1.1.0: Схематрон доработан в соответствии с обновленным руководством по реализации --&gt;
&lt;!-- 25.04.2023 - v.1.1.1: Обновлен модуль Main01; исправления в правилах У3-12, У3-16 --&gt;

&lt;schema xmlns="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt2"&gt;
    &lt;ns prefix="xsi" uri="http://www.w3.org/2001/XMLSchema-instance"/&gt;
    &lt;ns prefix="identity" uri="urn:hl7-ru:identity"/&gt;
    &lt;ns prefix="address" uri="urn:hl7-ru:address"/&gt;
    &lt;ns prefix="medService" uri="urn:hl7-ru:medService"/&gt;
    &lt;ns prefix="PII" uri="urn:hl7-ru:PII"/&gt;
    &lt;ns prefix="fias" uri="urn:hl7-ru:fias"/&gt;



    &lt;!-- Core02 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/recordTarget/patientRole/addr[not(@nullFlavor)]"&gt;
            &lt;assert test="count(address:Type)=1"&gt;У1-12. Элемент ClinicalDocument/recordTarget/patientRole/addr должен иметь 1 элемент address:Type.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- Main02 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/recordTarget/patientRole/patient/birthTime"&gt;
            &lt;report test="@nullFlavor"&gt;У1-12. Элемент ClinicalDocument/recordTarget/patientRole/patient/birthTime не должен иметь атрибут @nullFlavor.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- Main08 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument"&gt;
            &lt;assert test="count(documentationOf)=1"&gt;У1-19. Элемент ClinicalDocument должен иметь 1 элемент documentationOf.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/documentationOf/serviceEvent/code"&gt;
            &lt;assert test="@code='5'"&gt;У1-19. Элемент ClinicalDocument/documentationOf/serviceEvent/code должен иметь 1 значение атрибута @code равное '5'.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/documentationOf/serviceEvent/effectiveTime"&gt;
            &lt;assert test="count(low)=1"&gt;У1-19. Элемент ClinicalDocument/documentationOf/serviceEvent/effectiveTime должен иметь 1 элемент low.&lt;/assert&gt;
            &lt;assert test="count(high)&amp;lt;=1"&gt;У1-19. Элемент ClinicalDocument/documentationOf/serviceEvent/effectiveTime должен иметь не более 1 элемента high.&lt;/assert&gt;
            &lt;report test="@nullFlavor"&gt;У1-19. Элемент ClinicalDocument/documentationOf/serviceEvent/effectiveTime не должен иметь атрибут @nullFlavor.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/documentationOf/serviceEvent/effectiveTime/low"&gt;
            &lt;report test="@nullFlavor"&gt;У1-19. Элемент ClinicalDocument/documentationOf/serviceEvent/effectiveTime/low не должен иметь атрибут @nullFlavor.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/documentationOf/serviceEvent/effectiveTime/high"&gt;
            &lt;report test="@nullFlavor"&gt;У1-19. Элемент ClinicalDocument/documentationOf/serviceEvent/effectiveTime/high не должен иметь атрибут @nullFlavor.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/documentationOf/serviceEvent/performer"&gt;
            &lt;assert test="count(functionCode)=1"&gt;У1-19. Элемент ClinicalDocument/documentationOf/serviceEvent/performer должен иметь 1 элемент assignedEntity.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;



    &lt;!-- У1-3 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/templateId"&gt;
            &lt;assert test="@root='1.2.643.5.1.13.13.14.347.9.2'"&gt;У1-3. Элемент ClinicalDocument/templateId должен иметь значение атрибута @root равное '1.2.643.5.1.13.13.14.347.9.2'.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У1-5 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/code"&gt;
            &lt;assert test="@code='347'"&gt;У1-5. Элемент ClinicalDocument/code должен иметь значение атрибута @code равное '347'.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-1 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='DOCINFO'])=1"&gt;У2-1. Элемент ClinicalDocument/component/structuredBody должен иметь 1 элемент component[section/code/@code='DOCINFO'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-2 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='SERVICES'])&amp;lt;=1"&gt;У2-2. Элемент ClinicalDocument/component/structuredBody должен иметь не более 1 элемента component[section/code/@code='SERVICES'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-3 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='DGN'])&amp;lt;=1"&gt;У2-3. Элемент ClinicalDocument/component/structuredBody должен иметь не более 1 элемента component[section/code/@code='DGN'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-4 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='HIGHTECHMEDCARE'])&amp;lt;=1"&gt;У2-4. Элемент ClinicalDocument/component/structuredBody должен иметь не более 1 элемента component[section/code/@code='HIGHTECHMEDCARE'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-5 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='SPECMEDCARE'])&amp;lt;=1"&gt;У2-5. Элемент ClinicalDocument/component/structuredBody должен иметь не более 1 элемента component[section/code/@code='SPECMEDCARE'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У2-6 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody"&gt;
            &lt;assert test="count(component[section/code/@code='LINKDOCS'])&amp;lt;=1"&gt;У2-6. Элемент ClinicalDocument/component/structuredBody должен иметь не более 1 элемента component[section/code/@code='LINKDOCS'].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У3-1 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']"&gt;
            &lt;assert test="count(entry[observation/code[@code='12173']])=1"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO'] должен иметь 1 элемент entry[observation/code[@code='12173']].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation[code[@code='12173']]"&gt;
            &lt;assert test="count(text)=1"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation[code[@code='12173']] должен иметь 1 элемент text.&lt;/assert&gt;
            &lt;assert test="count(value)=1"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation[code[@code='12173']] должен иметь 1 элемент value.&lt;/assert&gt;
            &lt;assert test="count(entryRelationship[observation/code[@code='6079']])&amp;lt;=1"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation[code[@code='12173']] должен иметь не более 1 элемента entryRelationship[observation/code[@code='6079']].&lt;/assert&gt;
            &lt;assert test="count(entryRelationship[observation/code[@code='12140']])&amp;lt;=1"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation[code[@code='12173']] должен иметь не более 1 элемента entryRelationship[observation/code[@code='12140']].&lt;/assert&gt;
            &lt;assert test="count(entryRelationship[observation/code[@code='6025']])&amp;lt;=1"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation[code[@code='12173']] должен иметь не более 1 элемента entryRelationship[observation/code[@code='6025']].&lt;/assert&gt;
            &lt;assert test="count(entryRelationship[observation/code[@code='12477']])=1"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation[code[@code='12173']] должен иметь 1 элемент entryRelationship[observation/code[@code='12477']].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation[code[@code='12173']]/text[not(@nullFlavor)]"&gt;
            &lt;assert test=".!=''"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation/text должен иметь не пустое значение.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation/code[@code='12173']"&gt;
            &lt;assert test="@codeSystem=['1.2.643.5.1.13.13.99.2.166','1.2.643.5.1.13.2.1.1.1504.41','1.2.643.5.1.13.13.11.1380']"&gt;У3-1. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='DOCINFO']/entry/observation/code[@code='12173'] должен иметь значение атрибута @codeSystem равное '1.2.643.5.1.13.13.99.2.166', '1.2.643.5.1.13.2.1.1.1504.41' или '1.2.643.5.1.13.13.11.1380'.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;

                    &lt;/xsl:choose&gt;
					&lt;xsl:choose&gt;
					    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='DOCINFO']"&gt;
							&lt;table class="block-form"&gt;
					            &lt;xsl:for-each select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='DOCINFO']/n1:entry/n1:observation"&gt;
								    &lt;xsl:choose&gt;
									    &lt;xsl:when test="./n1:code/@code='837'"&gt;
										    &lt;tr&gt;
                                                &lt;td colspan="8"&gt;

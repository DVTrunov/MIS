					&lt;div&gt;
						&lt;span&gt;Медицинская услуга:&lt;/span&gt;
						&lt;a id="34ef5485-9af5-11ed-831a-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
					&lt;div&gt;
						&lt;span&gt;Вид направления:&lt;/span&gt;
						&lt;a id="34ef5484-9af5-11ed-831a-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/div&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;br&gt;&lt;div&gt;
				&lt;span&gt;Договор с клиентом:&lt;/span&gt;
				&lt;a id="30f1b4fd-533e-11ec-a348-b42e9995fee4" href="about:"&gt;[...]&lt;/a&gt;

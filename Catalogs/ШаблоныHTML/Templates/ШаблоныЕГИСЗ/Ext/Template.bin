					                                    &lt;thead&gt;
								        	        		&lt;th class="param"&gt;Дата введения&lt;/th&gt;
					                                        &lt;th class="param"&gt;Тип препарата&lt;/th&gt;
						                                    &lt;th class="param"&gt;Препарат&lt;/th&gt;
						                                &lt;/thead&gt;
								        	        	&lt;tbody&gt;
						                                    &lt;xsl:for-each select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='DOCINFO']/n1:entry/n1:substanceAdministration[n1:code/@codeSystem='1.2.643.5.1.13.13.99.2.848']"&gt;
						                                        &lt;tr&gt;
								        	        			    &lt;td class="param"&gt;
                                                                        &lt;p class="tableblack"&gt;
						                                               		&lt;xsl:call-template name="formatDate"&gt;

						        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SCORES']/n1:entry/n1:observation/n1:text"&gt;      
									&lt;table class="block-form"&gt;
					                    &lt;tr&gt;
					                        &lt;td colspan="8"&gt;
                                                &lt;h2 class="tablegray"&gt;
                                                    &lt;xsl:text&gt;Сведения о результатах расчета прогностических шкал&lt;/xsl:text&gt;

	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>80c99b3d-4dad-11ef-b691-1c697a96466f</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Клиент: Место работы и должность</Description>
			<АлгоритмВычисления>МестоРаботыИДолжность = Новый Массив;

МестоРаботы = ДокументОбъект.Клиент.умцМестоРаботы;
Если ЗначениеЗаполнено(МестоРаботы) Тогда
	Если ТипЗнч(МестоРаботы) = Тип("СправочникСсылка.Контрагенты") Тогда
		Если ЗначениеЗаполнено(МестоРаботы.НаименованиеПолное) Тогда
			МестоРаботыИДолжность.Добавить(МестоРаботы.НаименованиеПолное);
		Иначе
			МестоРаботыИДолжность.Добавить(МестоРаботы.Наименование);
		КонецЕсли;
	Иначе
		МестоРаботыИДолжность.Добавить(Строка(МестоРаботы));
	КонецЕсли;
КонецЕсли;

Если ЗначениеЗаполнено(ДокументОбъект.Клиент.Профессия) Тогда
	МестоРаботыИДолжность.Добавить(ДокументОбъект.Клиент.Профессия);
КонецЕсли;

Результат = СтрСоединить(МестоРаботыИДолжность, ", ");</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>90eb9681-75b7-4170-bec8-542c0d001a04</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Блок HTML: Диагноз</Description>
			<АлгоритмВычисления>НомерДиагноза = 1;
Текст = "";
ТЧ = Объект.Диагнозы;
Для Каждого Стр Из ТЧ Цикл
	Если ТЧ.Количество() &gt; 1 Тогда
		Текст = Символы.ПС + Текст + Строка(НомерДиагноза) + ". ";
		НомерДиагноза = НомерДиагноза + 1;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.Диагноз.КодДиагноза) Тогда
		МКБ = "[" + Стр.Диагноз.КодДиагноза + "] ";
	Иначе
		МКБ = "";
	КонецЕсли;
	
	Диагноз = Стр.Диагноз.Наименование;
	Описание = Стр.Детализация;
	Сопутствующий = Стр.Сопутствующий;
	К1 = Строка(Стр.Классификация1);
	К2 = Строка(Стр.Классификация2);
	К3 = Строка(Стр.Классификация3);
	Травма = Стр.Травма.Наименование;
	Исход = ?(Стр.Исход.ПолноеНаименование &lt;&gt; "", Стр.Исход.ПолноеНаименование, Стр.Исход.Наименование);
	
	Если ЗначениеЗаполнено(МКБ + Диагноз) Тогда 
		Текст = Текст + "Диагноз: " + МКБ + Диагноз + "&lt;br&gt;";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Описание) Тогда
		Текст = Текст + "Описание: " + Описание + "&lt;br&gt;";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сопутствующий) Тогда
		Текст = Текст + "Сопутствующий: " + Сопутствующий + "&lt;br&gt;";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К1 + К2 + К3) Тогда
		Текст = Текст + "Классификация: "; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К1) Тогда
		Текст = Текст + К1 + ", ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К2) Тогда
		Текст = Текст + К2 + ", ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К3) Тогда
		Текст = Текст + К3;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(К1 + К2 + К3) Тогда
		Текст = Текст + "&lt;br&gt;"; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Травма) Тогда
		Текст = Текст + "Вид нетрудоспособности: " + Травма;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Исход) Тогда
		Если Травма &lt;&gt; "" Тогда
			Текст = Текст + ", ";
		КонецЕсли;
		Текст = Текст + "Исход диагноза: " + Исход;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Травма + Исход) Тогда
		Текст = Текст + "&lt;br&gt;"; 
	КонецЕсли;
	
КонецЦикла;

Результат = Текст;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ВычисляемыйБлок</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>80c99b3c-4dad-11ef-b691-1c697a96466f</Ref>

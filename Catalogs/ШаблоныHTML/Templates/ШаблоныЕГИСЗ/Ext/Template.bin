				&lt;br&gt;&lt;div&gt;
					&lt;span&gt;Группа здоровья после текущего ПМО или диспансеризации:&lt;/span&gt;
					&lt;span&gt;
						&lt;a id="4789891f-8f51-11ee-a45a-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/span&gt;
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;br&gt;&lt;div data-bit-sectionname="DGN"&gt;
				&lt;div&gt;
					&lt;b&gt;Диагнозы&lt;/b&gt;
				&lt;/div&gt;
				&lt;br&gt;&lt;div&gt;
					&lt;table border="1" style="border-color: inherit; border-style: solid; border-collapse: collapse;width:100%;height:px" data-bit-dyntable-id="34ef5488-9af5-11ed-831a-40167e631f2e"&gt;&lt;tbody&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="text-align: center; word-wrap: break-word; vertical-align: middle; width: 13%;"&gt;Диагноз&lt;/td&gt;

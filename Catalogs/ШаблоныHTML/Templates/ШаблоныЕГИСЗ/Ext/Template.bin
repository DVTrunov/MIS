					    	       	                    &lt;xsl:choose&gt;
														    &lt;xsl:when test="./n1:value/@displayName and ./n1:value/n1:originalText"&gt;
									            				&lt;xsl:value-of select="./n1:value/@displayName"/&gt;
																&lt;xsl:text&gt; (&lt;/xsl:text&gt;
																&lt;xsl:value-of select="./n1:value/n1:originalText"/&gt;
																&lt;xsl:text&gt;)&lt;/xsl:text&gt;
                                                            &lt;/xsl:when&gt;
                                                            &lt;xsl:when test="./n1:value/@displayName"&gt;
									            				&lt;xsl:value-of select="./n1:value/@displayName"/&gt;
                                                            &lt;/xsl:when&gt;
															&lt;xsl:otherwise&gt;
															    &lt;xsl:value-of select="./n1:value/n1:originalText"/&gt;
															&lt;/xsl:otherwise&gt;

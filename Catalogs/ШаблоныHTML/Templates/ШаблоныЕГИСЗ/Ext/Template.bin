						        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='VITALPARAM']/n1:entry/n1:organizer[n1:statusCode/@code='completed']/n1:component/n1:observation/n1:referenceRange/n1:observationRange/n1:text"&gt;
					                &lt;table class="block-form"&gt;
                                        &lt;tr&gt;

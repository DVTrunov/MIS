					            				    &lt;xsl:choose&gt;
					            			            &lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IssueOrgName[not(@nullFlavor)]"&gt;

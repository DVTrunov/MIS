								        			        	        			    &lt;xsl:value-of select="./n1:effectiveTime/n1:width/@value"/&gt;
								        			        	        		        &lt;xsl:text&gt; &lt;/xsl:text&gt;
								        	                	        		        &lt;xsl:value-of select="./n1:effectiveTime/n1:width/n1:translation/@displayName"/&gt;&lt;br/&gt; 
								        			        	        			&lt;/xsl:otherwise&gt;
								        			        	        		&lt;/xsl:choose&gt; 
						                                                    &lt;/p&gt;
								        	                	        &lt;/td&gt;
								        	                	        &lt;td class="param" colspan="2"&gt;
                                                                            &lt;p class="tableresult"&gt;
						                                                       	&lt;xsl:value-of select="./n1:precondition/n1:criterion[n1:code/@code='ASSERTION']/n1:value"/&gt;	

                            &lt;/td&gt;
                        &lt;/tr&gt;
						&lt;xsl:choose&gt;
                            &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='STATECUR']/n1:entry/n1:observation[n1:code/@code='4109']/n1:value[not(@nullFlavor)]"&gt;
						        &lt;tr&gt;
					                &lt;td colspan="8"&gt;

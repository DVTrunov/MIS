	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>c367848f-5dec-11ee-a44f-984827df4433</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>4fb47a1a-4ef5-11e9-82be-40167e631f2e</Parent>
			<Description>Номер полиса ОМС с учетом полисов с неограниченным сроком</Description>
			<АлгоритмВычисления>Результат = "";




Выборка = Справочники.СтраховыеПолисы.Выбрать(,ДокументОбъект.Клиент);
Пока Выборка.Следующий() Цикл




	Если Не Выборка.НеДействителен
		 И Выборка.СрокДействияНачало &lt;= ДокументОбъект.Дата
		 И Не Выборка.ПометкаУдаления
		 И Выборка.ВидПолиса.Тип = Перечисления.ТипыСтраховыхПрограмм.ОМС 
	Тогда

		Если ЗначениеЗаполнено(Выборка.СрокДействия) И Выборка.СрокДействия &lt; ДокументОбъект.Дата Тогда
			Продолжить;
		КонецЕсли;


		Результат = СокрЛП(Выборка.Серия + " " + Выборка.Номер);




		Прервать;




	КонецЕсли;
КонецЦикла;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Клиент</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>2561c9ff-cc22-11e2-87cb-002618dcef2c</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Клиент: Дата рождения</Description>
			<АлгоритмВычисления>Док = ДокументОбъект;
Результат = Формат(Док.Клиент.ДатаРождения, "ДФ=dd.MM.yyyy");</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения/>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>c367848b-5dec-11ee-a44f-984827df4433</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Фактический адрес клиента</Description>
			<АлгоритмВычисления>    Клиент = ДокументОбъект.Клиент;
    Результат = "";
	
	// Возвращает полную форму представления адреса за исключением индекса.
	
	// Получаем фактический адрес. Если его нет, то юридический.
	Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	Запись.Объект = Клиент;
	Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресФактический;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Запись.Объект = Клиент;
		Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЮридический;
		Запись.Прочитать();
	КонецЕсли;
	
	Если Запись.Выбран() Тогда
		// Адрес найден
		Если Не ЗначениеЗаполнено(Запись.ЗначенияПолей) Тогда
			Запись = КонтактнаяИнформацияСервер.ОбновитьКИПодФорматФИАС(Клиент, Запись.Вид);	
		КонецЕсли;
		
		ВидИнформации = Новый Структура("ФорматАдреса, ВключатьИндексВПредставление", "ФИАС", Ложь);
		ВидИнформации.Вставить("ВключатьСтрануВПредставление", Ложь); // Вывод страны в адресе не осуществлять.
		
		АдресXDTO = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияИзXML(Запись.ЗначенияПолей);
		АдресXDTO.Состав.Состав.КраткоеПредставление = Ложь;
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(АдресXDTO);
		
		Представление = СведенияОбАдресе.Представление;
		
		// Убираем отображение индекса
		Если ЗначениеЗаполнено(СведенияОбАдресе.Индекс) 
			И Лев(Представление, СтрДлина(СведенияОбАдресе.Индекс)) = СведенияОбАдресе.Индекс
		Тогда
			Представление = Прав(Представление, СтрДлина(Представление) - СтрДлина(СведенияОбАдресе.Индекс));
			Если Лев(Представление, 1) = "," Тогда
				Представление = Прав(Представление, СтрДлина(Представление) - 1);
			КонецЕсли;
		КонецЕсли;
		
		Результат = СокрЛП(Представление);
	КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Клиент</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>80c99b3c-4dad-11ef-b691-1c697a96466f</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Клиент: Место работы</Description>
			<АлгоритмВычисления>МестоРаботы = ДокументОбъект.Клиент.умцМестоРаботы;
Если ТипЗнч(МестоРаботы) = Тип("СправочникСсылка.Контрагенты") Тогда
	Если ЗначениеЗаполнено(МестоРаботы.НаименованиеПолное) Тогда
		Результат = МестоРаботы.НаименованиеПолное;
	Иначе
		Результат = МестоРаботы.Наименование;
	КонецЕсли;
Иначе
	Результат = Строка(МестоРаботы);
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты/>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>059dba23-4c97-11e9-82be-40167e631f2e</Ref>

						                            &lt;/p&gt;
                                                &lt;/td&gt;
							           	        &lt;td class="param"&gt;
							           	            &lt;xsl:choose&gt;
					                                    &lt;xsl:when test="./n1:effectiveTime/@value"&gt;
															&lt;p class="tableblack"&gt;
									    		                &lt;xsl:text&gt;Дата установки диагноза: &lt;/xsl:text&gt;

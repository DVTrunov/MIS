						                            &lt;th class="param"&gt;Значение&lt;/th&gt;
						                            &lt;th class="param"&gt;Ед. изм.&lt;/th&gt;
						                        &lt;/thead&gt;
											    &lt;tbody&gt;
						                            &lt;xsl:for-each select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='VITALPARAM']/n1:entry/n1:organizer[n1:statusCode/@code='completed']/n1:component/n1:observation"&gt;
						                            &lt;tr&gt;
                                                        &lt;td class="param"&gt;
                                                            &lt;p class="tableresult"&gt;
						                                		&lt;xsl:value-of select="./n1:code/@displayName"/&gt;	
						                                	&lt;/p&gt;
                                                        &lt;/td&gt;
						                            	&lt;td class="param"&gt;
                                                            &lt;p class="tableresult"&gt;
						                                		&lt;xsl:value-of select="./n1:value/@value"/&gt;
						                                	&lt;/p&gt;
                                                        &lt;/td&gt;
						                            	&lt;td class="param"&gt;
                                                            &lt;p class="tableresult"&gt;
						                                		&lt;xsl:value-of select="./n1:value/@unit"/&gt;
						                                	&lt;/p&gt;
                                                        &lt;/td&gt;
						                            &lt;/tr&gt;
						                            &lt;/xsl:for-each&gt;
											    &lt;/tbody&gt;
											&lt;/table&gt;
										&lt;/p&gt;	
					                &lt;/td&gt;
					            &lt;/tr&gt;
				            &lt;/xsl:when&gt;
			            &lt;/xsl:choose&gt;	
			            &lt;tr&gt;
					        &lt;td colspan="8"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Состояние здоровья гражданина при направлении на медико-социальную экспертизу&lt;/xsl:text&gt;
                                &lt;/h2&gt;
                                &lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='STATECUR']/n1:entry/n1:observation[n1:code/@code='4109']/n1:value[not(@nullFlavor)]"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='STATECUR']/n1:entry/n1:observation[n1:code/@code='4109']/n1:value"/&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;

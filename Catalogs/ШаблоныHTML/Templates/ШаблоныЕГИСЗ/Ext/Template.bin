                                                    &lt;/xsl:call-template&gt;
                                                &lt;/p&gt;
						                    &lt;/xsl:when&gt;
                                        &lt;/xsl:choose&gt;
						                &lt;xsl:choose&gt;
                                            &lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/n1:id/@extension[not(@nullFlavor)]"&gt;
					                            &lt;p class="tableblack"&gt;
							            		    &lt;xsl:text&gt;СНИЛС: &lt;/xsl:text&gt;

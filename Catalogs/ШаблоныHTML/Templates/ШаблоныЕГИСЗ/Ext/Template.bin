						                        &lt;/thead&gt;
												&lt;tbody&gt;
						                            &lt;xsl:for-each select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='PROC']/n1:entry/n1:observation[n1:code/@code='4110']/n1:entryRelationship/n1:observation"&gt;
						                                &lt;tr&gt;

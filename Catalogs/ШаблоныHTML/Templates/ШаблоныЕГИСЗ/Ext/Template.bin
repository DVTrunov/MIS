                                    &lt;xsl:text&gt;Местонахождение граждан для медико-социальной экспертизы&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:code/@codeSystem='1.2.643.5.1.13.13.99.2.856'][not(@nullFlavor)]"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:code/@codeSystem='1.2.643.5.1.13.13.99.2.856']/n1:code/@displayName"/&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/p&gt;
								&lt;xsl:choose&gt;
                                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:code/@code='4']/n1:participant/n1:participantRole/n1:addr[not(@nullFlavor)]"&gt;
										&lt;p class="tableblack"&gt;
										    &lt;xsl:text&gt;Адрес организации: &lt;/xsl:text&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:code/@code='4']/n1:participant/n1:participantRole/n1:addr/n1:streetAddressLine"/&gt;
										&lt;/p&gt;	
                                    &lt;/xsl:when&gt;
                                &lt;/xsl:choose&gt;
								&lt;xsl:choose&gt;
                                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:code/@code='4']/n1:participant/n1:participantRole/identity:Props/identity:Ogrn[not(@nullFlavor)]"&gt;
										&lt;p class="tableblack"&gt;
										    &lt;xsl:text&gt;ОГРН организации: &lt;/xsl:text&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:code/@code='4']/n1:participant/n1:participantRole/identity:Props/identity:Ogrn"/&gt;
										&lt;/p&gt;	
                                    &lt;/xsl:when&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
					    &lt;tr&gt;
					    	&lt;td colspan="8"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Гражданин направляется на медико-социальную экспертизу&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@codeSystem='1.2.643.5.1.13.13.11.1007'][not(@nullFlavor)]"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@codeSystem='1.2.643.5.1.13.13.11.1007']/n1:code/@displayName"/&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/p&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
						&lt;xsl:choose&gt;
				            &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@codeSystem='1.2.643.5.1.13.13.11.1053'][not(@nullFlavor)]"&gt;
						        &lt;tr&gt;        
									&lt;td colspan="8"&gt;	
										&lt;h2 class="tablegray"&gt;
						                    &lt;xsl:text&gt;Инвалидность:&lt;/xsl:text&gt;
						                &lt;/h2&gt;
						                &lt;xsl:for-each select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@codeSystem='1.2.643.5.1.13.13.11.1053']"&gt;
                                            &lt;p class="tableblack"&gt;
                                                &lt;xsl:value-of select="./n1:code/@displayName"/&gt;.
					                    		&lt;xsl:value-of select="./n1:code/n1:qualifier/n1:value/@displayName"/&gt;,
						                		&lt;xsl:value-of select="./n1:entryRelationship/n1:observation[n1:code/@code='4115']/n1:value/@displayName"/&gt;
						                		&lt;xsl:text&gt; (&lt;/xsl:text&gt;
						                		&lt;xsl:call-template name="formatDate"&gt;
                                                    &lt;xsl:with-param name="newdate" select="./n1:effectiveTime/n1:low/@value"/&gt;
                                                &lt;/xsl:call-template&gt;
						                		&lt;xsl:choose&gt;
				                                    &lt;xsl:when test="./n1:effectiveTime/n1:high[not(@nullFlavor)]"&gt;
						                			    &lt;xsl:text&gt; &amp;#8212; &lt;/xsl:text&gt;
						                			    &lt;xsl:call-template name="formatDate"&gt;
                                                            &lt;xsl:with-param name="newdate" select="./n1:effectiveTime/n1:high/@value"/&gt;
                                                        &lt;/xsl:call-template&gt;
						                		    &lt;/xsl:when&gt;
					                            &lt;/xsl:choose&gt;
						                		&lt;xsl:text&gt;)&lt;/xsl:text&gt;
												&lt;br/&gt;&lt;xsl:text&gt;Находился на инвалидности на момент направления: &lt;/xsl:text&gt;
												&lt;xsl:value-of select="./n1:entryRelationship/n1:observation[n1:code/@code='4169']/n1:value/@displayName"/&gt; 
												&lt;br/&gt;&lt;xsl:text&gt;Причина инвалидности: &lt;/xsl:text&gt;
												&lt;xsl:value-of select="./n1:entryRelationship/n1:act/n1:code[@codeSystem='1.2.643.5.1.13.13.11.1474']/@displayName"/&gt;
                                            &lt;/p&gt;
						                &lt;/xsl:for-each&gt;
								        &lt;xsl:choose&gt;
				                            &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4058'][not(@nullFlavor)]"&gt;
						                        &lt;h3 class="tableblack"&gt;
						                            &lt;u&gt;&lt;xsl:text&gt;Степень утраты профессиональной трудоспособности (%):&lt;/xsl:text&gt;&lt;/u&gt;
						                        &lt;/h3&gt;
								        		&lt;xsl:for-each select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4058']"&gt;
                                                    &lt;p class="tableblack"&gt;
                                                        &lt;xsl:value-of select="./n1:value/@value"/&gt;
                                                        &lt;xsl:text&gt;%&lt;/xsl:text&gt;
								        			    &lt;xsl:text&gt; (&lt;/xsl:text&gt;
								        			    &lt;xsl:value-of select="./n1:entryRelationship/n1:observation[n1:code/@code='4083']/n1:value/@displayName"/&gt;
								        			    &lt;xsl:text&gt; до &lt;/xsl:text&gt;
								        			    &lt;xsl:call-template name="formatDate"&gt;
                                                            &lt;xsl:with-param name="newdate" select="./n1:effectiveTime/n1:high/@value"/&gt;
                                                        &lt;/xsl:call-template&gt;
								        			    &lt;xsl:text&gt;)&lt;/xsl:text&gt;
								        		    &lt;/p&gt;
								        		&lt;/xsl:for-each&gt;
					                        &lt;/xsl:when&gt;
					                    &lt;/xsl:choose&gt;
									&lt;/td&gt;
								&lt;/tr&gt;
							&lt;/xsl:when&gt;
					    &lt;/xsl:choose&gt;	
					&lt;/table&gt;
					&lt;table class="block-form"&gt;
						&lt;tr&gt;
					    	&lt;td colspan="8"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Образование&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='EDU']/n1:entry/n1:observation[n1:code/@code='4100'][not(@nullFlavor)]"&gt;
										    &lt;xsl:text&gt;Наименование и адрес образовательной организации, в которой гражданин получает образование: &lt;/xsl:text&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:observation[n1:code/@code='4100']/n1:performer/n1:assignedEntity/n1:representedOrganization/n1:name"/&gt;
											&lt;xsl:choose&gt;
                                                &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='EDU']/n1:entry/n1:observation[n1:code/@code='4100']/n1:performer/n1:assignedEntity/n1:representedOrganization/n1:addr[not(@nullFlavor)]"&gt;
												    &lt;xsl:text&gt;, &lt;/xsl:text&gt;
											        &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:observation[n1:code/@code='4100']/n1:performer/n1:assignedEntity/n1:representedOrganization/n1:addr/n1:streetAddressLine"/&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:when&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/p&gt;
								&lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='EDU']/n1:entry/n1:observation[n1:code/@code='12137'][not(@nullFlavor)]"&gt;
											&lt;xsl:text&gt;Курс,класс, возрастная группа детского дошкольного учреждения: &lt;/xsl:text&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:observation[n1:code/@code='12137']/n1:value"/&gt;
                                        &lt;/xsl:when&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/p&gt;
								&lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='EDU']/n1:entry/n1:observation[n1:code/@code='4078'][not(@nullFlavor)]"&gt;
											&lt;xsl:text&gt;Профессия (специальность), для получения которой проводится обучение: &lt;/xsl:text&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:observation[n1:code/@code='4078']/n1:value"/&gt;
                                        &lt;/xsl:when&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/p&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
					&lt;/table&gt;
					&lt;xsl:choose&gt;
                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073'][not(@nullFlavor)]"&gt;
					        &lt;table class="block-form"&gt;
					        	&lt;tr&gt;
					            	&lt;td colspan="8"&gt;
                                        &lt;h2 class="tablegray"&gt;
                                            &lt;xsl:text&gt;Основная профессия (специальность, должность)&lt;/xsl:text&gt;
                                        &lt;/h2&gt;
					            		&lt;p class="tableblack"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:observation[n1:code/@code='4074'][not(@nullFlavor)]"&gt;
					        						&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:observation[n1:code/@code='4074']/n1:text"/&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/p&gt;
                                    &lt;/td&gt;
                                &lt;/tr&gt;
					        	&lt;tr&gt;
					            	&lt;td colspan="8"&gt;
                                        &lt;h2 class="tablegray"&gt;
                                            &lt;xsl:text&gt;Квалификация (класс, разряд, категория, звание)&lt;/xsl:text&gt;
                                        &lt;/h2&gt;
					            		&lt;p class="tableblack"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:observation[n1:code/@code='4075'][not(@nullFlavor)]"&gt;
					        						&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:observation[n1:code/@code='4075']/n1:text"/&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/p&gt;
                                    &lt;/td&gt;
                                &lt;/tr&gt;
					        	&lt;tr&gt;
					            	&lt;td colspan="8"&gt;
                                        &lt;h2 class="tablegray"&gt;
                                            &lt;xsl:text&gt;Стаж работы&lt;/xsl:text&gt;
                                        &lt;/h2&gt;
					            		&lt;p class="tableblack"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:observation[n1:code/@code='4076'][not(@nullFlavor)]"&gt;
					        						&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:observation[n1:code/@code='4076']/n1:text"/&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/p&gt;
                                    &lt;/td&gt;
                                &lt;/tr&gt;
					        	&lt;tr&gt;
					            	&lt;td colspan="8"&gt;
                                        &lt;h2 class="tablegray"&gt;
                                            &lt;xsl:text&gt;Выполняемая работа на момент направления на медико-социальную экспертизу&lt;/xsl:text&gt;
                                        &lt;/h2&gt;
					        			&lt;p class="tableblack"&gt;
					        			    &lt;xsl:choose&gt;
                                                &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:organizer[not(@nullFlavor)]"&gt;
					            		            &lt;p class="tableblack"&gt;
                                                        &lt;xsl:choose&gt;
                                                            &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:organizer[n1:code/@code='4077'][not(@nullFlavor)]"&gt;
					        			            			&lt;xsl:text&gt;Профессия: &lt;/xsl:text&gt;
					        									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:organizer[n1:code/@code='4077']/n1:component/n1:observation[n1:code/@code='4078']/n1:text"/&gt;&lt;br/&gt;
					        			            			&lt;xsl:text&gt;Специальность: &lt;/xsl:text&gt;
					        									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:organizer[n1:code/@code='4077']/n1:component/n1:observation[n1:code/@code='4079']/n1:text"/&gt;&lt;br/&gt;
					        			            			&lt;xsl:text&gt;Должность: &lt;/xsl:text&gt;
					        									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:organizer[n1:code/@code='4077']/n1:component/n1:observation[n1:code/@code='4080']/n1:text"/&gt;
                                                            &lt;/xsl:when&gt;
                                                        &lt;/xsl:choose&gt;
                                                    &lt;/p&gt;
					        			            &lt;p class="tableblack"&gt;
                                                        &lt;xsl:choose&gt;
                                                            &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:observation[n1:code/@code='4081'][not(@nullFlavor)]"&gt;
					        			            			&lt;xsl:text&gt;Условия и характер выполняемого труда: &lt;/xsl:text&gt;
					        									&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='WORK']/n1:entry/n1:organizer[n1:code/@code='4073']/n1:component/n1:observation[n1:code/@code='4081']/n1:text"/&gt;
                                                            &lt;/xsl:when&gt;
                                                        &lt;/xsl:choose&gt;
                                                    &lt;/p&gt;
					        			    	&lt;/xsl:when&gt;
					        			    	&lt;xsl:otherwise&gt;
                                                    &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                                &lt;/xsl:otherwise&gt;
					        			    &lt;/xsl:choose&gt;
					        			&lt;/p&gt;	
                                    &lt;/td&gt;
                                &lt;/tr&gt;
					        &lt;/table&gt;
						&lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;	
                    &lt;table class="block-form"&gt;
					    &lt;tr&gt;
					    	&lt;td colspan="8"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Протокол врачебной комиссии&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4059'][not(@nullFlavor)]"&gt;
                                            &lt;xsl:text&gt;№ &lt;/xsl:text&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4059']/n1:value"/&gt;
											&lt;xsl:text&gt; от &lt;/xsl:text&gt;
											&lt;xsl:call-template name="formatDate"&gt;
                                                &lt;xsl:with-param name="newdate" select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4059']/n1:effectiveTime/@value"/&gt;
                                            &lt;/xsl:call-template&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/p&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
						&lt;tr&gt;
					    	&lt;td colspan="8"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Медико-социальную экспертизу необходимо проводить на дому&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:if test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4060']/n1:value[@value='true']"&gt;
                                        &lt;xsl:text&gt;Да&lt;/xsl:text&gt;
                                    &lt;/xsl:if&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4060']/n1:value[@value='false']"&gt;
                                        &lt;xsl:text&gt;Нет&lt;/xsl:text&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/p&gt;
                            &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
					    	&lt;td colspan="4"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Нуждаемость в оказании паллиативной медицинской помощи&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:if test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4061']/n1:value[@value='true']"&gt;
                                        &lt;xsl:text&gt;Да&lt;/xsl:text&gt;
                                    &lt;/xsl:if&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4061']/n1:value[@value='false']"&gt;
                                        &lt;xsl:text&gt;Нет&lt;/xsl:text&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/p&gt;
                            &lt;/td&gt;
							&lt;td colspan="4"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Дата выдачи направления на МСЭ&lt;/xsl:text&gt;
                                &lt;/h2&gt;
                                &lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4062']/n1:value/@value[not(@nullFlavor)]"&gt;
                                            &lt;xsl:call-template name="formatDate"&gt;
                                                &lt;xsl:with-param name="newdate" select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='4062']/n1:value/@value"/&gt;
                                            &lt;/xsl:call-template&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                        &lt;/xsl:otherwise&gt;
					    			&lt;/xsl:choose&gt;
                                &lt;/p&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
					    &lt;tr&gt;
					        &lt;td colspan="8"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Цели направления на медико-социальную экспертизу&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@codeSystem='1.2.643.5.1.13.13.99.2.147'][not(@nullFlavor)]"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@codeSystem='1.2.643.5.1.13.13.99.2.147']/n1:code/@displayName"/&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:text&gt;-&lt;/xsl:text&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/p&gt;
                            &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
					    	&lt;td colspan="8"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Нуждаемость в первичном протезировании&lt;/xsl:text&gt;
                                &lt;/h2&gt;
					    		&lt;p class="tableblack"&gt;
                                    &lt;xsl:if test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='7012']/n1:value[@value='true']"&gt;
                                        &lt;xsl:text&gt;Да&lt;/xsl:text&gt;
                                    &lt;/xsl:if&gt;
									&lt;xsl:if test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section/n1:entry/n1:act[n1:statusCode/@code='active']/n1:entryRelationship/n1:observation[n1:code/@code='7012']/n1:value[@value='false']"&gt;
                                        &lt;xsl:text&gt;Нет&lt;/xsl:text&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/p&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
					&lt;/table&gt;
					&lt;table class="block-form"&gt;
						&lt;tr&gt;
                            &lt;td colspan="8"&gt;
                                &lt;h2 class="tablegray"&gt;
                                    &lt;xsl:text&gt;Анамнез&lt;/xsl:text&gt;
                                &lt;/h2&gt;
							    &lt;p class="tableblack"&gt;
						        &lt;xsl:choose&gt;
				                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4101'][not(@nullFlavor)]"&gt;
						                &lt;h3 class="tableblack"&gt;
						                	&lt;u&gt;&lt;xsl:text&gt;Год, с которого наблюдается в медицинской организации:&lt;/xsl:text&gt;&lt;/u&gt;
						                &lt;/h3&gt;
                                        &lt;p class="tableblack"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4101']/n1:value"/&gt;
                                            &lt;xsl:text&gt; год&lt;/xsl:text&gt;
										&lt;/p&gt;
					                &lt;/xsl:when&gt;
					            &lt;/xsl:choose&gt;
						        &lt;xsl:choose&gt;
				                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4102'][not(@nullFlavor)]"&gt;
						                &lt;h3 class="tableblack"&gt;
						                	&lt;u&gt;&lt;xsl:text&gt;Анамнез заболевания:&lt;/xsl:text&gt;&lt;/u&gt;
						                &lt;/h3&gt;
                                        &lt;p class="tableblack"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4102']/n1:value"/&gt;
                                        &lt;/p&gt;
					                &lt;/xsl:when&gt;
					            &lt;/xsl:choose&gt;
								&lt;xsl:choose&gt;
				                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4103'][not(@nullFlavor)]"&gt;
						                &lt;h3 class="tableblack"&gt;
						                	&lt;u&gt;&lt;xsl:text&gt;Анамнез жизни:&lt;/xsl:text&gt;&lt;/u&gt;
						                &lt;/h3&gt;
                                        &lt;p class="tableblack"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4103']/n1:value"/&gt;
                                        &lt;/p&gt;
					                &lt;/xsl:when&gt;
					            &lt;/xsl:choose&gt;
								&lt;xsl:choose&gt;
				                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4082'][not(@nullFlavor)]"&gt;
						                &lt;h3 class="tableblack"&gt;
						                	&lt;u&gt;&lt;xsl:text&gt;Физическое развитие (в отношении детей в возрасте до 3 лет):&lt;/xsl:text&gt;&lt;/u&gt;
						                &lt;/h3&gt;
                                        &lt;p class="tableblack"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4082']/n1:text"/&gt;
                                        &lt;/p&gt;
					                &lt;/xsl:when&gt;
					            &lt;/xsl:choose&gt;
								&lt;xsl:choose&gt;
				                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:organizer/n1:component/n1:act[n1:code/@code='4057'][not(@nullFlavor)]"&gt;
						                &lt;h4 class="tableblack"&gt;
						                	&lt;u&gt;&lt;xsl:text&gt;Временная нетрудоспособность:&lt;/xsl:text&gt;&lt;/u&gt;
						                &lt;/h4&gt;
                                        &lt;p class="tableblack"&gt;
											&lt;table class="table-break"&gt;
											    &lt;thead&gt;
					                                &lt;th class="param"&gt;Дата начала&lt;/th&gt;
						                            &lt;th class="param"&gt;Дата окончания&lt;/th&gt;
													&lt;th class="param"&gt;Число дней&lt;/th&gt;
											    	&lt;th class="param"&gt;Шифр МКБ&lt;/th&gt;
						                        &lt;/thead&gt;
												&lt;tbody&gt;
						                            &lt;xsl:for-each select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:organizer/n1:component/n1:act[n1:code/@code='4057']"&gt;
						                                &lt;tr&gt;
                                                            &lt;td class="param"&gt;
                                                                &lt;p class="tableresult"&gt;
											        		        &lt;xsl:call-template name="formatDate"&gt;
                                                                        &lt;xsl:with-param name="newdate" select="./n1:effectiveTime/n1:low/@value"/&gt;
                                                                    &lt;/xsl:call-template&gt;	
						                                      	&lt;/p&gt;
                                                            &lt;/td&gt;
						                                  	&lt;td class="param"&gt;
                                                                &lt;p class="tableresult"&gt;
						                                      		&lt;xsl:call-template name="formatDate"&gt;
                                                                        &lt;xsl:with-param name="newdate" select="./n1:effectiveTime/n1:high/@value"/&gt;
                                                                    &lt;/xsl:call-template&gt;
						                                      	&lt;/p&gt;
                                                            &lt;/td&gt;
															&lt;td class="param"&gt;
                                                                &lt;p class="tableresult"&gt;
						                                      		&lt;xsl:call-template name="getDays"&gt;
                                                                        &lt;xsl:with-param name="birthdate" select="./n1:effectiveTime/n1:low/@value"/&gt;
																		&lt;xsl:with-param name="deathdate" select="./n1:effectiveTime/n1:high/@value"/&gt;
                                                                    &lt;/xsl:call-template&gt;
						                                      	&lt;/p&gt;
                                                            &lt;/td&gt;
											        	    &lt;td class="param"&gt;
                                                                &lt;p class="tableresult"&gt;
						                                      		&lt;xsl:value-of select="./n1:entryRelationship/n1:observation/n1:code/@code"/&gt;	
						                                      	&lt;/p&gt;
                                                            &lt;/td&gt;
						                                &lt;/tr&gt;
						                            &lt;/xsl:for-each&gt;
												&lt;/tbody&gt;	
											&lt;/table&gt;		
                                        &lt;/p&gt;
					                &lt;/xsl:when&gt;
					            &lt;/xsl:choose&gt;
								&lt;xsl:choose&gt;
				                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:organizer/n1:component/n1:observation[n1:code/@code='4063'][not(@nullFlavor)]"&gt;
						                &lt;h3 class="tableblack"&gt;
						                	&lt;u&gt;&lt;xsl:text&gt;Номер электронного листка нетрудоспособности:&lt;/xsl:text&gt;&lt;/u&gt;
						                &lt;/h3&gt;
                                        &lt;p class="tableblack"&gt;
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:organizer/n1:component/n1:observation[n1:code/@code='4063']/n1:value/@value"/&gt;
                                        &lt;/p&gt;
					                &lt;/xsl:when&gt;
					            &lt;/xsl:choose&gt;
						        &lt;xsl:choose&gt;
				                    &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4107'][not(@nullFlavor)]"&gt;
						                &lt;u&gt;&lt;h3 class="tableblack"&gt;
						                	&lt;xsl:text&gt;Результаты и эффективность проведенных мероприятий медицинской реабилитации, рекомендованных индивидуальной программой реабилитации или абилитации инвалида (ребенка-инвалида) №&lt;/xsl:text&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4104']/n1:value"/&gt;
											&lt;xsl:text&gt; к протоколу проведения медико-социальной экспертизы №&lt;/xsl:text&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4105']/n1:value"/&gt;
											&lt;xsl:text&gt; от &lt;/xsl:text&gt;
											&lt;xsl:call-template name="formatDate"&gt;
                                                &lt;xsl:with-param name="newdate" select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4106']/n1:value/@value"/&gt;
                                            &lt;/xsl:call-template&gt;:
						                &lt;/h3&gt;&lt;/u&gt;
                                        &lt;p class="tableblack"&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4064']/n1:code/@displayName"/&gt;:
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4064']/n1:value/@displayName"/&gt;&lt;br/&gt;
											&lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4065']/n1:code/@displayName"/&gt;:
                                            &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='SOCANAM']/n1:entry/n1:observation[n1:code/@code='4065']/n1:value/@displayName"/&gt;
                                        &lt;/p&gt;
					                &lt;/xsl:when&gt;
					            &lt;/xsl:choose&gt;
								&lt;/p&gt;
							&lt;/td&gt;
                        &lt;/tr&gt;
					&lt;/table&gt;
					&lt;table class="block-form"&gt;
					    &lt;xsl:choose&gt;
				            &lt;xsl:when test="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='VITALPARAM']/n1:entry"&gt;
                                &lt;tr&gt;
                                    &lt;td colspan="8"&gt;
                                        &lt;h4 class="tablegray"&gt;
 					             		    &lt;xsl:text&gt;Витальные параметры&lt;/xsl:text&gt;

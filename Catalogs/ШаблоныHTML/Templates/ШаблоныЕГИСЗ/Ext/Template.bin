			<Description>Направление на консультацию и во вспомогательные кабинеты</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div class="FORMAT" style="WIDTH:19cm;word-wrap:break-word"&gt;
			&lt;div style="font-weight:bold;text-align:center"&gt;
				&lt;div&gt;Направление на консультацию&lt;/div&gt;
				&lt;div&gt;и во вспомогательные кабинеты&lt;/div&gt;
			&lt;/div&gt;
			&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Врач:&lt;/td&gt;
						&lt;td&gt;
							&lt;a id="2ade98ad-d52e-11e5-986c-3a893ef5765d" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="padding-left:10px;padding-right:5px"&gt;Дата направления:&lt;/td&gt;
						&lt;td&gt;
							&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
					&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Пациент:&lt;/td&gt;
						&lt;td&gt;
							&lt;a id="f7bece55-cafa-11e5-9bc7-50af732359f4" href="about:"&gt;[...]&lt;/a&gt;
						&lt;/td&gt;
						&lt;td style="padding-left:10px;padding-right:5px"&gt;Дата рождения:&lt;/td&gt;
						&lt;td&gt;
							&lt;a id="2561c9fe-cc22-11e2-87cb-002618dcef2c" href="about:"&gt;[...]&lt;/a&gt;
							&lt;span&gt;(&lt;/span&gt;
							&lt;a id="4d22b3c0-03bd-11e3-943d-1c6f653fefc3" href="about:"&gt;[...]&lt;/a&gt;
							&lt;span&gt;)&lt;/span&gt;
						&lt;/td&gt;
					&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;br&gt;&lt;div data-bit-sectionname="SCOPORG"&gt;
				&lt;div style="font-weight:bold"&gt;Цель направления и медицинская организация:&lt;/div&gt;
				&lt;div&gt;
					&lt;div&gt;
						&lt;span&gt;Направлен:&lt;/span&gt;
						&lt;a id="34ef5483-9af5-11ed-831a-40167e631f2e" href="about:"&gt;[...]&lt;/a&gt;

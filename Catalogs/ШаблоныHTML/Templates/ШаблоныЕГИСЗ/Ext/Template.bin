								        			        	        				&lt;xsl:choose&gt;
								        			        	                            &lt;xsl:when test="./n1:consumable/n1:manufacturedProduct/n1:manufacturedMaterial/n1:name"&gt;
								        			        	        			            &lt;xsl:text&gt; [&lt;/xsl:text&gt;
								        			        	                                &lt;xsl:value-of select="./n1:consumable/n1:manufacturedProduct/n1:manufacturedMaterial/n1:name"/&gt;
								        			        	        						&lt;xsl:text&gt;]&lt;/xsl:text&gt;
								        			        	        	                &lt;/xsl:when&gt;

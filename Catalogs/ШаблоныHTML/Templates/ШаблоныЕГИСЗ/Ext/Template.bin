				<Row>
					<Реквизит>Клиент</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>725adb9a-4d7b-11ef-b694-b48c9d003dd0</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Заключение сменного осмотра</Description>
			<АлгоритмВычисления>Если ТипЗнч(Параметры.ВидОсмотраСменный) = Тип("СправочникСсылка.ВидыМедицинскихДокументов")
	И (Параметры.ВидОсмотраСменный.УИДЕГИСЗ = 513
		Или Параметры.ВидОсмотраСменный.УИДЕГИСЗ = 516)
Тогда
	Если Параметры.ЗаключениеСменногоОсмотра Тогда
		Результат = "Имеются признаки воздействия вредных и (или) опасных производственных факторов, состояний и заболеваний, препятствующих выполнению трудовых обязанностей, в том числе алкогольного, наркотического или иного токсического опьянения и остаточных явлений такого опьянения.";
	Иначе
		Результат = "Отсутствуют признаки воздействия вредных и (или) опасных производственных факторов, состояний и заболеваний, препятствующих выполнению трудовых обязанностей, в том числе алкогольного, наркотического или иного токсического опьянения и остаточных явлений такого опьянения."
    КонецЕсли;
Иначе
	Если Параметры.ЗаключениеСменногоОсмотра Тогда
		Результат = "Имеются признаки воздействия вредных и (или) опасных производственных факторов рабочей среды и трудового процесса на состояние здоровья работника, острого профессионального заболевания или отравления, признаков алкогольного, наркотического или иного токсического опьянения.";
	Иначе
		Результат = "Отсутствуют признаки вредных и (или) опасных производственных факторов рабочей среды и трудового процесса на состояние здоровья работника, острого профессионального заболевания или отравления, признаков алкогольного, наркотического или иного токсического опьянения."
    КонецЕсли;
	
КонецЕсли;

Если Параметры.ЗаключениеСменногоОсмотра И ЗначениеЗаполнено(Параметры.ПризнакиВоздействияВредныхФакт) Тогда
	Результат = Результат + " Признаки: " + Параметры.ПризнакиВоздействияВредныхФакт;
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных>
				<Row>

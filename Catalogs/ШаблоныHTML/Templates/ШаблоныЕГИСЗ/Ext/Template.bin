            &lt;assert test="@classCode='DOCCLIN'"&gt;У3-17. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument должен иметь значение атрибута @classCode равное 'DOCCLIN'.&lt;/assert&gt;
            &lt;assert test="@moodCode='EVN'"&gt;У3-17. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument должен иметь значение атрибута @moodCode равное 'EVN'.&lt;/assert&gt;
            &lt;assert test="count(id)=2"&gt;У3-17. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument должен иметь 2 элемента id.&lt;/assert&gt;
            &lt;report test="@nullFlavor"&gt;У3-17. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument не должен иметь атрибут @nullFlavor.&lt;/report&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument/id[1][not(@nullFlavor)]"&gt;
            &lt;assert test="matches(@root,'^[0-2](\.([1-9][0-9]*|0))+\.100([.]([1-9][0-9]*|0))+\.51$')"&gt;У3-17. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument/id[1] должен иметь синтаксически корректное значение атрибута @root, сформированное по правилу формирования идентификаторов документов, т.е. "OID_медицинской_организации.100.НомерМИС.НомерЭкзМИС.51".&lt;/assert&gt;
            &lt;assert test="@extension!=''"&gt;У3-17. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument/id[1] должен иметь не пустое значение атрибута @extension.&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument/id[2][not(@nullFlavor)]"&gt;
            &lt;assert test="@root='1.2.643.5.1.13.13.17.1.1'"&gt;У3-17. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument/id[2] должен иметь значение атрибута @root равное '1.2.643.5.1.13.13.17.1.1'.&lt;/assert&gt;
            &lt;assert test="matches(@extension,'(^[0-9]{2}[.][0-9]{2}[.][0-9]{3,4}[.][0-9]{9}$|^[0-9]{1,3}[.][0-9]{2}[.][0-9]{2}[.][0-9]{2}[.][0-9]{9}$)')"&gt;У3-17. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='SPECMEDCARE']/entry/act[code[@code='346']]/reference/externalDocument/id[2] должен иметь синтаксически корректное значение атрибута @extension, соответствующее формату "^[0-9]{2}[.][0-9]{2}[.][0-9]{3,4}[.][0-9]{9}$" или "^[0-9]{1,3}[.][0-9]{2}[.][0-9]{2}[.][0-9]{2}[.][0-9]{9}$".&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;
    &lt;!-- У3-18 --&gt;
    &lt;pattern&gt;
        &lt;rule context="ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS']"&gt;
            &lt;assert test="count(entry[act])&gt;=1"&gt;У3-18. Элемент ClinicalDocument/component/structuredBody/component/section[code/@code='LINKDOCS'] должен иметь не менее 1 элемента entry[act].&lt;/assert&gt;
        &lt;/rule&gt;
    &lt;/pattern&gt;




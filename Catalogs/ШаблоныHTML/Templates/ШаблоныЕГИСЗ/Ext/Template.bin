						&lt;span&gt;(&lt;/span&gt;
						&lt;a id="f4320b1f-5d10-11ee-a44f-984827df4433" href="about:"&gt;[...]&lt;/a&gt;
						&lt;span&gt;)&lt;/span&gt;
					&lt;/span&gt;
				&lt;/div&gt;
				&lt;div&gt;
					&lt;span&gt;Цель проведения врачебной комиссии:&lt;/span&gt;

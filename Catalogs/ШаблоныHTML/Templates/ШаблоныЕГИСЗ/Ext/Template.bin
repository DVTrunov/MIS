			<Текст>Признаки токсического опьянения</Текст>
			<Пользователь>00000000-0000-0000-0000-000000000000</Пользователь>
			<Параметр xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="ChartOfCharacteristicTypesRef.ПараметрыHTML">07262f0d-4fce-11ef-b697-1c697a9ea640</Параметр>

						        &lt;tr&gt;
                                    &lt;td colspan="8"&gt;
						        		&lt;p class="tableblack"&gt;
					            		    &lt;xsl:choose&gt;
					            			    &lt;xsl:when test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian /identity:AuthorityDoc[not(@nullFlavor)]"&gt;
					            				    &lt;xsl:text&gt;Документ, удостоверяющий полномочия: &lt;/xsl:text&gt;

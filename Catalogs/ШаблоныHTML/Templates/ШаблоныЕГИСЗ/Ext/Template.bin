							    					&lt;xsl:value-of select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian/identity:IdentityDoc/identity:IdentityCardType/@displayName"/&gt;
						        					&lt;xsl:text&gt;: &lt;/xsl:text&gt;
					            				    &lt;xsl:choose&gt;

			<Description>Протокол лабораторного исследования Редакция 5 (мин)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div style="WIDTH:19cm"&gt;
			&lt;div style="text-align:center;font-weight:bold"&gt;Протокол лабораторного исследования&lt;/div&gt;
			&lt;br&gt;&lt;div&gt;
				&lt;div style="font-weight:bold"&gt;Забор материала&lt;/div&gt;
				&lt;div data-bit-sectionname="SPECIMENS"&gt;
					&lt;table border="1" style="border-color: inherit; border-style: solid; border-collapse: collapse;width:100%;height:px" data-bit-dyntable-id="db0d0214-2c80-11ef-b68f-001a7dda7110"&gt;&lt;tbody&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="text-align:center;word-wrap:break-word;vertical-align:middle;width:20%"&gt;Дата поступления материала&lt;/td&gt;
								&lt;td style="text-align:center;word-wrap:break-word;vertical-align:middle;width:20%"&gt;Штрихкод&lt;/td&gt;
								&lt;td style="text-align: center; word-wrap: break-word; vertical-align: middle; width: 60%;"&gt;Исследуемый образец&lt;/td&gt;
							&lt;/tr&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="text-align:center;word-wrap:break-word;vertical-align:middle;width:20%"&gt;
									&lt;a id="0f238744-32ab-11ee-a448-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/td&gt;
								&lt;td style="text-align:center;word-wrap:break-word;vertical-align:middle;width:20%"&gt;
									&lt;a id="0f238747-32ab-11ee-a448-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/td&gt;
								&lt;td style="text-align: center; word-wrap: break-word; vertical-align: middle; width: 60%;"&gt;
									&lt;a id="0f238746-32ab-11ee-a448-1c697a9ea640" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/td&gt;
							&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
			&lt;/div&gt;
			&lt;div&gt;
				&lt;br&gt;&lt;div style="font-weight:bold"&gt;Исследования&lt;/div&gt;
				&lt;div data-bit-sectionname="RESLAB"&gt;

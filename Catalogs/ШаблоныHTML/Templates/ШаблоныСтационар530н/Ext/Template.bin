						&lt;/tr&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="width:40%"&gt;
								&lt;span&gt;Ответственная медсестра:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="width: 60%; vertical-align: middle;"&gt;
								&lt;a id="7c9eb266-69c9-11ef-b696-b48c9d003dd0" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
						&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;

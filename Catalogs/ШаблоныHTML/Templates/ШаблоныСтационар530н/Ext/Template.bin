			<Description>Протокол трансфузии (530н, CDA ред.5)</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;&lt;html&gt;&lt;body&gt;
		&lt;div class="FORMAT" style="WIDTH: 19cm;"&gt;
			&lt;div style="text-align: center;"&gt;
				&lt;span style="font-size:large;font-weight:bold"&gt;Протокол трансфузии&lt;/span&gt;
			&lt;/div&gt;
			&lt;br&gt;&lt;div&gt;
				&lt;table border="1" style="word-wrap:break-word;vertical-align:middle;border-color:inherit;border-style:solid;border-collapse:collapse;width:100%"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style="width:40%"&gt;
								&lt;span&gt;Показания к трансфузии:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="width:60%"&gt;
								&lt;a id="6c7ba7ce-69bf-11ef-b696-b48c9d003dd0" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
						&lt;/tr&gt;&lt;tr&gt;&lt;td style="width:40%"&gt;
								&lt;span&gt;Состояние по шкале:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="width:60%"&gt;
								&lt;a id="731df016-69cf-11ef-b696-b48c9d003dd0" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
						&lt;/tr&gt;&lt;tr&gt;&lt;td style="width:40%"&gt;
								&lt;span&gt;Компонент крови:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="width:60%"&gt;
								&lt;a id="ee3e3ff1-69cf-11ef-b696-b48c9d003dd0" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
						&lt;/tr&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="width:40%"&gt;
								&lt;span&gt;Объем компонента крови:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="vertical-align: middle; width: 60%;"&gt;
								&lt;input id="6c7ba7cf-69bf-11ef-b696-b48c9d003dd0" style="width:20%"&gt;&lt;/input&gt; 
								&lt;a id="6c7ba7d0-69bf-11ef-b696-b48c9d003dd0" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
						&lt;/tr&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="vertical-align: middle; width: 40%;"&gt;
								&lt;span&gt;№ контейнера компонента крови:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="width:60%"&gt;
								&lt;input style="width:20%;height:px" id="6c7ba7d1-69bf-11ef-b696-b48c9d003dd0"&gt;&lt;/input&gt;&lt;/td&gt;
						&lt;/tr&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="width:40%"&gt;
								&lt;span&gt;Дата заготовки:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="vertical-align: middle; width: 60%;"&gt;
								&lt;a id="f675e2c5-798c-11ef-9c5a-50af732359a9" href="about:"&gt;[...]&lt;/a&gt;
							&lt;/td&gt;
						&lt;/tr&gt;&lt;tr style="height: 0px;"&gt;&lt;td style="width:40%"&gt;
								&lt;span&gt;Срок годности компонента крови:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="vertical-align: middle; width: 60%;"&gt;
								&lt;a id="6c7ba7d2-69bf-11ef-b696-b48c9d003dd0" href="about:"&gt;[...]&lt;/a&gt;

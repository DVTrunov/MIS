	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>694621f6-b0f0-11ed-a353-b42e9995fee4</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Врач: Должность, Специализация по классификаторам </Description>
			<АлгоритмВычисления>Попытка
	ДанныеВрача = МедицинскаяДеятельность.ДолжностьСпециализацияВрача(ДокументОбъект.Врач);
	
	Если Не ПустаяСтрока(ДанныеВрача.ДолжностьПредставление) Тогда
		Результат = ДанныеВрача.ДолжностьПредставление;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДанныеВрача.СпециализацияПредставление) Тогда
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ", ";
		КонецЕсли;
		Результат = Результат + ДанныеВрача.СпециализацияПредставление;
	КонецЕсли;
Исключение 
КонецПопытки;
</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных/>
			<СвязанныеРеквизиты>
				<Row>
					<Реквизит>Врач</Реквизит>
				</Row>
			</СвязанныеРеквизиты>
		</CatalogObject.ВычисляемыеЗначенияПараметров>
	</ВычисляемоеЗначение>
	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>cf6126da-9713-11ed-81b5-50af73235947</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>568ca46d-a095-11ed-a353-b42e9995fee4</Parent>
			<Description>Часы_операции</Description>
			<АлгоритмВычисления>Н_мин = Параметры.Начало_мин;
К_мин = Параметры.Конец_мин;
Н_час = Параметры.Начало_час;
К_час = Параметры.Конец_час;
Н_день = Параметры.Начало_день;
К_день = Параметры.Конец_день; 
Часы = 0;

Если  ЗначениеЗаполнено(Н_мин)
	И ЗначениеЗаполнено(К_мин)
	И ЗначениеЗаполнено(Н_час)
	И ЗначениеЗаполнено(К_час)
	И ЗначениеЗаполнено(Н_день)
	И ЗначениеЗаполнено(К_день)
Тогда
	Если Число(Н_мин) &gt; Число(К_мин) Тогда 
		Часы = Часы -1;
	КонецЕсли;
	Часы = Часы + Число(К_час)- Число(Н_час); 
	Если Число(Н_час) &gt; Число(К_час) Тогда 
		Часы = Часы + 24 -24; 
	КонецЕсли; 
	Если (К_день - Н_день) &lt;&gt; 0 Тогда 
		Часы_даты = (К_день - Н_день)/86400;
		Часы = Часы + Часы_даты*24;
	КонецЕсли;
	Результат = Строка(Часы); 
Иначе
	Результат = "";      
КонецЕсли;</АлгоритмВычисления>
			<ПолучательВычисляемогоЗначения>ПараметрШаблонаПриема</ПолучательВычисляемогоЗначения>
			<СписокПеременных>
				<Row>
					<Параметр>5aff98f5-9304-11ed-81b5-50af73235947</Параметр>
					<ИмяПеременной>Начало_мин</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
				<Row>

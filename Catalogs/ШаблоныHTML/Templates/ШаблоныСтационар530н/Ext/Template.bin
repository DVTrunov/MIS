				<Row>
					<Параметр>5aff98f5-9304-11ed-81b5-50af73235947</Параметр>
					<ИмяПеременной>Начало</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
				<Row>
					<Параметр>5aff98f8-9304-11ed-81b5-50af73235947</Параметр>
					<ИмяПеременной>Конец</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
			</СписокПеременных>

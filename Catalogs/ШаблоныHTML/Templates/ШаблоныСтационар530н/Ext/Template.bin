											&lt;xsl:text&gt; (&lt;/xsl:text&gt;
						              	    &lt;xsl:value-of select="/n1:ClinicalDocument/n1:component/n1:structuredBody/n1:component/n1:section[n1:code/@code='DOCINFO']/n1:entry/n1:observation[n1:code/@code='9084']/n1:value/n1:originalText"/&gt;

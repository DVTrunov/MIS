					<ИмяПеременной>Конец_мин</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
				<Row>
					<Параметр>5aff98f1-9304-11ed-81b5-50af73235947</Параметр>
					<ИмяПеременной>Начало_час</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
				<Row>
					<Параметр>5aff98f4-9304-11ed-81b5-50af73235947</Параметр>
					<ИмяПеременной>Конец_час</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
				<Row>
					<Параметр>5aff98ec-9304-11ed-81b5-50af73235947</Параметр>
					<ИмяПеременной>Начало_день</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
				<Row>
					<Параметр>5aff98f9-9304-11ed-81b5-50af73235947</Параметр>
					<ИмяПеременной>Конец_день</ИмяПеременной>
					<Приемник>00000000-0000-0000-0000-000000000000</Приемник>
				</Row>
			</СписокПеременных>

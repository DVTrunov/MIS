	<ВычисляемоеЗначение>
		<CatalogObject.ВычисляемыеЗначенияПараметров>
			<Ref>cf6126d9-9713-11ed-81b5-50af73235947</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>00000000-0000-0000-0000-000000000000</Parent>
			<Description>Минуты_операции</Description>
			<АлгоритмВычисления>   Начало = Параметры.Начало;
   Конец = Параметры.Конец;
   Если ЗначениеЗаполнено(Начало) И ЗначениеЗаполнено(Конец) Тогда
        Если Число(Конец) &lt; Число(Начало) Тогда
             Минуты = Число(Конец) + 60 - Число(Начало); 
        Иначе
             Минуты = Число(Конец) - Число(Начало); 
        КонецЕсли;
        Если Минуты &lt; 10 Тогда
             Результат = "0" + Строка(Минуты);
        Иначе    
             Результат = Строка(Минуты);
        КонецЕсли;               
   Иначе Результат = "";       
   КонецЕсли;</АлгоритмВычисления>

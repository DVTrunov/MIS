						&lt;xsl:choose&gt;
					        &lt;xsl:when test="/n1:ClinicalDocument/n1:documentationOf/n1:serviceEvent[n1:code/@code='73']/n1:effectiveTime[not(@nullFlavor)]"&gt;
					            &lt;tr&gt;	
                                    &lt;td colspan="8"&gt;
									    &lt;p class="tableblack"&gt;
										    &lt;xsl:text&gt;Дата и время начала трансфузии: &lt;/xsl:text&gt;

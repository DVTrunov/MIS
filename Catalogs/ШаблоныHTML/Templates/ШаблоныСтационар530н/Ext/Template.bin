					<ГруппирующееПоле xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
					<ОбъединяющееПоле xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>

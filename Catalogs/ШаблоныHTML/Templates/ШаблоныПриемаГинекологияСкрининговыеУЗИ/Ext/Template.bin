Результат = СтруктураАдреса.Дом;

Если ЗначениеЗаполнено(СтруктураАдреса.Корпус) Тогда
	Результат = Результат + "-" + СтруктураАдреса.Корпус;
КонецЕсли;</АлгоритмВычисления>

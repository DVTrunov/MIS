	<Шаблон>
		<CatalogObject.ШаблоныHTML>
			<Ref>2496f38b-36df-11ec-8196-50af73235947</Ref>
			<IsFolder>false</IsFolder>
			<DeletionMark>false</DeletionMark>
			<Parent>5439321d-f70c-11e5-91be-1078d2d69bb4</Parent>
			<Code>000000209</Code>
			<Description>Скрининговое УЗИ в 19-21 неделю беременности</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="WIDTH: 19cm"&gt;
			&lt;div style="text-align: center;"&gt;
				&lt;b&gt;
					&lt;font size="3"&gt;Протокол скринингового ультразвукового исследования в 19 - 21 неделю беременности&lt;/font&gt;
				&lt;/b&gt;
			&lt;/div&gt;
			&lt;div style="text-align: center;"&gt;
				&lt;table width="100%" border="1" style="font-size:11pt; border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
					&lt;tbody&gt;
						&lt;tr&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 62%;"&gt;
								&lt;p&gt; Исследование № 
									&lt;span style="font-weight: bold;"&gt;
										&lt;input id="5b4c1825-2b44-11ec-8195-50af73235947" style="text-align: center; font-weight: bold; width: 40px;"/&gt;
									&lt;/span&gt;
								&lt;/p&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 38%;"&gt;
								&lt;p&gt; Дата исследования: 
									&lt;b&gt;
										&lt;a id="99e2a614-4243-11e4-8253-0cd29229b33b" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 62%;"&gt;
								&lt;p&gt; Ф.И.О. беременной:
									&lt;b&gt;
										&lt;a id="21632635-d7c9-11e1-bab2-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/p&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 38%;"&gt;
								&lt;p&gt; Возраст 
									&lt;b&gt;
										&lt;a id="4d22b3c0-03bd-11e3-943d-1c6f653fefc3" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 62%;"&gt;
								&lt;p&gt; Первый день последней менструации:
									&lt;b&gt;
										&lt;a id="bbf3c1b0-2bf1-11ec-8195-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/p&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 38%;"&gt;
								&lt;p&gt; Срок беременности: 
									&lt;b&gt;
										&lt;a id="9df96ddf-2d99-11ec-8195-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;нед. 
									&lt;b&gt;
										&lt;a id="9df96de2-2d99-11ec-8195-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt; дн.&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 62%;" colspan="2"&gt;
								&lt;p&gt; Срок беременности по скрининговому УЗИ в 1 триместре
									&lt;b&gt;
										&lt;a id="2496f387-36df-11ec-8196-50af73235947" href="about:" style="text-align: center;"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
									&lt;span style="text-align: center;"&gt;нед. &lt;/span&gt;
									&lt;b&gt;
										&lt;a id="2496f388-36df-11ec-8196-50af73235947" href="about:" style="text-align: center;"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
									&lt;span style="text-align: center;"&gt;дн.
										&lt;br/&gt;
									&lt;/span&gt;
									&lt;span style="text-align: center;font-size: 10pt;"&gt;  (при несоответствии гестационному сроку)&lt;/span&gt;
								&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 62%;"&gt;
								&lt;p&gt; Вид исследования:
									&lt;b&gt;
										&lt;select id="5b4c1828-2b44-11ec-8195-50af73235947"&gt;
											&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;трансвагинальный&amp;quot;}"&gt;трансвагинальный&lt;/option&gt;
											&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;трансабдоминальный&amp;quot;}"&gt;трансабдоминальный&lt;/option&gt;
										&lt;/select&gt;
									&lt;/b&gt;
								&lt;/p&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 38%;"&gt;
								&lt;p&gt; Количество плодов: 
									&lt;b&gt;
										&lt;a id="9df96de4-2d99-11ec-8195-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/p&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/tbody&gt;
				&lt;/table&gt;
			&lt;/div&gt;
			&lt;table width="100%" border="1" style="font-size:11pt; border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Сердцебиение плода: 
								&lt;b&gt;ЧСС плода (уд./мин.) - 
									&lt;span&gt;
										&lt;a id="2496f38c-36df-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt; (
										&lt;span&gt;
											&lt;a id="2496f38d-36df-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
										&lt;/span&gt;)&lt;/span&gt;
								&lt;/b&gt;
								&lt;span/&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; 
								&lt;u&gt;Фетометрия&lt;/u&gt; (оценить в мм с указанием соответствия процентильным значениям при отклонении)&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;"&gt;
							&lt;p&gt; Бипариетальный диаметр (БПР)
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="624efb69-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt; &lt;/b&gt;мм
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="624efb6a-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt; &lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 50%;"&gt;
							&lt;p&gt; Окружность живота (ОЖ)
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="624efb6d-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt; мм
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="624efb6e-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;"&gt;
							&lt;p&gt; Окружность головы (ОГ)
								&lt;b&gt;
									&lt;a id="624efb6b-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt; мм
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="624efb6c-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 50%;"&gt;
							&lt;p&gt; Длина бедра (ДБ) 
								&lt;span&gt;
									&lt;b&gt;
										&lt;a id="624efb6f-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/span&gt; мм
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="624efb70-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt; &lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td colspan="2" style="word-wrap: break-word; vertical-align: middle; width: 49%;"&gt;
							&lt;p&gt; Длина других костей (по показаниям):
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="f5ccbae5-37b7-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt; &lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Размеры плода соответствуют сроку беременности:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="f5ccbae7-37b7-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Предполагаемая масса плода 
								&lt;b&gt;
									&lt;span&gt;
										&lt;input id="6b811b52-3aff-11ec-8197-50af73235947" style="width: 7%;"/&gt;
									&lt;/span&gt; &lt;/b&gt;грамм (процентиль для данного срока: 
								&lt;b&gt;
									&lt;a id="6b811b53-3aff-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;)&lt;/p&gt;
							&lt;p&gt;
								&lt;b/&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;"&gt;
							&lt;p&gt; 
								&lt;u&gt;Анатомия&lt;/u&gt;
							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 50%;"&gt;
							&lt;p&gt; &lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: top; width: 49%;"&gt;
							&lt;p style="text-align: left;"&gt; Голова:
								&lt;br/&gt; - кости свода черепа:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="b94941e4-2fff-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
									&lt;br/&gt;
								&lt;/b&gt; - полость прозрачной перегородки:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="624efb71-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
									&lt;br/&gt;
								&lt;/b&gt; - срединные структуры:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="b94941e6-2fff-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
								&lt;br/&gt; - задние рога боковых желудочков:
								&lt;br/&gt;   справа 
								&lt;b&gt;
									&lt;a id="752ea945-3bb4-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt; мм, слева
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="752ea946-3bb4-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt; &lt;/b&gt;мм
								&lt;br/&gt; - мозжечок 
								&lt;b&gt;
									&lt;a id="6aca9623-3b97-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt; &lt;/b&gt;мм
								&lt;br/&gt; (указать процентиль для данного срока -
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="6b811b57-3aff-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;)
								&lt;br/&gt; - большая цистерна
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="752ea947-3bb4-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt; &lt;/b&gt;мм&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: top; width: 50%;"&gt;
							&lt;p&gt; Расположение внутренних органов:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="97522397-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
								&lt;br/&gt; Сердце: 
								&lt;br/&gt; - ось:
								&lt;b&gt;
									&lt;a id="47053e88-319b-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;br/&gt;
								&lt;/b&gt; - позиция:
								&lt;b&gt;
									&lt;a id="47053e8d-319b-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;br/&gt;
								&lt;/b&gt; - размеры:
								&lt;b&gt;
									&lt;a id="47053e92-319b-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;br/&gt;
								&lt;/b&gt; - 4-х камерный срез:
								&lt;b&gt;
									&lt;a id="47053e97-319b-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;br/&gt; - &lt;/b&gt;срез через 3 сосуда и трахею: 
								&lt;b&gt;
									&lt;a id="97522398-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;
								&lt;br/&gt; - левый выносящий тракт (по показаниям):
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="97522399-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
								&lt;br/&gt; - правый выносящий тракт (по показаниям): 
								&lt;span&gt;
									&lt;b&gt;
										&lt;a id="9752239a-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/span&gt;
							&lt;/p&gt;
							&lt;p/&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: top; width: 49%;"&gt;
							&lt;p&gt; Лицо: 
								&lt;br/&gt; - губы: 
								&lt;span&gt;
									&lt;b&gt;
										&lt;a id="97522395-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
									&lt;br/&gt;
								&lt;/span&gt; - профиль:
								&lt;b&gt;
									&lt;a id="47053e7e-319b-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;
								&lt;br/&gt; - глазницы:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="47053e79-319b-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
									&lt;br/&gt;
								&lt;/b&gt; - нос, ноздри: 
								&lt;span&gt;
									&lt;b&gt;
										&lt;a id="97522396-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/span&gt;
							&lt;/p&gt;
							&lt;p/&gt;
							&lt;p&gt;
								&lt;span/&gt;
							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: top; width: 50%;"&gt;
							&lt;p&gt; Брюшная полость: 
								&lt;br/&gt; - желудок:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="9752239c-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
									&lt;br/&gt;
								&lt;/b&gt; - кишечник:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="9752239d-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
									&lt;br/&gt; - &lt;/b&gt;почки:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="9752239b-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
								&lt;br/&gt; - мочевой пузырь: 
								&lt;b&gt;
									&lt;a id="9752239e-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;
								&lt;br/&gt; - область пупочного кольца:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="9752239f-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
							&lt;/p&gt;
							&lt;p&gt;
								&lt;span/&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: top; width: 49%;"&gt;
							&lt;p&gt; Шея:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="975223a0-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
									&lt;br/&gt;
								&lt;/b&gt; Позвоночник: 
								&lt;b&gt;
									&lt;a id="47053e83-319b-11ec-8196-50af73235947" href="about:" style="font-weight: bold;"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;
								&lt;br/&gt; Грудная клетка:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="975223a1-3873-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: top; width: 50%;"&gt;
							&lt;p&gt; Конечности: 
								&lt;br/&gt; - правая и левая рука (включая кисти):
								&lt;b&gt;
									&lt;a id="47053e9c-319b-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;br/&gt;
								&lt;/b&gt; - правая и левая нога (включая стопы):
								&lt;b&gt;
									&lt;a id="47053ea1-319b-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;
							&lt;/p&gt;
							&lt;p&gt;
								&lt;span/&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Врожденные пороки развития плода:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="c9fd14c5-30b3-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
								&lt;span/&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Особенности строения плода: наличие эхо-маркеров ХА:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="624efb72-37da-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
								&lt;span/&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Плацента:
								&lt;br/&gt; - расположение: 
								&lt;span&gt;
									&lt;b&gt;
										&lt;a id="afd515db-3ada-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;    &lt;/b&gt;- структура: 
									&lt;span&gt;
										&lt;b&gt;
											&lt;a id="afd515dc-3ada-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
										&lt;/b&gt;
										&lt;br/&gt; - положение по отношению к внутреннему зеву: 
										&lt;b&gt;
											&lt;a id="afd515dd-3ada-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
										&lt;/b&gt;
										&lt;br/&gt; Кесарево сечение в анамнезе: 
										&lt;span&gt;
											&lt;b&gt;
												&lt;a id="afd515de-3ada-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
											&lt;/b&gt;
											&lt;br/&gt; Если да, перекрывает ли плацента область послеоперационного рубца: 
											&lt;span&gt;
												&lt;b&gt;
													&lt;a id="afd515df-3ada-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
												&lt;/b&gt;
											&lt;/span&gt;
										&lt;/span&gt;
									&lt;/span&gt;
								&lt;/span&gt;
							&lt;/p&gt;
							&lt;p/&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Количество вод: 
								&lt;b&gt;
									&lt;a id="afd515e0-3ada-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;; &lt;/b&gt;  при изменении количества вод: ИАЖ
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="752ea948-3bb4-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;мм, либо МВК 
								&lt;span&gt;
									&lt;b&gt;
										&lt;a id="752ea949-3bb4-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt;
								&lt;/span&gt;мм&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Область придатков, стенки матки:
								&lt;b&gt;
									&lt;a id="c9fd14d1-30b3-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;"&gt;
							&lt;p&gt; Шейка матки (цервикометрия): 
								&lt;b&gt;
									&lt;a id="c9fd14d3-30b3-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt; мм&lt;/p&gt;
						&lt;/td&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 50%;"&gt;
							&lt;p&gt; Количество сосудов пуповины - 
								&lt;b&gt;
									&lt;a id="4cfe9d92-30d2-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;
								&lt;br/&gt; Место прикрепления к плаценте:
								&lt;b&gt;
									&lt;a id="c9fd14d0-30b3-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Визуализация:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="6b811b50-3aff-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Заключение:
								&lt;b&gt;
									&lt;span&gt;
										&lt;a id="c9fd14d9-30b3-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Беременность:
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="6b811b51-3aff-11ec-8197-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt; нед. 
								&lt;span&gt;
									&lt;b&gt;
										&lt;a id="bdd63a75-315f-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/b&gt; дн.&lt;/span&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Рекомендации:
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="bdd63a76-315f-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;  &lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr style="height: 0px;"&gt;
						&lt;td style="word-wrap: break-word; vertical-align: middle; width: 49%;" colspan="2"&gt;
							&lt;p&gt; Ф.И.О. врача ультразвуковой диагностики:
								&lt;b&gt; 
									&lt;span&gt;
										&lt;a id="bdd63a77-315f-11ec-8196-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
									&lt;/span&gt;
								&lt;/b&gt;
							&lt;/p&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
				&lt;/tbody&gt;
			&lt;/table&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

					&lt;tbody&gt;
						&lt;tr&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 140pt;"&gt;Диагноз до операции:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;

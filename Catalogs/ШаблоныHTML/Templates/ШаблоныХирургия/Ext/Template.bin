			<Description>Предоперационный осмотр анестезиолога</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div class="FORMAT" align="center" style="font-size: 15px; "&gt;
			&lt;font size="4"&gt;Предоперационный осмотр анестезиолога&lt;/font&gt;
		&lt;/div&gt;
		&lt;table border="0" style="border-collapse: collapse;"&gt;
			&lt;tbody&gt;
				&lt;tr style="height: 0px;"&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;Врач:&lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="2ade98ad-d52e-11e5-986c-3a893ef5765d" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/td&gt;
					&lt;td style="vertical-align: middle;"&gt;  Дата документа: &lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
				&lt;tr&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;Пациент:&lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="f7bece55-cafa-11e5-9bc7-50af732359f4" href="about:"&gt;[...]&lt;/a&gt; &lt;/td&gt;
					&lt;td style="vertical-align: middle;"&gt;  Дата рождения: &lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="2561c9fe-cc22-11e2-87cb-002618dcef2c" href="about:"&gt;[...]&lt;/a&gt;  (
						&lt;a id="4d22b3c0-03bd-11e3-943d-1c6f653fefc3" href="about:"&gt;[...]&lt;/a&gt;)&lt;/td&gt;
				&lt;/tr&gt;
			&lt;/tbody&gt;
		&lt;/table&gt;
		&lt;p style=" font-size: 15px; "/&gt;
		&lt;font face="Arial"&gt;
			&lt;b&gt;Данные о пациенте:&lt;/b&gt;
		&lt;/font&gt;
		&lt;br/&gt;
		&lt;table width="100%" border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
			&lt;tbody&gt;
				&lt;tr&gt;
					&lt;td style="word-wrap: break-word; vertical-align: middle; width: 76pt;"&gt;
						&lt;p&gt;
							&lt;font face="Arial"&gt;
								&lt;span&gt;Рост (см):&lt;/span&gt;
							&lt;/font&gt;
						&lt;/p&gt;
					&lt;/td&gt;
					&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
						&lt;p&gt;
							&lt;font face="Arial"&gt; 
								&lt;a id="5aa9ac42-2245-11e2-9496-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;;&lt;/font&gt;
						&lt;/p&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
				&lt;tr&gt;
					&lt;td style="word-wrap: break-word; vertical-align: middle; width: 76pt;"&gt;
						&lt;p&gt;
							&lt;font face="Arial"&gt;
								&lt;span&gt;Масса тела:&lt;/span&gt;
							&lt;/font&gt;
						&lt;/p&gt;
					&lt;/td&gt;
					&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
						&lt;p&gt;
							&lt;font face="Arial"&gt; 
								&lt;a id="20d44e3a-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;;&lt;/font&gt;
						&lt;/p&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
				&lt;tr style="height: 0px;"&gt;
					&lt;td style="word-wrap: break-word; vertical-align: middle; width: 76pt;"&gt;
						&lt;p&gt;
							&lt;font face="Arial"&gt;
								&lt;span&gt;Группа крови:&lt;/span&gt;
							&lt;/font&gt;
						&lt;/p&gt;
					&lt;/td&gt;
					&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
						&lt;p&gt;
							&lt;font face="Arial"&gt; 
								&lt;a id="1c8a5745-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;;&lt;/font&gt;
						&lt;/p&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
				&lt;tr style="height: 0px;" data-bit-hidden="true"&gt;
					&lt;td style="word-wrap: break-word; vertical-align: middle; width: 76pt;"&gt;
						&lt;p&gt;
							&lt;font face="Arial"&gt;
								&lt;span&gt;Rh-фактор:&lt;/span&gt;
							&lt;/font&gt;
						&lt;/p&gt;
					&lt;/td&gt;
					&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
						&lt;p&gt; 
							&lt;a id="92b15feb-772b-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/p&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
			&lt;/tbody&gt;
		&lt;/table&gt;
		&lt;div&gt;
			&lt;p&gt;
				&lt;font face="Arial"&gt;Предполагаемая операция: 
					&lt;select id="5e3a08a4-7688-11eb-93b9-50af73235947"&gt;
						&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;плановая&amp;quot;}"&gt;плановая&lt;/option&gt;
						&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;экстренная&amp;quot;}"&gt;экстренная&lt;/option&gt;
					&lt;/select&gt;
				&lt;/font&gt;
				&lt;br/&gt;
				&lt;font face="Arial"&gt;Степень анестезиологического риска по (АСА) класс: &lt;/font&gt;
				&lt;select id="b16a9ded-9112-11eb-93bb-50af73235947"&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,1}"&gt;1&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,2}"&gt;2&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,3}"&gt;3&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,4}"&gt;4&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,5}"&gt;5&lt;/option&gt;
					&lt;option value="{&amp;quot;N&amp;quot;,6}"&gt;6&lt;/option&gt;
				&lt;/select&gt;;
				&lt;span&gt;
					&lt;span&gt;
						&lt;span&gt;
							&lt;br/&gt;
							&lt;font face="Arial"&gt;
								&lt;table width="100%" border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
									&lt;tbody&gt;
										&lt;tr&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 88pt;"&gt;Вид анестезии:&lt;/td&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
												&lt;span&gt;
													&lt;select id="b16a9de3-9112-11eb-93bb-50af73235947"&gt;
														&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Общая&amp;quot;}"&gt;Общая&lt;/option&gt;
														&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Местная&amp;quot;}"&gt;Местная&lt;/option&gt;
													&lt;/select&gt;
												&lt;/span&gt;;&lt;/td&gt;
										&lt;/tr&gt;
										&lt;tr&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 88pt;"&gt;Премедикация:&lt;/td&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
												&lt;a id="ca0ec657-cd01-11e2-bc5e-1c75085ec106" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
										&lt;/tr&gt;
										&lt;tr&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 88pt;"&gt;Заключение:&lt;/td&gt;
											&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
												&lt;span&gt;
													&lt;a id="1194d524-f14c-11e3-9026-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;.&lt;/span&gt;
											&lt;/td&gt;
										&lt;/tr&gt;
									&lt;/tbody&gt;
								&lt;/table&gt;
							&lt;/font&gt;
						&lt;/span&gt;
					&lt;/span&gt;
				&lt;/span&gt;
			&lt;/p&gt;
		&lt;/div&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

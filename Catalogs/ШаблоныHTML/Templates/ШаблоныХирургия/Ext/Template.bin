			<Code>000000173</Code>
			<Description>Предоперационны эпикриз</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div class="FORMAT" align="center"&gt;
			&lt;font size="4"&gt;
				&lt;b&gt;Предоперационный эпикриз&lt;/b&gt;
			&lt;/font&gt;
		&lt;/div&gt;
		&lt;table border="0" style="border-collapse: collapse;"&gt;
			&lt;tbody&gt;
				&lt;tr style="height: 0px;"&gt;
					&lt;td style="vertical-align: middle;"&gt;Врач:&lt;/td&gt;
					&lt;td style="vertical-align: middle;"&gt;
						&lt;a id="2ade98ad-d52e-11e5-986c-3a893ef5765d" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/td&gt;
					&lt;td style="vertical-align: middle;"&gt;  Дата документа: &lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
				&lt;tr style="height: 0px;"&gt;
					&lt;td style="vertical-align: middle;"&gt;Пациент:&lt;/td&gt;
					&lt;td style="vertical-align: middle;"&gt;
						&lt;a id="f7bece55-cafa-11e5-9bc7-50af732359f4" href="about:"&gt;[...]&lt;/a&gt; &lt;/td&gt;
					&lt;td style="vertical-align: middle;"&gt;  Дата рождения: &lt;/td&gt;
					&lt;td style="vertical-align: middle; width: 0px;"&gt;
						&lt;a id="2561c9fe-cc22-11e2-87cb-002618dcef2c" href="about:"&gt;[...]&lt;/a&gt;  (
						&lt;a id="4d22b3c0-03bd-11e3-943d-1c6f653fefc3" href="about:"&gt;[...]&lt;/a&gt;)&lt;/td&gt;
				&lt;/tr&gt;
			&lt;/tbody&gt;
		&lt;/table&gt;
		&lt;p&gt;Поступил(а) в 
			&lt;a id="e53fd159-bad8-11e7-9bf5-fa1f296fa3e4" href="about:" style="background-color: transparent;"&gt;[...]&lt;/a&gt; отделение; 
			&lt;br/&gt;Дата поступления: 
			&lt;a id="92b15fd9-772b-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/p&gt;
		&lt;p&gt;
			&lt;b&gt;Проведено полное клинико-лабораторное обследование в объеме предоперационной подготовки:&lt;/b&gt;
			&lt;br/&gt;
			&lt;span&gt;
				&lt;table width="45%" border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
					&lt;tbody&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 64pt;"&gt;Группа крови:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 40pt;"&gt; 
								&lt;a id="1c8a5745-a8b1-11e2-93e2-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 1%;"&gt;Rh:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 32pt;"&gt;
								&lt;a id="92b15feb-772b-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;; &lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 10pt;"&gt; &lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 40pt;"&gt; &lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 10pt;"&gt; &lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 28pt;"&gt; &lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 1%;"&gt; &lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 40pt;"&gt; &lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 64pt;"&gt;Hb:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 40pt;"&gt; 
								&lt;a id="92b15fec-772b-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt; г/л;&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 1%;"&gt;Эр:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 32pt;"&gt;
								&lt;a id="92b15fed-772b-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 10pt;"&gt;Ht:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 40pt;"&gt;
								&lt;a id="92b15fee-772b-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt; %;&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 10pt;"&gt;Тр:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 28pt;"&gt;
								&lt;a id="92b15fef-772b-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 1%;"&gt;СВ:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 40pt;"&gt;
								&lt;a id="92b15ff0-772b-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/tbody&gt;
				&lt;/table&gt;
			&lt;/span&gt;
		&lt;/p&gt;
		&lt;b&gt;Общее состояние: &lt;/b&gt;
		&lt;span style="font-family: Arial;"&gt; 
			&lt;a id="862cd470-3578-11e2-87b9-002618dcef2c" href="about:"&gt;[...]&lt;/a&gt;;&lt;/span&gt;
		&lt;br/&gt;
		&lt;table border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
			&lt;tbody/&gt;
		&lt;/table&gt;
		&lt;p&gt;
			&lt;span/&gt;
			&lt;span&gt;
				&lt;b&gt;Анамнез:&lt;/b&gt;
				&lt;br/&gt;
				&lt;table border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse; width: 100%;"&gt;
					&lt;tbody&gt;
						&lt;tr style="height: 0px;" data-bit-hidden="true"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 165pt;"&gt;Гемотрансфузионный анамнез:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;a id="35f6f513-6270-11e4-8f38-d43d7e553e20" href="about:"&gt;[...]&lt;/a&gt;;
								&lt;br/&gt;
							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;" data-bit-hidden="true"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 165pt;"&gt;Аллергологический анамнез:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;a id="20d44e3e-0794-11e2-824b-00242cd5bb52" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/tbody&gt;
				&lt;/table&gt;
			&lt;/span&gt;
		&lt;/p&gt;
		&lt;p&gt;
			&lt;span&gt;
				&lt;tt id="90eb9681-75b7-4170-bec8-542c0d001a04"&gt;&amp;lt;Блок HTML: Диагноз&amp;gt;&lt;/tt&gt;
			&lt;/span&gt;
			&lt;br/&gt;Учитывая анамнез, вышеуказанный диагноз показано оперативное вмешательство в объеме: 
			&lt;a id="5e3a08ae-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
			&lt;br/&gt;
			&lt;span&gt;
				&lt;table border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse; width: 100%;"&gt;
					&lt;tbody&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 132pt;"&gt;Вид анестезии:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0px;"&gt;
								&lt;span&gt;
									&lt;select id="b16a9de3-9112-11eb-93bb-50af73235947"&gt;
										&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Общая&amp;quot;}"&gt;Общая&lt;/option&gt;
										&lt;option value="{&amp;quot;S&amp;quot;,&amp;quot;Местная&amp;quot;}"&gt;Местная&lt;/option&gt;
									&lt;/select&gt;
								&lt;/span&gt;;&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 132pt;"&gt;Показания к операции:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0px;"&gt;
								&lt;a id="5e3a08af-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 132pt;"&gt;Условия к операции:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0px;"&gt;
								&lt;a id="5e3a08b0-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 132pt;"&gt;Возможные осложнения:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0px;"&gt;
								&lt;a id="b011ed36-f184-11e5-87d5-201a06d0f905" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/tbody&gt;
				&lt;/table&gt;
			&lt;/span&gt;
		&lt;/p&gt;
		&lt;p&gt;
			&lt;b&gt;Операционная бригада:
				&lt;br/&gt;
			&lt;/b&gt;
			&lt;span&gt;
				&lt;table border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse; width: 100%;"&gt;
					&lt;tbody&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 70pt;"&gt;Врач-хирург:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;a id="5e3a08a6-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;" data-bit-hidden="true"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 70pt;"&gt;Ассистент:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;a id="5e3a08b1-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/tbody&gt;
				&lt;/table&gt;
			&lt;/span&gt;
			&lt;span&gt;
				&lt;table border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse; width: 100%;"&gt;
					&lt;tbody&gt;
						&lt;tr style="height: 0px;" data-bit-hidden="true"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 190pt;"&gt;Операционная медицинская сестра:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;a id="5e3a08a8-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 190pt;"&gt;Врач-анестезиолог-реаниматолог:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;a id="5e3a08a7-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;" data-bit-hidden="true"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 190pt;"&gt;Медицинская сестра-анестезист:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;a id="5e3a08b2-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;" data-bit-hidden="true"&gt;
							&lt;td style="word-wrap: break-word; vertical-align: top; width: 190pt;"&gt;Врач-трансфузиолог:&lt;/td&gt;
							&lt;td style="word-wrap: break-word; vertical-align: middle; width: 0pt;"&gt;
								&lt;a id="5e3a08b3-7688-11eb-93b9-50af73235947" href="about:"&gt;[...]&lt;/a&gt;;&lt;/td&gt;
						&lt;/tr&gt;
					&lt;/tbody&gt;
				&lt;/table&gt;
			&lt;/span&gt;
			&lt;br/&gt;Дата осмотра: 
			&lt;a id="8beddfdf-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;
		&lt;/p&gt;
	&lt;/body&gt;
&lt;/html&gt;</ТекстHTML>

				&lt;table border="0" style="border-color: inherit; border-style: solid; border-collapse: collapse;"&gt;
					&lt;tbody&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="text-align: right; word-wrap: break-word; width: 190px;"&gt; 
								&lt;span style="font-family: 'Arial Narrow';"&gt;Для постоянного ношения:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; width: 20px;"&gt;
								&lt;input type="checkbox" id="88d8a3ec-6a74-11ea-939c-50af73235947" value="False"/&gt;
							&lt;/td&gt;
							&lt;td style="text-align: right; word-wrap: break-word; width: 81px;"&gt; 
								&lt;span style="font-family: 'Arial Narrow';"&gt;Для дали:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; width: 20px;"&gt;

			<Description>Диагностическое обследование ОКЛ</Description>
			<ТекстHTML>&lt;!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN"&gt;
&lt;html&gt;
	&lt;body&gt;
		&lt;div style="text-align: center; "&gt;
			&lt;b&gt;
				&lt;font size="4" face="Arial Narrow"&gt;Диагностическое обследование ОКЛ&lt;/font&gt;
			&lt;/b&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;font face="Arial Narrow"&gt;
				&lt;strong&gt;- Жалобы: &lt;/strong&gt;
				&lt;a id="386e7d8f-69c5-11ea-939c-50af73235947" href="about:"&gt;[...]&lt;/a&gt;
			&lt;/font&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;font face="Arial Narrow"&gt;
				&lt;a id="8beddfe0-d17f-11e1-b361-1803736d59cd" href="about:"&gt;[...]&lt;/a&gt;

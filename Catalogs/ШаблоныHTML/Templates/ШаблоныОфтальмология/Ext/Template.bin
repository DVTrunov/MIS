							&lt;/td&gt;
						&lt;/tr&gt;
						&lt;tr style="height: 0px;"&gt;
							&lt;td style="text-align: right; word-wrap: break-word; width: 190px;"&gt; 
								&lt;span style="font-family: 'Arial Narrow';"&gt;Для помещения:&lt;/span&gt;
							&lt;/td&gt;
							&lt;td style="word-wrap: break-word; width: 20px;"&gt;
								&lt;input type="checkbox" id="ba2061b1-6a7b-11ea-939c-50af73235947" value="False"/&gt;
							&lt;/td&gt;

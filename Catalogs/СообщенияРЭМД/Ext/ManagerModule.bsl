Процедура ЗаписатьИдентификаторСообщенияВерсии(СообщениеРЭМД, ИдентификаторСообщения) Экспорт
	
	Если СообщениеРЭМД.Версии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	СообщениеОбъект = СообщениеРЭМД.ПолучитьОбъект();
	Для Каждого ТекущаяСтрокаВерсии Из СообщениеОбъект.Версии.НайтиСтроки(Новый Структура("ИдентификаторДокумента", СообщениеРЭМД.ИдентификаторДокумента)) Цикл
		Если Не ЗначениеЗаполнено(ТекущаяСтрокаВерсии.ИдентификаторСообщения) Тогда
			СтрокаВерсии = ТекущаяСтрокаВерсии;
		Иначе
			СтрокаВерсии = СообщениеОбъект.Версии.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВерсии, ТекущаяСтрокаВерсии);
		КонецЕсли;
		СтрокаВерсии.ИдентификаторСообщения = ИдентификаторСообщения;
		СтрокаВерсии.ДатаОтправки = ТекущаяДатаСеанса();
	КонецЦикла;
	СообщениеОбъект.ВПроцессеРегистрации = Истина;
	СообщениеОбъект.Записать();
	
КонецПроцедуры


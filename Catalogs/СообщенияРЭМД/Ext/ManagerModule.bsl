#Область ПрограммныйИнтерфейс

Процедура СформироватьНовоеСообщениеПоЭЦПФайла(Документ, ДанныеФайла, ДанныеЭЦПФайла, СпециальностиПоЭМД) Экспорт
	
	Если ДанныеФайла = Неопределено Тогда
		Сообщить("Не заполнены ДанныеФайла - формирование сообщения РЭМД невозможно!");
		Возврат;
	КонецЕсли;
	
	// Получим все подписи документа
	ПодписиВыборка = доп_СертификатыЭЦП.ПолучитьЭлектронныеПодписи(Документ.Ссылка);
	ИдентификаторДокумента = Строка(Новый УникальныйИдентификатор);
	
	Подписи = Новый Массив();
	инд = 1;
	Пока ПодписиВыборка.Следующий() Цикл
		
		СтруктураПодписи = ПолучитьДанныеЭлектронныхПодписейИзРезультатаПодписания(Документ, ПодписиВыборка);
		// Будем использовать только данные тех подписей, которые есть во входящем массиве ДанныеЭЦПФайла.
		Для Каждого ПодписьФайла Из ДанныеЭЦПФайла Цикл
			Если ПодписьФайла.УИД_ЭЦП = ПодписиВыборка.УникальныйИдентификатор Тогда
				
				ДвоичныеДанныеПодписи = ПодписиВыборка.Подпись.Получить();
				
				ИмяФайлаПодписи = ИдентификаторДокумента + "_sign" + инд;
				ПутиДляПодписи = ПолучитьНовыйПутьКФайлуВХранилище(ИмяФайлаПодписи, Документ.Филиал);
				ДвоичныеДанныеПодписи.Записать(ПутиДляПодписи.ПолныйПуть);
				
				ДанныеПодписи = Новый Структура;
				ДанныеПодписи.Вставить("ОтносительныйПутьКФайлуПодписиЭМД",	ПутиДляПодписи.ОтносительныйПуть);
				ДанныеПодписи.Вставить("РольРЭМД",							ПодписьФайла.РольСотрудника);
				ДанныеПодписи.Вставить("Сотрудник",							СтруктураПодписи.Сотрудник);
				ДанныеПодписи.Вставить("ЭтоПодписьМО",						СтруктураПодписи.ЭтоПодписьМО);
				ДанныеПодписи.Вставить("УИД_ЭЦП",							ПодписьФайла.УИД_ЭЦП);
				ДанныеПодписи.Вставить("ДолжностьМинздрава",				ПодписьФайла.ДолжностьМинздрава);
				ДанныеПодписи.Вставить("СпециальностьМинздрава",			СпециальностиПоЭМД.Получить(ПодписьФайла.УИД_ЭЦП));
				
				Подписи.Добавить(ДанныеПодписи);
				
				инд = инд + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ДанныеСообщения = Новый Структура;
	ДанныеСообщения.Вставить("Документ",				Документ);
	ДанныеСообщения.Вставить("ПутьКФайлуЭМД",			ДанныеФайла.ИмяФайла);
	ДанныеСообщения.Вставить("Клиент",					Документ.Клиент);
	ДанныеСообщения.Вставить("ИдентификаторДокумента",	ИдентификаторДокумента);
	ДанныеСообщения.Вставить("НомерДокумента",			Строка(Документ.УникальныйИдентификатор()));
	ДанныеСообщения.Вставить("ВидДокумента",			ДанныеФайла.ВидДокументаШаблона);
	ДанныеСообщения.Вставить("НомерВерсии",				Документ);
	
	// Когда требуется перезаписать существующее сообщение, то ссылка на него приходит в структуре ДанныеФайла
	Если ДанныеФайла.Свойство("СообщениеРЭМД") Тогда
		ДанныеСообщения.Вставить("СообщениеРЭМД", ДанныеФайла.СообщениеРЭМД);
	КонецЕсли;
	Если ДанныеФайла.Свойство("УИД_Шаблона") Тогда
		ДанныеСообщения.Вставить("УИД_Шаблона", ДанныеФайла.УИД_Шаблона);
	КонецЕсли;
	
	Если Документ.Тестовый Тогда
		СообщениеРЭМДСсылка = Справочники.СообщенияРЭМД.ПустаяСсылка();
	Иначе
		СообщениеРЭМДСсылка = ДобавитьСообщениеВСправочник(ДанныеСообщения, Подписи);
	КонецЕсли;
	
	ДанныеФайла.Вставить("СообщениеРЭМД", СообщениеРЭМДСсылка);
	
КонецПроцедуры

Процедура СформироватьНовоеСообщениеПоМедицинскомуДокументу(Документ) Экспорт
	
	ИдентификаторДокумента = Строка(Новый УникальныйИдентификатор);
	
	Подписи = Новый Массив;
	
	ДокументОбъект = Документ.ПолучитьОбъект();
	
	Для Каждого СтрокаПодписи Из ДокументОбъект.РолиИПодписиЭМД Цикл
		СтруктураПодписи = СтрокаПодписи.ФайлПодписи.Получить();
		ДвоичныеДанныеПодписи = СтруктураПодписи.ДвоичныеДанные;
		
		ИмяФайлаПодписи = ИдентификаторДокумента + "_sign" + СтрокаПодписи.НомерСтроки;
		ПутиДляПодписи = ПолучитьНовыйПутьКФайлуВХранилище(ИмяФайлаПодписи, Документ.Филиал);
		ДвоичныеДанныеПодписи.Записать(ПутиДляПодписи.ПолныйПуть);
		
		ДанныеПодписи = Новый Структура;
		ДанныеПодписи.Вставить("ОтносительныйПутьКФайлуПодписиЭМД",	ПутиДляПодписи.ОтносительныйПуть);
		ДанныеПодписи.Вставить("РольРЭМД",							СтрокаПодписи.РольСотрудника);
		ДанныеПодписи.Вставить("Сотрудник",							СтрокаПодписи.Сотрудник);
		ДанныеПодписи.Вставить("ЭтоПодписьМО",						СтрокаПодписи.ПодписьМО);
		ДанныеПодписи.Вставить("УИД_ЭЦП",							СтрокаПодписи.УИД_ЭЦП);
		ДанныеПодписи.Вставить("ДолжностьМинздрава",				СтрокаПодписи.ДолжностьМинздрава);
		ДанныеПодписи.Вставить("СпециальностьМинздрава",			СтрокаПодписи.СпециальностьМинздрава);
		
		Подписи.Добавить(ДанныеПодписи);
		
		// Перемещаем файл подписи из базы в каталог
		СтрокаПодписи.ФайлПодписи = Неопределено;
		СтрокаПодписи.ПутьКФайлуВАрхиве = ПутиДляПодписи.ОтносительныйПуть;
	КонецЦикла;
	
	СтрокаЭМД = ДокументОбъект.ЭМД[0];
	СтруктураЭМД = СтрокаЭМД.ФайлЭМД.Получить();
	ДвоичныеДанныеЭМД = СтруктураЭМД.ДвоичныеДанные;
	
	ПутьКАрхивуРЭМД = ИнтеграцияЕГИСЗСерверПовтИсп.ПолучитьПутьКАрхивуРЭМД(Документ.Филиал);
	ИмяФайлаБезРасширения = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПутьКАрхивуРЭМД) + Строка(Новый УникальныйИдентификатор);
	
	МассивСтрок = СтрокаЭМД.ВидДокументаЭМД.Атрибуты.НайтиСтроки(Новый Структура("Ключ", "FORMAT"));
	// Конечный формат файла либо *.xml, либо *.PDF/A - в зависимости от описания выбранного вида ЭМД.
	Если МассивСтрок.Количество() > 0 И МассивСтрок[0].Значение = "2" Тогда
		ИмяФайлаЭМД = ИмяФайлаБезРасширения + ".xml";
	Иначе
		ИмяФайлаЭМД = ИмяФайлаБезРасширения + ".pdf";
	КонецЕсли;
	
	ДвоичныеДанныеЭМД.Записать(ИмяФайлаЭМД);
	ОтносительныйПутьФайлаВАрхиве = ПолучитьОтносительныйПутьФайлаВАрхиве(ИмяФайлаЭМД);
	
	// Перемещаем файл ЭМД из базы в каталог
	СтрокаЭМД.ФайлЭМД = Неопределено;
	СтрокаЭМД.ПутьКФайлуВАрхиве = ОтносительныйПутьФайлаВАрхиве;
	
	ДанныеСообщения = Новый Структура;
	ДанныеСообщения.Вставить("Документ",				Документ);
	ДанныеСообщения.Вставить("ПутьКФайлуЭМД",			ОтносительныйПутьФайлаВАрхиве);
	ДанныеСообщения.Вставить("Клиент",					Документ.Клиент);
	ДанныеСообщения.Вставить("ИдентификаторДокумента",	ИдентификаторДокумента);
	ДанныеСообщения.Вставить("НомерДокумента",			Строка(Документ.УникальныйИдентификатор()));
	ДанныеСообщения.Вставить("ВидДокумента",			СтрокаЭМД.ВидДокументаЭМД);
	ДанныеСообщения.Вставить("СообщениеРЭМД",			СтрокаЭМД.СообщениеРЭМД);
	ДанныеСообщения.Вставить("УИД_Шаблона",				СтрокаЭМД.УИД_Шаблона);
	
	СообщениеРЭМДСсылка = ДобавитьСообщениеВСправочник(ДанныеСообщения, Подписи);
	
	Если ЗначениеЗаполнено(СообщениеРЭМДСсылка) Тогда
		СтрокаЭМД.СообщениеРЭМД = СообщениеРЭМДСсылка;
		ДокументОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьФайлыЭМДПоМД(Документ, СотрудникУстановившийПодпись, ДолжностиМЗ, ТекстыОшибок) Экспорт
	
	ФайлыЭМД = Новый Массив;
	
	ПутьКАрхивуРЭМД = ИнтеграцияЕГИСЗСерверПовтИсп.ПолучитьПутьКАрхивуРЭМД(Документ.Филиал);
	
	ДополнительныеПараметры = ИнтеграцияЕГИСЗВызовСервера.ДополнительныеПараметрыДляРаботыССЭМД();
	
	ИмяТипаДокумента = ДопСерверныеФункции.ИмяСсылочногоТипа(Документ);
	Если ИмяТипаДокумента = "Документ.Прием" Тогда
		Шаблоны = Документ.ШаблоныПриема.Выгрузить();
		
		ВерсииШаблонов = Новый ТаблицаЗначений;
		ВерсииШаблонов.Колонки.Добавить("ВерсияШаблона");
		ВерсииШаблонов.Колонки.Добавить("ШаблонПриема");
		ДокументыПриемаКлиентСервер.ЗаполнитьТаблицуВерсийШаблонов(ВерсииШаблонов, Документ);
		
		Для Каждого СтрокаШаблона Из Шаблоны Цикл
			
			СтрокаВерсии = ВерсииШаблонов.Найти(СтрокаШаблона.ШаблонПриема, "ШаблонПриема");
			Если СтрокаВерсии <> Неопределено Тогда
				ДополнительныеПараметры.ШаблонОсмотра = СтрокаВерсии.ВерсияШаблона;
			Иначе
				ДополнительныеПараметры.ШаблонОсмотра = СтрокаШаблона.ШаблонПриема;
			КонецЕсли;
			
			ДополнительныеПараметры.УИДШаблона		= СтрокаШаблона.УИД;
			ДополнительныеПараметры.ИндексШаблона	= Шаблоны.Индекс(СтрокаШаблона);
			ДополнительныеПараметры.СтрокаШаблона	= СтрокаШаблона;
			
			ДолжностьМЗ = ДолжностиМЗ.Получить(СтрокаШаблона.УИД);
			СформироватьФайлЭМД(Документ, ПутьКАрхивуРЭМД, СотрудникУстановившийПодпись, ДолжностьМЗ, ТекстыОшибок, ФайлыЭМД, ДополнительныеПараметры);
		КонецЦикла;
	ИначеЕсли ИмяТипаДокумента = "Документ.ПрохождениеМедосмотра" Тогда
		Если ЗначениеЗаполнено(Документ.Номенклатура.ВредныйФакторСправки.ШаблонОсмотраСправки) Тогда
			
			ДополнительныеПараметры.ШаблонОсмотра		 = Документ.Номенклатура.ВредныйФакторСправки.ШаблонОсмотраСправки;
			ДополнительныеПараметры.ВредныйФакторСправки = Документ.Номенклатура.ВредныйФакторСправки;
			
			УИДПриказаВредногоФактора = ИнтеграцияЕГИСЗВызовСервера.ПолучитьУИДПоПриказуВредномуФактору(Документ, Документ.Номенклатура.ВредныйФакторСправки);
			ДолжностьМЗ = ДолжностиМЗ.Получить(УИДПриказаВредногоФактора);
			СформироватьФайлЭМД(Документ, ПутьКАрхивуРЭМД, СотрудникУстановившийПодпись, ДолжностьМЗ, ТекстыОшибок, ФайлыЭМД, ДополнительныеПараметры);
		Иначе
			МодульМедосмотрыСервер = ДопСерверныеФункции.ОбщийМодуль("МедосмотрыСервер");
			ПриказыВредныеФакторы = МодульМедосмотрыСервер.ПриказыВредныеФакторыМедосмотраСВидамиДокументов(Документ);
			
			Для Каждого СтрокаПриказаВредногоФактора Из ПриказыВредныеФакторы Цикл
				ПриказВредныйФактор = СтрокаПриказаВредногоФактора.ПриказВредныйФактор;
				
				ЭтоСтрокаФактора = ДопСерверныеФункции.ИмяСсылочногоТипа(ПриказВредныйФактор) = "Справочник.ПереченьВредныхФакторовИРабот";
				Приказ = ?(ЭтоСтрокаФактора, ПриказВредныйФактор.Приказ, ПриказВредныйФактор);
				
				ШаблонСправки			= Неопределено;
				ВредныйФакторСправки	= Неопределено;
				ПриказВредныйФакторМО	= Неопределено;
				
				Если ЭтоСтрокаФактора
					И МодульМедосмотрыСервер.ЭтоПриказСправки(Приказ)
				Тогда
					ВредныйФакторСправки	= ПриказВредныйФактор;
					ШаблонСправки			= ПриказВредныйФактор.ШаблонОсмотраСправки;
				Иначе
					ПриказВредныйФакторМО	= ПриказВредныйФактор;
				КонецЕсли;
				
				УИДПриказаВредногоФактора = ИнтеграцияЕГИСЗВызовСервера.ПолучитьУИДПоПриказуВредномуФактору(Документ, ПриказВредныйФактор);
				
				ДополнительныеПараметры.УИДШаблона				= УИДПриказаВредногоФактора;
				ДополнительныеПараметры.ШаблонОсмотра			= ШаблонСправки;
				ДополнительныеПараметры.ВредныйФакторСправки	= ВредныйФакторСправки;
				ДополнительныеПараметры.ПриказВредныйФакторМО	= ПриказВредныйФакторМО;
				
				ДолжностьМЗ = ДолжностиМЗ.Получить(УИДПриказаВредногоФактора);
				СформироватьФайлЭМД(Документ, ПутьКАрхивуРЭМД, СотрудникУстановившийПодпись, ДолжностьМЗ, ТекстыОшибок, ФайлыЭМД, ДополнительныеПараметры);
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ИмяТипаДокумента = "Документ.ВрачебнаяКомиссия" Тогда // Версия КОРП
		ДолжностьМЗ = ДолжностиМЗ.Получить(ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
		СформироватьФайлЭМД(Документ, ПутьКАрхивуРЭМД, СотрудникУстановившийПодпись, ДолжностьМЗ, ТекстыОшибок, ФайлыЭМД, ДополнительныеПараметры);
	ИначеЕсли ИмяТипаДокумента = "Документ.Рецепт" Тогда
		ДолжностьМЗ = ДолжностиМЗ.Получить(ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
		СформироватьФайлЭМД(Документ, ПутьКАрхивуРЭМД, СотрудникУстановившийПодпись, ДолжностьМЗ, ТекстыОшибок, ФайлыЭМД, ДополнительныеПараметры);
	КонецЕсли;
	
	Возврат ФайлыЭМД;
	
КонецФункции

Функция ПолучитьДанныеЭлектронныхПодписейИзРезультатаПодписания(ДокументСсылка, ДанныеПодписи) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Сотрудник = ОтраслевыеДополнения.СотрудникПользователяПоФилиалу(ДанныеПодписи.УстановившийПодпись, РаботаСДокументамиСервер.ФилиалДокумента(ДокументСсылка));
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		ВызватьИсключение СтрШаблон("У пользователя ""%1"" нет подходящего сотрудника для ЭМД.", ДанныеПодписи.УстановившийПодпись);
	КонецЕсли;
	
	ЭтоПодписьМО = Ложь;
	Для Каждого Сертификат Из ИнтеграцияЕГИСЗСерверПовтИсп.ПолучитьСертификатыМОПользователя() Цикл
		Если Сертификат.Отпечаток = ДанныеПодписи.Отпечаток Тогда
			ЭтоПодписьМО = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("ДвоичныеДанныеПодписи, Сотрудник, ЭтоПодписьМО", ДанныеПодписи.Подпись.Получить(), Сотрудник, ЭтоПодписьМО);
	
КонецФункции

Процедура ЗаписатьТекстОшибки(СообщениеРЭМД, Ошибка) Экспорт
	
	Объект = СообщениеРЭМД.ПолучитьОбъект();
	
	Если ТипЗнч(Ошибка) = Тип("Структура") Тогда
		Текст = "";
		
		Если Ошибка.Свойство("ТекстОшибки")
			И ЗначениеЗаполнено(Ошибка.ТекстОшибки)
		Тогда
			Текст = Ошибка.ТекстОшибки;
		Иначе
			Для Каждого Деталь Из Ошибка.Детали Цикл
				Текст = Текст + ?(Текст <> "", Символы.ПС, "") + стрШаблон("%1 %2", Деталь.Код, Деталь.Сообщение);
			КонецЦикла;
		КонецЕсли;
		
		Если Объект.ТекстПоследнейОшибки <> Текст
			Или Объект.Отправить = Истина
			Или Объект.Обновить = Истина
		Тогда
			Объект.ТекстПоследнейОшибки = Текст;
			Если ИнтеграцияЕГИСЗ_РЭМД.ОшибкаВСпискеНаПереотправку(Текст)
				И Объект.КоличествоПереотправок < 20
			Тогда
				Объект.Отправить = Истина;
				Объект.Обновить = Истина;
				Объект.КоличествоПереотправок = Объект.КоличествоПереотправок + 1;
			Иначе
				Объект.Отправить = Ложь;
				Объект.Обновить = Ложь;
			КонецЕсли;
			Объект.Записать();
		КонецЕсли;
	Иначе
		
		Если Объект.ТекстПоследнейОшибки <> Ошибка
			Или Объект.Отправить = Истина
			Или Объект.Обновить = Истина
		Тогда
			Объект.ТекстПоследнейОшибки = Ошибка;
			Если ИнтеграцияЕГИСЗ_РЭМД.ОшибкаВСпискеНаПереотправку(Текст)
				И Объект.КоличествоПереотправок < 20
			Тогда
				Объект.Отправить = Истина;
				Объект.Обновить = Истина;
				Объект.КоличествоПереотправок = Объект.КоличествоПереотправок + 1;
			Иначе
				Объект.Отправить = Ложь;
				Объект.Обновить = Ложь;
			КонецЕсли;
			Объект.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеДокументаПоEmdrId(emdrId) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СообщенияРЭМД.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СообщенияРЭМД КАК СообщенияРЭМД
		|ГДЕ
		|	СообщенияРЭМД.ИдентификаторРЭМД = &ИдентификаторРЭМД
		|
		|УПОРЯДОЧИТЬ ПО
		|	СообщенияРЭМД.ПометкаУдаления";
	
	ИдентификаторИНомерВерсии = СтрРазделить(emdrId, "/");
	Если ИдентификаторИНомерВерсии.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ИдентификаторРЭМД", СокрЛП(ИдентификаторИНомерВерсии[0]));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СообщениеРЭМД = Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИдентификаторИНомерВерсии.Количество() > 1 Тогда
		НомерВерсии = Число(СокрЛП(ИдентификаторИНомерВерсии[1]));
	Иначе
		НомерВерсии = 1;
	КонецЕсли;
	
	ДанныеДокумента = Новый Структура("Ссылка, ИдентификаторДокумента, ОтносительныйПутьКФайлуЭМД", СообщениеРЭМД);
	
	СтрокиВерсии = СообщениеРЭМД.Версии.НайтиСтроки(Новый Структура("НомерВерсии", НомерВерсии));
	Если СтрокиВерсии.Количество() > 0 Тогда
		ДанныеДокумента.ОтносительныйПутьКФайлуЭМД = СтрокиВерсии[0].ПутьКФайлуЭМД;
		ДанныеДокумента.ИдентификаторДокумента = СтрокиВерсии[0].ИдентификаторДокумента;
	Иначе
		// Для совместимости со старыми сообщениями РЭМД, созданными до появления ТЧ "Версии"
		ДанныеДокумента.ОтносительныйПутьКФайлуЭМД = СообщениеРЭМД.ПутьКФайлуЭМД;
		ДанныеДокумента.ИдентификаторДокумента = СообщениеРЭМД.ИдентификаторДокумента;
	КонецЕсли;
	
	Возврат ДанныеДокумента;
	
КонецФункции

Процедура ЗаписатьEmdrId(СообщениеРЭМД, ИдентификаторДокумента, ИдентификаторРЭМД, НомерВерсии, ХранитьДо) Экспорт
	
	Попытка
		НомерВерсииЧисло = Число(НомерВерсии);
	Исключение
		НомерВерсииЧисло = 0;
	КонецПопытки;
	
	ОбъектСообщениеРЭМД = СообщениеРЭМД.ПолучитьОбъект();
	ОбъектИзменен = Ложь;
	
	Если НомерВерсииЧисло >= ОбъектСообщениеРЭМД.НомерВерсии
		Или ОбъектСообщениеРЭМД.ИдентификаторРЭМД <> ИдентификаторРЭМД
	Тогда
		ОбъектСообщениеРЭМД.ИдентификаторРЭМД = ИдентификаторРЭМД;
		ОбъектСообщениеРЭМД.НомерВерсии = НомерВерсииЧисло;
		Если ХранитьДо <> Неопределено Тогда
			ОбъектСообщениеРЭМД.ХранитьДо = ХранитьДо;
		КонецЕсли;
		ОбъектИзменен = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаВерсии Из ОбъектСообщениеРЭМД.Версии.НайтиСтроки(Новый Структура("ИдентификаторДокумента", ИдентификаторДокумента)) Цикл
		СтрокаВерсии.НомерВерсии = ?(НомерВерсииЧисло = 0, 1, НомерВерсииЧисло);
		ОбъектИзменен = Истина;
		Прервать;
	КонецЦикла;
	
	Если ОбъектИзменен Тогда
		ОбъектСообщениеРЭМД.Записать();
	КонецЕсли;
	
	ЗавершитьПроцессРегистрации(СообщениеРЭМД);
	
КонецПроцедуры

Функция ПолучитьДанныеДокументаПоИдентификаторуДокумента(ИдентификаторДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СообщенияРЭМД.Ссылка КАК Ссылка,
		|	СообщенияРЭМДВерсии.ПутьКФайлуЭМД КАК ОтносительныйПутьКФайлуЭМД,
		|	СообщенияРЭМДВерсии.ИдентификаторДокумента КАК ИдентификаторДокумента
		|ИЗ
		|	Справочник.СообщенияРЭМД.Версии КАК СообщенияРЭМДВерсии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СообщенияРЭМД КАК СообщенияРЭМД
		|		ПО (СообщенияРЭМД.Ссылка = СообщенияРЭМДВерсии.Ссылка)
		|			И (НЕ СообщенияРЭМД.ПометкаУдаления)
		|			И (СообщенияРЭМДВерсии.ИдентификаторДокумента = &ИдентификаторДокумента)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СообщенияРЭМД.Ссылка,
		|	СообщенияРЭМД.ПутьКФайлуЭМД,
		|	СообщенияРЭМД.ИдентификаторДокумента
		|ИЗ
		|	Справочник.СообщенияРЭМД КАК СообщенияРЭМД
		|ГДЕ
		|	НЕ СообщенияРЭМД.ПометкаУдаления
		|	И СообщенияРЭМД.ИдентификаторДокумента = &ИдентификаторДокумента";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеДокумента = Новый Структура("Ссылка, ОтносительныйПутьКФайлуЭМД, ИдентификаторДокумента");
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, Выборка);
		Возврат ДанныеДокумента;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСообщениеРЭМДПоИдентификаторуОтправленногоСообщения(ИдентификаторОтправленногоСообщения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщенияРЭМДВерсии.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СообщенияРЭМД.Версии КАК СообщенияРЭМДВерсии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СообщенияРЭМД КАК СообщенияРЭМД
		|		ПО (СообщенияРЭМД.Ссылка = СообщенияРЭМДВерсии.Ссылка)
		|			И (СообщенияРЭМДВерсии.ИдентификаторСообщения = &ИдентификаторОтправленногоСообщения)
		|			И (НЕ СообщенияРЭМД.ПометкаУдаления)";
	
	Запрос.УстановитьПараметр("ИдентификаторОтправленногоСообщения", ИдентификаторОтправленногоСообщения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Попытка
		СообщениеРЭМД = Справочники.СообщенияРЭМД.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторОтправленногоСообщения));
		Если СообщениеРЭМД.ПолучитьОбъект() <> Неопределено Тогда
			Возврат СообщениеРЭМД;
		КонецЕсли;
	Исключение КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщенияРЭМД.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СообщенияРЭМД КАК СообщенияРЭМД
		|ГДЕ
		|	СообщенияРЭМД.ИдентификаторДокумента В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИнтеграцияЕГИСЗСообщенияРЭМД.ИдентификаторДокумента КАК ИдентификаторДокумента
		|			ИЗ
		|				РегистрСведений.ИнтеграцияЕГИСЗСообщенияРЭМД КАК ИнтеграцияЕГИСЗСообщенияРЭМД
		|			ГДЕ
		|				ИнтеграцияЕГИСЗСообщенияРЭМД.УИДСообщения = &ИдентификаторОтправленногоСообщения)
		|	И СообщенияРЭМД.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ИдентификаторОтправленногоСообщения", ИдентификаторОтправленногоСообщения);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


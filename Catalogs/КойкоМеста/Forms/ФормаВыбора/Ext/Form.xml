			<UseAlways>
				<Field>Список.Занято</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникКойкоМеста.Ссылка КАК Ссылка,
	СправочникКойкоМеста.ПометкаУдаления КАК ПометкаУдаления,
	СправочникКойкоМеста.Владелец КАК Владелец,
	СправочникКойкоМеста.Код КАК Код,
	СправочникКойкоМеста.Наименование КАК Наименование,
	СправочникКойкоМеста.Предопределенный КАК Предопределенный,
	СправочникКойкоМеста.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА (СостояниеКойкоМеста.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийКойкоМест.Бронь)
				ИЛИ СостояниеКойкоМеста.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийКойкоМест.ЗанятоПациентом))
				И СостояниеКойкоМеста.ДатаОкончания &gt; &amp;Дата
				И СостояниеКойкоМеста.Регистратор &lt;&gt; &amp;Регистратор
				И  СостояниеКойкоМеста.Клиент &lt;&gt; &amp;Клиент
			ТОГДА 0
		КОГДА ДвижениеКоечногоФондаСрезПоследних.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СостоянияКоек.ПустаяСсылка)
			ТОГДА 1
		ИНАЧЕ 2
	КОНЕЦ КАК Занято
ИЗ
	Справочник.КойкоМеста КАК СправочникКойкоМеста
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДвижениеКоечногоФонда.СрезПоследних(&amp;Дата, ) КАК ДвижениеКоечногоФондаСрезПоследних
		ПО СправочникКойкоМеста.Ссылка = ДвижениеКоечногоФондаСрезПоследних.Койка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеКойкоМеста.СрезПоследних(&amp;Дата, ) КАК СостояниеКойкоМеста
		ПО СправочникКойкоМеста.Ссылка = СостояниеКойкоМеста.КойкоМесто</QueryText>
				<MainTable>Catalog.КойкоМеста</MainTable>

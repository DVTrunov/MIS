#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаРаздела Из Разделы Цикл
		Если ПустаяСтрока(СтрокаРаздела.Ключ) Тогда
			СтрокаРаздела.Ключ = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;

	КлючиРазделов = Новый Соответствие;
	Для Каждого СтрокаРаздела Из Разделы Цикл
		КлючиРазделов.Вставить(СтрокаРаздела.Ключ, Истина);
	КонецЦикла;

	Для Каждого СтрокаПоля Из Поля Цикл
		Если ПустаяСтрока(СтрокаПоля.Ключ) Тогда
			СтрокаПоля.Ключ = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		Если КлючиРазделов[СтрокаПоля.КлючРаздела] = Неопределено И Разделы.Количество() > 0 Тогда
			СтрокаПоля.КлючРаздела = Разделы[0].Ключ;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПоля.ТипПоля) Тогда
			СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.Текст;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Для Каждого СтрокаПоля Из Поля Цикл
		Если ПустаяСтрока(СтрокаПоля.Наименование) И СтрокаПоля.ТипПоля <> Перечисления.омг_ТипыПолейПротокола.Пояснение Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Не заполнено название поля в строке %1.'"), СтрокаПоля.НомерСтроки),
				ЭтотОбъект, ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Поля", СтрокаПоля.НомерСтроки, "Наименование"), , Отказ);
		КонецЕсли;
		Если (СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.Выбор
			Или СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.ВыборНесколько)
			И ПустаяСтрока(СтрокаПоля.ВариантыВыбора) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Для поля «%1» не заданы варианты выбора.'"), СтрокаПоля.Наименование),
				ЭтотОбъект, ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Поля", СтрокаПоля.НомерСтроки, "ВариантыВыбора"), , Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

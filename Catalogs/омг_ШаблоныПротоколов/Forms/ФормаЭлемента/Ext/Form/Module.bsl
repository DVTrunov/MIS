// Конструктор шаблона протокола: разделы слева, поля выбранного раздела справа.
// Порядок разделов и полей - порядок строк (кнопки «Переместить вверх/вниз» таблиц).
// Вкладка «Редактор» - свободная вёрстка: текст как в Word, поля и параметры вставляются у курсора
// (макет РедакторШаблонаHTML). Изменения редактора переносятся в шаблон при смене вкладки и при записи.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РаспознаватьБезМеток = Истина;

	Если Объект.Ссылка.Пустая() И Объект.Разделы.Количество() = 0 Тогда
		ИменаРазделов = НСтр("ru = 'Жалобы,Анамнез,Объективный статус,Локальный статус,Диагноз,Лечение на приёме'");
		Для Каждого ИмяРаздела Из СтрРазделить(ИменаРазделов, ",") Цикл
			СтрокаРаздела = Объект.Разделы.Добавить();
			СтрокаРаздела.Ключ = Строка(Новый УникальныйИдентификатор);
			СтрокаРаздела.Наименование = ИмяРаздела;
			СтрокаРаздела.ПечататьЗаголовок = Истина;
		КонецЦикла;
	КонецЕсли;

	УстановитьВидимостьШапки(Элементы, Объект.ЭтоШапка);

	// Оформление: выравнивание выбирается из списка, пустое значение - по левому краю.
	Для Каждого ИмяЭлемента Из СтрРазделить("РазделыВыравнивание,ПоляВыравнивание", ",") Цикл
		ЭлементВыравнивания = Элементы[ИмяЭлемента];
		ЭлементВыравнивания.РежимВыбораИзСписка = Истина;
		ЭлементВыравнивания.СписокВыбора.Добавить("", НСтр("ru = 'Влево'"));
		ЭлементВыравнивания.СписокВыбора.Добавить("Центр", НСтр("ru = 'По центру'"));
		ЭлементВыравнивания.СписокВыбора.Добавить("Право", НСтр("ru = 'Вправо'"));
		ЭлементВыравнивания.СписокВыбора.Добавить("Ширина", НСтр("ru = 'По ширине'"));
	КонецЦикла;
	Для Каждого ИмяШрифта Из СтрРазделить("Arial,Times New Roman,Calibri,Verdana,Tahoma", ",") Цикл
		Элементы.Шрифт.СписокВыбора.Добавить(ИмяШрифта);
	КонецЦикла;
	Если Объект.Ссылка.Пустая() И ПустаяСтрока(Объект.Шрифт) Тогда
		Объект.Шрифт = "Arial";
		Объект.РазмерШрифта = 10;
	КонецЕсли;

	Если Не Объект.ЭтоШапка Тогда
		ОбновитьРедакторНаСервере();
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаРедактор;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьОтборПолей();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	ДанныеРедактора = ДанныеИзРедактора();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	// Хранилища значений не входят в данные формы - переносим загруженные из Word файлы явно.
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ТекущийОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа), Новый СжатиеДанных(9));
	КонецЕсли;
	Если ЭтоАдресВременногоХранилища(АдресИсходногоФайла) Тогда
		ТекущийОбъект.ИсходныйФайл = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресИсходногоФайла), Новый СжатиеДанных(9));
	КонецЕсли;
	Если Не ПустаяСтрока(ДанныеРедактора) Тогда
		омг_ПротоколыПриемаСервер.ПрименитьДанныеРедактора(ТекущийОбъект, ДанныеРедактора);
		ДанныеРедактора = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ОтметитьРедакторЗаписанным();

КонецПроцедуры

// Правки в редакторе (HTML) не меняют данные формы сами по себе - отмечаем их, чтобы не потерять при закрытии.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не ЗавершениеРаботы И Не Модифицированность И РедакторИзменен() Тогда
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

// Выбор параметра для кнопки «+ Параметр» редактора (форма выбора ПараметрыHTML сообщает о выборе оповещением).
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия <> "СобытиеЗакрытияФормыВыбораПараметраHTML" Или Источник <> ЭтотОбъект
		Или ТипЗнч(Параметр) <> Тип("Соответствие") Или Параметр["ИмяКоманды"] <> "ВставитьПараметрРедактора" Тогда
		Возврат;
	КонецЕсли;
	ТекстПоля = ПолеРедактораПоПараметру(Параметр["ВыбранныйЭлемент"]);
	Если Не ПустаяСтрока(ТекстПоля) Тогда
		ВыполнитьВРедакторе("omgEdInsertField", ТекстПоля);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЭтоШапкаПриИзменении(Элемент)

	УстановитьВидимостьШапки(Элементы, Объект.ЭтоШапка);

КонецПроцедуры

// Щелчок в редакторе: кнопки «+ Поле», «+ Параметр» и двойной щелчок по полю оставляют действие,
// которое забирается после обработки щелчка страницей.
&НаКлиенте
Процедура ПолеРедактораПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	ПодключитьОбработчикОжидания("ОбработатьДействиеРедактора", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРазделы

&НаКлиенте
Процедура РазделыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("УстановитьОтборПолей", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура РазделыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекущиеДанные.Ключ = Строка(Новый УникальныйИдентификатор);
		Если Не Копирование Тогда
			ТекущиеДанные.ПечататьЗаголовок = Истина;
		КонецЕсли;
		УстановитьОтборПолей();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РазделыПередУдалением(Элемент, Отказ)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаПоля Из Объект.Поля.НайтиСтроки(Новый Структура("КлючРаздела", ТекущиеДанные.Ключ)) Цикл
		Объект.Поля.Удалить(СтрокаПоля);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоля

&НаКлиенте
Процедура ПоляПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущиеДанные.Ключ = Строка(Новый УникальныйИдентификатор);

	ТекущийРаздел = Элементы.Разделы.ТекущиеДанные;
	Если ТекущийРаздел <> Неопределено Тогда
		ТекущиеДанные.КлючРаздела = ТекущийРаздел.Ключ;
	КонецЕсли;

	Если Не Копирование Тогда
		ТекущиеДанные.ТипПоля = ПредопределенноеЗначение("Перечисление.омг_ТипыПолейПротокола.Текст");
		ТекущиеДанные.СкрыватьЕслиПусто = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзWord(Команда)

	Если Объект.Поля.Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗагрузитьИзWordПослеВопроса", ЭтотОбъект),
			НСтр("ru = 'Разделы и поля шаблона будут заменены содержимым документа Word. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыбратьФайлWord();
	КонецЕсли;

КонецПроцедуры

// Вкладка «Предпросмотр»: протокол так, как его увидит врач в приёме, по текущему (в т.ч. не записанному) шаблону.
// Вернулся на «Структуру», поправил оформление - снова открыл «Предпросмотр».
&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаРедактор Тогда
		ОбновитьРедакторНаСервере();
		Возврат;
	КонецЕсли;
	ПрименитьРедактор();
	Если ТекущаяСтраница = Элементы.СтраницаПредпросмотр Тогда
		ОбновитьПредпросмотрНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПредпросмотрНаСервере()

	ШаблонОбъект = РеквизитФормыВЗначение("Объект");
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ШаблонОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа));
	КонецЕсли;
	ПредпросмотрHTML = омг_ПротоколыПриемаСервер.ТекстHTMLФормыВвода(ШаблонОбъект, Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВWord(Команда)

	ПрименитьРедактор();
	ОписаниеФайла = ФайлWordШаблонаНаСервере();
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, ОписаниеФайла.Адрес, ОписаниеФайла.ИмяФайла);

КонецПроцедуры

&НаКлиенте
Процедура СопоставитьПараметры(Команда)

	ПрименитьРедактор();
	ОткрытьСопоставлениеПараметров();

КонецПроцедуры

// Свободная вёрстка печатается как HTML (средствами браузера), шаблон из разделов - табличным документом.
&НаКлиенте
Процедура ПредпросмотрПечати(Команда)

	ПрименитьРедактор();
	ДанныеПечати = ДанныеПечатиПредпросмотра();
	Если ПустаяСтрока(ДанныеПечати.HTML) Тогда
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", Новый Структура("КоллекцияПечатныхФорм", ДанныеПечати.Коллекция), ЭтотОбъект);
	Иначе
		ОткрытьФорму("Обработка.омг_ПротоколПриема.Форма.ПечатьHTML",
			Новый Структура("ТекстHTML, Заголовок", ДанныеПечати.HTML, ДанныеПечати.Заголовок), ЭтотОбъект, Новый УникальныйИдентификатор);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общая шапка задаётся для филиала; у обычного протокола - специализация и признак отказа от шапки.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьШапки(Элементы, ЭтоШапка)

	Элементы.Филиал.Видимость = ЭтоШапка;
	Элементы.Специализация.Видимость = Не ЭтоШапка;
	Элементы.НеИспользоватьШапку.Видимость = Не ЭтоШапка;
	Элементы.СтраницаРедактор.Видимость = Не ЭтоШапка;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПолей()

	ТекущийРаздел = Элементы.Разделы.ТекущиеДанные;
	Если ТекущийРаздел = Неопределено Тогда
		Элементы.Поля.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючРаздела", "-");
		Элементы.Поля.Заголовок = НСтр("ru = 'Поля'");
	Иначе
		Элементы.Поля.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючРаздела", ТекущийРаздел.Ключ);
		Элементы.Поля.Заголовок = СтрШаблон(НСтр("ru = 'Поля раздела «%1»'"), ТекущийРаздел.Наименование);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзWordПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыбратьФайлWord();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлWord()

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите документ Word'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Документ Word (*.docx)|*.docx'");
	ПараметрыДиалога.МножественныйВыбор = Ложь;

	НачатьПомещениеФайлаНаСервер(Новый ОписаниеОповещения("ВыбратьФайлWordЗавершение", ЭтотОбъект),
		, , , ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлWordЗавершение(ОписаниеФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеФайла = Неопределено Или ОписаниеФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	Предупреждения = ЗагрузитьИзWordНаСервере(ОписаниеФайла.Адрес, ОписаниеФайла.СсылкаНаФайл.Имя);

	Если Объект.Разделы.Количество() > 0 Тогда
		Элементы.Разделы.ТекущаяСтрока = Объект.Разделы[0].ПолучитьИдентификатор();
	КонецЕсли;
	УстановитьОтборПолей();
	ОбновитьРедакторНаСервере();

	// После загрузки - окно сопоставления с параметрами: найденное подставлено, остальное выбирается вручную.
	Если Предупреждения.Количество() > 0 Тогда
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ПослеПредупрежденийЗагрузки", ЭтотОбъект),
			СтрСоединить(Предупреждения, Символы.ПС));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Шаблон загружен из Word'"), ,
			СтрШаблон(НСтр("ru = 'Разделов: %1, полей: %2. Проверьте и запишите шаблон.'"), Объект.Разделы.Количество(), Объект.Поля.Количество()));
		ОткрытьСопоставлениеПараметров();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПредупрежденийЗагрузки(ДополнительныеПараметры) Экспорт

	ОткрытьСопоставлениеПараметров();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСопоставлениеПараметров()

	Поля = ПоляДляСопоставления();
	Если Поля.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В шаблоне нет полей для ввода, сопоставлять нечего.'"));
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Справочник.омг_ШаблоныПротоколов.Форма.ФормаСопоставленияПараметров",
		Новый Структура("Поля", Поля), ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("СопоставлениеПараметровЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеПараметровЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Изменено = Ложь;
	Для Каждого Элемент Из Результат Цикл
		Для Каждого СтрокаПоля Из Объект.Поля.НайтиСтроки(Новый Структура("Ключ", Элемент.Ключ)) Цикл
			Если СтрокаПоля.Параметр <> Элемент.Параметр Тогда
				СтрокаПоля.Параметр = Элемент.Параметр;
				Изменено = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Изменено Тогда
		Модифицированность = Истина;
		ОбновитьРедакторНаСервере();
	КонецЕсли;

КонецПроцедуры

// Поля для ввода (без пояснений и таблиц) с наименованием раздела - для окна сопоставления.
&НаСервере
Функция ПоляДляСопоставления()

	Поля = Новый Массив;
	Для Каждого СтрокаРаздела Из Объект.Разделы Цикл
		Для Каждого СтрокаПоля Из Объект.Поля.НайтиСтроки(Новый Структура("КлючРаздела", СтрокаРаздела.Ключ)) Цикл
			Если СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.Пояснение
				Или СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.Таблица
				Или СтрокаПоля.ТипПоля = Перечисления.омг_ТипыПолейПротокола.Фраза Тогда
				Продолжить;
			КонецЕсли;
			Поля.Добавить(Новый Структура("Ключ, Раздел, Наименование, ТипПоля, Параметр",
				СтрокаПоля.Ключ, СтрокаРаздела.Наименование, СтрокаПоля.Наименование,
				Строка(СтрокаПоля.ТипПоля), СтрокаПоля.Параметр));
		КонецЦикла;
	КонецЦикла;
	Возврат Поля;

КонецФункции

&НаСервере
Функция ЗагрузитьИзWordНаСервере(Адрес, ИмяФайла)

	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
	ШаблонОбъект = РеквизитФормыВЗначение("Объект");

	Предупреждения = омг_ПротоколыПриемаСервер.ЗаполнитьШаблонИзWord(ШаблонОбъект, ДвоичныеДанныеФайла, ИмяФайла, РаспознаватьБезМеток);

	Логотип = ШаблонОбъект.Логотип.Получить();
	Если Логотип <> Неопределено Тогда
		АдресЛоготипа = ПоместитьВоВременноеХранилище(Логотип, УникальныйИдентификатор);
	КонецЕсли;
	АдресИсходногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, УникальныйИдентификатор);

	ЗначениеВРеквизитФормы(ШаблонОбъект, "Объект");
	Модифицированность = Истина;

	Возврат Предупреждения;

КонецФункции

&НаСервере
Функция ФайлWordШаблонаНаСервере()

	ШаблонОбъект = РеквизитФормыВЗначение("Объект");
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ШаблонОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа));
	КонецЕсли;
	ДанныеФайла = омг_ПротоколыПриемаСервер.ФайлWordПротокола(ШаблонОбъект);
	Представление = ?(ПустаяСтрока(Объект.Наименование), НСтр("ru = 'Шаблон протокола'"), Объект.Наименование);
	Возврат Новый Структура("Адрес, ИмяФайла",
		ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор),
		омг_ПротоколыПриемаСервер.ИмяФайлаWord(Представление));

КонецФункции

&НаСервере
Функция ДанныеПечатиПредпросмотра()

	ШаблонОбъект = РеквизитФормыВЗначение("Объект");
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ШаблонОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа));
	КонецЕсли;
	Возврат омг_ПротоколыПриемаСервер.ДанныеПечатиПротокола(ШаблонОбъект);

КонецФункции

#КонецОбласти

#Область ВизуальныйРедактор

&НаСервере
Процедура ОбновитьРедакторНаСервере()

	Если Объект.ЭтоШапка Тогда
		РедакторHTML = "";
		Возврат;
	КонецЕсли;
	РедакторHTML = омг_ПротоколыПриемаСервер.ТекстHTMLРедактора(РеквизитФормыВЗначение("Объект"));

КонецПроцедуры

// Переносит изменения редактора в данные формы (перед сменой вкладки, предпросмотром, выгрузкой).
&НаКлиенте
Процедура ПрименитьРедактор()

	Данные = ДанныеИзРедактора();
	Если ПустаяСтрока(Данные) Тогда
		Возврат;
	КонецЕсли;
	ПрименитьРедакторНаСервере(Данные);
	ОтметитьРедакторЗаписанным();
	Если Объект.Разделы.Количество() > 0 Тогда
		Элементы.Разделы.ТекущаяСтрока = Объект.Разделы[0].ПолучитьИдентификатор();
	КонецЕсли;
	УстановитьОтборПолей();
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ПрименитьРедакторНаСервере(Данные)

	ШаблонОбъект = РеквизитФормыВЗначение("Объект");
	омг_ПротоколыПриемаСервер.ПрименитьДанныеРедактора(ШаблонОбъект, Данные);
	ЗначениеВРеквизитФормы(ШаблонОбъект, "Объект");

КонецПроцедуры

// Окно страницы редактора (WebKit - defaultView, старый движок - parentWindow) или Неопределено, пока страница не загружена.
&НаКлиенте
Функция ОкноРедактора()

	ОкноHTML = Неопределено;
	Попытка
		ДокументHTML = Элементы.ПолеРедактора.Документ;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Попытка
		ОкноHTML = ДокументHTML.defaultView;
	Исключение
		ОкноHTML = Неопределено;
	КонецПопытки;
	Если ОкноHTML = Неопределено Тогда
		Попытка
			ОкноHTML = ДокументHTML.parentWindow;
		Исключение
			ОкноHTML = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат ОкноHTML;

КонецФункции

&НаКлиенте
Функция РедакторИзменен()

	ОкноHTML = ОкноРедактора();
	Если ОкноHTML = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Строка(ОкноHTML.omgEdIsDirty()) = "true";
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// JSON содержимого редактора, если в нём есть не перенесённые в шаблон правки, иначе пустая строка.
&НаКлиенте
Функция ДанныеИзРедактора()

	Если Объект.ЭтоШапка Или Не РедакторИзменен() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(ОкноРедактора().omgEdGetData());

КонецФункции

&НаКлиенте
Процедура ОтметитьРедакторЗаписанным()

	ОкноHTML = ОкноРедактора();
	Если ОкноHTML <> Неопределено Тогда
		Попытка
			ОкноHTML.omgEdSetSaved();
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВыполнитьВРедакторе(ИмяФункции, Аргумент1, Аргумент2 = Неопределено)

	ОкноHTML = ОкноРедактора();
	Если ОкноHTML = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ИмяФункции = "omgEdInsertField" Тогда
		Результат = ОкноHTML.omgEdInsertField(Аргумент1);
	ИначеЕсли ИмяФункции = "omgEdUpdateField" Тогда
		Результат = ОкноHTML.omgEdUpdateField(Аргумент1, Аргумент2);
	Иначе
		Возврат "";
	КонецЕсли;
	Модифицированность = Истина;
	Возврат Строка(Результат);

КонецФункции

&НаКлиенте
Процедура ОбработатьДействиеРедактора()

	Если Не Модифицированность И РедакторИзменен() Тогда
		Модифицированность = Истина;
	КонецЕсли;
	ОкноHTML = ОкноРедактора();
	Если ОкноHTML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ТекстДействия = Строка(ОкноHTML.omgEdTakeAction());
	Исключение
		Возврат;
	КонецПопытки;
	Если ПустаяСтрока(ТекстДействия) Тогда
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстДействия);
	Действие = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Если Действие["act"] = "field" Тогда
		ОткрытьФорму("Справочник.омг_ШаблоныПротоколов.Форма.ФормаПоляРедактора",
			Новый Структура("Поле, Текст", Неопределено, Строка(Действие["text"])), ЭтотОбъект, , , ,
			Новый ОписаниеОповещения("ПолеРедактораЗавершение", ЭтотОбъект, ""),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Действие["act"] = "param" Тогда
		ОткрытьФорму("ПланВидовХарактеристик.ПараметрыHTML.Форма.ФормаВыбора",
			Новый Структура("Команда", "ВставитьПараметрРедактора"), ЭтотОбъект);
	ИначеЕсли Действие["act"] = "edit" И ТипЗнч(Действие["f"]) = Тип("Соответствие") Тогда
		Поле = Новый Структура;
		Для Каждого КлючИЗначение Из Действие["f"] Цикл
			Поле.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		ОткрытьФорму("Справочник.омг_ШаблоныПротоколов.Форма.ФормаПоляРедактора",
			Новый Структура("Поле, Текст", Поле, ""), ЭтотОбъект, , , ,
			Новый ОписаниеОповещения("ПолеРедактораЗавершение", ЭтотОбъект, Строка(Действие["uid"])),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

КонецПроцедуры

// ДополнительныеПараметры - идентификатор изменяемой плашки или пустая строка для нового поля.
&НаКлиенте
Процедура ПолеРедактораЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Результат);
	ТекстПоля = Запись.Закрыть();
	Если ПустаяСтрока(ДополнительныеПараметры) Тогда
		ВыполнитьВРедакторе("omgEdInsertField", ТекстПоля);
	Иначе
		ВыполнитьВРедакторе("omgEdUpdateField", ДополнительныеПараметры, ТекстПоля);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолеРедактораПоПараметру(Параметр)

	Если ТипЗнч(Параметр) <> Тип("ПланВидовХарактеристикСсылка.ПараметрыHTML") Или Не ЗначениеЗаполнено(Параметр)
		Или Параметр.ЭтоГруппа Тогда
		Возврат "";
	КонецЕсли;
	Возврат омг_ПротоколыПриемаСервер.ПолеРедактораПоПараметру(Параметр);

КонецФункции

#КонецОбласти

// Конструктор шаблона протокола: разделы слева, поля выбранного раздела справа.
// Порядок разделов и полей - порядок строк (кнопки «Переместить вверх/вниз» таблиц).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РаспознаватьБезМеток = Истина;

	Если Объект.Ссылка.Пустая() И Объект.Разделы.Количество() = 0 Тогда
		ИменаРазделов = НСтр("ru = 'Жалобы,Анамнез,Объективный статус,Локальный статус,Диагноз,Лечение на приёме'");
		Для Каждого ИмяРаздела Из СтрРазделить(ИменаРазделов, ",") Цикл
			СтрокаРаздела = Объект.Разделы.Добавить();
			СтрокаРаздела.Ключ = Строка(Новый УникальныйИдентификатор);
			СтрокаРаздела.Наименование = ИмяРаздела;
			СтрокаРаздела.ПечататьЗаголовок = Истина;
		КонецЦикла;
	КонецЕсли;

	УстановитьВидимостьШапки(Элементы, Объект.ЭтоШапка);

	// Оформление: выравнивание выбирается из списка, пустое значение - по левому краю.
	Для Каждого ИмяЭлемента Из СтрРазделить("РазделыВыравнивание,ПоляВыравнивание", ",") Цикл
		ЭлементВыравнивания = Элементы[ИмяЭлемента];
		ЭлементВыравнивания.РежимВыбораИзСписка = Истина;
		ЭлементВыравнивания.СписокВыбора.Добавить("", НСтр("ru = 'Влево'"));
		ЭлементВыравнивания.СписокВыбора.Добавить("Центр", НСтр("ru = 'По центру'"));
		ЭлементВыравнивания.СписокВыбора.Добавить("Право", НСтр("ru = 'Вправо'"));
		ЭлементВыравнивания.СписокВыбора.Добавить("Ширина", НСтр("ru = 'По ширине'"));
	КонецЦикла;
	Для Каждого ИмяШрифта Из СтрРазделить("Arial,Times New Roman,Calibri,Verdana,Tahoma", ",") Цикл
		Элементы.Шрифт.СписокВыбора.Добавить(ИмяШрифта);
	КонецЦикла;
	Если Объект.Ссылка.Пустая() И ПустаяСтрока(Объект.Шрифт) Тогда
		Объект.Шрифт = "Arial";
		Объект.РазмерШрифта = 10;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьОтборПолей();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	// Хранилища значений не входят в данные формы - переносим загруженные из Word файлы явно.
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ТекущийОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа), Новый СжатиеДанных(9));
	КонецЕсли;
	Если ЭтоАдресВременногоХранилища(АдресИсходногоФайла) Тогда
		ТекущийОбъект.ИсходныйФайл = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресИсходногоФайла), Новый СжатиеДанных(9));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЭтоШапкаПриИзменении(Элемент)

	УстановитьВидимостьШапки(Элементы, Объект.ЭтоШапка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРазделы

&НаКлиенте
Процедура РазделыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("УстановитьОтборПолей", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура РазделыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекущиеДанные.Ключ = Строка(Новый УникальныйИдентификатор);
		Если Не Копирование Тогда
			ТекущиеДанные.ПечататьЗаголовок = Истина;
		КонецЕсли;
		УстановитьОтборПолей();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РазделыПередУдалением(Элемент, Отказ)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаПоля Из Объект.Поля.НайтиСтроки(Новый Структура("КлючРаздела", ТекущиеДанные.Ключ)) Цикл
		Объект.Поля.Удалить(СтрокаПоля);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоля

&НаКлиенте
Процедура ПоляПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущиеДанные.Ключ = Строка(Новый УникальныйИдентификатор);

	ТекущийРаздел = Элементы.Разделы.ТекущиеДанные;
	Если ТекущийРаздел <> Неопределено Тогда
		ТекущиеДанные.КлючРаздела = ТекущийРаздел.Ключ;
	КонецЕсли;

	Если Не Копирование Тогда
		ТекущиеДанные.ТипПоля = ПредопределенноеЗначение("Перечисление.омг_ТипыПолейПротокола.Текст");
		ТекущиеДанные.СкрыватьЕслиПусто = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзWord(Команда)

	Если Объект.Поля.Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗагрузитьИзWordПослеВопроса", ЭтотОбъект),
			НСтр("ru = 'Разделы и поля шаблона будут заменены содержимым документа Word. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыбратьФайлWord();
	КонецЕсли;

КонецПроцедуры

// Вкладка «Предпросмотр»: протокол так, как его увидит врач в приёме, по текущему (в т.ч. не записанному) шаблону.
// Вернулся на «Структуру», поправил оформление - снова открыл «Предпросмотр».
&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаПредпросмотр Тогда
		ОбновитьПредпросмотрНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПредпросмотрНаСервере()

	ШаблонОбъект = РеквизитФормыВЗначение("Объект");
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ШаблонОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа));
	КонецЕсли;
	ПредпросмотрHTML = омг_ПротоколыПриемаСервер.ТекстHTMLФормыВвода(ШаблонОбъект, Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВWord(Команда)

	ОписаниеФайла = ФайлWordШаблонаНаСервере();
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, ОписаниеФайла.Адрес, ОписаниеФайла.ИмяФайла);

КонецПроцедуры

&НаКлиенте
Процедура ПредпросмотрПечати(Команда)

	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", Новый Структура("КоллекцияПечатныхФорм", КоллекцияПечатныхФормПредпросмотра()), ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общая шапка задаётся для филиала; у обычного протокола - специализация и признак отказа от шапки.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьШапки(Элементы, ЭтоШапка)

	Элементы.Филиал.Видимость = ЭтоШапка;
	Элементы.Специализация.Видимость = Не ЭтоШапка;
	Элементы.НеИспользоватьШапку.Видимость = Не ЭтоШапка;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПолей()

	ТекущийРаздел = Элементы.Разделы.ТекущиеДанные;
	Если ТекущийРаздел = Неопределено Тогда
		Элементы.Поля.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючРаздела", "-");
		Элементы.Поля.Заголовок = НСтр("ru = 'Поля'");
	Иначе
		Элементы.Поля.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючРаздела", ТекущийРаздел.Ключ);
		Элементы.Поля.Заголовок = СтрШаблон(НСтр("ru = 'Поля раздела «%1»'"), ТекущийРаздел.Наименование);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзWordПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыбратьФайлWord();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлWord()

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите документ Word'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Документ Word (*.docx)|*.docx'");
	ПараметрыДиалога.МножественныйВыбор = Ложь;

	НачатьПомещениеФайлаНаСервер(Новый ОписаниеОповещения("ВыбратьФайлWordЗавершение", ЭтотОбъект),
		, , , ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлWordЗавершение(ОписаниеФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеФайла = Неопределено Или ОписаниеФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	Предупреждения = ЗагрузитьИзWordНаСервере(ОписаниеФайла.Адрес, ОписаниеФайла.СсылкаНаФайл.Имя);

	Если Объект.Разделы.Количество() > 0 Тогда
		Элементы.Разделы.ТекущаяСтрока = Объект.Разделы[0].ПолучитьИдентификатор();
	КонецЕсли;
	УстановитьОтборПолей();

	Если Предупреждения.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Предупреждения, Символы.ПС));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Шаблон загружен из Word'"), ,
			СтрШаблон(НСтр("ru = 'Разделов: %1, полей: %2. Проверьте и запишите шаблон.'"), Объект.Разделы.Количество(), Объект.Поля.Количество()));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьИзWordНаСервере(Адрес, ИмяФайла)

	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
	ШаблонОбъект = РеквизитФормыВЗначение("Объект");

	Предупреждения = омг_ПротоколыПриемаСервер.ЗаполнитьШаблонИзWord(ШаблонОбъект, ДвоичныеДанныеФайла, ИмяФайла, РаспознаватьБезМеток);

	Логотип = ШаблонОбъект.Логотип.Получить();
	Если Логотип <> Неопределено Тогда
		АдресЛоготипа = ПоместитьВоВременноеХранилище(Логотип, УникальныйИдентификатор);
	КонецЕсли;
	АдресИсходногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, УникальныйИдентификатор);

	ЗначениеВРеквизитФормы(ШаблонОбъект, "Объект");
	Модифицированность = Истина;

	Возврат Предупреждения;

КонецФункции

&НаСервере
Функция ФайлWordШаблонаНаСервере()

	ШаблонОбъект = РеквизитФормыВЗначение("Объект");
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ШаблонОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа));
	КонецЕсли;
	ДанныеФайла = омг_ПротоколыПриемаСервер.ФайлWordПротокола(ШаблонОбъект);
	Представление = ?(ПустаяСтрока(Объект.Наименование), НСтр("ru = 'Шаблон протокола'"), Объект.Наименование);
	Возврат Новый Структура("Адрес, ИмяФайла",
		ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор),
		омг_ПротоколыПриемаСервер.ИмяФайлаWord(Представление));

КонецФункции

&НаСервере
Функция КоллекцияПечатныхФормПредпросмотра()

	ШаблонОбъект = РеквизитФормыВЗначение("Объект");
	Если ЭтоАдресВременногоХранилища(АдресЛоготипа) Тогда
		ШаблонОбъект.Логотип = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресЛоготипа));
	КонецЕсли;
	Возврат омг_ПротоколыПриемаСервер.КоллекцияПечатныхФормПротокола(ШаблонОбъект);

КонецФункции

#КонецОбласти

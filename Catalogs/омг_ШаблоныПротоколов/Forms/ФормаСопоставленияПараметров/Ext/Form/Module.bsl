// Окно сопоставления полей шаблона протокола с параметрами старого механизма (ПараметрыHTML).
// Параметр формы Поля - Массив из Структура (Ключ, Раздел, Наименование, ТипПоля, Параметр).
// Результат закрытия - Массив из Структура (Ключ, Параметр) или Неопределено при отмене.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Поля = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Для Каждого Поле Из Параметры.Поля Цикл
		СтрокаТаблицы = Сопоставление.Добавить();
		СтрокаТаблицы.Ключ = Поле.Ключ;
		СтрокаТаблицы.Раздел = Поле.Раздел;
		СтрокаТаблицы.Поле = Поле.Наименование;
		СтрокаТаблицы.ТипПоля = Поле.ТипПоля;
		СтрокаТаблицы.Параметр = Поле.Параметр;
		Если ЗначениеЗаполнено(СтрокаТаблицы.Параметр) Тогда
			СтрокаТаблицы.КакНайден = НСтр("ru = 'задан'");
		КонецЕсли;
	КонецЦикла;

	ПодобратьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТолькоБезПараметраПриИзменении(Элемент)

	УстановитьОтбор();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСопоставление

&НаКлиенте
Процедура СопоставлениеПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Сопоставление.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.КакНайден = ?(ЗначениеЗаполнено(ТекущиеДанные.Параметр), НСтр("ru = 'вручную'"), "");
	КонецЕсли;
	ОбновитьИтог(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Сопоставление Цикл
		Результат.Добавить(Новый Структура("Ключ, Параметр", СтрокаТаблицы.Ключ, СтрокаТаблицы.Параметр));
	КонецЦикла;
	Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьАвтоматически(Команда)

	Найдено = ПодобратьНаСервере();
	УстановитьОтбор();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Подбор параметров'"), ,
		СтрШаблон(НСтр("ru = 'Подобрано полей: %1'"), Найдено));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подбирает параметры полям, у которых он не выбран. Возвращает число подобранных.
&НаСервере
Функция ПодобратьНаСервере()

	Строки = Новый Массив;
	Поля = Новый Массив;
	Для Каждого СтрокаТаблицы Из Сопоставление Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Параметр) Тогда
			Строки.Добавить(СтрокаТаблицы);
			Поля.Добавить(Новый Структура("Наименование", СтрокаТаблицы.Поле));
		КонецЕсли;
	КонецЦикла;

	Найдено = 0;
	Найденные = омг_ПротоколыПриемаСервер.ПодобратьПараметрыПолей(Поля);
	Для Индекс = 0 По Найденные.ВГраница() Цикл
		Если ЗначениеЗаполнено(Найденные[Индекс]) Тогда
			Строки[Индекс].Параметр = Найденные[Индекс];
			Строки[Индекс].КакНайден = НСтр("ru = 'по наименованию'");
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;

	ОбновитьИтог(ЭтотОбъект);
	Возврат Найдено;

КонецФункции

&НаКлиенте
Процедура УстановитьОтбор()

	Если ТолькоБезПараметра Тогда
		Элементы.Сопоставление.ОтборСтрок = Новый ФиксированнаяСтруктура("КакНайден", "");
	Иначе
		Элементы.Сопоставление.ОтборСтрок = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтог(Форма)

	Всего = Форма.Сопоставление.Количество();
	Сопоставлено = 0;
	Для Каждого СтрокаТаблицы Из Форма.Сопоставление Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Параметр) Тогда
			Сопоставлено = Сопоставлено + 1;
		КонецЕсли;
	КонецЦикла;
	Форма.Итог = СтрШаблон(НСтр("ru = 'Сопоставлено %1 из %2, без параметра: %3'"), Сопоставлено, Всего, Всего - Сопоставлено);

КонецПроцедуры

#КонецОбласти

// Настройки поля визуального редактора шаблона протокола.
// Параметры: Поле - Структура (описание плашки: key, name, type, def, opts, cols, unit, param, req) или Неопределено;
//            Текст - выделенный в редакторе текст (для нового поля).
// Результат закрытия - Структура с теми же свойствами (и typeTitle, paramName) или Неопределено.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого ИмяТипа Из СтрРазделить("Текст,Строка,Число,Дата,Флажок,Выбор,ВыборНесколько,Таблица", ",") Цикл
		Элементы.ТипПоля.СписокВыбора.Добавить(Перечисления.омг_ТипыПолейПротокола[ИмяТипа]);
	КонецЦикла;

	Поле = Параметры.Поле;
	Если ТипЗнч(Поле) = Тип("Структура") Тогда
		Ключ = ЗначениеСвойства(Поле, "key");
		Наименование = ЗначениеСвойства(Поле, "name");
		ИмяТипа = ЗначениеСвойства(Поле, "type");
		Если ПустаяСтрока(ИмяТипа) Или ИмяТипа = "Пояснение" Или ИмяТипа = "Фраза" Тогда
			ИмяТипа = "Текст";
		КонецЕсли;
		Попытка
			ТипПоля = Перечисления.омг_ТипыПолейПротокола[ИмяТипа];
		Исключение
			ТипПоля = Перечисления.омг_ТипыПолейПротокола.Текст;
		КонецПопытки;
		ЗначениеПоУмолчанию = ЗначениеСвойства(Поле, "def");
		ВариантыВыбора = ЗначениеСвойства(Поле, "opts");
		КолонкиТаблицы = ЗначениеСвойства(Поле, "cols");
		ЕдиницаИзмерения = ЗначениеСвойства(Поле, "unit");
		Обязательное = (ЗначениеСвойства(Поле, "req", Ложь) = Истина);
		Идентификатор = ЗначениеСвойства(Поле, "param");
		Если Не ПустаяСтрока(Идентификатор) Тогда
			Попытка
				Параметр = ПланыВидовХарактеристик.ПараметрыHTML.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
			Исключение
				Параметр = Неопределено;
			КонецПопытки;
		КонецЕсли;
	Иначе
		ТипПоля = Перечисления.омг_ТипыПолейПротокола.Строка;
		// Выделенный текст вида «______» - не название; осмысленный текст - название поля.
		Текст = СокрЛП(СтрЗаменить(Строка(Параметры.Текст), "_", ""));
		Если СтрДлина(Текст) > 1 И СтрДлина(Текст) <= 60 Тогда
			Наименование = Текст;
		КонецЕсли;
	КонецЕсли;

	УстановитьВидимость(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ТекущийЭлемент = Элементы.Наименование;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)

	Наименование = СокрЛП(СтрЗаменить(СтрЗаменить(Наименование, "{", ""), "}", ""));

КонецПроцедуры

&НаКлиенте
Процедура ТипПоляПриИзменении(Элемент)

	УстановитьВидимость(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПараметрПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Параметр) Тогда
		ПараметрПриИзмененииНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)

	Если ПустаяСтрока(Наименование) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите название поля.'"), , "Наименование");
		Возврат;
	КонецЕсли;
	Закрыть(РезультатНаСервере());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция РезультатНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("key", Ключ);
	Результат.Вставить("name", СокрЛП(Наименование));
	Результат.Вставить("type", ?(ЗначениеЗаполнено(ТипПоля), XMLСтрока(ТипПоля), "Текст"));
	Результат.Вставить("typeTitle", Строка(ТипПоля));
	Результат.Вставить("def", ЗначениеПоУмолчанию);
	Результат.Вставить("opts", ВариантыВыбора);
	Результат.Вставить("cols", КолонкиТаблицы);
	Результат.Вставить("unit", ЕдиницаИзмерения);
	Результат.Вставить("param", ?(ЗначениеЗаполнено(Параметр), XMLСтрока(Параметр), ""));
	Результат.Вставить("paramName", ?(ЗначениеЗаполнено(Параметр), Строка(Параметр), ""));
	Результат.Вставить("req", Обязательное);
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПараметрПриИзмененииНаСервере()

	Если ПустаяСтрока(Наименование) Тогда
		Наименование = Строка(Параметр);
	КонецЕсли;
	Описание = омг_ПротоколыПриемаСервер.ПолеРедактораПоПараметру(Параметр);
	Если СтрНайти(Описание, """type"":""Число""") > 0 Тогда
		ТипПоля = Перечисления.омг_ТипыПолейПротокола.Число;
	ИначеЕсли СтрНайти(Описание, """type"":""Дата""") > 0 Тогда
		ТипПоля = Перечисления.омг_ТипыПолейПротокола.Дата;
	ИначеЕсли СтрНайти(Описание, """type"":""Флажок""") > 0 Тогда
		ТипПоля = Перечисления.омг_ТипыПолейПротокола.Флажок;
	КонецЕсли;
	УстановитьВидимость(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимость(Форма)

	Тип = Форма.ТипПоля;
	Элементы = Форма.Элементы;
	Элементы.ВариантыВыбора.Видимость = (Тип = ПредопределенноеЗначение("Перечисление.омг_ТипыПолейПротокола.Выбор")
		Или Тип = ПредопределенноеЗначение("Перечисление.омг_ТипыПолейПротокола.ВыборНесколько"));
	Элементы.КолонкиТаблицы.Видимость = (Тип = ПредопределенноеЗначение("Перечисление.омг_ТипыПолейПротокола.Таблица"));
	Элементы.ЕдиницаИзмерения.Видимость = (Тип = ПредопределенноеЗначение("Перечисление.омг_ТипыПолейПротокола.Число"));
	Элементы.ЗначениеПоУмолчанию.Видимость = (Тип <> ПредопределенноеЗначение("Перечисление.омг_ТипыПолейПротокола.Таблица"));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеСвойства(Структура, Имя, ПоУмолчанию = "")

	Значение = Неопределено;
	Если Структура.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти

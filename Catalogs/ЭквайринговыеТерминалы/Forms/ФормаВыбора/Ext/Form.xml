	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ЭТ.Ссылка КАК Ссылка,
	ЭТ.ПометкаУдаления КАК ПометкаУдаления,
	ЭТ.Предопределенный КАК Предопределенный,
	ЭТ.Код КАК Код,
	ЭТ.Наименование КАК Наименование,
	ЭТ.Тип КАК Тип,
	ЭТ.Договор КАК Договор,
	ЭТ.Контрагент КАК Контрагент,
	ЭТ.ИспользоватьЭТАвтономно КАК ИспользоватьЭТАвтономно,
	ЭТ.ТорговаяТочкаСБП КАК ТорговаяТочкаСБП,
	ЭТ.Касса КАК Касса
ИЗ
	Справочник.ЭквайринговыеТерминалы КАК ЭТ
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			МАКСИМУМ(ВЫБОР
					КОГДА ЭТПО.ПодключаемоеОборудование.РабочееМесто = &amp;РабочееМесто
						ТОГДА ИСТИНА
					ИНАЧЕ ЛОЖЬ
				КОНЕЦ) КАК ЭтоРабочееМесто,
			ЭТПО.Ссылка КАК Ссылка
		ИЗ
			Справочник.ЭквайринговыеТерминалы.Оборудование КАК ЭТПО
		
		СГРУППИРОВАТЬ ПО
			ЭТПО.Ссылка) КАК ЭТПО
		ПО ЭТ.Ссылка = ЭТПО.Ссылка
ГДЕ
	ЭТ.Тип &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ТипыСпособовОплат.СертификатНСПК) И
	(ЭТ.Договор = ЗНАЧЕНИЕ(Справочник.СоглашенияСтрахования.ПустаяСсылка) ИЛИ &amp;Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) ИЛИ ЭТ.Договор.Организация = &amp;Организация) И
	ВЫБОР
		КОГДА ЭТ.Касса ССЫЛКА Справочник.Кассы
			ТОГДА &amp;ПустаяКасса
					ИЛИ ЭТ.Касса В (&amp;Касса)
		КОГДА ЭТ.Касса ССЫЛКА Справочник.Филиалы
			ТОГДА ЭТ.Касса В (&amp;Филиал)
		ИНАЧЕ ИСТИНА
	КОНЕЦ
		И (ЭТПО.ЭтоРабочееМесто ЕСТЬ NULL
			ИЛИ ЭТПО.ЭтоРабочееМесто = ИСТИНА
			ИЛИ ЭТ.ИспользоватьЭТАвтономно
			ИЛИ ЭТ.ТорговаяТочкаСБП &lt;&gt; ЗНАЧЕНИЕ(Справочник.НастройкиИнтеграцииСПлатежнымиСистемами.ПустаяСсылка))</QueryText>
				<MainTable>Catalog.ЭквайринговыеТерминалы</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>

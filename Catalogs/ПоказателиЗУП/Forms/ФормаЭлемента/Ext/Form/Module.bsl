
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПереключательПоказатель = Объект.ЭтоВидВремени;
	НастроитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключательПоказательПриИзменении(Элемент)
	
	Объект.ЭтоВидВремени = ПереключательПоказатель;
	НастроитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьДоступность()
	
	Если Объект.ЭтоВидВремени Тогда 
		Элементы.Идентификатор.Заголовок = "Буквенный/цифровой код";
	Иначе
		Элементы.Идентификатор.Заголовок = "Идентификатор";
	КонецЕсли;
	
КонецПроцедуры

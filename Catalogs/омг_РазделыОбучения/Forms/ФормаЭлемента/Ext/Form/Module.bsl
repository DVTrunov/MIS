&НаКлиенте
Перем ИмяФайлаДокументаКандидат;

&НаКлиенте
Процедура ТипКонтентаПриИзменении(Элемент)
    ОбновитьВидимостьПолей();
КонецПроцедуры

Процедура ОбновитьВидимостьПолей()
	
	Если 
		Объект.ТипКонтента = Перечисления.омг_ТипыКонтента.Видео  Тогда
		Элементы.СсылкаНаВидео.Видимость = Истина; 
		
			Иначе
		Элементы.СсылкаНаВидео.Видимость = Ложь
	КонецЕсли;
	Если 
		Объект.ТипКонтента = Перечисления.омг_ТипыКонтента.Документ Тогда
		Элементы.Документ.Видимость = Истина;
		Элементы.КнопкаЗагрузить.Видимость = Истина;
		Элементы.ОткрытьФайл.Видимость = Истина;
			Иначе
		Элементы.Документ.Видимость = Ложь;
		Элементы.КнопкаЗагрузить.Видимость = Ложь;
		Элементы.ОткрытьФайл.Видимость = Ложь;
	КонецЕсли;
	Объект.НомерКартинкиТипаКонтента = ОбщегоНазначенияПереопределяемый.ПолучитьИндексЭлементаПеречисления(Объект.ТипКонтента)+1;
  КонецПроцедуры


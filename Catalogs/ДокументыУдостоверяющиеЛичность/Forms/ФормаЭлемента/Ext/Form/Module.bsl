#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.ВидКлассификатора", Перечисления.ВидыКлассификаторовМинЗдрава.КлассификаторДокументовУдостоверяющихЛичность));
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.КлассификаторВидовДУЛ.ПараметрыВыбора = НовыеПараметры;
	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.ВидКлассификатора", Перечисления.ВидыКлассификаторовМинЗдрава.ДокументыУдостоверяющиеЛичность));
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.КлассификаторВидовДУЛРЭМД.ПараметрыВыбора = НовыеПараметры;
	
	// Добавлено Макеев (
	Элементы.КлассификаторВидовДУЛ.Видимость = Ложь;
	Элементы.КлассификаторВидовДУЛРЭМД.Видимость = Ложь;
	
	Эломг_МаскаИИН = Элементы.Добавить("омг_МаскаИИН", Тип("ПолеФормы"), ЭтаФорма);
	Эломг_МаскаИИН.Вид = ВидПоляФормы.ПолеВвода;
	Эломг_МаскаИИН.ПутьКДанным = "Объект.омг_МаскаИИН";
	Эломг_МаскаИИН.АвтоМаксимальнаяШирина = Ложь;
	Эломг_МаскаИИН.МаксимальнаяШирина = 10;
	
	
	Элементы.Переместить(Эломг_МаскаИИН, ЭтаФорма, Элементы.МаскаСерииДокумента); 
	
	Эломг_ДокументРК = Элементы.Добавить("омг_Страна", Тип("ПолеФормы"), ЭтаФорма);
	Эломг_ДокументРК.Вид = ВидПоляФормы.ПолеВвода; 
	Эломг_ДокументРК.Заголовок = "Страна гражданства";
	Эломг_ДокументРК.ПутьКДанным = "Объект.омг_Страна";

	// )
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НеИмеетСериюПриИзменении(Элемент)	
	
	Объект.МаскаСерииДокумента = "";
	Элементы.МаскаСерииДокумента.Доступность = Не Объект.НеИмеетСерию;
	
КонецПроцедуры

#КонецОбласти
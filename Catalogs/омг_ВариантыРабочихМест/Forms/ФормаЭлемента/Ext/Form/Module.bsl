&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Объект.Поставляемый Тогда
        ТолькоПросмотр = Истина;
        Элементы.НадписьПоставляемый.Видимость = Истина;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПанелиПриАктивизацииСтроки(Элемент)
    ОбновитьОтборПлиток();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборПлиток()
    ТекущаяПанель = Элементы.Панели.ТекущиеДанные;
    Если ТекущаяПанель = Неопределено Тогда
        Элементы.Плитки.ОтборСтрок = Новый ФиксированнаяСтруктура("КодПанели", "—нет—");
        Элементы.Плитки.Доступность = Ложь;
    Иначе
        Элементы.Плитки.ОтборСтрок = Новый ФиксированнаяСтруктура("КодПанели", ТекущаяПанель.КодПанели);
        Элементы.Плитки.Доступность = Истина;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПанель(Команда)
    НоваяСтрока = Объект.Панели.Добавить();
    НоваяСтрока.КодПанели = НовыйКодПанели();
    НоваяСтрока.Заголовок = "Новая панель";
    НоваяСтрока.Колонка   = 1;
    Элементы.Панели.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
    ОбновитьОтборПлиток();
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйКодПанели()
    Возврат Справочники.омг_ВариантыРабочихМест.НовыйКодПанели();
КонецФункции

&НаКлиенте
Процедура УдалитьПанель(Команда)
    ТекущаяПанель = Элементы.Панели.ТекущиеДанные;
    Если ТекущаяПанель = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Оповещение = Новый ОписаниеОповещения("УдалитьПанельЗавершение", ЭтотОбъект, ТекущаяПанель.КодПанели);
    Текст = СтрШаблон("Удалить панель ""%1"" вместе со всеми её плитками?", ТекущаяПанель.Заголовок);
    ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПанельЗавершение(Ответ, КодПанели) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    Для Сч = -Объект.Плитки.Количество() По -1 Цикл
        Строка = Объект.Плитки[-Сч - 1];
        Если Строка.КодПанели = КодПанели Тогда
            Объект.Плитки.Удалить(Строка);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Панель Из Объект.Панели Цикл
        Если Панель.КодПанели = КодПанели Тогда
            Объект.Панели.Удалить(Панель);
            Прервать;
        КонецЕсли;
    КонецЦикла;
    ОбновитьОтборПлиток();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПлитку(Команда)
    ТекущаяПанель = Элементы.Панели.ТекущиеДанные;
    Если ТекущаяПанель = Неопределено Тогда
        ПоказатьПредупреждение(, "Сначала выберите или создайте панель");
        Возврат;
    КонецЕсли;
    НоваяСтрока = Объект.Плитки.Добавить();
    НоваяСтрока.КодПанели = ТекущаяПанель.КодПанели;
    НоваяСтрока.Размер    = ПредопределенноеЗначение("Перечисление.омг_РазмерыПлиток.Карточка");
    Элементы.Плитки.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
    Элементы.Плитки.ТекущийЭлемент = Элементы.ПлиткиДействие;
    ТекущийЭлемент = Элементы.Плитки;
КонецПроцедуры
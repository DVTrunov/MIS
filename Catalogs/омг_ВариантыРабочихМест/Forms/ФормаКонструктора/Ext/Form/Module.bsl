
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
     омг_КаталогДействийРабочихМест.ОбеспечитьАктуальностьКаталога();
    Если Объект.Поставляемый Тогда
        ТолькоПросмотр = Истина;
    КонецЕсли;
    ЗагрузитьДерево();
    ОбновитьПревьюНаСервере();
КонецПроцедуры


&НаСервере
Процедура ЗагрузитьДерево()

      ДеревоЗнач = РеквизитФормыВЗначение("Дерево");
    ДеревоЗнач.Строки.Очистить();
    Осталось = Новый Массив;
    Для Каждого Стр Из Объект.Элементы Цикл
        Осталось.Добавить(Стр);
    КонецЦикла;

    Размещенные = Новый Соответствие;

    Пока Осталось.Количество() > 0 Цикл

        Следующие = Новый Массив;
        Прогресс  = Ложь;

        Для Каждого Стр Из Осталось Цикл
            Если ПустаяСтрока(Стр.КодРодителя) Тогда
                Коллекция = ДеревоЗнач.Строки;
            Иначе
                Родитель = Размещенные.Получить(СокрЛП(Стр.КодРодителя));
                Если Родитель = Неопределено Тогда
                    Следующие.Добавить(Стр);
                    Продолжить;
                КонецЕсли;
                Коллекция = Родитель.Строки;
            КонецЕсли;
            Узел = Коллекция.Добавить();
            ЗаполнитьЗначенияСвойств(Узел, Стр);
            Узел.Представление = ПредставлениеУзлаСервер(Узел);
            Размещенные.Вставить(СокрЛП(Стр.КодЭлемента), Узел);
            Прогресс = Истина;
        КонецЦикла;

        Если НЕ Прогресс Тогда
            Для Каждого Стр Из Следующие Цикл
                Узел = ДеревоЗнач.Строки.Добавить();
                ЗаполнитьЗначенияСвойств(Узел, Стр);
                Узел.Представление = ПредставлениеУзлаСервер(Узел);
            КонецЦикла;
            Прервать;
        КонецЕсли;

        Осталось = Следующие;

    КонецЦикла;

    ЗначениеВДанныеФормы(ДеревоЗнач, Дерево);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеУзлаСервер(Узел)
    Текст = Строка(Узел.ТипЭлемента);
    Если ЗначениеЗаполнено(Узел.Заголовок) Тогда
        Возврат Текст + ": " + Узел.Заголовок;
    ИначеЕсли ЗначениеЗаполнено(Узел.Действие) Тогда
        Возврат Текст + ": " + Строка(Узел.Действие);
    КонецЕсли;
    Возврат Текст;
КонецФункции

&НаСервере
Процедура ВыгрузитьДерево()
    Объект.Элементы.Очистить();
    ЗаписатьУзлы(Дерево.ПолучитьЭлементы(), "");
КонецПроцедуры

&НаСервере
Процедура ЗаписатьУзлы(Коллекция, КодРодителя)
    Для Каждого Узел Из Коллекция Цикл
        Если ПустаяСтрока(Узел.КодЭлемента) Тогда
            Узел.КодЭлемента = Справочники.омг_ВариантыРабочихМест.НовыйКод();
        КонецЕсли;
        Стр = Объект.Элементы.Добавить();
        ЗаполнитьЗначенияСвойств(Стр, Узел);
        Стр.КодРодителя = КодРодителя;
        ЗаписатьУзлы(Узел.ПолучитьЭлементы(), Узел.КодЭлемента);
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    ВыгрузитьДерево();
    ТекущийОбъект.Элементы.Загрузить(Объект.Элементы.Выгрузить());
КонецПроцедуры

&НаСервере
Процедура ОбновитьПревьюНаСервере()
   ВыгрузитьДерево();
    Данные = омг_РабочиеМестаПостроение.ДанныеВарианта(РеквизитФормыВЗначение("Объект"));
    омг_РабочиеМестаПостроение.Построить(ЭтаФорма, Неопределено, Данные, Истина);
КонецПроцедуры 
&НаКлиенте
Процедура ОбновитьПревью()
    ОбновитьПревьюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
    Если НЕ ОтменаРедактирования Тогда
        Текущая = Элементы.Дерево.ТекущиеДанные;
        Если Текущая <> Неопределено Тогда
            ОбновитьПредставление(Текущая);
        КонецЕсли;
        ОбновитьПревью();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредставление(Узел)
    Текст = Строка(Узел.ТипЭлемента);
    Если ЗначениеЗаполнено(Узел.Заголовок) Тогда
        Узел.Представление = Текст + ": " + Узел.Заголовок;
    ИначеЕсли ЗначениеЗаполнено(Узел.Действие) Тогда
        Узел.Представление = Текст + ": " + Строка(Узел.Действие);
    Иначе
        Узел.Представление = Текст;
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура Подключаемый_НажатиеПлитки(Команда)

    Строки = ПараметрыДействий.НайтиСтроки(Новый Структура("ИмяКоманды", Команда.Имя));
    Если Строки.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Индекс = Строки[0].НомерСтроки - 1;
    Если Индекс < 0 ИЛИ Индекс >= Объект.Элементы.Количество() Тогда
        Возврат;
    КонецЕсли;

    Узел = НайтиУзел(Дерево.ПолучитьЭлементы(), Объект.Элементы[Индекс].КодЭлемента);
    Если Узел <> Неопределено Тогда
        Элементы.Дерево.ТекущаяСтрока = Узел.ПолучитьИдентификатор();
        ТекущийЭлемент = Элементы.Дерево;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция НайтиУзел(Коллекция, Код)
    Для Каждого Узел Из Коллекция Цикл
        Если Узел.КодЭлемента = Код Тогда
            Возврат Узел;
        КонецЕсли;
        Найденный = НайтиУзел(Узел.ПолучитьЭлементы(), Код);
        Если Найденный <> Неопределено Тогда
            Возврат Найденный;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ДобавитьЭлемент(Команда)

    Текущая = Элементы.Дерево.ТекущиеДанные;
    ТипТекущего  = Неопределено;
    ТипРодителя  = Неопределено;

    Если Текущая <> Неопределено Тогда
        ТипТекущего = Текущая.ТипЭлемента;
        Родитель = Текущая.ПолучитьРодителя();
        Если Родитель <> Неопределено Тогда
            ТипРодителя = Родитель.ТипЭлемента;
        КонецЕсли;
    КонецЕсли;

    Варианты = ВариантыДобавления(ТипТекущего, ТипРодителя);

    Если Варианты.Типы.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Внутрь выбранного элемента нельзя ничего вложить");
        Возврат;
    КонецЕсли;

    Оповещение = Новый ОписаниеОповещения("ДобавитьЭлементЗавершение", ЭтотОбъект, Варианты.Рядом);
    ПоказатьВыборИзМеню(Оповещение, Варианты.Типы);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВариантыДобавления(ТипТекущего, ТипРодителя)

    Менеджер  = Справочники.омг_ВариантыРабочихМест;
    Результат = Новый Структура("Типы, Рядом", Новый СписокЗначений, Ложь);

    Контейнер = ТипТекущего;
    Если ТипТекущего <> Неопределено И НЕ Менеджер.ЭтоКонтейнер(ТипТекущего) Тогда
        Контейнер      = ТипРодителя;
        Результат.Рядом = Истина;
    КонецЕсли;
    Если Контейнер = Неопределено Тогда
        Контейнер = Перечисления.омг_ТипыЭлементовРабочегоМеста.ПустаяСсылка();
    КонецЕсли;

    Для Каждого ЗначениеТипа Из Перечисления.омг_ТипыЭлементовРабочегоМеста Цикл
        Если Менеджер.ДопустимоВложение(Контейнер, ЗначениеТипа) Тогда
            Результат.Типы.Добавить(ЗначениеТипа, Строка(ЗначениеТипа));
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ДобавитьЭлементЗавершение(Выбранный, Рядом) Экспорт

    Если Выбранный = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Текущая = Элементы.Дерево.ТекущиеДанные;

    Если Текущая = Неопределено Тогда
        Коллекция = Дерево.ПолучитьЭлементы();
    ИначеЕсли Рядом Тогда
        Родитель  = Текущая.ПолучитьРодителя();
        Коллекция = ?(Родитель = Неопределено, Дерево.ПолучитьЭлементы(), Родитель.ПолучитьЭлементы());
    Иначе
        Коллекция = Текущая.ПолучитьЭлементы();
    КонецЕсли;

    Узел = Коллекция.Добавить();
    Узел.ТипЭлемента = Выбранный.Значение;
    Узел.КодЭлемента = НовыйКод();
    ЗаполнитьПоУмолчанию(Узел);
    ОбновитьПредставление(Узел);

    Элементы.Дерево.ТекущаяСтрока = Узел.ПолучитьИдентификатор();
    ОбновитьПревью();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Узел)

    Типы = ПредопределенноеЗначение("Перечисление.омг_ТипыЭлементовРабочегоМеста.Панель");

    Если Узел.ТипЭлемента = Типы Тогда
        Узел.Заголовок           = "Новая панель";
        Узел.ПоказыватьЗаголовок = Истина;
        Узел.Размер              = ПредопределенноеЗначение("Перечисление.омг_РазмерыПлиток.Карточка");
        Узел.ЭлементовВСтроке    = 2;
    ИначеЕсли Узел.ТипЭлемента = ПредопределенноеЗначение("Перечисление.омг_ТипыЭлементовРабочегоМеста.Плитка") Тогда
        Узел.Размер = ПредопределенноеЗначение("Перечисление.омг_РазмерыПлиток.Карточка");
    ИначеЕсли Узел.ТипЭлемента = ПредопределенноеЗначение("Перечисление.омг_ТипыЭлементовРабочегоМеста.Группа") Тогда
        Узел.Заголовок = "Новая группа";
        Узел.Поведение = ПредопределенноеЗначение("Перечисление.омг_ПоведенияГрупп.Обычная");
    КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйКод()
    Возврат Справочники.омг_ВариантыРабочихМест.НовыйКод();
КонецФункции

&НаКлиенте
Процедура УдалитьЭлемент(Команда)
    Текущая = Элементы.Дерево.ТекущиеДанные;
    Если Текущая = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Оповещение = Новый ОписаниеОповещения("УдалитьЭлементЗавершение", ЭтотОбъект);
    ПоказатьВопрос(Оповещение,
        СтрШаблон("Удалить ""%1"" со всем содержимым?", Текущая.Представление),
        РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЭлементЗавершение(Ответ, ДопПараметры) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    Текущая = Элементы.Дерево.ТекущиеДанные;
    Если Текущая = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Родитель  = Текущая.ПолучитьРодителя();
    Коллекция = ?(Родитель = Неопределено, Дерево.ПолучитьЭлементы(), Родитель.ПолучитьЭлементы());
    Коллекция.Удалить(Текущая);
    ОбновитьПревью();
КонецПроцедуры

&НаКлиенте
Процедура Вверх(Команда)
    Сдвинуть(-1);
КонецПроцедуры

&НаКлиенте
Процедура Вниз(Команда)
    Сдвинуть(1);
КонецПроцедуры

&НаКлиенте
Процедура Сдвинуть(Направление)
    Текущая = Элементы.Дерево.ТекущиеДанные;
    Если Текущая = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Родитель  = Текущая.ПолучитьРодителя();
    Коллекция = ?(Родитель = Неопределено, Дерево.ПолучитьЭлементы(), Родитель.ПолучитьЭлементы());
    Индекс = Коллекция.Индекс(Текущая);
    Если Индекс + Направление < 0 ИЛИ Индекс + Направление >= Коллекция.Количество() Тогда
        Возврат;
    КонецЕсли;
    Коллекция.Сдвинуть(Индекс, Направление);
    ОбновитьПревью();
КонецПроцедуры  

&НаКлиенте
Функция ПеренестиУзел(Узел, НоваяКоллекция, Индекс = -1)

    Если Индекс < 0 Тогда
        Новый_ = НоваяКоллекция.Добавить();
    Иначе
        Новый_ = НоваяКоллекция.Вставить(Индекс);
    КонецЕсли;

    ЗаполнитьЗначенияСвойств(Новый_, Узел);
    СкопироватьДетей(Узел, Новый_);

    СтараяКоллекция = КоллекцияУзла(Узел);
    СтараяКоллекция.Удалить(Узел);

    Возврат Новый_;

КонецФункции

&НаКлиенте
Процедура СкопироватьДетей(Источник, Приемник)
    Для Каждого Ребенок Из Источник.ПолучитьЭлементы() Цикл
        Новый_ = Приемник.ПолучитьЭлементы().Добавить();
        ЗаполнитьЗначенияСвойств(Новый_, Ребенок);
        СкопироватьДетей(Ребенок, Новый_);
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция КоллекцияУзла(Узел)
    Родитель = Узел.ПолучитьРодителя();
    Возврат ?(Родитель = Неопределено, Дерево.ПолучитьЭлементы(), Родитель.ПолучитьЭлементы());
КонецФункции

&НаСервереБезКонтекста
Функция МожноВложить(ТипРодителя, ТипЭлемента)
    Если ТипРодителя = Неопределено Тогда
        ТипРодителя = Перечисления.омг_ТипыЭлементовРабочегоМеста.ПустаяСсылка();
    КонецЕсли;
    Возврат Справочники.омг_ВариантыРабочихМест.ДопустимоВложение(ТипРодителя, ТипЭлемента);
КонецФункции

&НаКлиенте
Процедура Вложить(Команда)

    Текущая = Элементы.Дерево.ТекущиеДанные;
    Если Текущая = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Коллекция = КоллекцияУзла(Текущая);
    Индекс = Коллекция.Индекс(Текущая);
    Если Индекс = 0 Тогда
        ПоказатьПредупреждение(, "Некуда вкладывать: выше нет соседнего элемента");
        Возврат;
    КонецЕсли;

    Сосед = Коллекция[Индекс - 1];
    Если НЕ МожноВложить(Сосед.ТипЭлемента, Текущая.ТипЭлемента) Тогда
        ПоказатьПредупреждение(, СтрШаблон("""%1"" нельзя вложить в ""%2""",
            Текущая.ТипЭлемента, Сосед.ТипЭлемента));
        Возврат;
    КонецЕсли;

    Новый_ = ПеренестиУзел(Текущая, Сосед.ПолучитьЭлементы());
    Элементы.Дерево.ТекущаяСтрока = Новый_.ПолучитьИдентификатор();
    ОбновитьПревью();

КонецПроцедуры

&НаКлиенте
Процедура Вынести(Команда)

    Текущая = Элементы.Дерево.ТекущиеДанные;
    Если Текущая = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Родитель = Текущая.ПолучитьРодителя();
    Если Родитель = Неопределено Тогда
        ПоказатьПредупреждение(, "Элемент уже на верхнем уровне");
        Возврат;
    КонецЕсли;

    Дед = Родитель.ПолучитьРодителя();
    ТипДеда = ?(Дед = Неопределено, Неопределено, Дед.ТипЭлемента);

    Если НЕ МожноВложить(ТипДеда, Текущая.ТипЭлемента) Тогда
        ПоказатьПредупреждение(, "На этом уровне такой элемент недопустим");
        Возврат;
    КонецЕсли;

    Коллекция = ?(Дед = Неопределено, Дерево.ПолучитьЭлементы(), Дед.ПолучитьЭлементы());
    Новый_ = ПеренестиУзел(Текущая, Коллекция, Коллекция.Индекс(Родитель) + 1);
    Элементы.Дерево.ТекущаяСтрока = Новый_.ПолучитьИдентификатор();
    ОбновитьПревью();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоПеретаскиваниеНачало(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
    Текущая = Элементы.Дерево.ТекущиеДанные;
    Если Текущая = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ПараметрыПеретаскивания.Значение = Текущая.ПолучитьИдентификатор();
    ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
	//Сообщить("Начало: " + ПараметрыПеретаскивания.Значение);
КонецПроцедуры
&НаКлиенте
Процедура ДеревоПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
  Сообщить("Проверка: строка = " + Строка);
    СтандартнаяОбработка = Ложь;
    ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;

    Если Строка = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Источник = Дерево.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
    Приемник = Дерево.НайтиПоИдентификатору(Строка);
    Если Источник = Неопределено ИЛИ Приемник = Неопределено ИЛИ Источник = Приемник Тогда
        Возврат;
    КонецЕсли;

    Если ЕстьСредиПотомков(Источник, Приемник) Тогда
        Возврат;
    КонецЕсли;

    Если МожноВложить(Приемник.ТипЭлемента, Источник.ТипЭлемента) Тогда
        ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)

    СтандартнаяОбработка = Ложь;

    Если Строка = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Источник = Дерево.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
    Приемник = Дерево.НайтиПоИдентификатору(Строка);
    Если Источник = Неопределено ИЛИ Приемник = Неопределено ИЛИ Источник = Приемник Тогда
        Возврат;
    КонецЕсли;

    Если ЕстьСредиПотомков(Источник, Приемник) Тогда
        ПоказатьПредупреждение(, "Нельзя переместить элемент внутрь самого себя");
        Возврат;
    КонецЕсли;

    Если НЕ МожноВложить(Приемник.ТипЭлемента, Источник.ТипЭлемента) Тогда
        ПоказатьПредупреждение(, СтрШаблон("""%1"" нельзя вложить в ""%2""",
            Источник.ТипЭлемента, Приемник.ТипЭлемента));
        Возврат;
    КонецЕсли;

    Новый_ = ПеренестиУзел(Источник, Приемник.ПолучитьЭлементы());
    Элементы.Дерево.ТекущаяСтрока = Новый_.ПолучитьИдентификатор();
    ОбновитьПревью();

КонецПроцедуры

&НаКлиенте
Функция ЕстьСредиПотомков(Узел, Искомый)
    Для Каждого Ребенок Из Узел.ПолучитьЭлементы() Цикл
        Если Ребенок = Искомый ИЛИ ЕстьСредиПотомков(Ребенок, Искомый) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции
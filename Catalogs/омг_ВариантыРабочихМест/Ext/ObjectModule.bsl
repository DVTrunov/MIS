Процедура ПриКопировании(ОбъектКопирования)
    Поставляемый = Ложь;
    Наименование = Наименование + " (копия)";
    ПерегенерироватьКоды();
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

    Менеджер = Справочники.омг_ВариантыРабочихМест;
    ТипыПоКоду = Новый Соответствие;

    Для Каждого Стр Из Элементы Цикл
        Если ПустаяСтрока(Стр.КодЭлемента) Тогда
            Стр.КодЭлемента = Менеджер.НовыйКод();
        КонецЕсли;
        Если ТипыПоКоду.Получить(Стр.КодЭлемента) <> Неопределено Тогда
            СообщитьОбОшибке(СтрШаблон("Дублирующийся код в строке %1", Стр.НомерСтроки), Отказ);
        КонецЕсли;
        ТипыПоКоду.Вставить(Стр.КодЭлемента, Стр.ТипЭлемента);
    КонецЦикла;

    Для Каждого Стр Из Элементы Цикл

        Если ПустаяСтрока(Стр.КодРодителя) Тогда
            ТипРодителя = Перечисления.омг_ТипыЭлементовРабочегоМеста.ПустаяСсылка();
        Иначе
            ТипРодителя = ТипыПоКоду.Получить(Стр.КодРодителя);
            Если ТипРодителя = Неопределено Тогда
                СообщитьОбОшибке(СтрШаблон("Строка %1: родитель не найден", Стр.НомерСтроки), Отказ);
                Продолжить;
            КонецЕсли;
        КонецЕсли;

        Если НЕ Менеджер.ДопустимоВложение(ТипРодителя, Стр.ТипЭлемента) Тогда
            СообщитьОбОшибке(СтрШаблон("Строка %1: ""%2"" не может лежать внутри ""%3""",
                Стр.НомерСтроки, Стр.ТипЭлемента, ?(ЗначениеЗаполнено(ТипРодителя), ТипРодителя, "корня")), Отказ);
        КонецЕсли;

        Если ЕстьЦикл(Стр.КодЭлемента) Тогда
            СообщитьОбОшибке(СтрШаблон("Строка %1: циклическая вложенность", Стр.НомерСтроки), Отказ);
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

Процедура СообщитьОбОшибке(Текст, Отказ)
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Текст;
    Сообщение.Сообщить();
    Отказ = Истина;
КонецПроцедуры

Функция ЕстьЦикл(КодЭлемента)
    Текущий = КодЭлемента;
    Шагов = 0;
    Пока НЕ ПустаяСтрока(Текущий) Цикл
        Шагов = Шагов + 1;
        Если Шагов > Элементы.Количество() Тогда
            Возврат Истина;
        КонецЕсли;
        Найденные = Элементы.НайтиСтроки(Новый Структура("КодЭлемента", Текущий));
        Если Найденные.Количество() = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
        Текущий = Найденные[0].КодРодителя;
        Если Текущий = КодЭлемента Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Процедура ПерегенерироватьКоды()
    Менеджер = Справочники.омг_ВариантыРабочихМест;
    Соответствия = Новый Соответствие;
    Для Каждого Стр Из Элементы Цикл
        Новый_ = Менеджер.НовыйКод();
        Соответствия.Вставить(Стр.КодЭлемента, Новый_);
        Стр.КодЭлемента = Новый_;
    КонецЦикла;
    Для Каждого Стр Из Элементы Цикл
        Новый_ = Соответствия.Получить(Стр.КодРодителя);
        Если Новый_ <> Неопределено Тогда
            Стр.КодРодителя = Новый_;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
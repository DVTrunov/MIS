<xs:schema xmlns="http://www.fss.ru/integration/types/fault/v01"
		xmlns:ns1="http://www.fss.ru/integration/types/dic/fault/v01"
		xmlns:sedo="http://www.fss.ru/integration/types/sedo/v01"
		xmlns:tns="http://www.fss.ru/integration/types/fault/v01"
		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		elementFormDefault="qualified"
		targetNamespace="http://www.fss.ru/integration/types/fault/v01"
		version="1.0">
	<xs:import namespace="http://www.fss.ru/integration/types/dic/fault/v01"
			schemaLocation="file://2.xsd"/>
	<xs:import namespace="http://www.fss.ru/integration/types/sedo/v01"
			schemaLocation="file://3.xsd"/>
	<xs:complexType name="CommonFault">
		<xs:annotation>
			<xs:documentation/>
		</xs:annotation>
		<xs:sequence>
			<!--TODO: пока система активно дорабатывается не стоит мспользовать enum для кодов-->
			<xs:element minOccurs="0"
					name="uuid"
					type="xs:string"/>
			<xs:element minOccurs="0"
					name="code"
					type="xs:string"/>
			<xs:element minOccurs="0"
					name="message"
					type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InternalFault">
		<xs:annotation>
			<xs:documentation>
                Внутренняя ошибка. Если произошла не класифицируемая ошибка сервиса
            </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="tns:CommonFault"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="InvalidDataFault">
		<xs:annotation>
			<xs:documentation>
                Ошибки при обработке входящего сообщения
            </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="uuidInbound"
					type="sedo:Uuid"/>
			<xs:element name="faultList">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded"
								minOccurs="1"
								name="fault"
								type="tns:CommonFault"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DigitalSignFault">
		<xs:annotation>
			<xs:documentation>
                Ошибка при обработке ЭЦП
            </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="tns:CommonFault"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DecryptFault">
		<xs:annotation>
			<xs:documentation>
                Ошибка при расшифровке сообщения
            </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="tns:CommonFault"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="TmsFault">
		<xs:annotation>
			<xs:documentation>
                Ошибка в работе транспортного слоя
            </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="tns:CommonFault"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PovdBusinessFaultType">
		<xs:annotation>
			<xs:documentation>
                Ошибка при обработке заявления на подтверждение видов экономической деятельности
            </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="tns:CommonFault"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:element name="internalFault"
			type="tns:InternalFault">
		<xs:annotation>
			<xs:documentation>
                Внутренняя ошибка. Если произошла не класифицируемая ошибка сервиса
            </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="invalidDataFault"
			type="tns:InvalidDataFault">
		<xs:annotation>
			<xs:documentation>
                Ошибка форматно-логического контроля
            </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="digitalSignFault"
			type="tns:DigitalSignFault">
		<xs:annotation>
			<xs:documentation>
                Ошибка при обработке ЭЦП
            </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="decryptFault"
			type="tns:DecryptFault">
		<xs:annotation>
			<xs:documentation>
                Ошибка при обработке ЭЦП
            </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="tmsFault"
			type="tns:TmsFault">
		<xs:annotation>
			<xs:documentation>
                Ошибка в работе транспортного слоя
            </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="povdBusinessFaultType"
			type="tns:PovdBusinessFaultType">
		<xs:annotation>
			<xs:documentation>
                Ошибка при обработке заявления на подтверждение видов экономической деятельности
            </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element abstract="true"
			name="BusinessFault">
		<xs:annotation>
			<xs:documentation>
                Ошибка валидации бизнеслогики. свой у каждого сервиса/арма/функции свой
            </xs:documentation>
		</xs:annotation>
	</xs:element>
</xs:schema>